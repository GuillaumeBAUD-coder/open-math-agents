import Mathlib

namespace OMA.S_wp_nakai_conjecture

/-- Differential operators are filtered by iterating the commutator with
multiplication. The operators of order zero are multiplication operators. -/
def HasOrderAtMost {A : Type*} [CommRing A] [Algebra ℂ A] :
    ℕ → Module.End ℂ A → Prop
  | 0, D => ∃ a : A, D = Algebra.lmul ℂ A a
  | n + 1, D => ∀ a : A, HasOrderAtMost n
      (D * Algebra.lmul ℂ A a - Algebra.lmul ℂ A a * D)

/-- The algebra generated by multiplication operators and ordinary derivations. -/
def generatedByDerivations (A : Type*) [CommRing A] [Algebra ℂ A] :
    Subalgebra ℂ (Module.End ℂ A) :=
  Algebra.adjoin ℂ
    (Set.range (Algebra.lmul ℂ A) ∪
      Set.range fun d : Derivation ℂ A A => d.toLinearMap)

/-- Nakai's conjecture for reduced affine complex varieties. -/
theorem main :
    ∀ (A : Type) [CommRing A] [Algebra ℂ A] [IsReduced A] [Algebra.FiniteType ℂ A],
      (∀ (n : ℕ) (D : Module.End ℂ A),
        HasOrderAtMost n D → D ∈ generatedByDerivations A) →
      Algebra.Smooth ℂ A := by
  sorry

end OMA.S_wp_nakai_conjecture
