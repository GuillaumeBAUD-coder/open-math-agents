import Mathlib

namespace OMA.S_opg_which_homology_3_spheres_bound_homology_4_balls

open AlgebraicTopology Manifold
open scoped BigOperators ContDiff Manifold

abbrev TriangulationCode := ℕ × List (List ℕ)

/-- Barycentric realization of the complex generated by the listed simplices. -/
abbrev Realization (code : TriangulationCode) :=
  {x : Fin code.1 → ℝ // (∀ i, 0 ≤ x i) ∧ (∑ i, x i) = 1 ∧
    ∃ simplex ∈ code.2, ∀ i, x i ≠ 0 → i.val ∈ simplex}

abbrev realizedSpace (code : TriangulationCode) : TopCat := TopCat.of (Realization code)

noncomputable def homology (R : Type) [CommRing R] (X : TopCat) (i : ℕ) : ModuleCat R :=
  (((singularHomologyFunctor (ModuleCat R) i).obj (ModuleCat.of R R)).obj X)

/-- One free generator in each of the listed degrees and zero in each other degree. -/
def HasHomology (R : Type) [CommRing R] (X : TopCat) (degrees : Set ℕ) : Prop :=
  ∀ i, (i ∈ degrees → Nonempty (homology R X i ≃ₗ[R] R)) ∧
    (i ∉ degrees → Subsingleton (homology R X i))

/-- A finite triangulation of a closed three-manifold with sphere homology. -/
def IsHomologySphereCode (R : Type) [CommRing R] (code : TriangulationCode) : Prop :=
  (∀ simplex ∈ code.2, ∀ v ∈ simplex, v < code.1) ∧
    HasHomology R (realizedSpace code) {0, 3} ∧
    ∃ atlas : ChartedSpace (EuclideanSpace ℝ (Fin 3)) (Realization code),
      letI := atlas
      IsManifold (𝓡 3) ∞ (Realization code)

/-- A smooth compact four-manifold with point homology and prescribed boundary. -/
def BoundsHomologyBall (R : Type) [CommRing R] (X : TopCat) : Prop :=
  ∃ (W : TopCat) (atlas : ChartedSpace (EuclideanHalfSpace 4) W),
    letI := atlas
    T2Space W ∧ SecondCountableTopology W ∧ CompactSpace W ∧
      IsManifold (𝓡∂ 4) ∞ W ∧ HasHomology R W {0} ∧
      Nonempty (↥((𝓡∂ 4).boundary W) ≃ₜ X)

/-- A computable criterion for bounding a smooth homology four-ball, with
integer and rational coefficient versions. -/
theorem main :
    ∃ test : Bool × TriangulationCode → Prop, ComputablePred test ∧
      (∀ code, IsHomologySphereCode ℤ code →
        (test (false, code) ↔ BoundsHomologyBall ℤ (realizedSpace code))) ∧
      (∀ code, IsHomologySphereCode ℚ code →
        (test (true, code) ↔ BoundsHomologyBall ℚ (realizedSpace code))) := by
  sorry

end OMA.S_opg_which_homology_3_spheres_bound_homology_4_balls
