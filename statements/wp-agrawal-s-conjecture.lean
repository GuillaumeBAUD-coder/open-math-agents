import Mathlib

/-!
# Agrawal's conjecture

Source: https://en.wikipedia.org/wiki/Agrawal's_conjecture
Credit: @ihateSAS

Agrawal's conjecture: given coprime positive integers `n` and `r`, if
`(X - 1) ^ n ≡ X ^ n - 1 (mod n, X ^ r - 1)` then either `n` is prime or
`n ^ 2 ≡ 1 (mod r)`.

The congruence modulo `n` and `X ^ r - 1` is read in the standard way, as
membership of the difference in the ideal of `ℤ[X]` generated by `n` and
`X ^ r - 1`; it is spelled out below with an explicit existential.
-/

namespace OMA.S_wp_agrawal_s_conjecture

/-- The polynomial congruence `(X - 1) ^ n ≡ X ^ n - 1` modulo `n` and `X ^ r - 1`,
i.e. the difference lies in the ideal generated by `n` and `X ^ r - 1`. -/
def AgrawalCongruent (n r : ℕ) : Prop :=
  ∃ A B : Polynomial ℤ,
    (Polynomial.X - 1) ^ n - (Polynomial.X ^ n - 1) =
      (n : Polynomial ℤ) * A + (Polynomial.X ^ r - 1) * B

theorem main :
    ∀ n r : ℕ, 1 ≤ n → 1 ≤ r → Nat.Coprime n r → AgrawalCongruent n r →
      n.Prime ∨ n ^ 2 ≡ 1 [MOD r] := by
  sorry

end OMA.S_wp_agrawal_s_conjecture
