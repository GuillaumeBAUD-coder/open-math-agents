import Mathlib

/-!
# A267447: Number of OFF (white) cells in the n-th iteration of the 'Rule 129' elementary cellular automaton starting with a single ON (black) cell.

Source: https://oeis.org/A267447

The conjecture of the entry (R. J. Mathar, Jan 17 2016): a(n) = A071051(n), n>0.

A071051(n) is the number of 1's in the n-th row of the triangle A071035, the successive states of
the cellular automaton generated by Rule 126.

Conventions (as in Wolfram's numbering and the OEIS programs): each automaton runs on the integers,
starting from one ON cell at position 0 on an all-OFF background, and the rule is applied to every
cell, including the background, at each step. Row n of a triangle, and the n-th iteration of an
automaton, consist of the 2n+1 cells at positions -n..n after n steps; for A071035 (offset 0) the
entries of row n are the states of these cells under Rule 126, read from left to right.

Offset 0: a(n) is the number of OFF cells among positions -n..n after n steps of Rule 129. The
definitions below reproduce the terms listed in the OEIS entries of A267447 and A071051.
-/

namespace OMA.S_oeis_a267447

/-- The new value of a cell under the elementary cellular automaton with Wolfram rule number
`rule`, given the old values of its left neighbour, itself and its right neighbour. -/
def ruleOut (rule : ℕ) (l c r : Bool) : Bool :=
  rule.testBit (4 * l.toNat + 2 * c.toNat + r.toNat)

/-- `cell rule t i` is the value of the cell at position `i` after `t` steps, starting from a
single ON cell at position 0 on an all-OFF background. -/
def cell (rule : ℕ) : ℕ → ℤ → Bool
  | 0 => fun i => decide (i = 0)
  | t + 1 => fun i => ruleOut rule (cell rule t (i - 1)) (cell rule t i) (cell rule t (i + 1))

/-- The number of ON cells among positions `-t..t` after `t` steps. -/
def onCount (rule t : ℕ) : ℕ :=
  ∑ j ∈ Finset.range (2 * t + 1), if cell rule t ((j : ℤ) - t) then 1 else 0

/-- A267447(n): the number of OFF cells among positions `-n..n` after `n` steps of Rule 129. -/
def a (n : ℕ) : ℕ :=
  ((Finset.range (2 * n + 1)).filter (fun j : ℕ => cell 129 n ((j : ℤ) - n) = false)).card

/-- A071051(n): the number of 1's in row `n` of the triangle A071035 (Rule 126). -/
def A071051 (n : ℕ) : ℕ := onCount 126 n

theorem main : ∀ n : ℕ, 0 < n → a n = A071051 n := by
  sorry

end OMA.S_oeis_a267447
