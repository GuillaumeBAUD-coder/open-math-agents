import Mathlib

/-!
# A084569: Perimeter-magic hollow squares of order 3.

Source: https://oeis.org/A084569

Name: Partial sums of A084570.

Conjecture (R. J. Mathar, Mar 08 2025): `a(n)` is the number of
perimeter-magic (hollow) squares of order 3 with magic sum `n + 3`.
Order 3 means each of the four edges has three elements, all elements
are positive integers, and squares obtained from each other by a
rotation are counted only once.

Credit: @bear20252026 (agent: catpaw, model CatPaw)

The eight perimeter positions are numbered cyclically `0, ..., 7`;
the four edges are the triples `(0,1,2)`, `(2,3,4)`, `(4,5,6)` and
`(6,7,0)`, each summing to the magic sum.  A square is encoded by its
eight entries `x_i`, represented as `1 + x_i` with `x_i : Fin (s - 1)`
so that every entry is at least `1`; the edge equations force every
entry to be below `s`.  Rotating the square by a quarter turn shifts
every position by `2` modulo `8`, so the rotation group is generated by
that shift and consists of the shifts `0, 2, 4, 6`.

To count rotation classes we attach to a square the integer
`Sum_i x_i * s^i` (a base-`s` code, which separates distinct squares)
and let each rotation class contribute the smallest such code in its
class; the number of rotation classes is therefore the cardinality of
the image of this minimum over all magic squares.  The conjectured
closed form is the OEIS formula
`(-1)^n / 8 + (n^4 + 6*n^3 + 17*n^2 + 30*n + 21) / 24`,
equivalently `(n^4 + 6*n^3 + 17*n^2 + 30*n + 21 + 3*(-1)^n) / 24`,
written below without powers of `-1`.  An independent enumeration
(Burnside's lemma, or direct counting of the eight-tuples) confirms
the equality for magic sums up to `13`.  The body stays `sorry`; a
person reviews the translation before merging.
-/

noncomputable section

open scoped Classical

namespace OMA.S_oeis_a084569

/-- An order-3 hollow-square perimeter for magic sum `s`, encoded as
the eight cyclic entries as functions `Fin 8 -> Fin (s - 1)`, so that
the actual entry at a position is `1` plus the stored value. -/
abbrev Pt (s : ℕ) := Fin 8 → Fin (s - 1)

/-- The entry written at perimeter position `i`. -/
def entry (s : ℕ) (x : Pt s) (i : Fin 8) : ℕ := 1 + (x i).val

/-- Quarter-turn rotation of a perimeter: position `i` receives the
entry formerly at position `i + k` (modulo `8`). -/
def rot (s : ℕ) (k : ℕ) (x : Pt s) : Pt s :=
  fun i => x ⟨(i.val + k) % 8, Nat.mod_lt _ (by norm_num)⟩

/-- A perimeter whose four edges each sum to the magic sum `s`. -/
def valid (s : ℕ) (x : Pt s) : Prop :=
  entry s x 0 + entry s x 1 + entry s x 2 = s ∧
  entry s x 2 + entry s x 3 + entry s x 4 = s ∧
  entry s x 4 + entry s x 5 + entry s x 6 = s ∧
  entry s x 6 + entry s x 7 + entry s x 0 = s

/-- All magic perimeters with magic sum `s`. -/
def allValid (s : ℕ) : Finset (Pt s) := Finset.univ.filter (valid s)

/-- Base-`s` code of a perimeter; it separates distinct perimeters. -/
def key (s : ℕ) (x : Pt s) : ℕ :=
  (Finset.univ : Finset (Fin 8)).sum
    (fun i => entry s x i * s ^ i.val)

/-- The least code among the four rotations of `x`. -/
def minKey (s : ℕ) (x : Pt s) : ℕ :=
  Nat.min (Nat.min (key s x) (key s (rot s 2 x)))
          (Nat.min (key s (rot s 4 x)) (key s (rot s 6 x)))

/-- Number of order-3 perimeter-magic hollow squares with magic sum
`s`, counted up to rotation. -/
def numSquares (s : ℕ) : ℕ :=
  ((allValid s).image (minKey s)).card

/-- The OEIS closed form for `a(n)` (`n >= 1`), rewritten as an
integer numerator divided by `24`. -/
def a084569Formula (n : ℕ) : ℕ :=
  (n ^ 4 + 6 * n ^ 3 + 17 * n ^ 2 + 30 * n + 21 + 3 -
    (if n % 2 = 0 then 0 else 6)) / 24

theorem main :
    ∀ n : ℕ, 1 ≤ n → numSquares (n + 3) = a084569Formula n := by
  sorry

end OMA.S_oeis_a084569
