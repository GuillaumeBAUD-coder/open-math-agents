import Mathlib

/-!
# StrictFilterProducts
Open Problem Garden: https://www.openproblemgarden.org/op/strict_inequalities_for_products_of_filters
The three products use the filter order and the definitions in the section on oblique products of Algebraic General Topology.
-/

namespace OMA.S_opg_strict_inequalities_for_products_of_filters

open Filter Set
open scoped Topology

variable {A B : Type}

/-- A positive set meets every member of the filter. -/
def IsPositive (F : Filter A) (S : Set A) : Prop :=
  ∀ U ∈ F, (S ∩ U).Nonempty

/-- The principal funcoid of a relation contains the funcoidal product. -/
def CoversProduct (F : Filter A) (G : Filter B) (R : Set (A × B)) : Prop :=
  ∀ X Y, IsPositive F X → IsPositive G Y → (X ×ˢ Y ∩ R).Nonempty

/-- The outer reloid of the funcoidal product. -/
def secondProduct (F : Filter A) (G : Filter B) : Filter (A × B) :=
  Filter.generate {R | CoversProduct F G R}

/-- The left oblique product, generated by relations covering the first
filter times a principal filter of a member of the second. -/
def leftOblique (F : Filter A) (G : Filter B) : Filter (A × B) :=
  Filter.generate {R | ∃ S ∈ G, CoversProduct F (Filter.principal S) R}

/-- The neighborhood filter of zero restricted to the positive reals. -/
def positiveGerm : Filter ℝ := nhdsWithin (0 : ℝ) (Ioi 0)

def StrictChain (F : Filter A) (G : Filter B) : Prop :=
  secondProduct F G < leftOblique F G ∧ leftOblique F G < F ×ˢ G

def ClaimedOutcome : Prop :=
  (∃ (X Y : Type) (F : Filter X) (G : Filter Y), StrictChain F G) ∧
    StrictChain positiveGerm positiveGerm

theorem main : ClaimedOutcome := by
  sorry

end OMA.S_opg_strict_inequalities_for_products_of_filters
