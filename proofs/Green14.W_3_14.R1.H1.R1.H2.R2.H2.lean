theorem anchors {N lo : Nat} {r b : Nat}
    (hr : ∀ i : Fin N, r.testBit i.val = true → i.val = lo ∨ i.val = 93)
    (hb : ∀ i : Fin N, b.testBit i.val = true → lo < i.val ∧ i.val < 93)
    (h : Impossible N (r,b)) (c : Nat → Bool)
    (hl : c lo = true) (hu : c 93 = true)
    (hg : ∀ x : Nat, lo < x → x < 93 → c x = false) : Goal N c := by
  by_contra hn
  apply h c hn
  constructor
  · intro x hx hh
    rcases hr ⟨x,hx⟩ (by simpa [AtBit,Bit] using hh) with he | he
    · simpa [show x=lo from he] using hl
    · simpa [show x=93 from he] using hu
  · intro x hx hh
    obtain ⟨h₁,h₂⟩ := hb ⟨x,hx⟩ (by simpa [AtBit,Bit] using hh)
    exact hg x h₁ h₂

