def look (m i : ℕ) : ℕ := (tb.getD m []).getD i 0

def CT (m : ℕ) : Prop := ∀ i, i < 165 → cnt m i = look m i

theorem ex_iff (i : ℕ) : (∃ q, S i q) ↔ ∃ t, t < 128 ∧ (M i).testBit t = true := by
  constructor
  · rintro ⟨q, hq⟩; exact ⟨enc q, enc_lt q, hq⟩
  · rintro ⟨t, ht, h⟩
    refine ⟨dec t, ?_⟩
    unfold S
    rwa [enc_dec t ht]

theorem ct0_check : ∀ i, i < 165 → ((∃ t, t < 128 ∧ (M i).testBit t = true) ↔ look 0 i = 1) := by decide +kernel

theorem look0 : ∀ i, i < 165 → look 0 i ≤ 1 := by decide +kernel

theorem CT0 : CT 0 := by
  intro i hi
  unfold cnt
  rw [W_zero]
  split_ifs with h
  · exact ((ct0_check i hi).1 ((ex_iff i).1 h)).symm
  · have h1 : look 0 i ≠ 1 := fun h1 => h ((ex_iff i).2 ((ct0_check i hi).2 h1))
    have := look0 i hi
    omega

theorem tstep (m : ℕ) (hm : ∀ i, i < 165 → look (m + 1) i = ∑ b0 : Fin 2, ∑ b1 : Fin 2, ∑ b2 : Fin 2, look m (sg i (encB ![b0, b1, b2])))
    (h : CT m) : CT (m + 1) := by
  intro i hi
  rw [cnt_succ m i hi, hm i hi, ← sum_ltr (fun b => look m (sg i (encB b)))]
  exact Finset.sum_congr rfl fun b _ => h _ (check_sg i hi _ (encB_lt b))

theorem CT1 : CT 1 := tstep 0 (by decide +kernel) CT0

