import OMAReductions.R_Erdos436_erdos_436_variants_six_two_R1

/-! A finite search for consecutive zero weights in ZMod 6. Each bit position
stores parity and a two-bit residue modulo three. At each new prime,
factorization lists verify the linear equations for both consecutive integers.
The finite search branches on the six possible weights of each prime.
The bit-parallel proof framework is adapted from @marcusbuffett, PR 3591. -/

namespace SixPairs
structure W where
  x : Nat
  y : Nat
  z : Nat
deriving Inhabited


def W.get (w : W) (i : Nat) : Nat :=
  let u := (w.y.testBit i).toNat + 2*(w.z.testBit i).toNat
  if u%2 = (w.x.testBit i).toNat then u else u+3

def W.add (a b : W) : W :=
  let u := a.y ^^^ b.y
  let v := a.z ^^^ b.z
  let g := a.y &&& b.y
  let c := (a.z &&& b.z) ||| (v &&& g)
  ⟨a.x ^^^ b.x,u ^^^ c,v ^^^ (g ||| (u &&& c))⟩

def W.scale (_m : Nat) (w : W) : Nat → W
  | 0 => ⟨0,0,0⟩
  | 1 => w
  | 2 => ⟨0,w.z,w.y⟩
  | 3 => ⟨w.x,0,0⟩
  | 4 => ⟨0,w.y,w.z⟩
  | _ => ⟨w.x,w.z,w.y⟩
def dot (mask : Nat) : List W → Nat → W
  | [],_ => ⟨0,0,0⟩
  | c::cs,v =>
    let w := dot mask cs (v/8)
    if v%8 == 0 then w else w.add (c.scale mask (v%8))


structure Batch where
  even : Nat
  pivot : W
  cols : List W

def W.nz (w : W) := w.x ||| (w.y ^^^ w.z)
def maskAll (e : Nat) := e ||| (e <<< 1)
def gate (w : W) (g : Batch) (a : Nat) : Bool :=
  let v := (w.add (g.pivot.scale (maskAll g.even) a)).nz
  ((v ||| (v >>> 1)) &&& g.even) != g.even
def run : List Batch → Nat → Bool
  | [],_ => false
  | g::gs,v =>
    let w := dot (maskAll g.even) g.cols v
    let ok := fun a => gate w g a || run gs (8*v+a)
    ok 0 && ok 1 && ok 2 && ok 3 && ok 4 && ok 5


private theorem add_get (a b : W) (i : Nat) :
    ((a.add b).get i : ZMod 6) = (a.get i : ZMod 6) + (b.get i : ZMod 6) := by
  simp only [W.get,W.add,Nat.testBit_xor,Nat.testBit_or,Nat.testBit_and]
  generalize a.x.testBit i = x
  generalize a.y.testBit i = y
  generalize a.z.testBit i = z
  generalize b.x.testBit i = u
  generalize b.y.testBit i = v
  generalize b.z.testBit i = w
  revert x y z u v w
  decide +kernel

private theorem scale_get (c : W) (m i a : Nat) (hm : m.testBit i = true) (ha : a < 6) :
    ((c.scale m a).get i : ZMod 6) = (a : ZMod 6) * (c.get i : ZMod 6) := by
  interval_cases a <;> simp only [W.scale,W.get,Nat.testBit_xor,hm,
    Nat.zero_testBit,Bool.true_xor] <;>
    generalize c.x.testBit i = x <;> generalize c.y.testBit i = y <;>
    generalize c.z.testBit i = z <;> revert x y z <;> decide +kernel

private theorem nz_spec (w : W) (i : Nat) :
    w.nz.testBit i = false ↔ (w.get i : ZMod 6) = 0 := by
  simp only [W.nz,W.get,Nat.testBit_xor,Nat.testBit_or]
  generalize w.x.testBit i = x
  generalize w.y.testBit i = y
  generalize w.z.testBit i = z
  revert x y z
  decide +kernel

def encode (f : Nat → ZMod 6) : List Nat → Nat
  | [] => 0
  | q :: qs => (f q).val + 8 * encode f qs

private theorem enc_mod (f : Nat → ZMod 6) (q : Nat) (qs : List Nat) :
    encode f (q::qs) % 8 = (f q).val := by
  simp only [encode]
  have := (f q).val_lt
  omega

private theorem enc_div (f : Nat → ZMod 6) (q : Nat) (qs : List Nat) :
    encode f (q::qs) / 8 = encode f qs := by
  simp only [encode]
  have := (f q).val_lt
  omega

private theorem dot_cons_get (m i : Nat) (hm : m.testBit i = true) (w : W)
    (ws : List W) (f : Nat → ZMod 6) (q : Nat) (qs : List Nat) :
    ((dot m (w::ws) (encode f (q::qs))).get i : ZMod 6) =
    (f q) * (w.get i : ZMod 6) + ((dot m ws (encode f qs)).get i : ZMod 6) := by
  simp only [dot,enc_mod,enc_div]
  split
  · rename_i h
    simp only [beq_iff_eq] at h
    have hz : f q = 0 := by rw [← ZMod.natCast_zmod_val (f q), h]; rfl
    simp [hz]
  · rw [add_get,scale_get _ _ _ _ hm (f q).val_lt,ZMod.natCast_zmod_val,add_comm]

def linear (n : List Nat) (f : Nat → ZMod 6) : List Nat → ZMod 6
  | [] => 0
  | q::qs => (n.count q : ZMod 6) * f q + linear n f qs


def flags (i : Nat) (A B : List Nat) : List W → List Nat → Bool
  | [],[] => true
  | w::ws,q::qs => (w.get (2*i)%6 == A.count q%6) &&
      (w.get (2*i+1)%6 == B.count q%6) && flags i A B ws qs
  | _,_ => false

private theorem flags_sound (i m : Nat) (A B : List Nat) (ha : m.testBit (2*i) = true)
    (hb : m.testBit (2*i+1) = true) (f : Nat → ZMod 6) (ws : List W) (qs : List Nat)
    (hf : flags i A B ws qs = true) :
    ((dot m ws (encode f qs)).get (2*i) : ZMod 6) = linear A f qs ∧
    ((dot m ws (encode f qs)).get (2*i+1) : ZMod 6) = linear B f qs := by
  induction ws generalizing qs with
  | nil => cases qs <;> simp_all [dot,W.get,linear,flags]
  | cons w ws ih =>
    cases qs with
    | nil => simp [flags] at hf
    | cons q qs =>
      simp only [flags,Bool.and_eq_true,beq_iff_eq] at hf
      obtain ⟨⟨hl,hr⟩,ht⟩ := hf
      have hleft : (w.get (2*i) : ZMod 6) = A.count q := (ZMod.natCast_eq_natCast_iff ..).mpr hl
      have hright : (w.get (2*i+1) : ZMod 6) = B.count q := (ZMod.natCast_eq_natCast_iff ..).mpr hr
      obtain ⟨al,bl⟩ := ih qs ht
      rw [dot_cons_get _ _ ha,dot_cons_get _ _ hb,linear,linear,hleft,hright,al,bl]
      constructor <;> ring

def weight (f : Nat → ZMod 6) (n : Nat) := (n.primeFactorsList.map f).sum
def Goal (f : Nat → ZMod 6) : Prop :=
  ∃ n : Nat, 1 ≤ n ∧ n ≤ 202124 ∧ weight f n = 0 ∧ weight f (n+1) = 0

private theorem linear_finset (A ps : List Nat) (f : Nat → ZMod 6) (h : ps.Nodup) :
    linear A f ps = ∑ q ∈ ps.toFinset, (A.count q : ZMod 6) * f q := by
  induction ps with
  | nil => simp [linear]
  | cons q qs ih =>
    obtain ⟨hn, hu⟩ := List.nodup_cons.mp h
    simp [linear, Finset.sum_insert, hn, ih hu]


private theorem linear_weight (A ps : List Nat) (f : Nat → ZMod 6)
    (h : ps.Nodup) (hp : ∀ q ∈ A, Nat.Prime q) (hs : ∀ q ∈ A, q ∈ ps) :
    linear A f ps = weight f A.prod := by
  have perm := Nat.primeFactorsList_unique (n := A.prod) rfl hp
  rw [linear_finset _ _ _ h,weight,← (perm.map f).sum_eq]
  clear perm hp
  induction A with
  | nil => simp
  | cons a A ih =>
    have ha := hs a (by simp)
    have ht : ∀ q ∈ A, q ∈ ps := fun q hq => hs q (by simp [hq])
    simp only [List.count_cons,Nat.cast_add,mul_add,add_mul,Finset.sum_add_distrib,
      List.map_cons,List.sum_cons,ih ht]
    simp [apply_ite,ite_mul,ha,add_comm]

abbrev R := List Nat × List Nat

def goodRow (g : Batch) (q : Nat) (ps : List Nat) (i : Nat) (r : R) : Prop :=
  let A := r.1
  let B := r.2
  g.even.testBit (2*i+1) = false ∧
  (maskAll g.even).testBit (2*i) = true ∧
  (maskAll g.even).testBit (2*i+1) = true ∧
  (A.prod + 1 = B.prod ∨ B.prod + 1 = A.prod) ∧
  1 ≤ A.prod ∧ 1 ≤ B.prod ∧ min A.prod B.prod ≤ 202124 ∧
  (∀ p ∈ A, Nat.Prime p ∧ p ∈ q::ps) ∧ (∀ p ∈ B, Nat.Prime p ∧ p ∈ q::ps) ∧
  flags i A B (g.pivot::g.cols) (q::ps) = true

instance (g : Batch) (q : Nat) (ps : List Nat) (i : Nat) (r : R) :
    Decidable (goodRow g q ps i r) := by unfold goodRow; infer_instance

def certified (g : Batch) (q : Nat) (ps : List Nat) (rs : Array R) : Prop :=
  (q::ps).Nodup ∧ g.even < 2^(2*rs.size) ∧ ∀ i : Fin rs.size, goodRow g q ps i.val rs[i]

instance (g : Batch) (q : Nat) (ps : List Nat) (rs : Array R) :
    Decidable (certified g q ps rs) := by unfold certified; infer_instance

private theorem gate_sound (g : Batch) (q : Nat) (ps : List Nat) (rs : Array R)
    (hv : certified g q ps rs) (f : Nat → ZMod 6)
    (hit : gate (dot (maskAll g.even) g.cols (encode f ps)) g (f q).val = true) : Goal f := by

  let w := dot (maskAll g.even) g.cols (encode f ps)
  let t := w.add (g.pivot.scale (maskAll g.even) (f q).val)
  change (((t.nz ||| (t.nz >>> 1)) &&& g.even) != g.even) = true at hit
  simp only [bne_iff_ne] at hit
  have hx := mt Nat.eq_of_testBit_eq hit
  push Not at hx
  obtain ⟨k,hk⟩ := hx
  simp only [Nat.testBit_and, Nat.testBit_or, Nat.testBit_shiftRight] at hk
  have he : g.even.testBit k = true := by
    cases h : g.even.testBit k <;> simp_all
  have hklt : k < 2*rs.size := by
    by_contra! h
    have hzero := Nat.testBit_lt_two_pow (hv.2.1.trans_le (Nat.pow_le_pow_right (by decide : 0 < 2) h))
    rw [hzero] at he; contradiction
  let i : Fin rs.size := ⟨k/2, by omega⟩
  obtain ⟨ho,ma,mb,adj,pa,pb,bnd,aps,bps,hflags⟩ := hv.2.2 i
  have hke : k = 2*i.val := by
    change g.even.testBit (2*(k/2)+1) = false at ho
    change k = 2*(k/2)
    by_contra h
    have eq : 2*(k/2)+1 = k := by omega
    rw [eq,he] at ho; contradiction
  rw [hke] at hk he
  simp only [he,Bool.and_true,← Bool.eq_false_iff,Bool.or_eq_false_iff] at hk

  have ha := (nz_spec t (2*i.val)).mp hk.1
  have hb := (nz_spec t (2*i.val+1)).mp (by simpa [Nat.add_comm] using hk.2)
  obtain ⟨l,r⟩ := flags_sound i _ _ _ ma mb f _ _ hflags
  have dot_eq (j : Nat) (hj : (maskAll g.even).testBit j = true) :
      ((dot (maskAll g.even) (g.pivot::g.cols) (encode f (q::ps))).get j : ZMod 6) = t.get j := by
    rw [dot_cons_get _ _ hj]
    change _ = ((w.add (g.pivot.scale _ _)).get j : ZMod 6)
    rw [add_get,scale_get _ _ _ _ hj (f q).val_lt,ZMod.natCast_zmod_val,add_comm]
  have hA := linear_weight rs[i].1 (q::ps) f hv.1 (fun p h => (aps p h).1) (fun p h => (aps p h).2)
  have hB := linear_weight rs[i].2 (q::ps) f hv.1 (fun p h => (bps p h).1) (fun p h => (bps p h).2)
  rw [← l, dot_eq _ ma,ha] at hA
  rw [← r, dot_eq _ mb,hb] at hB
  replace hA := hA.symm
  replace hB := hB.symm
  rcases adj with a | b
  · exact ⟨_,pa,by omega,hA,a.symm ▸ hB⟩
  · exact ⟨_,pb,by omega,hB,b.symm ▸ hA⟩

def valid (ps : List Nat) : List Batch → Prop
  | [] => True
  | g::gs => ∃ q rs, certified g q ps rs ∧ valid (q::ps) gs

private theorem run_sound (ps : List Nat) (gs : List Batch) (f : Nat → ZMod 6)
    (hv : valid ps gs) (hc : run gs (encode f ps) = true) : Goal f := by
  induction gs generalizing ps with
  | nil => simp [run] at hc
  | cons g gs ih =>
    obtain ⟨q,rs,hq,ht⟩ := hv
    let w := dot (maskAll g.even) g.cols (encode f ps)
    let ok := fun a => gate w g a || run gs (8*encode f ps+a)
    change (ok 0 && ok 1 && ok 2 && ok 3 && ok 4 && ok 5) = true at hc
    simp only [Bool.and_eq_true] at hc
    have t : ok (f q).val = true := by
      have h := (f q).val_lt
      interval_cases v : (f q).val <;> tauto
    rcases Bool.or_eq_true_iff.mp t with h | h
    · exact gate_sound g q ps rs hq f h
    · exact ih (q::ps) ht (by simpa only [encode,Nat.add_comm] using h)


def children (g : Batch) (v : Nat) : List Nat :=
  let w := dot (maskAll g.even) g.cols v
  (List.range 6).filter (fun a => !(gate w g a))

def every (gs : List Batch) (v : Nat) : List Nat → Prop
  | [] => True
  | a::as => run gs (8*v+a) = true ∧ every gs v as

private theorem every_mem (gs : List Batch) (v a : Nat) (l : List Nat)
    (h : every gs v l) (ha : a ∈ l) : run gs (8*v+a) = true := by
  induction l with
  | nil => simp at ha
  | cons b bs ih =>
    rcases List.mem_cons.mp ha with rfl | h'
    · exact h.1
    · exact ih h.2 h'

private theorem branch (g : Batch) (gs : List Batch) (v : Nat) (l : List Nat)
    (he : children g v = l) (hc : every gs v l) : run (g::gs) v = true := by
  let w := dot (maskAll g.even) g.cols v
  have ok (a : Nat) (ha : a < 6) : gate w g a || run gs (8*v+a) := by
    by_cases hg : gate w g a = true
    · simp [hg]
    · apply Bool.or_eq_true_iff.mpr
      apply Or.inr
      apply every_mem _ _ _ l hc
      rw [← he]
      exact List.mem_filter.mpr ⟨List.mem_range.mpr ha,by simpa [Bool.not_eq_true'] using hg⟩
  simp only [run,Bool.and_eq_true]
  exact ⟨⟨⟨⟨⟨ok 0 (by decide),ok 1 (by decide)⟩,ok 2 (by decide)⟩,
    ok 3 (by decide)⟩,ok 4 (by decide)⟩,ok 5 (by decide)⟩


private def decodeRows (size code : Nat) : Array R :=
  Array.ofFn fun i : Fin size =>
    let z := code >>> (384*i.val)
    (Nat.digits 512 (z % 2^192),Nat.digits 512 ((z >>> 192) % 2^192))
