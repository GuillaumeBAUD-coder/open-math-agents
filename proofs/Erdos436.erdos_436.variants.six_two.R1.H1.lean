/-! Proof by reflection. A search tree `T` (leaf = witness `n`, node = case split on the label of a prime) is
checked by the Boolean function `check`, whose soundness (`sound`) is proved once; the tree, 38696 nodes
found by a depth-first search over the primes in increasing order, is cut into chunks `D0`, `D1`, … each
verified by `decide +kernel`, and `main_H1` splits on the labels of the first primes to reach the chunks. -/

namespace OMA436fv

/-- A search tree: a leaf names a witness `n`; a node branches on the value (`0, …, 5`) of the
label of a prime `p`. -/
inductive T where
  | l (n : ℕ)
  | n (p : ℕ) (c0 c1 c2 c3 c4 c5 : T)

/-- Look up the label of `q` in a partial assignment. -/
def look : List (ℕ × ℕ) → ℕ → Option ℕ
  | [], _ => none
  | (p, v) :: A, q => if q = p then some v else look A q

/-- The sum of the labels of a list of primes, if all are assigned. -/
def ev (A : List (ℕ × ℕ)) : List ℕ → Option ℕ
  | [] => some 0
  | q :: l => match look A q, ev A l with
    | some a, some b => some (a + b)
    | _, _ => none

/-- `n` is a valid witness under the partial assignment `A`. -/
def leafOk (A : List (ℕ × ℕ)) (n : ℕ) : Bool :=
  decide (1 ≤ n) && decide (n ≤ 202124) &&
    match ev A n.primeFactorsList, ev A (n + 1).primeFactorsList with
    | some a, some b => decide (a % 6 = 0) && decide (b % 6 = 0)
    | _, _ => false

/-- Check the whole tree below the partial assignment `A`. -/
def check (A : List (ℕ × ℕ)) : T → Bool
  | .l n => leafOk A n
  | .n p c0 c1 c2 c3 c4 c5 =>
    check ((p, 0) :: A) c0 &&
      check ((p, 1) :: A) c1 &&
      check ((p, 2) :: A) c2 &&
      check ((p, 3) :: A) c3 &&
      check ((p, 4) :: A) c4 &&
      check ((p, 5) :: A) c5

/-- `A` agrees with the labelling `w`. -/
def Agree (A : List (ℕ × ℕ)) (w : ℕ → ZMod 6) : Prop :=
  ∀ q v, look A q = some v → w q = (v : ZMod 6)

lemma agree_nil (w : ℕ → ZMod 6) : Agree [] w := fun q v h => by simp [look] at h

lemma agree_cons {A : List (ℕ × ℕ)} {w : ℕ → ZMod 6} (h : Agree A w) (p v : ℕ)
    (hv : w p = (v : ZMod 6)) : Agree ((p, v) :: A) w := by
  intro q u hq
  simp only [look] at hq
  split_ifs at hq with hqp
  · cases hq; rw [hqp]; exact hv
  · exact h q u hq

lemma ev_sound {A : List (ℕ × ℕ)} {w : ℕ → ZMod 6} (h : Agree A w) :
    ∀ (l : List ℕ) (s : ℕ), ev A l = some s → (l.map w).sum = (s : ZMod 6) := by
  intro l
  induction l with
  | nil => intro s hs; simp [ev] at hs; simp [← hs]
  | cons q l ih =>
    intro s hs
    simp only [ev] at hs
    split at hs
    · rename_i a b ha hb
      cases hs
      simp only [List.map_cons, List.sum_cons, Nat.cast_add]
      rw [h q a ha, ih b hb]
    · cases hs

lemma sound (w : ℕ → ZMod 6) : ∀ (t : T) (A : List (ℕ × ℕ)), Agree A w → check A t = true →
    ∃ n ∈ Finset.Icc 1 202124, (n.primeFactorsList.map w).sum = 0 ∧
      ((n + 1).primeFactorsList.map w).sum = 0 := by
  intro t
  induction t with
  | l n =>
    intro A hA hc
    simp only [check, leafOk, Bool.and_eq_true, decide_eq_true_eq] at hc
    obtain ⟨⟨h1, h2⟩, h3⟩ := hc
    refine ⟨n, Finset.mem_Icc.mpr ⟨h1, h2⟩, ?_⟩
    split at h3
    · rename_i a b ha hb
      simp only [Bool.and_eq_true, decide_eq_true_eq] at h3
      rw [ev_sound hA _ a ha, ev_sound hA _ b hb]
      exact ⟨(ZMod.natCast_eq_zero_iff _ _).mpr (Nat.dvd_of_mod_eq_zero h3.1),
        (ZMod.natCast_eq_zero_iff _ _).mpr (Nat.dvd_of_mod_eq_zero h3.2)⟩
    · cases h3
  | n p c0 c1 c2 c3 c4 c5 i0 i1 i2 i3 i4 i5 =>
    intro A hA hc
    simp only [check, Bool.and_eq_true] at hc
    obtain ⟨⟨⟨⟨⟨h0, h1⟩, h2⟩, h3⟩, h4⟩, h5⟩ := hc
    have hv : w p = ((w p).val : ZMod 6) := (ZMod.natCast_zmod_val _).symm
    have hlt : (w p).val < 6 := ZMod.val_lt _
    generalize hx : (w p).val = x at hv hlt
    interval_cases x
    · exact i0 _ (agree_cons hA p 0 hv) h0
    · exact i1 _ (agree_cons hA p 1 hv) h1
    · exact i2 _ (agree_cons hA p 2 hv) h2
    · exact i3 _ (agree_cons hA p 3 hv) h3
    · exact i4 _ (agree_cons hA p 4 hv) h4
    · exact i5 _ (agree_cons hA p 5 hv) h5

