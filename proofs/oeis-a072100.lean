lemma S_sq : S * S = R := by
  have := bs_sq (R - 1) (by simp [R])
  unfold S; rw [this]; ring

noncomputable def DD : PowerSeries ℚ := 2 - 6 * X + 4 * X ^ 2
noncomputable def NN : PowerSeries ℚ := X - 2 * X ^ 2 + (X) * S
noncomputable def AA : PowerSeries ℚ := NN * DD⁻¹

lemma hA : AA * DD = NN := by
  unfold AA
  rw [mul_assoc, PowerSeries.inv_mul_cancel _ (by simp [DD]), mul_one]

lemma hdD : derivative ℚ DD = 8*X - 6 := by
  simp [DD]; ring
lemma hdR : derivative ℚ R = -8*X := by
  simp [R]; ring
lemma hdN : derivative ℚ NN = 1 - 4*X + (1) * S + (X) * derivative ℚ S := by
  simp [NN]; ring

lemma ode : ((1) * X ^ 0 + (2) * X ^ 1 + (-6) * X ^ 2) * AA + ((-1) * X ^ 1 + (1) * X ^ 2 + (4) * X ^ 3 + (-4) * X ^ 4) * derivative ℚ AA = ((1) * X ^ 2 : PowerSeries ℚ) := by
  have r1 := hA
  have r2 : derivative ℚ AA * DD + AA * derivative ℚ DD = derivative ℚ NN := by
    have := congrArg (derivative ℚ) hA
    rw [Derivation.leibniz] at this
    simp only [smul_eq_mul] at this
    rw [← this]; ring
  have r4 := sqrt_ode S R S_sq
  have hK : (2 * R * DD ^ 2 : PowerSeries ℚ) ≠ 0 := by
    intro h
    have := congrArg constantCoeff h
    simp [R, DD] at this
  apply mul_left_cancel₀ hK
  rw [hdD, hdN] at r2
  rw [hdR] at r4
  unfold NN at r1
  unfold DD at r1 r2
  unfold R at r4
  unfold DD R
  linear_combination (-256*X^7 + 640*X^6 - 416*X^5 - 112*X^4 + 184*X^3 - 28*X^2 - 16*X + 4) * r1 + (128*X^8 - 320*X^7 + 192*X^6 + 96*X^5 - 120*X^4 + 12*X^3 + 16*X^2 - 4*X) * r2 + (-16*X^7 + 40*X^6 - 28*X^5 - 2*X^4 + 8*X^3 - 2*X^2) * r4

lemma ha (n : ℕ) : a n = coeff (n + 0) AA := rfl

lemma rec_a (k : ℕ) : (1 - ((k + 4 : ℕ) : ℚ)) * a (k + 4) + (((k + 4 : ℕ) : ℚ) + 1) * a (k + 3) + (4*((k + 4 : ℕ) : ℚ) - 14) * a (k + 2) + (12 - 4*((k + 4 : ℕ) : ℚ)) * a (k + 1) = 0 := by
  have h := congrArg (coeff (k + 4)) ode
  simp only [add_mul, sub_mul, neg_mul, one_mul, map_add, map_sub, map_neg, mul_assoc, cm2, cm3, cm4, cm6, cm8, cm12, cm14, coeff_X_pow_mul', coeff_derivative] at h
  simp at h
  simp only [ha]
  simp only [Nat.add_assoc, Nat.reduceAdd] at h ⊢
  push_cast at h ⊢
  linear_combination h

end OMA.S_oeis_a072100

theorem OMA.solution : type_of% @OMA.S_oeis_a072100.main := by
  intro n hn
  obtain ⟨k, rfl⟩ : ∃ k, n = k + 4 := ⟨n - 4, by omega⟩
  simp only [show k + 4 - 1 = k + 3 from by omega, show k + 4 - 2 = k + 2 from by omega, show k + 4 - 3 = k + 1 from by omega]
  have h := OMA.S_oeis_a072100.rec_a k
  push_cast at h ⊢
  linear_combination h
