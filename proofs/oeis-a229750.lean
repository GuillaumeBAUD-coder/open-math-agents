/-! Numerical tables -/

/-- The values a 0 .. a 17. -/
def AV : List ℕ := [0, 1, 60, 598, 2347, 6809, 17404, 41872, 97565, 223075, 503650, 1126490, 2500555, 5515189, 12096536, 26401012, 57368137, 124167191]

def nv (m s : ℕ) : ℕ := (NV.getD m []).getD s 0

/-- Add one at position `t` of a list. -/
def incAt : ℕ → List ℕ → List ℕ
  | 0, x :: xs => (x + 1) :: xs
  | t + 1, x :: xs => x :: incAt t xs
  | _, [] => []

theorem incAt_length : ∀ (t : ℕ) (l : List ℕ), (incAt t l).length = l.length
  | 0, _ :: _ => rfl
  | t + 1, _ :: xs => by simp [incAt, incAt_length t xs]
  | 0, [] => rfl
  | _ + 1, [] => rfl

theorem incAt_getD : ∀ (t : ℕ) (l : List ℕ) (i : ℕ), i < l.length →
    (incAt t l).getD i 0 = l.getD i 0 + if t = i then 1 else 0
  | 0, x :: xs, 0, _ => by simp [incAt]
  | 0, x :: xs, i + 1, _ => by simp [incAt]
  | t + 1, x :: xs, 0, _ => by simp [incAt]
  | t + 1, x :: xs, i + 1, h => by
    simp only [incAt, List.getD_cons_succ]
    rw [incAt_getD t xs i (by simpa using h)]
    simp
  | _, [], i, h => by simp at h

theorem rep_getD : ∀ (n i : ℕ), (List.replicate n 0).getD i 0 = 0
  | 0, _ => rfl
  | _ + 1, 0 => rfl
  | n + 1, i + 1 => by
    rw [List.replicate_succ, List.getD_cons_succ]
    exact rep_getD n i

/-- The histogram of the entries of a list below 141. -/
def histB (l : List ℕ) : List ℕ := l.foldr incAt (List.replicate 141 0)

theorem histB_length (l : List ℕ) : (histB l).length = 141 := by
  induction l with
  | nil => simp [histB]
  | cons x xs ih =>
    show (incAt x (histB xs)).length = 141
    rw [incAt_length, ih]

theorem histB_getD (l : List ℕ) (i : ℕ) (hi : i < 141) : (histB l).getD i 0 = cntL i l := by
  induction l with
  | nil => exact rep_getD 141 i
  | cons x xs ih =>
    show (incAt x (histB xs)).getD i 0 = _
    rw [incAt_getD x _ i (by rw [histB_length]; exact hi), ih, cntL]
    ring

/-- Rows of histograms checked in lockstep. -/
def rowsOK : List (List ℕ) → List (List ℕ) → Bool
  | r :: rs, c :: cs => (histB r == c) && rowsOK rs cs
  | [], [] => true
  | _, _ => false

theorem rowsOK_sound : ∀ (rs cs : List (List ℕ)), rowsOK rs cs = true →
    ∀ s < rs.length, histB (rs.getD s []) = cs.getD s []
  | r :: rs, c :: cs, h, s, hs => by
    simp only [rowsOK, Bool.and_eq_true, beq_iff_eq] at h
    cases s with
    | zero => simpa using h.1
    | succ s =>
      simp only [List.getD_cons_succ]
      exact rowsOK_sound rs cs h.2 s (by simpa using hs)
  | [], _, _, s, hs => by simp at hs
  | _ :: _, [], h, _, _ => by simp [rowsOK] at h

theorem chk_rows : rowsOK TT CM = true := by
  decide +kernel

theorem chk_cnt (s' : ℕ) (hs' : s' < 141) (s : ℕ) (hs : s < 141) :
    cnt s s' = (CM.getD s []).getD s' 0 := by
  rw [← rowsOK_sound TT CM chk_rows s (by rw [show TT.length = 141 from rfl]; exact hs),
    histB_getD _ _ hs']
  rfl

/-- Pointwise sum of two lists. -/
def addL : List ℕ → List ℕ → List ℕ
  | x :: xs, y :: ys => (x + y) :: addL xs ys
  | xs, [] => xs
  | [], ys => ys

theorem addL_getD : ∀ (u v : List ℕ) (i : ℕ), (addL u v).getD i 0 = u.getD i 0 + v.getD i 0
  | x :: xs, y :: ys, 0 => by simp [addL]
  | x :: xs, y :: ys, i + 1 => by
    simp only [addL, List.getD_cons_succ]
    exact addL_getD xs ys i
  | xs, [], i => by cases xs <;> simp [addL]
  | [], y :: ys, i => by simp [addL]

/-- A list times a scalar. -/
def scaleL (a : ℕ) : List ℕ → List ℕ
  | [] => []
  | x :: xs => (a * x) :: scaleL a xs

theorem scaleL_getD (a : ℕ) : ∀ (v : List ℕ) (i : ℕ), (scaleL a v).getD i 0 = a * v.getD i 0
  | [], i => by simp [scaleL]
  | x :: xs, 0 => by simp [scaleL]
  | x :: xs, i + 1 => by
    simp only [scaleL, List.getD_cons_succ]
    exact scaleL_getD a xs i

/-- The row vector `u` times the matrix with rows `rows`. -/
def vecStep : List ℕ → List (List ℕ) → List ℕ
  | x :: xs, r :: rs => addL (scaleL x r) (vecStep xs rs)
  | _, _ => []

theorem vecStep_getD : ∀ (u : List ℕ) (rows : List (List ℕ)) (n : ℕ), u.length = n →
    rows.length = n → ∀ i, (vecStep u rows).getD i 0 =
      ∑ s ∈ range n, u.getD s 0 * (rows.getD s []).getD i 0
  | [], _, n, hu, _, i => by
    subst hu
    simp [vecStep]
  | _ :: _, [], n, hu, hr, _ => by
    simp at hu hr
    omega
  | x :: xs, r :: rs, n, hu, hr, i => by
    obtain ⟨k, rfl⟩ : ∃ k, n = k + 1 := ⟨xs.length, by simp at hu; omega⟩
    rw [Finset.sum_range_succ', vecStep, addL_getD, scaleL_getD,
      vecStep_getD xs rs k (by simpa using hu) (by simpa using hr) i]
    simp only [List.getD_cons_succ, List.getD_cons_zero]
    ring

theorem chk_vec (m : ℕ) (hm : m < 17) : vecStep (NV.getD m []) CM = NV.getD (m + 1) [] := by
  interval_cases m
  · decide +kernel
  · decide +kernel
  · decide +kernel
  · decide +kernel
  · decide +kernel
  · decide +kernel
  · decide +kernel
  · decide +kernel
  · decide +kernel
  · decide +kernel
  · decide +kernel
  · decide +kernel
  · decide +kernel
  · decide +kernel
  · decide +kernel
  · decide +kernel
  · decide +kernel

theorem chk_lensB : allB 18 (fun m => Nat.beq (NV.getD m []).length 141) = true := by
  decide +kernel

theorem chk_nv0B : allB 141 (fun s => Nat.beq (nv 0 s) (if s = 140 then 1 else 0)) = true := by
  decide +kernel

theorem chk_nv0 (s : ℕ) (hs : s < 141) : nv 0 s = if s = 140 then 1 else 0 :=
  Nat.beq_eq.mp ((allB_iff _ _).mp chk_nv0B s hs)

theorem chk_baseB : allB 141 (fun s => Nat.beq (64 * nv 5 s + 348 * nv 9 s + 87 * nv 13 s + nv 17 s)
    (240 * nv 7 s + 245 * nv 11 s + 15 * nv 15 s)) = true := by
  decide +kernel

theorem chk_base (s : ℕ) (hs : s < 141) : 64 * nv 5 s + 348 * nv 9 s + 87 * nv 13 s + nv 17 s =
    240 * nv 7 s + 245 * nv 11 s + 15 * nv 15 s :=
  Nat.beq_eq.mp ((allB_iff _ _).mp chk_baseB s hs)

theorem chk_AB : allB 18 (fun m => Nat.beq (Aop (nv m)) (AV.getD m 0) || Nat.beq m 0) = true := by
  decide +kernel

theorem chk_A (m : ℕ) (hm : m < 18) (h1 : 1 ≤ m) : Aop (nv m) = AV.getD m 0 := by
  have h := (allB_iff _ _).mp chk_AB m hm
  simp only [Bool.or_eq_true, Nat.beq_eq] at h
  rcases h with h | h
  · exact h
  · omega

theorem chk_nv (m : ℕ) (hm : m < 17) (s' : ℕ) (hs' : s' < 141) : Mop (nv m) s' = nv (m + 1) s' := by
  have hl : (NV.getD m []).length = 141 := Nat.beq_eq.mp ((allB_iff _ _).mp chk_lensB m (by omega))
  unfold nv
  rw [← chk_vec m hm, vecStep_getD _ CM 141 hl rfl s']
  unfold Mop
  exact Finset.sum_congr rfl fun s hs => by rw [chk_cnt s' hs' s (Finset.mem_range.mp hs)]

/-! The recurrence -/

theorem Mop_congr {f g : ℕ → ℕ} (h : ∀ s < 141, f s = g s) (s' : ℕ) : Mop f s' = Mop g s' := by
  unfold Mop
  exact Finset.sum_congr rfl fun s hs => by rw [h s (Finset.mem_range.mp hs)]

theorem Aop_congr {f g : ℕ → ℕ} (h : ∀ s < 140, f s = g s) : Aop f = Aop g := by
  unfold Aop
  exact Finset.sum_congr rfl fun s hs => by rw [h s (Finset.mem_range.mp hs)]

theorem Mop_add (f g : ℕ → ℕ) (s' : ℕ) : Mop (fun t => f t + g t) s' = Mop f s' + Mop g s' := by
  unfold Mop
  rw [← Finset.sum_add_distrib]
  exact Finset.sum_congr rfl fun _ _ => by ring

theorem Mop_smul (c : ℕ) (f : ℕ → ℕ) (s' : ℕ) : Mop (fun t => c * f t) s' = c * Mop f s' := by
  unfold Mop
  rw [Finset.mul_sum]
  exact Finset.sum_congr rfl fun _ _ => by ring

theorem Aop_add (f g : ℕ → ℕ) : Aop (fun t => f t + g t) = Aop f + Aop g := by
  unfold Aop
  rw [← Finset.sum_add_distrib]
  exact Finset.sum_congr rfl fun _ _ => by ring

theorem Aop_smul (c : ℕ) (f : ℕ → ℕ) : Aop (fun t => c * f t) = c * Aop f := by
  unfold Aop
  rw [Finset.mul_sum]
  exact Finset.sum_congr rfl fun _ _ => by ring

theorem N_small : ∀ m ≤ 17, ∀ s < 141, N m s = nv m s := by
  intro m
  induction m with
  | zero =>
    intro _ s hs
    rw [N_zero, chk_nv0 s hs]
  | succ m ih =>
    intro hm s hs
    rw [N_succ m s hs, Mop_congr (g := nv m) (fun s' hs' => ih (by omega) s' hs') s,
      chk_nv m (by omega) s hs]

theorem vec_rec (j : ℕ) : ∀ s < 141, 64 * N (j + 5) s + 348 * N (j + 9) s + 87 * N (j + 13) s +
    N (j + 17) s = 240 * N (j + 7) s + 245 * N (j + 11) s + 15 * N (j + 15) s := by
  induction j with
  | zero =>
    intro s hs
    simp only [Nat.zero_add]
    rw [N_small 5 (by norm_num) s hs, N_small 9 (by norm_num) s hs, N_small 13 (by norm_num) s hs,
      N_small 17 (by norm_num) s hs, N_small 7 (by norm_num) s hs, N_small 11 (by norm_num) s hs,
      N_small 15 (by norm_num) s hs]
    exact chk_base s hs
  | succ j ih =>
    intro s hs
    have e : ∀ k, N (j + 1 + k) s = Mop (N (j + k)) s := fun k => by
      rw [show j + 1 + k = (j + k) + 1 by omega]
      exact N_succ _ s hs
    rw [e 5, e 9, e 13, e 17, e 7, e 11, e 15]
    have hL : 64 * Mop (N (j + 5)) s + 348 * Mop (N (j + 9)) s + 87 * Mop (N (j + 13)) s +
        Mop (N (j + 17)) s = Mop (fun t => 64 * N (j + 5) t + 348 * N (j + 9) t +
          87 * N (j + 13) t + N (j + 17) t) s := by
      rw [Mop_add, Mop_add, Mop_add, Mop_smul, Mop_smul, Mop_smul]
    have hR : 240 * Mop (N (j + 7)) s + 245 * Mop (N (j + 11)) s + 15 * Mop (N (j + 15)) s =
        Mop (fun t => 240 * N (j + 7) t + 245 * N (j + 11) t + 15 * N (j + 15) t) s := by
      rw [Mop_add, Mop_add, Mop_smul, Mop_smul, Mop_smul]
    rw [hL, hR]
    exact Mop_congr ih s

theorem a_eq (n : ℕ) (hn : 1 ≤ n) : a n = Aop (N n) := by
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  exact a_succ m

theorem a_rec (j : ℕ) : 64 * a (j + 5) + 348 * a (j + 9) + 87 * a (j + 13) + a (j + 17) =
    240 * a (j + 7) + 245 * a (j + 11) + 15 * a (j + 15) := by
  rw [a_eq (j + 5) (by omega), a_eq (j + 9) (by omega), a_eq (j + 13) (by omega),
    a_eq (j + 17) (by omega), a_eq (j + 7) (by omega), a_eq (j + 11) (by omega),
    a_eq (j + 15) (by omega)]
  have hL : 64 * Aop (N (j + 5)) + 348 * Aop (N (j + 9)) + 87 * Aop (N (j + 13)) +
      Aop (N (j + 17)) = Aop (fun t => 64 * N (j + 5) t + 348 * N (j + 9) t +
        87 * N (j + 13) t + N (j + 17) t) := by
    rw [Aop_add, Aop_add, Aop_add, Aop_smul, Aop_smul, Aop_smul]
  have hR : 240 * Aop (N (j + 7)) + 245 * Aop (N (j + 11)) + 15 * Aop (N (j + 15)) =
      Aop (fun t => 240 * N (j + 7) t + 245 * N (j + 11) t + 15 * N (j + 15) t) := by
    rw [Aop_add, Aop_add, Aop_smul, Aop_smul, Aop_smul]
  rw [hL, hR]
  exact Aop_congr fun t ht => vec_rec j t (by omega)

theorem a_small (m : ℕ) (h1 : 1 ≤ m) (h2 : m ≤ 17) : a m = AV.getD m 0 := by
  rw [a_eq m h1, Aop_congr (fun s hs => N_small m h2 s (by omega)), chk_A m (by omega) h1]

/-- The closed form of the statement. -/
noncomputable def CF (n : ℕ) : ℚ := (2 * (1732 + 117 * (2 : ℚ) ^ n) + (-4084 + 279 * (2 : ℚ) ^ n) * (n : ℚ) +
      (484 + 9 * (2 : ℚ) ^ n) * (n : ℚ) ^ 2) / 8

theorem cf_rec (j : ℕ) : 64 * CF (j + 5) + 348 * CF (j + 9) + 87 * CF (j + 13) + CF (j + 17) =
    240 * CF (j + 7) + 245 * CF (j + 11) + 15 * CF (j + 15) := by
  unfold CF
  simp only [pow_add]
  push_cast
  ring

theorem a_zero : a 0 = 0 := by
  unfold a
  rw [if_pos rfl]

theorem closed (n : ℕ) (hn : 3 ≤ n) : (a n : ℚ) = CF n := by
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    have v1 : a 1 = 1 := (a_small 1 (by norm_num) (by norm_num)).trans rfl
    have v2 : a 2 = 60 := (a_small 2 (by norm_num) (by norm_num)).trans rfl
    have v3 : a 3 = 598 := (a_small 3 (by norm_num) (by norm_num)).trans rfl
    have v4 : a 4 = 2347 := (a_small 4 (by norm_num) (by norm_num)).trans rfl
    have v5 : a 5 = 6809 := (a_small 5 (by norm_num) (by norm_num)).trans rfl
    have v6 : a 6 = 17404 := (a_small 6 (by norm_num) (by norm_num)).trans rfl
    have v7 : a 7 = 41872 := (a_small 7 (by norm_num) (by norm_num)).trans rfl
    have v8 : a 8 = 97565 := (a_small 8 (by norm_num) (by norm_num)).trans rfl
    have v9 : a 9 = 223075 := (a_small 9 (by norm_num) (by norm_num)).trans rfl
    have v10 : a 10 = 503650 := (a_small 10 (by norm_num) (by norm_num)).trans rfl
    have v11 : a 11 = 1126490 := (a_small 11 (by norm_num) (by norm_num)).trans rfl
    have v12 : a 12 = 2500555 := (a_small 12 (by norm_num) (by norm_num)).trans rfl
    have v13 : a 13 = 5515189 := (a_small 13 (by norm_num) (by norm_num)).trans rfl
    have v14 : a 14 = 12096536 := (a_small 14 (by norm_num) (by norm_num)).trans rfl
    have v15 : a 15 = 26401012 := (a_small 15 (by norm_num) (by norm_num)).trans rfl
    have v16 : a 16 = 57368137 := (a_small 16 (by norm_num) (by norm_num)).trans rfl
    rcases Nat.lt_or_ge n 17 with h | h
    · interval_cases n <;> simp only [v3, v4, v5, v6, v7, v8, v9, v10, v11, v12, v13, v14, v15, v16] <;>
        norm_num [CF]
    · obtain ⟨j, rfl⟩ : ∃ j, n = j + 17 := ⟨n - 17, by omega⟩
      have hr : ((64 * a (j + 5) + 348 * a (j + 9) + 87 * a (j + 13) + a (j + 17) : ℕ) : ℚ) =
          ((240 * a (j + 7) + 245 * a (j + 11) + 15 * a (j + 15) : ℕ) : ℚ) := by
        rw [a_rec j]
      push_cast at hr
      rw [ih (j + 5) (by omega) (by omega), ih (j + 9) (by omega) (by omega),
        ih (j + 13) (by omega) (by omega), ih (j + 7) (by omega) (by omega),
        ih (j + 11) (by omega) (by omega), ih (j + 15) (by omega) (by omega)] at hr
      have hc := cf_rec j
      linarith

open PowerSeries in
theorem gen_fun :
    (PowerSeries.mk fun n => (a n : ℚ)) * ((1 - PowerSeries.X) ^ 3 * (1 - 2 * PowerSeries.X) ^ 3) =
      PowerSeries.X * (1 + 51 * PowerSeries.X + 91 * PowerSeries.X ^ 2 - 1118 * PowerSeries.X ^ 3 +
        1706 * PowerSeries.X ^ 4 - 176 * PowerSeries.X ^ 5 - 612 * PowerSeries.X ^ 6 -
        64 * PowerSeries.X ^ 7) := by
  have key : PowerSeries.mk (fun n => (a n : ℚ)) * ((1 - X) ^ 3 * (1 - 2 * X) ^ 3) =
      C 1 * (PowerSeries.mk (fun n => (a n : ℚ)) * X ^ 0) - C 9 * (PowerSeries.mk (fun n => (a n : ℚ)) * X ^ 1) +
        C 33 * (PowerSeries.mk (fun n => (a n : ℚ)) * X ^ 2) - C 63 * (PowerSeries.mk (fun n => (a n : ℚ)) * X ^ 3) +
        C 66 * (PowerSeries.mk (fun n => (a n : ℚ)) * X ^ 4) - C 36 * (PowerSeries.mk (fun n => (a n : ℚ)) * X ^ 5) +
        C 8 * (PowerSeries.mk (fun n => (a n : ℚ)) * X ^ 6) := by
    simp only [map_one, map_ofNat]
    ring
  have hrhs : (X : ℚ⟦X⟧) * (1 + 51 * X + 91 * X ^ 2 - 1118 * X ^ 3 + 1706 * X ^ 4 - 176 * X ^ 5 -
      612 * X ^ 6 - 64 * X ^ 7) =
      C 1 * X ^ 1 + C 51 * X ^ 2 + C 91 * X ^ 3 - C 1118 * X ^ 4 + C 1706 * X ^ 5 -
        C 176 * X ^ 6 - C 612 * X ^ 7 - C 64 * X ^ 8 := by
    simp only [map_one, map_ofNat]
    ring
  rw [key, hrhs]
