import OMAStatements.S_oeis_a229750
import Mathlib

/-!
Proof of the g.f. and closed form of A229750 (n X 3 0..3 arrays in row-major order with
exactly two mistakes, a mistake being a king-move neighbour with the same value).

Rows and mistakes. `mistakes_eq` rewrites the statement's count as a sum of `mr` over the rows
(equal horizontal neighbours) plus a sum of `mb` over consecutive row pairs (equal vertical and
diagonal neighbours); appending a row `x` below `A` adds `mr x + mb (last row of A) x`
(`mistakes_snoc`). `rm_iff` restates `isRowMajor` cell by cell, and appending a row keeps the
condition iff every value below an entry of the new row occurs above it or earlier in the row
(`rm_snoc`).

Automaton. A row is coded by `rc x < 64`. The 140 live states record the code of the last row,
the mask of the values used so far and the number of mistakes (at most two); 140 is the initial
state and 141 the dead state. The transition table `TT` is checked against the definitions by
the kernel (`chk_init`, `chk_step`), and `run_spec` shows that the state after reading an array
records exactly these data, or is dead once the array is not row-major or has three mistakes.

Counting. `N m s` counts arrays with `m` rows ending in state `s`; `N (m + 1) = Mop (N m)` with the
transfer matrix `cnt` (`N_succ`) and `a (m + 1)` is the number of arrays ending in a live state
with two mistakes (`a_succ`). The kernel computes `N m` for `m <= 17` (`N_small`, through the
column table `CMT` and dot products) and checks the vector identity of the polynomial
`(x^2 - 1)^3 (x^2 - 4)^3` at `m = 5`; by linearity it holds for every `m >= 5` (`vec_rec`), hence
the same recurrence for `a` (`a_rec`). The closed form satisfies it as well (`cf_rec`), which gives
the closed form for every `n >= 3` (`closed`) and then the g.f. (`gen_fun`).
-/

namespace OMA.Helpers
open OMA.S_oeis_a229750 Finset


abbrev Row := Fin 3 → Fin 4

def eqi (a b : Fin 4) : ℕ := if a = b then 1 else 0

def mr (x : Row) : ℕ := eqi (x 0) (x 1) + eqi (x 1) (x 2)

def mb (x y : Row) : ℕ := eqi (x 0) (y 0) + eqi (x 1) (y 1) + eqi (x 2) (y 2) +
  (eqi (x 0) (y 1) + eqi (x 1) (y 2)) + (eqi (x 1) (y 0) + eqi (x 2) (y 1))

theorem rowsum (x : Row) :
    (∑ c : Fin 2, if x ⟨c.1, by omega⟩ = x ⟨c.1 + 1, by omega⟩ then 1 else 0) = mr x := by
  simp only [Fin.sum_univ_two, mr, eqi]
  rfl

theorem pairsum (x y : Row) :
    ((∑ c : Fin 3, if x c = y c then 1 else 0) +
     (∑ c : Fin 2, if x ⟨c.1, by omega⟩ = y ⟨c.1 + 1, by omega⟩ then 1 else 0) +
     (∑ c : Fin 2, if x ⟨c.1 + 1, by omega⟩ = y ⟨c.1, by omega⟩ then 1 else 0)) = mb x y := by
  simp only [Fin.sum_univ_two, Fin.sum_univ_three, mb, eqi]
  rfl

theorem mistakes_eq (n : ℕ) (A : Fin n → Row) :
    mistakes n A = (∑ r : Fin n, mr (A r)) +
      ∑ r : Fin (n - 1), mb (A ⟨r.1, by omega⟩) (A ⟨r.1 + 1, by omega⟩) := by
  unfold mistakes
  simp only [rowsum, pairsum]

theorem mistakes_one (A : Fin 1 → Row) : mistakes 1 A = mr (A 0) := by
  rw [mistakes_eq, Fin.sum_univ_one]
  have : (∑ r : Fin (1 - 1), mb (A ⟨r.1, by omega⟩) (A ⟨r.1 + 1, by omega⟩)) = 0 :=
    Finset.sum_eq_zero fun r _ => (Fin.elim0 (r : Fin 0))
  rw [this, add_zero]

theorem snoc_lt {m : ℕ} (A : Fin (m + 1) → Row) (x : Row) (i : ℕ) (h : i < m + 2)
    (h' : i < m + 1) : (Fin.snoc A x : Fin (m + 2) → Row) ⟨i, h⟩ = A ⟨i, h'⟩ := by
  have : (⟨i, h⟩ : Fin (m + 2)) = Fin.castSucc ⟨i, h'⟩ := rfl
  rw [this, Fin.snoc_castSucc]

theorem snoc_at_last {m : ℕ} (A : Fin (m + 1) → Row) (x : Row) (h : m + 1 < m + 2) :
    (Fin.snoc A x : Fin (m + 2) → Row) ⟨m + 1, h⟩ = x := by
  have : (⟨m + 1, h⟩ : Fin (m + 2)) = Fin.last (m + 1) := rfl
  rw [this, Fin.snoc_last]

theorem vs_snoc (m : ℕ) (A : Fin (m + 1) → Row) (x : Row) :
    (∑ r : Fin (m + 2 - 1), mb ((Fin.snoc A x : Fin (m + 2) → Row) ⟨r.1, by omega⟩)
      ((Fin.snoc A x : Fin (m + 2) → Row) ⟨r.1 + 1, by omega⟩)) =
    (∑ r : Fin (m + 1 - 1), mb (A ⟨r.1, by omega⟩) (A ⟨r.1 + 1, by omega⟩)) +
      mb (A (Fin.last m)) x := by
  show (∑ r : Fin (m + 1), _) = _
  rw [Fin.sum_univ_castSucc (n := m)]
  congr 1
  · refine Finset.sum_congr rfl fun r _ => ?_
    simp only [Fin.val_castSucc]
    rw [snoc_lt A x r.1 (by omega) (by omega), snoc_lt A x (r.1 + 1) (by omega) (by omega)]
  · simp only [Fin.val_last]
    rw [snoc_lt A x m (by omega) (by omega), snoc_at_last A x (by omega)]
    rfl

theorem mistakes_snoc (m : ℕ) (A : Fin (m + 1) → Row) (x : Row) :
    mistakes (m + 2) (Fin.snoc A x : Fin (m + 2) → Row) =
      mistakes (m + 1) A + mr x + mb (A (Fin.last m)) x := by
  rw [mistakes_eq, mistakes_eq]
  erw [vs_snoc]
  rw [Fin.sum_univ_castSucc (n := m + 1)]
  simp only [Fin.snoc_castSucc, Fin.snoc_last]
  ring

/-- The value `v` occurs somewhere in `A`. -/
def Used {n : ℕ} (A : Fin n → Row) (v : ℕ) : Prop := ∃ r : Fin n, ∃ c : Fin 3, (A r c).val = v

/-- Every value below an entry of `x` occurs in `P` or earlier in `x`. -/
def OkRow (P : ℕ → Prop) (x : Row) : Prop :=
  ∀ c : Fin 3, ∀ v : ℕ, v < (x c).val → P v ∨ ∃ c' : Fin 3, c' < c ∧ (x c').val = v

theorem cell_congr {n : ℕ} (A : Fin n → Row) {a b a' b' : ℕ} (ha : a < n) (hb : b < 3)
    (ha' : a' < n) (hb' : b' < 3) (e1 : a = a') (e2 : b = b') :
    A ⟨a, ha⟩ ⟨b, hb⟩ = A ⟨a', ha'⟩ ⟨b', hb'⟩ := by
  subst e1
  subst e2
  rfl

theorem rm_iff (n : ℕ) (A : Fin n → Row) : isRowMajor n A ↔
    ∀ r : Fin n, ∀ c : Fin 3, ∀ v : ℕ, v < (A r c).val →
      (∃ r' : Fin n, r' < r ∧ ∃ c' : Fin 3, (A r' c').val = v) ∨
        (∃ c' : Fin 3, c' < c ∧ (A r c').val = v) := by
  unfold isRowMajor
  constructor
  · intro h r c v hv
    have hi : 3 * r.1 + c.1 < 3 * n := by omega
    have e := cell_congr A (a := (3 * r.1 + c.1) / 3) (b := (3 * r.1 + c.1) % 3) (by omega)
      (by omega) r.isLt c.isLt (by omega) (by omega)
    obtain ⟨j, hj, hjv⟩ := h ⟨3 * r.1 + c.1, hi⟩ v (by rw [e]; exact hv)
    have hj' : j.1 < 3 * r.1 + c.1 := hj
    by_cases hlt : j.1 / 3 < r.1
    · left
      exact ⟨⟨j.1 / 3, by omega⟩, hlt, ⟨j.1 % 3, by omega⟩, hjv⟩
    · right
      refine ⟨⟨j.1 % 3, by omega⟩, ?_, ?_⟩
      · show j.1 % 3 < c.1
        omega
      · rw [← hjv]
        exact congrArg Fin.val (cell_congr A r.isLt _ _ _ (by omega) rfl)
  · intro h i v hv
    rcases h ⟨i.1 / 3, by omega⟩ ⟨i.1 % 3, by omega⟩ v hv with ⟨r', hr', c', hc'⟩ | ⟨c', hc', hv'⟩
    · refine ⟨⟨3 * r'.1 + c'.1, by omega⟩, ?_, ?_⟩
      · show 3 * r'.1 + c'.1 < i.1
        have : r'.1 < i.1 / 3 := hr'
        omega
      · rw [← hc']
        exact congrArg Fin.val (cell_congr A (a := (3 * r'.1 + c'.1) / 3)
          (b := (3 * r'.1 + c'.1) % 3) (by omega) (by omega) r'.isLt c'.isLt (by omega) (by omega))
    · refine ⟨⟨3 * (i.1 / 3) + c'.1, by omega⟩, ?_, ?_⟩
      · show 3 * (i.1 / 3) + c'.1 < i.1
        have : c'.1 < i.1 % 3 := hc'
        omega
      · rw [← hv']
        exact congrArg Fin.val (cell_congr A (a := (3 * (i.1 / 3) + c'.1) / 3)
          (b := (3 * (i.1 / 3) + c'.1) % 3) (a' := i.1 / 3) (by omega) (by omega) (by omega)
          c'.isLt (by omega) (by omega))

theorem last_not_lt {m : ℕ} (i : Fin m) : ¬ (Fin.last m < i.castSucc) :=
  not_lt.mpr (Fin.le_last _)

theorem rm_snoc (m : ℕ) (A : Fin m → Row) (x : Row) :
    isRowMajor (m + 1) (Fin.snoc A x : Fin (m + 1) → Row) ↔ isRowMajor m A ∧ OkRow (Used A) x := by
  rw [rm_iff, rm_iff, Fin.forall_fin_succ']
  unfold OkRow Used
  simp only [Fin.exists_fin_succ', Fin.snoc_castSucc, Fin.snoc_last, Fin.castSucc_lt_castSucc_iff,
    Fin.castSucc_lt_last, true_and, last_not_lt, lt_irrefl, false_and, or_false]


theorem used_snoc {m : ℕ} (A : Fin m → Row) (x : Row) (v : ℕ) :
    Used (Fin.snoc A x : Fin (m + 1) → Row) v ↔ Used A v ∨ ∃ c : Fin 3, (x c).val = v := by
  unfold Used
  rw [Fin.exists_fin_succ']
  simp only [Fin.snoc_castSucc, Fin.snoc_last]

theorem used_zero (A : Fin 0 → Row) (v : ℕ) : ¬ Used A v := by
  rintro ⟨r, _, _⟩
  exact Fin.elim0 r

theorem rm_zero (A : Fin 0 → Row) : isRowMajor 0 A := by
  rw [rm_iff]
  intro r
  exact Fin.elim0 r

theorem ex3 (P : Fin 3 → Prop) : (∃ c : Fin 3, P c) ↔ P 0 ∨ P 1 ∨ P 2 := by
  constructor
  · rintro ⟨c, hc⟩
    fin_cases c
    · exact Or.inl hc
    · exact Or.inr (Or.inl hc)
    · exact Or.inr (Or.inr hc)
  · rintro (h | h | h)
    · exact ⟨_, h⟩
    · exact ⟨_, h⟩
    · exact ⟨_, h⟩

theorem okRow_iff (P : ℕ → Prop) (x : Row) : OkRow P x ↔
    (∀ v < (x 0).val, P v) ∧ (∀ v < (x 1).val, P v ∨ (x 0).val = v) ∧
      (∀ v < (x 2).val, P v ∨ (x 0).val = v ∨ (x 1).val = v) := by
  unfold OkRow
  constructor
  · intro h
    refine ⟨fun v hv => ?_, fun v hv => ?_, fun v hv => ?_⟩
    · rcases h 0 v hv with h1 | ⟨c', hc', _⟩
      · exact h1
      · exact absurd hc' (Fin.not_lt_zero c')
    · rcases h 1 v hv with h1 | ⟨c', hc', h2⟩
      · exact Or.inl h1
      · have : c' = 0 := Fin.ext (by have := Fin.lt_def.mp hc'; simp at this ⊢; omega)
        subst this
        exact Or.inr h2
    · rcases h 2 v hv with h1 | ⟨c', hc', h2⟩
      · exact Or.inl h1
      · have hc2 : c'.val < 2 := Fin.lt_def.mp hc'
        rcases (show c' = 0 ∨ c' = 1 by
          rcases c' with ⟨k, hk⟩
          interval_cases k
          · exact Or.inl rfl
          · exact Or.inr rfl) with rfl | rfl
        · exact Or.inr (Or.inl h2)
        · exact Or.inr (Or.inr h2)
  · rintro ⟨h0, h1, h2⟩ c v hv
    fin_cases c
    · exact Or.inl (h0 v hv)
    · rcases h1 v hv with h | h
      · exact Or.inl h
      · exact Or.inr ⟨0, by decide, h⟩
    · rcases h2 v hv with h | h | h
      · exact Or.inl h
      · exact Or.inr ⟨0, by decide, h⟩
      · exact Or.inr ⟨1, by decide, h⟩

/-! Codes -/

def rc (x : Row) : ℕ := 16 * (x 0).val + 4 * (x 1).val + (x 2).val

def d0 (p : ℕ) : ℕ := p / 16
def d1 (p : ℕ) : ℕ := p / 4 % 4
def d2 (p : ℕ) : ℕ := p % 4

theorem rc_lt (x : Row) : rc x < 64 := by
  unfold rc
  have := (x 0).isLt
  have := (x 1).isLt
  have := (x 2).isLt
  omega

theorem d0_rc (x : Row) : d0 (rc x) = (x 0).val := by
  unfold d0 rc
  have := (x 0).isLt
  have := (x 1).isLt
  have := (x 2).isLt
  omega

theorem d1_rc (x : Row) : d1 (rc x) = (x 1).val := by
  unfold d1 rc
  have := (x 0).isLt
  have := (x 1).isLt
  have := (x 2).isLt
  omega

theorem d2_rc (x : Row) : d2 (rc x) = (x 2).val := by
  unfold d2 rc
  have := (x 0).isLt
  have := (x 1).isLt
  have := (x 2).isLt
  omega

def rowOf (c : ℕ) : Row := fun j =>
  ⟨(if j.val = 0 then c / 16 else if j.val = 1 then c / 4 else c) % 4, Nat.mod_lt _ (by norm_num)⟩

theorem rowOf_rc (x : Row) : rowOf (rc x) = x := by
  funext j
  apply Fin.ext
  have := (x 0).isLt
  have := (x 1).isLt
  have := (x 2).isLt
  fin_cases j <;> simp [rowOf, rc] <;> omega

theorem rc_rowOf (c : ℕ) (hc : c < 64) : rc (rowOf c) = c := by
  simp [rc, rowOf]
  omega

def eqb (a b : ℕ) : ℕ := if a = b then 1 else 0

theorem eqi_eq (a b : Fin 4) : eqi a b = eqb a.val b.val := by
  unfold eqi eqb
  simp only [Fin.val_inj]

def mrC (p : ℕ) : ℕ := eqb (d0 p) (d1 p) + eqb (d1 p) (d2 p)

def mbC (p q : ℕ) : ℕ := eqb (d0 p) (d0 q) + eqb (d1 p) (d1 q) + eqb (d2 p) (d2 q) +
  (eqb (d0 p) (d1 q) + eqb (d1 p) (d2 q)) + (eqb (d1 p) (d0 q) + eqb (d2 p) (d1 q))

theorem mr_code (x : Row) : mr x = mrC (rc x) := by
  simp only [mr, mrC, eqi_eq, d0_rc, d1_rc, d2_rc]

theorem mb_code (x y : Row) : mb x y = mbC (rc x) (rc y) := by
  simp only [mb, mbC, eqi_eq, d0_rc, d1_rc, d2_rc]

def bitP (mk v : ℕ) : Prop := mk / 2 ^ v % 2 = 1

instance (mk v : ℕ) : Decidable (bitP mk v) := by
  unfold bitP
  infer_instance

def okC (mk p : ℕ) : Prop :=
  (∀ v < d0 p, bitP mk v) ∧ (∀ v < d1 p, bitP mk v ∨ d0 p = v) ∧
    (∀ v < d2 p, bitP mk v ∨ d0 p = v ∨ d1 p = v)

instance (mk p : ℕ) : Decidable (okC mk p) := by
  unfold okC
  infer_instance

theorem okRow_code (P : ℕ → Prop) (mk : ℕ) (hP : ∀ v < 4, (P v ↔ bitP mk v)) (x : Row) :
    OkRow P x ↔ okC mk (rc x) := by
  rw [okRow_iff, okC, d0_rc, d1_rc, d2_rc]
  have h0 := (x 0).isLt
  have h1 := (x 1).isLt
  have h2 := (x 2).isLt
  refine and_congr ?_ (and_congr ?_ ?_)
  · exact forall₂_congr fun v hv => hP v (by omega)
  · exact forall₂_congr fun v hv => or_congr_left (hP v (by omega))
  · exact forall₂_congr fun v hv => or_congr_left (hP v (by omega))

