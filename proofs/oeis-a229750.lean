def dR (s : ℕ) : ℕ := DR.getD s 0
def dM (s : ℕ) : ℕ := DM.getD s 0
def dK (s : ℕ) : ℕ := DK.getD s 0

/-- The transition function on state codes; 140 is the initial state, 141 the dead state. -/
def δ (s c : ℕ) : ℕ := (TT.getD s []).getD c 141

/-- The state reached after reading the rows of `β` from the top. -/
def run : (m : ℕ) → (Fin m → Row) → ℕ
  | 0, _ => 140
  | m + 1, β => δ (run m (Fin.init β)) (rc (β (Fin.last m)))

/-- Bounded universal quantifier as a boolean. -/
def allB : ℕ → (ℕ → Bool) → Bool
  | 0, _ => true
  | n + 1, f => allB n f && f n

theorem allB_iff (n : ℕ) (f : ℕ → Bool) : allB n f = true ↔ ∀ v < n, f v = true := by
  induction n with
  | zero => simp [allB]
  | succ n ih =>
    simp only [allB, Bool.and_eq_true, ih]
    constructor
    · rintro ⟨h1, h2⟩ v hv
      rcases Nat.lt_succ_iff_lt_or_eq.mp hv with h | h
      · exact h1 v h
      · subst h
        exact h2
    · intro h
      exact ⟨fun v hv => h v (by omega), h n (by omega)⟩

def bitB (mk v : ℕ) : Bool := Nat.beq (mk / 2 ^ v % 2) 1

theorem bitB_iff (mk v : ℕ) : bitB mk v = true ↔ bitP mk v := by
  simp [bitB, bitP]

def okB (mk p : ℕ) : Bool :=
  allB (d0 p) (fun v => bitB mk v) && allB (d1 p) (fun v => bitB mk v || Nat.beq (d0 p) v) &&
    allB (d2 p) (fun v => bitB mk v || Nat.beq (d0 p) v || Nat.beq (d1 p) v)

theorem okB_iff (mk p : ℕ) : okB mk p = true ↔ okC mk p := by
  simp only [okB, okC, Bool.and_eq_true, allB_iff, Bool.or_eq_true, bitB_iff, Nat.beq_eq, or_assoc,
    and_assoc]

def maskB (m' mk c : ℕ) : Bool :=
  allB 4 (fun v => bitB m' v == (bitB mk v || Nat.beq (d0 c) v || Nat.beq (d1 c) v || Nat.beq (d2 c) v))

theorem maskB_iff (m' mk c : ℕ) : maskB m' mk c = true ↔
    ∀ v < 4, (bitP m' v ↔ (bitP mk v ∨ d0 c = v ∨ d1 c = v ∨ d2 c = v)) := by
  rw [maskB, allB_iff]
  refine forall₂_congr fun v _ => ?_
  rw [beq_iff_eq, Bool.eq_iff_iff]
  simp only [Bool.or_eq_true, bitB_iff, Nat.beq_eq, or_assoc]

/-- The kernel check of one transition. -/
def stepB (mk kc s c : ℕ) : Bool :=
  if (okB mk c && Nat.ble kc 2) then
    (Nat.blt (δ s c) 140 && Nat.beq (dR (δ s c)) c && maskB (dM (δ s c)) mk c &&
      Nat.beq (dK (δ s c)) kc)
  else Nat.beq (δ s c) 141

theorem stepB_sound (mk kc s c : ℕ) (h : stepB mk kc s c = true) :
    (okC mk c ∧ kc ≤ 2 → δ s c < 140 ∧ dR (δ s c) = c ∧
      (∀ v < 4, (bitP (dM (δ s c)) v ↔ (bitP mk v ∨ d0 c = v ∨ d1 c = v ∨ d2 c = v))) ∧
      dK (δ s c) = kc) ∧
    (¬ (okC mk c ∧ kc ≤ 2) → δ s c = 141) := by
  unfold stepB at h
  have hcond : (okB mk c && Nat.ble kc 2) = true ↔ (okC mk c ∧ kc ≤ 2) := by
    simp only [Bool.and_eq_true, okB_iff, Nat.ble_eq]
  by_cases hc : (okB mk c && Nat.ble kc 2) = true
  · rw [if_pos hc] at h
    simp only [Bool.and_eq_true, Nat.blt_eq, Nat.beq_eq, maskB_iff] at h
    obtain ⟨⟨⟨h1, h2⟩, h3⟩, h4⟩ := h
    exact ⟨fun _ => ⟨h1, h2, h3, h4⟩, fun hn => absurd (hcond.mp hc) hn⟩
  · rw [if_neg hc] at h
    simp only [Nat.beq_eq] at h
    exact ⟨fun hh => absurd (hcond.mpr hh) hc, fun _ => h⟩

def InitP (c : ℕ) : Prop :=
    (okC 0 c ∧ mrC c ≤ 2 → δ 140 c < 140 ∧ dR (δ 140 c) = c ∧
      (∀ v < 4, (bitP (dM (δ 140 c)) v ↔ (bitP 0 v ∨ d0 c = v ∨ d1 c = v ∨ d2 c = v))) ∧
      dK (δ 140 c) = mrC c) ∧
    (¬ (okC 0 c ∧ mrC c ≤ 2) → δ 140 c = 141)

def StepP (s c : ℕ) : Prop :=
    (okC (dM s) c ∧ dK s + mrC c + mbC (dR s) c ≤ 2 → δ s c < 140 ∧ dR (δ s c) = c ∧
      (∀ v < 4, (bitP (dM (δ s c)) v ↔ (bitP (dM s) v ∨ d0 c = v ∨ d1 c = v ∨ d2 c = v))) ∧
      dK (δ s c) = dK s + mrC c + mbC (dR s) c) ∧
    (¬ (okC (dM s) c ∧ dK s + mrC c + mbC (dR s) c ≤ 2) → δ s c = 141)

theorem chk_initB : allB 64 (fun c => stepB 0 (mrC c) 140 c) = true := by
  decide +kernel

theorem chk_init (c : ℕ) (hc : c < 64) : InitP c :=
  stepB_sound 0 (mrC c) 140 c ((allB_iff _ _).mp chk_initB c hc)

theorem chk_step0 : allB 35 (fun i => allB 64 (fun c =>
    stepB (dM (35 * 0 + i)) (dK (35 * 0 + i) + mrC c + mbC (dR (35 * 0 + i)) c)
      (35 * 0 + i) c)) = true := by
  decide +kernel

theorem chk_step1 : allB 35 (fun i => allB 64 (fun c =>
    stepB (dM (35 * 1 + i)) (dK (35 * 1 + i) + mrC c + mbC (dR (35 * 1 + i)) c)
      (35 * 1 + i) c)) = true := by
  decide +kernel

theorem chk_step2 : allB 35 (fun i => allB 64 (fun c =>
    stepB (dM (35 * 2 + i)) (dK (35 * 2 + i) + mrC c + mbC (dR (35 * 2 + i)) c)
      (35 * 2 + i) c)) = true := by
  decide +kernel

theorem chk_step3 : allB 35 (fun i => allB 64 (fun c =>
    stepB (dM (35 * 3 + i)) (dK (35 * 3 + i) + mrC c + mbC (dR (35 * 3 + i)) c)
      (35 * 3 + i) c)) = true := by
  decide +kernel

theorem chk_step (s : ℕ) (hs : s < 140) (c : ℕ) (hc : c < 64) : StepP s c := by
  obtain ⟨k, i, hi, rfl⟩ : ∃ k i, i < 35 ∧ s = 35 * k + i :=
    ⟨s / 35, s % 35, Nat.mod_lt _ (by norm_num), (Nat.div_add_mod s 35).symm⟩
  have hk : k < 4 := by omega
  apply stepB_sound (dM (35 * k + i)) (dK (35 * k + i) + mrC c + mbC (dR (35 * k + i)) c)
  interval_cases k
  · exact (allB_iff _ _).mp ((allB_iff _ _).mp chk_step0 i hi) c hc
  · exact (allB_iff _ _).mp ((allB_iff _ _).mp chk_step1 i hi) c hc
  · exact (allB_iff _ _).mp ((allB_iff _ _).mp chk_step2 i hi) c hc
  · exact (allB_iff _ _).mp ((allB_iff _ _).mp chk_step3 i hi) c hc

theorem δ_dead (c : ℕ) : δ 141 c = 141 := rfl

theorem bit_zero (v : ℕ) : ¬ bitP 0 v := by
  unfold bitP
  simp

/-- Arrays that are row-major with at most two mistakes. -/
def Good (n : ℕ) (A : Fin n → Row) : Prop := isRowMajor n A ∧ mistakes n A ≤ 2

theorem used_code {m : ℕ} (A : Fin m → Row) (x : Row) (mk : ℕ)
    (hA : ∀ v < 4, (Used A v ↔ bitP mk v)) (v : ℕ) (hv : v < 4) :
    Used (Fin.snoc A x : Fin (m + 1) → Row) v ↔
      (bitP mk v ∨ d0 (rc x) = v ∨ d1 (rc x) = v ∨ d2 (rc x) = v) := by
  rw [used_snoc, ex3, d0_rc, d1_rc, d2_rc, hA v hv]

theorem run_spec : ∀ (m : ℕ) (β : Fin (m + 1) → Row),
    (Good (m + 1) β → run (m + 1) β < 140 ∧ dR (run (m + 1) β) = rc (β (Fin.last m)) ∧
      (∀ v < 4, (Used β v ↔ bitP (dM (run (m + 1) β)) v)) ∧
      dK (run (m + 1) β) = mistakes (m + 1) β) ∧
    (¬ Good (m + 1) β → run (m + 1) β = 141) := by
  intro m
  induction m with
  | zero =>
    intro β
    set A := Fin.init β with hAdef
    set x := β (Fin.last 0) with hx
    have hβ : β = Fin.snoc A x := (Fin.snoc_init_self β).symm
    have hrun : run 1 β = δ 140 (rc x) := rfl
    have hP : ∀ v < 4, (Used A v ↔ bitP 0 v) := fun v _ =>
      ⟨fun h => absurd h (used_zero A v), fun h => absurd h (bit_zero v)⟩
    have hgood : Good 1 β ↔ okC 0 (rc x) ∧ mrC (rc x) ≤ 2 := by
      unfold Good
      rw [mistakes_one, show β 0 = x from rfl, mr_code, hβ, rm_snoc,
        okRow_code (Used A) 0 hP x]
      simp only [rm_zero, true_and]
    obtain ⟨c1, c2⟩ := chk_init (rc x) (rc_lt x)
    rw [hgood, hrun]
    refine ⟨fun h => ?_, c2⟩
    obtain ⟨e1, e2, e3, e4⟩ := c1 h
    refine ⟨e1, e2, fun v hv => ?_, ?_⟩
    · rw [e3 v hv, hβ, used_code A x 0 hP v hv]
    · rw [e4, mistakes_one, show β 0 = x from rfl, mr_code]
  | succ m ih =>
    intro β
    set A := Fin.init β with hAdef
    set x := β (Fin.last (m + 1)) with hx
    have hβ : β = Fin.snoc A x := (Fin.snoc_init_self β).symm
    have hrun : run (m + 2) β = δ (run (m + 1) A) (rc x) := rfl
    have hmis : mistakes (m + 2) β = mistakes (m + 1) A + mr x + mb (A (Fin.last m)) x := by
      rw [hβ, mistakes_snoc]
    obtain ⟨ih1, ih2⟩ := ih A
    by_cases hA : Good (m + 1) A
    · obtain ⟨e1, e2, e3, e4⟩ := ih1 hA
      set s := run (m + 1) A with hs
      have hgood : Good (m + 2) β ↔ okC (dM s) (rc x) ∧ dK s + mrC (rc x) + mbC (dR s) (rc x) ≤ 2 := by
        unfold Good
        rw [hmis, e4, e2, mr_code, mb_code, hβ, rm_snoc, okRow_code (Used A) (dM s) e3 x]
        simp only [hA.1, true_and]
      obtain ⟨c1, c2⟩ := chk_step s e1 (rc x) (rc_lt x)
      rw [hgood, hrun]
      refine ⟨fun h => ?_, c2⟩
      obtain ⟨f1, f2, f3, f4⟩ := c1 h
      refine ⟨f1, f2, fun v hv => ?_, ?_⟩
      · rw [f3 v hv, hβ, used_code A x (dM s) e3 v hv]
      · rw [f4, hmis, e4, e2, mr_code, mb_code]
    · have hd := ih2 hA
      rw [hrun, hd, δ_dead]
      refine ⟨fun h => absurd ?_ hA, fun _ => rfl⟩
      obtain ⟨h1, h2⟩ := h
      rw [hβ, rm_snoc] at h1
      refine ⟨h1.1, ?_⟩
      rw [hmis] at h2
      omega

/-! Counting -/

theorem card_eq_sum {α : Type*} [Fintype α] [DecidableEq α] (I : Finset α) :
    I.card = ∑ x, if x ∈ I then 1 else 0 := by
  rw [← Finset.card_filter, Finset.filter_univ_mem]

theorem sum_snoc (m : ℕ) (F : (Fin m → Row) → Row → ℕ) :
    ∑ B : Fin (m + 1) → Row, F (Fin.init B) (B (Fin.last m)) =
      ∑ β : Fin m → Row, ∑ γ : Row, F β γ := by
  calc ∑ B : Fin (m + 1) → Row, F (Fin.init B) (B (Fin.last m))
      = ∑ p : Row × (Fin m → Row), F p.2 p.1 :=
        (Fintype.sum_equiv (Fin.snocEquiv (fun _ => Row)) (fun p => F p.2 p.1) _
          (fun p => by
            rw [show (Fin.snocEquiv (fun _ => Row)) p = Fin.snoc p.2 p.1 from rfl,
              Fin.init_snoc, Fin.snoc_last])).symm
    _ = ∑ γ : Row, ∑ β : Fin m → Row, F β γ := Fintype.sum_prod_type' (fun γ β => F β γ)
    _ = ∑ β : Fin m → Row, ∑ γ : Row, F β γ := Finset.sum_comm

theorem sum_row (F : ℕ → ℕ) : ∑ γ : Row, F (rc γ) = ∑ c ∈ range 64, F c :=
  Finset.sum_nbij' rc rowOf (fun γ _ => Finset.mem_range.mpr (rc_lt γ))
    (fun _ _ => Finset.mem_univ _) (fun γ _ => rowOf_rc γ)
    (fun c hc => rc_rowOf c (Finset.mem_range.mp hc)) (fun _ _ => rfl)

theorem sum_fiber {X : Type*} [Fintype X] (r : X → ℕ) (hr : ∀ x, r x < 142) (h : ℕ → ℕ) :
    ∑ x, h (r x) = ∑ s ∈ range 142, (∑ x, if r x = s then 1 else 0) * h s := by
  simp only [Finset.sum_mul, ite_mul, one_mul, zero_mul]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun x _ => ?_
  rw [Finset.sum_ite_eq, if_pos (Finset.mem_range.mpr (hr x))]

theorem chk_lt0 : allB 47 (fun i => allB 64 (fun c => Nat.blt (δ (47 * 0 + i) c) 142)) = true := by
  decide +kernel

theorem chk_lt1 : allB 47 (fun i => allB 64 (fun c => Nat.blt (δ (47 * 1 + i) c) 142)) = true := by
  decide +kernel

theorem chk_lt2 : allB 47 (fun i => allB 64 (fun c => Nat.blt (δ (47 * 2 + i) c) 142)) = true := by
  decide +kernel

theorem chk_lt (s : ℕ) (hs : s < 141) (c : ℕ) (hc : c < 64) : δ s c < 142 := by
  obtain ⟨k, i, hi, rfl⟩ : ∃ k i, i < 47 ∧ s = 47 * k + i :=
    ⟨s / 47, s % 47, Nat.mod_lt _ (by norm_num), (Nat.div_add_mod s 47).symm⟩
  have hk : k < 3 := by omega
  interval_cases k
  · exact Nat.blt_eq.mp ((allB_iff _ _).mp ((allB_iff _ _).mp chk_lt0 i hi) c hc)
  · exact Nat.blt_eq.mp ((allB_iff _ _).mp ((allB_iff _ _).mp chk_lt1 i hi) c hc)
  · exact Nat.blt_eq.mp ((allB_iff _ _).mp ((allB_iff _ _).mp chk_lt2 i hi) c hc)


theorem chk_lenB : allB 141 (fun s => Nat.beq (TT.getD s []).length 64) = true := by
  decide +kernel

theorem chk_len (s : ℕ) (hs : s < 141) : (TT.getD s []).length = 64 :=
  Nat.beq_eq.mp ((allB_iff _ _).mp chk_lenB s hs)

theorem δ_lt (s c : ℕ) : δ s c < 142 := by
  by_cases hs : s < 141
  · by_cases hc : c < 64
    · exact chk_lt s hs c hc
    · unfold δ
      rw [List.getD_eq_default _ _ (by rw [chk_len s hs]; omega)]
      norm_num
  · unfold δ
    rw [List.getD_eq_default TT [] (by rw [show TT.length = 141 from rfl]; omega)]
    norm_num

theorem run_lt : ∀ (m : ℕ) (β : Fin m → Row), run m β < 142
  | 0, _ => by
    show 140 < 142
    norm_num
  | _ + 1, _ => δ_lt _ _

/-- The number of entries of a list equal to `a`. -/
def cntL (a : ℕ) : List ℕ → ℕ
  | [] => 0
  | x :: xs => (if x = a then 1 else 0) + cntL a xs

theorem sum_getD_cnt (l : List ℕ) (d t : ℕ) :
    ∑ c ∈ range l.length, (if l.getD c d = t then 1 else 0) = cntL t l := by
  induction l with
  | nil => simp [cntL]
  | cons a l ih =>
    rw [List.length_cons, Finset.sum_range_succ']
    simp only [List.getD_cons_succ, List.getD_cons_zero, ih, cntL]
    ring

/-- The number of row codes leading from `s` to `s'`. -/
def cnt (s s' : ℕ) : ℕ := cntL s' (TT.getD s [])

/-- The number of arrays with `m` rows whose run ends in state `s`. -/
noncomputable def N (m s : ℕ) : ℕ := ∑ β : Fin m → Row, if run m β = s then 1 else 0

def Mop (f : ℕ → ℕ) (s' : ℕ) : ℕ := ∑ s ∈ range 141, f s * cnt s s'

def w (s : ℕ) : ℕ := if dK s = 2 then 1 else 0

def Aop (f : ℕ → ℕ) : ℕ := ∑ s ∈ range 140, f s * w s

theorem N_zero (s : ℕ) : N 0 s = if s = 140 then 1 else 0 := by
  unfold N
  rw [Fintype.sum_unique]
  show (if 140 = s then 1 else 0) = _
  by_cases h : s = 140
  · subst h
    rfl
  · rw [if_neg (Ne.symm h), if_neg h]

theorem N_succ (m s' : ℕ) (hs' : s' < 141) : N (m + 1) s' = Mop (N m) s' := by
  have h1 : N (m + 1) s' = ∑ β : Fin m → Row, ∑ γ : Row,
      if δ (run m β) (rc γ) = s' then 1 else 0 :=
    sum_snoc m (fun β γ => if δ (run m β) (rc γ) = s' then 1 else 0)
  have h3 : ∀ β : Fin m → Row, (∑ γ : Row, if δ (run m β) (rc γ) = s' then 1 else 0) =
      ∑ c ∈ range 64, if δ (run m β) c = s' then 1 else 0 :=
    fun β => sum_row (fun c => if δ (run m β) c = s' then 1 else 0)
  rw [h1, Finset.sum_congr rfl (fun β _ => h3 β),
    sum_fiber (fun β : Fin m → Row => run m β) (run_lt m)
      (fun s => ∑ c ∈ range 64, if δ s c = s' then 1 else 0),
    Finset.sum_range_succ]
  have hdead : (∑ c ∈ range 64, if δ 141 c = s' then 1 else 0) = 0 :=
    Finset.sum_eq_zero fun c _ => if_neg (by rw [δ_dead]; omega)
  rw [hdead, mul_zero, add_zero]
  refine Finset.sum_congr rfl fun s hs => ?_
  refine congrArg₂ (· * ·) rfl ?_
  have hl := chk_len s (Finset.mem_range.mp hs)
  have hc : cntL s' (TT.getD s []) =
      ∑ c ∈ range 64, if (TT.getD s []).getD c 141 = s' then 1 else 0 := by
    rw [← hl, sum_getD_cnt]
  unfold cnt δ
  rw [hc]

theorem good_iff (m : ℕ) (β : Fin (m + 1) → Row) :
    (mistakes (m + 1) β = 2 ∧ isRowMajor (m + 1) β) ↔
      (run (m + 1) β < 140 ∧ dK (run (m + 1) β) = 2) := by
  obtain ⟨h1, h2⟩ := run_spec m β
  constructor
  · rintro ⟨hm, hr⟩
    obtain ⟨e1, -, -, e4⟩ := h1 ⟨hr, by omega⟩
    exact ⟨e1, by rw [e4, hm]⟩
  · rintro ⟨hlt, hk⟩
    by_cases hg : Good (m + 1) β
    · obtain ⟨-, -, -, e4⟩ := h1 hg
      exact ⟨by rw [← e4, hk], hg.1⟩
    · rw [h2 hg] at hlt
      omega

theorem a_succ (m : ℕ) : a (m + 1) = Aop (N (m + 1)) := by
  classical
  unfold a
  rw [if_neg (Nat.succ_ne_zero m), Fintype.card_subtype, Finset.card_filter]
  have h1 : (∑ β : Fin (m + 1) → Row, if mistakes (m + 1) β = 2 ∧ isRowMajor (m + 1) β then 1 else 0) =
      ∑ β : Fin (m + 1) → Row, (fun s => if s < 140 ∧ dK s = 2 then 1 else 0) (run (m + 1) β) :=
    Finset.sum_congr rfl fun β _ => if_congr (good_iff m β) rfl rfl
  rw [h1, sum_fiber (fun β : Fin (m + 1) → Row => run (m + 1) β) (run_lt (m + 1))
      (fun s => if s < 140 ∧ dK s = 2 then 1 else 0),
    Finset.sum_range_succ, Finset.sum_range_succ]
  simp only [lt_irrefl, false_and, if_false, mul_zero, add_zero, show ¬ (141 < 140) by omega]
  refine Finset.sum_congr rfl fun s hs => ?_
  have hs' := Finset.mem_range.mp hs
  unfold w N
  simp only [hs', true_and]

