import OMAReductions.R_oeis_a402459_R1

namespace OMA.TernaryRepunit

def primePowerProduct (ps : List (ℕ × ℕ)) : ℕ := (ps.map fun pe => pe.1 ^ pe.2).prod

/-- Scan a short suffix first so most rejected candidates need only a few divisions. -/
def hasTwo : ℕ → ℕ → Bool
  | 0, _ => false
  | fuel + 1, n => (n != 0) && ((n % 3 == 2) || hasTwo fuel (n / 3))

lemma hasTwo_sound (fuel n : ℕ) (h : hasTwo fuel n = true) : 2 ∈ Nat.digits 3 n := by
  induction fuel generalizing n with
  | zero => simp [hasTwo] at h
  | succ fuel ih =>
    simp only [hasTwo, Bool.and_eq_true, Bool.or_eq_true, bne_iff_ne, beq_iff_eq] at h
    obtain ⟨hn, h | h⟩ := h
    · rw [Nat.digits_eq_cons_digits_div (by decide : 1 < 3) hn]
      simp [h]
    · rw [Nat.digits_eq_cons_digits_div (by decide : 1 < 3) hn]
      exact List.mem_cons_of_mem _ (ih _ h)

def acceptable (length repunit d : ℕ) : Bool :=
  let e := repunit / d
  if e % 2 = d % 2 then
    let x := (e - d) / 2
    let ds := Nat.digits 3 (x * x)
    hasTwo 24 (x * x) || decide (2 ∈ ds ∨ ds.length ≠ length)
  else true

/-- Check divisors in the window (4d^2<R<6d^2) by splitting off one prime at a time. -/
def checkPairs (length repunit a : ℕ) (ps : List (ℕ × ℕ)) : Bool :=
  if repunit ≤ 4 * a * a ∨
      6 * (a * primePowerProduct ps) * (a * primePowerProduct ps) ≤ repunit then true
  else
    match ps with
    | [] => acceptable length repunit a
    | (p, k) :: rest => (List.range (k + 1)).all fun j =>
          checkPairs length repunit (a * p ^ j) rest

lemma primePowerProduct_pos {ps : List (ℕ × ℕ)} (hp : ∀ pe ∈ ps, pe.1.Prime) :
    0 < primePowerProduct ps := by
  induction ps with
  | nil => decide
  | cons pe ps ih =>
    exact Nat.mul_pos (pow_pos (hp pe (by simp)).pos _)
      (ih fun t ht => hp t (List.mem_cons_of_mem _ ht))

lemma checkPairs_sound (L R : ℕ) {ps : List (ℕ × ℕ)}
    (hp : ∀ pe ∈ ps, pe.1.Prime) {a b : ℕ}
    (hb : b ∣ primePowerProduct ps) (hd : 0 < a * b)
    (hlo : 4 * (a * b) * (a * b) < R) (hhi : R < 6 * (a * b) * (a * b))
    (hcheck : checkPairs L R a ps = true) : acceptable L R (a * b) = true := by
  have hab : a ≤ a * b := Nat.le_mul_of_pos_right _ (Nat.pos_of_mul_pos_left hd)
  have hba : a * b ≤ a * primePowerProduct ps :=
    Nat.mul_le_mul_left _ (Nat.le_of_dvd (primePowerProduct_pos hp) hb)
  have notBelow : ¬ R ≤ 4 * a * a := by
    have h : 4 * a * a ≤ 4 * (a * b) * (a * b) :=
      Nat.mul_le_mul (Nat.mul_le_mul_left 4 hab) hab
    omega
  have notAbove : ¬ 6 * (a * primePowerProduct ps) * (a * primePowerProduct ps) ≤ R := by
    have h : 6 * (a * b) * (a * b) ≤
        6 * (a * primePowerProduct ps) * (a * primePowerProduct ps) :=
      Nat.mul_le_mul (Nat.mul_le_mul_left 6 hba) hba
    omega
  rw [checkPairs.eq_def, if_neg (not_or.mpr ⟨notBelow, notAbove⟩)] at hcheck
  cases ps with
  | nil =>
    have h : b = 1 := Nat.dvd_one.mp hb
    simpa only [h, mul_one] using hcheck
  | cons pe ps =>
    rcases pe with ⟨p, k⟩
    have hprime := hp (p, k) (by simp)
    obtain ⟨c, d, hc, hd', rfl⟩ := Nat.dvd_mul.mp
      (show b ∣ p ^ k * primePowerProduct ps from hb)
    obtain ⟨j, hj, rfl⟩ := (Nat.dvd_prime_pow hprime).mp hc
    have hmul : a * (p ^ j * d) = (a * p ^ j) * d := (mul_assoc _ _ _).symm
    rw [hmul] at hd hlo hhi ⊢
    exact checkPairs_sound L R (fun pe he => hp pe (List.mem_cons_of_mem _ he)) hd' hd hlo hhi
      (List.all_eq_true.mp hcheck j (List.mem_range.mpr (by omega)))
termination_by ps.length

lemma parity_dvd {d e s R P x : ℕ} (hprod : d * e = R)
    (hs : s = 1 ∨ s = 2) (hR : s * s * P = R) (he : e = d + 2 * x) :
    ∃ j, d = s * j ∧ j ∣ P := by
  rcases hs with rfl | rfl
  · exact ⟨d, by simp, ⟨e, by simpa using hR.trans hprod.symm⟩⟩
  · have hEven : 2 ∣ d * e := ⟨2 * P, by rw [hprod, ← hR]; ring⟩
    have hdve : 2 ∣ d := by
      rcases Nat.prime_two.dvd_mul.mp hEven with h | h
      · exact h
      · have hdmod := Nat.dvd_iff_mod_eq_zero.mp h
        exact Nat.dvd_iff_mod_eq_zero.mpr (by omega)
    have heve : 2 ∣ e := by rw [he]; exact dvd_add hdve (dvd_mul_right 2 x)
    rcases hdve with ⟨j, hj⟩
    rcases heve with ⟨k, hk⟩
    refine ⟨j, hj, ⟨k, ?_⟩⟩
    apply Nat.eq_of_mul_eq_mul_left (by decide : 0 < 4)
    calc
      4 * P = R := hR
      _ = d * e := hprod.symm
      _ = 4 * (j * k) := by rw [hj, hk]; ring

def scale (L : ℕ) : ℕ := if L % 2 = 0 then 2 else 1

lemma verifiedPair {L d e x R : ℕ} {ps : List (ℕ × ℕ)}
    (hps : ∀ pe ∈ ps, pe.1.Prime)
    (hprod : d * e = R) (hR : scale L * scale L * primePowerProduct ps = R)
    (hd : 0 < d) (hlo : 4 * d < e) (hhi : e < 6 * d) (he : e = d + 2 * x)
    (hcheck : checkPairs L R (scale L) ps = true)
    (hlen : (Nat.digits 3 (x * x)).length = L) :
    2 ∈ Nat.digits 3 (x * x) := by
  have hs : scale L = 1 ∨ scale L = 2 := by unfold scale; split <;> simp
  obtain ⟨j, hj, hjdvd⟩ := parity_dvd hprod hs hR he
  have hlo' : 4 * d * d < R := by
    rw [← hprod, mul_comm d e]
    exact Nat.mul_lt_mul_of_pos_right hlo hd
  have hhi' : R < 6 * d * d := by
    rw [← hprod, mul_comm d e]
    exact Nat.mul_lt_mul_of_pos_right hhi hd
  have ht := checkPairs_sound L R hps (a := scale L) hjdvd
    (hj ▸ hd) (hj ▸ hlo') (hj ▸ hhi') hcheck
  rw [← hj] at ht
  have hdv : R / d = e := by rw [← hprod, Nat.mul_div_cancel_left _ hd]
  simp only [acceptable, hdv, if_pos (show e % 2 = d % 2 by omega),
    show (e-d)/2 = x by omega, Bool.or_eq_true, decide_eq_true_eq] at ht
  exact ht.elim (hasTwo_sound _ _) (fun h => h.resolve_right (not_not_intro hlen))

end OMA.TernaryRepunit

/- Binary modular exponentiation and the Lucas certificates follow the verifier
   in Erdos473.erdos_473.variants.finite. -/
namespace OMA.TernaryRepunit

def residue (m a : ℕ) : ℕ → ℕ → ℕ
  | 0, _ => 1 % m
  | k + 1, e =>
    if e = 0 then 1 % m
    else ((residue m a k (e / 2)) ^ 2 * (if e % 2 = 1 then a else 1)) % m

lemma cast_residue (m a : ℕ) : ∀ k e, e < 2 ^ k →
    (residue m a k e : ZMod m) = (a : ZMod m) ^ e := by
  intro k
  induction k with
  | zero =>
    intro e he
    have hz : e = 0 := by simpa using he
    simp [residue, hz, ZMod.natCast_mod]
  | succ k ih =>
    intro e he
    rw [pow_succ] at he
    have hd : e / 2 < 2 ^ k := by omega
    by_cases hz : e = 0
    · simp [residue, hz, ZMod.natCast_mod]
    rw [residue, if_neg hz, ZMod.natCast_mod, Nat.cast_mul, Nat.cast_pow, ih _ hd, ← pow_mul]
    by_cases h : e % 2 = 1
    · rw [if_pos h, ← pow_succ, show e / 2 * 2 + 1 = e by omega]
    · rw [if_neg h, Nat.cast_one, mul_one, show e / 2 * 2 = e by omega]

lemma certify (p a : ℕ) (fs : List ℕ) (hfs : ∀ q ∈ fs, q.Prime)
    (h : fs.prod = p - 1 ∧ p - 1 < 2 ^ 192 ∧ residue p a 192 (p - 1) = 1 ∧
      fs.all (fun q => decide (residue p a 192 ((p - 1) / q) % p ≠ 1 % p)) = true) :
    p.Prime := by
  rcases h with ⟨hprod, hbound, hfull, hparts⟩
  apply lucas_primality p (a : ZMod p)
  · rw [← cast_residue _ _ _ _ hbound, hfull, Nat.cast_one]
  · intro q hq hd
    rw [← hprod] at hd
    obtain ⟨r, hr, hqr⟩ := (Prime.dvd_prod_iff hq.prime).mp hd
    have eq := (Nat.prime_dvd_prime_iff_eq hq (hfs r hr)).mp hqr
    subst r
    have hn := of_decide_eq_true ((List.all_eq_true.mp hparts) q hr)
    intro one
    apply hn
    apply (ZMod.natCast_eq_natCast_iff' _ 1 p).mp
    rw [cast_residue _ _ _ _ ((Nat.div_le_self _ q).trans_lt hbound), one, Nat.cast_one]

end OMA.TernaryRepunit


namespace OMA.TernaryRepunit

abbrev Certificate := ℕ × ℕ × List ℕ

def entryAt (table : Array Certificate) (i : ℕ) : Certificate :=
  table[i]?.getD (2, 0, [])

def primeAt (table : Array Certificate) (i : ℕ) : ℕ := (entryAt table i).1

def certificateValid (table : Array Certificate) (i : ℕ) : Prop :=
  let row := entryAt table i
  let p := row.1
  let a := row.2.1
  let refs := row.2.2
  let fs := refs.map (primeAt table)
  p = 2 ∨
    (∀ j ∈ refs, j < i) ∧
    (fs.prod = p - 1 ∧ p - 1 < 2 ^ 192 ∧ residue p a 192 (p - 1) = 1 ∧
      fs.all (fun q => decide (residue p a 192 ((p - 1) / q) % p ≠ 1 % p)) = true)

instance (table : Array Certificate) (i : ℕ) : Decidable (certificateValid table i) := by
  unfold certificateValid
  infer_instance

lemma prime_of_certificates {table : Array Certificate}
    (checked : ∀ i < table.size, certificateValid table i) (i : ℕ) (hi : i < table.size) :
    (primeAt table i).Prime := by
  induction i using Nat.strong_induction_on with
  | h i ih =>
    rcases checked i hi with htwo | ⟨hrefs, hcalc⟩
    · unfold primeAt
      rw [htwo]
      exact Nat.prime_two
    · refine certify _ _ _ ?_ hcalc
      intro q hq
      obtain ⟨j, hj, rfl⟩ := List.mem_map.mp hq
      exact ih j (hrefs j hj) ((hrefs j hj).trans hi)

def blockCheck (P : ℕ → Prop) [DecidablePred P] (size b : ℕ) : Bool :=
  (List.range size).all fun j => decide (P (b * size + j))

lemma block_point {P : ℕ → Prop} [DecidablePred P] {size : ℕ} (hs : 0 < size)
    (i : ℕ) (h : blockCheck P size (i / size) = true) : P i := by
  have hmem : i % size ∈ List.range size := List.mem_range.mpr (Nat.mod_lt _ hs)
  have hp := of_decide_eq_true (List.all_eq_true.mp h (i % size) hmem)
  rwa [Nat.mul_comm, Nat.div_add_mod] at hp

end OMA.TernaryRepunit


