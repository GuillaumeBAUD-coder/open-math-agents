-- These two digit lemmas and the ratio argument are from the merged reduction.
private lemma shift_twice (ds : List ℕ) :
    2 * Nat.ofDigits 3 (ds.map (fun d => d + 1)) + 1 =
    2 * Nat.ofDigits 3 ds + 3 ^ ds.length := by
  induction ds with
  | nil => decide
  | cons d ds ih =>
    simp only [List.map_cons, Nat.ofDigits_cons, List.length_cons, pow_succ]
    omega

private lemma digit_bound (ds : List ℕ) (h : ∀ d ∈ ds, d ≤ 1) :
    2 * Nat.ofDigits 3 ds < 3 ^ ds.length := by
  induction ds with
  | nil => decide
  | cons d ds ih =>
    have ha := h d (by simp)
    have hb := ih (fun t ht => h t (List.mem_cons_of_mem _ ht))
    simp only [Nat.ofDigits_cons, List.length_cons, pow_succ]
    omega

private lemma ratio {d e x : ℕ} (hd : 0 < d) (he : e = d + 2 * x)
    (hu : x * x ≤ d * e) (hl : 2 * (d * e) < 3 * (x * x)) : 4 * d < e ∧ e < 6 * d := by
  zify at *
  constructor
  · by_contra! h
    have hs : (0 : ℤ) ≤ 3 * d - 2 * x := by omega
    have ht : (0 : ℤ) ≤ 6 * x + d := by positivity
    rw [he] at hl
    nlinarith [mul_nonneg hs ht, sq_nonneg (d : ℤ)]
  · by_contra! h
    have hs : (0 : ℤ) ≤ 2 * x - 5 * d := by omega
    have ht : (0 : ℤ) ≤ 2 * x + d := by positivity
    rw [he] at hu
    nlinarith [mul_nonneg hs ht, mul_pos hd hd]

end OMA.TernaryRepunit

open OMA.TernaryRepunit in
theorem OMA.solution : OMA.R_oeis_a402459_R1.H1 := by
  intro m hm hlen hs hdig ht
  obtain ⟨x, hx⟩ := hs
  obtain ⟨y, hy⟩ := ht
  let L := (Nat.digits 3 m).length
  have Lpos : 0 < L := List.length_pos_iff.mpr (Nat.digits_ne_nil_iff_ne_zero.mpr hm.ne')
  have shift := shift_twice (Nat.digits 3 m)
  rw [Nat.ofDigits_digits, hy] at shift
  change 2 * (y * y) + 1 = 2 * m + 3 ^ L at shift
  have low := Nat.base_pow_length_digits_le 3 m (by decide) hm.ne'
  change 3 ^ L ≤ 3 * m at low
  have high := digit_bound (Nat.digits 3 m) (by
    intro i hi
    have hlt := Nat.digits_lt_base (by decide : 1 < 3) hi
    have hne : i ≠ 2 := fun h => hdig (h ▸ hi)
    omega)
  rw [Nat.ofDigits_digits] at high
  change 2 * m < 3 ^ L at high
  have hpow : 1 < 3 ^ L := Nat.one_lt_pow Lpos.ne' (by decide)
  have hxy : x < y := by
    by_contra! h
    have := Nat.mul_self_le_mul_self h
    rw [hx] at shift
    omega
  let d := y - x
  let e := y + x
  have hd : 0 < d := Nat.sub_pos_of_lt hxy
  have hsum : d + x = y := Nat.sub_add_cancel hxy.le
  have he : e = d + 2 * x := by dsimp [e]; omega
  have hdiff : 2 * (d * e) + 1 = 3 ^ L := by
    rw [hx, ← hsum] at shift
    rw [he]
    nlinarith [shift]
  have hp : d * e = (3 ^ L - 1) / 2 := by omega
  obtain ⟨hlo, hhi⟩ := ratio hd he (by rw [← hx]; omega) (by rw [← hx]; omega)
  obtain ⟨ps, hps, hprod, hcheck⟩ := finiteRows L Lpos hlen
  apply hdig
  rw [hx]
  exact verifiedPair hps hp hprod hd hlo hhi he hcheck (by rw [← hx])

