lemma finiteRows (L : ℕ) (hpos : 0 < L) (hmax : L ≤ 128) :
    ∃ ps : List (ℕ × ℕ), (∀ pe ∈ ps, pe.1.Prime) ∧
      scale L * scale L * primePowerProduct ps = (3 ^ L - 1) / 2 ∧
      checkPairs L ((3 ^ L - 1) / 2) (scale L) ps = true := by
  have hv := block_point (by decide : 0 < 4) L (lengthBlock _ (by omega) (by omega))
  rcases hv with (hzero | hlarge) | ⟨hrefs, hprod, hcheck⟩
  · omega
  · omega
  refine ⟨powers L, ?_, hprod, hcheck⟩
  intro pe hpe
  obtain ⟨entry, he, rfl⟩ := List.mem_map.mp hpe
  change (primeAt certificates entry.1).Prime
  exact prime_of_certificates (table := certificates) allCertificates entry.1 (hrefs entry he)

