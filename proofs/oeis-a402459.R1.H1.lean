def exponents (L : ℕ) : List (ℕ × ℕ) := table[L]?.getD []

def powers (L : ℕ) : List (ℕ × ℕ) :=
  (exponents L).map fun pair => (primeAt certificates pair.1, pair.2)

def rowValid (L : ℕ) : Prop :=
  (L = 0 ∨ 128 < L) ∨
    (∀ pe ∈ exponents L, pe.1 < certificates.size) ∧
    scale L * scale L * primePowerProduct (powers L) = (3 ^ L - 1) / 2 ∧
    checkPairs L ((3 ^ L - 1) / 2) (scale L) (powers L) = true

instance (L : ℕ) : Decidable (rowValid L) := by unfold rowValid; infer_instance

