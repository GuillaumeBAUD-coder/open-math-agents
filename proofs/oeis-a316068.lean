theorem b_recur (q : ℕ) : (b (q + 21) : ℤ) = -2 * b (q + 19) + b (q + 18) - 3 * b (q + 17) + 3 * b (q + 16) - 3 * b (q + 15) + 5 * b (q + 14) - 4 * b (q + 13) + 6 * b (q + 12) - 4 * b (q + 11) + 6 * b (q + 10) - 4 * b (q + 9) + 5 * b (q + 8) - 3 * b (q + 7) + 3 * b (q + 6) - 3 * b (q + 5) + b (q + 4) - 2 * b (q + 3) - b (q + 1) := by
  induction q using Nat.strong_induction_on with
  | _ q ih =>
    rcases (show q < 30 ∨ 30 ≤ q by omega) with hq | hq
    · have h := congrArg (Nat.cast : ℕ → ℤ) (recur_base q hq)
      push_cast at h
      linarith
