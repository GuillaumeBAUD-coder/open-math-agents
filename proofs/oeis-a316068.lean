theorem drec (t : ℕ) : (dv (t + 20) : ℤ) = -2 * (dv (t + 18) : ℤ) + (dv (t + 17) : ℤ) - 3 * (dv (t + 16) : ℤ) + 3 * (dv (t + 15) : ℤ) - 3 * (dv (t + 14) : ℤ) + 5 * (dv (t + 13) : ℤ) - 4 * (dv (t + 12) : ℤ) + 6 * (dv (t + 11) : ℤ) - 4 * (dv (t + 10) : ℤ) + 6 * (dv (t + 9) : ℤ) - 4 * (dv (t + 8) : ℤ) + 5 * (dv (t + 7) : ℤ) - 3 * (dv (t + 6) : ℤ) + 3 * (dv (t + 5) : ℤ) - 3 * (dv (t + 4) : ℤ) + (dv (t + 3) : ℤ) - 2 * (dv (t + 2) : ℤ) - (dv (t + 0) : ℤ) := by
