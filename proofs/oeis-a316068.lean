      have h0 : (b (v + 21) : ℤ) = -2 * b (v + 19) + b (v + 18) - 3 * b (v + 17) + 3 * b (v + 16) - 3 * b (v + 15) + 5 * b (v + 14) - 4 * b (v + 13) + 6 * b (v + 12) - 4 * b (v + 11) + 6 * b (v + 10) - 4 * b (v + 9) + 5 * b (v + 8) - 3 * b (v + 7) + 3 * b (v + 6) - 3 * b (v + 5) + b (v + 4) - 2 * b (v + 3) - b (v + 1) := ih (v + 0) (by omega)
