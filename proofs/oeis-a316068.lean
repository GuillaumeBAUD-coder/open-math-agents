theorem gf : PowerSeries.mk (fun n => (a n : ℚ)) * ((X - 1) ^ 2 * (X ^ 2 - X + 1) * (X ^ 2 + X + 1) ^ 2 * (X ^ 4 - X ^ 3 + X ^ 2 - X + 1) * (X ^ 4 + X ^ 3 + X ^ 2 + X + 1) ^ 2) =
      X ^ 20 + 6 * X ^ 19 + 11 * X ^ 18 + 28 * X ^ 17 + 35 * X ^ 16 + 64 * X ^ 15 + 67 * X ^ 14 + 102 * X ^ 13 + 91 * X ^ 12 + 126 * X ^ 11 + 100 * X ^ 10 + 126 * X ^ 9 + 91 * X ^ 8 + 102 * X ^ 7 + 67 * X ^ 6 + 64 * X ^ 5 + 35 * X ^ 4 + 28 * X ^ 3 + 11 * X ^ 2 + 6 * X + 1 := by
  set A : ℚ⟦X⟧ := PowerSeries.mk (fun n => (a n : ℚ)) with hA
  rw [gf_den A, gf_num]
  ext n
  have hc : ∀ k, coeff k A = (b k : ℚ) := fun k => by rw [hA, coeff_mk, a_eq_b]
  simp only [map_add, map_sub, coeff_C_mul, coeff_mul_C, coeff_X_pow, coeff_mul_X_pow', hc]
  rcases Nat.lt_or_ge n 21 with hn | hn
  · linarith [gf_low n hn]
  · obtain ⟨q, rfl⟩ : ∃ q, n = q + 21 := ⟨n - 21, by omega⟩
    linarith [gf_high q]

end Count

