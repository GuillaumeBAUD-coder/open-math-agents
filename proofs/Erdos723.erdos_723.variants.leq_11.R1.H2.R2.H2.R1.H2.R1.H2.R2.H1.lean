import OMAReductions.R_Erdos723_erdos_723_variants_leq_11_R1_H2_R2_H2_R1_H2_R1_H2_R2

/-! Joined marked blocks in the weight-fifteen incidence search.

At each active endpoint, a legal group covers six incident edges with its six blocks.
Each block therefore chooses one edge at every endpoint. Enumerating these perfect
matchings gives 344 possible rows for each of the three centers. A second enumeration
selects disjoint matching rows to form complete groups.

For each joined root group, the finite certificate either identifies one of 34 survivor
groups or transports its triangle to center 0 and partners 9 and 14. For the 942
transported cases, an exact-cover tree chooses an uncovered point and branches over every
remaining row containing it. On each branch the table masks remove conflicting rows. A
leaf has an uncovered point with no available row. The packed integers record the
matching rows, symmetries, and pivot choices used by the Boolean checks below.
-/

namespace EC

structure Tables where
  rows : Bool → Nat → Nat
  point : Bool → Nat → Nat
  disj : Bool → Nat → Nat
  cross : Bool → Nat → Nat

structure State where
  rem : Bool → Nat
  opts : Bool → Nat

def picks (t : Tables) (s : State) (side : Bool) (p : Nat) : Nat :=
  s.opts side &&& t.point side p

def child (t : Tables) (s : State) (side : Bool) (i : Nat) : State :=
  { rem := fun a =>
      if a = side then s.rem a ^^^ (s.rem a &&& t.rows side i) else s.rem a
    opts := fun a =>
      s.opts a &&& (if a = side then t.disj side i else t.cross side i) }

def highBit : Nat → Nat → Nat → Nat
  | 0, _, _ => 0
  | n+1, k, w =>
    let upper := w >>> k
    if upper = 0 then highBit n (k/2) w else k + highBit n (k/2) upper

def pivotIndex (w : Nat) : Nat := highBit 9 256 w

def branches (step : Nat → Nat → Option Nat) : Nat → Nat → Nat → Option Nat
  | 0, pool, cert => if pool = 0 then some cert else none
  | fuel + 1, pool, cert =>
    if pool = 0 then some cert else
    let i := pivotIndex pool
    match step i cert with
    | none => none
    | some remaining => branches step fuel (pool ^^^ (2 ^ i)) remaining

def visit (t : Tables) : Nat → State → Nat → Option Nat
  | 0, _, _ => none
  | fuel + 1, s, cert =>
    let tag := cert % 128
    let side := decide (60 < tag)
    let p := if side then tag - 61 else tag - 1
    if 0 < tag ∧ tag ≤ 120 ∧ (s.rem side).testBit p = true then
      branches (fun i r => visit t fuel (child t s side i) r) 344
        (picks t s side p) (cert / 128)
    else none

end EC

namespace PlaneData
def pos0 (i : Nat) : Nat := ( >>> (36*i)) % (2^36)
def pos9 (i : Nat) : Nat := ( >>> (36*i)) % (2^36)
def point9 (i : Nat) : Nat := ( >>> (344 * i)) &&& 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
def pos14 (i : Nat) : Nat := ( >>> (36*i)) % (2^36)
def point14 (i : Nat) : Nat := ( >>> (344 * i)) &&& 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
def rowPos (s : Bool) (i : Nat) : Nat := if s then pos14 i else pos9 i

def asRow (w : Nat) : Nat :=
  (1 <<< (w % 64)) ||| (1 <<< ((w >>> 6) % 64)) ||| (1 <<< ((w >>> 12) % 64)) |||
  (1 <<< ((w >>> 18) % 64)) ||| (1 <<< ((w >>> 24) % 64)) ||| (1 <<< ((w >>> 30) % 64))

def row (s : Bool) (i : Nat) : Nat := asRow (rowPos s i)
def rootRow (i : Nat) : Nat := asRow (pos0 i)
def point (s : Bool) (i : Nat) : Nat := if s then point14 i else point9 i
def anyHit (s : Bool) (w : Nat) : Nat :=
  point s (w % 64) ||| point s ((w >>> 6) % 64) ||| point s ((w >>> 12) % 64) |||
    point s ((w >>> 18) % 64) ||| point s ((w >>> 24) % 64) ||| point s ((w >>> 30) % 64)

def twoHits (s : Bool) (w : Nat) : Nat :=
  let a := point s (w % 64)
  let b := point s ((w >>> 6) % 64)
  let c := point s ((w >>> 12) % 64)
  let d := point s ((w >>> 18) % 64)
  let e := point s ((w >>> 24) % 64)
  let f := point s ((w >>> 30) % 64)
  let ab := a ||| b
  let de := d ||| e
  (a &&& b) ||| (ab &&& c) ||| (d &&& e) ||| (de &&& f) ||| ((ab ||| c) &&& (de ||| f))

def disj (s : Bool) (i : Nat) : Nat := (2^344-1) ^^^ anyHit s (rowPos s i)
def cross (s : Bool) (i : Nat) : Nat := (2^344-1) ^^^ twoHits (!s) (rowPos s i)
def rootOpts (s : Bool) (i : Nat) : Nat := (2^344-1) ^^^ twoHits s (pos0 i)

def tables : EC.Tables := ⟨row, point, disj, cross⟩
def init (xs : List Nat) : EC.State :=
  { rem := fun s => if s then 0xfffc3ef80fafa00 else 0x15f55fdd75f5f00
    opts := fun s => xs.foldl (fun m i => m &&& rootOpts s i) (2^344-1) }
def search : Nat → Nat → Nat → Nat → Nat → Nat → Option Nat
  | 0, _, _, _, _, _ => none
  | fuel+1, ra, rb, oa, ob, c =>
    let tag := c % 128
    if tag = 0 then none
    else if tag ≤ 60 then
      let p := tag - 1
      if ra.testBit p then
        EC.branches (fun i k => search fuel (ra ^^^ (ra &&& row false i)) rb
          (oa &&& disj false i) (ob &&& cross false i) k) 344 (oa &&& point false p) (c / 128)
      else none
    else if tag ≤ 120 then
      let p := tag - 61
      if rb.testBit p then
        EC.branches (fun i k => search fuel ra (rb ^^^ (rb &&& row true i))
          (oa &&& cross true i) (ob &&& disj true i) k) 344 (ob &&& point true p) (c / 128)
      else none
    else none

def check (xs : List Nat) (c : Nat) : Bool :=
  let s := init xs
  search 13 (s.rem false) (s.rem true) (s.opts false) (s.opts true) c == some 0

end PlaneData

namespace PlaneCases

def factorCode (k : Nat) : Nat :=
  ( >>> (54*k)) &&& 0x3fffffffffffff

def indices (w : Nat) : List Nat :=
  [w % 512, (w >>> 9) % 512, (w >>> 18) % 512, (w >>> 27) % 512,
    (w >>> 36) % 512, (w >>> 45) % 512]

def factor (k : Nat) : List Nat := (indices (factorCode k)).map PlaneData.rootRow

end PlaneCases

