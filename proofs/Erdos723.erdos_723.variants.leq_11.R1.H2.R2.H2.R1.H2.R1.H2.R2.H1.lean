set_option maxHeartbeats 12000000 in
private theorem chunk2 : ∀ a : Bool, ∀ i : Fin 43, flagsForRow a (86 + i.val) := by decide +kernel

set_option maxRecDepth 32000 in
set_option maxHeartbeats 12000000 in
private theorem chunk3 : ∀ a : Bool, ∀ i : Fin 43, flagsForRow a (129 + i.val) := by decide +kernel

set_option maxRecDepth 32000 in
set_option maxHeartbeats 12000000 in
private theorem chunk4 : ∀ a : Bool, ∀ i : Fin 43, flagsForRow a (172 + i.val) := by decide +kernel

set_option maxRecDepth 32000 in
set_option maxHeartbeats 12000000 in
private theorem chunk5 : ∀ a : Bool, ∀ i : Fin 43, flagsForRow a (215 + i.val) := by decide +kernel

set_option maxRecDepth 32000 in
set_option maxHeartbeats 12000000 in
private theorem chunk6 : ∀ a : Bool, ∀ i : Fin 43, flagsForRow a (258 + i.val) := by decide +kernel

set_option maxRecDepth 32000 in
set_option maxHeartbeats 12000000 in
private theorem chunk7 : ∀ a : Bool, ∀ i : Fin 43, flagsForRow a (301 + i.val) := by decide +kernel

theorem allFlags (a : Bool) (i : Fin 344) : flagsForRow a i.val := by
  by_cases h0 : i.val < 43
  · have h := chunk0 a ⟨i.val - 0, by omega⟩
    change flagsForRow a (0 + (i.val - 0)) at h
    simpa only [show 0 + (i.val - 0) = i.val by omega] using h
  by_cases h1 : i.val < 86
  · have h := chunk1 a ⟨i.val - 43, by omega⟩
    change flagsForRow a (43 + (i.val - 43)) at h
    simpa only [show 43 + (i.val - 43) = i.val by omega] using h
  by_cases h2 : i.val < 129
  · have h := chunk2 a ⟨i.val - 86, by omega⟩
    change flagsForRow a (86 + (i.val - 86)) at h
    simpa only [show 86 + (i.val - 86) = i.val by omega] using h
  by_cases h3 : i.val < 172
  · have h := chunk3 a ⟨i.val - 129, by omega⟩
    change flagsForRow a (129 + (i.val - 129)) at h
    simpa only [show 129 + (i.val - 129) = i.val by omega] using h
  by_cases h4 : i.val < 215
  · have h := chunk4 a ⟨i.val - 172, by omega⟩
    change flagsForRow a (172 + (i.val - 172)) at h
    simpa only [show 172 + (i.val - 172) = i.val by omega] using h
  by_cases h5 : i.val < 258
  · have h := chunk5 a ⟨i.val - 215, by omega⟩
    change flagsForRow a (215 + (i.val - 215)) at h
    simpa only [show 215 + (i.val - 215) = i.val by omega] using h
  by_cases h6 : i.val < 301
  · have h := chunk6 a ⟨i.val - 258, by omega⟩
    change flagsForRow a (258 + (i.val - 258)) at h
    simpa only [show 258 + (i.val - 258) = i.val by omega] using h
  have h := chunk7 a ⟨i.val - 301, by omega⟩
  change flagsForRow a (301 + (i.val - 301)) at h
  simpa only [show 301 + (i.val - 301) = i.val by omega] using h
end PlaneData

namespace PlaneData

abbrev PointExact := ∀ (s : Bool) (j : Fin 344) (p : Fin 60),
    (row s j.val).testBit p.val = (point s p.val).testBit j.val

private theorem small_index {x p : Nat} (hx : x < 2^60) (hp : x.testBit p = true) : p < 60 := by
  by_cases h : p < 60
  · exact h
  have hle : 60 ≤ p := by omega
  have hfalse := Nat.testBit_lt_two_pow (Nat.lt_of_lt_of_le hx (Nat.pow_le_pow_right (by decide) hle))
  simp [hp] at hfalse

private theorem one_safe (pointExact : PointExact) (s : Bool) (x : Nat) (j : Fin 344)
    (hx : x < 2^60) (h : x &&& row s j.val = 0) :
    ((blockers s (positions 6 x)).1).testBit j.val ≠ true := by
  intro bad
  obtain ⟨p, hp, hflag⟩ := one_sound s _ j.val bad
  have hit := (positions_sound 6 x).2 p hp
  have target := (pointExact s j ⟨p,small_index hx hit⟩).trans hflag
  have shared : (x &&& row s j.val).testBit p = true := by
    rw [Nat.testBit_and,Bool.and_eq_true]
    exact ⟨hit,target⟩
  simp [h] at shared

private theorem two_safe (pointExact : PointExact) (s : Bool) (x : Nat) (j : Fin 344)
    (hx : x < 2^60) (h : MatchingRows.thin (x &&& row s j.val)) :
    ((blockers s (positions 6 x)).2).testBit j.val ≠ true := by
  intro bad
  obtain ⟨p,hp,q,hq,hne,hpflag,hqflag⟩ := two_sound s _ (positions_sound 6 x).1 _ bad
  have shared (k : Nat) (hk : k ∈ positions 6 x) (hflag : (point s k).testBit j.val = true) :
      (x &&& row s j.val).testBit k = true := by
    have hit := (positions_sound 6 x).2 k hk
    rw [Nat.testBit_and,Bool.and_eq_true]
    exact ⟨hit,(pointExact s j ⟨k,small_index hx hit⟩).trans hflag⟩
  exact hne (MatchingRows.thin_unique h (shared p hp hpflag) (shared q hq hqflag))

theorem sameOK_of_exact (hp : PointExact) (s : Bool) (i j : Fin 344)
    (h : row s i.val &&& row s j.val = 0) : (disj s i.val).testBit j.val = true :=
  finish_flag (allFlags s i).2.2.1 j (one_safe hp s (row s i.val) j (allFlags s i).1 h)

theorem crossOK_of_exact (hp : PointExact) (s : Bool) (i j : Fin 344)
    (h : MatchingRows.thin (row s i.val &&& row (!s) j.val)) :
    (cross s i.val).testBit j.val = true :=
  finish_flag (allFlags s i).2.2.2.1 j (two_safe hp (!s) (row s i.val) j (allFlags s i).1 h)

theorem rootOK_of_exact (hp : PointExact) (s : Bool) (i j : Fin 344)
    (h : MatchingRows.thin (rootRow i.val &&& row s j.val)) :
    (rootOpts s i.val).testBit j.val = true :=
  finish_flag (allFlags s i).2.2.2.2 j (two_safe hp s (rootRow i.val) j (allFlags s i).2.1 h)

end PlaneData

namespace PlaneData

private def group (a : Bool) : Fin 15 := if a then 14 else 9

private theorem opts_fold {s : Bool} {xs : List Nat} {j : Fin 344} {w : Nat}
    (initial : w.testBit j.val = true)
    (good : ∀ i ∈ xs, (rootOpts s i).testBit j.val = true) :
    (xs.foldl (fun mask i => mask &&& rootOpts s i) w).testBit j.val = true := by
  induction xs generalizing w with
  | nil => exact initial
  | cons i is ih =>
    apply ih
    · rw [Nat.testBit_and,Bool.and_eq_true]
      exact ⟨initial,good i (by simp)⟩
    · exact fun k hk => good k (List.Mem.tail _ hk)

theorem good_at_root_of_tables
    (pointExact : PointExact)
    (rowCovers : ∀ a x, x ∈ MatchingRows.catalogue (group a) → ∃ i : Fin 344, row a i.val = x)
    (xs c d : List Nat) (bounds : ∀ i ∈ xs, i < 344)
    (hc : MatchingRows.legal 9 c) (hd : MatchingRows.legal 14 d)
    (rc : ∀ i ∈ xs, ∀ x ∈ c, MatchingRows.thin (rootRow i &&& x))
    (rd : ∀ i ∈ xs, ∀ x ∈ d, MatchingRows.thin (rootRow i &&& x))
    (cd : ∀ x ∈ c, ∀ y ∈ d, MatchingRows.thin (x &&& y)) :
    ∃ W, EC.Family tables W ∧ EC.Good tables W (init xs) := by
  let b (a : Bool) := if a then d else c
  apply EC.good_of_legal group b
  · intro a
    cases a <;> assumption
  · intro a
    cases a with
    | false => exact cd
    | true =>
      intro x hx y hy
      rw [Nat.and_comm]
      exact cd y hy x hx
  · exact rowCovers
  · intro a i p h
    exact (pointExact a i p).symm.trans h
  · exact sameOK_of_exact pointExact
  · exact crossOK_of_exact pointExact
  · intro a j hj
    apply opts_fold
    · simp [Nat.testBit_two_pow_sub_one,j.isLt]
    · intro i hi
      apply rootOK_of_exact pointExact a ⟨i,bounds i hi⟩ j
      cases a with
      | false => exact rc i hi _ hj
      | true => exact rd i hi _ hj
  · intro a
    cases a <;> rfl

end PlaneData

namespace MatchingRows

private abbrev Included (xs : List Nat) (table : Nat → Nat) : Prop :=
  ∀ x ∈ xs, ∃ i : Fin 344, table i.val = x

private def sectionFit (table : Nat → Nat) (i : Nat) : List Nat → Bool
  | [] => true
  | x :: rest => decide (i < 344) && (table i == x) && sectionFit table (i+1) rest

private theorem sectionFit_included {xs : List Nat} {table : Nat → Nat} {i : Nat}
    (h : sectionFit table i xs = true) : Included xs table := by
  induction xs generalizing i with
  | nil => simp [Included]
  | cons x xs ih =>
    simp only [sectionFit, Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at h
    intro y hy
    rcases List.mem_cons.mp hy with rfl | hy
    · exact ⟨⟨i,h.1.1⟩,h.1.2⟩
    · exact ih h.2 y hy

private theorem coverFree {g m : Fin 15} {ms : List (Fin 15)} {row : Nat} {T : Nat → Nat}
    (free : row &&& incident m = 0)
    (branches : ∀ k : Fin 6, let p := neighbor g m k
      row &&& incident (otherEnd m p) = 0 → Included (enumerateRows g ms (row ||| 2^p.val)) T) :
    Included (enumerateRows g (m::ms) row) T := by
  intro x hx
  simp only [enumerateRows,if_pos free,List.mem_flatMap] at hx
  obtain ⟨k,_,hm⟩ := hx
  split at hm
  next h => exact branches k h x hm
  next => simp at hm

private theorem coverUsed {g m : Fin 15} {ms : List (Fin 15)} {row : Nat} {T : Nat → Nat}
    (used : row &&& incident m ≠ 0) (next : Included (enumerateRows g ms row) T) :
    Included (enumerateRows g (m::ms) row) T := by
  simpa only [enumerateRows,if_neg used] using next

private theorem pruneRow {w : Nat} {P : Prop} (h : w ≠ 0) : w = 0 → P :=
  fun eq => (h eq).elim

private theorem sixBranches {P : Fin 6 → Prop}
    (h0 : P 0) (h1 : P 1) (h2 : P 2) (h3 : P 3) (h4 : P 4) (h5 : P 5) : ∀ k, P k := by
  intro k
  have hk : k=0 ∨ k=1 ∨ k=2 ∨ k=3 ∨ k=4 ∨ k=5 := by omega
  rcases hk with rfl|rfl|rfl|rfl|rfl|rfl <;> assumption
