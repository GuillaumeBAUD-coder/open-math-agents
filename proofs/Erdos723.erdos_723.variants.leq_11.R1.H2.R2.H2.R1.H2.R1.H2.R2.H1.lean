private def knownPoint (g p : Nat) : List Nat := if g = 0 then point0 p else point9 p

def byPoint (g p : Nat) : List Nat :=
  if p ∈ hot g then knownPoint g p else (nativeRows g).filter (fun x => x.testBit p)

private abbrev TablesOk (g : Fin 15) := ∀ x ∈ catalogue g,
  (x &&& marker g = marker g → x ∈ marked g) ∧
  ∀ p ∈ hot g, x.testBit p = true → x ∈ knownPoint g p

set_option maxRecDepth 20000 in
set_option maxHeartbeats 32000000 in
private theorem tables0 : TablesOk 0 := by decide +kernel

set_option maxRecDepth 20000 in
set_option maxHeartbeats 32000000 in
private theorem tables9 : TablesOk 9 := by decide +kernel

private theorem native_eq (g : Fin 15) : nativeRows g = catalogue g := by
  have h : Fin.ofNat 15 g.val = g := Fin.ext (Nat.mod_eq_of_lt g.isLt)
  simp [nativeRows,h]

private theorem tables_ok (g : Fin 15) : TablesOk g := by
  by_cases hz : g.val = 0
  · have he : g = 0 := Fin.ext hz
    exact he ▸ tables0
  by_cases hn : g.val = 9
  · have he : g = 9 := Fin.ext hn
    exact he ▸ tables9
  intro x hx
  refine ⟨fun hm => ?_, ?_⟩
  · simp [marked,hz,hn,native_eq g,hx,hm]
  · simp [hot,hz,hn]

theorem marked_complete (g : Fin 15) (_hg : g.val ∈ [0,9,14]) :
    ∀ x ∈ catalogue g, x &&& marker g = marker g → x ∈ marked g :=
  fun x hx => (tables_ok g x hx).1

theorem byPoint_complete (g : Fin 15) (_hg : g.val ∈ [0,9,14]) :
    ∀ x ∈ catalogue g, ∀ p, x.testBit p = true → x ∈ byPoint g p := by
  intro x hx p hp
  by_cases hh : p ∈ hot g
  · rw [byPoint, if_pos hh]
    exact (tables_ok g x hx).2 p hh hp
  · simp [byPoint,hh,native_eq g,hx,hp]

theorem checked_of_certify {g : Fin 15} (hg : g.val ∈ [0,9,14]) (check : List Nat → Bool)
    (hc : certify (marked g) (byPoint g) check (allowed g) = true)
    {b : List Nat} (hb : legal g.val b) (joined : ∃ x ∈ b, x &&& marker g = marker g) :
    check b = true :=
  certify_sound hb (marker g) joined (marked g) (byPoint g) check
    (marked_complete g hg) (byPoint_complete g hg) hc

end MatchingRows.RootTables

namespace MatchingRows.Orbit

def inverse (s : Action) : Action := ⟨s.inverseVertices, s.vertices, s.inverseGroups, s.groups,
  s.inversePoints, s.points⟩

theorem inverse_mask (s : Action) (hs : Valid s) (x : Nat)
    (low : ∀ i, x.testBit i = true → i < 60) :
    maskImage (inverse s) (maskImage s x) = x := by
  apply Nat.eq_of_testBit_eq
  intro pos
  apply Bool.eq_iff_iff.mpr
  rw [image_bits]
  constructor
  · rintro ⟨y, hy, rfl⟩
    obtain ⟨i,hi,he⟩ := (image_bits ..).mp hy
    have eq : map60 s.points i = y := Fin.ext he
    subst y
    change x.testBit (map60 s.inversePoints (map60 s.points i)).val = true
    simpa only [(hs.2.1 i).1] using hi
  · intro hx
    let i : Fin 60 := ⟨pos, low pos hx⟩
    refine ⟨map60 s.points i, (image_bits ..).mpr ⟨i,hx,rfl⟩, ?_⟩
    exact congrArg Fin.val (hs.2.1 i).1

theorem inverse_factor (s : Action) (hs : Valid s) {g : Nat} {f : List Nat} (hf : legal g f) :
    factorImage (inverse s) (factorImage s f) = f := by
  apply sorted_eq_of_perm _ hf.2.1
  have p := (sorted_perm (f.map (maskImage s))).map (maskImage (inverse s))
  change ((factorImage s f).map (maskImage (inverse s))).Perm
    ((f.map (maskImage s)).map (maskImage (inverse s))) at p
  rw [List.map_map] at p
  have hsame : f.map ((maskImage (inverse s)) ∘ (maskImage s)) = f := by
    calc
      _ = f.map id := by
        apply List.map_congr_left
        intro z hz
        apply inverse_mask s hs
        intro i hi
        have hbit := (fold_or_bits f i).mpr ⟨z,hz,hi⟩
        rw [hf.2.2.1] at hbit
        exact allowed_lt hbit
      _ = f := List.map_id f
  rwa [hsame] at p

theorem image_mark (s : Action) {x m : Nat} (h : x &&& m = m) :
    maskImage s x &&& maskImage s m = maskImage s m := by
  apply Nat.eq_of_testBit_eq
  intro pos
  apply Bool.eq_iff_iff.mpr
  simp only [Nat.testBit_and, Bool.and_eq_true_iff, and_iff_right_iff_imp]
  intro hpos
  obtain ⟨i,hm,hi⟩ := (image_bits ..).mp hpos
  have hx := congrArg (fun n : Nat => n.testBit i.val) h
  simp [Nat.testBit_and,hm] at hx
  exact (image_bits ..).mpr ⟨i,hx,hi⟩

def chosen14 : Action := c14_0[3]

private theorem chosen_properties : Valid chosen14 ∧ ToZero chosen14 14 :=
  checked_c14_0 _ (List.getElem_mem ..)

private theorem chosen_marker : maskImage chosen14 (RootTables.marker 14) = RootTables.marker 0 :=
  by decide +kernel

set_option maxRecDepth 16000 in
set_option maxHeartbeats 16000000 in
private theorem inverse_survivors :
    ∀ f ∈ survivors0, factorImage (inverse chosen14) f ∈ survivors14 := by decide +kernel

theorem survivors_fourteen_of_zero
    (zero : ∀ f, Viable 0 f → (∃ x ∈ f, x &&& RootTables.marker 0 = RootTables.marker 0) →
      f ∈ survivors0) (f : List Nat) (h : Viable 14 f)
    (marked : ∃ x ∈ f, x &&& RootTables.marker 14 = RootTables.marker 14) :
    f ∈ survivors14 := by
  have ⟨valid, cent⟩ := chosen_properties
  obtain ⟨x,hx,hm⟩ := marked
  have v := viable_zero chosen14 valid 14 cent f h
  have hm0 : ∃ y ∈ factorImage chosen14 f, y &&& RootTables.marker 0 = RootTables.marker 0 := by
    refine ⟨maskImage chosen14 x, (factor_mem ..).mpr ⟨x,hx,rfl⟩, ?_⟩
    rw [←chosen_marker]
    exact image_mark chosen14 hm
  have hin := inverse_survivors (factorImage chosen14 f) (zero _ v hm0)
  rwa [inverse_factor chosen14 valid h.1] at hin

