theorem allChecked (i : Fin 942) :
    PlaneData.check (indices (factorCode i.val)) (cert i.val) = true := by
  have h := verifiedChunk (k := i.val/16) (by omega)
  have hj := List.all_eq_true.mp h (i.val % 16) (List.mem_range.mpr (by omega))
  have he : 16 * (i.val / 16) + i.val % 16 = i.val := by omega
  rw [he] at hj
  simpa [checkAt, Nat.not_le.mpr i.isLt] using hj

end PlaneCases

