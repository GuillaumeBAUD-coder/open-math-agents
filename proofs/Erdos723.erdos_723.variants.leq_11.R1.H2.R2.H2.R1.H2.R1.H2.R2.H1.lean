def cert (i : Nat) : Nat :=
  let chunk := i / 16
  let j := i % 16
  let offsets := boundaries chunk
  let lo := (offsets >>> (13*j)) % 8192
  let hi := (offsets >>> (13*(j+1))) % 8192
  (payload chunk >>> (7*lo)) % (2^(7*(hi-lo)))

def checkAt (i : Nat) : Bool :=
  decide (942 ≤ i) || PlaneData.check (indices (factorCode i)) (cert i)

def runChunk (k : Nat) : Bool := (List.range 16).all (fun j => checkAt (16*k+j))

