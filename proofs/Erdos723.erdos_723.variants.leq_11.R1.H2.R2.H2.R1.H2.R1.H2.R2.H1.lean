abbrev Preserves (s : Action) (g : Fin 15) : Prop :=
  map15 s.groups g = g ∧ ∀ t ∈ pairSet g.val, ∃ e ∈ pairSet g.val,
    let a := (map15 s.groups (Fin.ofNat 15 e.1)).val
    let b := (map15 s.groups (Fin.ofNat 15 e.2)).val
    (a,b) = t ∨ (b,a) = t

theorem viable_preserved (s : Action) (hs : Valid s) (g : Fin 15) (hp : Preserves s g)
    {f : List Nat} (hf : Viable g.val f) : Viable g.val (factorImage s f) := by
  refine ⟨by simpa only [hp.1] using legal_image hs g hf.1, ?_⟩
  intro t ht
  obtain ⟨e,he,hor⟩ := hp.2 t ht
  have small : ∀ v : Fin 15, ∀ q ∈ pairSet v.val, q.1 < 15 ∧ q.2 < 15 := by decide +kernel
  have ⟨ha,hb⟩ := small g e he
  let a := Fin.ofNat 15 e.1
  let b := Fin.ofNat 15 e.2
  have ae : a.val = e.1 := Nat.mod_eq_of_lt ha
  have be : b.val = e.2 := Nat.mod_eq_of_lt hb
  have ext := extension_image s hs a b f (by simpa only [ae,be] using hf.2 e he)
  rcases hor with eq | eq
  · rw [←eq]; exact ext
  · rw [←eq]; exact extension_comm _ _ _ ext

structure Route where
  source : Nat
  target : Nat
  action : Action

abbrev VerifiedRoute (r : Route) (g : Fin 15) (selected : List Nat) (truth : List (List Nat)) : Prop :=
  Valid r.action ∧ Preserves r.action g ∧ maskImage r.action r.source = r.target ∧ r.target ∈ selected ∧
  ∀ f ∈ truth, factorImage (inverse r.action) f ∈ truth

