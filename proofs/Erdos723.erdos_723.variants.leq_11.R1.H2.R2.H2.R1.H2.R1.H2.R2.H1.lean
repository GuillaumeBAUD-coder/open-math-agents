theorem covered0 (reject : ∀ k : Fin 942, ¬ Extends (PlaneCases.factor k.val) 9 14)
    (f : List Nat) (hf : Viable 0 f)
    (hm : ∃ x ∈ f, x &&& RootTables.marker 0 = RootTables.marker 0) :
    f ∈ survivors0 := by
  apply cover_from_selected (g := 0) (by decide) routes0 selected0 survivors0
    markers0 verified0 _ f hf hm
  intro a hv y hy hya
  have hg : (0 : Fin 15).val ∈ ([0,9,14] : List Nat) := by decide
  have pts := RootTables.byPoint_complete (0 : Fin 15) hg
  apply CenterCheck.sound (0 : Fin 15) hg a hv _ reject
  apply RF.root_sound (g := 0) hv.1 hya (RootTables.byPoint 0) (accept 0) pts
  simp only [selected0,List.mem_cons,List.not_mem_nil,or_false] at hy
  rcases hy with rfl | rfl | rfl
  · exact root0_0
  · exact root0_1
  · exact root0_2

