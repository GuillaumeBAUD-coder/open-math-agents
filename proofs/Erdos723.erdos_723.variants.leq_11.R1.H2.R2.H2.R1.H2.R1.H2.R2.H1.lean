private def fromBits (get : Nat → Nat) : Nat → Nat → List Nat
  | 0, _ => []
  | n+1, bits =>
    if bits = 0 then [] else
      let tail := bits &&& (bits-1)
      get (bits ^^^ tail).log2 :: fromBits get n tail

