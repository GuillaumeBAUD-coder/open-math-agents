def hashKey (f : List Nat) : Nat :=
  f.foldl (fun k x => (1000003 * k + x) % 18446744073709551557) 0

def lookup (b s : Nat) (salt entries : Nat → Nat) (f : List Nat) : Nat :=
  let k := hashKey f
  let q := k / b
  let d := salt (k % b)
  entries ((q % s + d * (1 + q / s % (s-1))) % s)

