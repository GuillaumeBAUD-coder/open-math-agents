/-- Six-edge masks require only six single-bit relabelings. The fallback preserves the
definition on larger or out-of-range inputs. -/
def paint (s : Action) : Nat → Nat → Nat
  | 0, w => if w = 0 then 0 else maskImage s w
  | k+1, w =>
    if w = 0 then 0 else
      let i := w.log2
      if hi : i < 60 then
        (1 <<< (map60 s.points ⟨i,hi⟩).val) ||| paint s k (w ^^^ (1 <<< i))
      else maskImage s w

private theorem image_zero (s : Action) : maskImage s 0 = 0 := by
  apply Nat.eq_of_testBit_eq
  intro j
  apply Bool.eq_iff_iff.mpr
  simp [image_bits]

private theorem image_or (s : Action) (u v : Nat) :
    maskImage s (u ||| v) = maskImage s u ||| maskImage s v := by
  apply Nat.eq_of_testBit_eq
  intro p
  apply Bool.eq_iff_iff.mpr
  simp only [Nat.testBit_or, Bool.or_eq_true_iff, image_bits]
  constructor
  · rintro ⟨i,hy,hi⟩
    rcases hy with h|h
    · exact Or.inl ⟨i,h,hi⟩
    · exact Or.inr ⟨i,h,hi⟩
  · rintro (⟨i,h,hi⟩|⟨i,h,hi⟩)
    · exact ⟨i,by simp [h],hi⟩
    · exact ⟨i,by simp [h],hi⟩

private theorem image_singleton (s : Action) (i : Fin 60) :
    maskImage s (1 <<< i.val) = (1 <<< (map60 s.points i).val) := by
  apply Nat.eq_of_testBit_eq
  intro p
  apply Bool.eq_iff_iff.mpr
  rw [image_bits]
  simp only [Nat.shiftLeft_eq,Nat.one_mul,Nat.testBit_two_pow,decide_eq_true_eq]
  constructor
  · rintro ⟨j,hij,e⟩
    exact (Fin.ext hij : i = j) ▸ e
  · intro eq
    exact ⟨i,rfl,eq⟩

theorem paint_eq (s : Action) (k w : Nat) : paint s k w = maskImage s w := by
  induction k generalizing w with
  | zero =>
    rw [paint]
    split
    next h => simpa [h] using (image_zero s).symm
    next => rfl
  | succ k ih =>
    rw [paint]
    split
    next h => simpa [h] using (image_zero s).symm
    next hn =>
      dsimp only
      split
      next bound =>
        rw [ih, ← image_singleton s ⟨w.log2,bound⟩, ← image_or]
        congr 1
        apply Nat.eq_of_testBit_eq
        intro p
        simp only [Nat.testBit_or,Nat.shiftLeft_eq,Nat.one_mul,Nat.testBit_two_pow,Nat.testBit_xor]
        by_cases hp : w.log2 = p
        · rw [←hp]
          simp [Nat.testBit_log2 hn]
        · simp [hp]
      next => rfl

def fast (a : Action) (w : Nat) : Nat := paint a 6 w
theorem fast_eq (a : Action) : fast a = maskImage a := funext (paint_eq a 6)

def fastFactor (a : Action) (f : List Nat) : List Nat := sorted (f.map (fast a))
theorem fastFactor_eq (a : Action) (f : List Nat) : fastFactor a f = factorImage a f := by
  simp only [fastFactor, factorImage, fast_eq]

def fastByIndex (g : Nat) (f : List Nat) (w : Nat) : Bool :=
  if w < 48*942 then
    match (actions g)[w % 48]? with
    | none => false
    | some a => fastFactor a f == PlaneCases.factor (w / 48)
  else (survivors g)[w - 48*942]? == some f

theorem fastByIndex_eq (g : Nat) (f : List Nat) (w : Nat) :
    fastByIndex g f w = byIndex g f w := by
  unfold fastByIndex byIndex
  by_cases h : w < 48*942
  · simp only [if_pos h]
    cases ha : (actions g)[w % 48]? <;> simp [fastFactor_eq]
  · simp [h]

def fastAccept (g : Nat) (f : List Nat) := fastByIndex g f (witness g f)
theorem fastAccept_eq (g : Nat) : fastAccept g = accept g :=
  funext (fun f => fastByIndex_eq g f _)

