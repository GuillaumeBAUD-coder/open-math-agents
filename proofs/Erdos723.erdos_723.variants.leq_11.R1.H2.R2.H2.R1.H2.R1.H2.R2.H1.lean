theorem pointExact (a : Bool) (i : Fin 344) (p : Fin 60) :
    (row a i.val).testBit p.val = (point a p.val).testBit i.val := by
  let k : Fin 43 := ⟨i.val / 8, by omega⟩
  let j : Fin 8 := ⟨i.val % 8, Nat.mod_lt _ (by decide)⟩
  have all : pointChunk a k.val := by cases a <;> first | exact pc_false k | exact pc_true k
  have h := all j p
  have e : 8*k.val + j.val = i.val := by dsimp [k,j]; omega
  rwa [e] at h
