theorem good_at_root
    (xs c d : List Nat) (bounds : ∀ i ∈ xs, i < 344)
    (hc : MatchingRows.legal 9 c) (hd : MatchingRows.legal 14 d)
    (rc : ∀ i ∈ xs, ∀ x ∈ c, MatchingRows.thin (rootRow i &&& x))
    (rd : ∀ i ∈ xs, ∀ x ∈ d, MatchingRows.thin (rootRow i &&& x))
    (cd : ∀ x ∈ c, ∀ y ∈ d, MatchingRows.thin (x &&& y)) :
    ∃ W, EC.Family tables W ∧ EC.Good tables W (init xs) :=
  good_at_root_of_tables pointExact rowCovers xs c d bounds hc hd rc rd cd


end PlaneData

