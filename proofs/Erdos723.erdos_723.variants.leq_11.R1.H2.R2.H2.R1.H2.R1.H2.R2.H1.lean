theorem cover_from_selected {g : Fin 15} (hg : g.val ∈ [0,9,14])
    (routes : List Route) (selected : List Nat) (truth : List (List Nat))
    (contains : ∀ r ∈ RootTables.marked g.val, r ∈ routes.map Route.source)
    (checked : ∀ r ∈ routes, VerifiedRoute r g selected truth)
    (localCover : ∀ (f : List Nat), Viable g.val f → ∀ y ∈ selected, y ∈ f → f ∈ truth)
    (f : List Nat) (hf : Viable g.val f)
    (hm : ∃ x ∈ f, x &&& RootTables.marker g.val = RootTables.marker g.val) : f ∈ truth := by
  obtain ⟨x,hx,hit⟩ := hm
  have hcat := catalogue_complete g ((legal_factors g.isLt hf.1).1 x hx)
  have hmarked := RootTables.marked_complete g hg x hcat hit
  obtain ⟨r,hr,rx⟩ := List.mem_map.mp (contains x hmarked)
  obtain ⟨valid,fix,move,mem,back⟩ := checked r hr
  have hf' := viable_preserved r.action valid g fix hf
  have he : r.target ∈ factorImage r.action f := by
    apply (factor_mem ..).mpr
    exact ⟨x,hx,rx ▸ move⟩
  have hfinal := back _ (localCover _ hf' _ mem he)
  rwa [inverse_factor r.action valid hf.1] at hfinal

