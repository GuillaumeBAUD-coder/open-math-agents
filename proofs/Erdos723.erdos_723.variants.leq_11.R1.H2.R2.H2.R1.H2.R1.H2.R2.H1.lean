theorem covered9 (reject : ∀ k : Fin 942, ¬ Extends (PlaneCases.factor k.val) 9 14)
    (f : List Nat) (hf : Viable 9 f)
    (hm : ∃ x ∈ f, x &&& RootTables.marker 9 = RootTables.marker 9) :
    f ∈ survivors9 := by
  apply cover_from_selected (g := 9) (by decide) routes9 selected9 survivors9
    markers9 verified9 _ f hf hm
  intro a hv y hy hya
  have hg : (9 : Fin 15).val ∈ ([0,9,14] : List Nat) := by decide
  have pts := RootTables.byPoint_complete (9 : Fin 15) hg
  apply CenterCheck.sound (9 : Fin 15) hg a hv _ reject
  apply RF.root_sound (g := 9) hv.1 hya (RootTables.byPoint 9) (accept 9) pts
  simp only [selected9,List.mem_cons,List.not_mem_nil,or_false] at hy
  rcases hy with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact root9_0
  · exact root9_1
  · exact root9_2
  · exact root9_3
  · exact root9_9
  · exact root9_10
  · exact root9_13
  · exact root9_15

end MatchingRows.Orbit

namespace MatchingRows.Orbit

theorem final_cover (g : Fin 15) (hg : g.val ∈ [0,9,14]) (f : List Nat) (hv : Viable g.val f)
    (joined : ∃ x ∈ f, x &&& RootTables.marker g.val = RootTables.marker g.val)
    (reject : ∀ k : Fin 942, ¬ Extends (PlaneCases.factor k.val) 9 14) :
    f ∈ CenterCheck.survivors g.val := by
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hg
  rcases hg with h | h | h
  · have eq : g = 0 := Fin.ext h
    subst g
    exact covered0 reject f hv joined
  · have eq : g = 9 := Fin.ext h
    subst g
    exact covered9 reject f hv joined
  · have eq : g = 14 := Fin.ext h
    subst g
    exact survivors_fourteen_of_zero (covered0 reject) f hv joined

theorem survivor_length (g : Fin 15) (hg : g.val ∈ [0,9,14]) :
    (CenterCheck.survivors g.val).length = 34 := by
  revert g
  decide +kernel

end MatchingRows.Orbit

open MatchingRows MatchingRows.Orbit in
theorem OMA.solution : OMA.R_Erdos723_erdos_723_variants_leq_11_R1_H2_R2_H2_R1_H2_R1_H2_R2.H1 := by
  intro g hg S hS
  have hg' : g < 15 := by
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hg
    omega
  let center : Fin 15 := ⟨g,hg'⟩
  have hsub : S ⊆ (CenterCheck.survivors g).toFinset := by
    intro f hf
    have h := hS f hf
    exact List.mem_toFinset.mpr (final_cover center hg f h.1 h.2 PlaneCases.rejected)
  calc
    S.card ≤ (CenterCheck.survivors g).toFinset.card := Finset.card_le_card hsub
    _ ≤ (CenterCheck.survivors g).length := List.toFinset_card_le _
    _ = 34 := survivor_length center hg
