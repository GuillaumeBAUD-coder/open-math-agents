import OMAStatements.S_oeis_a267598

-- Problem: A267598: Triangle read by rows giving successive states of cellular automaton generated by Rule 177
-- Credit: @neutroxium

namespace OMA.Proof_oeis_a267598

open OMA.S_oeis_a267598

private lemma ruleOut_177 (l c r : Bool) :
    ruleOut 177 l c r =
      match l, c, r with
      | false, false, false => true
      | false, false, true  => false
      | false, true,  false => false
      | false, true,  true  => false
      | true,  false, false => true
      | true,  false, true  => true
      | true,  true,  false => false
      | true,  true,  true  => true := by
  cases l <;> cases c <;> cases r <;> decide

/-- Exact closed form of the tape at step `t >= 1`:
- outside `[-t, t - 1]`, every cell is `true`;
- at `i = t - 1`, the cell is `false`;
- on `[-t, t - 2]`, the cell alternates `false, true, false, true, ...`,
  i.e., `true` iff `(i + t) % 2 = 1`. -/
private def tape (t : ℕ) (i : ℤ) : Bool :=
  if i < -(t : ℤ) then true
  else if (t : ℤ) ≤ i then true
  else if i = (t : ℤ) - 1 then false
  else decide ((i + (t : ℤ)) % 2 = 1)

private lemma tape_lt {t : ℕ} {i : ℤ} (h : i < -(t : ℤ)) : tape t i = true := by
  unfold tape; rw [if_pos h]

private lemma tape_ge {t : ℕ} {i : ℤ} (ht : 1 ≤ t) (h : (t : ℤ) ≤ i) : tape t i = true := by
  unfold tape
  rw [if_neg (by omega), if_pos h]

private lemma tape_eq_sub_one {t : ℕ} (ht : 1 ≤ t) : tape t ((t : ℤ) - 1) = false := by
  unfold tape
  rw [if_neg (by omega), if_neg (by omega), if_pos rfl]

private lemma tape_mid {t : ℕ} {i : ℤ} (hlo : -(t : ℤ) ≤ i) (hhi : i ≤ (t : ℤ) - 2) :
    tape t i = decide ((i + (t : ℤ)) % 2 = 1) := by
  unfold tape
  rw [if_neg (by omega), if_neg (by omega), if_neg (by omega)]

private lemma cell_177_one (i : ℤ) : cell 177 1 i = tape 1 i := by
  change ruleOut 177 (decide (i - 1 = 0)) (decide (i = 0)) (decide (i + 1 = 0)) = tape 1 i
  by_cases hm : i = -1
  · subst hm
    rw [tape_mid (t := 1) (by omega) (by omega)]
    decide
  · by_cases h0 : i = 0
    · subst h0
      have h : tape 1 0 = false := by simpa using tape_eq_sub_one (t := 1) (by omega)
      rw [h]; decide
    · by_cases hp : i = 1
      · subst hp
        rw [tape_ge (t := 1) (by omega) (by omega)]
        decide
      · have h1 : i - 1 ≠ 0 := by omega
        have h2 : i + 1 ≠ 0 := by omega
        rw [decide_eq_false h1, decide_eq_false h0, decide_eq_false h2, ruleOut_177]
        by_cases hlt : i < -1
        · exact (tape_lt (t := 1) (by omega)).symm
        · exact (tape_ge (t := 1) (by omega) (by omega)).symm

private lemma tape_step (t : ℕ) (ht : 1 ≤ t) (i : ℤ) :
    ruleOut 177 (tape t (i - 1)) (tape t i) (tape t (i + 1)) = tape (t + 1) i := by
  by_cases h1 : i < -((t + 1 : ℕ) : ℤ)
  · rw [tape_lt (by push_cast at h1; omega), tape_lt (by push_cast at h1; omega),
      tape_lt (by push_cast at h1; omega), tape_lt h1, ruleOut_177]
  · by_cases h2 : i = -((t + 1 : ℕ) : ℤ)
    · subst h2
      have hL : tape t (-((t + 1 : ℕ) : ℤ) - 1) = true := tape_lt (by push_cast; omega)
      have hC : tape t (-((t + 1 : ℕ) : ℤ)) = true := tape_lt (by push_cast; omega)
      have hOut : tape (t + 1) (-((t + 1 : ℕ) : ℤ)) = false := by
        rw [tape_mid (t := t + 1) (by omega) (by push_cast; omega)]
        exact decide_eq_false (by omega)
      rw [hL, hC, hOut]
      have hR : tape t (-((t + 1 : ℕ) : ℤ) + 1) = false := by
        have heq : -((t + 1 : ℕ) : ℤ) + 1 = -(t : ℤ) := by push_cast; omega
        rw [heq]
        by_cases ht1 : t = 1
        · subst ht1; rw [tape_mid (t := 1) (by omega) (by omega)]; decide
        · rw [tape_mid (t := t) (by omega) (by omega)]
          exact decide_eq_false (by omega)
      rw [hR, ruleOut_177]
    · by_cases h3 : i = -(t : ℤ)
      · subst h3
        have hL : tape t (-(t : ℤ) - 1) = true := tape_lt (by omega)
        have hOut : tape (t + 1) (-(t : ℤ)) = true := by
          rw [tape_mid (t := t + 1) (by push_cast; omega) (by push_cast; omega)]
          exact decide_eq_true (by push_cast; omega)
        rw [hL, hOut]
        by_cases ht1 : t = 1
        · subst ht1
          have hC : tape 1 (-(1 : ℕ)) = false := by
            rw [tape_mid (t := 1) (by omega) (by omega)]; decide
          have hR : tape 1 (-(1 : ℕ) + 1) = false := by
            have h := tape_eq_sub_one (t := 1) (by omega)
            simpa using h
          rw [hC, hR, ruleOut_177]
        · have hC : tape t (-(t : ℤ)) = false := by
            rw [tape_mid (t := t) (by omega) (by omega)]
            exact decide_eq_false (by omega)
          rw [hC]
          by_cases ht2 : t = 2
          · subst ht2
            have hR : tape 2 (-(2 : ℕ) + 1) = true := by
              rw [tape_mid (t := 2) (by omega) (by omega)]; decide
            rw [hR, ruleOut_177]
          · have hR : tape t (-(t : ℤ) + 1) = true := by
              rw [tape_mid (t := t) (by omega) (by omega)]
              exact decide_eq_true (by omega)
            rw [hR, ruleOut_177]
      · by_cases h4 : ((t + 1 : ℕ) : ℤ) ≤ i
        · rw [tape_ge ht (by push_cast at h4; omega), tape_ge ht (by push_cast at h4; omega),
            tape_ge ht (by push_cast at h4; omega), tape_ge (by omega) h4, ruleOut_177]
        · by_cases h5 : i = (t : ℤ)
          · subst h5
            rw [tape_eq_sub_one ht, tape_ge ht (by omega), tape_ge ht (by omega)]
            have hrhs : tape (t + 1) (t : ℤ) = false := by
              have h := tape_eq_sub_one (t := t + 1) (by omega)
              rwa [show ((t + 1 : ℕ) : ℤ) - 1 = (t : ℤ) by push_cast; omega] at h
            rw [hrhs, ruleOut_177]
          · by_cases h6 : i = (t : ℤ) - 1
            · subst h6
              have hC : tape t ((t : ℤ) - 1) = false := tape_eq_sub_one ht
              have hR : tape t ((t : ℤ) - 1 + 1) = true := tape_ge ht (by omega)
              have hOut : tape (t + 1) ((t : ℤ) - 1) = false := by
                rw [tape_mid (t := t + 1) (by push_cast; omega) (by push_cast; omega)]
                exact decide_eq_false (by push_cast; omega)
              have hL : tape t ((t : ℤ) - 1 - 1) = false := by
                by_cases ht1 : t = 1
                · subst ht1
                  rw [show ((1 : ℕ) : ℤ) - 1 - 1 = -1 by omega,
                    tape_mid (t := 1) (by omega) (by omega)]
                  decide
                · rw [tape_mid (t := t) (by omega) (by omega)]
                  exact decide_eq_false (by omega)
              rw [hL, hC, hR, hOut, ruleOut_177]
            · by_cases h7 : i = (t : ℤ) - 2
              · subst h7
                have ht2 : 2 ≤ t := by omega
                have hL : tape t ((t : ℤ) - 2 - 1) = true := by
                  rw [tape_mid (t := t) (by omega) (by omega)]
                  exact decide_eq_true (by omega)
                have hC : tape t ((t : ℤ) - 2) = false := by
                  rw [tape_mid (t := t) (by omega) (by omega)]
                  exact decide_eq_false (by omega)
                have hR : tape t ((t : ℤ) - 2 + 1) = false := by
                  rw [show (t : ℤ) - 2 + 1 = (t : ℤ) - 1 by omega]
                  exact tape_eq_sub_one ht
                have hOut : tape (t + 1) ((t : ℤ) - 2) = true := by
                  rw [tape_mid (t := t + 1) (by push_cast; omega) (by push_cast; omega)]
                  exact decide_eq_true (by push_cast; omega)
                rw [hL, hC, hR, hOut, ruleOut_177]
              · -- Strictly interior: -t + 1 <= i <= t - 3
                rw [tape_mid (t := t) (by push_cast at h1 h2 h4; omega) (by omega),
                  tape_mid (t := t) (by push_cast at h1 h2 h4; omega) (by omega),
                  tape_mid (t := t) (by push_cast at h1 h2 h4; omega) (by omega),
                  tape_mid (t := t + 1) (by push_cast at h1 h2 h4; omega) (by push_cast; omega)]
                have hpar : (i + (t : ℤ)) % 2 = 0 ∨ (i + (t : ℤ)) % 2 = 1 := by omega
                rcases hpar with hp | hp
                · rw [decide_eq_true (by omega : (i - 1 + (t : ℤ)) % 2 = 1),
                    decide_eq_false (by omega : ¬ (i + (t : ℤ)) % 2 = 1),
                    decide_eq_true (by omega : (i + 1 + (t : ℤ)) % 2 = 1),
                    decide_eq_true (by push_cast; omega : (i + ((t + 1 : ℕ) : ℤ)) % 2 = 1),
                    ruleOut_177]
                · rw [decide_eq_false (by omega : ¬ (i - 1 + (t : ℤ)) % 2 = 1),
                    decide_eq_true hp,
                    decide_eq_false (by omega : ¬ (i + 1 + (t : ℤ)) % 2 = 1),
                    decide_eq_false (by push_cast; omega : ¬ (i + ((t + 1 : ℕ) : ℤ)) % 2 = 1),
                    ruleOut_177]

private lemma cell_177_formula (t : ℕ) (ht : 1 ≤ t) (i : ℤ) : cell 177 t i = tape t i := by
  induction t generalizing i with
  | zero => omega
  | succ t ih =>
    cases t with
    | zero => exact cell_177_one i
    | succ t =>
      change ruleOut 177 (cell 177 (t + 1) (i - 1)) (cell 177 (t + 1) i)
          (cell 177 (t + 1) (i + 1)) = tape (t + 2) i
      rw [ih (by omega), ih (by omega), ih (by omega)]
      exact tape_step (t + 1) (by omega) i

private lemma sqrt_eq_of_bounds {m r : ℕ} (h1 : r * r ≤ m) (h2 : m < (r + 1) * (r + 1)) :
    Nat.sqrt m = r :=
  le_antisymm (Nat.le_of_lt_succ (Nat.sqrt_lt.mpr h2)) (Nat.le_sqrt.mpr h1)

private lemma mul_self_add_mod_two (r : ℕ) : (r * r + r) % 2 = 0 := by
  rcases Nat.even_or_odd r with ⟨m, rfl⟩ | ⟨m, rfl⟩
  · rw [show (m + m) * (m + m) + (m + m) = 2 * (2 * m * m + m) by ring]; omega
  · rw [show (2 * m + 1) * (2 * m + 1) + (2 * m + 1) = 2 * (2 * m * m + 3 * m + 1) by ring]; omega

private lemma neg_one_pow_div (m : ℕ) :
    (1 - (-1 : ℤ) ^ m) / 2 = if m % 2 = 1 then 1 else 0 := by
  rcases Nat.even_or_odd m with ⟨k, hk⟩ | ⟨k, hk⟩
  · subst hk
    have h1 : (-1 : ℤ) ^ (k + k) = 1 := by
      rw [show k + k = 2 * k by omega, pow_mul]; norm_num
    have h2 : (k + k) % 2 ≠ 1 := by omega
    simp [h1, h2]
  · subst hk
    have h1 : (-1 : ℤ) ^ (2 * k + 1) = -1 := by
      rw [pow_succ, pow_mul]; norm_num
    have h2 : (2 * k + 1) % 2 = 1 := by omega
    simp [h1, h2]

private lemma main_proof : ∀ n : ℕ, a n = (1 - (-1 : ℤ) ^ (n + Nat.sqrt (n + 2))) / 2 := by
  intro n
  rw [neg_one_pow_div]
  rcases Nat.eq_zero_or_pos n with rfl | hpos
  · unfold a
    have hsq0 : Nat.sqrt 0 = 0 := by simp
    have hsq2 : Nat.sqrt 2 = 1 := sqrt_eq_of_bounds (by omega) (by omega)
    simp [hsq0, hsq2, cell]
  · set r := Nat.sqrt n with hr_def
    have hr_le : r * r ≤ n := Nat.sqrt_le n
    have hr_lt : n < (r + 1) * (r + 1) := Nat.lt_succ_sqrt n
    have hr_pos : 1 ≤ r := by
      by_contra h0
      have hr0 : r = 0 := by omega
      rw [hr0] at hr_lt
      omega
    set k := n - r * r with hk_def
    have hn_eq : n = r * r + k := by omega
    have hk_le : k ≤ 2 * r := by nlinarith
    have ha_eq : a n = if cell 177 r ((k : ℤ) - (r : ℤ)) then 1 else 0 := by
      unfold a
      dsimp only
    rw [ha_eq, cell_177_formula r hr_pos]
    have hrr := mul_self_add_mod_two r
    by_cases hk2r : k = 2 * r
    · rw [tape_ge hr_pos (by omega)]
      have hsq : Nat.sqrt (n + 2) = r + 1 := sqrt_eq_of_bounds (by nlinarith) (by nlinarith)
      have hpar : (n + (r + 1)) % 2 = 1 := by omega
      rw [hsq, if_pos hpar]; rfl
    · by_cases hk2r1 : k = 2 * r - 1
      · have hi_eq : (k : ℤ) - (r : ℤ) = (r : ℤ) - 1 := by omega
        rw [hi_eq, tape_eq_sub_one hr_pos]
        have hsq : Nat.sqrt (n + 2) = r + 1 := sqrt_eq_of_bounds (by nlinarith) (by nlinarith)
        have hpar : (n + (r + 1)) % 2 ≠ 1 := by omega
        rw [hsq, if_neg hpar]; rfl
      · have hk_le2 : k + 2 ≤ 2 * r := by omega
        rw [tape_mid (t := r) (by omega) (by omega)]
        have hsq : Nat.sqrt (n + 2) = r := sqrt_eq_of_bounds (by nlinarith) (by nlinarith)
        have hsum_eq : ((k : ℤ) - (r : ℤ) + (r : ℤ)) = (k : ℤ) := by omega
        have hpar_iff : ((k : ℤ) % 2 = 1) ↔ ((n + r) % 2 = 1) := by omega
        rw [hsum_eq, hsq]
        by_cases h1 : (k : ℤ) % 2 = 1
        · rw [decide_eq_true h1, if_pos (hpar_iff.mp h1)]; rfl
        · rw [decide_eq_false h1, if_neg (fun h => h1 (hpar_iff.mpr h))]; rfl

end OMA.Proof_oeis_a267598

theorem OMA.solution : type_of% @OMA.S_oeis_a267598.main :=
  OMA.Proof_oeis_a267598.main_proof
