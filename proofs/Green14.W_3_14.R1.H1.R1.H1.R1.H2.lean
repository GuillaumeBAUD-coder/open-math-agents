  have h2 : 184 - (a + 2*d) + 2*d = 184 - a := by dsimp [board] at hb; omega
  have h3 : 184 - (a + 2*d) + d = 184 - (a + d) := by dsimp [board] at hb; omega
  exact h (184 - (a + 2*d)) d hd (by dsimp [board] at hb ⊢; omega)
