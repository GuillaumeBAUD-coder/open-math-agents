private lemma noBlue_rev {c : Nat → Bool} (h : NoBlueRuns c) :
    NoBlueRuns (fun q => c (184 - q)) := by
  intro a d hd hb
  obtain ⟨t, ht⟩ := h (184 - (a + 13*d)) d hd (by dsimp [board] at hb ⊢; omega)
