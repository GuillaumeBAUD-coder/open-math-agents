theorem V_tab (j : Fin 5) : ∀ s : St, (V Rel j.val s : ℤ) = tab j (s.1 0) (s.1 1) (s.1 2) (s.1 3) s.2 := by
  induction j using Fin.induction with
  | zero => intro s; simp [V]; rfl
  | succ j ih =>
    intro s
    simp only [Fin.val_castSucc] at ih
    rw [Fin.val_succ, step j]
    simp only [V]
    push_cast
    rw [sum_St]
    refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => Finset.sum_congr rfl
      fun c _ => Finset.sum_congr rfl fun d _ => Finset.sum_congr rfl fun e _ => ?_
    have hs : s = (![s.1 0, s.1 1, s.1 2, s.1 3], s.2) := Prod.ext (row_eta s.1) rfl
    rw [← hs]
    split_ifs
    · rw [ih]; rfl
    · rfl

theorem h0tab : ∀ a b c d : Fin 4, ∀ e : Fin 2,
    ∑ j ∈ Finset.range 5, cc j * tab ⟨j % 5, Nat.mod_lt _ (by norm_num)⟩ a b c d e = 0 := by
  decide +kernel

theorem h0V : ∀ s : St, ∑ j ∈ Finset.range (4 + 1), cc j * (V Rel j s : ℤ) = 0 := by
  intro s
  have h := h0tab (s.1 0) (s.1 1) (s.1 2) (s.1 3) s.2
  rw [← h]
  refine Finset.sum_congr rfl fun j hj => ?_
  rw [Finset.mem_range] at hj
  have := V_tab ⟨j % 5, Nat.mod_lt _ (by norm_num)⟩ s
  simp only [Nat.mod_eq_of_lt hj] at this ⊢
  rw [this]

