theorem drec_base : ∀ t : ℕ, t < 12 → (dv (t + 10) : ℤ) = 2 * (dv (t + 9) : ℤ) - (dv (t + 8) : ℤ) - (dv (t + 6) : ℤ) + 2 * (dv (t + 5) : ℤ) - (dv (t + 4) : ℤ) - (dv (t + 2) : ℤ) + 2 * (dv (t + 1) : ℤ) - (dv (t + 0) : ℤ) := by
