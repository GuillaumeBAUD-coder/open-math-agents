private lemma total : ∑ v : V, (ord (tag v)).totient = 23984 := by
  rw [← Equiv.sum_comp (finProdFinEquiv (m := 84) (n := 72)), Fintype.sum_prod_type]
  let sumBlock (i : Fin 84) := ∑ j : Fin 72, (ord (tag (finProdFinEquiv (i,j)))).totient
  let target : Fin 84 → ℕ := ![143, 144, 144, 144, 144, 144, 144, 144, 144, 144, 144, 144, 144, 144, 144, 144, 144, 88, 267, 288, 288, 288, 288, 288, 288, 288, 288, 288, 346, 432, 432, 432, 432, 432, 432, 432, 432, 432, 432, 432, 316, 296, 432, 432, 432, 432, 432, 432, 432, 432, 432, 432, 432, 280, 252, 288, 288, 288, 288, 288, 288, 288, 288, 288, 288, 288, 288, 288, 288, 288, 288, 252, 144, 144, 144, 144, 144, 288, 288, 288, 288, 288, 288, 288]
  change ∑ i, sumBlock i = _
  have eq : ∀ i, sumBlock i = target i := by
    intro i
    fin_cases i <;> decide +kernel
  simp_rw [eq]
  decide +kernel

theorem witness : ∃ (G : Type) (_ : Group G) (_ : Fintype G), IsSimpleGroup G ∧
    Fintype.card G = 6048 ∧ ∑ g : G, Nat.totient (orderOf g) = 23984 := by
  let : Fintype G := Fintype.ofEquiv V label.symm
  refine ⟨G, inferInstance, inferInstance, simple, Fintype.card_congr label |>.trans (Fintype.card_fin _), ?_⟩
  rw [← Equiv.sum_comp label.symm]
  change ∑ v : V, Nat.totient (orderOf (elt v)) = _
  simp_rw [order_at]
  exact total

