  Fin.ofNat 6048 <| (( : ℕ) >>> (13 * i.val)) % 8192

private def dist (i : V) : ℕ :=
  (( : ℕ) >>> (5 * i.val)) % 32

private def tag (i : V) : T :=
  Fin.ofNat 14 <| (( : ℕ) >>> (4 * i.val)) % 16

private def rep : T → V :=
  ![0, 1, 673, 736, 1240, 1303, 2059, 2923, 2986, 3850, 3906, 4662, 5166, 5544]

private def ord : T → ℕ :=
  ![1, 3, 4, 6, 2, 8, 7, 4, 7, 3, 8, 12, 4, 12]

private def repWord : T → List Bool :=
  ![[], [false], [true], [false, true], [true, true], [false, false, true], [false, true, true], [true, true, true], [false, false, true, true], [false, true, false, true], [false, true, true, true], [false, false, true, false, true], [false, true, false, true, true], [false, true, false, true, true, true]]


private def left (b : Bool) := if b then L1 else L0
private def right (b : Bool) := if b then R1 else R0
private def leftInv (b : Bool) := if b then Li1 else Li0
private def rightInv (b : Bool) := if b then Ri1 else Ri0
private def conjugate (b : Bool) (v : V) := left b (rightInv b v)

private lemma at_all (P : V → Prop)
    (h : ∀ i : Fin 84, ∀ j : Fin 72, P (Fin.ofNat 6048 (72*i.val+j.val))) (v : V) : P v := by
  have eq : Fin.ofNat 6048 (72*(v.val/72)+v.val%72) = v := by
    apply Fin.ext
    simp [Nat.div_add_mod]
  rw [← eq]
  exact h ⟨v.val/72, by omega⟩ ⟨v.val%72, Nat.mod_lt _ (by decide)⟩

private def facts (v : V) : Prop :=
    (∀ b, leftInv b (left b v) = v ∧ left b (leftInv b v) = v ∧
      rightInv b (right b v) = v ∧ right b (rightInv b v) = v) ∧
    (∀ b c, left b (right c v) = right c (left b v)) ∧
    (v ≠ 0 → (dist (left false v) < dist v ∨ dist (left true v) < dist v) ∧
      (dist (right false v) < dist v ∨ dist (right true v) < dist v)) ∧
    (v = rep (tag v) ∨ ∃ b : Bool, conjugate b v < v ∧ tag (conjugate b v) = tag v)

private instance (v : V) : Decidable (facts v) := by unfold facts; infer_instance

