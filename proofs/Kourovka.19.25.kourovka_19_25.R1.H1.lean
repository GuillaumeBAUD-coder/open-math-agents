private def lperm (b : Bool) : Equiv.Perm V where
  toFun := left b
  invFun := leftInv b
  left_inv v := ((localFacts v).1 b).1
  right_inv v := ((localFacts v).1 b).2.1

private def rperm (b : Bool) : Equiv.Perm V where
  toFun := right b
  invFun := rightInv b
  left_inv v := ((localFacts v).1 b).2.2.1
  right_inv v := ((localFacts v).1 b).2.2.2

private abbrev carrier := Subgroup.centralizer (Set.range rperm)
private abbrev G := ↥carrier

private def gen (b : Bool) : G :=
  ⟨lperm b, Subgroup.mem_centralizer_iff.mpr (by
    rintro _ ⟨c,rfl⟩
    apply Equiv.ext
    intro v
    exact ((localFacts v).2.1 b c).symm)⟩

private def index (g : G) : V := g.val 0

private lemma commute (g : G) (b : Bool) (v : V) :
    g.val (right b v) = right b (g.val v) := by
  have h := Subgroup.mem_centralizer_iff.mp g.property (rperm b) ⟨b,rfl⟩
  exact (congrArg (fun p : Equiv.Perm V => p v) h).symm

private lemma index_inj : Function.Injective index := by
  intro g h he
  apply Subtype.ext
  apply Equiv.ext
  intro v
  induction v using (measure dist).wf.induction with
  | h v ih =>
    by_cases hz : v = 0
    · subst v
      exact he
    obtain hstep := ((localFacts v).2.2.1 hz).2
    have step (b : Bool) (hb : dist (right b v) < dist v) : g.val v = h.val v := by
      apply (rperm b).injective
      exact (commute g b v).symm.trans ((ih _ hb).trans (commute h b v))
    exact hstep.elim (step false) (step true)

private lemma index_surj : Function.Surjective index := by
  intro v
  induction v using (measure dist).wf.induction with
  | h v ih =>
    by_cases hz : v = 0
    · exact ⟨1,hz.symm⟩
    obtain hstep := ((localFacts v).2.2.1 hz).1
    have step (b : Bool) (hb : dist (left b v) < dist v) : ∃ g : G, index g = v := by
      obtain ⟨g,hg⟩ := ih _ hb
      refine ⟨(gen b)⁻¹ * g, ?_⟩
      change leftInv b (index g) = v
      rw [hg]
      exact ((localFacts v).1 b).1
    exact hstep.elim (step false) (step true)

private noncomputable def label : G ≃ V := Equiv.ofBijective index ⟨index_inj,index_surj⟩
private noncomputable def elt (v : V) : G := label.symm v

private lemma idx_elt (v : V) : index (elt v) = v := label.apply_symm_apply _
private lemma elt_idx (g : G) : elt (index g) = g := label.symm_apply_apply _

private lemma idx_left (b : Bool) (g : G) : index (gen b * g) = left b (index g) := rfl

private lemma idx_right (b : Bool) (g : G) : index (g * gen b) = right b (index g) := by
  have he : left b 0 = right b 0 := (by decide +kernel : ∀ c, left c 0 = right c 0) b
  change g.val (left b 0) = _
  rw [he, commute]
  rfl

private lemma idx_conj (b : Bool) (g : G) :
    index (gen b * g * (gen b)⁻¹) = conjugate b (index g) := by
  have he := idx_right b (g * (gen b)⁻¹)
  rw [inv_mul_cancel_right] at he
  have h' : index (g * (gen b)⁻¹) = rightInv b (index g) := by
    rw [he]
    exact (((localFacts _).1 b).2.2.1).symm
  rw [mul_assoc, idx_left, h']
  rfl

private lemma rep_invariant (P : G → Prop)
    (h : ∀ g b, P (gen b * g * (gen b)⁻¹) ↔ P g) (v : V) :
    P (elt v) ↔ P (elt (rep (tag v))) := by
  induction v using (measure (fun x : V => x.val)).wf.induction with
  | h v ih =>
    rcases (localFacts v).2.2.2 with eq | ⟨b,hlt,ht⟩
    · rw [← eq]
    · have hc : elt (conjugate b v) = gen b * elt v * (gen b)⁻¹ := by
        apply index_inj
        rw [idx_elt,idx_conj,idx_elt]
      have hi := ih (conjugate b v) hlt
      rw [ht,hc] at hi
      exact (h (elt v) b).symm.trans hi

private def wordPerm (w : List Bool) (v : V) : V :=
  w.foldl (fun x b => left b x) v

private def wordGroup : List Bool → G
  | [] => 1
  | b::rest => wordGroup rest * gen b

private lemma word_apply (w : List Bool) (v : V) : (wordGroup w).val v = wordPerm w v := by
  induction w generalizing v with
  | nil => rfl
  | cons b w ih => exact ih (left b v)

private lemma idx_rep_word (t : T) : wordGroup (repWord t) = elt (rep t) := by
  apply index_inj
  rw [idx_elt]
  change (wordGroup (repWord t)).val 0 = _
  rw [word_apply]
  exact (by decide +kernel : ∀ z, wordPerm (repWord z) 0 = rep z) t

private lemma idx_power (w : List Bool) (n : ℕ) (v : V) :
    ((wordGroup w ^ n).val v) = (wordPerm w)^[n] v := by
  induction n generalizing v with
  | zero => rfl
  | succ n ih =>
    rw [pow_succ, Function.iterate_succ_apply]
    exact (ih _).trans (congrArg _ (word_apply w v))

private lemma rep_order (t : T) : orderOf (elt (rep t)) = ord t := by
  have cert := (by decide +kernel : ∀ z : T, 0 < ord z ∧
    (wordPerm (repWord z))^[ord z] 0 = 0 ∧
    ∀ i : Fin (ord z), 0 < i.val → (wordPerm (repWord z))^[i.val] 0 ≠ 0) t
  rw [← idx_rep_word]
  apply (orderOf_eq_iff cert.1).mpr
  constructor
  · apply index_inj
    exact (idx_power _ _ 0).trans cert.2.1
  · intro n hn hp he
    apply cert.2.2 ⟨n,hn⟩ hp
    rw [← idx_power]
    exact congrArg index he

private lemma order_at (v : V) : orderOf (elt v) = ord (tag v) := by
  apply (rep_invariant (fun g => orderOf g = ord (tag v)) ?_ v).mpr (rep_order _)
  intro g b
  change orderOf (MulAut.conj (gen b) g) = _ ↔ _
  rw [MulEquiv.orderOf_eq]

private lemma norm_rep (N : Subgroup G) (hn : N.Normal) (v : V) :
    elt v ∈ N ↔ elt (rep (tag v)) ∈ N := by
  apply rep_invariant
  intro g b
  rw [hn.mem_comm_iff, inv_mul_cancel_left]


private def conjWord (w : List Bool) (v : V) : V :=
  w.foldl (fun x b => conjugate b x) v

private lemma conjWord_mem (N : Subgroup G) (hn : N.Normal) (w : List Bool)
    (v : V) (hv : elt v ∈ N) : elt (conjWord w v) ∈ N := by
  induction w generalizing v with
  | nil => exact hv
  | cons b w ih =>
    apply ih
    have eq : elt (conjugate b v) = gen b * elt v * (gen b)⁻¹ := by
      apply index_inj
      rw [idx_elt,idx_conj,idx_elt]
    rw [eq]
    exact hn.conj_mem _ hv _

private lemma normal_edge (N : Subgroup G) (hn : N.Normal) (s d : T) (w : List Bool)
    (hc : tag (wordPerm (repWord s) (conjWord w (rep s))) = d)
    (hs : elt (rep s) ∈ N) : elt (rep d) ∈ N := by
  let y := conjWord w (rep s)
  let z := wordPerm (repWord s) y
  have eq : elt z = elt (rep s) * elt y := by
    apply index_inj
    rw [idx_elt, ← idx_rep_word]
    change z = (wordGroup (repWord s)).val (index (elt y))
    rw [idx_elt,word_apply]
  have hz : elt z ∈ N := eq ▸ N.mul_mem hs (conjWord_mem N hn w (rep s) hs)
  have h := (norm_rep N hn z).mp hz
  exact hc ▸ h

private lemma spread (P : T → Prop)
    (edge : ∀ s d w, tag (wordPerm (repWord s) (conjWord w (rep s))) = d → P s → P d) :
    (∀ t : T, t ≠ 0 → P t → P 1) ∧ (P 1 → ∀ t : T, t ≠ 0 → P t) := by
  have a1 : P 1 → P 1 := id
  have a3 : P 3 → P 1 := fun h => a1 (edge 3 1 [false, false, true, false] (by decide +kernel) h)
  have a4 : P 4 → P 1 := fun h => a1 (edge 4 1 [false, true, true, false] (by decide +kernel) h)
  have a5 : P 5 → P 1 := fun h => a1 (edge 5 1 [false, true, true, false, true, false] (by decide +kernel) h)
  have a6 : P 6 → P 1 := fun h => a1 (edge 6 1 [false] (by decide +kernel) h)
  have a8 : P 8 → P 1 := fun h => a1 (edge 8 1 [false] (by decide +kernel) h)
  have a10 : P 10 → P 1 := fun h => a1 (edge 10 1 [false, false, true, true, false, true] (by decide +kernel) h)
  have a11 : P 11 → P 1 := fun h => a1 (edge 11 1 [false, true, false, true, true, false, false] (by decide +kernel) h)
  have a12 : P 12 → P 1 := fun h => a1 (edge 12 1 [false, false, true, false, true] (by decide +kernel) h)
  have a13 : P 13 → P 1 := fun h => a1 (edge 13 1 [false, false, true, false, true] (by decide +kernel) h)
  have a2 : P 2 → P 1 := fun h => a3 (edge 2 3 [false, true, true, false] (by decide +kernel) h)
  have a7 : P 7 → P 1 := fun h => a3 (edge 7 3 [false, true, true, false] (by decide +kernel) h)
  have a9 : P 9 → P 1 := fun h => a3 (edge 9 3 [true, true] (by decide +kernel) h)
  constructor
  · intro t ht
    fin_cases t <;> first | exact False.elim (ht rfl) | assumption
  · intro h1
    have h13 := edge 1 13 [true] (by decide +kernel) h1
    have h6 := edge 1 6 [true, true] (by decide +kernel) h1
    have h10 := edge 1 10 [true, false, true] (by decide +kernel) h1
    have h8 := edge 1 8 [true, false, false, true] (by decide +kernel) h1
    have h11 := edge 1 11 [true, false, true, true] (by decide +kernel) h1
    have h5 := edge 1 5 [true, false, false, true, true] (by decide +kernel) h1
    have h4 := edge 1 4 [true, false, true, false, true] (by decide +kernel) h1
    have h7 := edge 1 7 [true, false, false, true, false, false, true] (by decide +kernel) h1
    have h12 := edge 1 12 [true, false, true, false, false, true, true] (by decide +kernel) h1
    have h3 := edge 1 3 [true, false, true, true, false, true, true] (by decide +kernel) h1
    have h9 := edge 13 9 [true, true] (by decide +kernel) h13
    have h2 := edge 6 2 [false, true, false, true, false, true] (by decide +kernel) h6
    intro t ht
    fin_cases t <;> first | exact False.elim (ht rfl) | assumption

private lemma zero_tag (v : V) (h : tag v = 0) : v = 0 := by
  have heq := order_at v
  rw [h] at heq
  have ho : ord (0:T) = 1 := by decide +kernel
  rw [ho, orderOf_eq_one_iff] at heq
  calc v = index (elt v) := (idx_elt v).symm
       _ = index 1 := congrArg index heq
       _ = 0 := rfl

private theorem simple : IsSimpleGroup G := by
  have hnt : Nontrivial G := ⟨elt 0, elt 1, fun h => (by decide : (0:V) ≠ 1) (label.symm.injective h)⟩
  constructor
  intro N hn
  by_cases hbot : N = ⊥
  · exact Or.inl hbot
  right
  obtain ⟨g,hg,hg1⟩ : ∃ g : G, g ∈ N ∧ g ≠ 1 := by
    obtain ⟨v,hv⟩ := Subgroup.ne_bot_iff_exists_ne_one.mp hbot
    exact ⟨v,v.property,fun e => hv (Subtype.ext e)⟩
  have ht : tag (index g) ≠ 0 := by
    intro h
    exact hg1 (index_inj (zero_tag _ h))
  have h := spread (fun t => elt (rep t) ∈ N) (normal_edge N hn)
  have h1 := h.1 _ ht ((norm_rep N hn (index g)).mp (by rwa [elt_idx]))
  apply top_unique
  intro x _
  by_cases ht' : tag (index x) = 0
  · have hxe : x = 1 := index_inj (zero_tag _ ht')
    rw [hxe]
    exact N.one_mem
  · rw [← elt_idx x]
    exact (norm_rep N hn _).mpr (h.2 h1 _ ht')

