    (hn : NoTriple S) (hm : LineMeets 158 S)
    (h78 : S 78) (h79 : ¬S 79) (h80 : ¬S 80) (h77 : ¬S 77) (h81 : ¬S 81) (h76 : ¬S 76) (h75 : ¬S 75) (h82 : ¬S 82) (h74 : ¬S 74) (h83 : ¬S 83) (h73 : ¬S 73) (h84 : ¬S 84) : False := by
