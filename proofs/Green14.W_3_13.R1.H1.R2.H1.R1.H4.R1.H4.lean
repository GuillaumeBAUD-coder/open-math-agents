  have start (x : Nat) (hx : S x) : (0x21084210842108421084210842108421084210842108421084210842108421084210842108421084210842108420000000040000001084210842108421084210842108421084210842108421084210842108421084210842108421084210842108421 : Nat).testBit (5*x) = true := by
    rcases allowed ⟨x, by have := bound157 x hx; omega⟩ with hmem | hok
    · simp only [List.mem_cons, List.not_mem_nil, or_false] at hmem
      rcases hmem with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
