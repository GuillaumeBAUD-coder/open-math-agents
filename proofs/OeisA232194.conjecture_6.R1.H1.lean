/-!
For each n from 6 through 1000, the table supplies q. The kernel checks that
q is positive, p = n - q is prime, and n * q² + 1 is prime.
-/

-- The literal represents 9200!, so it contains every possible trial divisor
-- of a candidate below 9201². The equality itself is verified in the kernel.
private def divisorProduct : ℕ := 

set_option maxRecDepth 24000 in
set_option maxHeartbeats 0 in
private theorem divisorProduct_eq : divisorProduct = Nat.factorial 9200 := by
  decide +kernel

private def smallDivisorProduct : ℕ := 0x1b30964ec395dc24069528d54bbda40d16e966ef9a70eb21b5b2943a321cdf10391745570cca9420c6ecb3b72ed2ee8b02ea2735c61a000000000000000000000000

private theorem smallDivisorProduct_eq : smallDivisorProduct = Nat.factorial 100 := by
  decide +kernel

private theorem prime_of_trial {n cutoff product : ℕ} (hn : 2 ≤ n)
    (productEq : product = Nat.factorial cutoff) (root : n.sqrt ≤ cutoff)
    (gcdOne : n.gcd product = 1) : n.Prime := by
  rw [Nat.prime_def_le_sqrt]
  refine ⟨hn, fun d hd hroot dvd => ?_⟩
  have factorialDvd : d ∣ product := by
    rw [productEq]
    exact Nat.dvd_factorial (by omega) (hroot.trans root)
  have one : d ∣ 1 := gcdOne ▸ Nat.dvd_gcd dvd factorialDvd
  exact (by omega : d ≠ 1) (Nat.dvd_one.mp one)

private def primeCheck (n : ℕ) : Bool :=
  if n ≤ 100 then decide n.Prime
  else if n < 101 ^ 2 then decide (n.gcd smallDivisorProduct = 1)
  else decide (n < 9201 ^ 2 ∧ n.gcd divisorProduct = 1)

private theorem primeCheck_sound {n : ℕ} (h : primeCheck n = true) : n.Prime := by
  by_cases tiny : n ≤ 100
  · exact of_decide_eq_true (by simpa only [primeCheck, if_pos tiny] using h)
  · by_cases small : n < 101 ^ 2
    · apply prime_of_trial (by omega) smallDivisorProduct_eq
        (Nat.lt_succ_iff.mp (Nat.sqrt_lt.mpr (by simpa [pow_two] using small)))
      exact of_decide_eq_true (by simpa only [primeCheck, if_neg tiny, if_pos small] using h)
    · have data : n < 9201 ^ 2 ∧ n.gcd divisorProduct = 1 :=
        of_decide_eq_true (by simpa only [primeCheck, if_neg tiny, if_neg small] using h)
      exact prime_of_trial (by omega) divisorProduct_eq
        (Nat.lt_succ_iff.mp (Nat.sqrt_lt.mpr (by simpa [pow_two] using data.1))) data.2

private def verify (first : ℕ) (values : List ℕ) : Bool :=
  (values.zipIdx first).all fun (q, n) =>
    decide (0 < q ∧ q ≤ n) && primeCheck (n - q) && primeCheck (n * q ^ 2 + 1)

private theorem verify_append {first : ℕ} {left right : List ℕ}
    (hLeft : verify first left = true) (hRight : verify (first + left.length) right = true) :
    verify first (left ++ right) = true := by
  simpa only [verify, List.zipIdx_append, List.all_append, Bool.and_eq_true] using And.intro hLeft hRight

private theorem verify_sound {first n : ℕ} {values : List ℕ} (h : verify first values = true)
    (lo : first ≤ n) (hi : n < first + values.length) :
    ∃ p q : ℕ, 0 < q ∧ p + q = n ∧ p.Prime ∧ (n * q ^ 2 + 1).Prime := by
  have index : n - first < values.length := by omega
  let q := values[n - first]
  have mem : (q, n) ∈ values.zipIdx first :=
    List.mk_mem_zipIdx_iff_le_and_getElem?_sub.mpr ⟨lo, by simp [q, index]⟩
  have checked := List.all_eq_true.mp h _ mem
  change (decide (0 < q ∧ q ≤ n) && primeCheck (n - q) && primeCheck (n * q ^ 2 + 1)) = true at checked
  simp only [Bool.and_eq_true, decide_eq_true_eq] at checked
  obtain ⟨⟨⟨hpos, hle⟩, hp⟩, hprime⟩ := checked
  exact ⟨n - q, q, hpos, Nat.sub_add_cancel hle, primeCheck_sound hp, primeCheck_sound hprime⟩

