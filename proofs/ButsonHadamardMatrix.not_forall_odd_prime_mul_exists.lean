/-- A primitive cube root of unity. -/
noncomputable def OMA.w : ℂ := ⟨-1 / 2, Real.sqrt 3 / 2⟩

lemma OMA.w_sq : OMA.w ^ 2 = -1 - OMA.w := by
  have h3 : Real.sqrt 3 * Real.sqrt 3 = 3 := Real.mul_self_sqrt (by norm_num)
  apply Complex.ext
  · simp only [OMA.w, pow_two, Complex.mul_re, Complex.sub_re, Complex.neg_re, Complex.one_re]
    linear_combination (-1 / 4 : ℝ) * h3
  · simp only [OMA.w, pow_two, Complex.mul_im, Complex.sub_im, Complex.neg_im, Complex.one_im]
    ring

/-- The norm form of the Eisenstein integers. -/
lemma OMA.normSq_w (a b : ℤ) :
    Complex.normSq ((a : ℂ) + (b : ℂ) * OMA.w) = ((a ^ 2 - a * b + b ^ 2 : ℤ) : ℝ) := by
  have h3 : Real.sqrt 3 * Real.sqrt 3 = 3 := Real.mul_self_sqrt (by norm_num)
  simp only [Complex.normSq_apply, OMA.w, Complex.add_re, Complex.add_im, Complex.mul_re,
    Complex.mul_im, Complex.intCast_re, Complex.intCast_im]
  push_cast
  linear_combination ((b : ℝ) ^ 2 / 4) * h3

/-- Every cube root of unity lies in the ring generated by `w`. -/
lemma OMA.cube_root_mem (z : ℂ) (hz : z ^ 3 = 1) :
    z ∈ Subring.closure ({OMA.w} : Set ℂ) := by
  have hw : OMA.w ∈ Subring.closure ({OMA.w} : Set ℂ) := Subring.subset_closure rfl
  have hfac : (z - 1) * ((z - OMA.w) * (z - (-1 - OMA.w))) = 0 := by
    linear_combination hz - (z - 1) * OMA.w_sq
  rcases mul_eq_zero.1 hfac with h | h
  · rw [sub_eq_zero.1 h]
    exact Subring.one_mem _
  · rcases mul_eq_zero.1 h with h | h
    · rw [sub_eq_zero.1 h]
      exact hw
    · rw [sub_eq_zero.1 h]
      exact Subring.sub_mem _ (Subring.neg_mem _ (Subring.one_mem _)) hw

/-- Every element of the ring generated by `w` has the form `a + b * w` with integers `a, b`. -/
lemma OMA.mem_form (z : ℂ) (hz : z ∈ Subring.closure ({OMA.w} : Set ℂ)) :
    ∃ a b : ℤ, z = (a : ℂ) + (b : ℂ) * OMA.w := by
  induction hz using Subring.closure_induction with
  | mem x hx =>
    rw [Set.mem_singleton_iff] at hx
    exact ⟨0, 1, by simp [hx]⟩
  | zero => exact ⟨0, 0, by simp⟩
  | one => exact ⟨1, 0, by simp⟩
  | add x y _ _ hx hy =>
    obtain ⟨a, b, rfl⟩ := hx
    obtain ⟨c, d, rfl⟩ := hy
    exact ⟨a + c, b + d, by push_cast; ring⟩
  | neg x _ hx =>
    obtain ⟨a, b, rfl⟩ := hx
    exact ⟨-a, -b, by push_cast; ring⟩
  | mul x y _ _ hx hy =>
    obtain ⟨a, b, rfl⟩ := hx
    obtain ⟨c, d, rfl⟩ := hy
    exact ⟨a * c - b * d, a * d + b * c - b * d, by
      push_cast
      linear_combination ((b : ℂ) * (d : ℂ)) * OMA.w_sq⟩

/-- The determinant of a matrix with entries in a subring lies in that subring. -/
lemma OMA.det_mem {n : ℕ} (S : Subring ℂ) (M : Matrix (Fin n) (Fin n) ℂ)
    (h : ∀ i j, M i j ∈ S) : M.det ∈ S := by
  rw [Matrix.det_apply']
  refine Subring.sum_mem _ (fun σ _ => ?_)
  exact Subring.mul_mem _ (intCast_mem _ _) (Subring.prod_mem _ (fun i _ => h _ _))

/-- The form `a ^ 2 - a * b + b ^ 2` is anisotropic modulo `5`. -/
lemma OMA.five_dvd (a b : ℤ) (h : (5 : ℤ) ∣ a ^ 2 - a * b + b ^ 2) :
    (5 : ℤ) ∣ a ∧ (5 : ℤ) ∣ b := by
  have key : ∀ x y : ZMod 5, x ^ 2 - x * y + y ^ 2 = 0 → x = 0 ∧ y = 0 := by decide
  have h1 : ((a ^ 2 - a * b + b ^ 2 : ℤ) : ZMod 5) = 0 :=
    (ZMod.intCast_zmod_eq_zero_iff_dvd _ 5).2 h
  push_cast at h1
  obtain ⟨ha, hb⟩ := key _ _ h1
  exact ⟨(ZMod.intCast_zmod_eq_zero_iff_dvd a 5).1 ha, (ZMod.intCast_zmod_eq_zero_iff_dvd b 5).1 hb⟩

/-- Hence `5` divides every value of the form to an even power. -/
lemma OMA.no_rep (e : ℕ) : ∀ a b c : ℤ, ¬ (5 : ℤ) ∣ c →
    a ^ 2 - a * b + b ^ 2 ≠ 5 ^ (2 * e + 1) * c := by
  induction e with
  | zero =>
    intro a b c hc h
    obtain ⟨⟨a', rfl⟩, ⟨b', rfl⟩⟩ := OMA.five_dvd a b ⟨c, by rw [h]; ring⟩
    apply hc
    have h5 : (5 : ℤ) * c = 5 * (5 * (a' ^ 2 - a' * b' + b' ^ 2)) := by
      linear_combination -h
    exact ⟨a' ^ 2 - a' * b' + b' ^ 2, mul_left_cancel₀ (by norm_num) h5⟩
  | succ e ih =>
    intro a b c hc h
    obtain ⟨⟨a', rfl⟩, ⟨b', rfl⟩⟩ :=
      OMA.five_dvd a b ⟨5 ^ (2 * e + 2) * c, by rw [h]; ring⟩
    refine ih a' b' c hc ?_
    have h25 : (25 : ℤ) * (a' ^ 2 - a' * b' + b' ^ 2) = 25 * (5 ^ (2 * e + 1) * c) := by
      linear_combination h
    exact mul_left_cancel₀ (by norm_num) h25

theorem OMA.solution : type_of% @ButsonHadamardMatrix.not_forall_odd_prime_mul_exists := by
  intro hall
  obtain ⟨M, -, hpow, hMM⟩ := hall 3 5 (by norm_num) (by norm_num) (by norm_num)
  have hdet : M.det * star M.det = (15 : ℂ) ^ 15 := by
    have h := congrArg Matrix.det hMM
    rw [Matrix.det_mul, Matrix.det_conjTranspose, Matrix.det_smul, Matrix.det_one] at h
    rw [h]
    simp
  have hmem : M.det ∈ Subring.closure ({OMA.w} : Set ℂ) :=
    OMA.det_mem _ M (fun i j => OMA.cube_root_mem _ (hpow i j))
  obtain ⟨a, b, hab⟩ := OMA.mem_form _ hmem
  have hns : Complex.normSq M.det = (15 : ℝ) ^ 15 := by
    have h1 : M.det * star M.det = ((Complex.normSq M.det : ℝ) : ℂ) := Complex.mul_conj M.det
    rw [h1] at hdet
    exact_mod_cast hdet
  rw [hab, OMA.normSq_w] at hns
  have hint : a ^ 2 - a * b + b ^ 2 = 5 ^ (2 * 7 + 1) * 3 ^ 15 := by
    have h2 : ((a ^ 2 - a * b + b ^ 2 : ℤ) : ℝ) = ((5 ^ (2 * 7 + 1) * 3 ^ 15 : ℤ) : ℝ) := by
      rw [hns]
      norm_num
    exact_mod_cast h2
  exact OMA.no_rep 7 a b (3 ^ 15) (by norm_num) hint
