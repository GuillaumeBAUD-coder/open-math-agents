import OMAStatements.S_oeis_a253505

/-!
Proof of Barker's two conjectures for OEIS A253505, by an exact transfer-matrix count.

Every condition compares subblock values within at most four consecutive rows, so adding a bottom
row only adds conditions on the last four rows. The last three rows (and how many rows there are,
up to three) form a finite summary updated row by row. The number of ways to complete a summary to
an array with t more rows satisfies a linear recursion over the 641 reachable summaries; the
kernel checks the explicit successor table, the count tables up to t = 11 rows, and the
order-4 recurrence for every summary at t = 7, which then propagates to all t by linearity.
The generating function follows from the recurrence and the initial terms.
-/

namespace OMA.S_oeis_a253505

open PowerSeries Finset

abbrev CC : ℕ := 5

/-! ## Local conditions on windows of consecutive rows -/

abbrev Row := Fin CC → Fin 2

def W2 (f : ℕ → ℕ → ℕ) (i j : ℕ) : ℤ :=
  max (f i j : ℤ) (f (i + 1) (j + 1)) - min (f i (j + 1) : ℤ) (f (i + 1) j)

def W3 (f : ℕ → ℕ → ℕ) (i j : ℕ) : ℤ :=
  max (max (f i j : ℤ) (f (i + 1) (j + 1))) (f (i + 2) (j + 2)) -
    min (min (f i (j + 2) : ℤ) (f (i + 1) (j + 1))) (f (i + 2) j)

def P1 (f : ℕ → ℕ → ℕ) (i j : ℕ) : Prop := W2 f i j ≤ W2 f i (j + 1)
def P2 (f : ℕ → ℕ → ℕ) (i j : ℕ) : Prop := W2 f i j ≤ W2 f (i + 1) j
def P3 (f : ℕ → ℕ → ℕ) (i j : ℕ) : Prop := W3 f i j ≤ W3 f i (j + 1)
def P4 (f : ℕ → ℕ → ℕ) (i j : ℕ) : Prop := W3 f i j ≤ W3 f (i + 1) j

theorem loc1 (f g : ℕ → ℕ → ℕ) (i i' j : ℕ) (h : ∀ a ≤ 1, ∀ b, f (i + a) b = g (i' + a) b) :
    P1 f i j ↔ P1 g i' j := by
  have h0 : ∀ b, f i b = g i' b := fun b => by simpa using h 0 (by omega) b
  have h1 : ∀ b, f (i + 1) b = g (i' + 1) b := fun b => h 1 (by omega) b
  simp only [P1, W2, h0, h1]

theorem loc2 (f g : ℕ → ℕ → ℕ) (i i' j : ℕ) (h : ∀ a ≤ 2, ∀ b, f (i + a) b = g (i' + a) b) :
    P2 f i j ↔ P2 g i' j := by
  have h0 : ∀ b, f i b = g i' b := fun b => by simpa using h 0 (by omega) b
  have h1 : ∀ b, f (i + 1) b = g (i' + 1) b := fun b => h 1 (by omega) b
  have h2 : ∀ b, f (i + 1 + 1) b = g (i' + 1 + 1) b := fun b => h 2 (by omega) b
  simp only [P2, W2, h0, h1, h2]

theorem loc3 (f g : ℕ → ℕ → ℕ) (i i' j : ℕ) (h : ∀ a ≤ 2, ∀ b, f (i + a) b = g (i' + a) b) :
    P3 f i j ↔ P3 g i' j := by
  have h0 : ∀ b, f i b = g i' b := fun b => by simpa using h 0 (by omega) b
  have h1 : ∀ b, f (i + 1) b = g (i' + 1) b := fun b => h 1 (by omega) b
  have h2 : ∀ b, f (i + 2) b = g (i' + 2) b := fun b => h 2 (by omega) b
  simp only [P3, W3, h0, h1, h2]

theorem loc4 (f g : ℕ → ℕ → ℕ) (i i' j : ℕ) (h : ∀ a ≤ 3, ∀ b, f (i + a) b = g (i' + a) b) :
    P4 f i j ↔ P4 g i' j := by
  have h0 : ∀ b, f i b = g i' b := fun b => by simpa using h 0 (by omega) b
  have h1 : ∀ b, f (i + 1) b = g (i' + 1) b := fun b => h 1 (by omega) b
  have h2 : ∀ b, f (i + 2) b = g (i' + 2) b := fun b => h 2 (by omega) b
  have h3 : ∀ b, f (i + 1 + 2) b = g (i' + 1 + 2) b := fun b => h 3 (by omega) b
  have h4 : ∀ b, f (i + 1 + 1) b = g (i' + 1 + 1) b := fun b => h 2 (by omega) b
  simp only [P4, W3, h0, h1, h2, h3, h4]

/-- Entries of a t-row array as natural numbers, 0 outside the array. -/
def Ey {t : ℕ} (y : Fin t → Row) (i j : ℕ) : ℕ := if h : i < t ∧ j < CC then (y ⟨i, h.1⟩ ⟨j, h.2⟩ : ℕ) else 0

def Gt (f : ℕ → ℕ → ℕ) (t : ℕ) : Prop :=
  (∀ i < t, ∀ j < CC, i + 1 < t → j + 2 < CC → P1 f i j) ∧
  (∀ i < t, ∀ j < CC, i + 2 < t → j + 1 < CC → P2 f i j) ∧
  (∀ i < t, ∀ j < CC, i + 2 < t → j + 3 < CC → P3 f i j) ∧
  (∀ i < t, ∀ j < CC, i + 3 < t → j + 2 < CC → P4 f i j)

def G {t : ℕ} (y : Fin t → Row) : Prop := Gt (Ey y) t

noncomputable instance {t : ℕ} : DecidablePred (@G t) := fun _ => Classical.dec _

theorem split_cond (P : (ℕ → ℕ → ℕ) → ℕ → ℕ → Prop) (h w : ℕ)
    (hloc : ∀ f g i i' j, (∀ a ≤ h, ∀ b, f (i + a) b = g (i' + a) b) → (P f i j ↔ P g i' j))
    (F G : ℕ → ℕ → ℕ) (t : ℕ) (hFG : ∀ i < t, ∀ b, F i b = G i b) :
    (∀ i < t + 1, ∀ j < CC, i + h < t + 1 → j + w < CC → P F i j) ↔
      (∀ i < t, ∀ j < CC, i + h < t → j + w < CC → P G i j) ∧ (h ≤ t → ∀ j < CC, j + w < CC → P F (t - h) j) := by
  constructor
  · intro H
    refine ⟨fun i hi j hj hh hw => ?_, fun ht j hj hw => H (t - h) (by omega) j hj (by omega) hw⟩
    exact (hloc F G i i j (fun a ha b => hFG _ (by omega) b)).1 (H i (by omega) j hj (by omega) hw)
  · rintro ⟨H1, H2⟩ i hi j hj hh hw
    rcases Nat.lt_or_ge (i + h) t with hlt | hge
    · exact (hloc F G i i j (fun a ha b => hFG _ (by omega) b)).2 (H1 i (by omega) j hj hlt hw)
    · have : i = t - h := by omega
      subst this
      exact H2 (by omega) j hj hw

theorem Ey_snoc_lt {t : ℕ} (y : Fin t → Row) (r : Row) (i b : ℕ) (hi : i < t) :
    Ey (Fin.snoc y r : Fin (t + 1) → Row) i b = Ey y i b := by
  unfold Ey
  by_cases hb : b < CC
  · rw [dif_pos ⟨by omega, hb⟩, dif_pos ⟨hi, hb⟩]
    have : (⟨i, by omega⟩ : Fin (t + 1)) = (⟨i, hi⟩ : Fin t).castSucc := rfl
    rw [this, Fin.snoc_castSucc]
  · rw [dif_neg (fun h => hb h.2), dif_neg (fun h => hb h.2)]

/-- State: the number of rows (capped at 3) and the codes of the last three rows (0 when missing). -/
abbrev St := ℕ × ℕ × ℕ × ℕ

def rc (r : Row) : ℕ := (finFunctionFinEquiv r : ℕ)

def bitOf (c b : ℕ) : ℕ := c / 2 ^ b % 2

theorem rc_bit (r : Row) (b : ℕ) (hb : b < CC) : bitOf (rc r) b = (r ⟨b, hb⟩ : ℕ) := by
  have := finFunctionFinEquiv_symm_apply_val (finFunctionFinEquiv r) ⟨b, hb⟩
  rw [Equiv.symm_apply_apply] at this
  rw [this]
  rfl

def F4 (s : St) (r : Row) (a b : ℕ) : ℕ :=
  if hb : b < CC then
    (if a = 0 then bitOf s.2.1 b else if a = 1 then bitOf s.2.2.1 b else if a = 2 then bitOf s.2.2.2 b
      else if a = 3 then (r ⟨b, hb⟩ : ℕ) else 0)
  else 0

def NEWs (s : St) (r : Row) : Prop :=
  ∀ j < CC, (1 ≤ s.1 → j + 2 < CC → P1 (F4 s r) 2 j) ∧ (2 ≤ s.1 → j + 1 < CC → P2 (F4 s r) 1 j) ∧
    (2 ≤ s.1 → j + 3 < CC → P3 (F4 s r) 1 j) ∧ (3 ≤ s.1 → j + 2 < CC → P4 (F4 s r) 0 j)

instance (s : St) (r : Row) : Decidable (NEWs s r) := by unfold NEWs P1 P2 P3 P4; infer_instance

def step (s : St) (r : Row) : Option St :=
  if NEWs s r then some (min (s.1 + 1) 3, s.2.2.1, s.2.2.2, rc r) else none

def init : St := (0, 0, 0, 0)

def slot {t : ℕ} (y : Fin t → Row) (k : ℕ) : ℕ := if h : 3 ≤ t + k ∧ k < 3 then rc (y ⟨t + k - 3, by omega⟩) else 0

def Sm {t : ℕ} (y : Fin t → Row) : St := (min t 3, slot y 0, slot y 1, slot y 2)

theorem rows_match {t : ℕ} (y : Fin t → Row) (r : Row) (a b : ℕ) (ha : a ≤ 3) (hta : 3 ≤ t + a) :
    Ey (Fin.snoc y r : Fin (t + 1) → Row) (t + a - 3) b = F4 (Sm y) r a b := by
  unfold F4 Ey Sm
  by_cases hb : b < CC
  · rw [dif_pos ⟨by omega, hb⟩, dif_pos hb]
    have key : ∀ k, k < 3 → a = k → ((Fin.snoc y r : Fin (t + 1) → Row) ⟨t + a - 3, by omega⟩ ⟨b, hb⟩ : ℕ) = bitOf (slot y k) b := by
      intro k hk hak
      subst hak
      unfold slot
      rw [dif_pos ⟨hta, hk⟩, rc_bit _ b hb]
      have : (⟨t + a - 3, by omega⟩ : Fin (t + 1)) = (⟨t + a - 3, by omega⟩ : Fin t).castSucc := rfl
      rw [this, Fin.snoc_castSucc]
    rcases (show a = 0 ∨ a = 1 ∨ a = 2 ∨ a = 3 by omega) with h | h | h | h
    · rw [if_pos h]; exact key 0 (by omega) h
    · rw [if_neg (by omega), if_pos h]; exact key 1 (by omega) h
    · rw [if_neg (by omega), if_neg (by omega), if_pos h]; exact key 2 (by omega) h
    · rw [if_neg (by omega), if_neg (by omega), if_neg (by omega), if_pos h]
      have : (⟨t + a - 3, by omega⟩ : Fin (t + 1)) = Fin.last t := Fin.ext (by simp; omega)
      rw [this, Fin.snoc_last]
  · rw [dif_neg (fun h => hb h.2), dif_neg hb]

theorem G_snoc_iff {t : ℕ} (y : Fin t → Row) (r : Row) :
    G (Fin.snoc y r : Fin (t + 1) → Row) ↔ G y ∧ NEWs (Sm y) r := by
  have hFG := fun i hi b => Ey_snoc_lt y r i b hi
  unfold G Gt
  rw [split_cond P1 1 2 loc1 _ _ t hFG, split_cond P2 2 1 loc2 _ _ t hFG, split_cond P3 2 3 loc3 _ _ t hFG,
    split_cond P4 3 2 loc4 _ _ t hFG]
  have m1 : ∀ j, 1 ≤ t → (P1 (Ey (Fin.snoc y r : Fin (t + 1) → Row)) (t - 1) j ↔ P1 (F4 (Sm y) r) 2 j) := fun j ht =>
    loc1 _ _ _ _ j (fun a ha b => by rw [show t - 1 + a = t + (2 + a) - 3 by omega]; exact rows_match y r _ b (by omega) (by omega))
  have m2 : ∀ j, 2 ≤ t → (P2 (Ey (Fin.snoc y r : Fin (t + 1) → Row)) (t - 2) j ↔ P2 (F4 (Sm y) r) 1 j) := fun j ht =>
    loc2 _ _ _ _ j (fun a ha b => by rw [show t - 2 + a = t + (1 + a) - 3 by omega]; exact rows_match y r _ b (by omega) (by omega))
  have m3 : ∀ j, 2 ≤ t → (P3 (Ey (Fin.snoc y r : Fin (t + 1) → Row)) (t - 2) j ↔ P3 (F4 (Sm y) r) 1 j) := fun j ht =>
    loc3 _ _ _ _ j (fun a ha b => by rw [show t - 2 + a = t + (1 + a) - 3 by omega]; exact rows_match y r _ b (by omega) (by omega))
  have m4 : ∀ j, 3 ≤ t → (P4 (Ey (Fin.snoc y r : Fin (t + 1) → Row)) (t - 3) j ↔ P4 (F4 (Sm y) r) 0 j) := fun j ht =>
    loc4 _ _ _ _ j (fun a ha b => by rw [show t - 3 + a = t + (0 + a) - 3 by omega]; exact rows_match y r _ b (by omega) (by omega))
  have hs : (Sm y).1 = min t 3 := rfl
  unfold NEWs
  rw [hs]
  constructor
  · rintro ⟨⟨a1, b1⟩, ⟨a2, b2⟩, ⟨a3, b3⟩, ⟨a4, b4⟩⟩
    refine ⟨⟨a1, a2, a3, a4⟩, fun j hj => ⟨fun ht hw => ?_, fun ht hw => ?_, fun ht hw => ?_, fun ht hw => ?_⟩⟩
    · exact (m1 j (by omega)).1 (b1 (by omega) j hj hw)
    · exact (m2 j (by omega)).1 (b2 (by omega) j hj hw)
    · exact (m3 j (by omega)).1 (b3 (by omega) j hj hw)
    · exact (m4 j (by omega)).1 (b4 (by omega) j hj hw)
  · rintro ⟨⟨a1, a2, a3, a4⟩, H⟩
    refine ⟨⟨a1, fun ht j hj hw => ?_⟩, ⟨a2, fun ht j hj hw => ?_⟩, ⟨a3, fun ht j hj hw => ?_⟩, ⟨a4, fun ht j hj hw => ?_⟩⟩
    · exact (m1 j ht).2 ((H j hj).1 (by omega) hw)
    · exact (m2 j ht).2 ((H j hj).2.1 (by omega) hw)
    · exact (m3 j ht).2 ((H j hj).2.2.1 (by omega) hw)
    · exact (m4 j ht).2 ((H j hj).2.2.2 (by omega) hw)

theorem slot_snoc {t : ℕ} (y : Fin t → Row) (r : Row) (k : ℕ) (hk : k < 2) :
    slot (Fin.snoc y r : Fin (t + 1) → Row) k = slot y (k + 1) := by
  unfold slot
  by_cases h3 : 3 ≤ t + (k + 1)
  · rw [dif_pos ⟨by omega, by omega⟩, dif_pos ⟨h3, by omega⟩]
    have : (⟨t + 1 + k - 3, by omega⟩ : Fin (t + 1)) = (⟨t + (k + 1) - 3, by omega⟩ : Fin t).castSucc :=
      Fin.ext (by simp; omega)
    rw [this, Fin.snoc_castSucc]
  · rw [dif_neg (by omega), dif_neg (by omega)]

theorem slot_snoc2 {t : ℕ} (y : Fin t → Row) (r : Row) :
    slot (Fin.snoc y r : Fin (t + 1) → Row) 2 = rc r := by
  unfold slot
  rw [dif_pos ⟨by omega, by omega⟩]
  have : (⟨t + 1 + 2 - 3, by omega⟩ : Fin (t + 1)) = Fin.last t := Fin.ext (by simp)
  rw [this, Fin.snoc_last]

theorem Sm_snoc {t : ℕ} (y : Fin t → Row) (r : Row) :
    Sm (Fin.snoc y r : Fin (t + 1) → Row) = (min ((Sm y).1 + 1) 3, (Sm y).2.2.1, (Sm y).2.2.2, rc r) := by
  unfold Sm
  simp only [slot_snoc y r 0 (by omega), slot_snoc y r 1 (by omega), slot_snoc2]
  congr 1
  omega

theorem step_spec {t : ℕ} (y : Fin t → Row) (r : Row) :
    step (Sm y) r = if NEWs (Sm y) r then some (Sm (Fin.snoc y r : Fin (t + 1) → Row)) else none := by
  rw [Sm_snoc]; rfl

def RunO (o : Option St) (l : List Row) : Option St := l.foldl (fun o r => o.bind fun s => step s r) o

theorem RunO_none (l : List Row) : RunO none l = none := by
  induction l with
  | nil => rfl
  | cons r l ih => exact ih

theorem ofFn_snoc {t : ℕ} (y : Fin t → Row) (r : Row) :
    List.ofFn (Fin.snoc y r : Fin (t + 1) → Row) = List.ofFn y ++ [r] := by
  rw [List.ofFn_succ_last]
  simp only [Fin.snoc_castSucc, Fin.snoc_last]

theorem INV : ∀ (t : ℕ) (y : Fin t → Row), RunO (some init) (List.ofFn y) = if G y then some (Sm y) else none := by
  intro t
  induction t with
  | zero =>
    intro y
    have hg : G y := ⟨fun i hi => absurd hi (by omega), fun i hi => absurd hi (by omega),
      fun i hi => absurd hi (by omega), fun i hi => absurd hi (by omega)⟩
    rw [if_pos hg]
    have : Sm y = init := by
      unfold Sm init slot
      simp
    rw [this]
    rfl
  | succ t ih =>
    intro y
    obtain ⟨y', r, rfl⟩ : ∃ (y' : Fin t → Row) (r : Row), y = (Fin.snoc y' r : Fin (t + 1) → Row) :=
      ⟨Fin.init y, y (Fin.last t), (Fin.snoc_init_self y).symm⟩
    rw [ofFn_snoc]
    unfold RunO
    rw [List.foldl_append]
    change ((RunO (some init) (List.ofFn y')).bind fun s => step s r) = _
    rw [ih y']
    by_cases hy : G y'
    · rw [if_pos hy, Option.bind_some, step_spec y' r]
      by_cases hr : NEWs (Sm y') r
      · rw [if_pos hr, if_pos ((G_snoc_iff y' r).2 ⟨hy, hr⟩)]
      · rw [if_neg hr, if_neg (fun h => hr ((G_snoc_iff y' r).1 h).2)]
    · rw [if_neg hy, if_neg (fun h => hy ((G_snoc_iff y' r).1 h).1)]
      rfl

/-! ## Counting continuations -/

def E (t : ℕ) (s : St) : ℕ := (univ.filter fun z : Fin t → Row => (RunO (some s) (List.ofFn z)).isSome = true).card

theorem E_zero (s : St) : E 0 s = 1 := by
  unfold E
  rw [Finset.filter_true_of_mem (fun z _ => by simp [RunO])]
  simp

theorem E_succ (t : ℕ) (s : St) :
    E (t + 1) s = ∑ r : Row, (match step s r with | none => 0 | some s' => E t s') := by
  unfold E
  rw [Finset.card_filter]
  rw [← (Fin.consEquiv fun _ => Row).sum_comp, Fintype.sum_prod_type]
  refine Finset.sum_congr rfl (fun r _ => ?_)
  simp only [show ∀ y : Fin t → Row, (Fin.consEquiv (fun _ => Row)) (r, y) = Fin.cons r y from fun _ => rfl,
    List.ofFn_cons]
  have hR : ∀ l : List Row, RunO (some s) (r :: l) = RunO (step s r) l := fun l => by
    simp [RunO, List.foldl_cons]
  simp only [hR]
  cases step s r with
  | none => simp [RunO_none]
  | some s' => exact (Finset.card_filter _ _).symm

theorem a_eq_E (n : ℕ) : (univ.filter fun y : Fin n → Row => G y).card = E n init := by
  unfold E
  refine congrArg Finset.card (Finset.filter_congr (fun y _ => ?_))
  rw [INV]
  split_ifs with h <;> simp [h]

def decS (code : ℕ) : St :=
  (code % 4, code / 4 % 2 ^ CC, code / 4 / 2 ^ CC % 2 ^ CC, code / 4 / 2 ^ (2 * CC) % 2 ^ CC)

instance dec3 : DecidableEq (ℕ × ℕ × ℕ) := instDecidableEqProd
instance decSt : DecidableEq St := instDecidableEqProd

abbrev Q : ℕ := 2
abbrev K : ℕ := CC


theorem good_iff {n : ℕ} (x : Fin (n + 2) → Row) : good x ↔ G x := Iff.rfl

theorem card_bridge (n : ℕ) : a n = (univ.filter fun y : Fin (n + 2) → Row => G y).card := by
  unfold a
  exact congrArg Finset.card (Finset.filter_congr (fun x _ => good_iff x))

/-! ## The explicit automaton, checked by the kernel -/

abbrev M : ℕ := 641

abbrev NR : ℕ := Q ^ K

def rowOf (c : ℕ) : Row := fun j => ⟨c / Q ^ (j : ℕ) % Q, Nat.mod_lt _ (by decide)⟩

def rowAt (c : ℕ) : Row := rowOf c

theorem sum_row (g : Row → ℕ) : ∑ r : Row, g r = ∑ c ∈ Finset.range NR, g (rowOf c) := by
  rw [← Fin.sum_univ_eq_sum_range (fun c => g (rowOf c)) NR]
  rw [← (finFunctionFinEquiv (m := Q) (n := K)).symm.sum_comp g]
  refine Finset.sum_congr rfl (fun c _ => ?_)
  congr 1
  all_goals funext j
  all_goals ext
  all_goals simp [rowOf, finFunctionFinEquiv_symm_apply_val]

theorem sum_row_step (s : St) (F : St → ℕ) :
    ∑ r : Row, (match step s r with | none => 0 | some s' => F s') =
      ∑ c ∈ Finset.range NR, (match step s (rowAt c) with | none => 0 | some s' => F s') := sum_row _



/-- Codes of the reachable states, 17 bits each. -/

def RS : ℕ := 

/-- Successor table: entry i * NR + c is 0 (dead) or 1 + the index of the successor, 10 bits each. -/
def TRT : ℕ := 

def dec (i : ℕ) : St := decS (RS / 2 ^ (17 * i) % 2 ^ 17)
def tr (i c : ℕ) : ℕ := TRT / 2 ^ (10 * (i * NR + c)) % 2 ^ 10

theorem chk0 : ∀ i < 200, ∀ c < NR, step (dec (0 + i)) (rowAt c) = (if tr (0 + i) c = 0 then none else some (dec (tr (0 + i) c - 1))) ∧
    tr (0 + i) c ≤ M := by
  decide +kernel

theorem chk1 : ∀ i < 200, ∀ c < NR, step (dec (200 + i)) (rowAt c) = (if tr (200 + i) c = 0 then none else some (dec (tr (200 + i) c - 1))) ∧
    tr (200 + i) c ≤ M := by
  decide +kernel

theorem chk2 : ∀ i < 200, ∀ c < NR, step (dec (400 + i)) (rowAt c) = (if tr (400 + i) c = 0 then none else some (dec (tr (400 + i) c - 1))) ∧
    tr (400 + i) c ≤ M := by
  decide +kernel

theorem chk3 : ∀ i < 41, ∀ c < NR, step (dec (600 + i)) (rowAt c) = (if tr (600 + i) c = 0 then none else some (dec (tr (600 + i) c - 1))) ∧
    tr (600 + i) c ≤ M := by
  decide +kernel

theorem chk : ∀ i < M, ∀ c < NR, step (dec i) (rowAt c) = (if tr i c = 0 then none else some (dec (tr i c - 1))) ∧
    tr i c ≤ M := by
  intro i hi
  have hi' : i < 641 := hi
  by_cases h0 : i < 200
  · have := chk0 (i - 0) (by omega); rwa [show 0 + (i - 0) = i by omega] at this
  by_cases h1 : i < 400
  · have := chk1 (i - 200) (by omega); rwa [show 200 + (i - 200) = i by omega] at this
  by_cases h2 : i < 600
  · have := chk2 (i - 400) (by omega); rwa [show 400 + (i - 400) = i by omega] at this
  have := chk3 (i - 600) (by omega); rwa [show 600 + (i - 600) = i by omega] at this

theorem dec0 : dec 0 = init := by decide +kernel

def sumN : ℕ → (ℕ → ℕ) → ℕ
  | 0, _ => 0
  | n + 1, g => sumN n g + g n

theorem sumN_eq (n : ℕ) (g : ℕ → ℕ) : sumN n g = ∑ c ∈ Finset.range n, g c := by
  induction n with
  | zero => rfl
  | succ n ih => rw [sumN, ih, Finset.sum_range_succ]

def nxt (f : ℕ → ℕ) (i : ℕ) : ℕ := sumN NR fun c => if tr i c = 0 then 0 else f (tr i c - 1)

def E' : ℕ → ℕ → ℕ
  | 0, _ => 1
  | t + 1, i => nxt (E' t) i

theorem E_E' : ∀ t, ∀ i < M, E t (dec i) = E' t i := by
  intro t
  induction t with
  | zero => intro i _; rw [E_zero]; rfl
  | succ t ih =>
    intro i hi
    rw [E_succ, sum_row_step]
    show _ = sumN NR _
    rw [sumN_eq]
    refine Finset.sum_congr rfl (fun c hc => ?_)
    obtain ⟨h1, h2⟩ := chk i hi c (Finset.mem_range.1 hc)
    rw [h1]
    split_ifs with h0
    · rfl
    · exact ih _ (by omega)

theorem nxt_congr (f g : ℕ → ℕ) (h : ∀ j < M, f j = g j) : ∀ i < M, nxt f i = nxt g i := by
  intro i hi
  unfold nxt
  rw [sumN_eq, sumN_eq]
  refine Finset.sum_congr rfl (fun c hc => ?_)
  have := (chk i hi c (Finset.mem_range.1 hc)).2
  split_ifs with h0
  · rfl
  · exact h _ (by omega)

/-! ## Count tables -/


def TT : List ℕ := [, , , , , , , , , , , ]

def tb (t i : ℕ) : ℕ := TT.getD t 0 / 2 ^ (14 * i) % 2 ^ 14

theorem tb0 : ∀ i < M, tb 0 i = 1 := by decide +kernel

theorem tbs0 : ∀ i < M, nxt (tb 0) i = tb 1 i := by decide +kernel
theorem tbs1 : ∀ i < M, nxt (tb 1) i = tb 2 i := by decide +kernel
theorem tbs2 : ∀ i < M, nxt (tb 2) i = tb 3 i := by decide +kernel
theorem tbs3 : ∀ i < M, nxt (tb 3) i = tb 4 i := by decide +kernel
theorem tbs4 : ∀ i < M, nxt (tb 4) i = tb 5 i := by decide +kernel
theorem tbs5 : ∀ i < M, nxt (tb 5) i = tb 6 i := by decide +kernel
theorem tbs6 : ∀ i < M, nxt (tb 6) i = tb 7 i := by decide +kernel
theorem tbs7 : ∀ i < M, nxt (tb 7) i = tb 8 i := by decide +kernel
theorem tbs8 : ∀ i < M, nxt (tb 8) i = tb 9 i := by decide +kernel
theorem tbs9 : ∀ i < M, nxt (tb 9) i = tb 10 i := by decide +kernel
theorem tbs10 : ∀ i < M, nxt (tb 10) i = tb 11 i := by decide +kernel
theorem tbs : ∀ t < 11, ∀ i < M, nxt (tb t) i = tb (t + 1) i := by
  intro t ht
  interval_cases t
  · exact tbs0
  · exact tbs1
  · exact tbs2
  · exact tbs3
  · exact tbs4
  · exact tbs5
  · exact tbs6
  · exact tbs7
  · exact tbs8
  · exact tbs9
  · exact tbs10

theorem E'_tb : ∀ t ≤ 11, ∀ i < M, E' t i = tb t i := by
  intro t
  induction t with
  | zero => intro _ i hi; rw [tb0 i hi]; rfl
  | succ t ih =>
    intro ht i hi
    show nxt (E' t) i = _
    rw [nxt_congr _ _ (ih (by omega)) i hi, tbs t (by omega) i hi]

/-! ## The linear recurrence, state by state -/


def cf (l : ℕ) : ℤ := match l with | 0 => 1 | 1 => -4 | 2 => 6 | 3 => -4 | 4 => 1 | _ => 0

def V (t i : ℕ) : ℤ := ∑ l ∈ Finset.range (4 + 1), cf l * (E' (t + l) i : ℤ)

def Vtb (t i : ℕ) : ℤ := ∑ l ∈ Finset.range (4 + 1), cf l * (tb (t + l) i : ℤ)

theorem Vbase : ∀ i < M, Vtb 7 i = 0 := by decide +kernel

theorem V_succ (t i : ℕ) :
    V (t + 1) i = ∑ c ∈ Finset.range NR, if tr i c = 0 then 0 else V t (tr i c - 1) := by
  unfold V
  have e : ∀ l, E' (t + 1 + l) i = nxt (E' (t + l)) i := fun l => by
    rw [show t + 1 + l = (t + l) + 1 by omega]; rfl
  simp only [e, nxt, sumN_eq, Nat.cast_sum, Finset.mul_sum]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl (fun c _ => ?_)
  by_cases h0 : tr i c = 0 <;> simp [h0]

theorem V_zero : ∀ t, 7 ≤ t → ∀ i < M, V t i = 0 := by
  intro t ht
  induction t, ht using Nat.le_induction with
  | base =>
    intro i hi
    rw [← Vbase i hi]
    unfold V Vtb
    refine Finset.sum_congr rfl (fun l hl => ?_)
    rw [E'_tb _ (by have := Finset.mem_range.1 hl; omega) i hi]
  | succ t _ ih =>
    intro i hi
    rw [V_succ]
    refine Finset.sum_eq_zero (fun c hc => ?_)
    have := (chk i hi c (Finset.mem_range.1 hc)).2
    split_ifs with h0
    · rfl
    · exact ih _ (by omega)

theorem a_E' (n : ℕ) : a n = E' (n + 2) 0 := by
  rw [← E_E' (n + 2) 0 (by decide), dec0, ← a_eq_E]
  exact card_bridge n

theorem a_rec (n : ℕ) (hn : 5 + 4 ≤ n) : ∑ l ∈ Finset.range (4 + 1), cf l * (a (n - 4 + l) : ℤ) = 0 := by
  have := V_zero (n - 4 + 2) (by omega) 0 (by decide)
  unfold V at this
  have e : ∀ l, n - 4 + 2 + l = n - 4 + l + 2 := fun l => by omega
  simp only [e] at this
  simpa only [a_E'] using this

theorem a_tb (n : ℕ) (hn : n + 2 ≤ 11) : a n = tb (n + 2) 0 := by
  rw [a_E', E'_tb (n + 2) hn 0 (by decide)]


theorem rec_small : ∀ n < 9, 8 < n → (tb (n + 2) 0 : ℤ) = 4 * (tb (n - 1 + 2) 0 : ℤ) - 6 * (tb (n - 2 + 2) 0 : ℤ) + 4 * (tb (n - 3 + 2) 0 : ℤ) - (tb (n - 4 + 2) 0 : ℤ) := by
  decide +kernel

theorem recurrence (n : ℕ) (hn : 8 < n) : (a n : ℤ) = 4 * a (n - 1) - 6 * a (n - 2) + 4 * a (n - 3) - a (n - 4) := by
  rcases Nat.lt_or_ge n 9 with h | h
  · have := rec_small n (by omega) hn
    rw [a_tb n (by omega), a_tb (n - 1) (by omega), a_tb (n - 2) (by omega), a_tb (n - 3) (by omega), a_tb (n - 4) (by omega)]
    exact this
  · obtain ⟨m, rfl⟩ : ∃ m, n = m + 4 := ⟨n - 4, by omega⟩
    have hr := a_rec (m + 4) (by omega)
    simp only [Finset.sum_range_succ, Finset.sum_range_zero, zero_add, cf, Nat.add_sub_cancel, add_zero] at hr
    simp only [show m + 4 - 1 = m + 3 by omega, show m + 4 - 2 = m + 2 by omega, show m + 4 - 3 = m + 1 by omega, show m + 4 - 4 = m by omega]
    linarith

theorem gf_of (f : ℕ → ℕ) (hr : ∀ n, 9 ≤ n → (f n : ℤ) = 4 * f (n - 1) - 6 * f (n - 2) + 4 * f (n - 3) - f (n - 4))
    (hv : ∀ n < 9, f n = tb (n + 2) 0) :
    PowerSeries.mk (fun n => if n = 0 then (0 : ℚ) else (f n : ℚ)) * (1 - X) ^ 4 =
      4 * X * (107 - 232 * X + 191 * X ^ 2 - 62 * X ^ 3 - 4 * X ^ 4 + 6 * X ^ 5 - 2 * X ^ 6 + X ^ 7) := by
  have v1 : (f 1 : ℚ) = 428 := by exact_mod_cast (hv 1 (by norm_num)).trans (by decide +kernel : tb 3 0 = 428)
  have v2 : (f 2 : ℚ) = 784 := by exact_mod_cast (hv 2 (by norm_num)).trans (by decide +kernel : tb 4 0 = 784)
  have v3 : (f 3 : ℚ) = 1332 := by exact_mod_cast (hv 3 (by norm_num)).trans (by decide +kernel : tb 5 0 = 1332)
  have v4 : (f 4 : ℚ) = 2088 := by exact_mod_cast (hv 4 (by norm_num)).trans (by decide +kernel : tb 6 0 = 2088)
  have v5 : (f 5 : ℚ) = 3052 := by exact_mod_cast (hv 5 (by norm_num)).trans (by decide +kernel : tb 7 0 = 3052)
  have v6 : (f 6 : ℚ) = 4248 := by exact_mod_cast (hv 6 (by norm_num)).trans (by decide +kernel : tb 8 0 = 4248)
  have v7 : (f 7 : ℚ) = 5692 := by exact_mod_cast (hv 7 (by norm_num)).trans (by decide +kernel : tb 9 0 = 5692)
  have v8 : (f 8 : ℚ) = 7404 := by exact_mod_cast (hv 8 (by norm_num)).trans (by decide +kernel : tb 10 0 = 7404)
  set A : ℚ⟦X⟧ := PowerSeries.mk (fun n => if n = 0 then (0 : ℚ) else (f n : ℚ)) with hA
  have e1 : A * (1 - X) ^ 4 = A - C 4 * (A * X ^ 1) + C 6 * (A * X ^ 2) - C 4 * (A * X ^ 3) + (A * X ^ 4) := by
    simp only [map_ofNat]; ring
  have e2 : (4 * X * (107 - 232 * X + 191 * X ^ 2 - 62 * X ^ 3 - 4 * X ^ 4 + 6 * X ^ 5 - 2 * X ^ 6 + X ^ 7) : ℚ⟦X⟧) = X ^ 1 * C 428 - X ^ 2 * C 928 + X ^ 3 * C 764 - X ^ 4 * C 248 - X ^ 5 * C 16 + X ^ 6 * C 24 - X ^ 7 * C 8 + X ^ 8 * C 4 := by
    simp only [map_ofNat]; ring
  rw [e1, e2]
  ext n
  have hc : ∀ k, coeff k A = if k = 0 then (0 : ℚ) else (f k : ℚ) := fun k => by rw [hA, coeff_mk]
  simp only [map_add, map_sub, coeff_C_mul, coeff_mul_C, coeff_X_pow, coeff_mul_X_pow', hc]
  rcases Nat.lt_or_ge n 9 with hn | hn
  · interval_cases n <;> norm_num [v1, v2, v3, v4, v5, v6, v7, v8]
  · obtain ⟨m, rfl⟩ : ∃ m, n = m + 9 := ⟨n - 9, by omega⟩
    have h := hr (m + 9) (by omega)
    simp only [show m + 9 - 1 = m + 8 by omega, show m + 9 - 2 = m + 7 by omega, show m + 9 - 3 = m + 6 by omega, show m + 9 - 4 = m + 5 by omega] at h ⊢
    simp only [show ¬ (m + 9 = 0) by omega, show 1 ≤ m + 9 by omega, show ¬ (m + 8 = 0) by omega, show 2 ≤ m + 9 by omega, show ¬ (m + 7 = 0) by omega, show 3 ≤ m + 9 by omega, show ¬ (m + 6 = 0) by omega, show 4 ≤ m + 9 by omega, show ¬ (m + 5 = 0) by omega, show ¬ (m + 9 = 1) by omega, show ¬ (m + 9 = 2) by omega, show ¬ (m + 9 = 3) by omega, show ¬ (m + 9 = 4) by omega, show ¬ (m + 9 = 5) by omega, show ¬ (m + 9 = 6) by omega, show ¬ (m + 9 = 7) by omega, show ¬ (m + 9 = 8) by omega, ↓reduceIte, zero_mul, mul_zero, add_zero, sub_zero]
    have h' : ((f (m + 9) : ℤ) : ℚ) = (((4 * (f (m + 8) : ℤ) - 6 * (f (m + 7) : ℤ) + 4 * (f (m + 6) : ℤ) - (f (m + 5) : ℤ) : ℤ)) : ℚ) := congrArg _ h
    push_cast at h'
    linarith

theorem solution_main :
    PowerSeries.mk (fun n => if n = 0 then (0 : ℚ) else (a n : ℚ)) * (1 - X) ^ 4 =
      4 * X * (107 - 232 * X + 191 * X ^ 2 - 62 * X ^ 3 - 4 * X ^ 4 + 6 * X ^ 5 - 2 * X ^ 6 + X ^ 7) ∧
    ∀ n : ℕ, 8 < n → (a n : ℤ) = 4 * a (n - 1) - 6 * a (n - 2) + 4 * a (n - 3) - a (n - 4) :=
  ⟨gf_of a (fun n hn => recurrence n (by omega)) (fun n hn => a_tb n (by omega)), recurrence⟩

end OMA.S_oeis_a253505

theorem OMA.solution : type_of% @OMA.S_oeis_a253505.main :=
  OMA.S_oeis_a253505.solution_main
