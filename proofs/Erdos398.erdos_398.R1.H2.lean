/-- `s` is the integer square root and `n! + 1` is not a perfect square. -/
def chk (n : ℕ) : Bool :=
  decide (tbl.getD n 0 * tbl.getD n 0 < n.factorial + 1) &&
    decide (n.factorial + 1 < (tbl.getD n 0 + 1) * (tbl.getD n 0 + 1))

lemma not_sq {N s : ℕ} (h1 : s * s < N) (h2 : N < (s + 1) * (s + 1)) : ¬ ∃ m : ℕ, N = m ^ 2 := by
  rintro ⟨m, rfl⟩
  have hm1 : s < m := by
    by_contra h
    push Not at h
    have : m * m ≤ s * s := Nat.mul_le_mul h h
    rw [sq] at h1
    omega
  have hm2 : m < s + 1 := by
    by_contra h
    push Not at h
    have : (s + 1) * (s + 1) ≤ m * m := Nat.mul_le_mul h h
    rw [sq] at h2
    omega
  omega

lemma chk_all : ∀ n < 128, n ≠ 4 → n ≠ 5 → n ≠ 7 → chk n = true := by
  decide +kernel

end OMA.Erdos398H2

theorem OMA.solution : OMA.R_Erdos398_erdos_398_R1.H2 := by
  intro n hn
  by_cases h457 : n = 4 ∨ n = 5 ∨ n = 7
  · have hmem : n ∈ ({4, 5, 7} : Set ℕ) := by
      rcases h457 with rfl | rfl | rfl <;> simp
    simp only [hmem, iff_true]
    rcases h457 with rfl | rfl | rfl
    · exact ⟨5, by decide⟩
    · exact ⟨11, by decide⟩
    · exact ⟨71, by decide⟩
  · push Not at h457
    have hmem : n ∉ ({4, 5, 7} : Set ℕ) := by
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff]
      omega
    simp only [hmem, iff_false]
    have h := OMA.Erdos398H2.chk_all n hn h457.1 h457.2.1 h457.2.2
    simp only [OMA.Erdos398H2.chk, Bool.and_eq_true, decide_eq_true_eq] at h
    exact OMA.Erdos398H2.not_sq h.1 h.2
