lemma coordinateGroup_indexSet {b : List ℕ} (hb : Legal 0 b) :
    coordinateGroup (indexSet rows0 b).toList = b := by
  have hbound : ∀ i ∈ (indexSet rows0 b).toList, i < 344 := by
    intro i hi
    exact ((mem_indexSet rows0 b i).mp (Finset.mem_toList.mp hi)).1
  have hmapn : ((indexSet rows0 b).toList.map (lookup rows0)).Nodup := by
    apply List.Nodup.map_on _ (Finset.nodup_toList _)
    intro i hi j hj he
    exact congrArg Fin.val (rowsInjective0 (a₁ := ⟨i, hbound i hi⟩) (a₂ := ⟨j, hbound j hj⟩) he)
  have hset : ((indexSet rows0 b).toList.map (lookup rows0)).toFinset = b.toFinset := by
    ext x
    simp only [List.mem_toFinset, List.mem_map, Finset.mem_toList]
    constructor
    · rintro ⟨i, hi, rfl⟩
      exact ((mem_indexSet rows0 b i).mp hi).2
    · intro hx
      obtain ⟨i, hi⟩ := legal_has_index (g := ⟨0, by decide⟩) rows0 rowsComplete0 hb hx
      exact ⟨i.val, (mem_indexSet rows0 b i.val).mpr ⟨i.isLt, hi ▸ hx⟩, hi⟩
  have hp := List.perm_of_nodup_nodup_toFinset_eq hmapn (legal_nodup (g := ⟨0, by decide⟩) hb) hset
  exact ((List.mergeSort_perm _ _).trans hp).eq_of_pairwise' (List.pairwise_mergeSort' _ _) hb.2.1

