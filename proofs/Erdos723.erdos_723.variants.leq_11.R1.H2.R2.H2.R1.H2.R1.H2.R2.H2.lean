lemma rejectCompact_legal_extension (g h : Fin 15) (cr cp dr dp hints : Tree)
    (h0 : RowBound rows0) (hcr : RowBound cr) (hdr : RowBound dr)
    (hcp : PointCorrect cr cp) (hdp : PointCorrect dr dp)
    (hcompC : matchings g.val = List.ofFn (fun i : Fin 344 => lookup cr i.val))
    (hcompD : matchings h.val = List.ofFn (fun i : Fin 344 => lookup dr i.val))
    (hinjC : Function.Injective (fun i : Fin 344 => lookup cr i.val))
    (hinjD : Function.Injective (fun i : Fin 344 => lookup dr i.val))
    (b c d : List ℕ) (hb : ∀ i ∈ b, i < 344)
    (hc : Legal g.val c) (hd : Legal h.val d)
    (hbc : ∀ x ∈ coordinateGroup b, ∀ y ∈ c, Thin (x &&& y))
    (hbd : ∀ x ∈ coordinateGroup b, ∀ y ∈ d, Thin (x &&& y))
    (hcd : ∀ x ∈ c, ∀ y ∈ d, Thin (x &&& y)) (cert fuel : ℕ) :
    rejectCompact cr cp dr dp hints fuel (allowed g.val) (allowed h.val)
      (initialCandidates cp b) (initialCandidates dp b) cert = none := by
  apply rejectCompact_solution cr cp dr dp hints hcr hdr hcp hdp fuel _ _ _ _ cert
    (indexSet cr c) (indexSet dr d)
  · exact fun i hi => ((mem_indexSet cr c i).mp hi).1
  · exact fun i hi => ((mem_indexSet dr d i).mp hi).1
  · intro i hi
    have hi' := (mem_indexSet cr c i).mp hi
    exact initialCandidates_hit cr cp b i h0 hcp hb hi'.1
      (fun j hj => hbc _ (coordinateGroup_mem hj) _ hi'.2)
  · intro i hi
    have hi' := (mem_indexSet dr d i).mp hi
    exact initialCandidates_hit dr dp b i h0 hdp hb hi'.1
      (fun j hj => hbd _ (coordinateGroup_mem hj) _ hi'.2)
  · exact indexSet_covers cr hcompC hc
  · exact indexSet_covers dr hcompD hd
  · exact indexSet_apart cr hinjC hc
  · exact indexSet_apart dr hinjD hd
  · exact fun i hi j hj => hcd _ ((mem_indexSet cr c i).mp hi).2 _ ((mem_indexSet dr d j).mp hj).2

end PlaneGrid

