namespace PlaneGrid
lemma combine_representatives (P : ℕ → Prop)
    (h : ∀ q : Fin 102, ∀ r : Fin 10, P (10*q.val+r.val)) (hlast : P 1020)
    (i : Fin 1021) : P i.val := by
  by_cases hi : i.val < 1020
  · have hq : i.val / 10 < 102 := by omega
    have hr : i.val % 10 < 10 := Nat.mod_lt _ (by decide)
    have hh := h ⟨i.val/10, hq⟩ ⟨i.val%10, hr⟩
    change P (10*(i.val/10) + i.val%10) at hh
