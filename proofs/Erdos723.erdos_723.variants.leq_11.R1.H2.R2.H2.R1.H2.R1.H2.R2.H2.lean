def orbitTable (rows points disj : Tree) (leaf : List ℕ → ℕ → Bool) :
    ℕ → ℕ → List ℕ → ℕ → ℕ → Option ℕ
 | 0, rem, acc, _, cert => if rem = 0 then
     if leaf acc (cert%64) then some (cert/64) else none
   else some cert
 | n+1, rem, acc, cand, cert => if rem = 0 then none else
     scanCert 344 (cand &&& lookup points rem.log2) cert fun i c =>
       orbitTable rows points disj leaf n (rem ^^^ lookup rows i) (i::acc)
         (cand &&& lookup disj i) c

lemma orbitTable_complete (rows points disj : Tree) (leaf : List ℕ → ℕ → Bool)
    (hr : RowBound rows) (hp : PointCorrect rows points)
    (hdisj : ∀ i < 344, lookup disj i = disjointMask points (lookup rows i))
    (P : List ℕ → Prop) (hleaf : ∀ b h, leaf b h = true → P b)
    (hperm : ∀ b c, b.Perm c → P b → P c)
    (fuel rem : ℕ) (acc : List ℕ) (cand cert : ℕ) (B : Finset ℕ)
    (hB : ∀ i ∈ B, i < 344) (hBc : ∀ i ∈ B, cand.testBit i = true)
    (hc : ICovers rows B rem) (ha : IApart rows B) (hcard : B.card = fuel)
    (hbad : ¬ P (B.toList ++ acc)) :
    orbitTable rows points disj leaf fuel rem acc cand cert = none := by
  induction fuel generalizing rem acc cand cert B with
  | zero =>
    have hB0 : B = ∅ := Finset.card_eq_zero.mp hcard
    subst B
    have hr0 : rem = 0 := by
      apply Nat.eq_of_testBit_eq
      intro k
      have hh := hc k
      simp only [Finset.notMem_empty, false_and, exists_false, iff_false] at hh
      simpa using Bool.eq_false_iff.mpr hh
    have hf : leaf acc (cert%64) = false := by
      apply Bool.eq_false_iff.mpr
      intro ht
      exact hbad (by simpa using hleaf acc _ ht)
    simp [orbitTable, hr0, hf]
  | succ fuel ih =>
    simp only [orbitTable]
    split
    · rfl
    · rename_i hn
      have ht : rem.testBit rem.log2 = true := Nat.testBit_log2 hn
      obtain ⟨i, hi, hit⟩ := (hc rem.log2).mp ht
      have hk : rem.log2 < 60 := by
        by_contra h
        have hf := Nat.testBit_lt_two_pow ((hr i (hB i hi)).trans_le
          (Nat.pow_le_pow_right (by decide : 0 < 2) (show 60 ≤ rem.log2 by omega)))
        simp [hf] at hit
      have hop : (cand &&& lookup points rem.log2).testBit i = true := by
        simp [Nat.testBit_and, hBc i hi, hp i (hB i hi) _ hk, hit]
      apply scanCert_reject _ _ _ _ hop
      intro c
      apply ih _ _ _ c (B.erase i)
      · exact fun j hj => hB j (Finset.mem_of_mem_erase hj)
      · intro j hj
        have hjB := Finset.mem_of_mem_erase hj
        have hd := ha i hi j hjB (Ne.symm (Finset.ne_of_mem_erase hj))
        simp [Nat.testBit_and, hBc j hjB, hdisj i (hB i hi),
          disjoint_candidate rows points hr hp (hB i hi) (hB j hjB) hd]
      · exact icovers_erase hc hi ha
      · exact fun j hj k hk hne => ha j (Finset.mem_of_mem_erase hj) k
          (Finset.mem_of_mem_erase hk) hne
      · rw [Finset.card_erase_of_mem hi, hcard]
        omega
      · intro hh
        apply hbad
        have he : B.toList.Perm (i :: (B.erase i).toList) := by
          simpa only [Finset.insert_erase hi] using
            (Finset.toList_insert (Finset.notMem_erase i B))
        have he' : ((B.erase i).toList ++ i :: acc).Perm (B.toList ++ acc) :=
          List.perm_middle.trans (he.symm.append_right acc)
        exact hperm _ _ he' hh


end PlaneGrid

