lemma indexSet_card {g : Fin 15} (rows : Tree)
    (hc : matchings g.val = List.ofFn (fun i : Fin 344 => lookup rows i.val))
    (hinj : Function.Injective (fun i : Fin 344 => lookup rows i.val))
    {b : List ℕ} (hb : Legal g.val b) : (indexSet rows b).card = 6 := by
  have hcard : (indexSet rows b).card = b.toFinset.card := by
    apply Finset.card_bij (fun i _ => lookup rows i)
    · intro i hi
      exact List.mem_toFinset.mpr ((mem_indexSet rows b i).mp hi).2
    · intro i hi j hj he
      exact congrArg Fin.val (hinj (a₁ := ⟨i, ((mem_indexSet rows b i).mp hi).1⟩)
        (a₂ := ⟨j, ((mem_indexSet rows b j).mp hj).1⟩) he)
    · intro x hx
      have hx' := List.mem_toFinset.mp hx
      obtain ⟨i, hi⟩ := legal_has_index rows hc hb hx'
      exact ⟨i.val, (mem_indexSet rows b i.val).mpr ⟨i.isLt, hi ▸ hx'⟩, hi⟩
  exact hcard.trans ((List.toFinset_card_of_nodup (legal_nodup hb)).trans hb.1)

end PlaneGrid

