lemma compact_viable_good (n : Fin 1021) (hc : checkCompact n.val = true)
    (hv : Viable 0 (coordinateGroup (rep n.val))) : n.val ∈ goodRep := by
  by_contra hn
  by_cases h0 : lookup compactCertData n.val % 4 = 0
  · obtain ⟨c, d, hcg, hdh, hbc, hbd, hcd⟩ := hv.2 (9,14) (by decide)
    have hh := rejectCompact_legal_extension ⟨9, by decide⟩ ⟨14, by decide⟩
      rows9 points9 rows14 points14 (hintTree (lookup compactCertData n.val % 4)) row_bound0 row_bound9 row_bound14
      point_correct9 point_correct14 rowsComplete9 rowsComplete14 rowsInjective9 rowsInjective14
      (rep n.val) c d (rep_index_bound n) hcg hdh hbc hbd hcd (lookup compactCertData n.val / 4) 13
    simp only [checkCompact, hn, if_false, h0, if_true] at hc
    rw [h0] at hh
    rw [hh] at hc
    contradiction
  · by_cases h1 : lookup compactCertData n.val % 4 = 1
    · obtain ⟨c, d, hcg, hdh, hbc, hbd, hcd⟩ := hv.2 (10,13) (by decide)
      have hh := rejectCompact_legal_extension ⟨10, by decide⟩ ⟨13, by decide⟩
        rows10 points10 rows13 points13 (hintTree (lookup compactCertData n.val % 4)) row_bound0 row_bound10 row_bound13
        point_correct10 point_correct13 rowsComplete10 rowsComplete13 rowsInjective10 rowsInjective13
        (rep n.val) c d (rep_index_bound n) hcg hdh hbc hbd hcd (lookup compactCertData n.val / 4) 13
      simp only [checkCompact, hn, if_false, h1, if_true, Nat.one_ne_zero] at hc
      rw [h1] at hh
      rw [hh] at hc
      contradiction
    · obtain ⟨c, d, hcg, hdh, hbc, hbd, hcd⟩ := hv.2 (11,12) (by decide)
      have hh := rejectCompact_legal_extension ⟨11, by decide⟩ ⟨12, by decide⟩
        rows11 points11 rows12 points12 (hintTree (lookup compactCertData n.val % 4)) row_bound0 row_bound11 row_bound12
        point_correct11 point_correct12 rowsComplete11 rowsComplete12 rowsInjective11 rowsInjective12
        (rep n.val) c d (rep_index_bound n) hcg hdh hbc hbd hcd (lookup compactCertData n.val / 4) 13
      simp only [checkCompact, hn, if_false, h0, h1] at hc
      rw [hh] at hc
      contradiction
