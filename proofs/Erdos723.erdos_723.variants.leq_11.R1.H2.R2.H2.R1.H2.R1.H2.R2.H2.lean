namespace PlaneGrid

def indexSet (rows : Tree) (b : List ℕ) : Finset ℕ :=
  (Finset.range 344).filter fun i => lookup rows i ∈ b

lemma mem_indexSet (rows : Tree) (b : List ℕ) (i : ℕ) :
    i ∈ indexSet rows b ↔ i < 344 ∧ lookup rows i ∈ b := by simp [indexSet]

lemma legal_has_index {g : Fin 15} (rows : Tree)
    (hc : matchings g.val = List.ofFn (fun i : Fin 344 => lookup rows i.val))
    {b : List ℕ} (hb : Legal g.val b) {x : ℕ} (hx : x ∈ b) :
    ∃ i : Fin 344, lookup rows i.val = x := by
  have hh := legal_matching hb hx
  rw [hc] at hh
  exact List.mem_ofFn.mp hh

lemma indexSet_covers {g : Fin 15} (rows : Tree)
    (hc : matchings g.val = List.ofFn (fun i : Fin 344 => lookup rows i.val))
    {b : List ℕ} (hb : Legal g.val b) : ICovers rows (indexSet rows b) (allowed g.val) := by
  intro k
  rw [← hb.2.2.1, fold_bits]
  constructor
  · rintro ⟨x, hx, hk⟩
    obtain ⟨i, hi⟩ := legal_has_index rows hc hb hx
    exact ⟨i.val, (mem_indexSet rows b i.val).mpr ⟨i.isLt, hi ▸ hx⟩, hi ▸ hk⟩
  · rintro ⟨i, hi, hk⟩
    exact ⟨lookup rows i, ((mem_indexSet rows b i).mp hi).2, hk⟩

lemma indexSet_apart {g : Fin 15} (rows : Tree)
    (hinj : Function.Injective (fun i : Fin 344 => lookup rows i.val))
    {b : List ℕ} (hb : Legal g.val b) : IApart rows (indexSet rows b) := by
  intro i hi j hj hij
  have hi' := (mem_indexSet rows b i).mp hi
  have hj' := (mem_indexSet rows b j).mp hj
  have hne : lookup rows i ≠ lookup rows j := by
    intro he
    have hh := hinj (a₁ := ⟨i, hi'.1⟩) (a₂ := ⟨j, hj'.1⟩) he
    exact hij (congrArg Fin.val hh)
  exact legal_apart hb _ (List.mem_toFinset.mpr hi'.2) _ (List.mem_toFinset.mpr hj'.2) hne

lemma foldl_and_bit (f : ℕ → ℕ) (b : List ℕ) (j acc : ℕ)
    (ha : acc.testBit j = true) (hb : ∀ i ∈ b, (f i).testBit j = true) :
    (b.foldl (fun a i => a &&& f i) acc).testBit j = true := by
  induction b generalizing acc with
  | nil => exact ha
  | cons i b ih =>
    apply ih
    · simp [Nat.testBit_and, ha, hb i (by simp)]
    · exact fun k hk => hb k (List.mem_cons_of_mem _ hk)

lemma initialCandidates_hit (rows points : Tree) (b : List ℕ) (j : ℕ)
    (h0 : RowBound rows0) (hp : PointCorrect rows points)
    (hb : ∀ i ∈ b, i < 344) (hj : j < 344)
    (hc : ∀ i ∈ b, Thin (lookup rows0 i &&& lookup rows j)) :
    (initialCandidates points b).testBit j = true := by
  apply foldl_and_bit
  · rw [Nat.testBit_two_pow_sub_one]
    exact decide_eq_true hj
  · intro i hi
    exact compatible_candidate rows0 rows points h0 hp (hb i hi) hj (hc i hi)

def coordinateGroup (b : List ℕ) : List ℕ := (b.map (lookup rows0)).mergeSort (· ≤ ·)

lemma coordinateGroup_mem {b : List ℕ} {i : ℕ} (hi : i ∈ b) :
    lookup rows0 i ∈ coordinateGroup b := by
  simp only [coordinateGroup, List.mem_mergeSort]
  exact List.mem_map.mpr ⟨i, hi, rfl⟩

end PlaneGrid

namespace PlaneGrid

def readHint : Tree → ℕ → ℕ × ℕ
 | .L tag, cert => (tag, cert)
 | .P x y, cert => (if cert % 2 = 0 then x else y, cert/2)
 | .Q a b c d, cert => (if cert%4 = 0 then a else if cert%4 = 1 then b else if cert%4 = 2 then c else d, cert/4)
 | .N l r, cert => if cert % 2 = 0 then readHint l (cert/2) else readHint r (cert/2)

def rejectCompact (cr cp dr dp hints : Tree) :
    ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → Option ℕ
 | 0, _, _, _, _, _ => none
 | n+1, rc, rd, cc, dd, cert =>
   if rc = 0 ∧ rd = 0 then none else
   let tag := (readHint hints cert).1
   let rest := (readHint hints cert).2
   if tag < 60 then
     if rc.testBit tag then
       scanCert 344 (cc &&& lookup cp tag) rest fun i c =>
         rejectCompact cr cp dr dp hints n (rc ^^^ lookup cr i) rd
           (cc &&& disjointMask cp (lookup cr i)) (dd &&& compatibleMask dp (lookup cr i)) c
     else none
   else
     if rd.testBit (tag-60) then
       scanCert 344 (dd &&& lookup dp (tag-60)) rest fun i c =>
         rejectCompact cr cp dr dp hints n rc (rd ^^^ lookup dr i)
           (cc &&& compatibleMask cp (lookup dr i)) (dd &&& disjointMask dp (lookup dr i)) c
     else none

end PlaneGrid

namespace PlaneGrid
lemma rejectCompact_solution (cr cp dr dp hints : Tree)
    (hcr : RowBound cr) (hdr : RowBound dr)
    (hcp : PointCorrect cr cp) (hdp : PointCorrect dr dp)
    (fuel rc rd cc dd cert : ℕ) (B D : Finset ℕ)
    (hB : ∀ i ∈ B, i < 344) (hD : ∀ i ∈ D, i < 344)
    (hBc : ∀ i ∈ B, cc.testBit i = true) (hDc : ∀ i ∈ D, dd.testBit i = true)
    (hcB : ICovers cr B rc) (hcD : ICovers dr D rd)
    (haB : IApart cr B) (haD : IApart dr D) (hcomp : ICompat cr dr B D) :
    rejectCompact cr cp dr dp hints fuel rc rd cc dd cert = none := by
  induction fuel generalizing rc rd cc dd cert B D with
  | zero => rfl
  | succ fuel ih =>
    simp only [rejectCompact]
    split
    · rfl
    · split
      · rename_i htag
        split
        · rename_i hbit
          obtain ⟨i, hi, hik⟩ := (hcB ((readHint hints cert).1)).mp hbit
          have hopt : (cc &&& lookup cp ((readHint hints cert).1)).testBit i = true := by
            simp [Nat.testBit_and, hBc i hi, hcp i (hB i hi) _ htag, hik]
          apply scanCert_reject 344 _ _ _ hopt
          intro c
          apply ih _ _ _ _ c (B.erase i) D
          · exact fun j hj => hB j (Finset.mem_of_mem_erase hj)
          · exact hD
          · intro j hj
            have hjB := Finset.mem_of_mem_erase hj
            have hdij := haB i hi j hjB (Ne.symm (Finset.ne_of_mem_erase hj))
            simp [Nat.testBit_and, hBc j hjB,
              disjoint_candidate cr cp hcr hcp (hB i hi) (hB j hjB) hdij]
          · intro j hj
            simp [Nat.testBit_and, hDc j hj,
              compatible_candidate cr dr dp hcr hdp (hB i hi) (hD j hj) (hcomp i hi j hj)]
          · exact icovers_erase hcB hi haB
          · exact hcD
          · exact fun j hj k hk hne => haB j (Finset.mem_of_mem_erase hj) k
              (Finset.mem_of_mem_erase hk) hne
          · exact haD
          · exact fun j hj k hk => hcomp j (Finset.mem_of_mem_erase hj) k hk
        · rfl
      · rename_i htag
        split
        · rename_i hbit
          obtain ⟨i, hi, hik⟩ := (hcD ((readHint hints cert).1 - 60)).mp hbit
          have hk60 : (readHint hints cert).1 - 60 < 60 := by
            have hlt := hdr i (hD i hi)
            by_contra hn
            have hf := Nat.testBit_lt_two_pow (hlt.trans_le
              (Nat.pow_le_pow_right (by decide : 0 < 2) (show 60 ≤ (readHint hints cert).1 - 60 by omega)))
            simp [hf] at hik
          have hopt : (dd &&& lookup dp ((readHint hints cert).1 - 60)).testBit i = true := by
            simp [Nat.testBit_and, hDc i hi, hdp i (hD i hi) _ hk60, hik]
          apply scanCert_reject 344 _ _ _ hopt
          intro c
          apply ih _ _ _ _ c B (D.erase i)
          · exact hB
          · exact fun j hj => hD j (Finset.mem_of_mem_erase hj)
          · intro j hj
            have hcij : Thin (lookup dr i &&& lookup cr j) := by
              simpa [Nat.and_comm] using hcomp j hj i hi
            simp [Nat.testBit_and, hBc j hj,
              compatible_candidate dr cr cp hdr hcp (hD i hi) (hB j hj) hcij]
          · intro j hj
            have hjD := Finset.mem_of_mem_erase hj
            have hdij := haD i hi j hjD (Ne.symm (Finset.ne_of_mem_erase hj))
            simp [Nat.testBit_and, hDc j hjD,
              disjoint_candidate dr dp hdr hdp (hD i hi) (hD j hjD) hdij]
          · exact hcB
          · exact icovers_erase hcD hi haD
          · exact haB
          · exact fun j hj k hk hne => haD j (Finset.mem_of_mem_erase hj) k
              (Finset.mem_of_mem_erase hk) hne
          · exact fun j hj k hk => hcomp j hj k (Finset.mem_of_mem_erase hk)
        · rfl

end PlaneGrid

