def marker (g : ℕ) : ℕ := if g = 0 then 4398063288320 else if g = 9 then 262400 else 131584
def Joined (g : ℕ) (b : List ℕ) : Prop := ∃ x ∈ b, x &&& marker g = marker g
instance (g : ℕ) (b : List ℕ) : Decidable (Joined g b) :=
  inferInstanceAs (Decidable (∃ x ∈ b, x &&& marker g = marker g))
def computedMap (p : Fin 60 ≃ Fin 60) (b : List ℕ) : List ℕ :=
  (b.map (mapMask p)).insertionSort (· ≤ ·)
lemma groupMap_eq_computed (p : Fin 60 ≃ Fin 60) (b : List ℕ) : groupMap p b = computedMap p b :=
  List.mergeSort_eq_insertionSort _ _
def candidateGroups (g : ℕ) : Finset (List ℕ) := if g = 0 then positiveGroups else
  if g = 9 then positiveGroups.image (computedMap perm5) else positiveGroups.image (computedMap perm6)

theorem count0 : ((candidateGroups 0).filter (fun b => ¬ Joined 0 b)).card = 52 := by decide +kernel
theorem count9 : ((candidateGroups 9).filter (fun b => ¬ Joined 9 b)).card = 52 := by decide +kernel
theorem count14 : ((candidateGroups 14).filter (fun b => ¬ Joined 14 b)).card = 52 := by decide +kernel

lemma viable_candidates
    (hchecked : ∀ i : Fin 344, (lookup rows0 i.val).testBit 59 = true → rootTableCheck i.val = true)
    {g : ℕ} (hg : g ∈ [0,9,14]) {b : List ℕ} (hv : Viable g b) : b ∈ candidateGroups g := by
  have hbound : ∀ x ∈ b, x < 2^60 := by
    intro x hx
    exact (sub_le (legal_sub hv.1 hx)).trans_lt (allowed_lt g)
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hg
  rcases hg with rfl | rfl | rfl
  · exact all_viable_positive_table hchecked hv
  · have hh := all_viable_positive_table hchecked (viable_from9 hv)
    have hinv := groupMap_inv perm5 hv.1.2.1 hbound
    have hsym : perm5.symm = perm5 := rfl
    rw [hsym] at hinv
    apply Finset.mem_image.mpr
    exact ⟨groupMap perm5 b, hh, (groupMap_eq_computed perm5 _).symm.trans hinv⟩
  · have hh := all_viable_positive_table hchecked (viable_from14 hv)
    have hinv := groupMap_inv perm6 hv.1.2.1 hbound
    have hsym : perm6.symm = perm6 := rfl
    rw [hsym] at hinv
    apply Finset.mem_image.mpr
    exact ⟨groupMap perm6 b, hh, (groupMap_eq_computed perm6 _).symm.trans hinv⟩

lemma final_bound
    (hchecked : ∀ i : Fin 344, (lookup rows0 i.val).testBit 59 = true → rootTableCheck i.val = true) :
    ∀ g ∈ [0,9,14], ∀ S : Finset (List ℕ),
      (∀ b ∈ S, Viable g b ∧ ¬ Joined g b) → S.card ≤ 52 := by
  intro g hg S hS
  have hsub : S ⊆ (candidateGroups g).filter (fun b => ¬ Joined g b) := by
    intro b hb
    exact Finset.mem_filter.mpr ⟨viable_candidates hchecked hg (hS b hb).1, (hS b hb).2⟩
  have hcount : ((candidateGroups g).filter (fun b => ¬ Joined g b)).card = 52 := by
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hg
    rcases hg with rfl | rfl | rfl
    · exact count0
    · exact count9
    · exact count14
  exact hcount ▸ Finset.card_le_card hsub

