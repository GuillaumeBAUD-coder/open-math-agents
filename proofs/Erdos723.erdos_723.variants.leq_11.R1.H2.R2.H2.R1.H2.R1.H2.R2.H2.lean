def pairs (g : ℕ) : List (ℕ × ℕ) := if g = 0 then [(9,14),(10,13),(11,12)] else
  if g = 9 then [(0,14),(3,8),(4,7)] else [(0,9),(1,6),(2,5)]
def Extension (g h : ℕ) (b : List ℕ) : Prop :=
  ∃ c d, Legal g c ∧ Legal h d ∧
    (∀ x ∈ b, ∀ y ∈ c, Thin (x &&& y)) ∧
    (∀ x ∈ b, ∀ y ∈ d, Thin (x &&& y)) ∧
    (∀ x ∈ c, ∀ y ∈ d, Thin (x &&& y))
def Viable (g : ℕ) (b : List ℕ) : Prop := Legal g b ∧ ∀ t ∈ pairs g, Extension t.1 t.2 b

lemma extension_swap {g h : ℕ} {b : List ℕ} (he : Extension g h b) : Extension h g b := by
  obtain ⟨c, d, hc, hd, hbc, hbd, hcd⟩ := he
  refine ⟨d, c, hd, hc, hbd, hbc, ?_⟩
  intro x hx y hy
  simpa [Nat.and_comm] using hcd y hy x hx

lemma extension_map (p : Fin 60 ≃ Fin 60) {g h g' h' : ℕ}
    (hg : mapMask p (allowed g) = allowed g') (hh : mapMask p (allowed h) = allowed h')
    (hinc : ∀ m : Fin 15, ∃ n : Fin 15, mapMask p (incident n.val) = incident m.val)
    {b : List ℕ} (he : Extension g h b) : Extension g' h' (groupMap p b) := by
  obtain ⟨c, d, hc, hd, hbc, hbd, hcd⟩ := he
  exact ⟨groupMap p c, groupMap p d, groupMap_legal p hg hinc hc,
    groupMap_legal p hh hinc hd, groupMap_compatible p hbc,
    groupMap_compatible p hbd, groupMap_compatible p hcd⟩

lemma viable_zero_of_triples {b : List ℕ} (hb : Legal 0 b)
    (h1 : Extension 9 14 b) (h2 : Extension 10 13 b) (h3 : Extension 11 12 b) : Viable 0 b := by
  refine ⟨hb, ?_⟩
  intro t ht
  have ht' : t = (9,14) ∨ t = (10,13) ∨ t = (11,12) := by simpa [pairs] using ht
  rcases ht' with rfl | rfl | rfl
  · exact h1
  · exact h2
  · exact h3

