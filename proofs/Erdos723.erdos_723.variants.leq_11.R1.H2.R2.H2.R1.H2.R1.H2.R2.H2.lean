def rootTableCheck (i : ℕ) : Bool :=
 (orbitTable rows0 points0 disjointData directCheck 5 (allowed 0 ^^^ lookup rows0 i) [i]
   (lookup disjointData i) (lookup fastBranchData i)).isSome

lemma all_viable_positive_table
    (hchecked : ∀ i : Fin 344, (lookup rows0 i.val).testBit 59 = true → rootTableCheck i.val = true)
    {b : List ℕ} (hv : Viable 0 b) : b ∈ positiveGroups := by
  let B := indexSet rows0 b
  have hB : ∀ i ∈ B, i < 344 := fun i hi => ((mem_indexSet rows0 b i).mp hi).1
  have hc := indexSet_covers (g := ⟨0, by decide⟩) rows0 rowsComplete0 hv.1
  have ha := indexSet_apart (g := ⟨0, by decide⟩) rows0 rowsInjective0 hv.1
  have hcard : B.card = 6 := indexSet_card (g := ⟨0, by decide⟩) rows0 rowsComplete0 rowsInjective0 hv.1
  have hgood : LeafGood B.toList := by
    by_contra hn
    obtain ⟨i, hi, hit⟩ := (hc 59).mp (by decide +kernel)
    have hbc : ∀ j ∈ B.erase i, (lookup disjointData i).testBit j = true := by
      intro j hj
      rw [disjointTable_correct ⟨i, hB i hi⟩]
      exact disjoint_candidate rows0 points0 row_bound0 point_correct0 (hB i hi)
        (hB j (Finset.mem_of_mem_erase hj))
        (ha i hi j (Finset.mem_of_mem_erase hj) (Ne.symm (Finset.ne_of_mem_erase hj)))
    have he : B.toList.Perm (i :: (B.erase i).toList) := by
      have hh := Finset.toList_insert (Finset.notMem_erase i B)
      rw [Finset.insert_erase (show i ∈ B from hi)] at hh
      exact hh
    have he' : ((B.erase i).toList ++ [i]).Perm B.toList :=
      (List.perm_append_singleton i (B.erase i).toList).trans he.symm
    have hbad : ¬ LeafGood ((B.erase i).toList ++ [i]) := fun hh => hn (leafGood_perm _ _ he' hh)
    have hf := orbitTable_complete rows0 points0 disjointData directCheck row_bound0 point_correct0
      (fun j hj => disjointTable_correct ⟨j, hj⟩)
      LeafGood direct_good leafGood_perm 5 (allowed 0 ^^^ lookup rows0 i) [i]
      (lookup disjointData i) (lookup fastBranchData i) (B.erase i)
      (fun j hj => hB j (Finset.mem_of_mem_erase hj)) hbc (icovers_erase hc hi ha)
      (fun j hj k hk hne => ha j (Finset.mem_of_mem_erase hj) k (Finset.mem_of_mem_erase hk) hne)
      (by rw [Finset.card_erase_of_mem hi, hcard]) hbad
    have hh := hchecked ⟨i, hB i hi⟩ hit
    unfold rootTableCheck at hh
    rw [hf] at hh
    exact Bool.false_ne_true hh
  have he : coordinateGroup B.toList = b := coordinateGroup_indexSet hv.1
  have hh := hgood (by simpa using hcard)
    (fun i hi => hB i (Finset.mem_toList.mp hi)) (by simpa only [he] using hv)
  simpa only [he] using hh

end PlaneGrid

