def seekRep (code : ℕ) : SearchTree → ℕ
 | E => 1021
 | B i l r => if code = lookup repData i then i else
     if code < lookup repData i then seekRep code l else seekRep code r

def normalizeWord : ℕ → ℕ → List ℕ → List ℕ
 | 0, _, b => b.insertionSort (· ≤ ·)
 | n+1, w, b => if w % 8 = 0 then b.insertionSort (· ≤ ·) else
     normalizeWord n (w/8) (b.map (generatorIndex (w%8-1)))
def packCoordinates : List ℕ → ℕ
 | [] => 0
 | i::is => i + 512 * packCoordinates is

def normalizedCheck (b : List ℕ) (hint : ℕ) : Bool :=
 let code := packCoordinates (normalizeWord 6 (lookup wordData hint) b)
 let i := seekRep code repSearch
 decide (i < 1021) && (lookup repData i == code)
end PlaneGrid

