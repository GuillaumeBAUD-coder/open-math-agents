/- Generic bit-mask and covering lemmas. New integration: Hanan Beer (@hananzlt).
The fold-or membership argument follows the canonical reduction by @MrSeizy,
PR2033; its attribution is retained here. -/
namespace PlaneGrid

def bits (w n : ℕ) : Finset (Fin w) := Finset.univ.filter fun i => n.testBit i.val

def Thin (n : ℕ) : Prop := n &&& (n - 1) = 0

lemma mem_bits {w n : ℕ} (i : Fin w) : i ∈ bits w n ↔ n.testBit i.val = true := by
  simp [bits]

lemma bits_and (w x y : ℕ) : bits w (x &&& y) = bits w x ∩ bits w y := by
  ext i
  simp [mem_bits, Nat.testBit_and, Bool.and_eq_true]

lemma thin_card {w n : ℕ} (h : Thin n) : (bits w n).card ≤ 1 := by
  apply Finset.card_le_one.mpr
  intro i hi j hj
  by_cases hn : n = 0
  · simp [mem_bits, hn] at hi
  · obtain ⟨k, hk⟩ := (Nat.and_sub_one_eq_zero_iff_isPowerOfTwo hn).mp h
    have hi' : i.val = k := by simpa [mem_bits, hk, Nat.testBit_two_pow, eq_comm] using hi
    have hj' : j.val = k := by simpa [mem_bits, hk, Nat.testBit_two_pow, eq_comm] using hj
    exact Fin.ext (hi'.trans hj'.symm)

lemma fold_bits (l : List Nat) (p : Nat) :
    (l.foldr Nat.lor 0).testBit p = true ↔ ∃ x ∈ l, x.testBit p = true := by
  induction l with
  | nil => simp
  | cons a l ih => simp [ih]

lemma le_fold_or {l : List ℕ} {x : ℕ} (hx : x ∈ l) : x ≤ l.foldr Nat.lor 0 := by
  apply Nat.le_of_testBit
  intro p hp
  exact (fold_bits l p).mpr ⟨x, hx, hp⟩

lemma each_nonempty_of_cover {α β : Type*} [DecidableEq α] [DecidableEq β]
    (B : Finset β) (U : Finset α) (f : β → Finset α)
    (hcover : U ⊆ B.biUnion f) (hsize : B.card ≤ U.card)
    (hsmall : ∀ b ∈ B, (f b).card ≤ 1) : ∀ b ∈ B, (f b).Nonempty := by
  intro b hb
  by_contra hn
  have hz : f b = ∅ := Finset.not_nonempty_iff_eq_empty.mp hn
  have hcov : U ⊆ (B.erase b).biUnion f := by
    intro a ha
    obtain ⟨c, hc, hca⟩ := Finset.mem_biUnion.mp (hcover ha)
    have hcb : c ≠ b := by
      rintro rfl
      simp [hz] at hca
    exact Finset.mem_biUnion.mpr ⟨c, Finset.mem_erase.mpr ⟨hcb, hc⟩, hca⟩
  have hsum : (∑ c ∈ B.erase b, (f c).card) ≤ (B.erase b).card := by
    calc
      _ ≤ ∑ c ∈ B.erase b, 1 := Finset.sum_le_sum fun c hc =>
        hsmall c (Finset.mem_of_mem_erase hc)
      _ = _ := by simp
  have hcard : U.card ≤ (B.erase b).card :=
    (Finset.card_le_card hcov).trans (Finset.card_biUnion_le.trans hsum)
  have he := Finset.card_erase_of_mem hb
  have hpos := Finset.card_pos.mpr ⟨b, hb⟩
  omega

lemma block_meets {w : ℕ} {b : List ℕ} {allowed incident : ℕ}
    (hlen : b.length ≤ (bits w (allowed &&& incident)).card)
    (hcover : b.foldr Nat.lor 0 = allowed)
    (hthin : ∀ x ∈ b, Thin (x &&& incident)) :
    ∀ x ∈ b, (bits w (x &&& incident)).Nonempty := by
  have hcov : bits w (allowed &&& incident) ⊆
      b.toFinset.biUnion (fun x => bits w (x &&& incident)) := by
    intro p hp
    have hbit := (mem_bits p).mp hp
    rw [Nat.testBit_and, Bool.and_eq_true] at hbit
    obtain ⟨x, hx, hpx⟩ := (fold_bits b p.val).mp (hcover.symm ▸ hbit.1)
    exact Finset.mem_biUnion.mpr ⟨x, List.mem_toFinset.mpr hx,
      (mem_bits p).mpr (by simp [Nat.testBit_and, hpx, hbit.2])⟩
  have hh := each_nonempty_of_cover b.toFinset (bits w (allowed &&& incident))
    (fun x => bits w (x &&& incident)) hcov (b.toFinset_card_le.trans hlen)
    (fun x hx => thin_card (hthin x (List.mem_toFinset.mp hx)))
  exact fun x hx => hh x (List.mem_toFinset.mpr hx)

end PlaneGrid


/- Exhaustive matching generation. Hanan Beer (@hananzlt). -/
namespace PlaneGrid

def Sub (a b : ℕ) : Prop := ∀ k, a.testBit k = true → b.testBit k = true

lemma sub_refl (a : ℕ) : Sub a a := fun _ h => h
lemma sub_trans {a b c : ℕ} (hab : Sub a b) (hbc : Sub b c) : Sub a c :=
  fun k hk => hbc k (hab k hk)
lemma sub_zero (a : ℕ) : Sub 0 a := by intro k hk; simp at hk
lemma sub_or_left (a b : ℕ) : Sub a (a ||| b) := by
  intro k hk
  simp [Nat.testBit_or, hk]
lemma sub_or_right (a b : ℕ) : Sub b (a ||| b) := by
  intro k hk
  simp [Nat.testBit_or, hk]
lemma sub_or {a b c : ℕ} (ha : Sub a c) (hb : Sub b c) : Sub (a ||| b) c := by
  intro k hk
  simp only [Nat.testBit_or, Bool.or_eq_true] at hk
  exact hk.elim (ha k) (hb k)
lemma sub_le {a b : ℕ} (h : Sub a b) : a ≤ b := Nat.le_of_testBit h
lemma sub_and {a b : ℕ} (h : Sub a b) (c : ℕ) : Sub (a &&& c) (b &&& c) := by
  intro k hk
  simp only [Nat.testBit_and, Bool.and_eq_true] at hk ⊢
  exact ⟨h k hk.1, hk.2⟩
lemma meets_mono {a b c : ℕ} (h : Sub a b) (hm : a &&& c ≠ 0) : b &&& c ≠ 0 := by
  have hh := sub_le (sub_and h c)
  omega

lemma thin_unique {n : ℕ} (h : Thin n) {i j : ℕ}
    (hi : n.testBit i = true) (hj : n.testBit j = true) : i = j := by
  by_cases hn : n = 0
  · simp [hn] at hi
  · obtain ⟨k, hk⟩ := (Nat.and_sub_one_eq_zero_iff_isPowerOfTwo hn).mp h
    simp only [hk, Nat.testBit_two_pow, decide_eq_true_eq] at hi hj
    omega

lemma thin_of_unique {n : ℕ}
    (h : ∀ i j, n.testBit i = true → n.testBit j = true → i = j) : Thin n := by
  by_cases hn : n = 0
  · simp [Thin, hn]
  · have hi : n.testBit n.log2 = true := Nat.testBit_log2 (by omega)
    have he : n = 2 ^ n.log2 := by
      apply Nat.eq_of_testBit_eq
      intro j
      apply Bool.eq_iff_iff.mpr
      simp only [Nat.testBit_two_pow, decide_eq_true_eq]
      exact ⟨fun hj => h _ _ hi hj, fun hj => hj ▸ hi⟩
    exact (Nat.and_sub_one_eq_zero_iff_isPowerOfTwo hn).mpr ⟨_, he⟩

lemma thin_mono {a b : ℕ} (hab : Sub a b) (hb : Thin b) : Thin a :=
  thin_of_unique fun i j hi hj => thin_unique hb (hab i hi) (hab j hj)

def fills (inc : ℕ → ℕ) (opts : ℕ → List ℕ) (Good : ℕ → Prop) [DecidablePred Good] :
    List ℕ → ℕ → List ℕ
  | [], a => [a]
  | v :: vs, a => if a &&& inc v ≠ 0 then fills inc opts Good vs a else
    (opts v).flatMap fun e => if Good (a ||| e) then fills inc opts Good vs (a ||| e) else []

lemma fills_complete (inc : ℕ → ℕ) (opts : ℕ → List ℕ) (Good : ℕ → Prop)
    [DecidablePred Good] (x : ℕ) (good : ∀ a, Sub a x → Good a)
    (vs : List ℕ) (edges : ∀ v ∈ vs, ∃ e ∈ opts v, Sub e x ∧ e &&& inc v ≠ 0)
    (a : ℕ) (ha : Sub a x) :
    ∃ z ∈ fills inc opts Good vs a,
      Sub a z ∧ Sub z x ∧ ∀ v ∈ vs, z &&& inc v ≠ 0 := by
  induction vs generalizing a with
  | nil => exact ⟨a, by simp [fills], sub_refl _, ha, by simp⟩
  | cons v vs ih =>
    have rest := fun w hw => edges w (List.mem_cons_of_mem v hw)
    by_cases hm : a &&& inc v ≠ 0
    · obtain ⟨z, hz, haz, hzx, hvs⟩ := ih rest a ha
      refine ⟨z, by simpa [fills, hm] using hz, haz, hzx, ?_⟩
      intro w hw
      rcases List.mem_cons.mp hw with rfl | hw
      · exact meets_mono haz hm
      · exact hvs w hw
    · obtain ⟨e, he, hex, hem⟩ := edges v (by simp)
      have hax : Sub (a ||| e) x := sub_or ha hex
      obtain ⟨z, hz, haz, hzx, hvs⟩ := ih rest (a ||| e) hax
      refine ⟨z, ?_, sub_trans (sub_or_left a e) haz, hzx, ?_⟩
      · simp only [fills, hm, if_false, List.mem_flatMap]
        exact ⟨e, he, by simpa [good _ hax] using hz⟩
      · intro w hw
        rcases List.mem_cons.mp hw with rfl | hw
        · exact meets_mono (sub_trans (sub_or_right a e) haz) hem
        · exact hvs w hw

lemma matching_eq_of_sub (inc : ℕ → ℕ) (vs : List ℕ) {x z : ℕ}
    (hzx : Sub z x) (thin : ∀ v ∈ vs, Thin (x &&& inc v))
    (cover : ∀ k, x.testBit k = true → ∃ v ∈ vs, (inc v).testBit k = true)
    (hits : ∀ v ∈ vs, z &&& inc v ≠ 0) : z = x := by
  apply Nat.eq_of_testBit_eq
  intro k
  apply Bool.eq_iff_iff.mpr
  refine ⟨hzx k, ?_⟩
  intro hk
  obtain ⟨v, hv, hvk⟩ := cover k hk
  have hp : (z &&& inc v).testBit (z &&& inc v).log2 = true :=
    Nat.testBit_log2 (by have := hits v hv; omega)
  rw [Nat.testBit_and, Bool.and_eq_true] at hp
  have he : k = (z &&& inc v).log2 := thin_unique (thin v hv)
    (by simp [Nat.testBit_and, hk, hvk])
    (by simp [Nat.testBit_and, hzx _ hp.1, hp.2])
  exact he ▸ hp.1

end PlaneGrid

namespace PlaneGrid
inductive Tree where
 | L : ℕ → Tree
 | N : Tree → Tree → Tree
 | P : ℕ → ℕ → Tree
 | Q : ℕ → ℕ → ℕ → ℕ → Tree
open _root_.PlaneGrid.Tree
def lookup (t : Tree) (i : ℕ) : ℕ :=
 match t with
 | .L v => v
 | .P x y => if i % 2 = 0 then x else y
 | .Q a b c d => if i%4 = 0 then a else if i%4 = 1 then b else if i%4 = 2 then c else d
 | .N a b => if i % 2 = 0 then lookup a (i/2) else lookup b (i/2)

def scanCert : ℕ → ℕ → ℕ → (ℕ → ℕ → Option ℕ) → Option ℕ
 | 0, mask, cert, _ => if mask = 0 then some cert else none
 | n+1, mask, cert, f => if mask = 0 then some cert else
   match f mask.log2 cert with
   | none => none
   | some rest => scanCert n (mask ^^^ (2^mask.log2)) rest f

end PlaneGrid

namespace PlaneGrid
def pointList : ℕ → ℕ → List ℕ
 | 0, _ => []
 | n+1, row => if row = 0 then [] else row.log2 :: pointList n (row ^^^ (2^row.log2))

def unionMask (points : Tree) : List ℕ → ℕ
 | [] => 0
 | k::ks => lookup points k ||| unionMask points ks

def collisionMask (points : Tree) : List ℕ → ℕ → ℕ
 | [], _ => 0
 | k::ks, seen => (seen &&& lookup points k) ||| collisionMask points ks (seen ||| lookup points k)

def disjointMask (points : Tree) (row : ℕ) : ℕ :=
 (2^344-1) ^^^ unionMask points (pointList 6 row)
def compatibleMask (points : Tree) (row : ℕ) : ℕ :=
 (2^344-1) ^^^ collisionMask points (pointList 6 row) 0

end PlaneGrid

