namespace PlaneGrid

lemma clear_sub {row : ℕ} (hr : row ≠ 0) : Sub (row ^^^ (2^row.log2)) row := by
  intro k hk
  by_cases he : row.log2 = k
  · subst k
    exact Nat.testBit_log2 hr
  · simpa [Nat.testBit_xor, he] using hk

lemma clear_top {row : ℕ} (hr : row ≠ 0) :
    (row ^^^ (2^row.log2)).testBit row.log2 = false := by
  simp [Nat.testBit_xor, Nat.testBit_log2 hr]

lemma pointList_mem (fuel row : ℕ) {k : ℕ} (hk : k ∈ pointList fuel row) :
    row.testBit k = true := by
  induction fuel generalizing row with
  | zero => simp [pointList] at hk
  | succ fuel ih =>
    by_cases hr : row = 0
    · simp [pointList, hr] at hk
    · simp only [pointList, hr, if_false, List.mem_cons] at hk
      rcases hk with rfl | hk
      · exact Nat.testBit_log2 hr
      · exact clear_sub hr k (ih _ hk)

lemma pointList_nodup (fuel row : ℕ) : (pointList fuel row).Nodup := by
  induction fuel generalizing row with
  | zero => simp [pointList]
  | succ fuel ih =>
    by_cases hr : row = 0
    · simp [pointList, hr]
    · simp only [pointList, hr, if_false, List.nodup_cons]
      refine ⟨?_, ih _⟩
      intro hk
      have hh := pointList_mem fuel (row ^^^ (2^row.log2)) hk
      rw [clear_top hr] at hh
      contradiction

lemma unionMask_bit (points : Tree) (ks : List ℕ) (j : ℕ) :
    (unionMask points ks).testBit j = true ↔ ∃ k ∈ ks, (lookup points k).testBit j = true := by
  induction ks with
  | nil => simp [unionMask]
  | cons k ks ih => simp [unionMask, Nat.testBit_or, ih]

lemma collision_no_hits (points : Tree) (ks : List ℕ) (j seen : ℕ)
    (hh : ∀ k ∈ ks, (lookup points k).testBit j = false) :
    (collisionMask points ks seen).testBit j = false := by
  induction ks generalizing seen with
  | nil => simp [collisionMask]
  | cons k ks ih =>
    have hk := hh k (by simp)
    have hs : ∀ l ∈ ks, (lookup points l).testBit j = false :=
      fun l hl => hh l (List.mem_cons_of_mem _ hl)
    simp [collisionMask, Nat.testBit_or, Nat.testBit_and, hk, ih _ hs]

lemma collision_one_hit (points : Tree) (ks : List ℕ) (j seen : ℕ)
    (hseen : seen.testBit j = false) (hn : ks.Nodup)
    (hone : ∀ k ∈ ks, ∀ l ∈ ks, (lookup points k).testBit j = true →
      (lookup points l).testBit j = true → k = l) :
    (collisionMask points ks seen).testBit j = false := by
  induction ks generalizing seen with
  | nil => simp [collisionMask]
  | cons k ks ih =>
    have hnr := List.nodup_cons.mp hn
    by_cases hk : (lookup points k).testBit j = true
    · have hs : ∀ l ∈ ks, (lookup points l).testBit j = false := by
        intro l hl
        apply Bool.eq_false_iff.mpr
        intro hlt
        have he := hone k (by simp) l (List.mem_cons_of_mem _ hl) hk hlt
        exact hnr.1 (he ▸ hl)
      simp [collisionMask, Nat.testBit_or, Nat.testBit_and, hseen,
        collision_no_hits points ks j _ hs]
    · have hkf := Bool.eq_false_iff.mpr hk
      have hnew : (seen ||| lookup points k).testBit j = false := by
        simp [Nat.testBit_or, hseen, hkf]
      have hs : ∀ a ∈ ks, ∀ b ∈ ks, (lookup points a).testBit j = true →
          (lookup points b).testBit j = true → a = b := by
        intro a ha b hb
        exact hone a (List.mem_cons_of_mem _ ha) b (List.mem_cons_of_mem _ hb)
      simp [collisionMask, Nat.testBit_or, Nat.testBit_and, hseen, ih _ hnew hnr.2 hs]

lemma disjointMask_hit (points : Tree) (row target j : ℕ) (hj : j < 344)
    (htable : ∀ k ∈ pointList 6 row,
      (lookup points k).testBit j = target.testBit k)
    (hdis : row &&& target = 0) : (disjointMask points row).testBit j = true := by
  have hu : (unionMask points (pointList 6 row)).testBit j = false := by
    apply Bool.eq_false_iff.mpr
    intro h
    obtain ⟨k, hk, ht⟩ := (unionMask_bit points (pointList 6 row) j).mp h
    rw [htable k hk] at ht
    have hz := congrArg (fun n : ℕ => n.testBit k) hdis
    simp [Nat.testBit_and, pointList_mem 6 row hk, ht] at hz
  rw [disjointMask, Nat.testBit_xor, Nat.testBit_two_pow_sub_one]
  simp only [hj, decide_true, hu, Bool.xor_false]

lemma compatibleMask_hit (points : Tree) (row target j : ℕ) (hj : j < 344)
    (htable : ∀ k ∈ pointList 6 row,
      (lookup points k).testBit j = target.testBit k)
    (hthin : Thin (row &&& target)) : (compatibleMask points row).testBit j = true := by
  have hone : ∀ k ∈ pointList 6 row, ∀ l ∈ pointList 6 row,
      (lookup points k).testBit j = true → (lookup points l).testBit j = true → k = l := by
    intro k hk l hl hkj hlj
    rw [htable k hk] at hkj
    rw [htable l hl] at hlj
    exact thin_unique hthin
      (by simp [Nat.testBit_and, pointList_mem 6 row hk, hkj])
      (by simp [Nat.testBit_and, pointList_mem 6 row hl, hlj])
  have hc := collision_one_hit points (pointList 6 row) j 0 (by simp)
    (pointList_nodup 6 row) hone
  rw [compatibleMask, Nat.testBit_xor, Nat.testBit_two_pow_sub_one]
  simp only [hj, decide_true, hc, Bool.xor_false]

end PlaneGrid

namespace PlaneGrid

lemma scanCert_reject (fuel mask cert : ℕ) (f : ℕ → ℕ → Option ℕ)
    {i : ℕ} (hi : mask.testBit i = true) (hf : ∀ c, f i c = none) :
    scanCert fuel mask cert f = none := by
  induction fuel generalizing mask cert with
  | zero =>
    have hm : mask ≠ 0 := by intro hz; simp [hz] at hi
    simp [scanCert, hm]
  | succ fuel ih =>
    have hm : mask ≠ 0 := by intro hz; simp [hz] at hi
    by_cases hik : i = mask.log2
    · subst i
      simp [scanCert, hm, hf]
    · have hrem : (mask ^^^ (2^mask.log2)).testBit i = true := by
        have hh : ¬ mask.log2 = i := Ne.symm hik
        simp [Nat.testBit_xor, hh, hi]
      simp only [scanCert, hm, if_false]
      cases h : f mask.log2 cert with
      | none => rfl
      | some rest => exact ih _ _ hrem

end PlaneGrid

namespace PlaneGrid

def ICovers (rows : Tree) (B : Finset ℕ) (rem : ℕ) : Prop :=
  ∀ k, rem.testBit k = true ↔ ∃ i ∈ B, (lookup rows i).testBit k = true

def IApart (rows : Tree) (B : Finset ℕ) : Prop :=
  ∀ i ∈ B, ∀ j ∈ B, i ≠ j → lookup rows i &&& lookup rows j = 0

def ICompat (cr dr : Tree) (B D : Finset ℕ) : Prop :=
  ∀ i ∈ B, ∀ j ∈ D, Thin (lookup cr i &&& lookup dr j)

def RowBound (rows : Tree) : Prop := ∀ i < 344, lookup rows i < 2^60

def PointCorrect (rows points : Tree) : Prop :=
  ∀ i < 344, ∀ k < 60, (lookup points k).testBit i = (lookup rows i).testBit k

lemma icovers_erase {rows : Tree} {B : Finset ℕ} {rem i : ℕ}
    (hc : ICovers rows B rem) (hi : i ∈ B) (hd : IApart rows B) :
    ICovers rows (B.erase i) (rem ^^^ lookup rows i) := by
  intro k
  by_cases hik : (lookup rows i).testBit k = true
  · have hrk := (hc k).mpr ⟨i, hi, hik⟩
    have hh : ¬ ∃ j ∈ B.erase i, (lookup rows j).testBit k = true := by
      rintro ⟨j, hj, hjk⟩
      have he := hd i hi j (Finset.mem_of_mem_erase hj) (Ne.symm (Finset.ne_of_mem_erase hj))
      have ht := congrArg (fun z : ℕ => z.testBit k) he
      simp [Nat.testBit_and, hik, hjk] at ht
    constructor
    · intro h
      simp [Nat.testBit_xor, hik, hrk] at h
    · intro h
      exact (hh h).elim
  · have hif : (lookup rows i).testBit k = false := Bool.eq_false_iff.mpr hik
    simp only [Nat.testBit_xor, hif, Bool.xor_false]
    rw [hc k]
    constructor
    · rintro ⟨j, hj, hjk⟩
      have hji : j ≠ i := by rintro rfl; exact hik hjk
      exact ⟨j, Finset.mem_erase.mpr ⟨hji, hj⟩, hjk⟩
    · rintro ⟨j, hj, hjk⟩
      exact ⟨j, Finset.mem_of_mem_erase hj, hjk⟩

lemma pointList_lt {row : ℕ} (hr : row < 2^60) {k : ℕ} (hk : k ∈ pointList 6 row) : k < 60 := by
  have hbit := pointList_mem 6 row hk
  by_contra hn
  have hf := Nat.testBit_lt_two_pow (hr.trans_le
    (Nat.pow_le_pow_right (by decide : 0 < 2) (show 60 ≤ k by omega)))
  simp [hf] at hbit

lemma disjoint_candidate (rows points : Tree) (hb : RowBound rows) (hp : PointCorrect rows points)
    {i j : ℕ} (hi : i < 344) (hj : j < 344)
    (hd : lookup rows i &&& lookup rows j = 0) :
    (disjointMask points (lookup rows i)).testBit j = true :=
  disjointMask_hit points (lookup rows i) (lookup rows j) j hj
    (fun k hk => hp j hj k (pointList_lt (hb i hi) hk)) hd

lemma compatible_candidate (cr dr points : Tree) (hb : RowBound cr) (hp : PointCorrect dr points)
    {i j : ℕ} (hi : i < 344) (hj : j < 344)
    (hc : Thin (lookup cr i &&& lookup dr j)) :
    (compatibleMask points (lookup cr i)).testBit j = true :=
  compatibleMask_hit points (lookup cr i) (lookup dr j) j hj
    (fun k hk => hp j hj k (pointList_lt (hb i hi) hk)) hc

end PlaneGrid


/- Incidence data and exact matching completeness.
Original masks and legal-group encoding: @MrSeizy, reduction PR2033.
New proof: Hanan Beer (@hananzlt). -/
namespace PlaneGrid
def allowed (g : ℕ) : ℕ := (0xfffc3ef80fafa00f3bbfb03bed00eeaeefc0bef00bdbdcf43b5efe00e7db781eef77db7007715f55fdd75f5f003c3740d75d7ddf5d5c1dd01e7d77fa4b5ea76c0beee5fa2a83ababebbbaf00cccf3cf3f3f3f033333cf3cfcfcffc003cf3cf3f3f3ffffc0000fcfcfcfffffffff000000 >>> (60*g)) % 2^60
def incident (m : ℕ) : ℕ := (0x2a0220020808000842110800400080511000410004040c008802082020003080481000010200c440400410001003c000082080008003c020010008040003c104004040000003f000000202000000fc002000100000003f010100000000000ff000000000000000ff000000000000000ff >>> (60*m)) % 2^60
def Good (n : ℕ) : Prop := ∀ m : Fin 15, Thin (n &&& incident m.val)
instance (n : ℕ) : Decidable (Good n) :=
  inferInstanceAs (Decidable (∀ m : Fin 15,
    (n &&& incident m.val) &&& ((n &&& incident m.val) - 1) = 0))
def vertices (g : ℕ) : List ℕ := (List.range 15).filter fun m => allowed g &&& incident m ≠ 0
def edges (g m : ℕ) : List ℕ :=
  ((List.range 60).filter fun k => (allowed g &&& incident m).testBit k).map (2 ^ ·)
def matchings (g : ℕ) : List ℕ := fills incident (edges g) Good (vertices g) 0

def Legal (g : ℕ) (b : List ℕ) : Prop :=
  b.length = 6 ∧ b.Pairwise (· ≤ ·) ∧ b.foldr Nat.lor 0 = allowed g ∧ ∀ x ∈ b, Good x

lemma allowed_lt (g : ℕ) : allowed g < 2^60 := Nat.mod_lt _ (by decide)

lemma vertex_degree (g : Fin 15) (m : Fin 15) :
    allowed g.val &&& incident m.val = 0 ∨
    (bits 60 (allowed g.val &&& incident m.val)).card = 6 := by
  fin_cases g <;> revert m <;> decide +kernel

lemma point_covered (k : Fin 60) : ∃ m : Fin 15, (incident m.val).testBit k.val = true := by
  revert k
  decide +kernel

lemma legal_sub {g : ℕ} {b : List ℕ} (hb : Legal g b) {x : ℕ} (hx : x ∈ b) :
    Sub x (allowed g) := by
  intro k hk
  rw [← hb.2.2.1]
  exact (fold_bits b k).mpr ⟨x, hx, hk⟩

lemma legal_meets {g : Fin 15} {b : List ℕ} (hb : Legal g.val b) {x : ℕ} (hx : x ∈ b)
    {m : ℕ} (hm : m ∈ vertices g.val) : x &&& incident m ≠ 0 := by
  have hmem : m < 15 ∧ allowed g.val &&& incident m ≠ 0 := by
    simpa [vertices] using hm
  have hd := vertex_degree g ⟨m, hmem.1⟩
  have hc : (bits 60 (allowed g.val &&& incident m)).card = 6 := hd.resolve_left hmem.2
  have hne := block_meets (w := 60) (b := b) (allowed := allowed g.val)
    (incident := incident m) (by rw [hb.1, hc]) hb.2.2.1
    (fun y hy => hb.2.2.2 y hy ⟨m, hmem.1⟩) x hx
  intro hz
  rcases hne with ⟨k, hk⟩
  simp [mem_bits, hz] at hk

lemma legal_matching {g : Fin 15} {b : List ℕ} (hb : Legal g.val b) {x : ℕ}
    (hx : x ∈ b) : x ∈ matchings g.val := by
  have hsub := legal_sub hb hx
  have hgood : ∀ a, Sub a x → Good a := by
    intro a ha m
    exact thin_mono (sub_and ha _) (hb.2.2.2 x hx m)
  have he : ∀ m ∈ vertices g.val, ∃ e ∈ edges g.val m, Sub e x ∧ e &&& incident m ≠ 0 := by
    intro m hm
    have hm0 := legal_meets hb hx hm
    let k := (x &&& incident m).log2
    have hk : (x &&& incident m).testBit k = true := Nat.testBit_log2 (by omega)
    have hk' := hk
    rw [Nat.testBit_and, Bool.and_eq_true] at hk'
    have hka := hsub k hk'.1
    have hk60 : k < 60 := by
      by_contra hn
      have hf := Nat.testBit_lt_two_pow ((allowed_lt g.val).trans_le (Nat.pow_le_pow_right (by decide : 0 < 2) (show 60 ≤ k by omega)))
      simp [hf] at hka
    refine ⟨2^k, ?_, ?_, ?_⟩
    · apply List.mem_map.mpr
      exact ⟨k, by simp [List.mem_filter, hk60, Nat.testBit_and, hka, hk'.2], rfl⟩
    · intro j hj
      have hkj : k = j := by simpa [Nat.testBit_two_pow] using hj
      exact hkj ▸ hk'.1
    · intro hz
      have ht : ((2^k) &&& incident m).testBit k = true := by
        simp [Nat.testBit_and, hk'.2]
      simp [hz] at ht
  obtain ⟨z, hz, _, hzx, hhit⟩ := fills_complete incident (edges g.val) Good x hgood
    (vertices g.val) he 0 (sub_zero x)
  have hcov : ∀ k, x.testBit k = true → ∃ m ∈ vertices g.val, (incident m).testBit k = true := by
    intro k hk
    have hka := hsub k hk
    have hk60 : k < 60 := by
      by_contra hn
      have hf := Nat.testBit_lt_two_pow ((allowed_lt g.val).trans_le (Nat.pow_le_pow_right (by decide : 0 < 2) (show 60 ≤ k by omega)))
      simp [hf] at hka
    obtain ⟨m, hm⟩ := point_covered ⟨k, hk60⟩
    refine ⟨m.val, ?_, hm⟩
    simp only [vertices, List.mem_filter, List.mem_range, decide_eq_true_eq]
    refine ⟨m.isLt, ?_⟩
    intro hz
    have ht : (allowed g.val &&& incident m.val).testBit k = true := by
      simp [Nat.testBit_and, hka, hm]
    simp [hz] at ht
  have hthin : ∀ m ∈ vertices g.val, Thin (x &&& incident m) := by
    intro m hm
    have hm15 : m < 15 := (List.mem_range.mp (List.mem_of_mem_filter hm))
    exact hb.2.2.2 x hx ⟨m, hm15⟩
  have hzEq := matching_eq_of_sub incident (vertices g.val) hzx hthin hcov hhit
  exact hzEq ▸ hz

end PlaneGrid


/- Disjointness forced by sharp covering counts. Hanan Beer (@hananzlt). -/
namespace PlaneGrid
lemma pairwise_disjoint_of_cover {α β : Type*} [DecidableEq α] [DecidableEq β]
    (B : Finset β) (U : Finset α) (f : β → Finset α)
    (hcover : U ⊆ B.biUnion f) (hsize : B.card ≤ U.card)
    (hsmall : ∀ b ∈ B, (f b).card ≤ 1) :
    ∀ b ∈ B, ∀ c ∈ B, b ≠ c → Disjoint (f b) (f c) := by
  intro b hb c hc hbc
  apply Finset.disjoint_left.mpr
  intro a hab hac
  have hcov : U ⊆ (B.erase b).biUnion f := by
    intro z hz
    obtain ⟨d, hd, hzd⟩ := Finset.mem_biUnion.mp (hcover hz)
    by_cases hdb : d = b
    · subst d
      have hza : z = a := Finset.card_le_one.mp (hsmall b hb) z hzd a hab
      subst z
      exact Finset.mem_biUnion.mpr ⟨c, Finset.mem_erase.mpr ⟨Ne.symm hbc, hc⟩, hac⟩
    · exact Finset.mem_biUnion.mpr ⟨d, Finset.mem_erase.mpr ⟨hdb, hd⟩, hzd⟩
  have hsum : (∑ d ∈ B.erase b, (f d).card) ≤ (B.erase b).card := by
    calc
      _ ≤ ∑ d ∈ B.erase b, 1 := Finset.sum_le_sum fun d hd =>
        hsmall d (Finset.mem_of_mem_erase hd)
      _ = _ := by simp
  have hcard : U.card ≤ (B.erase b).card :=
    (Finset.card_le_card hcov).trans (Finset.card_biUnion_le.trans hsum)
  have he := Finset.card_erase_of_mem hb
  have hpos := Finset.card_pos.mpr ⟨b, hb⟩
  omega

lemma size_le_of_cover {α β : Type*} [DecidableEq α] [DecidableEq β]
    (B : Finset β) (U : Finset α) (f : β → Finset α)
    (hcover : U ⊆ B.biUnion f) (hsmall : ∀ b ∈ B, (f b).card ≤ 1) : U.card ≤ B.card := by
  calc
    _ ≤ (B.biUnion f).card := Finset.card_le_card hcover
    _ ≤ ∑ b ∈ B, (f b).card := Finset.card_biUnion_le
    _ ≤ ∑ b ∈ B, 1 := Finset.sum_le_sum fun b hb => hsmall b hb
    _ = _ := by simp

lemma blocks_disjoint {w : ℕ} {b : List ℕ} {allowed incident : ℕ}
    (hlen : b.length ≤ (bits w (allowed &&& incident)).card)
    (hcover : b.foldr Nat.lor 0 = allowed)
    (hthin : ∀ x ∈ b, Thin (x &&& incident)) :
    ∀ x ∈ b, ∀ y ∈ b, x ≠ y →
      Disjoint (bits w (x &&& incident)) (bits w (y &&& incident)) := by
  have hcov : bits w (allowed &&& incident) ⊆
      b.toFinset.biUnion (fun x => bits w (x &&& incident)) := by
    intro p hp
    have hbit := (mem_bits p).mp hp
    rw [Nat.testBit_and, Bool.and_eq_true] at hbit
    obtain ⟨x, hx, hpx⟩ := (fold_bits b p.val).mp (hcover.symm ▸ hbit.1)
    exact Finset.mem_biUnion.mpr ⟨x, List.mem_toFinset.mpr hx,
      (mem_bits p).mpr (by simp [Nat.testBit_and, hpx, hbit.2])⟩
  have hh := pairwise_disjoint_of_cover b.toFinset (bits w (allowed &&& incident))
    (fun x => bits w (x &&& incident)) hcov (b.toFinset_card_le.trans hlen)
    (fun x hx => thin_card (hthin x (List.mem_toFinset.mp hx)))
  exact fun x hx y hy hxy => hh x (List.mem_toFinset.mpr hx) y (List.mem_toFinset.mpr hy) hxy

lemma blocks_nodup {w : ℕ} {b : List ℕ} {allowed incident : ℕ}
    (hlen : b.length ≤ (bits w (allowed &&& incident)).card)
    (hcover : b.foldr Nat.lor 0 = allowed)
    (hthin : ∀ x ∈ b, Thin (x &&& incident)) : b.Nodup := by
  have hcov : bits w (allowed &&& incident) ⊆
      b.toFinset.biUnion (fun x => bits w (x &&& incident)) := by
    intro p hp
    have hbit := (mem_bits p).mp hp
    rw [Nat.testBit_and, Bool.and_eq_true] at hbit
    obtain ⟨x, hx, hpx⟩ := (fold_bits b p.val).mp (hcover.symm ▸ hbit.1)
    exact Finset.mem_biUnion.mpr ⟨x, List.mem_toFinset.mpr hx,
      (mem_bits p).mpr (by simp [Nat.testBit_and, hpx, hbit.2])⟩
  have hh := size_le_of_cover b.toFinset (bits w (allowed &&& incident))
    (fun x => bits w (x &&& incident)) hcov
    (fun x hx => thin_card (hthin x (List.mem_toFinset.mp hx)))
  apply (Multiset.toFinset_card_eq_card_iff_nodup (m := (b : Multiset ℕ))).mp
  exact Nat.le_antisymm b.toFinset_card_le (hlen.trans hh)

end PlaneGrid


/- Complete exact-cover enumeration. Hanan Beer (@hananzlt). -/
namespace PlaneGrid

def Apart (B : Finset ℕ) : Prop :=
  ∀ a ∈ B, ∀ b ∈ B, a ≠ b → a &&& b = 0

end PlaneGrid


/- Completeness of sorted legal groups. Hanan Beer (@hananzlt). -/
namespace PlaneGrid

lemma nonempty_vertex (g : Fin 15) : ∃ m : Fin 15, allowed g.val &&& incident m.val ≠ 0 := by
  revert g
  decide +kernel

lemma legal_nodup {g : Fin 15} {b : List ℕ} (hb : Legal g.val b) : b.Nodup := by
  obtain ⟨m, hm⟩ := nonempty_vertex g
  have hd := (vertex_degree g m).resolve_left hm
  exact blocks_nodup (w := 60) (b := b) (allowed := allowed g.val) (incident := incident m.val)
    (by rw [hb.1, hd]) hb.2.2.1 (fun x hx => hb.2.2.2 x hx m)

lemma legal_apart {g : Fin 15} {b : List ℕ} (hb : Legal g.val b) : Apart b.toFinset := by
  intro x hx y hy hxy
  have hx' := List.mem_toFinset.mp hx
  have hy' := List.mem_toFinset.mp hy
  apply Nat.eq_of_testBit_eq
  intro k
  rw [Nat.zero_testBit]
  apply Bool.eq_false_iff.mpr
  intro hk
  rw [Nat.testBit_and, Bool.and_eq_true] at hk
  have hka := legal_sub hb hx' k hk.1
  have hk60 : k < 60 := by
    by_contra hn
    have hf := Nat.testBit_lt_two_pow ((allowed_lt g.val).trans_le
      (Nat.pow_le_pow_right (by decide : 0 < 2) (show 60 ≤ k by omega)))
    simp [hf] at hka
  obtain ⟨m, hm⟩ := point_covered ⟨k, hk60⟩
  have hmn : allowed g.val &&& incident m.val ≠ 0 := by
    intro hz
    have ht : (allowed g.val &&& incident m.val).testBit k = true := by
      simp [Nat.testBit_and, hka, hm]
    simp [hz] at ht
  have hd := (vertex_degree g m).resolve_left hmn
  have hdis := blocks_disjoint (w := 60) (b := b) (allowed := allowed g.val)
    (incident := incident m.val) (by rw [hb.1, hd]) hb.2.2.1
    (fun z hz => hb.2.2.2 z hz m) x hx' y hy' hxy
  have hxbit : (⟨k, hk60⟩ : Fin 60) ∈ bits 60 (x &&& incident m.val) := by
    simp [mem_bits, Nat.testBit_and, hk.1, hm]
  have hybit : (⟨k, hk60⟩ : Fin 60) ∈ bits 60 (y &&& incident m.val) := by
    simp [mem_bits, Nat.testBit_and, hk.2, hm]
  exact Finset.disjoint_left.mp hdis hxbit hybit

end PlaneGrid

namespace PlaneGrid

def mapMask (p : Fin 60 ≃ Fin 60) (row : ℕ) : ℕ :=
  (((List.finRange 60).filter fun i => row.testBit i.val).map fun i => 2^(p i).val).foldr Nat.lor 0

lemma mapMask_bit (p : Fin 60 ≃ Fin 60) (row k : ℕ) :
    (mapMask p row).testBit k = true ↔
      ∃ i : Fin 60, row.testBit i.val = true ∧ (p i).val = k := by
  simp [mapMask, fold_bits, Nat.testBit_two_pow]

lemma mapMask_bit_fin (p : Fin 60 ≃ Fin 60) (row : ℕ) (k : Fin 60) :
    (mapMask p row).testBit k.val = row.testBit (p.symm k).val := by
  apply Bool.eq_iff_iff.mpr
  rw [mapMask_bit]
  constructor
  · rintro ⟨i, hi, he⟩
    have he' : p i = k := Fin.ext he
    have hi' : i = p.symm k := by simpa using congrArg p.symm he'
    exact hi' ▸ hi
  · intro h
    exact ⟨p.symm k, h, by simp⟩

lemma mapMask_lt (p : Fin 60 ≃ Fin 60) (row : ℕ) : mapMask p row < 2^60 := by
  have hle : mapMask p row ≤ 2^60-1 := by
    apply Nat.le_of_testBit
    intro k hk
    obtain ⟨i, _, he⟩ := (mapMask_bit p row k).mp hk
    have hlt : k < 60 := he ▸ (p i).isLt
    exact (Nat.testBit_two_pow_sub_one 60 k).trans (by simp only [hlt, decide_true])
  have hp : 0 < (2:ℕ)^60 := by decide
  omega

lemma high_bit_false {row k : ℕ} (hr : row < 2^60) (hk : 60 ≤ k) : row.testBit k = false :=
  Nat.testBit_lt_two_pow (hr.trans_le (Nat.pow_le_pow_right (by decide : 0 < 2) hk))

lemma mapMask_zero (p : Fin 60 ≃ Fin 60) : mapMask p 0 = 0 := by simp [mapMask]

lemma mapMask_and (p : Fin 60 ≃ Fin 60) (a b : ℕ) :
    mapMask p (a &&& b) = mapMask p a &&& mapMask p b := by
  apply Nat.eq_of_testBit_eq
  intro k
  by_cases hk : k < 60
  · simp only [Nat.testBit_and, mapMask_bit_fin p _ ⟨k, hk⟩]
  · have hle : 60 ≤ k := by omega
    simp [Nat.testBit_and, high_bit_false (mapMask_lt p _) hle]

lemma mapMask_or (p : Fin 60 ≃ Fin 60) (a b : ℕ) :
    mapMask p (a ||| b) = mapMask p a ||| mapMask p b := by
  apply Nat.eq_of_testBit_eq
  intro k
  by_cases hk : k < 60
  · simp only [Nat.testBit_or, mapMask_bit_fin p _ ⟨k, hk⟩]
  · have hle : 60 ≤ k := by omega
    simp [Nat.testBit_or, high_bit_false (mapMask_lt p _) hle]

lemma mapMask_inv (p : Fin 60 ≃ Fin 60) {row : ℕ} (hr : row < 2^60) :
    mapMask p.symm (mapMask p row) = row := by
  apply Nat.eq_of_testBit_eq
  intro k
  by_cases hk : k < 60
  · rw [mapMask_bit_fin p.symm _ ⟨k, hk⟩, mapMask_bit_fin p]
    simp
  · have hle : 60 ≤ k := by omega
    rw [high_bit_false (mapMask_lt p.symm _) hle, high_bit_false hr hle]

lemma mapMask_thin (p : Fin 60 ≃ Fin 60) {row : ℕ} (hr : Thin row) : Thin (mapMask p row) := by
  apply thin_of_unique
  intro k l hk hl
  obtain ⟨i, hi, hik⟩ := (mapMask_bit p row k).mp hk
  obtain ⟨j, hj, hjl⟩ := (mapMask_bit p row l).mp hl
  have hij : i = j := Fin.ext (thin_unique hr hi hj)
  subst j
  exact hik.symm.trans hjl

lemma mapMask_fold (p : Fin 60 ≃ Fin 60) (b : List ℕ) :
    mapMask p (b.foldr Nat.lor 0) = (b.map (mapMask p)).foldr Nat.lor 0 := by
  induction b with
  | nil => simp [mapMask_zero]
  | cons a b ih => simp [mapMask_or, ih]

lemma fold_or_perm {b c : List ℕ} (h : b.Perm c) : b.foldr Nat.lor 0 = c.foldr Nat.lor 0 := by
  apply Nat.eq_of_testBit_eq
  intro k
  apply Bool.eq_iff_iff.mpr
  rw [fold_bits, fold_bits]
  exact ⟨fun ⟨x, hx, hk⟩ => ⟨x, h.mem_iff.mp hx, hk⟩,
    fun ⟨x, hx, hk⟩ => ⟨x, h.mem_iff.mpr hx, hk⟩⟩

def groupMap (p : Fin 60 ≃ Fin 60) (b : List ℕ) : List ℕ :=
  (b.map (mapMask p)).mergeSort (· ≤ ·)

lemma mem_groupMap (p : Fin 60 ≃ Fin 60) (b : List ℕ) (x : ℕ) :
    x ∈ groupMap p b ↔ ∃ y ∈ b, mapMask p y = x := by simp [groupMap]

lemma groupMap_fold (p : Fin 60 ≃ Fin 60) (b : List ℕ) :
    (groupMap p b).foldr Nat.lor 0 = mapMask p (b.foldr Nat.lor 0) := by
  rw [mapMask_fold]
  exact fold_or_perm (List.mergeSort_perm _ _)

lemma groupMap_legal (p : Fin 60 ≃ Fin 60) {g h : ℕ}
    (hal : mapMask p (allowed g) = allowed h)
    (hinc : ∀ m : Fin 15, ∃ n : Fin 15, mapMask p (incident n.val) = incident m.val)
    {b : List ℕ} (hb : Legal g b) : Legal h (groupMap p b) := by
  refine ⟨by simpa [groupMap] using hb.1, List.pairwise_mergeSort' _ _, ?_, ?_⟩
  · rw [groupMap_fold, hb.2.2.1, hal]
  · intro x hx m
    obtain ⟨y, hy, rfl⟩ := (mem_groupMap p b x).mp hx
    obtain ⟨n, hn⟩ := hinc m
    rw [← hn, ← mapMask_and]
    exact mapMask_thin p (hb.2.2.2 y hy n)

lemma groupMap_compatible (p : Fin 60 ≃ Fin 60) {b c : List ℕ}
    (h : ∀ x ∈ b, ∀ y ∈ c, Thin (x &&& y)) :
    ∀ x ∈ groupMap p b, ∀ y ∈ groupMap p c, Thin (x &&& y) := by
  intro x hx y hy
  obtain ⟨a, ha, rfl⟩ := (mem_groupMap p b x).mp hx
  obtain ⟨d, hd, rfl⟩ := (mem_groupMap p c y).mp hy
  rw [← mapMask_and]
  exact mapMask_thin p (h a ha d hd)

lemma groupMap_inv (p : Fin 60 ≃ Fin 60) {b : List ℕ}
    (hs : b.Pairwise (· ≤ ·)) (hb : ∀ x ∈ b, x < 2^60) :
    groupMap p.symm (groupMap p b) = b := by
  have hmap : (b.map (mapMask p)).map (mapMask p.symm) = b := by
    rw [List.map_map]
    simpa only [List.map_id, Function.comp_def] using
      (List.map_congr_left (fun x hx => mapMask_inv p (hb x hx)) :
        b.map (fun x => mapMask p.symm (mapMask p x)) = b.map id)
  have hp : (groupMap p.symm (groupMap p b)).Perm b := by
    have h1 := List.mergeSort_perm ((groupMap p b).map (mapMask p.symm)) (· ≤ ·)
    have h2 := (List.mergeSort_perm (b.map (mapMask p)) (· ≤ ·)).map (mapMask p.symm)
    rw [hmap] at h2
    exact h1.trans h2
  exact hp.eq_of_pairwise' (List.pairwise_mergeSort' _ _) hs

end PlaneGrid

