def checkCompact (i : ℕ) : Bool :=
 if i ∈ goodRep then true else
 let code := lookup compactCertData i
 let b := rep i
 let g := if code % 4 = 0 then 9 else if code % 4 = 1 then 10 else 11
 let h := if code % 4 = 0 then 14 else if code % 4 = 1 then 13 else 12
 let cr := if code % 4 = 0 then rows9 else if code % 4 = 1 then rows10 else rows11
 let cp := if code % 4 = 0 then points9 else if code % 4 = 1 then points10 else points11
 let dr := if code % 4 = 0 then rows14 else if code % 4 = 1 then rows13 else rows12
 let dp := if code % 4 = 0 then points14 else if code % 4 = 1 then points13 else points12
 (rejectCompact cr cp dr dp (hintTree (code%4)) 13 (allowed g) (allowed h)
   (initialCandidates cp b) (initialCandidates dp b) (code/4)).isSome
end PlaneGrid

