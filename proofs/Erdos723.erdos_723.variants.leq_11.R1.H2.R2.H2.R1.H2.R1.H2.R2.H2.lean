def positiveCoords : Finset (List ℕ) := (positiveCodes.map (unpack 6)).toFinset

theorem positive_bounds : ∀ c ∈ positiveCoords, ∀ i ∈ c, i < 344 := by decide +kernel

theorem positive_closed : ∀ g : Fin 5, ∀ c ∈ positiveCoords,
    (c.map (generatorIndex g.val)).insertionSort (· ≤ ·) ∈ positiveCoords := by decide +kernel

theorem positive_good : ∀ n ∈ goodRep, rep n ∈ positiveCoords := by decide +kernel

def computedGroup (c : List ℕ) : List ℕ := (c.map (lookup rows0)).insertionSort (· ≤ ·)
def positiveGroups : Finset (List ℕ) := positiveCoords.image computedGroup

lemma coordinateGroup_eq_computed (c : List ℕ) : coordinateGroup c = computedGroup c :=
  List.mergeSort_eq_insertionSort _ _

lemma positiveGroups_mem {b : List ℕ} : b ∈ positiveGroups ↔ ∃ c ∈ positiveCoords, coordinateGroup c = b := by
  simp only [positiveGroups, Finset.mem_image, coordinateGroup_eq_computed]

lemma positive_closed_all (g : ℕ) {c : List ℕ} (hc : c ∈ positiveCoords) :
    (c.map (generatorIndex g)).insertionSort (· ≤ ·) ∈ positiveCoords := by
  by_cases hg : g < 4
  · exact positive_closed ⟨g, by omega⟩ c hc
  · have he : generatorIndex g = generatorIndex 4 := by
      funext i
      simp [generatorIndex, show g ≠ 0 by omega, show g ≠ 1 by omega,
        show g ≠ 2 by omega, show g ≠ 3 by omega]
    rw [he]
    exact positive_closed ⟨4, by decide⟩ c hc

lemma positiveGroups_closed (g : ℕ) (b : List ℕ) (hb : b ∈ positiveGroups) :
    groupMap (generatorPerm g) b ∈ positiveGroups := by
  obtain ⟨c, hc, rfl⟩ := positiveGroups_mem.mp hb
  apply positiveGroups_mem.mpr
  refine ⟨(c.map (generatorIndex g)).insertionSort (· ≤ ·), positive_closed_all g hc, ?_⟩
  rw [coordinateGroup_sort, coordinateGroup_generator g (positive_bounds c hc)]

end PlaneGrid

