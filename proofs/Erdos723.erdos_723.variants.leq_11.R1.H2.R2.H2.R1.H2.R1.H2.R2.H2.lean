theorem genBound0 : ∀ i : Fin 344, generatorIndex 0 i.val < 344 := by decide +kernel
theorem genMask0 : ∀ i : Fin 344, lookup rows0 (generatorIndex 0 i.val) = mapMask perm0 (lookup rows0 i.val) := by decide +kernel
theorem genBound1 : ∀ i : Fin 344, generatorIndex 1 i.val < 344 := by decide +kernel
theorem genMask1 : ∀ i : Fin 344, lookup rows0 (generatorIndex 1 i.val) = mapMask perm1 (lookup rows0 i.val) := by decide +kernel
theorem genBound2 : ∀ i : Fin 344, generatorIndex 2 i.val < 344 := by decide +kernel
theorem genMask2 : ∀ i : Fin 344, lookup rows0 (generatorIndex 2 i.val) = mapMask perm2 (lookup rows0 i.val) := by decide +kernel
theorem genBound3 : ∀ i : Fin 344, generatorIndex 3 i.val < 344 := by decide +kernel
theorem genMask3 : ∀ i : Fin 344, lookup rows0 (generatorIndex 3 i.val) = mapMask perm3 (lookup rows0 i.val) := by decide +kernel
theorem genBound4 : ∀ i : Fin 344, generatorIndex 4 i.val < 344 := by decide +kernel
theorem genMask4 : ∀ i : Fin 344, lookup rows0 (generatorIndex 4 i.val) = mapMask perm4 (lookup rows0 i.val) := by decide +kernel
end PlaneGrid

namespace PlaneGrid

def generatorPerm (g : ℕ) : Fin 60 ≃ Fin 60 :=
 if g = 0 then perm0 else if g = 1 then perm1 else if g = 2 then perm2 else if g = 3 then perm3 else perm4

lemma generatorPerm_symm (g : ℕ) : (generatorPerm g).symm = generatorPerm g := by
  unfold generatorPerm
  split <;> try rfl
  split <;> try rfl
  split <;> try rfl
  split <;> rfl

lemma generatorIndex_bound (g i : ℕ) (hi : i < 344) : generatorIndex g i < 344 := by
  by_cases h0 : g = 0
  · subst g; exact genBound0 ⟨i, hi⟩
  by_cases h1 : g = 1
  · subst g; exact genBound1 ⟨i, hi⟩
  by_cases h2 : g = 2
  · subst g; exact genBound2 ⟨i, hi⟩
  by_cases h3 : g = 3
  · subst g; exact genBound3 ⟨i, hi⟩
  simpa [generatorIndex, h0, h1, h2, h3] using genBound4 ⟨i, hi⟩

lemma generatorIndex_mask (g i : ℕ) (hi : i < 344) :
    lookup rows0 (generatorIndex g i) = mapMask (generatorPerm g) (lookup rows0 i) := by
  by_cases h0 : g = 0
  · subst g; simpa [generatorPerm] using genMask0 ⟨i, hi⟩
  by_cases h1 : g = 1
  · subst g; simpa [generatorPerm] using genMask1 ⟨i, hi⟩
  by_cases h2 : g = 2
  · subst g; simpa [generatorPerm] using genMask2 ⟨i, hi⟩
  by_cases h3 : g = 3
  · subst g; simpa [generatorPerm] using genMask3 ⟨i, hi⟩
  simpa [generatorIndex, generatorPerm, h0, h1, h2, h3] using genMask4 ⟨i, hi⟩

lemma generator_viable (g : ℕ) {b : List ℕ} (hb : Viable 0 b) : Viable 0 (groupMap (generatorPerm g) b) := by
  by_cases h0 : g = 0
  · subst g; simpa [generatorPerm] using viable_generator0 hb
  by_cases h1 : g = 1
  · subst g; simpa [generatorPerm] using viable_generator1 hb
  by_cases h2 : g = 2
  · subst g; simpa [generatorPerm] using viable_generator2 hb
  by_cases h3 : g = 3
  · subst g; simpa [generatorPerm] using viable_generator3 hb
  simpa [generatorPerm, h0, h1, h2, h3] using viable_generator4 hb

lemma coordinateGroup_perm {b c : List ℕ} (h : b.Perm c) : coordinateGroup b = coordinateGroup c := by
  have hp : (coordinateGroup b).Perm (coordinateGroup c) :=
    (List.mergeSort_perm _ _).trans ((h.map (lookup rows0)).trans (List.mergeSort_perm _ _).symm)
  exact hp.eq_of_pairwise' (List.pairwise_mergeSort' _ _) (List.pairwise_mergeSort' _ _)

lemma coordinateGroup_sort (b : List ℕ) : coordinateGroup (b.insertionSort (· ≤ ·)) = coordinateGroup b :=
  coordinateGroup_perm (List.perm_insertionSort _ _)

lemma coordinateGroup_bound {b : List ℕ} (hb : ∀ i ∈ b, i < 344) :
    ∀ x ∈ coordinateGroup b, x < 2^60 := by
  intro x hx
  obtain ⟨i, hi, rfl⟩ := List.mem_map.mp (List.mem_mergeSort.mp hx)
  exact row_bound0 i (hb i hi)

lemma coordinateGroup_generator (g : ℕ) {b : List ℕ} (hb : ∀ i ∈ b, i < 344) :
    coordinateGroup (b.map (generatorIndex g)) = groupMap (generatorPerm g) (coordinateGroup b) := by
  have he : (b.map (generatorIndex g)).map (lookup rows0) =
      (b.map (lookup rows0)).map (mapMask (generatorPerm g)) := by
    simp only [List.map_map]
    exact List.map_congr_left (fun i hi => generatorIndex_mask g i (hb i hi))
  have hp := (List.mergeSort_perm (b.map (lookup rows0)) (· ≤ ·)).map (mapMask (generatorPerm g))
  unfold coordinateGroup groupMap
  rw [he]
  exact ((List.mergeSort_perm _ _).trans (hp.symm.trans (List.mergeSort_perm _ _).symm)).eq_of_pairwise'
    (List.pairwise_mergeSort' _ _) (List.pairwise_mergeSort' _ _)

lemma normalizeWord_bound (fuel w : ℕ) {b : List ℕ} (hb : ∀ i ∈ b, i < 344) :
    ∀ i ∈ normalizeWord fuel w b, i < 344 := by
  induction fuel generalizing w b with
  | zero => simpa only [normalizeWord, List.mem_insertionSort] using hb
  | succ fuel ih =>
    simp only [normalizeWord]
    split
    · simpa only [List.mem_insertionSort] using hb
    · apply ih
      intro i hi
      obtain ⟨j, hj, rfl⟩ := List.mem_map.mp hi
      exact generatorIndex_bound _ _ (hb j hj)

lemma normalizeWord_length (fuel w : ℕ) (b : List ℕ) : (normalizeWord fuel w b).length = b.length := by
  induction fuel generalizing w b with
  | zero => simp [normalizeWord]
  | succ fuel ih => simp only [normalizeWord]; split <;> simp [ih]

lemma normalizeWord_viable (fuel w : ℕ) {b : List ℕ} (hb : ∀ i ∈ b, i < 344)
    (hv : Viable 0 (coordinateGroup b)) : Viable 0 (coordinateGroup (normalizeWord fuel w b)) := by
  induction fuel generalizing w b with
  | zero => simpa only [normalizeWord, coordinateGroup_sort] using hv
  | succ fuel ih =>
    simp only [normalizeWord]
    split
    · simpa only [coordinateGroup_sort] using hv
    · apply ih
      · intro i hi
        obtain ⟨j, hj, rfl⟩ := List.mem_map.mp hi
        exact generatorIndex_bound _ _ (hb j hj)
      · rw [coordinateGroup_generator _ hb]
        exact generator_viable _ hv

lemma normalizeWord_back (P : List ℕ → Prop)
    (hP : ∀ g b, P b → P (groupMap (generatorPerm g) b))
    (fuel w : ℕ) {b : List ℕ} (hb : ∀ i ∈ b, i < 344)
    (hn : P (coordinateGroup (normalizeWord fuel w b))) : P (coordinateGroup b) := by
  induction fuel generalizing w b with
  | zero => simpa only [normalizeWord, coordinateGroup_sort] using hn
  | succ fuel ih =>
    simp only [normalizeWord] at hn
    split at hn
    · simpa only [coordinateGroup_sort] using hn
    · have hm : ∀ i ∈ b.map (generatorIndex (w%8-1)), i < 344 := by
        intro i hi
        obtain ⟨j, hj, rfl⟩ := List.mem_map.mp hi
        exact generatorIndex_bound _ _ (hb j hj)
      have hh := ih _ hm hn
      rw [coordinateGroup_generator _ hb] at hh
      have hh' := hP (w%8-1) _ hh
      have hinv := groupMap_inv (generatorPerm (w%8-1)) (List.pairwise_mergeSort' (· ≤ ·) (b.map (lookup rows0)))
        (coordinateGroup_bound hb)
      rw [generatorPerm_symm] at hinv
      exact (congrArg P hinv).mp hh'

