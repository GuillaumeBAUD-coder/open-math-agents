lemma unpack_pack (b : List ℕ) (hb : ∀ i ∈ b, i < 512) :
    unpack b.length (packCoordinates b) = b := by
  induction b with
  | nil => rfl
  | cons i b ih =>
    have hi : i < 512 := hb i (by simp)
    have ht : ∀ j ∈ b, j < 512 := fun j hj => hb j (by simp [hj])
    simp only [List.length_cons, packCoordinates, unpack]
    rw [Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt hi, Nat.add_mul_div_left _ _ (by decide)]
    simp only [Nat.div_eq_of_lt hi, zero_add]
    rw [ih ht]

def LeafGood (b : List ℕ) : Prop := b.length = 6 →
  (∀ i ∈ b, i < 344) → Viable 0 (coordinateGroup b) → coordinateGroup b ∈ positiveGroups

lemma normalized_rep (b : List ℕ) (hint : ℕ) (hl : b.length = 6)
    (hb : ∀ i ∈ b, i < 344) (hcheck : normalizedCheck b hint = true) :
    ∃ n, n < 1021 ∧ rep n = normalizeWord 6 (lookup wordData hint) b := by
  simp only [normalizedCheck, Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at hcheck
  refine ⟨_, hcheck.1, ?_⟩
  unfold rep
  rw [hcheck.2]
  have hnlen : (normalizeWord 6 (lookup wordData hint) b).length = 6 :=
    (normalizeWord_length _ _ _).trans hl
  have hh := unpack_pack (normalizeWord 6 (lookup wordData hint) b)
    (fun i hi => (normalizeWord_bound _ _ hb i hi).trans (by decide))
  simpa only [hnlen] using hh

lemma normalized_good (b : List ℕ) (hint : ℕ) (hcheck : normalizedCheck b hint = true) : LeafGood b := by
  intro hl hb hv
  obtain ⟨n, hn, he⟩ := normalized_rep b hint hl hb hcheck
  have hv' := normalizeWord_viable 6 (lookup wordData hint) hb hv
  rw [← he] at hv'
  have hg := compact_viable_good ⟨n, hn⟩ (all_compact_checked ⟨n, hn⟩) hv'
  have hpos : coordinateGroup (normalizeWord 6 (lookup wordData hint) b) ∈ positiveGroups := by
    rw [← he]
    exact positiveGroups_mem.mpr ⟨rep n, positive_good n hg, rfl⟩
  exact normalizeWord_back (fun c => c ∈ positiveGroups) positiveGroups_closed _ _ hb hpos

lemma leafGood_perm (b c : List ℕ) (hp : b.Perm c) (hb : LeafGood b) : LeafGood c := by
  intro hl hc hv
  have he := coordinateGroup_perm hp
  rw [← he] at hv ⊢
  apply hb (hp.length_eq.trans hl)
  · intro i hi
    exact hc i (hp.mem_iff.mp hi)
  · exact hv

end PlaneGrid

