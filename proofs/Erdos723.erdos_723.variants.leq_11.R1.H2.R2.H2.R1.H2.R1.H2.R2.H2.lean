def directCheck (b : List ℕ) (hint : ℕ) : Bool :=
 if hint < 48 then
   let code := packCoordinates ((b.map (autoIndex hint)).insertionSort (· ≤ ·))
   let i := seekRep code repSearch
   decide (i < 1021) && (lookup repData i == code)
 else false
