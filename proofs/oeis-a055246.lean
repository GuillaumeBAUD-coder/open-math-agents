import OMAStatements.S_oeis_a055246
import Mathlib

/-!
# A055246: the Cantor construction's left endpoints

`a n = 1 + 6 * (n - 1 written in binary, read in base 3)`.  Writing `c m` for that base-3
value, the binary recursions `c (2m) = 3 c m` and `c (2m+1) = 3 c m + 1` give

* `a (2m+1) = 3 * a (m+1) - 2`,
* `a (2m+2) = 3 * a (m+1) + 4`,

which are exactly the two generating rules of `Gen`, and `a 1 = 1`.
-/

namespace OMA

open OMA.S_oeis_a055246

/-- `m` written in binary and read in base 3. -/
private def c (m : ℕ) : ℕ := Nat.ofDigits 3 (Nat.digits 2 m)

private lemma c_zero : c 0 = 0 := by
  simp [c, Nat.digits_zero]

private lemma c_two_mul (m : ℕ) : c (2 * m) = 3 * c m := by
  rcases m with _ | m
  · simp [c, Nat.digits_zero]
  · simp only [c]
    have hpos : 0 < 2 * (m + 1) := by omega
    rw [Nat.digits_of_two_le_of_pos (b := 2) (by norm_num) hpos]
    have h1 : (2 * (m + 1)) % 2 = 0 := by omega
    have h2 : (2 * (m + 1)) / 2 = m + 1 := by omega
    rw [h1, h2, Nat.ofDigits_cons]
    ring

private lemma c_two_mul_add_one (m : ℕ) : c (2 * m + 1) = 3 * c m + 1 := by
  simp only [c]
  have hpos : 0 < 2 * m + 1 := by omega
  rw [Nat.digits_of_two_le_of_pos (b := 2) (by norm_num) hpos]
  have h1 : (2 * m + 1) % 2 = 1 := by omega
  have h2 : (2 * m + 1) / 2 = m := by omega
  rw [h1, h2, Nat.ofDigits_cons]
  ring

private lemma a_succ (k : ℕ) : a (k + 1) = 6 * c k + 1 := by
  simp [a, c]

/-- `a (2m+1)` is the `3x-2` image of `a (m+1)`. -/
private lemma step_odd (m : ℕ) : a (2 * m + 1) = 3 * a (m + 1) - 2 := by
  rw [a_succ (2 * m), c_two_mul m, a_succ m]
  omega

/-- `a (2m+2)` is the `3x+4` image of `a (m+1)`. -/
private lemma step_even (m : ℕ) : a (2 * m + 2) = 3 * a (m + 1) + 4 := by
  have h : 2 * m + 2 = (2 * m + 1) + 1 := by omega
  rw [h, a_succ (2 * m + 1), c_two_mul_add_one m, a_succ m]
  omega

private lemma a_one : a 1 = 1 := by
  rw [a_succ 0, c_zero]

/-- Every term of the sequence is generated by `1` under `x ↦ 3x-2` and `x ↦ 3x+4`. -/
private lemma gen_a : ∀ n : ℕ, 1 ≤ n → Gen (a n) := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    intro hn
    rcases Nat.eq_or_lt_of_le hn with h1 | hgt
    · rw [← h1, a_one]
      exact Gen.one
    · rcases Nat.even_or_odd n with ⟨j, hj⟩ | ⟨j, hj⟩
      · have hj1 : 1 ≤ j := by omega
        have hlt : j < n := by omega
        have hstep : a n = 3 * a j + 4 := by
          have hk : n = 2 * (j - 1) + 2 := by omega
          rw [hk, step_even (j - 1), show j - 1 + 1 = j from by omega]
        rw [hstep]
        exact Gen.g (a j) (ih j hlt hj1)
      · have hj1 : 1 ≤ j := by omega
        have hlt : j + 1 < n := by omega
        have hstep : a n = 3 * a (j + 1) - 2 := by
          have hk : n = 2 * j + 1 := by omega
          rw [hk, step_odd j]
        rw [hstep]
        exact Gen.f (a (j + 1)) (ih (j + 1) hlt (by omega))

/-- Conversely every generated number is a term of the sequence. -/
private lemma a_gen : ∀ x : ℕ, Gen x → ∃ n, 1 ≤ n ∧ a n = x := by
  intro x hx
  induction hx with
  | one => exact ⟨1, by norm_num, a_one⟩
  | f x _ ih =>
      obtain ⟨n, hn, hnx⟩ := ih
      refine ⟨2 * (n - 1) + 1, by omega, ?_⟩
      rw [step_odd (n - 1), show n - 1 + 1 = n from by omega, hnx]
  | g x _ ih =>
      obtain ⟨n, hn, hnx⟩ := ih
      refine ⟨2 * (n - 1) + 2, by omega, ?_⟩
      rw [step_even (n - 1), show n - 1 + 1 = n from by omega, hnx]

private theorem key : {x : ℕ | ∃ n, 1 ≤ n ∧ a n = x} = {x : ℕ | Gen x} := by
  ext x
  simp only [Set.mem_setOf_eq]
  constructor
  · rintro ⟨n, hn, rfl⟩
    exact gen_a n hn
  · intro hx
    exact a_gen x hx

end OMA

theorem OMA.solution : type_of% @OMA.S_oeis_a055246.main := OMA.key
