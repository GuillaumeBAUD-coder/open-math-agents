lemma center5 (r : Fin 97 → Bool) (hr : r (Fin.ofNat 97 43) = true)
    (hb : ∀ i : Fin 97, 43 < i.val → i.val < 53 → r i = false) : Mono r := by
  by_contra hn
  apply node7 (Red r) (noTriple_of_not_mono hn) (all_hit hn)
  · intro x hx
    have he : x = 43 := by simpa using hx
    exact he ▸ ⟨by decide, hr⟩
  · intro x hx
    obtain ⟨h114,hred⟩ := hx
    have hbound : x ≤ 43 ∨ 53 ≤ x := by
      by_contra! bad
      have hblue := hb ⟨x,h114⟩ bad.1 bad.2
      have he : (Fin.ofNat 97 x) = ⟨x,h114⟩ := Fin.ext (Nat.mod_eq_of_lt h114)
      exact Bool.noConfusion (hred.symm.trans ((congrArg r he).trans hblue))
    have hbits : ∀ t : Fin 97, t.val ≤ 43 ∨ 53 ≤ t.val →
        Nat.testBit 0x1ffffffffffe00fffffffffff t.val = true := by decide +kernel
    exact hbits ⟨x,h114⟩ hbound

