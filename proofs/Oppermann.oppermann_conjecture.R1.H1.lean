theorem OMA.solution : OMA.R_Oppermann_oppermann_conjecture_R1.H1 := by
  show ∀ x : ℕ, 2 ≤ x → x ≤ 1000 →
    (∃ p ∈ Finset.Ioo (x * (x - 1)) (x ^ 2), p.Prime) ∧
    (∃ p ∈ Finset.Ioo (x ^ 2) (x * (x + 1)), p.Prime)
  intro x hn hle
  have hok : okO x = true := by
    by_cases h0 : x < 102
    · exact chunk_sound c0 hn h0
    by_cases h1 : x < 202
    · exact chunk_sound c1 (by omega) h1
    by_cases h2 : x < 302
    · exact chunk_sound c2 (by omega) h2
    by_cases h3 : x < 402
    · exact chunk_sound c3 (by omega) h3
    by_cases h4 : x < 502
    · exact chunk_sound c4 (by omega) h4
    by_cases h5 : x < 602
    · exact chunk_sound c5 (by omega) h5
    by_cases h6 : x < 702
    · exact chunk_sound c6 (by omega) h6
    by_cases h7 : x < 802
