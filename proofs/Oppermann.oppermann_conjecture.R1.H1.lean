private def checkList1 (x : ℕ) : List ℕ → Bool
  | [] => true
  | p :: ps => decide (x * (x - 1) < p ∧ p < x * x) && isPrimeBool p && checkList1 (x + 1) ps

private def checkList2 (x : ℕ) : List ℕ → Bool
  | [] => true
  | p :: ps => decide (x * x < p ∧ p < x * (x + 1)) && isPrimeBool p && checkList2 (x + 1) ps

private lemma checkList1_sound : ∀ (l : List ℕ) (x : ℕ), checkList1 x l = true →
    ∀ i : ℕ, i < l.length →
      let p := l.getD i 0
      (x + i) * (x + i - 1) < p ∧ p < (x + i) ^ 2 ∧ p.Prime := by
  intro l
  induction l with
  | nil => intro _ _ i hi; simp at hi
  | cons p ps ih =>
    intro x hok i hi
    unfold checkList1 at hok
    rw [Bool.and_eq_true, Bool.and_eq_true, decide_eq_true_eq] at hok
    cases i with
    | zero =>
      simp only [List.getD_cons_zero, add_zero]
      exact ⟨hok.1.1.1, by rw [sq]; exact hok.1.1.2, isPrimeBool_sound hok.1.2⟩
    | succ j =>
      simp only [List.getD_cons_succ, List.length_cons] at hi ⊢
      have hres := ih (x + 1) hok.2 j (by omega)
      have heq : x + 1 + j = x + (j + 1) := by omega
      rwa [heq] at hres

private lemma checkList2_sound : ∀ (l : List ℕ) (x : ℕ), checkList2 x l = true →
    ∀ i : ℕ, i < l.length →
      let p := l.getD i 0
      (x + i) ^ 2 < p ∧ p < (x + i) * (x + i + 1) ∧ p.Prime := by
  intro l
  induction l with
  | nil => intro _ _ i hi; simp at hi
  | cons p ps ih =>
    intro x hok i hi
    unfold checkList2 at hok
    rw [Bool.and_eq_true, Bool.and_eq_true, decide_eq_true_eq] at hok
    cases i with
    | zero =>
      simp only [List.getD_cons_zero, add_zero]
      exact ⟨by rw [sq]; exact hok.1.1.1, hok.1.1.2, isPrimeBool_sound hok.1.2⟩
    | succ j =>
      simp only [List.getD_cons_succ, List.length_cons] at hi ⊢
      have hres := ih (x + 1) hok.2 j (by omega)
      have heq : x + 1 + j = x + (j + 1) := by omega
      rwa [heq] at hres

private lemma witnesses1_len : witnesses1.length = 999 := by decide +kernel
private lemma witnesses2_len : witnesses2.length = 999 := by decide +kernel
private lemma witnesses1_ok : checkList1 2 witnesses1 = true := by decide +kernel
private lemma witnesses2_ok : checkList2 2 witnesses2 = true := by decide +kernel

end OppermannR1H1Proof

theorem OMA.solution : OMA.R_Oppermann_oppermann_conjecture_R1.H1 := by
  intro x h1 h2
  have hlt1 : x - 2 < OppermannR1H1Proof.witnesses1.length := by
    rw [OppermannR1H1Proof.witnesses1_len]; omega
  have hlt2 : x - 2 < OppermannR1H1Proof.witnesses2.length := by
    rw [OppermannR1H1Proof.witnesses2_len]; omega
  have ha := OppermannR1H1Proof.checkList1_sound OppermannR1H1Proof.witnesses1 2
    OppermannR1H1Proof.witnesses1_ok (x - 2) hlt1
  have hb := OppermannR1H1Proof.checkList2_sound OppermannR1H1Proof.witnesses2 2
    OppermannR1H1Proof.witnesses2_ok (x - 2) hlt2
  have hne : 2 + (x - 2) = x := by omega
  rw [hne] at ha hb
  exact ⟨⟨OppermannR1H1Proof.witnesses1.getD (x - 2) 0, Finset.mem_Ioo.mpr ⟨ha.1, ha.2.1⟩, ha.2.2⟩,
    ⟨OppermannR1H1Proof.witnesses2.getD (x - 2) 0, Finset.mem_Ioo.mpr ⟨hb.1, hb.2.1⟩, hb.2.2⟩⟩
