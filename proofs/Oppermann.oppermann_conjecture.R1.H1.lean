def okO (x : ℕ) : Bool :=
  isP (x + 2) (WA.getD (x - 2) 0) && x * (x - 1) < WA.getD (x - 2) 0 && WA.getD (x - 2) 0 < x ^ 2 &&
  (isP (x + 2) (WB.getD (x - 2) 0) && x ^ 2 < WB.getD (x - 2) 0 && WB.getD (x - 2) 0 < x * (x + 1))

def chunk (a b : ℕ) : Bool := (List.range (b - a)).all fun i => okO (a + i)

theorem chunk_sound {a b n : ℕ} (h : chunk a b = true) (h1 : a ≤ n) (h2 : n < b) : okO n = true := by
  have := List.all_eq_true.mp h (n - a) (List.mem_range.mpr (by omega))
  simpa [show a + (n - a) = n by omega] using this

