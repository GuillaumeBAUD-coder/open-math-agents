    · exact chunk_sound c8 (by omega) h8
    exact chunk_sound c9 (by omega) (by omega)
  simp only [okO, Bool.and_eq_true, decide_eq_true_eq] at hok
  obtain ⟨⟨⟨h1, h2⟩, h3⟩, ⟨h4, h5⟩, h6⟩ := hok
  exact ⟨⟨_, Finset.mem_Ioo.mpr ⟨h2, h3⟩, isP_prime h1 (by nlinarith)⟩,
    ⟨_, Finset.mem_Ioo.mpr ⟨h5, h6⟩, isP_prime h4 (by nlinarith)⟩⟩
