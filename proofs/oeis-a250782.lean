theorem V_step : ∀ m : Fin 14, ∀ i : Fin N, ((adjL i).map (V m.val)).sum = V (m.val + 1) i := by
  decide +kernel

theorem cnt_eq_V (m : ℕ) (hm : m ≤ 14) (i : Fin N) : cnt R' m i = V m i := by
  induction m generalizing i with
  | zero => rw [V_zero]; rfl
  | succ m ih =>
    show (∑ t, if R' i t then cnt R' m t else 0) = _
    rw [sum_adj R' adjL adj_iff adj_nodup]
    have := V_step ⟨m, by omega⟩ i
    simp only at this
    rw [← this]
    congr 1
    apply List.map_congr_left
    intro t _
    exact ih (by omega) t

