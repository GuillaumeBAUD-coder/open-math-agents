theorem vec_base : ∀ i : Fin N, (∑ k ∈ Finset.range 14, qp k * V (1 + k) i) =
    ∑ k ∈ Finset.range 14, qn k * V (1 + k) i := by decide +kernel

theorem vec_rec (n : ℕ) (hn : 1 ≤ n) : ∀ i : Fin N,
    (∑ k ∈ Finset.range 14, qp k * cnt R' (n + k) i) =
      ∑ k ∈ Finset.range 14, qn k * cnt R' (n + k) i := by
  induction n, hn using Nat.le_induction with
  | base =>
    intro i
    have h : ∀ w : ℕ → ℕ, (∑ k ∈ Finset.range 14, w k * cnt R' (1 + k) i) =
        ∑ k ∈ Finset.range 14, w k * V (1 + k) i := by
      intro w
      apply Finset.sum_congr rfl
      intro k hk
      rw [Finset.mem_range] at hk
      rw [cnt_eq_V (1 + k) (by omega)]
    rw [h, h]
    exact vec_base i
  | succ n hn ih =>
    intro i
    rw [lin_step, lin_step]
    apply Finset.sum_congr rfl
    intro t _
    rw [ih t]

def Tot (n : ℕ) : ℕ := ∑ i, cnt R' n i

def c (k : ℕ) : ℚ := (qp k : ℚ) - (qn k : ℚ)

theorem Tot_rec (n : ℕ) (hn : 1 ≤ n) :
    ∑ k ∈ Finset.range 14, c k * (Tot (n + k) : ℚ) = 0 := by
  have h := fun i => vec_rec n hn i
  have hs : (∑ k ∈ Finset.range 14, qp k * Tot (n + k)) =
      ∑ k ∈ Finset.range 14, qn k * Tot (n + k) := by
    simp only [Tot, Finset.mul_sum]
    rw [Finset.sum_comm, Finset.sum_comm (s := Finset.range 14)]
    exact Finset.sum_congr rfl (fun i _ => h i)
  simp only [c, sub_mul, Finset.sum_sub_distrib]
  have := congrArg (fun x : ℕ => (x : ℚ)) hs
  push_cast at this
  rw [this, sub_self]

