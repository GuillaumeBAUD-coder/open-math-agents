theorem adj_iff (i j : Fin N) : R' i j ↔ j ∈ adjL i :=
  if h0 : i.val < 16 then adj_iff_0 i (by omega) h0 j else if h16 : i.val < 32 then adj_iff_16 i (by omega) h16 j else if h32 : i.val < 48 then adj_iff_32 i (by omega) h32 j else if h48 : i.val < 64 then adj_iff_48 i (by omega) h48 j else if h64 : i.val < 80 then adj_iff_64 i (by omega) h64 j else if h80 : i.val < 96 then adj_iff_80 i (by omega) h80 j else if h96 : i.val < 112 then adj_iff_96 i (by omega) h96 j else if h112 : i.val < 128 then adj_iff_112 i (by omega) h112 j else if h128 : i.val < 144 then adj_iff_128 i (by omega) h128 j else if h144 : i.val < 160 then adj_iff_144 i (by omega) h144 j else if h160 : i.val < 176 then adj_iff_160 i (by omega) h160 j else if h176 : i.val < 192 then adj_iff_176 i (by omega) h176 j else if h192 : i.val < 208 then adj_iff_192 i (by omega) h192 j else if h208 : i.val < 224 then adj_iff_208 i (by omega) h208 j else if h224 : i.val < 240 then adj_iff_224 i (by omega) h224 j else adj_iff_240 i (by omega) (by have := i.isLt; simp only [N, K] at this; omega) j

