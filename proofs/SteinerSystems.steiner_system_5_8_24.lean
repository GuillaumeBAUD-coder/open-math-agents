private lemma cardBlock (j : Fin 759) : (block j).card = 8 := by
  have h := cardAll j (Nat.zero_le _) j.isLt
  simpa [cardOK,j.isLt] using h
private lemma cover (R : Finset (Fin 24)) (hR : R.card = 5) : (B.filter (R ⊆ ·)).card = 1 := by
  let f := R.orderEmbOfFin hR
  have h₁ : (f 1).val < (f 2).val := f.strictMono (by decide : (1 : Fin 5) < 2)
  have h₂ : (f 2).val < (f 3).val := f.strictMono (by decide : (2 : Fin 5) < 3)
  have h₃ : (f 3).val < (f 4).val := f.strictMono (by decide : (3 : Fin 5) < 4)
  have h₀ : (f 0).val < (f 1).val := f.strictMono (by decide : (0 : Fin 5) < 1)
  have H := checked (f 4)
  simp only [check,List.all_eq_true,List.mem_range] at H
  have he := of_decide_eq_true (H _ h₃ _ h₂ _ h₁ _ h₀)
  let w := meet (f 4) (f 3) (f 2) (f 1) (f 0)
  change w.log2 < 759 ∧ w = 2^w.log2 at he
  let k : Fin 759 := ⟨w.log2,he.1⟩
  have hb (j : Fin 759) : R ⊆ block j ↔ w.testBit j = true := by
    simp only [w,meet,Nat.testBit_and,Bool.and_eq_true]
    constructor
    · intro h
      have A (i : Fin 5) : (col (f i)).testBit j = true := by
        simpa [block] using h (R.orderEmbOfFin_mem hR i)
      exact ⟨⟨⟨⟨A 4,A 3⟩,A 2⟩,A 1⟩,A 0⟩
    · intro ⟨⟨⟨⟨e₄,e₃⟩,e₂⟩,e₁⟩,e₀⟩ t ht
      have ht' : t ∈ Set.range f := by simpa [f] using ht
      obtain ⟨i,rfl⟩ := ht'
      simp only [block,Finset.mem_filter,Finset.mem_univ,true_and]
      fin_cases i <;> assumption
  apply Finset.card_eq_one.mpr
  refine ⟨block k,?_⟩
  ext T
  simp only [B,Finset.mem_filter,Finset.mem_image,Finset.mem_univ,true_and,Finset.mem_singleton]
  constructor
  · rintro ⟨⟨j,rfl⟩,hj⟩
    have hz := (hb j).mp hj
    rw [he.2,Nat.testBit_two_pow] at hz
    exact congrArg block (Fin.ext (of_decide_eq_true hz).symm)
  · rintro rfl
    refine ⟨⟨k,rfl⟩,(hb k).mpr ?_⟩
    rw [he.2,Nat.testBit_two_pow]
    exact decide_eq_true rfl
end OMA.Witt
theorem OMA.solution : type_of% @SteinerSystems.steiner_system_5_8_24 := by
  refine ⟨⟨OMA.Witt.B,?_,OMA.Witt.cover⟩⟩
  intro b hb
  obtain ⟨j,_,rfl⟩ := Finset.mem_image.mp hb
  exact OMA.Witt.cardBlock j
