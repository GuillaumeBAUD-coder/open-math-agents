private def col (i : Nat) := columns[i]?.getD 0
private def block (j : Fin 759) : Finset (Fin 24) :=
  univ.filter (fun i => (col i).testBit j)
private def B := univ.image block
private def meet (a b c d e : Nat) := col a &&& col b &&& col c &&& col d &&& col e
private def test (a b c d e : Nat) :=
  let x := meet a b c d e
  decide (x.log2 < 759 ∧ x = 2^x.log2)
private def check (a : Nat) := (List.range a).all fun b =>
  (List.range b).all fun c => (List.range c).all fun d => (List.range d).all (test a b c d)
