open OMA.W in
theorem OMA.solution : OMA.R_OeisA229969_conjecture_5b_R1.H1 := by
  intro n h1 h0 h2
  have h := all_sound _ _ key (n - 3) (by omega)
  rw [show 3 + (n - 3) = n by omega] at h
  generalize T / _ ^ _ % _ = d at h
  unfold test at h
  simp only [Bool.or_eq_true, Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at h
  rcases h with h | ⟨⟨⟨⟨⟨a, b⟩, c⟩, e⟩, f⟩, g⟩
  · exact absurd h h0
  · refine ⟨d % 8, d / 8, n - d % 8 - d / 8, by omega, b, by omega, by omega, ?_, pr_sound e, pr_sound f, pr_sound g⟩
    simp only [Finset.mem_insert, Finset.mem_singleton]
    tauto
