/-- The block condition on natural numbers, as a Boolean function. -/
def blkb (a b c d : ℕ) : Bool :=
  decide (d + a ≥ b + c) && decide ((d - b) + (b - d) ≥ (c - a) + (a - c))

lemma blk_iff : ∀ a b c d : Fin 3,
    OMA.S_oeis_a250894.Blk a b c d ↔ blkb a b c d = true := by decide +kernel

