     rw [Finset.sum_Icc_succ_top (by omega)]
     have g:(1:ℝ) / ((N+1:ℕ):ℝ)≤ Real.log ((N+1:ℕ):ℝ) - Real.log (N:ℝ):=by
       have h:=Real.one_sub_inv_le_log_of_pos (show (0:ℝ)< ((N+1:ℕ):ℝ) / N by positivity)
       rw [Real.log_div (by positivity) (by positivity),inv_div] at h
       have c:1 - (N:ℝ) / ((N+1:ℕ):ℝ)= 1 / ((N+1:ℕ):ℝ):=by push_cast;field_simp;ring
       linarith only [h,c]
     linarith only [ih,g]
