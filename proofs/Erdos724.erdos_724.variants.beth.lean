   Finset.card_le_card_of_injOn (fun s => ∏ p ∈ s,p)
     (fun s hs=>Finset.mem_coe.mpr (Nat.mem_divisors.mpr ⟨Finset.prod_dvd_prod_of_subset s d id (Finset.mem_powerset.mp hs),b⟩))
