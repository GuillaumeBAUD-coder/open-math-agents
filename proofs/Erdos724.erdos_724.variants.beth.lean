   rw [← Finset.card_sigma (s:=Finset.Icc 1 N) (t:=Nat.divisors)]
   have h2 : ∑ d ∈ Finset.Icc 1 N,(N / d)= ((Finset.Icc 1 N).sigma (fun d=>Finset.Icc 1 (N / d))).card:=by
     rw [Finset.card_sigma]
     refine Finset.sum_congr rfl fun d hd => ?_
     rw [Finset.mem_Icc] at hd
     have:=Nat.div_pos hd.2 hd.1;rw [Nat.card_Icc];omega
   rw [h2]
   refine Finset.card_bij (fun p _=>⟨p.2,p.1 / p.2⟩)
     (fun ⟨n,d⟩ hnd=>by
       rw [Finset.mem_sigma,Finset.mem_Icc,Nat.mem_divisors] at hnd;dsimp only at hnd
       have b:1≤ d:=Nat.pos_of_ne_zero fun h0=>by subst h0;simp only [zero_dvd_iff] at hnd;omega
       have l:=Nat.mul_div_cancel' hnd.2.1
       have e:1≤ n / d:=Nat.pos_of_ne_zero fun h0=>by rw [h0,mul_zero] at l;omega
       exact Finset.mem_sigma.mpr ⟨Finset.mem_Icc.mpr ⟨b,(Nat.le_of_dvd (by omega) hnd.2.1).trans hnd.1.2⟩,
         Finset.mem_Icc.mpr ⟨e,Nat.div_le_div_right hnd.1.2⟩⟩)
     (fun ⟨n₁,d₁⟩ h₁ ⟨n₂,d₂⟩ h₂ c=>by
       rw [Finset.mem_sigma,Nat.mem_divisors] at h₁ h₂;dsimp only at h₁ h₂ c
