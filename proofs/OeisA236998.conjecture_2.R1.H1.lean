import OMAReductions.R_OeisA236998_conjecture_2_R1

/-!
For every n from 21 through 5000, the table supplies k and an integer square root.
Euler's product formula computes the two totients from their prime factors.
-/

private def fastPhi (n : ℕ) : ℕ :=
  let primes := n.primeFactorsList.dedup
  (n / primes.prod) * (primes.map (fun p => p - 1)).prod

private theorem fastPhi_eq (n : ℕ) : fastPhi n = n.totient := by
  let primes := n.primeFactorsList.dedup
  have same : primes.toFinset = n.primeFactors := by
    change n.primeFactorsList.dedup.toFinset = n.primeFactorsList.toFinset
    ext p
    simp only [List.mem_toFinset, List.mem_dedup]
  have unique : primes.Nodup := List.nodup_dedup _
  rw [Nat.totient_eq_div_primeFactors_mul, ← same]
  rw [List.prod_toFinset _ unique, List.prod_toFinset _ unique]
  rw [List.map_id']
  rfl

private def verify (first : ℕ) (values : List (ℕ × ℕ)) : Bool :=
  (values.zipIdx first).all fun ((k, root), n) =>
    decide (0 < k ∧ 2 * k < n ∧ fastPhi k * fastPhi (n - k) + 1 = root * root)

private theorem verify_append {first : ℕ} {left right : List (ℕ × ℕ)}
    (hLeft : verify first left = true) (hRight : verify (first + left.length) right = true) :
    verify first (left ++ right) = true := by
  simpa only [verify, List.zipIdx_append, List.all_append, Bool.and_eq_true] using And.intro hLeft hRight

private theorem verify_sound {first n : ℕ} {values : List (ℕ × ℕ)}
    (checked : verify first values = true) (lo : first ≤ n) (hi : n < first + values.length) :
    ∃ k : ℕ, 0 < k ∧ 2 * k < n ∧ IsSquare (k.totient * (n - k).totient + 1) := by
  have index : n - first < values.length := by omega
  let pair := values[n - first]
  have mem : (pair, n) ∈ values.zipIdx first :=
    List.mk_mem_zipIdx_iff_le_and_getElem?_sub.mpr ⟨lo, by simp [pair, index]⟩
  obtain ⟨positive, range, square⟩ := of_decide_eq_true (List.all_eq_true.mp checked _ mem)
  refine ⟨pair.1, positive, range, pair.2, ?_⟩
  simpa only [fastPhi_eq] using square

