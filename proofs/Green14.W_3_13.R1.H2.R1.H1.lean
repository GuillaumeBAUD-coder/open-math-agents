import OMAReductions.R_Green14_W_3_13_R1_H2_R1

/-!
# Six consecutive blues in the interior

Translate positions 1 through 158 down by one. On the resulting interval red 75 and six consecutive blues force a red triple or a blue thirteen-term progression.

The packed coverage test adapts the W(3,12) proof in PR 3245. The partitioned search follows the large-gap certificate in PR 5141.
-/

namespace OMA.MediumSix

private def NoTriple (R : Nat → Prop) :=
  ∀ a d, 0 < d → R a → R (a+d) → R (a+2*d) → False

private lemma distinct_terms {R : Nat → Prop} (hn : NoTriple R) {u v w : Nat}
    (hu : R u) (hv : R v) (hw : R w) (he : u+w=2*v) (hne : u ≠ w) : False := by
  rcases lt_or_gt_of_ne hne with h | h
  · exact hn u (v-u) (by omega) hu (by simpa only [show u+(v-u)=v by omega] using hv)
      (by simpa only [show u+2*(v-u)=w by omega] using hw)
  · exact hn w (v-w) (by omega) hw (by simpa only [show w+(v-w)=v by omega] using hv)
      (by simpa only [show w+2*(v-w)=u by omega] using hu)

-- Four views of the chosen red positions give every forbidden third point
-- by shifts. The last two views compress even and odd positions separately.
private structure Marks where
  rev : Nat
  dbl : Nat
  ev : Nat
  od : Nat
  deriving DecidableEq

private def mark (q : Nat) : Marks :=
  ⟨1 <<< (8*(159-q)), 1 <<< (16*q),
    if q%2=0 then 1 <<< (8*(q/2)) else 0,
    if q%2=1 then 1 <<< (8*(q/2)) else 0⟩

private def join (s t : Marks) : Marks :=
  ⟨s.rev ||| t.rev, s.dbl ||| t.dbl, s.ev ||| t.ev, s.od ||| t.od⟩

private def forbidden (s : Marks) (p : Nat) : Nat :=
  ((s.rev <<< (16*p)) >>> 1272) ||| (s.dbl >>> (8*p)) |||
    ((if p%2=0 then s.ev else s.od) <<< (8*((p+1)/2)))

private def Good (R : Nat → Prop) (s : Marks) :=
  ∀ p t, R p → R t → t ≠ p → (forbidden s p).testBit (8*t) = false

private lemma mark_good {R : Nat → Prop} (hn : NoTriple R)
    {q : Nat} (hq : R q) (hq' : q ≤ 159) : Good R (mark q) := by
  intro p t hp ht hne
  have h₁ : t+q ≠ 2*p := fun he =>
    distinct_terms hn ht hp hq he (by rintro rfl; omega)
  have h₂ : t+p ≠ 2*q := fun he => distinct_terms hn ht hq hp he hne
  have h₃ : p+q ≠ 2*t := fun he =>
    distinct_terms hn hp ht hq he (by rintro rfl; omega)
  have single (x i : Nat) : (1 <<< x : Nat).testBit i = decide (x=i) := by
    rw [Nat.shiftLeft_eq, one_mul, Nat.testBit_two_pow]
  unfold forbidden mark
  split_ifs <;> simp only [Nat.testBit_or, Nat.testBit_shiftRight, single,
    Nat.testBit_shiftLeft, Nat.zero_testBit, Bool.or_eq_false_iff,
    Bool.and_eq_false_imp, decide_eq_true_eq, decide_eq_false_iff_not]
  all_goals (repeat' apply And.intro) <;> intros <;> first | trivial | omega

private lemma join_good {R : Nat → Prop} {s u : Marks} (hs : Good R s) (hu : Good R u) :
    Good R (join s u) := by
  intro p t hp ht hn
  have h₁ := hs p t hp ht hn
  have h₂ := hu p t hp ht hn
  unfold forbidden at *
  unfold join
  split_ifs at * <;> simp_all [Nat.testBit_or, Nat.testBit_shiftRight, Nat.testBit_shiftLeft]

private def addRed (s : Marks) (a p : Nat) : Marks × Nat :=
  let bad := forbidden s p
  (join s (mark p), (a ^^^ (a &&& bad)) ||| (1 <<< (8*p)))

private def Bad (hit : (Nat → Prop) → Prop) (seed : Marks × Nat) :=
  ∀ R : Nat → Prop, (∀ x, R x → x ≤ 159) → NoTriple R → hit R →
    Good R seed.1 → (∀ x, R x → seed.2.testBit (8*x) = true) → False

private lemma add_safe {R : Nat → Prop} {s : Marks} {a p : Nat} (hs : Good R s)
    (ha : ∀ x, R x → a.testBit (8*x) = true) (hp : R p) :
    ∀ x, R x → (addRed s a p).2.testBit (8*x) = true := by
  intro x hx
  by_cases he : x = p
  · simp [addRed, he, Nat.shiftLeft_eq]
  · simp [addRed, Nat.testBit_xor, ha x hx, hs p x hp hx he]

private def bluePattern (a d : Nat) : Nat :=
  (List.range 13).foldr (fun t m => (1 <<< (8*(a+t*d))) ||| m) 0

private def base (d : Nat) := ( >>> (1280*d)) % (1 <<< 1280)

private def pattern (i : Nat) : Nat :=
  let a := i % 160
  let d := i / 160 + 1
  if a + 12*d < 158 then base d <<< (8*a) else base 1

private def Hits (R : Nat → Prop) := ∀ i, ∃ t, (pattern i).testBit (8*t) = true ∧ R t

private def erase (a p : Nat) := a ^^^ (a &&& (1 <<< (8*p)))

private lemma erase_safe {R : Nat → Prop} {a p : Nat}
    (ha : ∀ x, R x → a.testBit (8*x) = true) (hp : ¬R p) :
    ∀ x, R x → (erase a p).testBit (8*x) = true := by
  intro t ht
  have hne : p ≠ t := fun he => hp (he ▸ ht)
  simp [erase, Nat.testBit_xor, ha t ht, Nat.shiftLeft_eq, hne]


private abbrev State := Marks × Nat
private def Closed (s : State) := Bad Hits s

-- A separated base-256 board lets one multiplication count the possible red
-- entries in every thirteen-term progression.  The counts guide the search.
-- Every claimed empty or singleton progression is checked on the original board.
private def spread (x : Nat) : Nat :=
  let x := (x ||| (x <<< 1792)) &&& 
  let x := (x ||| (x <<< 896)) &&& 
  let x := (x ||| (x <<< 448)) &&& 
  let x := (x ||| (x <<< 224)) &&& 
  let x := (x ||| (x <<< 112)) &&& 
  let x := (x ||| (x <<< 56)) &&& 
  let x := (x ||| (x <<< 28)) &&& 
  let x := (x ||| (x <<< 14)) &&& 
  let x := (x ||| (x <<< 7)) &&& 
  x

private def pointIndex (x : Nat) : Nat :=
  (( : Nat) >>> (8*((x ^^^ (x-1)) % 347))) % 256

private def endIndex (x : Nat) : Nat :=
  (( : Nat) >>> (12*((x ^^^ (x-1)) % 4219))) % 4096

private def convolution : Nat := 

private def slots : Nat := 

private def high : Nat := slots <<< 7
private def fieldMask : Nat := slots * 255

private def slotAt (highBit : Nat) : Nat :=
  let i := endIndex highBit
  let d := i / 160 + 1
  i - 12*d

private def tight (sums k : Nat) : Nat → Nat
  | 0 => 0
  | fuel + 1 =>
    let x := (high+k*slots-sums) &&& high
    if x != 0 then slotAt x else tight sums (k+1) fuel

private abbrev Board := State × Nat
private def Left (s : Board) (p : Nat) : Board :=
  (addRed s.1.1 s.1.2 p, s.2 ||| (12 <<< (8*p)))
private def Right (s : Board) (p : Nat) : Board := ((s.1.1, erase s.1.2 p), s.2)
private def Sealed (s : Board) := Closed s.1
private def Facts (l : List Board) := ∀ s ∈ l, Sealed s
private lemma emptyFacts : Facts [] := by simp [Facts]
private lemma consFacts {s : Board} {l : List Board} (hs : Sealed s) (hl : Facts l) :
    Facts (s :: l) := by
  intro t ht
  rcases List.mem_cons.mp ht with rfl | h
  · exact hs
  · exact hl t h

private def upperPoint (x : Nat) : Nat :=
  let x := x ||| (x >>> 1)
  let x := x ||| (x >>> 2)
  let x := x ||| (x >>> 4)
  let x := x ||| (x >>> 8)
  let x := x ||| (x >>> 16)
  let x := x ||| (x >>> 32)
  let x := x ||| (x >>> 64)
  let x := x ||| (x >>> 128)
  let x := x ||| (x >>> 256)
  let x := x ||| (x >>> 512)
  let x := x ||| (x >>> 1024)
  pointIndex (x - (x >>> 1))

private def choose (s : Board) : Nat :=
  let sums := ((s.1.2 ||| s.2) * convolution) &&& fieldMask
  let emptySlots := (high - sums) &&& high
  if emptySlots != 0 then 160 + slotAt emptySlots else
    let one := ((high + slots) - sums) &&& high
    if one != 0 then 160 + slotAt one else
      let rest := (pattern (tight sums 2 12)) &&& s.1.2
      let lo := pointIndex rest
      if (1 <<< (8*(159-lo)) : Nat) ≤ rest then lo else upperPoint rest

private def atCut (mask trail : Nat) (cuts : List (Nat × Board)) (s : Board) : Bool :=
  if mask = 0 then false else
    mask.testBit (trail % 256) && (cuts.lookup trail == some s)

private lemma lookup_mem {trail : Nat} {cuts : List (Nat × Board)} {s : Board}
    (h : cuts.lookup trail = some s) : s ∈ cuts.map Prod.snd := by
  induction cuts with
  | nil => simp at h
  | cons p rest ih =>
    rcases p with ⟨k, v⟩
    simp only [List.lookup_cons] at h
    split at h
    · cases h
      exact List.mem_cons_self
    · exact List.mem_cons_of_mem _ (ih h)

private lemma cut_sound {mask trail : Nat} {cuts : List (Nat × Board)} {s : Board}
    (hc : atCut mask trail cuts s = true) (facts : Facts (cuts.map Prod.snd)) : Sealed s := by
  unfold atCut at hc
  split at hc
  · contradiction
  · have eqn : cuts.lookup trail = some s := beq_iff_eq.mp (Bool.and_eq_true_iff.mp hc).2
    exact facts s (lookup_mem eqn)

private def visit (mask : Nat) (cuts : List (Nat × Board)) : Nat → Nat → Board → Bool
  | 0, _, _ => false
  | fuel+1, trail, s =>
    if atCut mask trail cuts s then true else
      let c := choose s
      if c < 160 then visit mask cuts fuel (trail*2) (Left s c) &&
          visit mask cuts fuel (trail*2+1) (Right s c) else
        let rest := pattern (c-160) &&& s.1.2
        if rest = 0 then true else
          let p := pointIndex rest
          if rest = (1 <<< (8*p)) then visit mask cuts fuel (trail*2) (Left s p) else false

private lemma visit_sound (mask : Nat) (cuts : List (Nat × Board)) (facts : Facts (cuts.map Prod.snd)) (fuel trail : Nat)
    (s : Board) (hw : visit mask cuts fuel trail s = true) : Sealed s := by
  induction fuel generalizing trail s with
  | zero => simp [visit] at hw
  | succ fuel ih =>
    simp only [visit] at hw
    split at hw
    · exact cut_sound (by assumption) facts
    · split at hw
      · obtain ⟨left, right⟩ := Bool.and_eq_true_iff.mp hw
        intro R bound hn hit hs ha
        by_cases hp : R (choose s)
        · exact ih _ _ left R bound hn hit (join_good hs (mark_good hn hp (bound _ hp))) (add_safe hs ha hp)
        · exact ih _ _ right R bound hn hit hs (erase_safe ha hp)
      · intro R bound hn hit hs ha
        let k := choose s - 160
        obtain ⟨t, hbit, ht⟩ := hit k
        have hr : (pattern k &&& s.1.2).testBit (8*t) = true := by simp [hbit, ha t ht]
        split at hw
        · rename_i hz
          change pattern k &&& s.1.2 = 0 at hz
          simp [hz] at hr
        · split at hw
          · rename_i hone
            let p := pointIndex (pattern k &&& s.1.2)
            change pattern k &&& s.1.2 = 1 <<< (8*p) at hone
            rw [hone, Nat.shiftLeft_eq, one_mul, Nat.testBit_two_pow] at hr
            have hp : R p := (show t = p by have := of_decide_eq_true hr; omega) ▸ ht
            exact ih _ _ hw R bound hn hit (join_good hs (mark_good hn hp (bound _ hp))) (add_safe hs ha hp)
          · contradiction

private lemma certify {s : Board} (mask : Nat) (cuts : List (Nat × Board))
    (h : visit mask cuts 150 1 s = true) (facts : Facts (cuts.map Prod.snd)) : Sealed s :=
  visit_sound mask cuts facts 150 1 s h

private def seed (rev dbl ev od allow red : Nat) : Board :=
  ((⟨spread rev, spread dbl, spread ev, spread od⟩, spread allow), 12 * spread red)

private lemma pattern_has {t : ℕ} (ht : t < 13) (a d : ℕ) :
    (bluePattern a d).testBit (8*(a+t*d)) = true := by
  suffices ∀ xs : List ℕ, t ∈ xs → (xs.foldr (fun i m : ℕ => (1 <<< (8*(a+i*d))) ||| m) 0).testBit (8*(a+t*d)) = true from
    this _ (List.mem_range.mpr ht)
  intro xs
  induction xs with
  | nil => simp
  | cons u xs ih =>
    intro hm
    rcases List.mem_cons.mp hm with rfl | h
    · simp [Nat.shiftLeft_eq]
    · simp [ih h]

private lemma base_correct : ∀ d : Fin 14, base d.val = bluePattern 0 d.val := by decide +kernel

private lemma all_hit_of_cover {R : ℕ → Prop}
    (cover : ∀ a d : ℕ, 0 < d → a + 12*d < 158 → ∃ t : Fin 13, R (a+t.val*d)) :
    Hits R := by
  have shifted (a d : ℕ) (hd : 0 < d) (bound : a + 12*d < 158) :
      ∃ x, ((base d) <<< (8*a)).testBit (8*x) = true ∧ R x := by
    obtain ⟨t, ht⟩ := cover a d hd bound
    refine ⟨a+t.val*d, ?_, ht⟩
    rw [base_correct ⟨d, by omega⟩]
    simpa [Nat.mul_add, Nat.testBit_shiftLeft, Nat.le_add_right] using pattern_has t.isLt 0 d
  intro i
  dsimp only [pattern]
  split
  · exact shifted _ _ (by omega) (by assumption)
  · simpa using shifted 0 1 (by decide) (by decide)

private def initialAllowed : Nat := 

private lemma six_blue_of_certificate (cert : Closed (mark 75, initialAllowed)) :
    OMA.R_Green14_W_3_13_R1_H2_R1.H1 := by
  intro c anchor gap
  by_contra noMono
  let R (x : ℕ) : Prop := x < 158 ∧ c (x+1) = true
  have red : R 75 := ⟨by decide, anchor⟩
  have hn : NoTriple R := by
    intro a d hd ha hm he
    have lim := he.1
    apply noMono
    refine ⟨true, a+1, d, by omega, hd, by change a+1+2*d<159; omega, ?_⟩
    intro t ht
    change t.val ≤ 2 at ht
    rw [show a+1+t.val*d = (a+t.val*d)+1 by omega]
    have any : t.val = 0 ∨ t.val = 1 ∨ t.val = 2 := by omega
    rcases any with h | h | h
    · simpa only [h, zero_mul, Nat.add_zero] using ha.2
    · simpa only [h, one_mul] using hm.2
    · simpa only [h] using he.2
  have cover (a d : ℕ) (hd : 0 < d) (hb : a+12*d < 158) :
      ∃ t : Fin 13, R (a+t.val*d) := by
    by_contra miss
    apply noMono
    refine ⟨false, a+1, d, by omega, hd, by change a+1+12*d<159; omega, ?_⟩
    intro t ht
    change t.val ≤ 12 at ht
    have step := Nat.mul_le_mul_right d ht
    rw [show a+1+t.val*d = (a+t.val*d)+1 by omega]
    cases eqn : c ((a+t.val*d)+1) with
    | false => rfl
    | true => exact (miss ⟨t, by exact ⟨by omega, eqn⟩⟩).elim
  have table : ∀ i : Fin 160, i.val < 158 → ¬ (75 < i.val ∧ i.val < 82) →
      initialAllowed.testBit (8*i.val) = true := by decide +kernel
  have allowed (x : ℕ) (hx : R x) : initialAllowed.testBit (8*x) = true := by
    have bound := hx.1
    have outside : ¬ (75 < x ∧ x < 82) := by
      rintro ⟨lo, hi⟩
      have blue := gap (x+1) (by omega) (by omega)
      rw [hx.2] at blue
      cases blue
    exact table ⟨x, by omega⟩ bound outside
  exact cert R (fun x hx => by have h := hx.1; omega) hn (all_hit_of_cover cover)
    (mark_good hn red (by decide)) allowed

