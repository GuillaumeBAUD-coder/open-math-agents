private theorem interior_gap (r : Nat → Bool) (hr : r 76 = false)
    (hb : ∀ x, 76 < x → x ≤ 82 → r x = true) : Mono r := by
  by_contra hn
  have ht := triple_free hn
  apply complete (Red r) (fun x h => by have := h.2.1; omega) ht (hit_all hn)
  · exact mark_good ht (show Red r 76 from ⟨by decide, by decide, hr⟩) (by decide)
  · intro x hx
    have outside : x ≤ 76 ∨ 82 < x := by
      by_contra! h
      have := hb x h.1 h.2
      simp [Red, this] at hx
    have mask : ∀ i : Fin 160, 0 < i.val → i.val < 159 →
        i.val ≤ 76 ∨ 82 < i.val →
        ( : Nat).testBit (8*i.val) = true := by decide +kernel
    exact mask ⟨x, by have := hx.2.1; omega⟩ hx.1 hx.2.1 outside

end OMA.Green14InteriorB8Fused

open OMA.Green14InteriorB8Fused in
theorem OMA.solution : OMA.R_Green14_W_3_13_R1_H2_R1.H1 := by
  intro c hc hb
  obtain ⟨b, a, d, ha, hd, hend, hall⟩ := interior_gap (fun x => !c x)
    (by simp only [hc, Bool.not_true])
    (fun x hlo hhi => by simp only [hb x hlo (by omega), Bool.not_false])
  refine ⟨!b, a, d, ha, hd, ?_, ?_⟩
  · cases b <;> simpa using hend
  · intro t ht
    cases b <;> simpa using hall t.val (by simpa using ht)
