/-!
# A solution of the coprime variant of Erdős Problem 307 without the element 1

Prior work. The existence of such sets was first announced on 26 November 2026 by Doug Phillips
(repository github.com/duggiephresh/unit-fraction-solutions, registry entry
PALOMAR-2026-11-26-000045), found by a residue-steered descent in which the huge elements are never
written down. This file uses that idea. Its chain of deviations was found by a separate search, and
its checker and soundness proof were written separately.

Method. For finite sets P, Q of pairwise coprime integers put A = prod P, a = sum of A / p,
B = prod Q, b = sum of B / q, so the reciprocal sums are a / A and b / B. The deviation is
D = A * B - a * b. Adding the element x = (A * b + D') / D to P turns the deviation D into D'
(any D' congruent to -(A * b) modulo D), and x is coprime to P as soon as gcd (D', A * b) = 1.
When the deviation is 1, the elements x = A * b + B ^ 2 and y = a * B + A ^ 2 added to P and Q
give (sum over P) * (sum over Q) = 1 exactly.

The seed is the set of the 59 primes below 280, split into P0 and Q0, and the list Ds holds the
successive deviations down to 1. The elements roughly square at every step, so they are not
computed: the checker only carries A * b modulo M, where M is B times the product of the
deviations still to come, and divides M by the current deviation at each step. The theorem
sound shows that a successful run of the checker yields the two sets, and the kernel runs the
checker on the data.
-/

namespace E307c

open Finset

/-- Clearing denominators in a reciprocal sum. -/
lemma sum_inv_eq (S : Finset ℕ) (hS : ∀ p ∈ S, 0 < p) :
    (∑ p ∈ S, (p : ℚ)⁻¹) =
      ((∑ p ∈ S, (∏ x ∈ S, x) / p : ℕ) : ℚ) / ((∏ x ∈ S, x : ℕ) : ℚ) := by
  have hpos : 0 < ∏ x ∈ S, x := Finset.prod_pos hS
  have hne : ((∏ x ∈ S, x : ℕ) : ℚ) ≠ 0 := by exact_mod_cast hpos.ne'
  rw [eq_div_iff hne, Finset.sum_mul]
  push_cast
  apply Finset.sum_congr rfl
  intro a ha
  have hdvd : a ∣ ∏ x ∈ S, x := Finset.dvd_prod_of_mem _ ha
  have hapos : 0 < a := hS a ha
  have hane : (a : ℚ) ≠ 0 := by positivity
  rw [Nat.cast_div hdvd hane, Nat.cast_prod, div_eq_mul_inv, mul_comm]

lemma pairwise_insert {S : Finset ℕ} {p : ℕ}
    (hS : Set.Pairwise (S : Set ℕ) Nat.Coprime)
    (hp : ∀ a ∈ S, Nat.Coprime p a) :
    Set.Pairwise ((insert p S : Finset ℕ) : Set ℕ) Nat.Coprime := by
  intro x hx y hy hxy
  rw [Finset.mem_coe, Finset.mem_insert] at hx hy
  rcases hx with rfl | hx
  · rcases hy with rfl | hy
    · exact absurd rfl hxy
    · exact hp y hy
  · rcases hy with rfl | hy
    · exact (hp x hx).symm
    · exact hS hx hy hxy

lemma coprime_add_mul {m n k : ℕ} (h : Nat.Coprime m n) : Nat.Coprime (m + n * k) n := by
  have h1 : Nat.gcd (m + n * k) n ∣ m := by
    have h2 : Nat.gcd (m + n * k) n ∣ m + n * k := Nat.gcd_dvd_left _ _
    have h3 : Nat.gcd (m + n * k) n ∣ n * k := Dvd.dvd.mul_right (Nat.gcd_dvd_right _ _) k
    exact (Nat.dvd_add_left h3).mp h2
  have h4 : Nat.gcd (m + n * k) n ∣ Nat.gcd m n := Nat.dvd_gcd h1 (Nat.gcd_dvd_right _ _)
  rw [h] at h4
  exact Nat.dvd_one.mp h4

/-- The state reached after some steps: a set `P` with product `A`, numerator `a`,
deviation `D = A * B - a * b`, and `A * b` known modulo `M`. -/
def Inv (B b E0 M D e : ℕ) : Prop :=
  ∃ (P : Finset ℕ) (a : ℕ),
    P.Nonempty ∧ (∀ p ∈ P, 2 ≤ p) ∧ Set.Pairwise (P : Set ℕ) Nat.Coprime ∧
    (∑ p ∈ P, (p : ℚ)⁻¹) = (a : ℚ) / ((∏ p ∈ P, p : ℕ) : ℚ) ∧
    (∏ p ∈ P, p) * B = a * b + D ∧
    Nat.ModEq M ((∏ p ∈ P, p) * b) e ∧
    E0 ≤ (∏ p ∈ P, p) * b ∧
    Nat.Coprime (∏ p ∈ P, p) B ∧ 0 < D

/-- One step of the checker: from deviation `D` to deviation `D'`, with `e` the residue of
`A * b` modulo `M`. It tests that the new element is an integer, at least 2, coprime to `P`
(through `gcd (D', A * b) = 1`) and coprime to `B`. -/
def stepOk (B E0 M D e D' : ℕ) : Bool :=
  (M % D == 0) && ((e + D') % D == 0) && ((M / D) % D' == 0) && ((M / D) % B == 0) &&
  (Nat.gcd D' (e % D') == 1) && (Nat.gcd (((e + D') / D) % (M / D)) B == 1) &&
  (Nat.ble (2 * D) E0) && (Nat.ble 1 D')

/-- The residue of the new `A * b` modulo `M / D`. -/
def nextE (M D e D' : ℕ) : ℕ :=
  (e % (M / D)) * (((e + D') / D) % (M / D)) % (M / D)

/-- Run the checker along the list of deviations; the last deviation must be 1. -/
def loop (B E0 : ℕ) : List ℕ → ℕ → ℕ → ℕ → Bool
  | [], _, D, _ => D == 1
  | D' :: rest, M, D, e =>
      stepOk B E0 M D e D' && loop B E0 rest (M / D) D' (nextE M D e D')

theorem step_sound {B b E0 M D e D' : ℕ} (hinv : Inv B b E0 M D e)
    (hok : stepOk B E0 M D e D' = true) :
    Inv B b E0 (M / D) D' (nextE M D e D') := by
  obtain ⟨P, a, hne, h2, hcop, hsum, hdev, hmod, hE0, hAB, hDpos⟩ := hinv
  simp only [stepOk, Bool.and_eq_true, beq_iff_eq, Nat.ble_eq] at hok
  obtain ⟨⟨⟨⟨⟨⟨⟨hMD, htD⟩, hM'D'⟩, hM'B⟩, hg1⟩, hg2⟩, h2D⟩, hD'⟩ := hok
  have hDM : D ∣ M := Nat.dvd_of_mod_eq_zero hMD
  have hMeq : D * (M / D) = M := Nat.mul_div_cancel' hDM
  have hM'M : M / D ∣ M := ⟨D, by rw [mul_comm]; exact hMeq.symm⟩
  have hD'M' : D' ∣ M / D := Nat.dvd_of_mod_eq_zero hM'D'
  have hBM' : B ∣ M / D := Nat.dvd_of_mod_eq_zero hM'B
  have htdvd : D ∣ e + D' := Nat.dvd_of_mod_eq_zero htD
  have hApos : 0 < ∏ p ∈ P, p := Finset.prod_pos (fun p hp => by have := h2 p hp; omega)
  -- the new element
  have hED : Nat.ModEq D ((∏ p ∈ P, p) * b) e := hmod.of_dvd hDM
  have hdiv : D ∣ (∏ p ∈ P, p) * b + D' :=
    (Nat.modEq_zero_iff_dvd).mp
      ((hED.add_right D').trans (Nat.modEq_zero_iff_dvd.mpr htdvd))
  obtain ⟨x, hx⟩ := hdiv
  have hx2 : 2 ≤ x := by
    by_contra hcon
    have hx1 : x ≤ 1 := by omega
    have : D * x ≤ D * 1 := Nat.mul_le_mul_left _ hx1
    omega
  -- gcd(D', E) = 1
  have hED' : Nat.ModEq D' ((∏ p ∈ P, p) * b) (e % D') :=
    (hmod.of_dvd (hD'M'.trans hM'M)).trans (Nat.mod_modEq e D').symm
  have hgE : Nat.gcd D' ((∏ p ∈ P, p) * b) = 1 := by
    rw [Nat.gcd_comm, hED'.gcd_eq, Nat.gcd_comm]
    exact hg1
  have hxE : Nat.Coprime x ((∏ p ∈ P, p) * b) := by
    have h1 : Nat.gcd x ((∏ p ∈ P, p) * b) ∣ D' := by
      have h3 : Nat.gcd x ((∏ p ∈ P, p) * b) ∣ (∏ p ∈ P, p) * b + D' := by
        rw [hx]
        exact Dvd.dvd.mul_left (Nat.gcd_dvd_left _ _) D
      exact (Nat.dvd_add_right (Nat.gcd_dvd_right _ _)).mp h3
    have h4 : Nat.gcd x ((∏ p ∈ P, p) * b) ∣ Nat.gcd D' ((∏ p ∈ P, p) * b) :=
      Nat.dvd_gcd h1 (Nat.gcd_dvd_right _ _)
    rw [hgE] at h4
    exact Nat.dvd_one.mp h4
  have hxp : ∀ p ∈ P, Nat.Coprime x p := by
    intro p hp
    have hpE : p ∣ (∏ p ∈ P, p) * b := Dvd.dvd.mul_right (Finset.dvd_prod_of_mem _ hp) b
    exact Nat.Coprime.coprime_dvd_right hpE hxE
  have hxnot : x ∉ P := by
    intro hmem
    have h := hxp x hmem
    rw [Nat.coprime_self] at h
    omega
  -- x modulo M / D
  have hDne : D ≠ 0 := by omega
  have hxmod : Nat.ModEq (M / D) x ((e + D') / D) := by
    have h1 : Nat.ModEq M ((∏ p ∈ P, p) * b + D') (e + D') := hmod.add_right D'
    rw [hx, ← Nat.mul_div_cancel' htdvd, ← hMeq] at h1
    exact Nat.ModEq.mul_left_cancel' hDne h1
  have hxmod' : Nat.ModEq (M / D) x (((e + D') / D) % (M / D)) :=
    hxmod.trans (Nat.mod_modEq _ _).symm
  have hxB : Nat.Coprime x B := by
    have h1 : Nat.ModEq B x (((e + D') / D) % (M / D)) := hxmod'.of_dvd hBM'
    unfold Nat.Coprime
    rw [h1.gcd_eq]
    exact hg2
  refine ⟨insert x P, a * x + ∏ p ∈ P, p, Finset.insert_nonempty _ _, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro p hp
    rcases Finset.mem_insert.mp hp with rfl | hp
    · exact hx2
    · exact h2 p hp
  · exact pairwise_insert hcop hxp
  · rw [Finset.sum_insert hxnot, Finset.prod_insert hxnot, hsum]
    have hxq : (x : ℚ) ≠ 0 := by positivity
    have hAq : ((∏ p ∈ P, p : ℕ) : ℚ) ≠ 0 := by exact_mod_cast hApos.ne'
    rw [Nat.cast_add, Nat.cast_mul, Nat.cast_mul]
    generalize ((∏ p ∈ P, p : ℕ) : ℚ) = A at hAq ⊢
    field_simp
    ring
  · rw [Finset.prod_insert hxnot]
    calc x * (∏ p ∈ P, p) * B = x * ((∏ p ∈ P, p) * B) := by ring
      _ = x * (a * b + D) := by rw [hdev]
      _ = a * x * b + D * x := by ring
      _ = a * x * b + ((∏ p ∈ P, p) * b + D') := by rw [hx]
      _ = (a * x + ∏ p ∈ P, p) * b + D' := by ring
  · rw [Finset.prod_insert hxnot]
    have h1 : Nat.ModEq (M / D) ((∏ p ∈ P, p) * b) (e % (M / D)) :=
      (hmod.of_dvd hM'M).trans (Nat.mod_modEq _ _).symm
    have h3 : Nat.ModEq (M / D) (((∏ p ∈ P, p) * b) * x)
        ((e % (M / D)) * (((e + D') / D) % (M / D))) := h1.mul hxmod'
    have h4 : x * (∏ p ∈ P, p) * b = ((∏ p ∈ P, p) * b) * x := by ring
    rw [h4]
    exact h3.trans (Nat.mod_modEq _ _).symm
  · rw [Finset.prod_insert hxnot]
    calc E0 ≤ (∏ p ∈ P, p) * b := hE0
      _ = 1 * ((∏ p ∈ P, p) * b) := (one_mul _).symm
      _ ≤ x * ((∏ p ∈ P, p) * b) := Nat.mul_le_mul_right _ (by omega)
      _ = x * (∏ p ∈ P, p) * b := by ring
  · rw [Finset.prod_insert hxnot]
    exact Nat.Coprime.mul_left hxB hAB
  · exact hD'

theorem loop_sound {B b E0 : ℕ} : ∀ (Ds : List ℕ) (M D e : ℕ), Inv B b E0 M D e →
    loop B E0 Ds M D e = true → ∃ M' e', Inv B b E0 M' 1 e'
  | [], M, D, e, hinv, h => by
      simp only [loop, beq_iff_eq] at h
      subst h
      exact ⟨M, e, hinv⟩
  | D' :: rest, M, D, e, hinv, h => by
      simp only [loop, Bool.and_eq_true] at h
      exact loop_sound rest _ _ _ (step_sound hinv h.1) h.2

theorem closing {B b E0 M e : ℕ} (Q : Finset ℕ) (hQne : Q.Nonempty) (hQ2 : ∀ q ∈ Q, 2 ≤ q)
    (hQc : Set.Pairwise (Q : Set ℕ) Nat.Coprime) (hB : B = ∏ q ∈ Q, q)
    (hb : b = ∑ q ∈ Q, B / q) (hinv : Inv B b E0 M 1 e) :
    type_of% @Erdos307.erdos_307.variants.coprime_one_notMem := by
  obtain ⟨P, a, hne, h2, hcop, hsum, hdev, -, -, hAB, -⟩ := hinv
  have hApos : 0 < ∏ p ∈ P, p := Finset.prod_pos (fun p hp => by have := h2 p hp; omega)
  have hBpos : 0 < B := by
    rw [hB]
    exact Finset.prod_pos (fun q hq => by have := hQ2 q hq; omega)
  have hA2 : 2 ≤ ∏ p ∈ P, p := by
    obtain ⟨p, hp⟩ := hne
    exact le_trans (h2 p hp) (Nat.le_of_dvd hApos (Finset.dvd_prod_of_mem _ hp))
  have hB2 : 2 ≤ B := by
    obtain ⟨q, hq⟩ := hQne
    have : q ∣ B := by rw [hB]; exact Finset.dvd_prod_of_mem _ hq
    exact le_trans (hQ2 q hq) (Nat.le_of_dvd hBpos this)
  have hsumQ : (∑ q ∈ Q, (q : ℚ)⁻¹) = (b : ℚ) / (B : ℚ) := by
    rw [sum_inv_eq Q (fun q hq => by have := hQ2 q hq; omega), hb, hB]
  -- the two closing elements
  have hxA : Nat.Coprime (B * B + (∏ p ∈ P, p) * b) (∏ p ∈ P, p) :=
    coprime_add_mul (Nat.Coprime.mul_left hAB.symm hAB.symm)
  have hyB : Nat.Coprime ((∏ p ∈ P, p) * (∏ p ∈ P, p) + B * a) B :=
    coprime_add_mul (Nat.Coprime.mul_left hAB hAB)
  have hx2 : 2 ≤ B * B + (∏ p ∈ P, p) * b := by nlinarith
  have hy2 : 2 ≤ (∏ p ∈ P, p) * (∏ p ∈ P, p) + B * a := by nlinarith
  have hxp : ∀ p ∈ P, Nat.Coprime (B * B + (∏ p ∈ P, p) * b) p := fun p hp =>
    Nat.Coprime.coprime_dvd_right (Finset.dvd_prod_of_mem _ hp) hxA
  have hyq : ∀ q ∈ Q, Nat.Coprime ((∏ p ∈ P, p) * (∏ p ∈ P, p) + B * a) q := fun q hq =>
    Nat.Coprime.coprime_dvd_right (by rw [hB]; exact Finset.dvd_prod_of_mem _ hq) hyB
  have hxnot : B * B + (∏ p ∈ P, p) * b ∉ P := by
    intro hmem
    have h := hxp _ hmem
    rw [Nat.coprime_self] at h
    omega
  have hynot : (∏ p ∈ P, p) * (∏ p ∈ P, p) + B * a ∉ Q := by
    intro hmem
    have h := hyq _ hmem
    rw [Nat.coprime_self] at h
    omega
  refine ⟨insert (B * B + (∏ p ∈ P, p) * b) P,
    insert ((∏ p ∈ P, p) * (∏ p ∈ P, p) + B * a) Q, ?_, ?_, ?_, ?_,
    pairwise_insert hcop hxp, pairwise_insert hQc hyq, ?_⟩
  · intro h0
    rcases Finset.mem_insert.mp (Finset.mem_inter.mp h0).1 with h | h
    · omega
    · have := h2 0 h; omega
  · intro h1
    rcases Finset.mem_union.mp h1 with h | h
    · rcases Finset.mem_insert.mp h with h | h
      · omega
      · have := h2 1 h; omega
    · rcases Finset.mem_insert.mp h with h | h
      · omega
      · have := hQ2 1 h; omega
  · rw [Finset.card_insert_of_notMem hxnot]
    have := Finset.card_pos.mpr hne
    omega
  · rw [Finset.card_insert_of_notMem hynot]
    have := Finset.card_pos.mpr hQne
    omega
  · rw [Finset.sum_insert hxnot, Finset.sum_insert hynot, hsum, hsumQ]
    have hAq : ((∏ p ∈ P, p : ℕ) : ℚ) ≠ 0 := by exact_mod_cast hApos.ne'
    have hBq : (B : ℚ) ≠ 0 := by exact_mod_cast hBpos.ne'
    have hdevq : ((∏ p ∈ P, p : ℕ) : ℚ) * (B : ℚ) = (a : ℚ) * (b : ℚ) + 1 := by
      exact_mod_cast hdev
    have hXc : ((B * B + (∏ p ∈ P, p) * b : ℕ) : ℚ) =
        (B : ℚ) * B + ((∏ p ∈ P, p : ℕ) : ℚ) * b := by
      rw [Nat.cast_add, Nat.cast_mul, Nat.cast_mul]
    have hYc : (((∏ p ∈ P, p) * (∏ p ∈ P, p) + B * a : ℕ) : ℚ) =
        ((∏ p ∈ P, p : ℕ) : ℚ) * ((∏ p ∈ P, p : ℕ) : ℚ) + (B : ℚ) * a := by
      rw [Nat.cast_add, Nat.cast_mul, Nat.cast_mul]
    have hXpos : (0 : ℚ) < ((B * B + (∏ p ∈ P, p) * b : ℕ) : ℚ) := by
      have : 0 < B * B + (∏ p ∈ P, p) * b := by omega
      exact_mod_cast this
    have hYpos : (0 : ℚ) < (((∏ p ∈ P, p) * (∏ p ∈ P, p) + B * a : ℕ) : ℚ) := by
      have : 0 < (∏ p ∈ P, p) * (∏ p ∈ P, p) + B * a := by omega
      exact_mod_cast this
    rw [hXc] at hXpos ⊢
    rw [hYc] at hYpos ⊢
    generalize ((∏ p ∈ P, p : ℕ) : ℚ) = A at hAq hdevq hXpos hYpos ⊢
    generalize (B : ℚ) = Bq at hBq hdevq hXpos hYpos ⊢
    generalize (a : ℚ) = aq at hdevq hXpos hYpos ⊢
    generalize (b : ℚ) = bq at hdevq hXpos hYpos ⊢
    have h1 : aq * (Bq * Bq + A * bq) + A = Bq * (A * A + Bq * aq) := by
      linear_combination (-A) * hdevq
    have h3 : bq * (A * A + Bq * aq) + Bq = A * (Bq * Bq + A * bq) := by
      linear_combination (-Bq) * hdevq
    have hX0 : Bq * Bq + A * bq ≠ 0 := hXpos.ne'
    have hY0 : A * A + Bq * aq ≠ 0 := hYpos.ne'
    generalize Bq * Bq + A * bq = X at h1 h3 hX0 ⊢
    generalize A * A + Bq * aq = Y at h1 h3 hY0 ⊢
    have e1 : X⁻¹ + aq / A = (aq * X + A) / (X * A) := by
      rw [inv_eq_one_div, div_add_div _ _ hX0 hAq]
      congr 1
      ring
    have e2 : Y⁻¹ + bq / Bq = (bq * Y + Bq) / (Y * Bq) := by
      rw [inv_eq_one_div, div_add_div _ _ hY0 hBq]
      congr 1
      ring
    rw [e1, e2, h1, h3, div_mul_div_comm, eq_comm,
      div_eq_one_iff_eq (mul_ne_zero (mul_ne_zero hX0 hAq) (mul_ne_zero hY0 hBq))]
    ring


