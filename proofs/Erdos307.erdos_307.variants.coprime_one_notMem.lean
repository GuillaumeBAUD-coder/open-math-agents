/-- The numerator of the reciprocal sum of a list over the common denominator `L.prod`. -/
def numer (L : List ℕ) : ℕ := (L.map (fun p => L.prod / p)).sum

/-- The whole certificate check: seed sets `P`, `Q` and the chain of deviations `Ds`. -/
def check (P Q Ds : List ℕ) : Bool :=
  decide (P.Nodup ∧ (∀ p ∈ P, 2 ≤ p) ∧ P.Pairwise Nat.Coprime ∧ P ≠ []) &&
  decide (Q.Nodup ∧ (∀ q ∈ Q, 2 ≤ q) ∧ Q.Pairwise Nat.Coprime ∧ Q ≠ []) &&
  decide (Nat.gcd P.prod Q.prod = 1) &&
  decide (numer P * numer Q < P.prod * Q.prod) &&
  loop Q.prod (P.prod * numer Q) Ds
    (Q.prod * (P.prod * Q.prod - numer P * numer Q) * Ds.prod)
    (P.prod * Q.prod - numer P * numer Q)
    ((P.prod * numer Q) % (Q.prod * (P.prod * Q.prod - numer P * numer Q) * Ds.prod))

lemma pairwise_toFinset : ∀ {l : List ℕ}, l.Pairwise Nat.Coprime →
    Set.Pairwise ((l.toFinset : Finset ℕ) : Set ℕ) Nat.Coprime
  | [], _ => by
      intro x hx
      simp at hx
  | a :: t, h => by
      rw [List.pairwise_cons] at h
      rw [List.toFinset_cons]
      exact pairwise_insert (pairwise_toFinset h.2)
        (fun c hc => h.1 c (List.mem_toFinset.mp hc))

lemma prod_toFinset_eq {l : List ℕ} (h : l.Nodup) : ∏ p ∈ l.toFinset, p = l.prod :=
  (List.prod_toFinset (fun p => p) h).trans (by rw [List.map_id'])

lemma sum_toFinset_eq {l : List ℕ} (h : l.Nodup) :
    ∑ p ∈ l.toFinset, l.prod / p = numer l :=
  List.sum_toFinset (fun p => l.prod / p) h

theorem sound (P Q Ds : List ℕ) (h : check P Q Ds = true) :
    type_of% @Erdos307.erdos_307.variants.coprime_one_notMem := by
  simp only [check, Bool.and_eq_true, decide_eq_true_eq] at h
  obtain ⟨⟨⟨⟨⟨hPnd, hP2, hPc, hPne⟩, ⟨hQnd, hQ2, hQc, hQne⟩⟩, hcop⟩, hlt⟩, hloop⟩ := h
  have hprodP := prod_toFinset_eq hPnd
  have hsumP := sum_toFinset_eq hPnd
  have hprodQ := prod_toFinset_eq hQnd
  have hsumQ := sum_toFinset_eq hQnd
  generalize P.prod = A at hprodP hsumP hcop hlt hloop
  generalize numer P = a at hsumP hlt hloop
  generalize Q.prod = B at hprodQ hsumQ hcop hlt hloop
  generalize numer Q = b at hsumQ hlt hloop
  have hinv : Inv B b (A * b) (B * (A * B - a * b) * Ds.prod) (A * B - a * b)
      ((A * b) % (B * (A * B - a * b) * Ds.prod)) := by
    refine ⟨P.toFinset, a, ?_, ?_, pairwise_toFinset hPc, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · exact (List.toFinset_nonempty_iff P).mpr hPne
    · intro p hp
      exact hP2 p (List.mem_toFinset.mp hp)
    · have h1 := sum_inv_eq P.toFinset
        (fun p hp => by have := hP2 p (List.mem_toFinset.mp hp); omega)
      simp only [hprodP] at h1
      rw [hsumP] at h1
      rw [hprodP]
      exact h1
    · rw [hprodP]
      omega
    · rw [hprodP]
      exact (Nat.mod_modEq _ _).symm
    · rw [hprodP]
    · rw [hprodP]
      exact hcop
    · omega
  obtain ⟨M', e', hfin⟩ := loop_sound Ds _ _ _ hinv hloop
  exact closing Q.toFinset ((List.toFinset_nonempty_iff Q).mpr hQne)
    (fun q hq => hQ2 q (List.mem_toFinset.mp hq)) (pairwise_toFinset hQc)
    hprodQ.symm hsumQ.symm hfin

end E307c

theorem OMA.solution : type_of% @Erdos307.erdos_307.variants.coprime_one_notMem :=
  E307c.sound E307c.P0 E307c.Q0 E307c.Ds (by decide +kernel)
