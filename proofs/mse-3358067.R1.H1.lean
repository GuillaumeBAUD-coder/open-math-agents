import OMAReductions.R_mse_3358067_R1

/-! For each 4 ≤ n ≤ 200 there is a prime p (found by computer search) dividing
P = (1² + 1)(2² + 1)⋯(n² + 1) exactly once: p ∣ P and p² ∤ P, both checked by the kernel.
A square divisible by a prime p is divisible by p², so P is not a square. -/

namespace OMA.Mse3358067

theorem not_sq {N : ℕ} (p : ℕ) (hp : p.Prime) (h1 : p ∣ N) (h2 : ¬ p ^ 2 ∣ N) :
    ¬ IsSquare N := by
  rintro ⟨k, rfl⟩
  have hk : p ∣ k := (hp.dvd_mul.1 h1).elim id id
  obtain ⟨c, rfl⟩ := hk
  exact h2 ⟨c * c, by ring⟩

end OMA.Mse3358067

