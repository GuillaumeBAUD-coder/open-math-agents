lemma center4 (r : Fin 97 → Bool) (hr : r (Fin.ofNat 97 44) = true)
    (hb : ∀ i : Fin 97, 44 < i.val → i.val < 52 → r i = false) : Mono r := by
  by_contra hn
  apply node20 (Red r) (noTriple_of_not_mono hn) (all_hit hn)
  · intro x hx
    have he : x = 44 := by simpa using hx
    exact he ▸ ⟨by decide, hr⟩
  · intro x hx
    obtain ⟨hbound97,hred⟩ := hx
    have hbound : x ≤ 44 ∨ 52 ≤ x := by
      by_contra! bad
      have hblue := hb ⟨x,hbound97⟩ bad.1 bad.2
      have he : (Fin.ofNat 97 x) = ⟨x,hbound97⟩ := Fin.ext (Nat.mod_eq_of_lt hbound97)
      exact Bool.noConfusion (hred.symm.trans ((congrArg r he).trans hblue))
    have hbits : ∀ t : Fin 97, t.val ≤ 44 ∨ 52 ≤ t.val →
        Nat.testBit 0x1fffffffffff01fffffffffff t.val = true := by decide +kernel
    exact hbits ⟨x,hbound97⟩ hbound

