/- At threshold t, at least as many available multipliers must be omitted as there
are entries of this list at most t. The omitted multipliers can depend on the set. -/
private def holes : List ℕ := [3, 6, 9, 12, 18, 24, 32, 36, 48, 64, 72, 96, 108, 128, 144, 192, 216, 243, 288, 324, 384, 432, 486, 576, 648, 729, 768, 864, 972, 1152, 1296, 1458, 1536, 1728, 1944, 2187, 2304, 2592, 2916, 3072, 3456, 3888, 4374, 4608, 5184, 5832, 6144, 6912, 7776, 8192, 8748, 9216, 10368]
private def unitSize : ℕ := 17915904

private def avail (t : ℕ) := vals.filter fun v => v ≤ t
private def lost (t : ℕ) := holes.toFinset.filter fun v => v ≤ t

private def certificate (t : ℕ) : Bool :=
  let m := flags (fun v => decide (v ≤ t)) vals
  (List.range r0.size).any fun i =>
    let e := r0.get i
    decide (e.mask = m ∧ (lost t).card + e.bound ≤ (avail t).toFinset.card)

set_option maxRecDepth 20000 in
set_option maxHeartbeats 0 in
private theorem cert : (0 :: vals).all certificate = true := by decide +kernel

private theorem holes_mem {v : ℕ} (hv : v ∈ holes) : v ∈ vals :=
  of_decide_eq_true (List.all_eq_true.mp (show holes.all (fun v => decide (v ∈ vals)) = true by decide +kernel) v hv)



private theorem certified (t : ℕ) :
    ∃ z, Limit (avail t) z ∧ (lost t).card + z ≤ (avail t).toFinset.card := by
  let S := insert 0 (avail t).toFinset
  have hn : S.Nonempty := ⟨0,mem_insert_self ..⟩
  let m := S.max' hn
  have hm : m ∈ S := S.max'_mem hn
  have hmax {v : ℕ} (hv : v ∈ vals) (le : v ≤ t) : v ≤ m :=
    S.le_max' v (mem_insert_of_mem (List.mem_toFinset.mpr (List.mem_filter.mpr ⟨hv,by simpa using le⟩)))
  have hmt : m ≤ t := by
    rcases mem_insert.mp hm with e | e
    · omega
    · simpa using (List.mem_filter.mp (List.mem_toFinset.mp e)).2
  have hmv : m ∈ 0::vals := by
    rcases mem_insert.mp hm with e | e
    · simp [e]
    · exact List.mem_cons_of_mem _ (List.mem_filter.mp (List.mem_toFinset.mp e)).1
  have av : avail m = avail t := by
    apply List.filter_congr
    intro x hx
    simp only [decide_eq_decide]
    exact ⟨fun h => h.trans hmt, hmax hx⟩
  have lo : lost m = lost t := by
    ext x
    simp only [lost,mem_filter,List.mem_toFinset]
    exact ⟨fun ⟨hx,h⟩ => ⟨hx,h.trans hmt⟩,fun ⟨hx,h⟩ => ⟨hx,hmax (holes_mem hx) h⟩⟩

  obtain ⟨i,hi,ec⟩ := List.any_eq_true.mp (List.all_eq_true.mp cert m hmv)
  let e := r0.get i
  obtain ⟨eq,upper⟩ := of_decide_eq_true ec
  have h := ok0 i (List.mem_range.mp hi)
  change Limit (active vals e.mask) e.bound at h
  rw [eq,active_flags] at h
  change Limit (avail m) e.bound at h
  exact ⟨e.bound,av ▸ h,by simpa only [lo,av] using upper⟩
private def rough (q : ℕ) : Prop := q % 6 = 1 ∨ q % 6 = 5
private instance (q : ℕ) : Decidable (rough q) := inferInstanceAs (Decidable (_ ∨ _))
private theorem rough_pos {q : ℕ} (hq : rough q) : 0 < q := by unfold rough at hq; omega
private theorem rough_core {q : ℕ} (hq : rough q) : core q = q := by
  unfold rough at hq
  exact core_self (by omega) (by omega)

private theorem vals_spec : vals.all (fun v => decide (0 < v ∧ core v = 1)) = true := by
  decide +kernel

private theorem vprop {v : ℕ} (hv : v ∈ vals) : 0 < v ∧ core v = 1 :=
  of_decide_eq_true (List.all_eq_true.mp vals_spec v hv)

private def missing (A : Finset ℕ) (n q : ℕ) :=
  (((avail (n/q)).toFinset).filter fun v => q*v ∉ A).image (q * ·)

private theorem local_bound (A : Finset ℕ) (hf : ForkFree (A : Set ℕ)) (n q : ℕ)
    (qp : 0 < q) : (lost (n/q)).card ≤ (missing A n q).card := by
  classical
  let F := (avail (n/q)).toFinset
  let X := F.filter fun v => q*v ∈ A
  have xsub : ∀ x ∈ X, x ∈ avail (n/q) := fun _ hx => List.mem_toFinset.mp (mem_filter.mp hx).1
  have xf : ForkFree (X : Set ℕ) := by
    intro a ha b hb c hc
    have inj : Function.Injective (q * ·) := mul_right_injective₀ qp.ne'
    apply inj
    apply hf (q*a) (mem_filter.mp ha).2
    · exact ⟨⟨(mem_filter.mp hb.1.1).2, fun h => hb.1.2 (inj h)⟩,mul_dvd_mul_left q hb.2⟩
    · exact ⟨⟨(mem_filter.mp hc.1.1).2, fun h => hc.1.2 (inj h)⟩,mul_dvd_mul_left q hc.2⟩
  obtain ⟨z,b,hc⟩ := certified (n/q)
  have h := b X xsub xf
  have hp := F.card_filter_add_card_filter_not (fun v => q*v ∈ A)
  rw [missing,card_image_of_injective _ (mul_right_injective₀ qp.ne')]
  change (lost (n/q)).card ≤ (F.filter fun v => q*v ∉ A).card
  change X.card + _ = F.card at hp
  change _ ≤ F.card at hc
  omega


private def qs (n : ℕ) := (range (n+1)).filter rough

private theorem missing_spec {A : Finset ℕ} {n q x : ℕ} (hq : rough q)
    (hx : x ∈ missing A n q) : x ∈ Icc 1 n ∧ x ∉ A ∧ core x = q := by
  obtain ⟨v,hv,rfl⟩ := mem_image.mp hx
  obtain ⟨hv,ha⟩ := mem_filter.mp hv
  obtain ⟨hval,hl⟩ := List.mem_filter.mp (List.mem_toFinset.mp hv)
  have vp := vprop hval
  have qp := rough_pos hq
  have le : v ≤ n/q := of_decide_eq_true hl
  refine ⟨mem_Icc.mpr ⟨Nat.mul_pos qp vp.1,?_⟩,ha,?_⟩
  · simpa [mul_comm] using (Nat.le_div_iff_mul_le qp).mp le
  · rw [core_mul,rough_core hq,vp.2,mul_one]

private theorem total_bound (A : Finset ℕ) (n : ℕ) (hA : A ⊆ Icc 1 n)
    (hf : ForkFree (A : Set ℕ)) :
    A.card + ∑ q ∈ qs n, (lost (n/q)).card ≤ n := by
  classical
  have dis : ((qs n : Finset ℕ) : Set ℕ).PairwiseDisjoint (missing A n) := by
    intro q hq r hr ne
    apply Finset.disjoint_left.mpr
    intro x hx hy
    exact ne ((missing_spec (mem_filter.mp hq).2 hx).2.2.symm.trans
      (missing_spec (mem_filter.mp hr).2 hy).2.2)
  have sub : (qs n).biUnion (missing A n) ⊆ Icc 1 n \ A := by
    intro x hx
    obtain ⟨q,hq,hx⟩ := mem_biUnion.mp hx
    obtain ⟨hx,ha,_⟩ := missing_spec (mem_filter.mp hq).2 hx
    exact mem_sdiff.mpr ⟨hx,ha⟩
  have sm := sum_le_sum (s := qs n) (fun q hq =>
    local_bound A hf n q (rough_pos (mem_filter.mp hq).2))
  have hu := card_le_card sub
  rw [card_biUnion dis] at hu
  have add := card_sdiff_add_card_eq_card hA
  rw [Nat.card_Icc] at add
  omega

private theorem count_rough (k : ℕ) : Nat.count rough (6*k) = 2*k := by
  induction k with
  | zero => simp
  | succ k ih =>
    rw [Nat.mul_succ]
    iterate 6 rw [Nat.count_succ]
    simp [ih,rough,Nat.add_mod,Nat.mul_succ]

private theorem count_up_to (k : ℕ) : (qs (6*k)).card = 2*k := by
  rw [qs,← Nat.count_eq_card_filter_range,Nat.count_succ,count_rough]
  simp [rough]

private theorem weight_spec : holes.all (fun v => decide (v ∣ unitSize)) = true := by decide +kernel
private theorem unit_pos : 0 < unitSize := by decide
private theorem weight_sum :
    100000 * (∑ v ∈ holes.toFinset, 2 * (unitSize/v)) ≥ 32644 * (6*unitSize) := by decide +kernel

/- Each token v counts once for each q coprime to six with q*v ≤ n. Taking n a
multiple of six times the common denominator makes these counts exact. -/
private theorem count_tokens (k : ℕ) :
    ∑ q ∈ qs (6*unitSize*k), (lost ((6*unitSize*k)/q)).card =
      (∑ v ∈ holes.toFinset, 2*(unitSize/v))*k := by
  classical
  let n := 6*unitSize*k
  change (∑ q ∈ qs n, (lost (n/q)).card) = _
  simp only [lost,card_filter]
  rw [sum_comm,sum_mul]
  apply sum_congr rfl
  intro v hv
  have vp := (vprop (holes_mem (List.mem_toFinset.mp hv))).1
  have dvd := of_decide_eq_true (List.all_eq_true.mp weight_spec v (List.mem_toFinset.mp hv))
  have div : n/v = 6*((unitSize/v)*k) := by
    have e := Nat.div_mul_cancel dvd
    change (6*unitSize*k)/v = _
    conv_lhs => rw [← e]
    rw [show 6*(unitSize/v*v)*k = (6*((unitSize/v)*k))*v by ring,Nat.mul_div_cancel _ vp]
  have same : ((qs n).filter (fun q => v ≤ n/q)) = qs (n/v) := by
    ext q
    simp only [qs,mem_filter,mem_range,Nat.lt_succ_iff]
    constructor
    · rintro ⟨⟨_,hq⟩,le⟩
      refine ⟨(Nat.le_div_iff_mul_le vp).mpr ?_,hq⟩
      simpa [mul_comm] using (Nat.le_div_iff_mul_le (rough_pos hq)).mp le
    · rintro ⟨le,hq⟩
      refine ⟨⟨le.trans (Nat.div_le_self ..),hq⟩,(Nat.le_div_iff_mul_le (rough_pos hq)).mpr ?_⟩
      simpa [mul_comm] using (Nat.le_div_iff_mul_le vp).mp le
  rw [← card_filter,same,div,count_up_to]
  ring


private theorem finite_upper (A : Finset ℕ) (k : ℕ) (hA : A ⊆ Icc 1 (6*unitSize*k))
    (hf : ForkFree (A : Set ℕ)) : 100000*A.card ≤ 67356*(6*unitSize*k) := by
  have h := total_bound A _ hA hf
  rw [count_tokens] at h
  have w := Nat.mul_le_mul_right k weight_sum
  rw [mul_assoc 100000 _ k] at w
  rw [mul_assoc 32644 _ k] at w
  omega

private theorem upper (n : ℕ) (large : 20000*(6*unitSize) ≤ n) :
    (f n : ℝ) ≤ 0.6736 * n := by
  classical
  let m := 6*unitSize
  have mp : 0 < m := Nat.mul_pos (by decide) unit_pos
  let k := n/m+1
  have ceil_le : n ≤ m*k := by
    have e := Nat.mod_add_div n m
    have h := Nat.mod_lt n mp
    dsimp [k]
    rw [Nat.mul_succ]
    omega
  have excess : m*k ≤ n+m := by
    dsimp [k]
    rw [Nat.mul_succ]
    exact Nat.add_le_add_right (Nat.mul_div_le n m) _
  have ex : ∃ A ⊆ Set.Icc 1 n, ForkFree A ∧ A.ncard = f n := by
    unfold f
    apply Nat.findGreatest_spec (P := fun k => ∃ A ⊆ Set.Icc 1 n, ForkFree A ∧ A.ncard = k) (m := 0) (Nat.zero_le _)
    exact ⟨∅,Set.empty_subset _,by simp [ForkFree],by simp⟩
  obtain ⟨A,As,hf,he⟩ := ex
  have af := (Set.finite_Icc 1 n).subset As
  have sub : af.toFinset ⊆ Icc 1 (6*unitSize*k) := by
    intro x hx
    exact mem_Icc.mpr ⟨(As (af.mem_toFinset.mp hx)).1,(As (af.mem_toFinset.mp hx)).2.trans ceil_le⟩
  have U := finite_upper af.toFinset k sub (by simpa using hf)
  rw [← Set.ncard_eq_toFinset_card A af,he] at U
  change 100000 * f n ≤ 67356*(m*k) at U
  change 20000*m ≤ n at large
  have num : 100000*f n ≤ 67360*n := by omega
  have realnum : (100000:ℝ)*f n ≤ 67360*n := by exact_mod_cast num
  linarith

end LebensoldUpper

theorem OMA.solution : OMA.R_Erdos1062_erdos_1062_variants_lebensold_bounds_R1.H2 := by
  exact Filter.eventually_atTop.2 ⟨_,fun n h => LebensoldUpper.upper n h⟩

