private def oddBase (x : ℕ) := ordCompl[2] x
private def core (x : ℕ) := ordCompl[3] (oddBase x)

private theorem core_mul (a b : ℕ) : core (a*b) = core a * core b := by
  simp only [core,oddBase,Nat.ordCompl_mul]

private theorem core_self {q : ℕ} (h2 : ¬ 2 ∣ q) (h3 : ¬ 3 ∣ q) : core q = q := by
  simp only [core,oddBase,(Nat.ordCompl_eq_self_iff_zero_or_not_dvd q Nat.prime_two).mpr (Or.inr h2),
    (Nat.ordCompl_eq_self_iff_zero_or_not_dvd q Nat.prime_three).mpr (Or.inr h3)]


