import OMAReductions.R_Erdos1062_erdos_1062_variants_lebensold_bounds_R1
/-! Group integers by their part coprime to six. For each group, use a finite
certificate for the 68 multipliers of the form 2^i * 3^j up to 10368. The finite
branching argument either omits the least available element or allows at most one
of its larger multiples. -/
open Finset Filter Erdos1062
namespace LebensoldUpper

private theorem fork_mono {X Y : Finset ℕ} (h : ForkFree (Y : Set ℕ)) (sub : X ⊆ Y) :
    ForkFree (X : Set ℕ) := by
  intro a ha b hb c hc
  apply h a (sub ha)
  · exact ⟨⟨sub hb.1.1,hb.1.2⟩,hb.2⟩
  · exact ⟨⟨sub hc.1.1,hc.1.2⟩,hc.2⟩


private def Limit (l : List ℕ) (z : ℕ) : Prop :=
  ∀ X : Finset ℕ, (∀ x ∈ X, x ∈ l) → ForkFree (X : Set ℕ) → X.card ≤ z

private theorem limit_empty (z : ℕ) : Limit [] z := by
  intro X sub _
  have : X = ∅ := eq_empty_iff_forall_notMem.mpr (fun x hx => by simpa using sub x hx)
  simp [this]

private theorem limit_step {a u z : ℕ} {l : List ℕ} (base : Limit l u)
    (bound : u+1 ≤ z ∨ (u ≤ z ∧ ∃ w, Limit (l.filter (fun b => !(a ∣ b))) w ∧ 2+w ≤ z)) :
    Limit (a::l) z := by
  classical
  intro X hsub hf
  let Y := X.erase a
  have ys : ∀ x ∈ Y, x ∈ l := fun x hx =>
    (List.mem_cons.mp (hsub x (mem_erase.mp hx).2)).resolve_left (mem_erase.mp hx).1
  have ysub : Y ⊆ X := erase_subset _ _
  have b := base Y ys (fork_mono hf ysub)
  by_cases ha : a ∈ X
  · have size : X.card = Y.card+1 := (card_erase_add_one ha).symm
    rcases bound with small | ⟨_,w,remb,wh⟩
    · omega
    let D := Y.filter (a ∣ ·)
    let R := Y \ D
    have hD : D.card ≤ 1 := card_le_one.mpr (by
      intro x hx y hy
      obtain ⟨hx,ax⟩ := mem_filter.mp hx
      obtain ⟨hy,ay⟩ := mem_filter.mp hy
      exact hf a ha ⟨⟨ysub hx,(mem_erase.mp hx).1⟩,ax⟩ ⟨⟨ysub hy,(mem_erase.mp hy).1⟩,ay⟩)
    have rb := remb R (fun x hx => List.mem_filter.mpr ⟨ys x (mem_sdiff.mp hx).1,by
      simpa using (show ¬ a ∣ x from fun ax =>
        (mem_sdiff.mp hx).2 (mem_filter.mpr ⟨(mem_sdiff.mp hx).1,ax⟩))⟩)
      (fork_mono hf (sdiff_subset.trans ysub))
    have add : R.card+D.card = Y.card := card_sdiff_add_card_eq_card (filter_subset _ _)
    omega
  · have e : Y = X := erase_eq_of_notMem ha
    rw [e] at b
    rcases bound with h | h <;> omega

private def active : List ℕ → ℕ → List ℕ
  | [], _ => []
  | a::xs,m => if m.testBit 0 then a :: active xs (m >>> 1) else active xs (m >>> 1)

private def flags (p : ℕ → Bool) : List ℕ → ℕ
  | [] => 0
  | a::xs => Nat.bit (p a) (flags p xs)

private theorem active_flags (p : ℕ → Bool) (l : List ℕ) : active l (flags p l) = l.filter p := by
  induction l with
  | nil => rfl
  | cons a xs ih =>
    simp only [active,flags,Nat.testBit_bit_zero,Nat.bit_shiftRight_one,List.filter_cons,ih]

private theorem active_clear (p : ℕ → Bool) (l : List ℕ) (m : ℕ) :
    active l (m ^^^ (m &&& flags p l)) = (active l m).filter (fun x => !p x) := by
  induction l generalizing m with
  | nil => rfl
  | cons a xs ih =>
    simp only [active,flags,Nat.testBit_xor,Nat.testBit_and,Nat.testBit_bit_zero,
      Nat.shiftRight_xor_distrib,Nat.shiftRight_and_distrib,Nat.bit_shiftRight_one,ih]
    cases m.testBit 0 <;> cases h : p a <;> simp [h]

private structure Cell where
  mask : ℕ
  bound : ℕ
  skip : ℕ
  take : ℕ
  deriving Inhabited

/- A row packs each mask and its bound and two successor indices into one 96-bit word. -/
private structure Row where
  size : ℕ
  words : ℕ

private def Row.get (r : Row) (i : ℕ) : Cell :=
  if i < r.size then
    let w := (r.words >>> (96*i)) % 2^96
    ⟨w >>> 24,(w >>> 16)%256,(w >>> 8)%256,w%256⟩
  else default

private def checked (c : ℕ) (next : Row) (e : Cell) : Bool :=
  let u := next.get e.skip
  let v := next.get e.take
  let r := e.mask >>> 1
  let d := r &&& c
  decide (u.mask = r ∧ u.bound ≤ e.bound ∧
    (e.mask.testBit 0 = false ∨ u.bound+1 ≤ e.bound ∨
      (v.mask = r ^^^ d ∧ 2+v.bound ≤ e.bound)))

private def Sound (l : List ℕ) (row : Row) : Prop :=
  ∀ i < row.size, Limit (active l (row.get i).mask) (row.get i).bound

private theorem active_zero (l : List ℕ) : active l 0 = [] := by
  induction l <;> simp_all [active]

private theorem lookup_sound {l : List ℕ} {r : Row} (h : Sound l r) (i : ℕ) :
    let e := r.get i
    Limit (active l e.mask) e.bound := by
  by_cases hi : i < r.size
  · exact h i hi
  · simpa [Row.get,hi,show (default : Cell).mask = 0 by rfl,active_zero] using (limit_empty (default : Cell).bound)

private theorem advance {a : ℕ} {l : List ℕ} {row next : Row}
    (h : Sound l next) (cert : (List.range row.size).all (fun i => checked (flags (fun b => decide (a ∣ b)) l) next (row.get i)) = true) :
    Sound (a::l) row := by
  intro i hi
  let e := row.get i
  change Limit (active (a::l) e.mask) e.bound
  have ec : checked (flags (fun b => decide (a ∣ b)) l) next e = true := List.all_eq_true.mp cert i (List.mem_range.mpr hi)
  obtain ⟨em,le,hc⟩ := of_decide_eq_true ec
  have u := lookup_sound h e.skip
  have v := lookup_sound h e.take
  dsimp only at u v
  rw [em] at u
  rw [active]
  split
  · rename_i bit
    apply limit_step u
    rcases hc with no | yes | ⟨ev,lv⟩
    · simp_all
    · exact Or.inl yes
    · rw [ev,active_clear] at v
      exact Or.inr ⟨le,_,v,lv⟩
  · intro X xs hf
    exact (u X xs hf).trans le

