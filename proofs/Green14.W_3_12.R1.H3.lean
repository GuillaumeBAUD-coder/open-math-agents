import OMAReductions.R_Green14_W_3_12_R1

/-!
# A common 134-position obstruction for the three central cases

A shift by zero or one places a false point at 64 followed by four true
points. On this 134-position interval, a coloring avoiding both progressions
would give a triple-free set of false points meeting every 12-term progression.

The search records known false points and a mask containing all points still
allowed to be false. It branches on a point or intersects a progression with
that mask. An empty intersection is a contradiction. A singleton forces
its point to be false. Each certificate checks a subtree and can call on
previously checked subtrees after comparing their initial states.

The pair-exclusion and progression-mask arguments are adapted from Vincent T.
Mossman's proof of Green14.W_3_11.R1.H3.
-/
namespace OMA.Green135

def extra (x y : Nat) : Nat :=
  let a := min x y
  let d := max x y - a
  if d = 0 then 0 else
    (1 <<< (a+2*d)) ||| (if d ≤ a then 1 <<< (a-d) else 0) |||
      (if d%2=0 then 1 <<< (a+d/2) else 0)

def removeMask (allowed bad : Nat) := allowed ^^^ (allowed &&& bad)

def bluePattern (a d : Nat) : Nat :=
  (List.range 12).foldr (fun t m => (1 <<< (a+t*d)) ||| m) 0

def NoTriple (R : ℕ → Prop) := ∀ a d, 0 < d → R a → R (a+d) → R (a+2*d) → False

lemma extra_safe {R : ℕ → Prop} (h : NoTriple R) {x y t : ℕ}
    (hx : R x) (hy : R y) (ht : R t) : (extra x y).testBit t = false := by
  suffices ordered : ∀ a d : ℕ, 0 < d → R a → R (a+d) →
      t ≠ a+2*d ∧ (d ≤ a → t ≠ a-d) ∧ (d%2=0 → t ≠ a+d/2) by
    unfold extra
    rcases le_total x y with hxy | hyx
    · rw [min_eq_left hxy, max_eq_right hxy]
      dsimp only
      by_cases hz : y-x=0
      · simp [hz]
      have hb : R (x+(y-x)) := by simpa [Nat.add_sub_of_le hxy] using hy
      obtain ⟨h₁,h₂,h₃⟩ := ordered x (y-x) (by omega) hx hb
      split_ifs <;> simp_all [Nat.shiftLeft_eq, Nat.testBit_two_pow] <;> omega
    · rw [min_eq_right hyx, max_eq_left hyx]
      dsimp only
      by_cases hz : x-y=0
      · simp [hz]
      have hb : R (y+(x-y)) := by simpa [Nat.add_sub_of_le hyx] using hx
      obtain ⟨h₁,h₂,h₃⟩ := ordered y (x-y) (by omega) hy hb
      split_ifs <;> simp_all [Nat.shiftLeft_eq, Nat.testBit_two_pow] <;> omega
  intro a d hd ha hb
  refine ⟨fun he => h a d hd ha hb (he ▸ ht), ?_, ?_⟩
  · intro hle he
    apply h (a-d) d hd (he ▸ ht)
    · simpa [Nat.sub_add_cancel hle] using ha
    · convert hb using 1 <;> omega
  · intro heven he
    apply h a (d/2) (by omega) ha (he ▸ ht)
    convert hb using 1 <;> omega

lemma remove_safe {a b t : ℕ} (ha : a.testBit t = true) (hb : b.testBit t = false) :
    (removeMask a b).testBit t = true := by simp [removeMask, Nat.testBit_xor, ha, hb]

def Mono (r : ℕ → Bool) := ∃ (b : Bool) (a d : ℕ), 0 < d ∧
  a + (if b then 11 else 2)*d < 134 ∧ ∀ t ≤ (if b then 11 else 2), r (a+t*d) = b

def Red (r : ℕ → Bool) (x : ℕ) := x < 134 ∧ r x = false

lemma noTriple {r : ℕ → Bool} (hn : ¬ Mono r) : NoTriple (Red r) := by
  intro a d hd h₀ h₁ h₂
  apply hn
  refine ⟨false,a,d,hd,h₂.1,?_⟩
  intro t ht
  change t ≤ 2 at ht
  interval_cases t <;> simp_all [Red]

lemma pattern_has {t : ℕ} (ht : t < 12) (a d : ℕ) :
    (bluePattern a d).testBit (a+t*d) = true := by
  suffices ∀ xs : List ℕ, t ∈ xs → (xs.foldr (fun i m : ℕ => (1 <<< (a+i*d)) ||| m) 0).testBit (a+t*d) = true from
    this _ (List.mem_range.mpr ht)
  intro xs
  induction xs with
  | nil => simp
  | cons u xs ih =>
    intro hm
    rcases List.mem_cons.mp hm with rfl | h
    · simp [Nat.shiftLeft_eq, Nat.testBit_two_pow]
    · simp [ih h]

def bases : Array ℕ := #[1, 0xfff, 0x555555, 0x249249249, 0x111111111111, 0x84210842108421, 0x41041041041041041, 0x20408102040810204081, 0x10101010101010101010101, 0x8040201008040201008040201, 0x4010040100401004010040100401, 0x2004008010020040080100200400801, 0x1001001001001001001001001001001001]

lemma base_correct : ∀ d : Fin 13, bases[d.val]! = bluePattern 0 d.val := by decide +kernel

def pattern (a d : ℕ) : ℕ :=
  if 0 < d ∧ a + 11*d < 134 then bases[d]! <<< a else bases[1]!

def Hits (R : ℕ → Prop) := ∀ a d, ∃ x, (pattern a d).testBit x = true ∧ R x

lemma shifted_hit {r : ℕ → Bool} (hn : ¬ Mono r) {a d : ℕ}
    (hd : 0 < d) (hb : a+11*d < 134) :
    ∃ x, ((bases[d]!) <<< a).testBit x = true ∧ Red r x := by
  by_contra! bad
  apply hn
  refine ⟨true,a,d,hd,hb,?_⟩
  intro t ht
  change t ≤ 11 at ht
  have hx : a+t*d < 134 := by have := Nat.mul_le_mul_right d ht; omega
  have hbit : ((bases[d]!) <<< a).testBit (a+t*d) = true := by
    rw [base_correct ⟨d,by omega⟩]
    simpa [Nat.testBit_shiftLeft, Nat.le_add_right] using pattern_has (by omega : t < 12) 0 d
  exact Bool.eq_true_of_not_eq_false fun hh => bad _ hbit ⟨hx,hh⟩

lemma hits {r : ℕ → Bool} (hn : ¬ Mono r) : Hits (Red r) := by
  intro a d
  unfold pattern
  split
  · exact shifted_hit hn (by tauto) (by tauto)
  · simpa using shifted_hit hn (a:=0) (d:=1) (by decide) (by decide)

-- Store the doubled, reflected and halved coordinates in disjoint bit fields.
-- A shift in each field recovers the three possible completions of a pair.
def atom (q : Nat) : Nat :=
  (1 <<< (2*q)) ||| (1 <<< (634-q)) ||| (1 <<< ((if q%2=0 then 925 else 1120)+q/2))

def view : List Nat → Nat
  | [] => 0
  | q::rs => atom q ||| view rs

def vBans (p v : Nat) : Nat :=
  (((v >>> p) ||| (v >>> (634-2*p)) ||| (v >>> ((if p%2=0 then 925 else 1120) - (p+1)/2))) &&&
    (2^134-1))

lemma vBans_or (p v w : Nat) : vBans p (v ||| w) = vBans p v ||| vBans p w := by
  unfold vBans
  simp only [Nat.shiftRight_or_distrib, Nat.and_or_distrib_right]
  ac_rfl

set_option maxHeartbeats 10000000 in
lemma vBans_one : ∀ p q : Fin 134,
    removeMask (vBans p.val (atom q.val)) (1 <<< p.val) = extra p.val q.val &&& (2^134-1) := by
  decide +kernel

def pvAfter (rs : List Nat) (a p : Nat) : Nat :=
  removeMask a (removeMask (vBans p (view rs)) (1 <<< p))

lemma pv_safe {R : Nat → Prop} (hn : NoTriple R) {rs : List Nat} {a p t : Nat}
    (hr : ∀ q ∈ rs, R q) (bound : ∀ q, R q → q < 134)
    (hp : R p) (ht : R t) (ha : a.testBit t = true) :
    (pvAfter rs a p).testBit t = true := by
  apply remove_safe ha
  by_cases eq : p = t
  · subst t
    simp [removeMask, Nat.shiftLeft_eq, Nat.testBit_xor]
  · have hbit : (1 <<< p : Nat).testBit t = false := by simp [Nat.shiftLeft_eq, eq]
    suffices h : (vBans p (view rs)).testBit t = false by simp [removeMask, Nat.testBit_xor, h]
    induction rs with
    | nil => simp [view, vBans]
    | cons q qs ih =>
      have hq := hr q (by simp)
      have he := congrArg (fun m : Nat => m.testBit t) (vBans_one ⟨p,bound _ hp⟩ ⟨q,bound _ hq⟩)
      simp [removeMask, Nat.testBit_xor, hbit, extra_safe hn hp hq ht] at he
      rw [view, vBans_or, Nat.testBit_or, he, ih (fun x hx => hr x (by simp [hx]))]
      rfl

-- Powers of two below 2^135 have distinct residues modulo 139.
-- The search checks the recovered singleton before using it.
def bitIndex (bit : Nat) := (0x45466e47116f77480d12077085783a49260e82131608607167863679193b7d4a3027430f0b83241465172e0963611d721f684f0074375d7a211a5a3c6a7e3f4b5131552800446d10760c0684392581155f6635187c2f420a23642d621c1e4e735c2059693e5054006c750538805e347b41222c1b4d5b583d536b047f33402b4c575203322a560229010000 >>> (8*(bit%139))) % 256

def firstBit (x : Nat) := bitIndex (x - (x &&& (x-1)))

def full : Nat := 2^134-1

-- At each starting position the low-count mask detects windows that are all
-- blue, or allow only one additional red point, with no previously chosen red.
def probe (blue free d : Nat) : Nat :=
  let b2 := blue &&& (blue >>> d)
  let b4 := b2 &&& (b2 >>> (2*d))
  let b8 := b4 &&& (b4 >>> (4*d))
  let b12 := b8 &&& (b4 >>> (8*d))
  if b12 != 0 then 128*d+firstBit b12 else
  let u2 := (free &&& (blue >>> d)) ||| (blue &&& (free >>> d))
  let u4 := (u2 &&& (b2 >>> (2*d))) ||| (b2 &&& (u2 >>> (2*d)))
  let u8 := (u4 &&& (b4 >>> (4*d))) ||| (b4 &&& (u4 >>> (4*d)))
  let u12 := (u8 &&& (b4 >>> (8*d))) ||| (b8 &&& (u4 >>> (8*d)))
  if u12 != 0 then 128*d+firstBit u12 else 0

def erasePt (a p : Nat) := removeMask a (1 <<< p)

def Bad (s : List ℕ × ℕ) := ∀ R : ℕ → Prop, NoTriple R → Hits R → (∀ q, R q → q < 134) →
    (∀ x ∈ s.1, R x) → (∀ x, R x → s.2.testBit x = true) → False

def gate (leaves : Array {s // Bad s}) (k : ℕ) (rs : List ℕ) (a : ℕ) : Bool :=
  match leaves[k]? with
  | some leaf => leaf.val == (rs,a)
  | none => false

lemma gate_sound (leaves : Array {s // Bad s}) {R : ℕ → Prop} (hn : NoTriple R) (hit : Hits R) (bound : ∀ q, R q → q < 134)
    (k : ℕ) (rs : List ℕ) (a : ℕ) (hr : ∀ x ∈ rs, R x) (ha : ∀ x, R x → a.testBit x = true) :
    gate leaves k rs a ≠ true := by
  unfold gate
  split
  · rename_i t he
    intro hh
    have hbad := t.property
    rw [beq_iff_eq.mp hh] at hbad
    exact hbad R hn hit bound hr ha
  · decide

-- Decode the hinted common difference (zero requests a split) and the next tape position.
def instruction (tape i a free : Nat) : Nat × Nat :=
  let tag := ( >>> (8*((tape >>> (i-1)) % 256))) % 256
  let d := tag%16
  (if d = 0 then 0 else probe (full ^^^ a) free d, i+tag/16)

-- Evaluate the arithmetic state at a recursive call.
def forceN {α : Type} (x : Nat) (f : Nat → α) : α :=
  match x with
  | 0 => f 0
  | n+1 => f (n+1)

lemma forceN_eq {α : Type} (x : Nat) (f : Nat → α) : forceN x f = f x := by cases x <;> rfl

def walk (leaves : Array {s // Bad s}) (tape : Nat) : Nat → Nat → List Nat → Nat → Nat → Nat
  | 0, _, _, _, _ => 0
  | gas+1, i, rs, a, free =>
    forceN a fun a => forceN free fun free => forceN i fun i =>
    let (z,i) := instruction tape i a free
    if z != 0 then
      let rest := pattern (z%128) (z/128) &&& a
      if rest = 0 then i else
      forceN (bitIndex rest) fun p =>
      if rest = 1 <<< p then
        walk leaves tape gas i (p::rs) (pvAfter rs a p) (erasePt free p)
      else 0
    else
      forceN ((tape >>> (i-1)) % 256) fun p =>
      if 135 ≤ p then
        if gate leaves (p-135) rs a then i+8 else 0
      else
        let j := walk leaves tape gas (i+8) (p::rs) (pvAfter rs a p) (erasePt free p)
        if j = 0 then 0 else walk leaves tape gas j rs (erasePt a p) free

lemma erase_safe {R : ℕ → Prop} {a p t : ℕ} (hp : ¬ R p) (ht : R t)
    (ha : a.testBit t = true) : (erasePt a p).testBit t = true := by
  apply remove_safe ha
  simp [Nat.shiftLeft_eq, Nat.testBit_two_pow, (show p ≠ t by rintro rfl; exact hp ht)]

lemma walk_sound (leaves : Array {s // Bad s}) (tape : ℕ)
    {R : ℕ → Prop} (hn : NoTriple R) (hit : Hits R) (bound : ∀ q, R q → q < 134) (gas i : ℕ) (rs : List ℕ) (a free : ℕ)
    (hr : ∀ x ∈ rs, R x) (ha : ∀ x, R x → a.testBit x = true) :
    walk leaves tape gas i rs a free = 0 := by
  induction gas generalizing i rs a free with
  | zero => rfl
  | succ gas ih =>
    rw [walk]
    simp only [forceN_eq]
    generalize instruction tape i a free = ins
    rcases ins with ⟨z,j⟩
    dsimp only
    split
    · obtain ⟨t,hb,ht⟩ := hit (z%128) (z/128)
      have hrest : ((pattern (z%128) (z/128)) &&& a).testBit t = true := by simp [hb, ha t ht]
      split
      · rename_i he
        change pattern (z%128) (z/128) &&& a = 0 at he
        simp [he] at hrest
      · split
        · rename_i he
          rw [he, Nat.shiftLeft_eq, one_mul, Nat.testBit_two_pow] at hrest
          have heq := of_decide_eq_true hrest
          exact ih _ _ _ _ (by simpa [heq] using And.intro ht hr)
            (fun u hu => pv_safe hn hr bound (heq.symm ▸ ht) hu (ha u hu))
        · rfl
    · split
      · simp [gate_sound leaves hn hit bound _ rs a hr ha]
      · split
        · rfl
        · rename_i hj
          let p := (tape >>> (j-1)) % 256
          by_cases hp : R p
          · exact (hj (ih _ _ _ _ (by simpa using And.intro hp hr)
              (fun u hu => pv_safe hn hr bound hp hu (ha u hu)))).elim
          · exact ih _ _ _ _ hr (fun u hu => erase_safe hp hu (ha u hu))

def unused (rs : List ℕ) : ℕ := rs.foldl erasePt full

lemma certify {s : List ℕ × ℕ} (tape : ℕ) (leaves : Array {s // Bad s})
    (ok : walk leaves tape 160 1 s.1 s.2 (unused s.1) ≠ 0) : Bad s := by
  intro R hn hit bound hr ha
  exact ok (walk_sound leaves tape hn hit bound _ _ _ _ _ hr ha)
