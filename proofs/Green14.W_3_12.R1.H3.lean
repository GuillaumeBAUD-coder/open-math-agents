lemma center (r : ℕ → Bool) (h64 : r 64 = false)
    (h65 : r 65 = true) (h66 : r 66 = true) (h67 : r 67 = true) (h68 : r 68 = true) : Mono r := by
  by_contra hn
  apply v306 (Red r) (noTriple hn) (hits hn) (fun _ h => h.1)
  · intro x hx
    obtain rfl : x = 64 := by simpa using hx
    exact ⟨by decide,h64⟩
  · intro x hx
    have outside : x < 65 ∨ 68 < x := by
      by_contra! inside
      obtain ⟨_,hc⟩ := hx
      obtain ⟨hl,hu⟩ := inside
      interval_cases x <;> simp_all
    have bits : ∀ t : Fin 134, t.val < 65 ∨ 68 < t.val →
        Nat.testBit 0x3fffffffffffffffe1ffffffffffffffff t.val = true := by decide +kernel
    exact bits ⟨x,hx.1⟩ outside

lemma translate {r : ℕ → Bool} (o : ℕ) (ho : o ≤ 1) (h : Mono (fun i => r (o+i))) :
    ∃ (b : Bool) (a d : ℕ), 0 < d ∧ a + (if b then 11 else 2)*d < 135 ∧
      ∀ t ≤ (if b then 11 else 2), r (a+t*d) = b := by
  obtain ⟨b,a,d,hd,hb,hm⟩ := h
  refine ⟨b,o+a,d,hd,by omega,?_⟩
  simpa only [Nat.add_assoc] using hm

