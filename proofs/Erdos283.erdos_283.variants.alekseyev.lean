theorem OMA.solution : type_of% @Erdos283.erdos_283.variants.alekseyev := by
  intro m hm
  obtain ⟨S,hS,hr,hs⟩ := EgyptianSquares.completion EgyptianSquares.span8543_54534 m hm
  exact ⟨S, fun n hn => by have := (hS n hn).1; omega, hr, by exact_mod_cast hs⟩
