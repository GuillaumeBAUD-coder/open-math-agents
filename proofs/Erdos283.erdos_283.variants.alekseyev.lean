import FormalConjectures.ErdosProblems.«283»

/-! The four translations follow M. A. Alekseyev, arXiv:1801.05928.
Exceptional finite witnesses come from his supplementary table OEIS A297895. -/
namespace EgyptianSquares

private def Good (m : ℕ) : Prop :=
  ∃ S : Finset ℕ, (∀ n ∈ S, 2 ≤ n ∧ (9498 ≤ m → n ≠ 21 ∧ n ≠ 39)) ∧
    (∑ n ∈ S, (1 : ℚ) / n) = 1 ∧ ∑ n ∈ S, n^2 = m

private def chooseMask : List ℕ → ℕ → List ℕ
  | [], _ => []
  | n :: ns, w => if w % 2 = 1 then n :: chooseMask ns (w / 2) else chooseMask ns (w / 2)

private def score : List ℕ → ℕ → ℕ
  | [], _ => 0
  | a :: as, w => if w % 2 = 1 then a + score as (w / 2) else score as (w / 2)

private theorem chosen_sub (xs : List ℕ) (w : ℕ) : (chooseMask xs w).Sublist xs := by
  induction xs generalizing w with
  | nil => exact .slnil
  | cons n xs ih =>
    simp only [chooseMask]
    split
    · exact (ih _).cons_cons _
    · exact (ih _).cons _

private theorem score_eq (xs : List ℕ) (f : ℕ → ℕ) (w : ℕ) :
    score (xs.map f) w = ((chooseMask xs w).map f).sum := by
  induction xs generalizing w with
  | nil => rfl
  | cons n xs ih =>
    simp only [List.map_cons, score, chooseMask]
    split <;> simp [ih]

private def radix : ℕ := 8388608
private def weights (xs : List ℕ) (D : ℕ) := xs.map fun n => (D / n) * radix + n^2

private theorem good_score {xs : List ℕ} {D w m : ℕ}
    (hD : 0 < D) (hu : xs.Nodup)
    (hxs : ∀ n ∈ xs, 2 ≤ n ∧ n ∣ D)
    (hs : (xs.map (fun n => n^2)).sum < radix) (hm : m < radix)
    (ha : 9498 ≤ m → ∀ n ∈ chooseMask xs w, n ≠ 21 ∧ n ≠ 39)
    (he : score (weights xs D) w = D * radix + m) : Good m := by
  let ys := chooseMask xs w
  have hsub : ys.Sublist xs := chosen_sub _ _
  have hy := hsub.nodup hu
  have hsq : (ys.map (fun n => n^2)).sum < radix :=
    lt_of_le_of_lt ((hsub.map _).sum_le_sum (fun _ _ => Nat.zero_le _)) hs
  have hval : ((ys.map (fun n => D / n)).sum) * radix + (ys.map (fun n => n^2)).sum =
      D * radix + m := by
    rw [weights, score_eq] at he
    change (ys.map _).sum = _ at he
    convert he using 1
    clear he
    induction ys with
    | nil => simp
    | cons n l ih => simp_all [Nat.add_mul]; omega
  have hq : (ys.map (fun n => D / n)).sum = D := by
    unfold radix at hval hm hsq; omega
  rw [hq] at hval
  have hsq' := Nat.add_left_cancel hval
  refine ⟨ys.toFinset, ?_, ?_, ?_⟩
  · intro n hn
    have hn' := List.mem_toFinset.mp hn
    exact ⟨(hxs n (hsub.subset hn')).1, fun h => ha h n hn'⟩
  all_goals rw [List.sum_toFinset _ hy]
  · have hx : ∀ n ∈ ys, (1 : ℚ) / n = (D / n : ℕ) / (D : ℚ) := by
      intro n hn
      obtain ⟨hn2, hd⟩ := hxs n (hsub.subset hn)
      have hdc : (D / n : ℕ) * (n : ℚ) = D := by exact_mod_cast Nat.div_mul_cancel hd
      field_simp
      all_goals linarith
    calc
      _ = (ys.map (fun n => (D / n : ℕ) / (D : ℚ))).sum :=
        congrArg List.sum (List.map_congr_left hx)
      _ = ((ys.map (fun n => D / n)).sum : ℕ) / (D : ℚ) := by
        induction ys with
        | nil => simp
        | cons n l ih => simp_all [add_div]
      _ = 1 := by rw [hq]; exact div_self (by positivity)
  · exact hsq'

private def basic : List ℕ :=
  [2,3,4,5,6,7,8,9,10,12,14,15,18,20,24,28,30,35,36,40,42,45,56,60,63,70,72,84,90,105,120,126,140,168,180,210]

private def full : List ℕ := List.range' 2 232
private def common : ℕ := Nat.factorial 234

private theorem scoredBasic (w m : ℕ) (hm : m < radix)
    (h : score (weights basic 2520) w = 2520 * radix + m) : Good m := by
  apply good_score (by decide : 0 < 2520) (by decide : basic.Nodup) (by decide) (by decide) hm _ h
  intro _ n hn
  have h' := (chosen_sub basic w).subset hn
  exact (show ∀ n ∈ basic, n ≠ 21 ∧ n ≠ 39 by decide) n h'

set_option maxRecDepth 10000 in
private theorem scoredFull (w m : ℕ) (hm : m < radix)
    (ha : 9498 ≤ m → ∀ n ∈ chooseMask full w, n ≠ 21 ∧ n ≠ 39)
    (h : score (weights full common) w = common * radix + m) : Good m := by
  apply good_score (Nat.factorial_pos _) (by decide : full.Nodup) _ (by decide) hm ha h
  intro n hn
  simp [full, List.mem_range'] at hn
  exact ⟨by omega, Nat.dvd_factorial (by omega) (by omega)⟩

-- Each ordinary row is a 36-bit subset of the divisors in basic. A zero row
-- introduces a 232-bit subset of the integers from 2 to 233.
private def smallBase : ℕ := 2^36
private def wideBase : ℕ := 2^232

private def rows : ℕ → ℕ → ℕ → Bool
  | 0, _, _ => true
  | k+1, m, data =>
    let w := data % smallBase
    let tail := data / smallBase
    if w = 0 then
      let v := tail % wideBase
      decide (score (weights full common) v = common * radix + m) &&
        decide (9498 ≤ m → ∀ n ∈ chooseMask full v, n ≠ 21 ∧ n ≠ 39) &&
        rows k (m+1) (tail / wideBase)
    else
      decide (score (weights basic 2520) w = 2520 * radix + m) && rows k (m+1) tail

private def Covers (a b : ℕ) := ∀ m, a ≤ m → m < b → Good m

private theorem rows_sound (k m data : ℕ) (hb : m+k ≤ radix)
    (h : rows k m data = true) : Covers m (m+k) := by
  induction k generalizing m data with
  | zero => intro u ha hb; omega
  | succ k ih =>
    simp only [rows] at h
    intro u ha hu
    split at h
    · simp only [Bool.and_eq_true, decide_eq_true_eq] at h
      by_cases e : u = m
      · subst u; exact scoredFull _ _ (by omega) h.1.2 h.1.1
      · apply ih (m+1) _ (by omega) h.2 u (by omega) (by omega)
    · simp only [Bool.and_eq_true, decide_eq_true_eq] at h
      by_cases e : u = m
      · subst u; exact scoredBasic _ _ (by omega) h.1
      · apply ih (m+1) _ (by omega) h.2 u (by omega) (by omega)

private theorem joinCover {a b c : ℕ} (ab : Covers a b) (bc : Covers b c) : Covers a c := by
  intro m ha hm
  by_cases h : m < b
  · exact ab m ha h
  · exact bc m (by omega) hm

