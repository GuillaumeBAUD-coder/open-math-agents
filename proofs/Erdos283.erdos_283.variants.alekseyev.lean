private theorem grow (A : Finset ℕ) (shift m : ℕ) (hm : 9498 ≤ m) (h : Good m)
    (hA : ∀ a ∈ A, 2 ≤ a ∧ a ≠ 21 ∧ a ≠ 39 ∧
      (∀ x : ℕ, 2*x = a → x = 1 ∨ x = 21 ∨ x = 39))
    (hr : (∑ n ∈ A, (1 : ℚ) / n) = 1/2) (hs : ∑ n ∈ A, n^2 = shift) :
    Good (4*m + shift) := by
  obtain ⟨S,hS,hR,hQ⟩ := h
  let f : ℕ ↪ ℕ := ⟨fun n => 2*n, by intro a b h; change 2*a = 2*b at h; omega⟩
  have hf (x : ℕ) : f x = 2*x := rfl
  have hd : Disjoint A (S.map f) := by
    rw [Finset.disjoint_left]
    intro a ha hmem
    obtain ⟨x,hx,rfl⟩ := Finset.mem_map.mp hmem
    obtain ⟨hx₂,hx₂₁,hx₃₉⟩ := And.intro (hS x hx).1 ((hS x hx).2 hm)
    have := (hA _ ha).2.2.2 x (hf x).symm
    omega
  refine ⟨A ∪ S.map f, ?_, ?_, ?_⟩
  · intro n hn
    rcases Finset.mem_union.mp hn with ha | hs'
    · obtain ⟨h₂,h₂₁,h₃₉,_⟩ := hA n ha
      exact ⟨h₂,fun _ => ⟨h₂₁,h₃₉⟩⟩
    · obtain ⟨x,hx,rfl⟩ := Finset.mem_map.mp hs'
      have := (hS x hx).1
      rw [hf]; omega
  · rw [Finset.sum_union hd, hr, Finset.sum_map]
    have term (x : ℕ) : (1 : ℚ) / (f x : ℕ) = (1/2) * (1/(x : ℚ)) := by
      rw [hf, Nat.cast_mul]; push_cast; ring
    simp only [term, ← Finset.mul_sum, hR]
    norm_num
  · rw [Finset.sum_union hd, hs, Finset.sum_map]
    simp only [hf, mul_pow, ← Finset.mul_sum, hQ]; omega

private theorem completion (base : Covers 8543 54534) (m : ℕ) (hm : 8543 ≤ m) : Good m := by
  induction m using Nat.strong_induction_on with
  | h m ih =>
    by_cases hb : m < 54534
    · exact base _ hm hb
    · have hmod := Nat.mod_lt m (by decide : 0 < 4)
      interval_cases h : m % 4
      · let n := (m-4)/4
        have hn : 9498 ≤ n := by dsimp [n]; omega
        have he : 4*n+4 = m := by dsimp [n]; omega
        rw [← he]
        apply grow {2} _ n hn (ih n (by dsimp [n]; omega) (by omega))
        · intro a ha
          simp only [Finset.mem_singleton] at ha
          subst a
          refine ⟨by decide, by decide, by decide, ?_⟩
          intro x hx
          omega
        · norm_num [Finset.sum_insert]
        · decide
      · let n := (m-16545)/4
        have hn : 9498 ≤ n := by dsimp [n]; omega
        have he : 4*n+16545 = m := by dsimp [n]; omega
        rw [← he]
        apply grow {5,7,9,45,78,91} _ n hn (ih n (by dsimp [n]; omega) (by omega))
        · intro a ha
          simp only [Finset.mem_insert, Finset.mem_singleton] at ha
          rcases ha with rfl | rfl | rfl | rfl | rfl | rfl <;> refine ⟨by decide, by decide, by decide, ?_⟩ <;> intro x hx <;> omega
        · norm_num [Finset.sum_insert]
        · decide
      · let n := (m-1822)/4
        have hn : 9498 ≤ n := by dsimp [n]; omega
        have he : 4*n+1822 = m := by dsimp [n]; omega
        rw [← he]
        apply grow {3,7,42} _ n hn (ih n (by dsimp [n]; omega) (by omega))
        · intro a ha
          simp only [Finset.mem_insert, Finset.mem_singleton] at ha
          rcases ha with rfl | rfl | rfl <;> refine ⟨by decide, by decide, by decide, ?_⟩ <;> intro x hx <;> omega
        · norm_num [Finset.sum_insert]
        · decide
      · let n := (m-14423)/4
        have hn : 9498 ≤ n := by dsimp [n]; omega
        have he : 4*n+14423 = m := by dsimp [n]; omega
        rw [← he]
        apply grow {3,7,78,91} _ n hn (ih n (by dsimp [n]; omega) (by omega))
        · intro a ha
          simp only [Finset.mem_insert, Finset.mem_singleton] at ha
          rcases ha with rfl | rfl | rfl | rfl <;> refine ⟨by decide, by decide, by decide, ?_⟩ <;> intro x hx <;> omega
        · norm_num [Finset.sum_insert]
        · decide

