theorem OMA.solution : OMA.R_Erdos473_erdos_473_variants_finite_R1_H1_R1.H1 := by
  intro m hlo hhi heven
  have hidx : (m-10)/2 < 2496 := by omega
  have h := PrimeCircleCert.allCases ((m-10)/2) hidx
  rw [show 10+2*((m-10)/2) = m by omega] at h
  obtain ⟨u, v, huv, hvm, hcop, hu, hu', hv, hv'⟩ := h
  exact ⟨u, v, huv, hvm, hcop, PrimeCircleCert.primeCheck_sound hu,
    fun z => PrimeCircleCert.primeCheck_sound (hu' z), PrimeCircleCert.primeCheck_sound hv,
    fun z => PrimeCircleCert.primeCheck_sound (hv' z)⟩
