import OMAReductions.R_Erdos473_erdos_473_variants_finite_R1_H1_R1
import Mathlib

namespace PrimeCircleCert

def primeCheck (n : ℕ) : Bool := if n ≤ 103 then decide n.Prime else
  decide (n < 104^2 ∧ Nat.gcd n (Nat.factorial 103) = 1)

lemma primeCheck_sound {n : ℕ} (h : primeCheck n = true) : n.Prime := by
  by_cases hn : n ≤ 103
  · simpa [primeCheck, hn] using h
  · have hh : n < 104^2 ∧ Nat.gcd n (Nat.factorial 103) = 1 := by simpa [primeCheck, hn] using h
    by_contra hnp
    have hprime := Nat.minFac_prime (show n ≠ 1 by omega)
    have hsq := Nat.minFac_sq_le_self (by omega : 0 < n) hnp
    have hsmall : n.minFac ≤ 103 := by nlinarith
    have hd := Nat.dvd_gcd (Nat.minFac_dvd n) (Nat.dvd_factorial hprime.pos hsmall)
    rw [hh.2] at hd
    have := Nat.eq_one_of_dvd_one hd
    exact hprime.ne_one this

def Good (m u v : ℕ) : Prop :=
  u < v ∧ v < m ∧ (v-u).Coprime m ∧ primeCheck (2*u+3) = true ∧
  (u+1 < m → primeCheck (2*u+3+2*m) = true) ∧ primeCheck (2*v+3) = true ∧
  (v+1 < m → primeCheck (2*v+3+2*m) = true)

instance (m u v : ℕ) : Decidable (Good m u v) := by unfold Good; infer_instance

def check : ℕ → ℕ → ℕ → Bool
  | 0, _, _ => true
  | n+1, m, bits => decide (Good m (bits % 256) (bits / 256 % 256)) &&
      check n (m+2) (bits/65536)

def Span (m n : ℕ) : Prop := ∀ j < n, ∃ u v, Good (m+2*j) u v

lemma sound (n m bits : ℕ) (h : check n m bits = true) : Span m n := by
  induction n generalizing m bits with
  | zero => intro j hj; omega
  | succ n ih =>
    simp only [check, Bool.and_eq_true, decide_eq_true_eq] at h
    intro j hj
    cases j with
    | zero => exact ⟨_, _, by simpa using h.1⟩
    | succ j =>
      have hh := ih (m+2) (bits/65536) h.2 j (by omega)
      simpa only [Nat.mul_succ, Nat.add_right_comm, Nat.add_assoc, Nat.add_comm] using hh

lemma join (m a b : ℕ) (left : Span m a) (right : Span (m+2*a) b) : Span m (a+b) := by
  intro j hj
  by_cases ha : j < a
  · exact left j ha
  · have hh := right (j-a) (by omega)
    rwa [show m + 2*a + 2*(j-a) = m + 2*j by omega] at hh

