theorem gf_den (A : ℚ⟦X⟧) : A * ((X - 1) ^ 2 * (X ^ 4 + 1) * (X ^ 2 + X + 1)) = C 1 * A - C 1 * (A * X ^ 1) - C 1 * (A * X ^ 3) + C 2 * (A * X ^ 4) - C 1 * (A * X ^ 5) - C 1 * (A * X ^ 7) + C 1 * (A * X ^ 8) := by
  simp only [map_ofNat, map_one]
  ring

