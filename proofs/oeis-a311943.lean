/-! The steps satisfy the recurrence, on one period of the residues (negative terms moved across). -/

def drec_baseK : PLift (∀ t : ℕ, t < 24 → dv (t + 8) + 2 * dv (t + 4) + dv (t + 0) = dv (t + 7) + dv (t + 5) + dv (t + 3) + dv (t + 1)) :=
  ⟨by decide +kernel⟩

theorem drec_base : ∀ t : ℕ, t < 24 → dv (t + 8) + 2 * dv (t + 4) + dv (t + 0) = dv (t + 7) + dv (t + 5) + dv (t + 3) + dv (t + 1) := drec_baseK.down

theorem drec (t : ℕ) : (dv (t + 8) : ℤ) = (dv (t + 7) : ℤ) + (dv (t + 5) : ℤ) - 2 * (dv (t + 4) : ℤ) + (dv (t + 3) : ℤ) + (dv (t + 1) : ℤ) - (dv (t + 0) : ℤ) := by
  have e : ∀ o : ℕ, dv (t + o) = dv (t % 24 + o) := fun o => by
    rw [dv, dv, Nat.mod_add_mod]
  rw [e 0, e 1, e 3, e 4, e 5, e 7, e 8]
  have h := congrArg (Nat.cast : ℕ → ℤ) (drec_base (t % 24) (Nat.mod_lt _ (by norm_num)))
  push_cast at h
  linarith

/-! The recurrence on its first 24 terms, by the kernel (negative terms moved across). -/

def recur_baseK : PLift (∀ q : ℕ, q < 24 → b (q + 9) + 2 * b (q + 5) + b (q + 1) = b (q + 8) + b (q + 6) + b (q + 4) + b (q + 2)) :=
  ⟨by decide +kernel⟩

theorem recur_base : ∀ q : ℕ, q < 24 → b (q + 9) + 2 * b (q + 5) + b (q + 1) = b (q + 8) + b (q + 6) + b (q + 4) + b (q + 2) := recur_baseK.down

theorem b_recur (q : ℕ) : (b (q + 9) : ℤ) = b (q + 8) + b (q + 6) - 2 * b (q + 5) + b (q + 4) + b (q + 2) - b (q + 1) := by
  induction q using Nat.strong_induction_on with
  | _ q ih =>
    rcases (show q < 24 ∨ 24 ≤ q by omega) with hq | hq
    · have h := congrArg (Nat.cast : ℕ → ℤ) (recur_base q hq)
      push_cast at h
      linarith
    · obtain ⟨v, rfl⟩ : ∃ v, q = v + 24 := ⟨q - 24, by omega⟩
      have h0 : (b (v + 9) : ℤ) = b (v + 8) + b (v + 6) - 2 * b (v + 5) + b (v + 4) + b (v + 2) - b (v + 1) := ih (v + 0) (by omega)
      have hd := drec v
      have s1 : (b (v + 25) : ℤ) = b (v + 1) + dv (v + 0) := by
        have h := b_step (v + 1) (le_trans (by decide : 1 ≤ 1) (Nat.le_add_left _ v))
        rw [show v + 1 + 24 = v + 25 from Nat.add_assoc _ _ _,
          show v + 1 - 1 = v + 0 from Nat.add_sub_assoc (by decide : 1 ≤ 1) v] at h
        exact_mod_cast h
      have s2 : (b (v + 26) : ℤ) = b (v + 2) + dv (v + 1) := by
        have h := b_step (v + 2) (le_trans (by decide : 1 ≤ 2) (Nat.le_add_left _ v))
        rw [show v + 2 + 24 = v + 26 from Nat.add_assoc _ _ _,
          show v + 2 - 1 = v + 1 from Nat.add_sub_assoc (by decide : 1 ≤ 2) v] at h
        exact_mod_cast h
      have s4 : (b (v + 28) : ℤ) = b (v + 4) + dv (v + 3) := by
        have h := b_step (v + 4) (le_trans (by decide : 1 ≤ 4) (Nat.le_add_left _ v))
        rw [show v + 4 + 24 = v + 28 from Nat.add_assoc _ _ _,
          show v + 4 - 1 = v + 3 from Nat.add_sub_assoc (by decide : 1 ≤ 4) v] at h
        exact_mod_cast h
      have s5 : (b (v + 29) : ℤ) = b (v + 5) + dv (v + 4) := by
        have h := b_step (v + 5) (le_trans (by decide : 1 ≤ 5) (Nat.le_add_left _ v))
        rw [show v + 5 + 24 = v + 29 from Nat.add_assoc _ _ _,
          show v + 5 - 1 = v + 4 from Nat.add_sub_assoc (by decide : 1 ≤ 5) v] at h
        exact_mod_cast h
      have s6 : (b (v + 30) : ℤ) = b (v + 6) + dv (v + 5) := by
        have h := b_step (v + 6) (le_trans (by decide : 1 ≤ 6) (Nat.le_add_left _ v))
        rw [show v + 6 + 24 = v + 30 from Nat.add_assoc _ _ _,
          show v + 6 - 1 = v + 5 from Nat.add_sub_assoc (by decide : 1 ≤ 6) v] at h
        exact_mod_cast h
      have s8 : (b (v + 32) : ℤ) = b (v + 8) + dv (v + 7) := by
        have h := b_step (v + 8) (le_trans (by decide : 1 ≤ 8) (Nat.le_add_left _ v))
        rw [show v + 8 + 24 = v + 32 from Nat.add_assoc _ _ _,
          show v + 8 - 1 = v + 7 from Nat.add_sub_assoc (by decide : 1 ≤ 8) v] at h
        exact_mod_cast h
      have s9 : (b (v + 33) : ℤ) = b (v + 9) + dv (v + 8) := by
        have h := b_step (v + 9) (le_trans (by decide : 1 ≤ 9) (Nat.le_add_left _ v))
        rw [show v + 9 + 24 = v + 33 from Nat.add_assoc _ _ _,
          show v + 9 - 1 = v + 8 from Nat.add_sub_assoc (by decide : 1 ≤ 9) v] at h
        exact_mod_cast h
      show (b (v + 33) : ℤ) = b (v + 32) + b (v + 30) - 2 * b (v + 29) + b (v + 28) + b (v + 26) - b (v + 25)
      linear_combination s9 - (1) * s8 - (1) * s6 - (-2) * s5 - (1) * s4 - (1) * s2 - (-1) * s1 + h0 + hd

/-- The recurrence. -/
theorem recur : ∀ n : ℕ, 8 < n → (a n : ℤ) = a (n - 1) + a (n - 3) - 2 * a (n - 4) + a (n - 5) + a (n - 7) - a (n - 8) := by
  intro n hn
  obtain ⟨q, rfl⟩ : ∃ q, n = q + 9 := ⟨n - 9, by omega⟩
  rw [show q + 9 - 1 = q + 8 from Nat.add_sub_assoc (by decide : 1 ≤ 9) q, show q + 9 - 3 = q + 6 from Nat.add_sub_assoc (by decide : 3 ≤ 9) q, show q + 9 - 4 = q + 5 from Nat.add_sub_assoc (by decide : 4 ≤ 9) q, show q + 9 - 5 = q + 4 from Nat.add_sub_assoc (by decide : 5 ≤ 9) q, show q + 9 - 7 = q + 2 from Nat.add_sub_assoc (by decide : 7 ≤ 9) q, show q + 9 - 8 = q + 1 from Nat.add_sub_assoc (by decide : 8 ≤ 9) q]
  simp only [a_eq_b]
  exact b_recur q

/-- b (n - k) for k ≤ n, and [n = j]: the shapes of the coefficients of the g.f. -/
def bk (n k : ℕ) : ℕ := cond (Nat.ble k n) (b (Nat.sub n k)) 0

def ind (n j : ℕ) : ℕ := cond (Nat.beq n j) 1 0

theorem cast_bk (n k : ℕ) : ((bk n k : ℕ) : ℚ) = if k ≤ n then ((b (n - k) : ℕ) : ℚ) else 0 := by
  rw [bk]
  by_cases h : k ≤ n
  · rw [if_pos h, Nat.ble_eq_true_of_le h]
    rfl
  · rw [if_neg h]
    cases hb : Nat.ble k n
    · simp
    · exact absurd (Nat.le_of_ble_eq_true hb) h

theorem cast_ind (n j : ℕ) : ((ind n j : ℕ) : ℚ) = if n = j then 1 else 0 := by
  rw [ind]
  by_cases h : n = j
  · subst h
    rw [Nat.beq_refl, if_pos rfl]
    simp
  · rw [if_neg h, beq_ff _ _ h]
    simp

/-- The coefficients of A * DEN and NUM agree below 9, in natural numbers (negative terms moved
across). -/
def gfL (n : ℕ) : ℕ := Nat.add (Nat.add (b n) (Nat.mul 2 (bk n 4))) (bk n 8)

def gfR (n : ℕ) : ℕ := Nat.add (Nat.add (Nat.add (Nat.add (Nat.add (Nat.add (Nat.add (Nat.add (Nat.add (Nat.add (Nat.add (Nat.add (bk n 1) (bk n 3)) (bk n 5)) (bk n 7)) (ind n 0)) (Nat.mul 3 (ind n 1))) (Nat.mul 4 (ind n 2))) (Nat.mul 4 (ind n 3))) (Nat.mul 2 (ind n 4))) (Nat.mul 4 (ind n 5))) (Nat.mul 4 (ind n 6))) (Nat.mul 3 (ind n 7))) (ind n 8)

def gfK : PLift ((allR 9 fun n => Nat.beq (gfL n) (gfR n)) = true) :=
  ⟨by decide +kernel⟩

/-- The coefficient identity of the g.f. below 9, from the kernel check. -/
theorem gf_low (n : ℕ) (hn : n < 9) :
    1 * (b (n) : ℚ) - 1 * (if 1 ≤ n then (b (n - 1) : ℚ) else 0) - 1 * (if 3 ≤ n then (b (n - 3) : ℚ) else 0) + 2 * (if 4 ≤ n then (b (n - 4) : ℚ) else 0) - 1 * (if 5 ≤ n then (b (n - 5) : ℚ) else 0) - 1 * (if 7 ≤ n then (b (n - 7) : ℚ) else 0) + 1 * (if 8 ≤ n then (b (n - 8) : ℚ) else 0) =
      (if n = 0 then (1 : ℚ) else 0) * 1 + (if n = 1 then (1 : ℚ) else 0) * 3 + (if n = 2 then (1 : ℚ) else 0) * 4 + (if n = 3 then (1 : ℚ) else 0) * 4 + (if n = 4 then (1 : ℚ) else 0) * 2 + (if n = 5 then (1 : ℚ) else 0) * 4 + (if n = 6 then (1 : ℚ) else 0) * 4 + (if n = 7 then (1 : ℚ) else 0) * 3 + (if n = 8 then (1 : ℚ) else 0) * 1 := by
  have h := (allR_iff _ _).1 gfK.down n hn
  rw [Nat.beq_eq] at h
  have hq := congrArg (Nat.cast : ℕ → ℚ) h
  simp only [gfL, gfR, Nat.add_eq, Nat.mul_eq, Nat.cast_add, Nat.cast_mul, Nat.cast_ofNat, Nat.cast_one,
    Nat.cast_zero, cast_bk, cast_ind] at hq
  linarith

/-- The coefficient identity of the g.f. from 9 on, from the recurrence. -/
theorem gf_high (q : ℕ) :
    1 * (b (q + 9) : ℚ) - 1 * (if 1 ≤ q + 9 then (b (q + 9 - 1) : ℚ) else 0) - 1 * (if 3 ≤ q + 9 then (b (q + 9 - 3) : ℚ) else 0) + 2 * (if 4 ≤ q + 9 then (b (q + 9 - 4) : ℚ) else 0) - 1 * (if 5 ≤ q + 9 then (b (q + 9 - 5) : ℚ) else 0) - 1 * (if 7 ≤ q + 9 then (b (q + 9 - 7) : ℚ) else 0) + 1 * (if 8 ≤ q + 9 then (b (q + 9 - 8) : ℚ) else 0) =
      (if q + 9 = 0 then (1 : ℚ) else 0) * 1 + (if q + 9 = 1 then (1 : ℚ) else 0) * 3 + (if q + 9 = 2 then (1 : ℚ) else 0) * 4 + (if q + 9 = 3 then (1 : ℚ) else 0) * 4 + (if q + 9 = 4 then (1 : ℚ) else 0) * 2 + (if q + 9 = 5 then (1 : ℚ) else 0) * 4 + (if q + 9 = 6 then (1 : ℚ) else 0) * 4 + (if q + 9 = 7 then (1 : ℚ) else 0) * 3 + (if q + 9 = 8 then (1 : ℚ) else 0) * 1 := by
  have h : (b (q + 9) : ℤ) = b (q + 8) + b (q + 6) - 2 * b (q + 5) + b (q + 4) + b (q + 2) - b (q + 1) := b_recur (q + 0)
