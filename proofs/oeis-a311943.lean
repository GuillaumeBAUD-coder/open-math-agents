/-- The numerator as a sum of monomials. -/
theorem gf_num : (X ^ 8 + 3 * X ^ 7 + 4 * X ^ 6 + 4 * X ^ 5 + 2 * X ^ 4 + 4 * X ^ 3 + 4 * X ^ 2 + 3 * X + 1 : ℚ⟦X⟧) = X ^ 0 * C 1 + X ^ 1 * C 3 + X ^ 2 * C 4 + X ^ 3 * C 4 + X ^ 4 * C 2 + X ^ 5 * C 4 + X ^ 6 * C 4 + X ^ 7 * C 3 + X ^ 8 * C 1 := by
  simp only [map_ofNat, map_one]
  ring

