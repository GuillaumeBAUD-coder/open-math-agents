def OMA.chk (n c : ℕ) : Bool :=
    decide (0 < (c % 4096)) &&
    decide ((c / 16777216) + (c % 4096) < n) &&
    decide (2 ≤ (c / 16777216) ∧ (c / 16777216) ≤ 4) &&
    OMA.pb (2 * (c / 16777216) - 1) (c / 4096 % 4096) &&
    OMA.pb (2 * (c % 4096) - 1) (c / 4096 % 4096) &&
    OMA.pb (2 * (n - (c / 16777216) - (c % 4096)) - 1) (c / 4096 % 4096) &&
    OMA.pb (2 * (c / 16777216) * (c % 4096) * (n - (c / 16777216) - (c % 4096)) - 1) (c / 4096 % 4096)

