theorem OMA.h : ∀ i < 1000, OMA.chk (i + 7) (OMA.T.getD i 0) = true := by
  decide +kernel

theorem OMA.solution : OMA.R_OeisA229969_conjecture_3a_R1.H1 := by
  intro n h1 h2
  have h := OMA.h (n - 7) (by omega)
  rw [show n - 7 + 7 = n by omega] at h
  generalize OMA.T.getD (n - 7) 0 = c at h
  simp only [OMA.chk, Bool.and_eq_true, decide_eq_true_eq] at h
  obtain ⟨⟨⟨⟨⟨⟨a0, a1⟩, a2⟩, p0⟩, p1⟩, p2⟩, p3⟩ := h
  refine ⟨(c / 16777216), (c % 4096), (n - (c / 16777216) - (c % 4096)), by omega, a0, by omega, by omega, ?_, OMA.pb_prime p0, OMA.pb_prime p1,
    OMA.pb_prime p2, OMA.pb_prime p3⟩
  simp only [Finset.mem_insert, Finset.mem_singleton]
  omega
