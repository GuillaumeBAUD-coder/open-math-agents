theorem range (n : ℕ) (hn : 0 < n) (hN : n ≤ 1000) : ∃ m, js^[m] n = 1 := by
  have hi : ∃ i, n = 1 + i := ⟨n - 1, by omega⟩
  obtain ⟨i, rfl⟩ := hi
  by_cases g0 : i < 100
  · obtain ⟨m, hm⟩ := all_spec d0 1 t0 (i - 0) (by rw [len0]; omega)
    have e : 1 + (i - 0) = 1 + i := by omega
    rw [e] at hm
    exact ⟨m, hm⟩
  by_cases g1 : i < 200
  · obtain ⟨m, hm⟩ := all_spec d1 101 t1 (i - 100) (by rw [len1]; omega)
    have e : 101 + (i - 100) = 1 + i := by omega
    rw [e] at hm
    exact ⟨m, hm⟩
  by_cases g2 : i < 300
  · obtain ⟨m, hm⟩ := all_spec d2 201 t2 (i - 200) (by rw [len2]; omega)
    have e : 201 + (i - 200) = 1 + i := by omega
    rw [e] at hm
    exact ⟨m, hm⟩
  by_cases g3 : i < 400
  · obtain ⟨m, hm⟩ := all_spec d3 301 t3 (i - 300) (by rw [len3]; omega)
    have e : 301 + (i - 300) = 1 + i := by omega
    rw [e] at hm
    exact ⟨m, hm⟩
  by_cases g4 : i < 500
  · obtain ⟨m, hm⟩ := all_spec d4 401 t4 (i - 400) (by rw [len4]; omega)
    have e : 401 + (i - 400) = 1 + i := by omega
    rw [e] at hm
    exact ⟨m, hm⟩
  by_cases g5 : i < 600
  · obtain ⟨m, hm⟩ := all_spec d5 501 t5 (i - 500) (by rw [len5]; omega)
    have e : 501 + (i - 500) = 1 + i := by omega
    rw [e] at hm
    exact ⟨m, hm⟩
  by_cases g6 : i < 700
  · obtain ⟨m, hm⟩ := all_spec d6 601 t6 (i - 600) (by rw [len6]; omega)
    have e : 601 + (i - 600) = 1 + i := by omega
    rw [e] at hm
    exact ⟨m, hm⟩
  by_cases g7 : i < 800
  · obtain ⟨m, hm⟩ := all_spec d7 701 t7 (i - 700) (by rw [len7]; omega)
    have e : 701 + (i - 700) = 1 + i := by omega
    rw [e] at hm
    exact ⟨m, hm⟩
  by_cases g8 : i < 900
  · obtain ⟨m, hm⟩ := all_spec d8 801 t8 (i - 800) (by rw [len8]; omega)
    have e : 801 + (i - 800) = 1 + i := by omega
    rw [e] at hm
    exact ⟨m, hm⟩
  obtain ⟨m, hm⟩ := all_spec d9 901 t9 (i - 900) (by rw [len9]; omega)
  have e : 901 + (i - 900) = 1 + i := by omega
  rw [e] at hm
  exact ⟨m, hm⟩

theorem range' (n : ℕ) (hn : 0 < n) (hN : n ≤ 1000) :
    ∃ m, JugglerConjecture.jugglerStep^[m] n = 1 := by
  have hf : JugglerConjecture.jugglerStep = js := funext step_eq
  rw [hf]
  exact range n hn hN

end OMA.Juggler

theorem OMA.solution : OMA.R_JugglerConjecture_juggler_conjecture_R1.H1 := by
  intro n hn hN
  exact OMA.Juggler.range' n hn hN
