import OMAReductions.R_JugglerConjecture_juggler_conjecture_R1

-- The juggler conjecture for 0 < n <= 1000.
-- step_eq: the real-power definition agrees with integer square roots, floor(n^(1/2)) = Nat.sqrt n and
-- floor(n^(3/2)) = Nat.sqrt (n^3). The trajectory of each n (computed outside Lean) is listed, and the kernel
-- certifies every term b after a as an integer square root by b^2 <= x < (b + 1)^2 with x = a or a^3 (chk).
-- The largest term has 271 digits (start 163). A verified numerical range only; not progress on the conjecture.

namespace OMA.Juggler

/-- The juggler step with integer square roots. -/
def js (n : ℕ) : ℕ := if n % 2 = 0 then Nat.sqrt n else Nat.sqrt (n ^ 3)

theorem step_eq (n : ℕ) : JugglerConjecture.jugglerStep n = js n := by
  unfold JugglerConjecture.jugglerStep js
  by_cases h : n % 2 = 0
  · rw [if_pos (Nat.even_iff.mpr h), if_pos h, ← Real.sqrt_eq_rpow]
    exact Real.nat_floor_real_sqrt_eq_nat_sqrt
  · have hne : ¬ Even n := fun he => h (Nat.even_iff.mp he)
    have e : (n : ℝ) ^ (3 / 2 : ℝ) = Real.sqrt ((n ^ 3 : ℕ) : ℝ) := by
      rw [Real.sqrt_eq_rpow, Nat.cast_pow, ← Real.rpow_natCast, ← Real.rpow_mul (Nat.cast_nonneg n)]
      norm_num
    rw [if_neg hne, if_neg h, e]
    exact Real.nat_floor_real_sqrt_eq_nat_sqrt

/-- `l` is the juggler trajectory after `a`, ending in `1`; each term is certified as an integer
square root by two inequalities. -/
def chk : ℕ → List ℕ → Bool
  | a, [] => decide (a = 1)
  | a, b :: l =>
    (decide (b * b ≤ (if a % 2 = 0 then a else a ^ 3)) &&
      decide ((if a % 2 = 0 then a else a ^ 3) < (b + 1) * (b + 1))) && chk b l

theorem chk_spec : ∀ (l : List ℕ) (a : ℕ), chk a l = true → ∃ m, js^[m] a = 1 := by
  intro l
  induction l with
  | nil =>
    intro a h
    rw [chk, decide_eq_true_eq] at h
    exact ⟨0, h⟩
  | cons b l ih =>
    intro a h
    rw [chk, Bool.and_eq_true, Bool.and_eq_true, decide_eq_true_eq, decide_eq_true_eq] at h
    obtain ⟨m, hm⟩ := ih b h.2
    have hb : js a = b := by
      unfold js
      by_cases h2 : a % 2 = 0
      · rw [if_pos h2] at h ⊢
        exact (Nat.eq_sqrt.mpr h.1).symm
      · rw [if_neg h2] at h ⊢
        exact (Nat.eq_sqrt.mpr h.1).symm
    exact ⟨m + 1, by rw [Function.iterate_succ_apply, hb, hm]⟩

/-- Trajectories for consecutive starting values. -/
def all : ℕ → List (List ℕ) → Bool
  | _, [] => true
  | n, l :: ls => chk n l && all (n + 1) ls

theorem all_spec : ∀ (ls : List (List ℕ)) (n : ℕ), all n ls = true → ∀ i, i < ls.length →
    ∃ m, js^[m] (n + i) = 1 := by
  intro ls
  induction ls with
  | nil =>
    intro n _ i hi
    simp at hi
  | cons l ls ih =>
    intro n h i hi
    rw [all, Bool.and_eq_true] at h
    rcases Nat.eq_zero_or_pos i with rfl | hpos
    · exact chk_spec l n h.1
    · have hi' : i - 1 < ls.length := by
        rw [List.length_cons] at hi
        omega
      obtain ⟨m, hm⟩ := ih (n + 1) h.2 (i - 1) hi'
      have e : n + 1 + (i - 1) = n + i := by omega
      rw [e] at hm
      exact ⟨m, hm⟩

