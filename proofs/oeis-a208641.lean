theorem N0 : ∀ p, N p 0 = tA T0 (p.1 0) (p.1 1) (p.1 2) (p.1 3) (p.1 4) (p.1 5) (p.2 0) (p.2 1) (p.2 2) (p.2 3) (p.2 4) (p.2 5) := fun p => by rw [N_zero, T0_one]

/-- The states that a column can lead to. -/
def reachB (a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 : Fin 2) : Bool := decide ((() >>> iA a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11) % 2 = 1)

theorem reach_cells : ∀ c0 c1 c2 c3 c4 c5 q0 q1 q2 q3 q4 q5 : Fin 2,
    aB ![c0, c1, c2, c3, c4, c5] ![q0, q1, q2, q3, q4, q5] = true →
      reachB q0 q1 q2 q3 q4 q5 (tnB ![c0, c1, c2, c3, c4, c5] ![q0, q1, q2, q3, q4, q5] 0) (tnB ![c0, c1, c2, c3, c4, c5] ![q0, q1, q2, q3, q4, q5] 1) (tnB ![c0, c1, c2, c3, c4, c5] ![q0, q1, q2, q3, q4, q5] 2) (tnB ![c0, c1, c2, c3, c4, c5] ![q0, q1, q2, q3, q4, q5] 3) (tnB ![c0, c1, c2, c3, c4, c5] ![q0, q1, q2, q3, q4, q5] 4) (tnB ![c0, c1, c2, c3, c4, c5] ![q0, q1, q2, q3, q4, q5] 5) = true := by
  decide +kernel

theorem reach_first : ∀ q0 q1 q2 q3 q4 q5 : Fin 2, q0 = 0 →
    reachB q0 q1 q2 q3 q4 q5 (tn0 ![q0, q1, q2, q3, q4, q5] 0) (tn0 ![q0, q1, q2, q3, q4, q5] 1) (tn0 ![q0, q1, q2, q3, q4, q5] 2) (tn0 ![q0, q1, q2, q3, q4, q5] 3) (tn0 ![q0, q1, q2, q3, q4, q5] 4) (tn0 ![q0, q1, q2, q3, q4, q5] 5) = true := by
  decide +kernel

theorem col_eta (c : Col) : c = ![c 0, c 1, c 2, c 3, c 4, c 5] := by
  funext j; fin_cases j <;> rfl

theorem reach_step (c t q : Col) (h : okB c t q = true) :
    reachB (q 0) (q 1) (q 2) (q 3) (q 4) (q 5) (tnB c q 0) (tnB c q 1) (tnB c q 2) (tnB c q 3) (tnB c q 4) (tnB c q 5) = true := by
  have h1 := reach_cells (c 0) (c 1) (c 2) (c 3) (c 4) (c 5) (q 0) (q 1) (q 2) (q 3) (q 4) (q 5)
  rw [← col_eta c, ← col_eta q] at h1
  exact h1 (okB_aB c t q h)

theorem reach_init (q : Col) (h : q 0 = 0) :
    reachB (q 0) (q 1) (q 2) (q 3) (q 4) (q 5) (tn0 q 0) (tn0 q 1) (tn0 q 2) (tn0 q 3) (tn0 q 4) (tn0 q 5) = true := by
  have h1 := reach_first (q 0) (q 1) (q 2) (q 3) (q 4) (q 5)
  rw [← col_eta q] at h1
  exact h1 h

