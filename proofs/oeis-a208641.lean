theorem N_next (m : ℕ) (A B : ℕ) (hA : ∀ p, N p m = tA A (p.1 0) (p.1 1) (p.1 2) (p.1 3) (p.1 4) (p.1 5) (p.2 0) (p.2 1) (p.2 2) (p.2 3) (p.2 4) (p.2 5))
    (h : step (tA A) = tA B) (p : Col × Col) :
    N p (m + 1) = tA B (p.1 0) (p.1 1) (p.1 2) (p.1 3) (p.1 4) (p.1 5) (p.2 0) (p.2 1) (p.2 2) (p.2 3) (p.2 4) (p.2 5) := by
  rw [N_succ]
  simp only [hA]
  rw [row_sum, h]

