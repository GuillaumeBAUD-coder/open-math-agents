/-- Barker's closed form, for n >= 4. -/
theorem closed (n : ℕ) (hn : 4 ≤ n) : (a n : ℚ) = (792 * (7 * 2 ^ n - 10) - 3382 * n - 539 * n ^ 2 - 38 * n ^ 3 - n ^ 4) / 24 := by
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    rcases Nat.lt_or_ge n 10 with h | h
    · interval_cases n <;> norm_num [v1, v2, v3, v4, v5, v6, v7, v8, v9]
    · obtain ⟨m, rfl⟩ : ∃ m, n = m + 10 := ⟨n - 10, by omega⟩
      rw [a_recQ m, ih (m + 9) (by omega) (by omega), ih (m + 8) (by omega) (by omega), ih (m + 7) (by omega) (by omega), ih (m + 6) (by omega) (by omega), ih (m + 5) (by omega) (by omega), ih (m + 4) (by omega) (by omega)]
      push_cast; ring

/-- Barker's g.f., as A(x) (denominator) = numerator. -/
theorem gf_mul : gf * ((1 - X) ^ 5 * (1 - 2 * X)) = X * (32 + 9 * X - 140 * X ^ 2 + 74 * X ^ 3 + 85 * X ^ 4 - 37 * X ^ 5 - 34 * X ^ 6 + 4 * X ^ 7 + 8 * X ^ 8) := by
  have e1 : gf * ((1 - X) ^ 5 * (1 - 2 * X)) = gf - C (7 : ℚ) * (gf * X ^ 1) + C (20 : ℚ) * (gf * X ^ 2) - C (30 : ℚ) * (gf * X ^ 3) + C (25 : ℚ) * (gf * X ^ 4) - C (11 : ℚ) * (gf * X ^ 5) + C (2 : ℚ) * (gf * X ^ 6) := by
    simp only [map_ofNat]; ring
  have e2 : (X * (32 + 9 * X - 140 * X ^ 2 + 74 * X ^ 3 + 85 * X ^ 4 - 37 * X ^ 5 - 34 * X ^ 6 + 4 * X ^ 7 + 8 * X ^ 8) : ℚ⟦X⟧) = X ^ 1 * C (32 : ℚ) + X ^ 2 * C (9 : ℚ) - X ^ 3 * C (140 : ℚ) + X ^ 4 * C (74 : ℚ) + X ^ 5 * C (85 : ℚ) - X ^ 6 * C (37 : ℚ) - X ^ 7 * C (34 : ℚ) + X ^ 8 * C (4 : ℚ) + X ^ 9 * C (8 : ℚ) := by
    simp only [map_ofNat]; ring
  rw [e1, e2]
  ext n
  have hc : ∀ k, coeff k gf = if k = 0 then (0 : ℚ) else a k := fun k => by rw [gf, coeff_mk]
  simp only [map_add, map_sub, coeff_C_mul, coeff_mul_C, coeff_X_pow, coeff_mul_X_pow', hc]
  rcases Nat.lt_or_ge n 10 with hn | hn
  · have w1 := v1; have w2 := v2; have w3 := v3; have w4 := v4; have w5 := v5; have w6 := v6; have w7 := v7; have w8 := v8; have w9 := v9
    interval_cases n <;> simp_all <;> norm_num
  · obtain ⟨m, rfl⟩ : ∃ m, n = m + 10 := ⟨n - 10, by omega⟩
    have s1 : m + 10 - 1 = m + 9 := by omega
    have s2 : m + 10 - 2 = m + 8 := by omega
    have s3 : m + 10 - 3 = m + 7 := by omega
    have s4 : m + 10 - 4 = m + 6 := by omega
    have s5 : m + 10 - 5 = m + 5 := by omega
    have s6 : m + 10 - 6 = m + 4 := by omega
    rw [s1, s2, s3, s4, s5, s6]
    simp only [show ¬ m + 10 = 0 by omega, show ¬ m + 9 = 0 by omega, show ¬ m + 8 = 0 by omega, show ¬ m + 7 = 0 by omega, show ¬ m + 6 = 0 by omega, show ¬ m + 5 = 0 by omega, show ¬ m + 4 = 0 by omega, show 1 ≤ m + 10 by omega, show 2 ≤ m + 10 by omega, show 3 ≤ m + 10 by omega, show 4 ≤ m + 10 by omega, show 5 ≤ m + 10 by omega, show 6 ≤ m + 10 by omega, show ¬ m + 10 = 1 by omega, show ¬ m + 10 = 2 by omega, show ¬ m + 10 = 3 by omega, show ¬ m + 10 = 4 by omega, show ¬ m + 10 = 5 by omega, show ¬ m + 10 = 6 by omega, show ¬ m + 10 = 7 by omega, show ¬ m + 10 = 8 by omega, show ¬ m + 10 = 9 by omega, if_true, if_false]
    have h := a_recQ (m + 0)
    simp only [add_assoc, Nat.reduceAdd] at h
    rw [h]
