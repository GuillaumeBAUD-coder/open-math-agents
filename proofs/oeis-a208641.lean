import OMAStatements.S_oeis_a208641

/-!
Proof of Barker's conjectures for OEIS A208641, by a transfer computation over the columns.

The array is read column by column. A column together with, for each of its elements, whether it
already equals its leftward or upward neighbour, is a state; a state and the next column determine
whether the right-upward condition holds and the next state. The continuation counts N of the
states satisfy, on every state that a column can lead to, the recurrence of the polynomial
x^3 (x - 1) (x - 1) (x - 1) (x - 1) (x - 1) (x - 2). Each column step is factored into 6 cell steps
(s5, ..., s0), with intermediate tables that the kernel computes itself (`mkB`). The tables of
N_0 .. N_9 were computed by a script and are checked by the kernel.
-/

namespace OMA.S_oeis_a208641

open PowerSeries Classical


abbrev Col := Fin 6 → Fin 2

/-- Neighbour relations for a sequence of columns `y`, with an optional column `p` to the left of
`y 0`. -/
def L' {m : ℕ} (p : Option Col) (y : Fin m → Col) (i : Fin 6) (j : Fin m) : Prop :=
  (j.val = 0 ∧ ∃ c, p = some c ∧ c i = y j i) ∨ ∃ j' : Fin m, j'.val + 1 = j.val ∧ y j' i = y j i
def U' {m : ℕ} (y : Fin m → Col) (i : Fin 6) (j : Fin m) : Prop :=
  ∃ i' : Fin 6, i'.val + 1 = i.val ∧ y j i' = y j i
def R' {m : ℕ} (y : Fin m → Col) (i : Fin 6) (j : Fin m) : Prop :=
  ∃ i' : Fin 6, ∃ j' : Fin m, i'.val + 1 = i.val ∧ j'.val = j.val + 1 ∧ y j' i' = y j i
def Few {m : ℕ} (p : Option Col) (y : Fin m → Col) : Prop :=
  ∀ i j, ¬ (L' p y i j ∧ U' y i j) ∧ ¬ (L' p y i j ∧ R' y i j) ∧ ¬ (U' y i j ∧ R' y i j)

theorem few_iff {n : ℕ} (x : Fin 6 → Fin n → Fin 2) :
    fewEqual x ↔ Few none (fun j i => x i j) := by
  unfold fewEqual Few
  refine forall_congr' fun i => forall_congr' fun j => ?_
  have hL : eqLeft x i j ↔ L' none (fun j i => x i j) i j := by
    simp [eqLeft, L']
  have hU : eqUp x i j ↔ U' (fun j i => x i j) i j := Iff.rfl
  have hR : eqRightUp x i j ↔ R' (fun j i => x i j) i j := Iff.rfl
  rw [hL, hU, hR]

/-- The window condition of the column c, with the column p to its left (if any) and the column q
to its right (if any). -/
def Lw (p : Option Col) (c : Col) (i : Fin 6) : Prop := ∃ d, p = some d ∧ d i = c i
def Uw (c : Col) (i : Fin 6) : Prop := ∃ i' : Fin 6, i'.val + 1 = i.val ∧ c i' = c i
def Rw (c : Col) (q : Option Col) (i : Fin 6) : Prop :=
  ∃ d, q = some d ∧ ∃ i' : Fin 6, i'.val + 1 = i.val ∧ d i' = c i
def Ww (p : Option Col) (c : Col) (q : Option Col) : Prop :=
  ∀ i, ¬ (Lw p c i ∧ Uw c i) ∧ ¬ (Lw p c i ∧ Rw c q i) ∧ ¬ (Uw c i ∧ Rw c q i)

theorem few_cons {m : ℕ} (p : Option Col) (c : Col) (y : Fin m → Col) :
    Few p (Fin.cons c y : Fin (m + 1) → Col) ↔
      Ww p c (if h : 0 < m then some (y ⟨0, h⟩) else none) ∧ Few (some c) y := by
  unfold Few Ww
  have hL0 : ∀ i, L' p (Fin.cons c y : Fin (m + 1) → Col) i 0 ↔ Lw p c i := by
    intro i
    simp only [L', Lw, Fin.val_zero, true_and, Fin.cons_zero]
    constructor
    · rintro (h | ⟨j', hj', _⟩)
      · exact h
      · omega
    · intro h; exact Or.inl h
  have hU0 : ∀ i, U' (Fin.cons c y : Fin (m + 1) → Col) i 0 ↔ Uw c i := by
    intro i; simp [U', Uw]
  have hR0 : ∀ i, R' (Fin.cons c y : Fin (m + 1) → Col) i 0 ↔
      Rw c (if h : 0 < m then some (y ⟨0, h⟩) else none) i := by
    intro i
    simp only [R', Rw, Fin.val_zero, zero_add, Fin.cons_zero]
    constructor
    · rintro ⟨i', j', hi, hj, he⟩
      have hm : 0 < m := by have := j'.isLt; omega
      refine ⟨y ⟨0, hm⟩, by simp [hm], i', hi, ?_⟩
      have : j' = Fin.succ ⟨0, hm⟩ := Fin.ext (by simp [hj])
      subst this
      rw [Fin.cons_succ] at he
      exact he
    · rintro ⟨d, hd, i', hi, he⟩
      by_cases hm : 0 < m
      · simp only [hm, dite_true, Option.some.injEq] at hd
        subst hd
        refine ⟨i', Fin.succ ⟨0, hm⟩, hi, by simp, ?_⟩
        rw [Fin.cons_succ]
        exact he
      · simp [hm] at hd
  have hLs : ∀ i (j : Fin m), L' p (Fin.cons c y : Fin (m + 1) → Col) i j.succ ↔
      L' (some c) y i j := by
    intro i j
    simp only [L', Fin.val_succ, Fin.cons_succ, Option.some.injEq, exists_eq_left']
    constructor
    · rintro (⟨h, _⟩ | ⟨j', hj', he⟩)
      · omega
      · refine Fin.cases (motive := fun j' => j'.val + 1 = j.val + 1 →
          (Fin.cons c y : Fin (m + 1) → Col) j' i = y j i → _) ?_ ?_ j' hj' he
        · intro h0 he0
          left
          refine ⟨by simpa using h0, ?_⟩
          simpa using he0
        · intro k hk hek
          right
          exact ⟨k, by simpa using hk, by simpa using hek⟩
    · rintro (⟨h0, he⟩ | ⟨j', hj', he⟩)
      · right
        exact ⟨0, by simp [h0], by simpa using he⟩
      · right
        exact ⟨j'.succ, by simp [hj'], by simpa using he⟩
  have hUs : ∀ i (j : Fin m), U' (Fin.cons c y : Fin (m + 1) → Col) i j.succ ↔ U' y i j := by
    intro i j; simp [U']
  have hRs : ∀ i (j : Fin m), R' (Fin.cons c y : Fin (m + 1) → Col) i j.succ ↔ R' y i j := by
    intro i j
    simp only [R', Fin.val_succ]
    constructor
    · rintro ⟨i', j', hi, hj, he⟩
      refine Fin.cases (motive := fun j' => j'.val = j.val + 1 + 1 →
          (Fin.cons c y : Fin (m + 1) → Col) j' i' = (Fin.cons c y : Fin (m + 1) → Col) j.succ i → _)
        ?_ ?_ j' hj he
      · intro h; simp at h
      · intro k hk hek
        exact ⟨i', k, hi, by simpa using hk, by simpa using hek⟩
    · rintro ⟨i', j', hi, hj, he⟩
      exact ⟨i', j'.succ, hi, by simp [hj], by simpa using he⟩
  constructor
  · intro h
    refine ⟨fun i => ?_, fun i j => ?_⟩
    · have := h i 0
      rwa [hL0, hU0, hR0] at this
    · have := h i j.succ
      rwa [hLs, hUs, hRs] at this
  · rintro ⟨h0, hs⟩ i j
    refine Fin.cases ?_ (fun j => ?_) j
    · rw [hL0, hU0, hR0]; exact h0 i
    · rw [hLs, hUs, hRs]; exact hs i j



theorem order_iff {n : ℕ} (x : Fin 6 → Fin n → Fin 2) :
    newInOrder x ↔ ∀ j : Fin n, j.val = 0 → x 0 j = 0 := by
  constructor
  · intro h j hj
    by_contra hne
    have h1 : x 0 j = 1 := by
      have h2 : (x 0 j).val ≠ 0 := fun h => hne (Fin.ext h)
      have h3 := (x 0 j).isLt
      exact Fin.ext (by simp; omega)
    obtain ⟨i', j', h2, -⟩ := h 0 j h1
    rcases h2 with h2 | ⟨-, h2⟩
    · simp at h2
    · omega
  · intro h i j hij
    have hn : 0 < n := j.pos
    refine ⟨0, ⟨0, hn⟩, ?_, h ⟨0, hn⟩ rfl⟩
    by_cases hi : i.val = 0
    · right
      refine ⟨Fin.ext (by simp [hi]), ?_⟩
      show 0 < j.val
      by_contra hj
      have hj0 : j = ⟨0, hn⟩ := Fin.ext (by simp; omega)
      have hi0 : i = 0 := Fin.ext (by simp [hi])
      rw [hj0, hi0, h ⟨0, hn⟩ rfl] at hij
      exact absurd hij (by decide)
    · left
      simp only [Fin.val_zero]
      omega

/-- Whether each element of the column c equals its leftward (in p) or upward neighbour. -/
noncomputable def tn (p : Option Col) (c : Col) : Col := fun i => if Lw p c i ∨ Uw c i then 1 else 0
def Aw (p : Option Col) (c : Col) : Prop := ∀ i, ¬ (Lw p c i ∧ Uw c i)
def Bw (c t : Col) (q : Option Col) : Prop := ∀ i, ¬ (t i = 1 ∧ Rw c q i)

theorem ww_iff (p : Option Col) (c : Col) (q : Option Col) :
    Ww p c q ↔ Aw p c ∧ Bw c (tn p c) q := by
  unfold Ww Aw Bw tn
  constructor
  · intro h
    refine ⟨fun i => (h i).1, fun i hi => ?_⟩
    obtain ⟨-, h2, h3⟩ := h i
    by_cases hl : Lw p c i
    · exact h2 ⟨hl, hi.2⟩
    · by_cases hu : Uw c i
      · exact h3 ⟨hu, hi.2⟩
      · have h4 := hi.1
        simp [hl, hu] at h4
  · rintro ⟨ha, hb⟩ i
    exact ⟨ha i, fun hlr => hb i ⟨by simp [hlr.1], hlr.2⟩, fun hur => hb i ⟨by simp [hur.1], hur.2⟩⟩

/-- The first column, if any. -/
def hd {m : ℕ} (y : Fin m → Col) : Option Col := if h : 0 < m then some (y ⟨0, h⟩) else none

/-- The continuation counts of the state p (a column and its flags) by m columns. -/
noncomputable def N (p : Col × Col) (m : ℕ) : ℕ :=
  ∑ y : Fin m → Col, if Bw p.1 p.2 (hd y) ∧ Few (some p.1) y then 1 else 0

/-- The cell conditions and flags, as Booleans. -/
def aC (c qp x : Fin 2) : Bool := !(decide (c = x) && decide (qp = x))
def cB (t c qp x : Fin 2) : Bool := !(decide (t = 1) && decide (qp = c)) && aC c qp x
def uB (c qp x : Fin 2) : Fin 2 := if decide (c = x) || decide (qp = x) then 1 else 0
def u0 (c x : Fin 2) : Fin 2 := if c = x then 1 else 0
def okB (c t q : Col) : Bool := (cB (t 1) (c 1) (q 0) (q 1) && (cB (t 2) (c 2) (q 1) (q 2) && (cB (t 3) (c 3) (q 2) (q 3) && (cB (t 4) (c 4) (q 3) (q 4) && cB (t 5) (c 5) (q 4) (q 5)))))
def aB (c q : Col) : Bool := (aC (c 1) (q 0) (q 1) && (aC (c 2) (q 1) (q 2) && (aC (c 3) (q 2) (q 3) && (aC (c 4) (q 3) (q 4) && aC (c 5) (q 4) (q 5)))))
def tnB (c q : Col) : Col := ![u0 (c 0) (q 0), uB (c 1) (q 0) (q 1), uB (c 2) (q 1) (q 2), uB (c 3) (q 2) (q 3), uB (c 4) (q 3) (q 4), uB (c 5) (q 4) (q 5)]
def tn0 (q : Col) : Col := ![0, if q 0 = q 1 then 1 else 0, if q 1 = q 2 then 1 else 0, if q 2 = q 3 then 1 else 0, if q 3 = q 4 then 1 else 0, if q 4 = q 5 then 1 else 0]

set_option maxHeartbeats 8000000 in
theorem okB_iff (c t q : Col) : (Bw c t (some q) ∧ Aw (some c) q) ↔ okB c t q = true := by
  simp only [Bw, Aw, Rw, Lw, Uw, okB, cB, aC, Option.some.injEq, exists_eq_left', Fin.forall_fin_succ,
    Fin.exists_fin_succ, Bool.and_eq_true, Bool.not_eq_true', Bool.and_eq_false_iff, decide_eq_true_eq,
    decide_eq_false_iff_not]
  simp
  try tauto

set_option maxHeartbeats 8000000 in
theorem tn_eq (c q : Col) : tn (some c) q = tnB c q := by
  funext i
  fin_cases i <;> simp [tn, tnB, Lw, Uw, u0, uB, Fin.exists_fin_succ] <;> try tauto

set_option maxHeartbeats 8000000 in
theorem tn0_eq (q : Col) : tn none q = tn0 q := by
  funext i
  fin_cases i <;> simp [tn, tn0, Lw, Uw, Fin.exists_fin_succ]

theorem okB_aB (c t q : Col) (h : okB c t q = true) : aB c q = true := by
  simp only [okB, aB, cB, Bool.and_eq_true] at h ⊢
  tauto

theorem hd_cons {m : ℕ} (q : Col) (y : Fin m → Col) : hd (Fin.cons q y : Fin (m + 1) → Col) = some q := by
  simp [hd]

theorem N_zero (p : Col × Col) : N p 0 = 1 := by
  simp [N, Bw, Rw, Few, hd]

theorem N_succ (p : Col × Col) (m : ℕ) :
    N p (m + 1) = ∑ q : Col, if okB p.1 p.2 q = true then N (q, tnB p.1 q) m else 0 := by
  unfold N
  rw [← (Fin.consEquiv fun _ => Col).sum_comp, Fintype.sum_prod_type]
  refine Finset.sum_congr rfl fun q _ => ?_
  have hce : ∀ y : Fin m → Col, (Fin.consEquiv fun _ => Col) (q, y) = Fin.cons q y := fun _ => rfl
  simp only [hce, hd_cons, few_cons, ww_iff, ← tn_eq]
  by_cases hc : Bw p.1 p.2 (some q) ∧ Aw (some p.1) q
  · rw [if_pos ((okB_iff _ _ _).1 hc)]
    refine Finset.sum_congr rfl fun y _ => if_congr ?_ rfl rfl
    constructor
    · rintro ⟨-, ⟨-, h1⟩, h2⟩
      exact ⟨h1, h2⟩
    · rintro ⟨h1, h2⟩
      exact ⟨hc.1, ⟨hc.2, h1⟩, h2⟩
  · rw [if_neg (fun h => hc ((okB_iff _ _ _).2 h))]
    apply Finset.sum_eq_zero
    intro y _
    rw [if_neg]
    rintro ⟨h1, ⟨h2, -⟩, -⟩
    exact hc ⟨h1, h2⟩

theorem a_eq (m : ℕ) : a (m + 1) = ∑ q : Col, if q 0 = 0 then N (q, tn0 q) m else 0 := by
  unfold a
  rw [Finset.card_filter, ← (Equiv.piComm fun (_ : Fin (m + 1)) (_ : Fin 6) => Fin 2).sum_comp,
    ← (Fin.consEquiv fun _ => Col).sum_comp, Fintype.sum_prod_type]
  refine Finset.sum_congr rfl fun q _ => ?_
  have hpc : ∀ y : Fin m → Col, (Equiv.piComm fun (_ : Fin (m + 1)) (_ : Fin 6) => Fin 2)
      ((Fin.consEquiv fun _ => Col) (q, y)) = fun i j => (Fin.cons q y : Fin (m + 1) → Col) j i :=
    fun _ => rfl
  simp only [hpc, order_iff, few_iff]
  have e1 : ∀ y : Fin m → Col, (∀ j : Fin (m + 1), j.val = 0 → (Fin.cons q y : Fin (m + 1) → Col) j 0 = 0) ↔
      q 0 = 0 := by
    intro y
    constructor
    · intro h; exact h 0 rfl
    · intro h j hj
      have : j = 0 := Fin.ext hj
      subst this
      simpa using h
  have e2 : ∀ y : Fin m → Col, Few none (fun j i => (Fin.cons q y : Fin (m + 1) → Col) j i) ↔
      Bw q (tn0 q) (hd y) ∧ Few (some q) y := by
    intro y
    rw [show (fun j i => (Fin.cons q y : Fin (m + 1) → Col) j i) = Fin.cons q y from rfl, few_cons,
      ww_iff, tn0_eq]
    constructor
    · rintro ⟨⟨-, h1⟩, h2⟩
      exact ⟨h1, h2⟩
    · rintro ⟨h1, h2⟩
      refine ⟨⟨fun i h => ?_, h1⟩, h2⟩
      obtain ⟨d, hd', -⟩ := h.1
      simp at hd'
  by_cases hq : q 0 = 0
  · rw [if_pos hq]
    unfold N
    refine Finset.sum_congr rfl fun y _ => if_congr ?_ rfl rfl
    rw [e1, e2]
    simp [hq]
  · rw [if_neg hq]
    apply Finset.sum_eq_zero
    intro y _
    rw [if_neg]
    rw [e1]
    tauto


/-! The column sums, one cell at a time. -/

abbrev FA := Fin 2 → Fin 2 → Fin 2 → Fin 2 → Fin 2 → Fin 2 → Fin 2 → Fin 2 → Fin 2 → Fin 2 → Fin 2 → Fin 2 → ℕ

def sm (f : Fin 2 → ℕ) : ℕ := f 0 + f 1

theorem sm_eq (f : Fin 2 → ℕ) : sm f = ∑ x, f x := by
  simp [sm, Fin.sum_univ_succ]

def s5 (H : FA) : FA := fun q0 q1 q2 q3 q4 u0 u1 u2 u3 u4 c5 t5 =>
  sm fun x => if cB t5 c5 q4 x = true then H q0 q1 q2 q3 q4 x u0 u1 u2 u3 u4 (uB c5 q4 x) else 0
def s4 (H : FA) : FA := fun q0 q1 q2 q3 u0 u1 u2 u3 c4 c5 t4 t5 =>
  sm fun x => if cB t4 c4 q3 x = true then H q0 q1 q2 q3 x u0 u1 u2 u3 (uB c4 q3 x) c5 t5 else 0
def s3 (H : FA) : FA := fun q0 q1 q2 u0 u1 u2 c3 c4 c5 t3 t4 t5 =>
  sm fun x => if cB t3 c3 q2 x = true then H q0 q1 q2 x u0 u1 u2 (uB c3 q2 x) c4 c5 t4 t5 else 0
def s2 (H : FA) : FA := fun q0 q1 u0 u1 c2 c3 c4 c5 t2 t3 t4 t5 =>
  sm fun x => if cB t2 c2 q1 x = true then H q0 q1 x u0 u1 (uB c2 q1 x) c3 c4 c5 t3 t4 t5 else 0
def s1 (H : FA) : FA := fun q0 u0 c1 c2 c3 c4 c5 t1 t2 t3 t4 t5 =>
  sm fun x => if cB t1 c1 q0 x = true then H q0 x u0 (uB c1 q0 x) c2 c3 c4 c5 t2 t3 t4 t5 else 0
def s0 (H : FA) : FA := fun c0 c1 c2 c3 c4 c5 t0 t1 t2 t3 t4 t5 =>
  sm fun x => H x (u0 c0 x) c1 c2 c3 c4 c5 t1 t2 t3 t4 t5

def step (F : FA) : FA := s0 (s1 (s2 (s3 (s4 (s5 (F))))))

theorem sum_pi (g : Col → ℕ) :
    ∑ c, g c = ∑ r0 : Fin 2, ∑ r1 : Fin 2, ∑ r2 : Fin 2, ∑ r3 : Fin 2, ∑ r4 : Fin 2, ∑ r5 : Fin 2, g ![r0, r1, r2, r3, r4, r5] := by
  let e : Fin 2 × Fin 2 × Fin 2 × Fin 2 × Fin 2 × Fin 2 ≃ Col :=
    { toFun := fun x => ![x.1, x.2.1, x.2.2.1, x.2.2.2.1, x.2.2.2.2.1, x.2.2.2.2.2]
      invFun := fun f => (f 0, f 1, f 2, f 3, f 4, f 5)
      left_inv := fun x => rfl
      right_inv := fun f => by
        funext j
        fin_cases j <;> rfl }
  rw [← e.sum_comp]
  simp only [Fintype.sum_prod_type]
  rfl

theorem okB_eq (c t : Col) (r0 r1 r2 r3 r4 r5 : Fin 2) :
    okB c t ![r0, r1, r2, r3, r4, r5] = (cB (t 1) (c 1) r0 r1 && (cB (t 2) (c 2) r1 r2 && (cB (t 3) (c 3) r2 r3 && (cB (t 4) (c 4) r3 r4 && cB (t 5) (c 5) r4 r5)))) := rfl

theorem tnB_0 (c : Col) (r0 r1 r2 r3 r4 r5 : Fin 2) : tnB c ![r0, r1, r2, r3, r4, r5] 0 = u0 (c 0) r0 := rfl
theorem tnB_1 (c : Col) (r0 r1 r2 r3 r4 r5 : Fin 2) : tnB c ![r0, r1, r2, r3, r4, r5] 1 = uB (c 1) r0 r1 := rfl
theorem tnB_2 (c : Col) (r0 r1 r2 r3 r4 r5 : Fin 2) : tnB c ![r0, r1, r2, r3, r4, r5] 2 = uB (c 2) r1 r2 := rfl
theorem tnB_3 (c : Col) (r0 r1 r2 r3 r4 r5 : Fin 2) : tnB c ![r0, r1, r2, r3, r4, r5] 3 = uB (c 3) r2 r3 := rfl
theorem tnB_4 (c : Col) (r0 r1 r2 r3 r4 r5 : Fin 2) : tnB c ![r0, r1, r2, r3, r4, r5] 4 = uB (c 4) r3 r4 := rfl
theorem tnB_5 (c : Col) (r0 r1 r2 r3 r4 r5 : Fin 2) : tnB c ![r0, r1, r2, r3, r4, r5] 5 = uB (c 5) r4 r5 := rfl

set_option maxHeartbeats 8000000 in
theorem row_sum (F : FA) (c t : Col) :
    (∑ q : Col, if okB c t q = true then
      F (q 0) (q 1) (q 2) (q 3) (q 4) (q 5) (tnB c q 0) (tnB c q 1) (tnB c q 2) (tnB c q 3) (tnB c q 4) (tnB c q 5) else 0) =
      step F (c 0) (c 1) (c 2) (c 3) (c 4) (c 5) (t 0) (t 1) (t 2) (t 3) (t 4) (t 5) := by
  rw [sum_pi]
  simp only [okB_eq, tnB_0, tnB_1, tnB_2, tnB_3, tnB_4, tnB_5, step, s0, s1, s2, s3, s4, s5, sm_eq, Matrix.cons_val_zero,
    Matrix.cons_val_one, Bool.and_eq_true, ite_and, Finset.sum_ite_irrel, Finset.sum_const_zero]
  simp

/-! Tables, packed as 16-bit fields of one numeral. -/

def look (t i : ℕ) : ℕ := (t >>> (16 * i)) % 2 ^ 16
def pk (f : ℕ → ℕ) : ℕ → ℕ → ℕ
  | 0, acc => acc
  | n + 1, acc => pk f n (acc * 2 ^ 16 + f n)
def dg (i k : ℕ) : Fin 2 := ⟨i / 2 ^ k % 2, Nat.mod_lt _ (by norm_num)⟩
