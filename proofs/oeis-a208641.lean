theorem base : ∀ a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 : Fin 2, reachB a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 = true →
    2 * tA T3 a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 + 25 * tA T5 a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 + 20 * tA T7 a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 + tA T9 a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 = 11 * tA T4 a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 + 30 * tA T6 a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 + 7 * tA T8 a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 := by
  decide +kernel

/-- The recurrence of the continuation counts, on every state of `reach`. -/
theorem N_rec (m : ℕ) : ∀ p, reachB (p.1 0) (p.1 1) (p.1 2) (p.1 3) (p.1 4) (p.1 5) (p.2 0) (p.2 1) (p.2 2) (p.2 3) (p.2 4) (p.2 5) = true → (N p (m + 9) : ℤ) = 7 * N p (m + 8) - 20 * N p (m + 7) + 30 * N p (m + 6) - 25 * N p (m + 5) + 11 * N p (m + 4) - 2 * N p (m + 3) := by
  induction m with
  | zero =>
    intro p hr
    rw [N9, N8, N7, N6, N5, N4, N3]
    have h := base (p.1 0) (p.1 1) (p.1 2) (p.1 3) (p.1 4) (p.1 5) (p.2 0) (p.2 1) (p.2 2) (p.2 3) (p.2 4) (p.2 5) hr
    omega
  | succ m ih =>
    intro p hr
    rw [N_succ p (m + 9), N_succ p (m + 8), N_succ p (m + 7), N_succ p (m + 6), N_succ p (m + 5), N_succ p (m + 4), N_succ p (m + 3)]
    push_cast
    simp only [Finset.mul_sum, ← Finset.sum_add_distrib, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl (fun c _ => ?_)
    split_ifs with hc
    · exact ih _ (reach_step _ _ _ hc)
    · simp

theorem a_rec (m : ℕ) : (a (m + 10) : ℤ) = 7 * a (m + 9) - 20 * a (m + 8) + 30 * a (m + 7) - 25 * a (m + 6) + 11 * a (m + 5) - 2 * a (m + 4) := by
  simp only [a_eq]
  push_cast
  simp only [Finset.mul_sum, ← Finset.sum_add_distrib, ← Finset.sum_sub_distrib]
  refine Finset.sum_congr rfl (fun q _ => ?_)
  split_ifs with hq
  · exact N_rec m (q, tn0 q) (reach_init q hq)
  · simp

theorem a_recQ (m : ℕ) : (a (m + 10) : ℚ) = 7 * a (m + 9) - 20 * a (m + 8) + 30 * a (m + 7) - 25 * a (m + 6) + 11 * a (m + 5) - 2 * a (m + 4) := by
  have h := a_rec m
  exact_mod_cast h

