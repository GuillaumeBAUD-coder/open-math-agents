def ok (t : ℕ × ℕ × ℕ × ℕ × ℕ) : Bool :=
  0 < t.2.1 && 0 < t.2.2.1 && 0 < t.2.2.2.1 && 0 < t.2.2.2.2 &&
    t.1 ^ 3 == t.2.1 ^ 3 + t.2.2.1 ^ 3 + t.2.2.2.1 ^ 3 + t.2.2.2.2 ^ 3

theorem W_ok : W.all ok = true := by decide +kernel

theorem term_of_mem (k : ℕ) (h : k ∈ W.map Prod.fst) : IsTerm k := by
  obtain ⟨⟨k', w, x, y, z⟩, ht, rfl⟩ := List.mem_map.1 h
  have := List.all_eq_true.1 W_ok _ ht
  simp only [ok, Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at this
  obtain ⟨⟨⟨⟨h1, h2⟩, h3⟩, h4⟩, h5⟩ := this
  exact ⟨w, x, y, z, h1, h2, h3, h4, h5⟩

