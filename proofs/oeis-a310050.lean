theorem controls : (List.range 50).map a =
    [1, 3, 6, 10, 13, 16, 19, 20, 26, 35, 34, 31, 34, 46, 51, 46, 49, 56, 62, 61, 62, 69, 72, 76, 79, 82, 83, 84, 92, 99, 100, 97, 100, 110, 115, 112, 113, 122, 128, 127, 126, 133, 138, 140, 145, 148, 149, 148, 156, 165] := by
