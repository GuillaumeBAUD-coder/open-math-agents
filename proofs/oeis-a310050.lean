/-- The numerator as a sum of monomials. -/
theorem gf_num : (-2 * X ^ 16 + X ^ 14 + 3 * X ^ 13 + 7 * X ^ 12 + 15 * X ^ 11 + 21 * X ^ 10 + 29 * X ^ 9 + 29 * X ^ 8 + 28 * X ^ 7 + 29 * X ^ 6 + 25 * X ^ 5 + 19 * X ^ 4 + 13 * X ^ 3 + 7 * X ^ 2 + 3 * X + 1 : ℚ⟦X⟧) = X ^ 0 * C 1 + X ^ 1 * C 3 + X ^ 2 * C 7 + X ^ 3 * C 13 + X ^ 4 * C 19 + X ^ 5 * C 25 + X ^ 6 * C 29 + X ^ 7 * C 28 + X ^ 8 * C 29 + X ^ 9 * C 29 + X ^ 10 * C 21 + X ^ 11 * C 15 + X ^ 12 * C 7 + X ^ 13 * C 3 + X ^ 14 * C 1 - X ^ 16 * C 2 := by
  simp only [map_ofNat, map_one]
