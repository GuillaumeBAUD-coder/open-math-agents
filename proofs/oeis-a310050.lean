/-! The steps satisfy the recurrence, on one period of the residues (negative terms moved across). -/

def drec_baseK : PLift (∀ t : ℕ, t < 140 → dv (t + 14) + dv (t + 12) + dv (t + 2) + dv (t + 0) = dv (t + 9) + 2 * dv (t + 7) + dv (t + 5)) :=
  ⟨by decide +kernel⟩

theorem drec_base : ∀ t : ℕ, t < 140 → dv (t + 14) + dv (t + 12) + dv (t + 2) + dv (t + 0) = dv (t + 9) + 2 * dv (t + 7) + dv (t + 5) := drec_baseK.down

theorem drec (t : ℕ) : (dv (t + 14) : ℤ) = -(dv (t + 12) : ℤ) + (dv (t + 9) : ℤ) + 2 * (dv (t + 7) : ℤ) + (dv (t + 5) : ℤ) - (dv (t + 2) : ℤ) - (dv (t + 0) : ℤ) := by
  have e : ∀ o : ℕ, dv (t + o) = dv (t % 140 + o) := fun o => by
    rw [dv, dv, Nat.mod_add_mod]
  rw [e 0, e 2, e 5, e 7, e 9, e 12, e 14]
  have h := congrArg (Nat.cast : ℕ → ℤ) (drec_base (t % 140) (Nat.mod_lt _ (by norm_num)))
  push_cast at h
  linarith

/-! The recurrence on its first 140 terms, by the kernel (negative terms moved across). -/

def recur_baseK : PLift (∀ q : ℕ, q < 140 → b (q + 17) + b (q + 15) + b (q + 5) + b (q + 3) = b (q + 12) + 2 * b (q + 10) + b (q + 8)) :=
  ⟨by decide +kernel⟩

theorem recur_base : ∀ q : ℕ, q < 140 → b (q + 17) + b (q + 15) + b (q + 5) + b (q + 3) = b (q + 12) + 2 * b (q + 10) + b (q + 8) := recur_baseK.down

theorem b_recur (q : ℕ) : (b (q + 17) : ℤ) = -b (q + 15) + b (q + 12) + 2 * b (q + 10) + b (q + 8) - b (q + 5) - b (q + 3) := by
  induction q using Nat.strong_induction_on with
  | _ q ih =>
    rcases (show q < 140 ∨ 140 ≤ q by omega) with hq | hq
    · have h := congrArg (Nat.cast : ℕ → ℤ) (recur_base q hq)
      push_cast at h
      linarith
    · obtain ⟨v, rfl⟩ : ∃ v, q = v + 140 := ⟨q - 140, by omega⟩
      have h0 : (b (v + 17) : ℤ) = -b (v + 15) + b (v + 12) + 2 * b (v + 10) + b (v + 8) - b (v + 5) - b (v + 3) := ih (v + 0) (by omega)
      have hd := drec v
      have s3 : (b (v + 143) : ℤ) = b (v + 3) + dv (v + 0) := by
        have h := b_step (v + 3) (le_trans (by decide : 3 ≤ 3) (Nat.le_add_left _ v))
        rw [show v + 3 + 140 = v + 143 from Nat.add_assoc _ _ _,
          show v + 3 - 3 = v + 0 from Nat.add_sub_assoc (by decide : 3 ≤ 3) v] at h
        exact_mod_cast h
      have s5 : (b (v + 145) : ℤ) = b (v + 5) + dv (v + 2) := by
        have h := b_step (v + 5) (le_trans (by decide : 3 ≤ 5) (Nat.le_add_left _ v))
        rw [show v + 5 + 140 = v + 145 from Nat.add_assoc _ _ _,
          show v + 5 - 3 = v + 2 from Nat.add_sub_assoc (by decide : 3 ≤ 5) v] at h
        exact_mod_cast h
      have s8 : (b (v + 148) : ℤ) = b (v + 8) + dv (v + 5) := by
        have h := b_step (v + 8) (le_trans (by decide : 3 ≤ 8) (Nat.le_add_left _ v))
        rw [show v + 8 + 140 = v + 148 from Nat.add_assoc _ _ _,
          show v + 8 - 3 = v + 5 from Nat.add_sub_assoc (by decide : 3 ≤ 8) v] at h
        exact_mod_cast h
      have s10 : (b (v + 150) : ℤ) = b (v + 10) + dv (v + 7) := by
        have h := b_step (v + 10) (le_trans (by decide : 3 ≤ 10) (Nat.le_add_left _ v))
        rw [show v + 10 + 140 = v + 150 from Nat.add_assoc _ _ _,
          show v + 10 - 3 = v + 7 from Nat.add_sub_assoc (by decide : 3 ≤ 10) v] at h
        exact_mod_cast h
      have s12 : (b (v + 152) : ℤ) = b (v + 12) + dv (v + 9) := by
        have h := b_step (v + 12) (le_trans (by decide : 3 ≤ 12) (Nat.le_add_left _ v))
        rw [show v + 12 + 140 = v + 152 from Nat.add_assoc _ _ _,
          show v + 12 - 3 = v + 9 from Nat.add_sub_assoc (by decide : 3 ≤ 12) v] at h
        exact_mod_cast h
      have s15 : (b (v + 155) : ℤ) = b (v + 15) + dv (v + 12) := by
        have h := b_step (v + 15) (le_trans (by decide : 3 ≤ 15) (Nat.le_add_left _ v))
        rw [show v + 15 + 140 = v + 155 from Nat.add_assoc _ _ _,
          show v + 15 - 3 = v + 12 from Nat.add_sub_assoc (by decide : 3 ≤ 15) v] at h
        exact_mod_cast h
      have s17 : (b (v + 157) : ℤ) = b (v + 17) + dv (v + 14) := by
        have h := b_step (v + 17) (le_trans (by decide : 3 ≤ 17) (Nat.le_add_left _ v))
        rw [show v + 17 + 140 = v + 157 from Nat.add_assoc _ _ _,
          show v + 17 - 3 = v + 14 from Nat.add_sub_assoc (by decide : 3 ≤ 17) v] at h
        exact_mod_cast h
      show (b (v + 157) : ℤ) = -b (v + 155) + b (v + 152) + 2 * b (v + 150) + b (v + 148) - b (v + 145) - b (v + 143)
      linear_combination s17 - (-1) * s15 - (1) * s12 - (2) * s10 - (1) * s8 - (-1) * s5 - (-1) * s3 + h0 + hd

/-- The recurrence. -/
theorem recur : ∀ n : ℕ, 16 < n → (a n : ℤ) = -a (n - 2) + a (n - 5) + 2 * a (n - 7) + a (n - 9) - a (n - 12) - a (n - 14) := by
  intro n hn
  obtain ⟨q, rfl⟩ : ∃ q, n = q + 17 := ⟨n - 17, by omega⟩
  rw [show q + 17 - 2 = q + 15 from Nat.add_sub_assoc (by decide : 2 ≤ 17) q, show q + 17 - 5 = q + 12 from Nat.add_sub_assoc (by decide : 5 ≤ 17) q, show q + 17 - 7 = q + 10 from Nat.add_sub_assoc (by decide : 7 ≤ 17) q, show q + 17 - 9 = q + 8 from Nat.add_sub_assoc (by decide : 9 ≤ 17) q, show q + 17 - 12 = q + 5 from Nat.add_sub_assoc (by decide : 12 ≤ 17) q, show q + 17 - 14 = q + 3 from Nat.add_sub_assoc (by decide : 14 ≤ 17) q]
  simp only [a_eq_b]
  exact b_recur q

/-- b (n - k) for k ≤ n, and [n = j]: the shapes of the coefficients of the g.f. -/
def bk (n k : ℕ) : ℕ := cond (Nat.ble k n) (b (Nat.sub n k)) 0

def ind (n j : ℕ) : ℕ := cond (Nat.beq n j) 1 0

theorem cast_bk (n k : ℕ) : ((bk n k : ℕ) : ℚ) = if k ≤ n then ((b (n - k) : ℕ) : ℚ) else 0 := by
  rw [bk]
  by_cases h : k ≤ n
  · rw [if_pos h, Nat.ble_eq_true_of_le h]
    rfl
  · rw [if_neg h]
    cases hb : Nat.ble k n
    · simp
    · exact absurd (Nat.le_of_ble_eq_true hb) h

theorem cast_ind (n j : ℕ) : ((ind n j : ℕ) : ℚ) = if n = j then 1 else 0 := by
  rw [ind]
  by_cases h : n = j
  · subst h
    rw [Nat.beq_refl, if_pos rfl]
    simp
  · rw [if_neg h, beq_ff _ _ h]
    simp

/-- The coefficients of A * DEN and NUM agree below 17, in natural numbers (negative terms moved
across). -/
def gfL (n : ℕ) : ℕ := Nat.add (Nat.add (Nat.add (Nat.add (b n) (bk n 2)) (bk n 12)) (bk n 14)) (Nat.mul 2 (ind n 16))

