/-- The denominator times A, as a sum of monomials. -/
theorem gf_den (A : ℚ⟦X⟧) : A * (X ^ 14 + X ^ 12 - X ^ 9 - 2 * X ^ 7 - X ^ 5 + X ^ 2 + 1) = C 1 * A + C 1 * (A * X ^ 2) - C 1 * (A * X ^ 5) - C 2 * (A * X ^ 7) - C 1 * (A * X ^ 9) + C 1 * (A * X ^ 12) + C 1 * (A * X ^ 14) := by
  simp only [map_ofNat, map_one]
