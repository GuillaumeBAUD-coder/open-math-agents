/-!
# A sharp `5/8` bound for Erdős Problem 865

For `A ⊆ {1, …, N}` we say `A` contains a *pairwise-sum triple* if there are distinct
`a, b, c ∈ A` with `a + b, a + c, b + c ∈ A` (`Erdos865.HasTriple`). Let `f₃(N)` be the least
size forcing such a triple. This file assembles the proof that
`f₃(N) = 5N/8 + O(1)`, resolving Erdős Problem 865.

* `Erdos865.erdos865_upper_bound` — every triple-free `A ⊆ [1,N]` has `8|A| ≤ 5N + 53`,
  i.e. `|A| ≤ 5N/8 + O(1)`.
* `Erdos865.erdos865_contains_triple` — every `A ⊆ [1,N]` with `8|A| > 5N + 53` contains a
  pairwise-sum triple (the contrapositive form matching the paper's Theorem 1.1).
* `Erdos865.erdos865` — the packaged existence statement `∃ C, …`.
* `Erdos865.sharpness` — for `N = 8M` (`M ≥ 1`) there is a triple-free `A ⊆ [1,N]` with
  `8|A| = 5N + 16`, so the constant `5/8` is optimal.
-/

open scoped BigOperators
open Finset

namespace Erdos865Port

/-- **Upper bound (Erdős 865).** Every triple-free set `A ⊆ [1,N]` satisfies
`8 * |A| ≤ 5 * N + 53`, i.e. `|A| ≤ (5/8) N + O(1)`. -/
theorem erdos865_upper_bound (N : ℕ) (A : Finset ℕ) (hsub : A ⊆ Finset.Icc 1 N)
    (hA : IsTripleFree A) : 8 * A.card ≤ 5 * N + 53 := by
  have hsub' : A ⊆ Finset.Icc 1 (2 * ((N + 1) / 2)) :=
    hsub.trans (Finset.Icc_subset_Icc_right (by omega))
  have h := even_bound ((N + 1) / 2) A hsub' hA
  omega

/-- **Contains a triple (Erdős 865, Theorem 1.1 form).** Every `A ⊆ [1,N]` with
`5 * N + 53 < 8 * |A|` (i.e. `|A| ≥ (5/8) N + O(1)`) contains a pairwise-sum triple. -/
theorem erdos865_contains_triple (N : ℕ) (A : Finset ℕ) (hsub : A ⊆ Finset.Icc 1 N)
    (hcard : 5 * N + 53 < 8 * A.card) : HasTriple A := by
  by_contra h
  have := erdos865_upper_bound N A hsub h
  omega

/-- The upper bound packaged as an existence statement: there is an absolute constant `C`
such that every triple-free `A ⊆ [1,N]` has `8 * |A| ≤ 5 * N + C`. -/
theorem erdos865 : ∃ C : ℕ, ∀ (N : ℕ) (A : Finset ℕ), A ⊆ Finset.Icc 1 N →
    IsTripleFree A → 8 * A.card ≤ 5 * N + C :=
  ⟨53, erdos865_upper_bound⟩

end Erdos865Port

end

/-! ### Bridge to the Formal Conjectures function `Erdos865.f N 3` -/

namespace Erdos865Port

open Finset Filter Asymptotics

/-- A pairwise-sum triple gives a 3-element subset whose pairwise sums lie in `A`. -/
theorem hasTriple_to_subset {A : Finset ℕ} (h : HasTriple A) :
    ∃ S ⊆ A, S.card = 3 ∧ ∀ x ∈ S, ∀ y ∈ S, x ≠ y → x + y ∈ A := by
  obtain ⟨a, ha, b, hb, c, hc, hab, hac, hbc, h1, h2, h3⟩ := h
  refine ⟨{a, b, c}, ?_, ?_, ?_⟩
  · intro x hx
    simp only [mem_insert, mem_singleton] at hx
    rcases hx with rfl | rfl | rfl <;> assumption
  · exact card_eq_three.mpr ⟨a, b, c, hab, hac, hbc, rfl⟩
  · intro x hx y hy hxy
    simp only [mem_insert, mem_singleton] at hx hy
    rcases hx with rfl | rfl | rfl <;> rcases hy with rfl | rfl | rfl
    · exact absurd rfl hxy
    · exact h1
    · exact h2
    · rw [add_comm]; exact h1
    · exact absurd rfl hxy
    · exact h3
    · rw [add_comm]; exact h2
    · rw [add_comm]; exact h3
    · exact absurd rfl hxy

/-- Conversely, such a 3-element subset is a pairwise-sum triple. -/
theorem subset_to_hasTriple {A S : Finset ℕ} (hS : S ⊆ A) (h3 : S.card = 3)
    (hs : ∀ x ∈ S, ∀ y ∈ S, x ≠ y → x + y ∈ A) : HasTriple A := by
  obtain ⟨a, b, c, hab, hac, hbc, rfl⟩ := card_eq_three.mp h3
  have ha : a ∈ ({a, b, c} : Finset ℕ) := by simp
  have hb : b ∈ ({a, b, c} : Finset ℕ) := by simp
  have hc : c ∈ ({a, b, c} : Finset ℕ) := by simp
  exact ⟨a, hS ha, b, hS hb, c, hS hc, hab, hac, hbc, hs a ha b hb hab, hs a ha c hc hac,
    hs b hb c hc hbc⟩

/-- The property defining `Erdos865.f N 3`. -/
def Good3 (N m : ℕ) : Prop :=
  ∀ A ⊆ Icc 1 N, A.card ≥ m → ∃ S ⊆ A, S.card = 3 ∧ ∀ x ∈ S, ∀ y ∈ S, x ≠ y → x + y ∈ A

theorem f3_eq (N : ℕ) : Erdos865.f N 3 = sInf {m | Good3 N m} := rfl

/-- Upper bound: `(5N + 54)/8 + 1` elements force a pairwise-sum triple. -/
theorem good3_upper (N : ℕ) : Good3 N ((5 * N + 54) / 8 + 1) := by
  intro A hA hcard
  apply hasTriple_to_subset
  by_contra h
  have := erdos865_upper_bound N A hA h
  omega

/-- Lower bound: every admissible `m` exceeds `5 * (N / 8)`. -/
theorem lower_of_good3 (N m : ℕ) (hm : Good3 N m) : 5 * (N / 8) < m := by
  rcases Nat.eq_zero_or_pos (N / 8) with h0 | hpos
  · rw [h0]
    by_contra hle
    have hm0 : m = 0 := by omega
    obtain ⟨S, hS, hS3, -⟩ := hm ∅ (empty_subset _) (by rw [hm0]; exact Nat.zero_le _)
    rw [subset_empty.mp hS, card_empty] at hS3
    omega
  · by_contra hle
    have hM : 1 ≤ N / 8 := hpos
    have hsub : sharpSet (N / 8) ⊆ Icc 1 N :=
      (sharpSet_subset hM).trans (Icc_subset_Icc_right (by omega))
    obtain ⟨S, hS, hS3, hs⟩ := hm (sharpSet (N / 8)) hsub
      (by rw [sharpSet_card hM]; omega)
    exact sharpSet_tripleFree (N / 8) (subset_to_hasTriple hS hS3 hs)

theorem f3_bounds (N : ℕ) :
    5 * (N / 8) < Erdos865.f N 3 ∧ Erdos865.f N 3 ≤ (5 * N + 54) / 8 + 1 := by
  have hne : ({m | Good3 N m} : Set ℕ).Nonempty := ⟨_, good3_upper N⟩
  rw [f3_eq]
  exact ⟨lower_of_good3 N _ (Nat.sInf_mem hne), Nat.sInf_le (good3_upper N)⟩

/-- `f_3(N) ~ 5N/8`. -/
theorem k_three :
    (fun N ↦ (Erdos865.f N 3 : ℝ)) ~[atTop]
      (fun N ↦ (1 / 2 : ℝ) * (1 + ∑ r ∈ Icc 1 (3 - 2), (1 / 4 : ℝ) ^ r) * N) := by
  have hs : ∀ N : ℕ, (1 / 2 : ℝ) * (1 + ∑ r ∈ Icc 1 (3 - 2), (1 / 4 : ℝ) ^ r) * N
      = 5 * N / 8 := by
    intro N
    simp only [show (3 : ℕ) - 2 = 1 from rfl, Finset.Icc_self, Finset.sum_singleton, pow_one]
    ring
  simp only [hs]
  have hb : ∀ N : ℕ, |(Erdos865.f N 3 : ℝ) - 5 * N / 8| ≤ 8 := by
    intro N
    obtain ⟨h1, h2⟩ := f3_bounds N
    have n1 : 5 * N ≤ 8 * Erdos865.f N 3 + 35 := by omega
    have n2 : 8 * Erdos865.f N 3 ≤ 5 * N + 62 := by omega
    have r1 : (5 * N : ℝ) ≤ 8 * (Erdos865.f N 3 : ℝ) + 35 := by exact_mod_cast n1
    have r2 : 8 * (Erdos865.f N 3 : ℝ) ≤ 5 * N + 62 := by exact_mod_cast n2
    rw [abs_le]
    constructor <;> linarith
  refine IsLittleO.isEquivalent ?_
  have hO : (fun N : ℕ ↦ (Erdos865.f N 3 : ℝ) - 5 * N / 8) =O[atTop] (fun _ : ℕ ↦ (1 : ℝ)) :=
    IsBigO.of_bound 8 (Eventually.of_forall fun N => by simpa using hb N)
  refine hO.trans_isLittleO ?_
  rw [isLittleO_one_left_iff]
  have : Tendsto (fun N : ℕ ↦ 5 * (N : ℝ) / 8) atTop atTop := by
    have h5 : Tendsto (fun N : ℕ ↦ 5 * (N : ℝ)) atTop atTop :=
      (tendsto_natCast_atTop_atTop).const_mul_atTop (by norm_num)
    exact h5.atTop_div_const (by norm_num)
  exact tendsto_norm_atTop_atTop.comp this

end Erdos865Port

