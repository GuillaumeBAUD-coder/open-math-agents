/-! ### Generic helpers -/

/-
Inclusion–exclusion upper bound for four finite sets.
-/
theorem four_card_le {X : Type*} [DecidableEq X] (s1 s2 s3 s4 : Finset X) :
    s1.card + s2.card + s3.card + s4.card ≤
      (s1 ∪ s2 ∪ s3 ∪ s4).card +
        ((s1 ∩ s2).card + (s1 ∩ s3).card + (s1 ∩ s4).card +
          (s2 ∩ s3).card + (s2 ∩ s4).card + (s3 ∩ s4).card) := by
  have h1 := Finset.card_union_add_card_inter s1 ( s2 ∪ s3 ∪ s4 );
  have h2 := Finset.card_union_add_card_inter s2 ( s3 ∪ s4 ) ; ( have h3 := Finset.card_union_add_card_inter s3 s4; ( simp_all +decide [ Finset.inter_union_distrib_left ] ) );
  linarith [ Finset.card_union_add_card_inter ( s1 ∩ s2 ) ( s1 ∩ s3 ∪ s1 ∩ s4 ), Finset.card_union_add_card_inter ( s1 ∩ s3 ) ( s1 ∩ s4 ), Finset.card_union_add_card_inter ( s2 ∩ s3 ) ( s2 ∩ s4 ) ]

/-
A natural number below `2m` that is congruent mod `m` to a number below `m`
equals it or exceeds it by exactly `m`.
-/
theorem eq_of_cast_eq {m L R : ℕ} (h : (L : ZMod m) = (R : ZMod m)) (hL : L < 2 * m)
    (hR : R < m) : L = R ∨ L = R + m := by
  rw [ZMod.natCast_eq_natCast_iff', Nat.mod_eq_of_lt hR] at h
  rcases lt_or_ge L m with hl | hl
  · left
    rwa [Nat.mod_eq_of_lt hl] at h
  · right
    have h2 : L % m = L - m := by
      rw [Nat.mod_eq_sub_mod hl, Nat.mod_eq_of_lt (show L - m < m by omega)]
    omega

/-
In `ZMod m` the equation `2 * x = c` has at most two solutions.
-/
theorem card_two_sol (m : ℕ) [NeZero m] (c : ZMod m) :
    (Finset.univ.filter (fun x : ZMod m => 2 * x = c)).card ≤ 2 := by
  have hab : ∀ x : ZMod m, 2 * x = c →
      x = ((c.val / 2 : ℕ) : ZMod m) ∨ x = (((c.val + m) / 2 : ℕ) : ZMod m) := by
    intro x hx
    have h1 : ((2 * x.val : ℕ) : ZMod m) = ((c.val : ℕ) : ZMod m) := by
      rw [Nat.cast_mul, ZMod.natCast_zmod_val, ZMod.natCast_zmod_val]
      exact_mod_cast hx
    have hxl := ZMod.val_lt x
    have hcl := ZMod.val_lt c
    rcases eq_of_cast_eq h1 (by omega) hcl with h | h
    · left
      conv_lhs => rw [← ZMod.natCast_zmod_val x]
      congr 1
      omega
    · right
      conv_lhs => rw [← ZMod.natCast_zmod_val x]
      congr 1
      omega
  refine le_trans (Finset.card_le_card (t := {((c.val / 2 : ℕ) : ZMod m),
    (((c.val + m) / 2 : ℕ) : ZMod m)}) ?_) Finset.card_le_two
  intro x hx
  rw [Finset.mem_filter] at hx
  rw [Finset.mem_insert, Finset.mem_singleton]
  exact hab x hx.2

/-! ### The four sets `T₁,…,T₄` in `ZMod m` -/

/-- `T₁ = B` inside `ZMod m`. -/
def T1 (m : ℕ) (B : Finset ℕ) : Finset (ZMod m) := B.image (fun b : ℕ => (b : ZMod m))

/-- `T₂ = -B` inside `ZMod m`. -/
def T2 (m : ℕ) (B : Finset ℕ) : Finset (ZMod m) := B.image (fun b : ℕ => -(b : ZMod m))

/-- `T₃ = (B - α) \ {0}` inside `ZMod m`. -/
def T3 (m : ℕ) (B : Finset ℕ) (α : ℕ) : Finset (ZMod m) :=
  (B.image (fun b : ℕ => (b : ZMod m) - (α : ZMod m))).erase 0

/-- `T₄ = (β - B) \ {0}` inside `ZMod m`. -/
def T4 (m : ℕ) (B : Finset ℕ) (β : ℕ) : Finset (ZMod m) :=
  (B.image (fun b : ℕ => (β : ZMod m) - (b : ZMod m))).erase 0

/-
The cast `ℕ → ZMod m` is injective on `B` when `B ⊆ {1,…,m-1}`.
-/
theorem cast_injOn {m : ℕ} {B : Finset ℕ} (hB : FoldedOK m B) :
    Set.InjOn (fun b : ℕ => (b : ZMod m)) (B : Set ℕ) := by
  intro x hx y hy hxy
  have hx1 := hB.1 x hx
  have hy1 := hB.1 y hy
  have h := (ZMod.natCast_eq_natCast_iff' x y m).1 hxy
  rwa [Nat.mod_eq_of_lt (show x < m by omega), Nat.mod_eq_of_lt (show y < m by omega)] at h

theorem card_T1 {m : ℕ} {B : Finset ℕ} (hB : FoldedOK m B) : (T1 m B).card = B.card := by
  exact Finset.card_image_of_injOn (cast_injOn hB)

theorem card_T2 {m : ℕ} {B : Finset ℕ} (hB : FoldedOK m B) : (T2 m B).card = B.card := by
  apply Finset.card_image_of_injOn
  intro x hx y hy hxy
  have h : -(x : ZMod m) = -(y : ZMod m) := hxy
  exact cast_injOn hB hx hy (neg_inj.mp h)

theorem card_T3 {m : ℕ} {B : Finset ℕ} (hB : FoldedOK m B) {α : ℕ} (hα : α ∈ B) :
    (T3 m B α).card = B.card - 1 := by
  have hinj : Set.InjOn (fun b : ℕ => (b : ZMod m) - (α : ZMod m)) (B : Set ℕ) := by
    intro x hx y hy hxy
    have h : (x : ZMod m) - α = (y : ZMod m) - α := hxy
    exact cast_injOn hB hx hy (sub_left_inj.mp h)
  have hmem : (0 : ZMod m) ∈ B.image (fun b : ℕ => (b : ZMod m) - (α : ZMod m)) :=
    Finset.mem_image.mpr ⟨α, hα, sub_self _⟩
  rw [T3, Finset.card_erase_of_mem hmem, Finset.card_image_of_injOn hinj]

theorem card_T4 {m : ℕ} {B : Finset ℕ} (hB : FoldedOK m B) {β : ℕ} (hβ : β ∈ B) :
    (T4 m B β).card = B.card - 1 := by
  have hinj : Set.InjOn (fun b : ℕ => (β : ZMod m) - (b : ZMod m)) (B : Set ℕ) := by
    intro x hx y hy hxy
    have h : (β : ZMod m) - x = (β : ZMod m) - y := hxy
    exact cast_injOn hB hx hy (sub_right_inj.mp h)
  have hmem : (0 : ZMod m) ∈ B.image (fun b : ℕ => (β : ZMod m) - (b : ZMod m)) :=
    Finset.mem_image.mpr ⟨β, hβ, sub_self _⟩
  rw [T4, Finset.card_erase_of_mem hmem, Finset.card_image_of_injOn hinj]

/-
None of the four sets contain `0`, so their union misses `0`.
-/
theorem union_card_le {m : ℕ} (hm : 2 ≤ m) {B : Finset ℕ} (hB : FoldedOK m B) (α β : ℕ) :
    haveI : NeZero m := ⟨by omega⟩
    (T1 m B ∪ T2 m B ∪ T3 m B α ∪ T4 m B β).card ≤ m - 1 := by
  haveI : NeZero m := ⟨by omega⟩
  have hsub : T1 m B ∪ T2 m B ∪ T3 m B α ∪ T4 m B β ⊆
      (Finset.univ : Finset (ZMod m)).erase 0 := by
    intro x hx
    rw [Finset.mem_erase]
    refine ⟨?_, Finset.mem_univ _⟩
    simp only [Finset.mem_union] at hx
    rcases hx with ((hx | hx) | hx) | hx
    · unfold T1 at hx
      obtain ⟨b, hb, hbx⟩ := Finset.mem_image.mp hx
      have e : (b : ZMod m) = x := hbx
      intro h0
      rw [h0] at e
      have hb1 := hB.1 b hb
      have hd := (ZMod.natCast_eq_zero_iff b m).1 e
      have := Nat.le_of_dvd (by omega) hd
      omega
    · unfold T2 at hx
      obtain ⟨b, hb, hbx⟩ := Finset.mem_image.mp hx
      have e : -(b : ZMod m) = x := hbx
      intro h0
      rw [h0] at e
      have hb1 := hB.1 b hb
      have hd := (ZMod.natCast_eq_zero_iff b m).1 (neg_eq_zero.mp e)
      have := Nat.le_of_dvd (by omega) hd
      omega
    · unfold T3 at hx
      exact Finset.ne_of_mem_erase hx
    · unfold T4 at hx
      exact Finset.ne_of_mem_erase hx
  calc (T1 m B ∪ T2 m B ∪ T3 m B α ∪ T4 m B β).card
      ≤ ((Finset.univ : Finset (ZMod m)).erase 0).card := Finset.card_le_card hsub
    _ = m - 1 := by
      rw [Finset.card_erase_of_mem (Finset.mem_univ _), Finset.card_univ, ZMod.card]

/-! ### The pairwise intersection bounds -/

theorem mem_T1_T2 {m : ℕ} {B : Finset ℕ} (hB : FoldedOK m B) :
    ∀ z ∈ T1 m B ∩ T2 m B, ∃ b ∈ B, z = (b : ZMod m) ∧ 2 * b = m := by
  intro z hz
  rw [Finset.mem_inter] at hz
  obtain ⟨b, hb, hbz⟩ := Finset.mem_image.mp hz.1
  obtain ⟨b', hb', hb'z⟩ := Finset.mem_image.mp hz.2
  have e1 : (b : ZMod m) = z := hbz
  have e2 : -(b' : ZMod m) = z := hb'z
  have hb1 := hB.1 b hb
  have hb'1 := hB.1 b' hb'
  have h0 : ((b + b' : ℕ) : ZMod m) = ((0 : ℕ) : ZMod m) := by
    push_cast
    linear_combination e1 - e2
  rcases eq_of_cast_eq h0 (by omega) (by omega) with h | h
  · omega
  · have hbb : b = b' := by
      by_contra hne
      exact (hB.2 b hb b' hb' hne).1 (by omega)
    exact ⟨b, hb, e1.symm, by omega⟩

theorem inter_T1_T2_le {m : ℕ} {B : Finset ℕ} (hB : FoldedOK m B) :
    (T1 m B ∩ T2 m B).card ≤ 1 := by
  rw [Finset.card_le_one]
  intro x hx y hy
  obtain ⟨b1, -, rfl, h1⟩ := mem_T1_T2 hB x hx
  obtain ⟨b2, -, rfl, h2⟩ := mem_T1_T2 hB y hy
  have : b1 = b2 := by omega
  rw [this]

theorem inter_T1_T2_odd {m : ℕ} (hodd : ¬ 2 ∣ m) {B : Finset ℕ} (hB : FoldedOK m B) :
    T1 m B ∩ T2 m B = ∅ := by
  by_contra hne
  obtain ⟨z, hz⟩ := Finset.nonempty_iff_ne_empty.mpr hne
  obtain ⟨b, -, -, h⟩ := mem_T1_T2 hB z hz
  exact hodd ⟨b, by omega⟩

theorem inter_T1_T3_le {m : ℕ} {B : Finset ℕ} (hB : FoldedOK m B) {α : ℕ} (hα : α ∈ B) :
    (T1 m B ∩ T3 m B α).card ≤ 1 := by
  have key : ∀ z ∈ T1 m B ∩ T3 m B α, z = (α : ZMod m) := by
    intro z hz
    rw [Finset.mem_inter] at hz
    obtain ⟨b, hb, hbz⟩ := Finset.mem_image.mp hz.1
    obtain ⟨c, hc, hcz⟩ := Finset.mem_image.mp (Finset.mem_of_mem_erase hz.2)
    have e1 : (b : ZMod m) = z := hbz
    have e2 : (c : ZMod m) - α = z := hcz
    by_cases hbα : b = α
    · rw [← e1, hbα]
    · exfalso
      have h := (hB.2 b hb α hα hbα).2
      have hcast : ((b + α : ℕ) : ZMod m) = ((c : ℕ) : ZMod m) := by
        push_cast
        linear_combination e1 - e2
      rw [ZMod.natCast_eq_natCast_iff', Nat.mod_eq_of_lt (hB.1 c hc).2] at hcast
      exact h (by rw [hcast]; exact hc)
  rw [Finset.card_le_one]
  intro x hx y hy
  rw [key x hx, key y hy]

theorem inter_T2_T3_le {m : ℕ} {B : Finset ℕ} (hB : FoldedOK m B) {α : ℕ} (hα : α ∈ B)
    (hmin : ∀ x ∈ B, α ≤ x) : (T2 m B ∩ T3 m B α).card ≤ 1 := by
  have key : ∀ z ∈ T2 m B ∩ T3 m B α, ∃ u ∈ B, z = -(u : ZMod m) ∧ 2 * u = α + m := by
    intro z hz
    rw [Finset.mem_inter] at hz
    obtain ⟨u, hu, huz⟩ := Finset.mem_image.mp hz.1
    obtain ⟨b, hb, hbz⟩ := Finset.mem_image.mp (Finset.mem_of_mem_erase hz.2)
    have e1 : -(u : ZMod m) = z := huz
    have e2 : (b : ZMod m) - α = z := hbz
    have hu1 := hB.1 u hu
    have hb1 := hB.1 b hb
    have hα1 := hB.1 α hα
    have hcast : ((u + b : ℕ) : ZMod m) = ((α : ℕ) : ZMod m) := by
      push_cast
      linear_combination e2 - e1
    have hmu := hmin u hu
    have hmb := hmin b hb
    rcases eq_of_cast_eq hcast (by omega) hα1.2 with h | h
    · omega
    · have hub : u = b := by
        by_contra hne
        apply (hB.2 u hu b hb hne).2
        rw [h, Nat.add_mod_right, Nat.mod_eq_of_lt hα1.2]
        exact hα
      exact ⟨u, hu, e1.symm, by omega⟩
  rw [Finset.card_le_one]
  intro x hx y hy
  obtain ⟨u1, -, rfl, h1⟩ := key x hx
  obtain ⟨u2, -, rfl, h2⟩ := key y hy
  have : u1 = u2 := by omega
  rw [this]

theorem inter_T2_T4_le {m : ℕ} {B : Finset ℕ} (hB : FoldedOK m B) {β : ℕ} (hβ : β ∈ B) :
    (T2 m B ∩ T4 m B β).card ≤ 1 := by
  have key : ∀ z ∈ T2 m B ∩ T4 m B β, z = -(β : ZMod m) := by
    intro z hz
    rw [Finset.mem_inter] at hz
    obtain ⟨u, hu, huz⟩ := Finset.mem_image.mp hz.1
    obtain ⟨b, hb, hbz⟩ := Finset.mem_image.mp (Finset.mem_of_mem_erase hz.2)
    have e1 : -(u : ZMod m) = z := huz
    have e2 : (β : ZMod m) - b = z := hbz
    by_cases huβ : u = β
    · rw [← e1, huβ]
    · exfalso
      have h := (hB.2 β hβ u hu (Ne.symm huβ)).2
      have hcast : ((β + u : ℕ) : ZMod m) = ((b : ℕ) : ZMod m) := by
        push_cast
        linear_combination e2 - e1
      rw [ZMod.natCast_eq_natCast_iff', Nat.mod_eq_of_lt (hB.1 b hb).2] at hcast
      exact h (by rw [hcast]; exact hb)
  rw [Finset.card_le_one]
  intro x hx y hy
  rw [key x hx, key y hy]

theorem inter_T1_T4_le {m : ℕ} (hm : 2 ≤ m) {B : Finset ℕ} (hB : FoldedOK m B) {β : ℕ}
    (hβ : β ∈ B) : (T1 m B ∩ T4 m B β).card ≤ 2 := by
  haveI : NeZero m := ⟨by omega⟩
  refine le_trans (Finset.card_le_card ?_) (card_two_sol m (β : ZMod m))
  intro z hz
  rw [Finset.mem_inter] at hz
  obtain ⟨a, ha, haz⟩ := Finset.mem_image.mp hz.1
  obtain ⟨b, hb, hbz⟩ := Finset.mem_image.mp (Finset.mem_of_mem_erase hz.2)
  have e1 : (a : ZMod m) = z := haz
  have e2 : (β : ZMod m) - b = z := hbz
  rw [Finset.mem_filter]
  refine ⟨Finset.mem_univ _, ?_⟩
  by_cases hab : a = b
  · subst hab
    linear_combination -e1 - e2
  · exfalso
    have h := (hB.2 a ha b hb hab).2
    have hcast : ((a + b : ℕ) : ZMod m) = ((β : ℕ) : ZMod m) := by
      push_cast
      linear_combination e1 - e2
    rw [ZMod.natCast_eq_natCast_iff', Nat.mod_eq_of_lt (hB.1 β hβ).2] at hcast
    exact h (by rw [hcast]; exact hβ)

theorem inter_T3_T4_le {m : ℕ} {B : Finset ℕ} (hB : FoldedOK m B) {α β : ℕ}
    (hα : α ∈ B) (hβ : β ∈ B) (hαβ : α < β) (hmin : ∀ x ∈ B, α ≤ x)
    (hmin2 : ∀ x ∈ B, x ≠ α → β ≤ x) (hsum : α + β < m)
    (hnc : α + β ∉ collisions m B) : (T3 m B α ∩ T4 m B β).card ≤ 2 := by
  have key : ∀ z ∈ T3 m B α ∩ T4 m B β,
      z = (β : ZMod m) - α ∨ z = (((α + β + m) / 2 : ℕ) : ZMod m) - α := by
    intro z hz
    rw [Finset.mem_inter] at hz
    have hz0 : z ≠ 0 := Finset.ne_of_mem_erase hz.1
    obtain ⟨b, hb, hbz⟩ := Finset.mem_image.mp (Finset.mem_of_mem_erase hz.1)
    obtain ⟨b', hb', hb'z⟩ := Finset.mem_image.mp (Finset.mem_of_mem_erase hz.2)
    have e1 : (b : ZMod m) - α = z := hbz
    have e2 : (β : ZMod m) - b' = z := hb'z
    have hb1 := hB.1 b hb
    have hb'1 := hB.1 b' hb'
    have hbα : b ≠ α := by
      rintro rfl
      exact hz0 (by rw [← e1, sub_self])
    have hcast : ((b + b' : ℕ) : ZMod m) = ((α + β : ℕ) : ZMod m) := by
      push_cast
      linear_combination e1 - e2
    have hbβ := hmin2 b hb hbα
    have hb'α := hmin b' hb'
    rcases eq_of_cast_eq hcast (by omega) hsum with h | h
    · left
      have hb_eq : b = β := by omega
      rw [← e1, hb_eq]
    · right
      have hbb : b = b' := by
        by_contra hne
        apply hnc
        show α + β ∈ lowSums m B ∩ highSums m B
        unfold lowSums highSums
        refine Finset.mem_inter.mpr ⟨?_, ?_⟩
        · exact Finset.mem_image.mpr ⟨(α, β), Finset.mem_filter.mpr
            ⟨Finset.mem_product.mpr ⟨hα, hβ⟩, show α ≠ β by omega, hsum⟩, rfl⟩
        · exact Finset.mem_image.mpr ⟨(b, b'), Finset.mem_filter.mpr
            ⟨Finset.mem_product.mpr ⟨hb, hb'⟩, hne, show m < b + b' by omega⟩,
            show b + b' - m = α + β by omega⟩
      have hb_eq : b = (α + β + m) / 2 := by omega
      rw [← e1, hb_eq]
  refine le_trans (Finset.card_le_card (t := {(β : ZMod m) - α,
    (((α + β + m) / 2 : ℕ) : ZMod m) - α}) ?_) Finset.card_le_two
  intro z hz
  rw [Finset.mem_insert, Finset.mem_singleton]
  exact key z hz

/-! ### The Case 2 bound -/

/-
The four-set union bound of Case 2 of the folded additive lemma.
-/
theorem case2_bound {m : ℕ} (hm : 2 ≤ m) {B : Finset ℕ} (hB : FoldedOK m B) {α β : ℕ}
    (hα : α ∈ B) (hβ : β ∈ B) (hαβ : α < β) (hmin : ∀ x ∈ B, α ≤ x)
    (hmin2 : ∀ x ∈ B, x ≠ α → β ≤ x) (hsum : α + β < m)
    (hnc : α + β ∉ collisions m B) : 4 * B.card ≤ m + 8 := by
  by_cases h_even : 2 ∣ m;
  · have := ( four_card_le ( T1 m B ) ( T2 m B ) ( T3 m B α ) ( T4 m B β ) );
    rw [ card_T1 hB, card_T2 hB, card_T3 hB hα, card_T4 hB hβ ] at this;
    have := union_card_le hm hB α β;
    have := inter_T1_T2_le hB; ( have := inter_T1_T3_le hB hα; ( have := inter_T1_T4_le hm hB hβ; ( have := inter_T2_T3_le hB hα hmin; ( have := inter_T2_T4_le hB hβ; ( have := inter_T3_T4_le hB hα hβ hαβ hmin hmin2 hsum hnc; omega; ) ) ) ) );
  · have h_union_card : (T1 m B ∪ T2 m B ∪ T3 m B α ∪ T4 m B β).card ≤ m - 1 := by
      convert union_card_le hm hB α β using 1;
    have h_four_card_le : (T1 m B).card + (T2 m B).card + (T3 m B α).card + (T4 m B β).card ≤ (T1 m B ∪ T2 m B ∪ T3 m B α ∪ T4 m B β).card + ((T1 m B ∩ T2 m B).card + (T1 m B ∩ T3 m B α).card + (T1 m B ∩ T4 m B β).card + (T2 m B ∩ T3 m B α).card + (T2 m B ∩ T4 m B β).card + (T3 m B α ∩ T4 m B β).card) := by
      convert four_card_le ( T1 m B ) ( T2 m B ) ( T3 m B α ) ( T4 m B β ) using 1;
    have := inter_T1_T3_le hB hα; have := inter_T2_T3_le hB hα hmin; have := inter_T2_T4_le hB hβ; have := inter_T1_T4_le hm hB hβ; have := inter_T3_T4_le hB hα hβ hαβ hmin hmin2 hsum hnc; simp_all +decide [ card_T1, card_T2, card_T3, card_T4 ] ;
    have := inter_T1_T2_odd ( show ¬2 ∣ m from by omega ) hB; simp_all +decide [ Finset.ext_iff ] ; omega;

end Erdos865Port

