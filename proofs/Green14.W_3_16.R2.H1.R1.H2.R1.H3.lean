private def checkRow (x : Nat) : Bool :=
  (List.range 117).all fun y =>
    let m := cell (rowVal x) y
    (m &&& geom x y) == m

private def checkInit : Bool :=
  (List.range 117).all fun x =>
    let m := cell initTable x
    (m &&& geom x x) == m

set_option maxRecDepth 200000 in
set_option maxHeartbeats 0 in
private theorem allRowsOk : (List.range 117).all checkRow = true := by
  decide +kernel

set_option maxRecDepth 200000 in
set_option maxHeartbeats 0 in
private theorem initOk : checkInit = true := by
  decide +kernel

private theorem row_compat {c : Nat → Bool}
    (hs : ∀ x < 233, c (232 - x) = c x)
    (hap : ∀ (b : Bool) (a d : Nat), 0 < d → a + ((if b then 16 else 3) - 1) * d < 233 →
      ∃ t < (if b then 16 else 3), c (a + t * d) = b)
    {x : Nat} (hcx : c x = true) : Compat c (rowVal x) := by
  intro y hcy
  by_cases h1 : x < 117
  · by_cases h2 : y < 117
    · have hr := List.all_eq_true.mp allRowsOk x (List.mem_range.mpr h1)
      have hm := List.all_eq_true.mp hr y (List.mem_range.mpr h2)
      exact blueSub (beq_iff_eq.mp hm) (geom_ok hs hap hcx hcy)
    · simp [cell, h2, blueZero]
  · have hzero : rowVal x = 0 := by
      unfold rowVal
      split <;> omega
    simp [hzero, cell, blueZero]

private theorem init_compat {c : Nat → Bool}
    (hs : ∀ x < 233, c (232 - x) = c x)
    (hap : ∀ (b : Bool) (a d : Nat), 0 < d → a + ((if b then 16 else 3) - 1) * d < 233 →
      ∃ t < (if b then 16 else 3), c (a + t * d) = b) :
    Compat c initTable := by
  intro x hcx
  by_cases h1 : x < 117
  · have hm := List.all_eq_true.mp initOk x (List.mem_range.mpr h1)
    exact blueSub (beq_iff_eq.mp hm) (geom_ok hs hap hcx hcx)
  · simp [cell, h1, blueZero]

private def apEntry (i : Nat) : Nat :=
  (apChunk (i / 16) >>> (132 * (i % 16))) &&& ((1 <<< 132) - 1)

private def apMask (i : Nat) : Nat :=
  apEntry i >>> 12

private def apValid (i : Nat) : Bool :=
  let e := apEntry i
  let a := e % 256
  let d := (e >>> 8) % 16
  let m := e >>> 12
  decide (0 < d ∧ a + 15 * d < 233) &&
    (List.range 16).all (fun t => m.testBit (foldPos (a + t * d)))

set_option maxRecDepth 200000 in
set_option maxHeartbeats 0 in
private theorem allAPValid : (List.range numAPs).all apValid = true := by
  decide +kernel

private theorem apMask_hit {c : Nat → Bool}
    (hs : ∀ x < 233, c (232 - x) = c x)
    (hap : ∀ (b : Bool) (a d : Nat), 0 < d → a + ((if b then 16 else 3) - 1) * d < 233 →
      ∃ t < (if b then 16 else 3), c (a + t * d) = b)
    (i : Nat) (hi : i < numAPs) : Hit c (apMask i) := by
  have hv := List.all_eq_true.mp allAPValid i (List.mem_range.mpr hi)
  simp only [apValid, Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true, List.mem_range] at hv
  obtain ⟨⟨hd, hlt⟩, hbits⟩ := hv
  let e := apEntry i
  let a := e % 256
  let d := (e >>> 8) % 16
  obtain ⟨t, ht, hct⟩ := hap true a d hd hlt
  change t < 16 at ht
  have hat : a + t * d < 233 := by
    have : t * d ≤ 15 * d := Nat.mul_le_mul_right d (by omega)
    omega
  exact ⟨foldPos (a + t * d), hbits t ht, by rwa [reflectAt hs hat]⟩

private def trCode (p : Nat) : Nat :=
  (trChunk (p / 100) >>> (10 * (p % 100))) % 1024

private def maskAt (p : Nat) : Nat :=
  apMask (trCode p % numAPs)

private theorem maskAt_hit {c : Nat → Bool}
    (hs : ∀ x < 233, c (232 - x) = c x)
    (hap : ∀ (b : Bool) (a d : Nat), 0 < d → a + ((if b then 16 else 3) - 1) * d < 233 →
      ∃ t < (if b then 16 else 3), c (a + t * d) = b)
    (p : Nat) : Hit c (maskAt p) :=
  apMask_hit hs hap _ (Nat.mod_lt _ (by decide))

private def branches (child : Nat → Nat → Nat → Nat)
    (v : Nat) : Nat → Nat → Nat → Nat → Nat
  | 0, m, _, p => if m == 0 then p else 0
  | k + 1, m, b, p =>
    if m == 0 then p else
      let x := (Nat.xor m (m - 1)).log2
      let q := child (Nat.lor v (rowVal x)) (Nat.lor b (cell v x)) p
      if q == 0 then 0 else
        branches child v k (without m (1 <<< x)) (Nat.lor b (1 <<< x)) q

private theorem branches_ok {c : Nat → Bool}
    (hs : ∀ x < 233, c (232 - x) = c x)
    (hap : ∀ (b : Bool) (a d : Nat), 0 < d → a + ((if b then 16 else 3) - 1) * d < 233 →
      ∃ t < (if b then 16 else 3), c (a + t * d) = b)
    {child : Nat → Nat → Nat → Nat}
    (hc : ∀ v b p, Compat c v → Blue c b → child v b p = 0)
    {v : Nat} (hv : Compat c v)
    (k m b p : Nat) (hb : Blue c b) (hw : Hit c m) :
    branches child v k m b p = 0 := by
  induction k generalizing m b p with
  | zero =>
    have hm : m ≠ 0 := by rintro rfl; simp [Hit] at hw
    simp [branches, hm]
  | succ k ih =>
    have hm : m ≠ 0 := by rintro rfl; simp [Hit] at hw
    rw [branches, if_neg (by simpa using hm)]
    dsimp only
    cases hx : c (Nat.xor m (m - 1)).log2 with
    | false =>
      split
      · rfl
      · exact ih _ _ _ (blueOr hb (blueSingle hx)) (hit_without hw (blueSingle hx))
    | true =>
      let x := (Nat.xor m (m - 1)).log2
      have hchild := hc (Nat.lor v (rowVal x)) (Nat.lor b (cell v x)) p
        (compatOr hv (row_compat hs hap hx)) (blueOr hb (hv x hx))
      split
      · rfl
      · rename_i h
        exact (h (beq_iff_eq.mpr hchild)).elim

private def walk : Nat → Nat → Nat → Nat → Nat
  | 0, _, _, _ => 0
  | fuel + 1, v, b, p =>
    branches (walk fuel) v 16 (without (maskAt p) b) b (p + 1)

private theorem walk_ok {c : Nat → Bool}
    (hs : ∀ x < 233, c (232 - x) = c x)
    (hap : ∀ (b : Bool) (a d : Nat), 0 < d → a + ((if b then 16 else 3) - 1) * d < 233 →
      ∃ t < (if b then 16 else 3), c (a + t * d) = b)
    (fuel v b p : Nat) (hv : Compat c v) (hb : Blue c b) :
