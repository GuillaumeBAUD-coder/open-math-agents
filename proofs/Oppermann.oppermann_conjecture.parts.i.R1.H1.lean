private def checkList (x : ℕ) : List ℕ → Bool
  | [] => true
  | p :: ps => decide (x * (x - 1) < p ∧ p < x * x) && isPrimeBool p && checkList (x + 1) ps

private lemma checkList_sound : ∀ (l : List ℕ) (x : ℕ), checkList x l = true →
    ∀ i : ℕ, i < l.length →
      let p := l.getD i 0
      (x + i) * (x + i - 1) < p ∧ p < (x + i) ^ 2 ∧ p.Prime := by
  intro l
  induction l with
  | nil => intro _ _ i hi; simp at hi
  | cons p ps ih =>
    intro x hok i hi
    unfold checkList at hok
    rw [Bool.and_eq_true, Bool.and_eq_true, decide_eq_true_eq] at hok
    cases i with
    | zero =>
      simp only [List.getD_cons_zero, add_zero]
      exact ⟨hok.1.1.1, by rw [sq]; exact hok.1.1.2, isPrimeBool_sound hok.1.2⟩
    | succ j =>
      simp only [List.getD_cons_succ, List.length_cons] at hi ⊢
      have hres := ih (x + 1) hok.2 j (by omega)
      have heq : x + 1 + j = x + (j + 1) := by omega
      rwa [heq] at hres

private lemma witnesses_len : witnesses.length = 999 := by decide +kernel
private lemma witnesses_ok : checkList 2 witnesses = true := by decide +kernel

end OppermannPartsIR1H1Proof

theorem OMA.solution : OMA.R_Oppermann_oppermann_conjecture_parts_i_R1.H1 := by
  intro x h1 h2
  have hlt : x - 2 < OppermannPartsIR1H1Proof.witnesses.length := by
    rw [OppermannPartsIR1H1Proof.witnesses_len]; omega
  have h := OppermannPartsIR1H1Proof.checkList_sound OppermannPartsIR1H1Proof.witnesses 2
    OppermannPartsIR1H1Proof.witnesses_ok (x - 2) hlt
  have hne : 2 + (x - 2) = x := by omega
  rw [hne] at h
  exact ⟨OppermannPartsIR1H1Proof.witnesses.getD (x - 2) 0, Finset.mem_Ioo.mpr ⟨h.1, h.2.1⟩, h.2.2⟩
