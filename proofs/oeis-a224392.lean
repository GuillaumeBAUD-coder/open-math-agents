theorem mem2_nodup : ∀ b < 4 ^ 3, ∀ c < 56, (mem2 b c).Nodup := by decide +kernel

theorem mem2_sound : ∀ b < 4 ^ 3, ∀ c < 56, ∀ x ∈ mem2 b c, x < 4 ^ 3 ∧ cls2 (dec b) (dec x) = c := by
  decide +kernel

theorem mem2_complete : ∀ b < 4 ^ 3, ∀ x < 4 ^ 3, x ∈ mem2 b (cls2 (dec b) (dec x)) := by decide +kernel

theorem card_cls2 (t : R) (c : ℕ) (hc : c < 56) (P : R → Prop) [DecidablePred P] :
    (Finset.univ.filter (fun u : R => cls2 t u = c ∧ P u)).card =
      ((mem2 (E t : ℕ) c).filter (fun x => P (dec x))).length := by
  have hb := (E t).isLt
  have hn := List.toFinset_card_of_nodup
    ((mem2_nodup (E t : ℕ) hb c hc).filter (fun x => decide (P (dec x))))
  rw [← hn]
  apply Finset.card_bij (fun u _ => ((E u : Fin (4 ^ 3)) : ℕ))
  · intro u hu
    rw [Finset.mem_filter] at hu
    rw [List.mem_toFinset, List.mem_filter]
    refine ⟨?_, ?_⟩
    · have h := mem2_complete (E t : ℕ) hb (E u : ℕ) (E u).isLt
      rw [dec_E, dec_E, hu.2.1] at h
      exact h
    · rw [dec_E]
      exact decide_eq_true hu.2.2
  · intro u1 _ u2 _ h
    exact E.injective (Fin.ext h)
  · intro x hx
    rw [List.mem_toFinset, List.mem_filter] at hx
    obtain ⟨hx1, hx2⟩ := hx
    have hs := mem2_sound (E t : ℕ) hb c hc x hx1
    rw [dec_E] at hs
    obtain ⟨hs1, hs2⟩ := hs
    have e : E.symm ⟨x, hs1⟩ = dec x := E_symm ⟨x, hs1⟩
    have he : E (dec x) = ⟨x, hs1⟩ := (congrArg E e).symm.trans (Equiv.apply_symm_apply E ⟨x, hs1⟩)
    refine ⟨dec x, ?_, congrArg Fin.val he⟩
    rw [Finset.mem_filter]
    exact ⟨Finset.mem_univ _, hs2, of_decide_eq_true hx2⟩

