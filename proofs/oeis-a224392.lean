        (if Walk2 y ∧ y 0 = s ∧ y 1 = t then 1 else 0) else 0) =
        ∑ y : Fin (n + 2) → R, if y 0 = s ∧ y 1 = t then (if Walk2 y ∧ ini (y 0) then 1 else 0)
