private theorem dep_stride_dvd {g j : ℕ} (hg : g < 472) (hj : j < 13)
    (hb : (dep g).testBit j = true) : small j ∣ stride g := by
  have hm := List.all_eq_true.mp masks_ok g (List.mem_range.mpr hg)
