private theorem prime_data {q : ℕ} (hq : q.Prime) (ho : Odd q) (hn : q ≤ 2^17) :
    tag q < 472 ∧ stride (tag q) ∣ q-1 ∧ (tag q < 13 → small (tag q) = q) ∧
      offset q < count (tag q) ∧ primeByGroup (first (tag q) + offset q) = q := by
  obtain ⟨u, hu⟩ := ho
  have htwo := hq.two_le
  have hqform : 2*((q-3)/2)+3 = q := by omega
  have h := number_valid ((q-3)/2) (by norm_num at hn; omega)
  rw [hqform] at h
  by_cases ht : tag q < 472
  · simp only [checkNumber, if_pos ht, decide_eq_true_eq] at h
    exact ⟨ht,h⟩
  · simp only [checkNumber, if_neg ht, decide_eq_true_eq] at h
    exact ((Nat.prime_def_lt'.mp hq).2 (tag q - 500) h.1 h.2.1
      (Nat.dvd_of_mod_eq_zero h.2.2)).elim

