private theorem fiber_bound {S : Finset ℕ}
    (hs : ∀ q ∈ S, q.Prime ∧ Odd q ∧ q ≤ 2^17) {g : ℕ} (hg : g < 472) :
    ∑ q ∈ S.filter (fun q => tag q = g), wt q ≤ upper g := by
  let F := S.filter fun q => tag q = g
  have data : ∀ q ∈ F, offset q < count g ∧ primeByGroup (first g + offset q) = q := by
    intro q hq
    obtain ⟨hqS, htag⟩ := Finset.mem_filter.mp hq
    obtain ⟨hp, ho, hn⟩ := hs q hqS
    have h := (prime_data hp ho hn).2.2.2
    simpa only [htag] using h
  have inj : Set.InjOn offset (F : Set ℕ) := by
    intro q hq r hr hqr
    calc
      q = primeByGroup (first g + offset q) := (data q hq).2.symm
      _ = primeByGroup (first g + offset r) := by rw [hqr]
      _ = r := (data r hr).2
  have mem : F.image offset ⊆ Finset.range (count g) := by
    intro i hi
    obtain ⟨q,hq,rfl⟩ := Finset.mem_image.mp hi
    exact Finset.mem_range.mpr (data q hq).1
  rw [← group_eq hg]
  change (∑ q ∈ F, wt q) ≤ ∑ i ∈ Finset.range (count g), wt (primeByGroup (first g + i))
  calc
    (∑ q ∈ F, wt q) = ∑ q ∈ F, wt (primeByGroup (first g + offset q)) :=
      Finset.sum_congr rfl fun q hq => congrArg wt (data q hq).2.symm
    _ = ∑ i ∈ F.image offset, wt (primeByGroup (first g + i)) := (Finset.sum_image inj).symm
    _ ≤ _ := Finset.sum_le_sum_of_subset mem

private def value (A : Finset ℕ) : ℕ := ∑ g ∈ A, upper g

private def search : List ℕ → Finset ℕ → Bool
  | [], A => decide (value A ≤ 111000000)
  | j :: t, A =>
    if value A ≤ 111000000 then true else
      if j ∈ A then search t (A.erase j) && search t (A.filter (fun g => !(dep g).testBit j))
      else search t A

private theorem search_sound {S : Finset ℕ}
    (hs : ∀ q ∈ S, q.Prime ∧ Odd q ∧ q ≤ 2^17)
    (hc : ∀ p ∈ S, ∀ q ∈ S, ¬p ∣ q-1)
    (l : List ℕ) (hl : ∀ j ∈ l, j < 13) (A : Finset ℕ) (hA : ∀ g ∈ A, g < 472)
    (belongs : ∀ q ∈ S, tag q ∈ A) (ok : search l A = true) :
    ∑ q ∈ S, wt q ≤ 111000000 := by
  have mono : ∀ (T : Finset ℕ), (∀ g ∈ T, g < 472) → (∀ q ∈ S, tag q ∈ T) →
      (∑ q ∈ S, wt q) ≤ value T := by
    intro T hT hmap
    rw [← Finset.sum_fiberwise_of_maps_to hmap wt]
    exact Finset.sum_le_sum fun g hg => fiber_bound hs (hT g hg)
  induction l generalizing A with
  | nil => exact (mono A hA belongs).trans (of_decide_eq_true ok)
  | cons j t ih =>
    have hj := hl j (List.mem_cons_self ..)
    have ht : ∀ i ∈ t, i < 13 := fun i hi => hl i (List.mem_cons_of_mem _ hi)
    by_cases cheap : value A ≤ 111000000
    · exact (mono A hA belongs).trans cheap
    · by_cases hmem : j ∈ A
      · have hours : search t (A.erase j) = true ∧
            search t (A.filter (fun g => !(dep g).testBit j)) = true := by
          simpa only [search, if_neg cheap, if_pos hmem, Bool.and_eq_true] using ok
        by_cases chosen : small j ∈ S
        · apply ih ht _ (fun g hg => hA g (Finset.mem_filter.mp hg).1) _ hours.2
          intro q hq
          obtain ⟨hp, ho, hn⟩ := hs q hq
          refine Finset.mem_filter.mpr ⟨belongs q hq, ?_⟩
          cases hbit : (dep (tag q)).testBit j with
          | false => rfl
          | true => exact (hc _ chosen _ hq ((dep_stride_dvd (hA _ (belongs q hq)) hj hbit).trans (prime_data hp ho hn).2.1)).elim
        · apply ih ht _ (fun g hg => hA g (Finset.mem_of_mem_erase hg)) _ hours.1
          intro q hq
          refine Finset.mem_erase.mpr ⟨?_, belongs q hq⟩
          intro eq
          obtain ⟨hp, ho, hn⟩ := hs q hq
          have data := (prime_data hp ho hn).2.2.1 (by omega : tag q < 13)
          rw [eq] at data
          exact chosen (data.symm ▸ hq)
      · apply ih ht A hA belongs
        simpa only [search, if_neg cheap, if_neg hmem] using ok

set_option maxRecDepth 200000 in
set_option maxHeartbeats 0 in
private theorem accepted : search (List.range 13) (Finset.range 472) = true := by decide +kernel

private theorem bound {S : Finset ℕ}
    (hs : ∀ p ∈ S, p.Prime ∧ Odd p ∧ p ≤ 2^17)
    (hc : ∀ p ∈ S, ∀ q ∈ S, ¬p ∣ q-1) : (∑ q ∈ S, wt q) ≤ 111000000 := by
  apply search_sound hs hc (List.range 13) (fun _ h => List.mem_range.mp h)
    (Finset.range 472) (fun _ h => Finset.mem_range.mp h) _ accepted
  intro q hq
  obtain ⟨hp, ho, hn⟩ := hs q hq
  exact Finset.mem_range.mpr (prime_data hp ho hn).1

private theorem point {p : ℕ} (hp : 0 < p) : (p : ℝ)⁻¹ ≤ (wt p : ℝ) / 100000000 := by
  have hNat : 100000000 ≤ wt p * p := by
    have hm := Nat.mod_lt 100000000 hp
    have hid := Nat.div_add_mod 100000000 p
    unfold wt
    rw [Nat.add_mul, Nat.one_mul, Nat.mul_comm (100000000 / p) p]
    omega
  have hReal : (100000000 : ℝ) ≤ (wt p : ℝ) * (p : ℝ) := by exact_mod_cast hNat
  rw [inv_eq_one_div, div_le_div_iff₀ (by exact_mod_cast hp) (by norm_num)]
  simpa using hReal

end OMA.PrimeAntichainSeventeen

theorem OMA.solution : OMA.R_AgohGiuga_agoh_giuga_variants_giuga_R3_H2_R1_H2_R1_H1_R1.H1 := by
  intro S hs hc
  have hn := OMA.PrimeAntichainSeventeen.bound hs hc
  change (∑ p ∈ S, OMA.PrimeAntichainSeventeen.wt p) ≤ 111000000 at hn
  have hr : (∑ p ∈ S, (OMA.PrimeAntichainSeventeen.wt p : ℝ)) ≤ 111000000 := by
    exact_mod_cast hn
  calc
    ∑ p ∈ S, (p : ℝ)⁻¹ ≤ ∑ p ∈ S, (OMA.PrimeAntichainSeventeen.wt p : ℝ) / 100000000 :=
      Finset.sum_le_sum fun p hp => OMA.PrimeAntichainSeventeen.point (hs p hp).1.pos
    _ = (∑ p ∈ S, (OMA.PrimeAntichainSeventeen.wt p : ℝ)) / 100000000 := by rw [Finset.sum_div]
    _ ≤ 111 / 100 := by linarith
