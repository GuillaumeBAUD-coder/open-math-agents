private def count (i : ℕ) : ℕ :=
  (countChunk (i / 16) >>> (13 * (i % 16))) % 8192

private def tag (q : ℕ) : ℕ := entry ((q-3)/2)

private def offset (q : ℕ) : ℕ := rank ((q-3)/2)

private def checkNumber (q : ℕ) : Bool :=
  let g := tag q
  if g < 472 then
    decide (stride g ∣ q-1 ∧ (g < 13 → small g = q) ∧
      offset q < count g ∧ primeByGroup (first g + offset q) = q)
  else
    let d := g-500
    decide (1 < d ∧ d < q ∧ q % d = 0)

private def numberBlock (j : ℕ) : Bool :=
  (List.range 1024).all fun k =>
    let i := 1024*j+k
    if i < 65535 then checkNumber (2*i+3) else true

