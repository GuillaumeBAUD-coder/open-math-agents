import OMAReductions.R_oeis_a003459_R1

/-!
# Proof of `oeis-a003459.R1.H1`

Proves Slinko's digit restriction for multidigit permutable primes `p ≥ 10`:
1. Every base-10 digit of `p` lies in `{1, 3, 7, 9}` (otherwise moving an even digit or `5`
   to the units place with a nonzero leading digit gives a composite permutation).
2. At most one digit position differs from the most frequent digit (`length ≤ count a + 1`):
   - For lengths `3 ≤ L ≤ 6`, every non-near-repdigit multiset over `{1, 3, 7, 9}` has an
     explicit composite permutation.
   - For length `L ≥ 7`, any non-near-repdigit multiset contains a length-7 non-near-repdigit
     sub-multiset `s`; all 104 such multisets cover every residue modulo `7`, yielding a
     permutation of `p` divisible by `7` and strictly greater than `7`.
-/

namespace OeisA003459R1H1Proof

open OMA.S_oeis_a003459

private def ofDigits10 : List ℕ → ℕ
  | [] => 0
  | d :: ds => d + 10 * ofDigits10 ds

private lemma ofDigits10_eq (l : List ℕ) : ofDigits10 l = Nat.ofDigits 10 l := by
  induction l with
  | nil => rfl
  | cons d ds ih => simp [ofDigits10, Nat.ofDigits, ih]

private lemma ofDigits_append (s t : List ℕ) :
    Nat.ofDigits 10 (s ++ t) = Nat.ofDigits 10 s + 10 ^ s.length * Nat.ofDigits 10 t := by
  induction s with
  | nil => simp [Nat.ofDigits]
  | cons d ds ih =>
    simp only [List.cons_append, Nat.ofDigits, ih, List.length_cons, pow_succ']
    ring

