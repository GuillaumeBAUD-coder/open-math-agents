private def sameCounts (l : List ℕ) (c1 c3 c7 c9 : ℕ) : Bool :=
  l.length == c1 + c3 + c7 + c9 &&
  l.count 1 == c1 && l.count 3 == c3 && l.count 7 == c7 && l.count 9 == c9

private def checkSmallOne (c1 c3 c7 c9 : ℕ) : Bool :=
  let L := c1 + c3 + c7 + c9
  if L < 3 || 6 < L || L ≤ max (max c1 c3) (max c7 c9) + 1 then true
  else
    let wd := smallWitness c1 c3 c7 c9
    let v := ofDigits10 wd.1
    sameCounts wd.1 c1 c3 c7 c9 && (1 < wd.2) && (wd.2 < v) && (v % wd.2 == 0)

private def checkSmallAll : Bool :=
  (List.range 7).all fun c1 =>
  (List.range 7).all fun c3 =>
  (List.range 7).all fun c7 =>
  (List.range 7).all fun c9 => checkSmallOne c1 c3 c7 c9

private lemma checkSmallAll_ok : checkSmallAll = true := by decide +kernel

private def checkLen7One (c1 c3 c7 c9 : ℕ) : Bool :=
  if c1 + c3 + c7 + c9 != 7 || 5 < max (max c1 c3) (max c7 c9) then true
  else
    (List.range 7).all fun r =>
      let w := len7Witness c1 c3 c7 c9 r
      sameCounts w c1 c3 c7 c9 && (ofDigits10 w % 7 == r)

private def checkLen7All : Bool :=
  (List.range 6).all fun c1 =>
  (List.range 6).all fun c3 =>
  (List.range 6).all fun c7 =>
  (List.range 6).all fun c9 => checkLen7One c1 c3 c7 c9

private lemma checkLen7All_ok : checkLen7All = true := by decide +kernel

private lemma perm_canonical_of_sameCounts {l : List ℕ} {c1 c3 c7 c9 : ℕ}
    (h : sameCounts l c1 c3 c7 c9 = true) : l.Perm (canonical c1 c3 c7 c9) := by
  unfold sameCounts at h
  simp only [Bool.and_eq_true, beq_iff_eq] at h
  obtain ⟨⟨⟨⟨hlen, h1⟩, h3⟩, h7⟩, h9⟩ := h
  have hsub : ∀ x ∈ l, x = 1 ∨ x = 3 ∨ x = 7 ∨ x = 9 := by
    have hsum : l.count 1 + l.count 3 + l.count 7 + l.count 9 = l.length := by omega
    have hfilt : (l.filter (fun x => x == 1 || x == 3 || x == 7 || x == 9)).length = l.length := by
      have hsplit : ∀ m : List ℕ, (m.filter (fun x => x == 1 || x == 3 || x == 7 || x == 9)).length =
          m.count 1 + m.count 3 + m.count 7 + m.count 9 := by
        intro m; induction m with
        | nil => simp
        | cons a t ih =>
          simp only [List.filter_cons, List.count_cons]
          by_cases ha1 : a = 1
          · subst ha1; simp [ih]; omega
          by_cases ha3 : a = 3
          · subst ha3; simp [ih]; omega
          by_cases ha7 : a = 7
          · subst ha7; simp [ih]; omega
          by_cases ha9 : a = 9
          · subst ha9; simp [ih]; omega
          have hf : (a == 1 || a == 3 || a == 7 || a == 9) = false := by simp [ha1, ha3, ha7, ha9]
          simp [hf, ha1, ha3, ha7, ha9, ih]
      rw [hsplit l, hsum]
    intro x hx
    have hall : ∀ y ∈ l, (y == 1 || y == 3 || y == 7 || y == 9) = true := by
      have := List.filter_eq_self.mp (List.Sublist.eq_of_length (List.filter_sublist) hfilt)
      intro y hy; exact this y hy
    have hx' := hall x hx
    simp only [Bool.or_eq_true, beq_iff_eq] at hx'
    tauto
  rw [List.perm_iff_count]
  intro a
  have hrep : ∀ n b, a ≠ b → (List.replicate n b).count a = 0 := fun n b hne =>
    List.count_eq_zero.mpr fun hm => hne (List.eq_of_mem_replicate hm)
  unfold canonical
  simp only [List.count_append]
  by_cases ha1 : a = 1
  · subst ha1; rw [h1, List.count_replicate_self, hrep c3 3 (by decide), hrep c7 7 (by decide), hrep c9 9 (by decide)]; omega
  by_cases ha3 : a = 3
  · subst ha3; rw [h3, List.count_replicate_self, hrep c1 1 (by decide), hrep c7 7 (by decide), hrep c9 9 (by decide)]; omega
  by_cases ha7 : a = 7
  · subst ha7; rw [h7, List.count_replicate_self, hrep c1 1 (by decide), hrep c3 3 (by decide), hrep c9 9 (by decide)]; omega
  by_cases ha9 : a = 9
  · subst ha9; rw [h9, List.count_replicate_self, hrep c1 1 (by decide), hrep c3 3 (by decide), hrep c7 7 (by decide)]; omega
  have hnotl : a ∉ l := fun hm => by rcases hsub a hm with rfl | rfl | rfl | rfl <;> contradiction
  rw [List.count_eq_zero.mpr hnotl, hrep c1 1 ha1, hrep c3 3 ha3, hrep c7 7 ha7, hrep c9 9 ha9]

private lemma exists_perm_cons_of_mem {α : Type*} {x : α} {l : List α}
    (h : x ∈ l) : ∃ t, l.Perm (x :: t) := by
  induction l with
  | nil => cases h
  | cons a l ih =>
    rcases List.mem_cons.mp h with rfl | hmem
    · exact ⟨l, List.Perm.refl _⟩
    · obtain ⟨t, ht⟩ := ih hmem
      exact ⟨a :: t, (ht.cons a).trans (List.Perm.swap x a t)⟩

private lemma mem_admissible {p : ℕ} (hp10 : 10 ≤ p) (hperm : IsPermutablePrime p) :
    ∀ j ∈ Nat.digits 10 p, j ∈ ([1, 3, 7, 9] : List ℕ) := by
  set l := Nat.digits 10 p
  have hlen : 2 ≤ l.length := by
    have h1 := Nat.length_digits 10 p (by decide) (by omega)
    have hlog : 1 ≤ Nat.log 10 p := Nat.le_log_of_pow_le (by decide) (by omega)
    dsimp [l]; omega
  have hne : l ≠ [] := fun h => by rw [h] at hlen; simp at hlen
  have hlast_ne0 : l.getLast hne ≠ 0 := Nat.getLast_digit_ne_zero 10 (by omega)
  intro j hj
  have hjlt : j < 10 := Nat.digits_lt_base (by decide) hj
  have hjne : j ∉ ([0, 2, 4, 5, 6, 8] : List ℕ) := by
    intro hbad
    -- Build a permutation of l starting with j and having a nonzero digit in the tail
    obtain ⟨l1, hperm1⟩ : ∃ l1, l.Perm (j :: l1) := exists_perm_cons_of_mem hj
    have hl1_ne : l1 ≠ [] := by
      intro h0; subst h0; have := hperm1.length_eq; simp at this; omega
    have hex_nz : ∃ x ∈ l1, x ≠ 0 := by
      by_cases hj0 : j = 0
      · have hmem : l.getLast hne ∈ j :: l1 := hperm1.subset (List.getLast_mem hne)
        rcases List.mem_cons.mp hmem with heq | hm
        · exact absurd (heq.trans hj0) hlast_ne0
        · exact ⟨l.getLast hne, hm, hlast_ne0⟩
      · -- If all of l1 were 0, then l = [j, 0, ...] so p = j * 10^k which is div by 10
        by_contra hall0
        push Not at hall0
        have h0_mem : 0 ∈ l1 := by
          cases hl1 : l1 with
          | nil => exact absurd hl1 hl1_ne
          | cons a t => exact hall0 a (by rw [hl1]; simp) ▸ List.mem_cons_self
        -- Put 0 at head and j at index 1
        obtain ⟨l2, hl2⟩ := exists_perm_cons_of_mem h0_mem
        have hperm0 : (0 :: j :: l2).Perm l :=
          (List.Perm.swap j 0 l2).trans ((hl2.symm.cons j).trans hperm1.symm)
        have hpr0 : (Nat.ofDigits 10 (0 :: j :: l2)).Prime := hperm _ hperm0
        have hval0 : Nat.ofDigits 10 (0 :: j :: l2) = 10 * (j + 10 * Nat.ofDigits 10 l2) := by
          simp [Nat.ofDigits]
        have h2dvd : 2 ∣ Nat.ofDigits 10 (0 :: j :: l2) := by rw [hval0]; exact ⟨5 * (j + 10 * Nat.ofDigits 10 l2), by ring⟩
        have hge10 : 10 ≤ Nat.ofDigits 10 (0 :: j :: l2) := by rw [hval0]; omega
        rcases (Nat.dvd_prime hpr0).mp h2dvd with h | h <;> omega
    obtain ⟨x, hx1, hxnz⟩ := hex_nz
    obtain ⟨l2, hl2⟩ := exists_perm_cons_of_mem hx1
    have hperm_j : (j :: x :: l2).Perm l := (hl2.symm.cons j).trans hperm1.symm
    have hpr : (Nat.ofDigits 10 (j :: x :: l2)).Prime := hperm _ hperm_j
    have hval : Nat.ofDigits 10 (j :: x :: l2) = j + 10 * (x + 10 * Nat.ofDigits 10 l2) := by
      simp [Nat.ofDigits]
    have hge10 : 10 ≤ Nat.ofDigits 10 (j :: x :: l2) := by rw [hval]; omega
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hbad
    rcases hbad with rfl | rfl | rfl | rfl | rfl | rfl
    · have h2 : 2 ∣ Nat.ofDigits 10 (0 :: x :: l2) := by rw [hval]; omega
      rcases (Nat.dvd_prime hpr).mp h2 with h | h <;> omega
    · have h2 : 2 ∣ Nat.ofDigits 10 (2 :: x :: l2) := by rw [hval]; omega
      rcases (Nat.dvd_prime hpr).mp h2 with h | h <;> omega
    · have h2 : 2 ∣ Nat.ofDigits 10 (4 :: x :: l2) := by rw [hval]; omega
      rcases (Nat.dvd_prime hpr).mp h2 with h | h <;> omega
    · have h5 : 5 ∣ Nat.ofDigits 10 (5 :: x :: l2) := by rw [hval]; omega
      rcases (Nat.dvd_prime hpr).mp h5 with h | h <;> omega
    · have h2 : 2 ∣ Nat.ofDigits 10 (6 :: x :: l2) := by rw [hval]; omega
      rcases (Nat.dvd_prime hpr).mp h2 with h | h <;> omega
    · have h2 : 2 ∣ Nat.ofDigits 10 (8 :: x :: l2) := by rw [hval]; omega
      rcases (Nat.dvd_prime hpr).mp h2 with h | h <;> omega
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hjne ⊢
  omega

private lemma perm_canonical_of_admissible {l : List ℕ}
    (hadm : ∀ j ∈ l, j ∈ ([1, 3, 7, 9] : List ℕ)) :
    l.Perm (canonical (l.count 1) (l.count 3) (l.count 7) (l.count 9)) ∧
    l.length = l.count 1 + l.count 3 + l.count 7 + l.count 9 := by
  have hlen : l.length = l.count 1 + l.count 3 + l.count 7 + l.count 9 := by
    induction l with
    | nil => simp
    | cons a t ih =>
      have ha := hadm a (List.mem_cons_self)
      have ht := ih (fun j hj => hadm j (List.mem_cons_of_mem _ hj))
      simp only [List.mem_cons, List.not_mem_nil, or_false] at ha
      rcases ha with rfl | rfl | rfl | rfl <;> simp <;> omega
  refine ⟨?_, hlen⟩
  apply perm_canonical_of_sameCounts
  unfold sameCounts
  simp [hlen]

private lemma extract_len7_sublist {l : List ℕ}
    (hadm : ∀ j ∈ l, j ∈ ([1, 3, 7, 9] : List ℕ))
    (hlen7 : 7 ≤ l.length)
    (hnot : ∀ a : ℕ, l.count a + 1 < l.length) :
    ∃ s rest : List ℕ, l.Perm (s ++ rest) ∧ s.length = 7 ∧
      (∀ j ∈ s, j ∈ ([1, 3, 7, 9] : List ℕ)) ∧ (∀ a : ℕ, s.count a ≤ 5) := by
  -- Pick a ∈ {1, 3, 7, 9} with maximum count in l
  have hex_max : ∃ a : ℕ, ∀ x : ℕ, l.count x ≤ l.count a := by
    set c1 := l.count 1; set c3 := l.count 3; set c7 := l.count 7; set c9 := l.count 9
    have hzero : ∀ x, x ≠ 1 → x ≠ 3 → x ≠ 7 → x ≠ 9 → l.count x = 0 := by
      intro x h1 h3 h7 h9
      apply List.count_eq_zero.mpr
      intro hm
      have := hadm x hm
      simp only [List.mem_cons, List.not_mem_nil, or_false] at this
      tauto
    by_cases h1 : c3 ≤ c1 ∧ c7 ≤ c1 ∧ c9 ≤ c1
    · refine ⟨1, fun x => ?_⟩
      by_cases hx1 : x = 1; · subst hx1; exact le_rfl
      by_cases hx3 : x = 3; · subst hx3; exact h1.1
      by_cases hx7 : x = 7; · subst hx7; exact h1.2.1
      by_cases hx9 : x = 9; · subst hx9; exact h1.2.2
      rw [hzero x hx1 hx3 hx7 hx9]; exact Nat.zero_le _
    by_cases h3 : c1 ≤ c3 ∧ c7 ≤ c3 ∧ c9 ≤ c3
    · refine ⟨3, fun x => ?_⟩
      by_cases hx1 : x = 1; · subst hx1; exact h3.1
      by_cases hx3 : x = 3; · subst hx3; exact le_rfl
      by_cases hx7 : x = 7; · subst hx7; exact h3.2.1
      by_cases hx9 : x = 9; · subst hx9; exact h3.2.2
      rw [hzero x hx1 hx3 hx7 hx9]; exact Nat.zero_le _
    by_cases h7 : c1 ≤ c7 ∧ c3 ≤ c7 ∧ c9 ≤ c7
    · refine ⟨7, fun x => ?_⟩
      by_cases hx1 : x = 1; · subst hx1; exact h7.1
      by_cases hx3 : x = 3; · subst hx3; exact h7.2.1
      by_cases hx7 : x = 7; · subst hx7; exact le_rfl
      by_cases hx9 : x = 9; · subst hx9; exact h7.2.2
      rw [hzero x hx1 hx3 hx7 hx9]; exact Nat.zero_le _
    · refine ⟨9, fun x => ?_⟩
      by_cases hx1 : x = 1; · subst hx1; omega
      by_cases hx3 : x = 3; · subst hx3; omega
      by_cases hx7 : x = 7; · subst hx7; omega
      by_cases hx9 : x = 9; · subst hx9; exact le_rfl
      rw [hzero x hx1 hx3 hx7 hx9]; exact Nat.zero_le _
  obtain ⟨a, ha_max⟩ := hex_max
  -- Split l into l_a (copies of a) and l_o (elements ≠ a)
  let l_a := l.filter (fun x => x == a)
  let l_o := l.filter (fun x => !(x == a))
  have hperm_split : l.Perm (l_a ++ l_o) := by
    have haux : ∀ m : List ℕ, m.Perm (m.filter (fun x => x == a) ++ m.filter (fun x => !(x == a))) := by
      intro m; induction m with
      | nil => simp
      | cons y t ih =>
        by_cases hy : y = a
        · subst hy; simpa using ih.cons y
        · have hne : (y == a) = false := beq_false_of_ne hy
          simp only [List.filter_cons, hne, Bool.not_false, Bool.false_eq_true, ↓reduceIte]
          have hmid : (y :: (t.filter (fun x => x == a) ++ t.filter (fun x => !(x == a)))).Perm
              (t.filter (fun x => x == a) ++ y :: t.filter (fun x => !(x == a))) := by
            rw [List.perm_iff_count]; intro z; simp only [List.count_cons, List.count_append]; omega
          exact (ih.cons y).trans hmid
    exact haux l
  have hlen_a : l_a.length = l.count a := by
    simp [l_a, List.count_eq_length_filter]
  have hlen_o : 2 ≤ l_o.length := by
    have htot := hperm_split.length_eq
    rw [List.length_append, hlen_a] at htot
    have := hnot a
    omega
  set k := min l_a.length 5
  let s_a := l_a.take k
  let r_a := l_a.drop k
  let s_o := l_o.take (7 - k)
  let r_o := l_o.drop (7 - k)
  have hka : k ≤ l_a.length := Nat.min_le_left _ _
  have hko : 7 - k ≤ l_o.length := by
    have htot := hperm_split.length_eq
    rw [List.length_append] at htot
    omega
  refine ⟨s_a ++ s_o, r_a ++ r_o, ?_, ?_, ?_, ?_⟩
  · have h1 : l_a = s_a ++ r_a := (List.take_append_drop k l_a).symm
    have h2 : l_o = s_o ++ r_o := (List.take_append_drop (7 - k) l_o).symm
    have hmid : ((s_a ++ r_a) ++ (s_o ++ r_o)).Perm ((s_a ++ s_o) ++ (r_a ++ r_o)) := by
      rw [List.perm_iff_count]; intro y; simp only [List.count_append]; omega
    exact hperm_split.trans (by rw [h1, h2]; exact hmid)
  · rw [List.length_append, List.length_take, List.length_take, Nat.min_eq_left hka, Nat.min_eq_left hko]
    omega
  · intro j hj
    have hmem : j ∈ l := by
      apply hperm_split.symm.subset
      rw [List.mem_append] at hj ⊢
      rcases hj with h | h
      · exact Or.inl (List.mem_of_mem_take h)
      · exact Or.inr (List.mem_of_mem_take h)
    exact hadm j hmem
  · intro x
    have hsa_all : ∀ y ∈ s_a, y = a := fun y hy => by
      have := (List.mem_filter.mp (List.mem_of_mem_take hy)).2
      simpa using this
    have hso_none : ∀ y ∈ s_o, y ≠ a := fun y hy => by
      have := (List.mem_filter.mp (List.mem_of_mem_take hy)).2
      simpa using this
    by_cases hxa : x = a
    · subst hxa
      rw [List.count_append]
      have h0 : s_o.count x = 0 := List.count_eq_zero.mpr (fun hm => hso_none x hm rfl)
      have hle : s_a.count x ≤ s_a.length := List.count_le_length
      rw [h0, add_zero]
      rw [List.length_take, Nat.min_eq_left hka] at hle
      omega
    · by_cases ha2 : 2 ≤ l_a.length
      · have h0 : s_a.count x = 0 := List.count_eq_zero.mpr (fun hm => hxa (hsa_all x hm))
        rw [List.count_append, h0, zero_add]
        have hle : s_o.count x ≤ s_o.length := List.count_le_length
        rw [List.length_take, Nat.min_eq_left hko] at hle
        omega
      · have hsub : (s_a ++ s_o).Perm (s_a ++ s_o) := List.Perm.refl _
        have hcount_le : (s_a ++ s_o).count x ≤ l.count x := by
          have h1 : l.Perm ((s_a ++ s_o) ++ (r_a ++ r_o)) := by
            have ha_eq : l_a = s_a ++ r_a := (List.take_append_drop k l_a).symm
            have ho_eq : l_o = s_o ++ r_o := (List.take_append_drop (7 - k) l_o).symm
            have hmid : ((s_a ++ r_a) ++ (s_o ++ r_o)).Perm ((s_a ++ s_o) ++ (r_a ++ r_o)) := by
              rw [List.perm_iff_count]; intro y; simp only [List.count_append]; omega
            exact hperm_split.trans (by rw [ha_eq, ho_eq]; exact hmid)
          have hc := h1.count_eq (a := x)
          simp only [List.count_append] at hc ⊢
          omega
        have hle_a := ha_max x
        omega

end OeisA003459R1H1Proof

