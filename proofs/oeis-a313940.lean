/-- The recurrence. -/
theorem recur : ∀ n : ℕ, 12 < n → (a n : ℤ) = a (n - 1) - a (n - 3) + a (n - 4) + a (n - 5) - 2 * a (n - 6) + a (n - 7) + a (n - 8) - a (n - 9) + a (n - 11) - a (n - 12) := by
  intro n hn
  obtain ⟨q, rfl⟩ : ∃ q, n = q + 13 := ⟨n - 13, by omega⟩
  rw [show q + 13 - 1 = q + 12 from Nat.add_sub_assoc (by decide : 1 ≤ 13) q, show q + 13 - 3 = q + 10 from Nat.add_sub_assoc (by decide : 3 ≤ 13) q, show q + 13 - 4 = q + 9 from Nat.add_sub_assoc (by decide : 4 ≤ 13) q, show q + 13 - 5 = q + 8 from Nat.add_sub_assoc (by decide : 5 ≤ 13) q, show q + 13 - 6 = q + 7 from Nat.add_sub_assoc (by decide : 6 ≤ 13) q, show q + 13 - 7 = q + 6 from Nat.add_sub_assoc (by decide : 7 ≤ 13) q, show q + 13 - 8 = q + 5 from Nat.add_sub_assoc (by decide : 8 ≤ 13) q, show q + 13 - 9 = q + 4 from Nat.add_sub_assoc (by decide : 9 ≤ 13) q, show q + 13 - 11 = q + 2 from Nat.add_sub_assoc (by decide : 11 ≤ 13) q, show q + 13 - 12 = q + 1 from Nat.add_sub_assoc (by decide : 12 ≤ 13) q]
