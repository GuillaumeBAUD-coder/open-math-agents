/-- The denominator times A, as a sum of monomials. -/
theorem gf_den (A : ℚ⟦X⟧) : A * ((X - 1) ^ 2 * (X ^ 6 + X ^ 3 + 1) * (X ^ 4 + X ^ 3 + X ^ 2 + X + 1)) = C 1 * A - C 1 * (A * X ^ 1) + C 1 * (A * X ^ 3) - C 1 * (A * X ^ 4) - C 1 * (A * X ^ 5) + C 2 * (A * X ^ 6) - C 1 * (A * X ^ 7) - C 1 * (A * X ^ 8) + C 1 * (A * X ^ 9) - C 1 * (A * X ^ 11) + C 1 * (A * X ^ 12) := by
  simp only [map_ofNat, map_one]
  ring

open PowerSeries in
/-- The numerator as a sum of monomials. -/
theorem gf_num : ((X + 1) ^ 2 * (X ^ 10 + 2 * X ^ 9 + 5 * X ^ 7 + X ^ 6 + 3 * X ^ 5 + X ^ 4 + 5 * X ^ 3 + 2 * X + 1) : ℚ⟦X⟧) = X ^ 0 * C 1 + X ^ 1 * C 4 + X ^ 2 * C 5 + X ^ 3 * C 7 + X ^ 4 * C 11 + X ^ 5 * C 10 + X ^ 6 * C 8 + X ^ 7 * C 10 + X ^ 8 * C 11 + X ^ 9 * C 7 + X ^ 10 * C 5 + X ^ 11 * C 4 + X ^ 12 * C 1 := by
  simp only [map_ofNat, map_one]
  ring

