theorem dv_const : ∀ t : ℕ, dv t = 252 := by
  intro t
  rw [dv]
  exact dconst_base _ (Nat.mod_lt _ (by norm_num))

/-- The step a(n + 45) = a(n) + 252 for n ≥ 1. -/
theorem a_step (n : ℕ) (hn : 1 ≤ n) : a (n + 45) = a n + 252 := by
  rw [a_eq_b, a_eq_b, b_step n hn, dv_const]

