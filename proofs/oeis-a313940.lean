  have e : ∀ o : ℕ, dv (t + o) = dv (t % 45 + o) := fun o => by
    rw [dv, dv, Nat.mod_add_mod]
  rw [e 0, e 1, e 3, e 4, e 5, e 6, e 7, e 8, e 9, e 11, e 12]
