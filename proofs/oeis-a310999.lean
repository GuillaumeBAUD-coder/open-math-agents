theorem recur_base : ∀ q : ℕ, q < 10 → b (q + 14) + 2 * b (q + 12) + 2 * b (q + 10) + 2 * b (q + 8) + 2 * b (q + 6) + b (q + 4) = 2 * b (q + 13) + 2 * b (q + 11) + 2 * b (q + 9) + 2 * b (q + 7) + 2 * b (q + 5) := recur_baseK.down

