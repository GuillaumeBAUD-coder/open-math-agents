  exacts [farsOK0_dec.down, farsOK1_dec.down, farsOK2_dec.down, farsOK3_dec.down, farsOK4_dec.down, farsOK5_dec.down, farsOK6_dec.down, farsOK7_dec.down, farsOK8_dec.down, farsOK9_dec.down, farsOK10_dec.down, farsOK11_dec.down, farsOK12_dec.down, farsOK13_dec.down, farsOK14_dec.down, farsOK15_dec.down]

