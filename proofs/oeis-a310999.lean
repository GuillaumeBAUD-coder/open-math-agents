theorem smallOK_all (k : Fin 20) : smallOK k = true := by
  fin_cases k
  exacts [smallOK0_dec.down, smallOK1_dec.down, smallOK2_dec.down, smallOK3_dec.down, smallOK4_dec.down, smallOK5_dec.down, smallOK6_dec.down, smallOK7_dec.down, smallOK8_dec.down, smallOK9_dec.down, smallOK10_dec.down, smallOK11_dec.down, smallOK12_dec.down, smallOK13_dec.down, smallOK14_dec.down, smallOK15_dec.down, smallOK16_dec.down, smallOK17_dec.down, smallOK18_dec.down, smallOK19_dec.down]

/-- The coordination sequence below n = 4. -/
theorem small_vals : (List.range 4).map a = [1, 4, 8, 10] := by
  have hc : ∀ n ∈ List.range 4, a n = ∑ s : Fin 20, smallT s n := by
    intro n hn
    rw [List.mem_range] at hn
    rw [a_small n (by omega)]
    refine Finset.sum_congr rfl (fun s _ => ?_)
    have h := smallOK_all s
    unfold smallOK at h
    rw [List.all_eq_true] at h
    exact of_decide_eq_true (h n (List.mem_range.2 hn))
  rw [List.map_congr_left hc]
  decide +kernel


/-! ## Counting the spheres

The sphere F = n splits into pieces: class s and the first facet i attaining the maximum. The
gradient of facet i is gc i times the primitive vector (Ap i, Bp i), so the points of class s with
pot_i = n lie on the line Ap i x + Bp i y = c with c = lev s i n, and only when gc i divides
n - Cc s i. That line is par s i c u = (al i c + Bp i u, be i c - Ap i u), and potential j is
ka i j c + Dm i j u + Cc s j there (`pot_par`). The previous facet bounds u from above, the next one
from below, and for n ≥ 16 the other facets lie below by Farkas certificates (`certG_ok`,
`certC_ok`). So each piece is an interval of integers (`piece_eq`), the sphere size is a sum of floor
quotients (`cnt_eq_S`), and shifting n by 30 moves every quotient by an integer (`inner_shift`,
`S_shift`). The kernel checks run over natural numbers in loops by the recursor of ℕ (`allR`,
`sumR`, `maxR`), on tables packed into natural numbers (`ctabN`). The section lives in the namespace
`Count`; `gf`, `recur`, `controls`, `a_step` and `a_closed` are restated after it. -/

namespace Count

/-- Field k of the B-bit fields packed in T. -/
def ctabN (T B k : ℕ) : ℕ := Nat.mod (Nat.shiftRight T (Nat.mul B k)) (Nat.pow 2 B)

/-- f 0 && ... && f (n - 1), by the recursor of ℕ: the kernel's cheapest loop. -/
noncomputable def allR (n : ℕ) (f : ℕ → Bool) : Bool := Nat.rec true (fun k acc => f k && acc) n

theorem allR_iff (n : ℕ) (f : ℕ → Bool) : allR n f = true ↔ ∀ k, k < n → f k = true := by
  induction n with
  | zero => exact ⟨fun _ k hk => absurd hk (Nat.not_lt_zero k), fun _ => rfl⟩
  | succ n ih =>
    show (f n && allR n f) = true ↔ _
    rw [Bool.and_eq_true, ih]
    constructor
    · rintro ⟨h1, h2⟩ k hk
      rcases Nat.lt_succ_iff_lt_or_eq.1 hk with h | h
      · exact h2 k h
      · exact h ▸ h1
    · intro h
      exact ⟨h n (Nat.lt_succ_self n), fun k hk => h k (Nat.lt_succ_of_lt hk)⟩

/-- f 0 + ... + f (n - 1), by the recursor of ℕ. -/
noncomputable def sumR (n : ℕ) (f : ℕ → ℕ) : ℕ := Nat.rec 0 (fun k acc => Nat.add (f k) acc) n

theorem sumR_eq (n : ℕ) (f : ℕ → ℕ) : sumR n f = ∑ k ∈ Finset.range n, f k := by
  induction n with
  | zero => rfl
  | succ n ih =>
    show Nat.add (f n) (sumR n f) = _
    rw [Finset.sum_range_succ, ← ih, Nat.add_eq, Nat.add_comm]

/-- The largest of f 0, ..., f (n - 1), and 0 for n = 0, by the recursor of ℕ. -/
noncomputable def maxR (n : ℕ) (f : ℕ → ℕ) : ℕ :=
  Nat.rec 0 (fun k acc => cond (Nat.ble (f k) acc) acc (f k)) n

theorem maxR_succ (n : ℕ) (f : ℕ → ℕ) : maxR (n + 1) f = max (f n) (maxR n f) := by
  show cond (Nat.ble (f n) (maxR n f)) (maxR n f) (f n) = _
  cases hb : Nat.ble (f n) (maxR n f)
  · have h : ¬ f n ≤ maxR n f := fun h => by
      rw [Nat.ble_eq_true_of_le h] at hb
      exact Bool.noConfusion hb
    exact (max_eq_left (not_le.mp h).le).symm
  · exact (max_eq_right (Nat.le_of_ble_eq_true hb)).symm

theorem maxR_le (n : ℕ) (f : ℕ → ℕ) (c : ℕ) (h : ∀ k, k < n → f k ≤ c) : maxR n f ≤ c := by
  induction n with
  | zero => exact Nat.zero_le c
  | succ n ih =>
    rw [maxR_succ]
    exact max_le (h n (Nat.lt_succ_self n)) (ih (fun k hk => h k (Nat.lt_succ_of_lt hk)))

theorem le_maxR (n : ℕ) (f : ℕ → ℕ) (k : ℕ) (hk : k < n) : f k ≤ maxR n f := by
  induction n with
  | zero => exact absurd hk (Nat.not_lt_zero k)
  | succ n ih =>
    rw [maxR_succ]
    rcases Nat.lt_succ_iff_lt_or_eq.1 hk with h | h
    · exact le_trans (ih h) (le_max_right _ _)
    · rw [h]
      exact le_max_left _ _

theorem nmod (x y : ℕ) : Nat.mod x y = x % y := rfl

theorem ndiv (x y : ℕ) : Nat.div x y = x / y := rfl

/-- f a && ... && f (a + w - 1): one piece of a kernel check. -/
noncomputable def allI (a w : ℕ) (f : ℕ → Bool) : Bool := allR w fun t => f (Nat.add a t)

theorem allI_get (a w : ℕ) (f : ℕ → Bool) (h : allI a w f = true) (k : ℕ) (h1 : a ≤ k)
    (h2 : k < a + w) : f k = true := by
  have := (allR_iff _ _).1 h (k - a) (by omega)
  rwa [Nat.add_eq, Nat.add_sub_cancel' h1] at this

/-- The potential tables of the distance part as natural numbers. -/
def AW (i : ℕ) : ℕ := tgetN 3777057663291376418 4 i

def BW (i : ℕ) : ℕ := tgetN 10002193276528108358 4 i

def CW (s i : ℕ) : ℕ := tgetN (CcT s) 4 i

theorem A_W (i : Fin 16) : Ac i = (AW i.val : ℤ) - 8 := by rw [Ac, tget, Int.subNatNat_eq_coe]; rfl

theorem B_W (i : Fin 16) : Bc i = (BW i.val : ℤ) - 8 := by rw [Bc, tget, Int.subNatNat_eq_coe]; rfl

theorem C_W (s : Fin 20) (i : Fin 16) : Cc s i = (CW s.val i.val : ℤ) - 8 := by rw [Cc, tget, Int.subNatNat_eq_coe]; rfl

def gcV (k : ℕ) : ℕ := ctabN 185977765700946 3 k

def gcN (k : ℕ) : ℤ := (gcV k : ℤ)

def gc (i : Fin 16) : ℤ := gcN i.val

def ApV (k : ℕ) : ℕ := ctabN 76189340672640 3 k

def ApN (k : ℕ) : ℤ := (ApV k : ℤ) - 3

def Ap (i : Fin 16) : ℤ := ApN i.val

def BpV (k : ℕ) : ℕ := ctabN 126362977861770 3 k

def BpN (k : ℕ) : ℤ := (BpV k : ℤ) - 3

def Bp (i : Fin 16) : ℤ := BpN i.val

def alV (k : ℕ) : ℕ := ctabN 437883025 2 k

def alN (k : ℕ) : ℤ := (alV k : ℤ) - 1

def al (i : Fin 16) : ℤ := alN i.val

def beV (k : ℕ) : ℕ := ctabN 1772241160 2 k

def beN (k : ℕ) : ℤ := (beV k : ℤ) - 1

def be (i : Fin 16) : ℤ := beN i.val

def primK : PLift (∀ i : Fin 16, Ac i = gc i * Ap i ∧ Bc i = gc i * Bp i ∧ 0 < gc i ∧ al i * Ap i + be i * Bp i = 1) :=
  ⟨by decide +kernel⟩

theorem prim : ∀ i : Fin 16, Ac i = gc i * Ap i ∧ Bc i = gc i * Bp i ∧ 0 < gc i ∧ al i * Ap i + be i * Bp i = 1 := primK.down

/-- Potential j changes by Dm i j along the line of facet i, per lattice step. -/
def Dm (i j : Fin 16) : ℤ := Ac j * Bp i - Bc j * Ap i

def ka (i j : Fin 16) : ℤ := Ac j * al i + Bc j * be i

def orientK : PLift (∀ i : Fin 16, 0 < Dm i (i - 1) ∧ Dm i (i + 1) < 0) :=
  ⟨by decide +kernel⟩

theorem orient : ∀ i : Fin 16, 0 < Dm i (i - 1) ∧ Dm i (i + 1) < 0 := orientK.down

/-- The point with parameter u on the line Ap i x + Bp i y = c, in class s. -/
def par (s : Fin 20) (i : Fin 16) (c u : ℤ) : V :=
  (al i * c + Bp i * u, be i * c - Ap i * u, s)

theorem pot_par (s : Fin 20) (i j : Fin 16) (c u : ℤ) :
    pot (par s i c u) j = ka i j * c + Dm i j * u + Cc s j := by
  simp only [pot, par, ka, Dm]
  ring

theorem par_inv (v : V) (i : Fin 16) :
    v = par v.2.2 i (Ap i * v.1 + Bp i * v.2.1) (be i * v.1 - al i * v.2.1) := by
  obtain ⟨x, y, s⟩ := v
  have hb := (prim i).2.2.2
  simp only [par, Prod.mk.injEq, and_true]
  constructor
  · linear_combination (-x) * hb
  · linear_combination (-y) * hb

theorem pot_lev (v : V) (i : Fin 16) : pot v i = gc i * (Ap i * v.1 + Bp i * v.2.1) + Cc v.2.2 i := by
  obtain ⟨h1, h2, -, -⟩ := prim i
  simp only [pot]
  rw [h1, h2]
  ring

theorem par_inj (s : Fin 20) (i : Fin 16) (c : ℤ) : Function.Injective (par s i c) := by
  intro u u' h
  simp only [par, Prod.mk.injEq] at h
  have hb := (prim i).2.2.2
  have h1 : Bp i * (u - u') = 0 := by linarith [h.1]
  have h2 : Ap i * (u - u') = 0 := by linarith [h.2.1]
  have h3 : (u - u') = (u - u') * (al i * Ap i + be i * Bp i) := by rw [hb, mul_one]
  have : u - u' = 0 := by
    rw [h3]
    linear_combination (al i) * h2 + (be i) * h1
  linarith

/-- Some facet attains the maximum. -/
theorem F_attained (v : V) : ∃ k : Fin 16, pot v k = F v := by
  by_contra hne
  have h : ∀ k, pot v k ≤ F v - 1 := fun k => by
    have h1 := le_F v k
    have h2 : pot v k ≠ F v := fun e => hne ⟨k, e⟩
    omega
  have := F_le v (F v - 1) (h 0) (h 1) (h 2) (h 3) (h 4) (h 5) (h 6) (h 7) (h 8) (h 9) (h 10) (h 11) (h 12) (h 13) (h 14) (h 15)
  omega

/-- The first facet attaining the maximum. -/
noncomputable def fi (v : V) : Fin 16 := Fin.find (fun k => pot v k = F v) (F_attained v)

theorem fi_spec (v : V) : pot v (fi v) = F v ∧ ∀ j, j < fi v → pot v j < F v :=
  ⟨Fin.find_spec (F_attained v), fun j hj =>
    lt_of_le_of_ne (le_F v j) (Fin.find_min (F_attained v) hj)⟩

theorem fi_iff (v : V) (i : Fin 16) : fi v = i ↔ pot v i = F v ∧ ∀ j, j < i → pot v j < F v := by
  constructor
  · rintro rfl
    exact fi_spec v
  · rintro ⟨h1, h2⟩
    obtain ⟨g1, g2⟩ := fi_spec v
    rcases lt_trichotomy (fi v) i with h | h | h
    · exact absurd g1 (ne_of_lt (h2 _ h))
    · exact h
    · exact absurd h1 (ne_of_lt (g2 _ h))

theorem ite01 (c : Prop) [Decidable c] : (0 : ℤ) ≤ (if c then 1 else 0) ∧ (if c then 1 else 0 : ℤ) ≤ 1 := by
  split_ifs <;> norm_num

/-- On the sphere F = n, the first maximal facet is i exactly when potential i is n and every
potential j is at most n - [j < i]. -/
theorem piece_iff (v : V) (i : Fin 16) (n : ℤ) :
    (F v = n ∧ fi v = i) ↔ (pot v i = n ∧ ∀ j, pot v j ≤ n - (if j < i then 1 else 0)) := by
  rw [fi_iff]
  constructor
  · rintro ⟨rfl, h1, h2⟩
    refine ⟨h1, fun j => ?_⟩
    split_ifs with hj
    · have := h2 j hj
      omega
    · have := le_F v j
      omega
  · rintro ⟨h1, h2⟩
    have h3 : ∀ j, pot v j ≤ n := fun j => le_trans (h2 j) (sub_le_self n (ite01 _).1)
    have hF : F v = n := le_antisymm (F_le_all v n h3) (h1 ▸ le_F v i)
    refine ⟨hF, hF ▸ h1, fun j hj => ?_⟩
    have := h2 j
    rw [if_pos hj] at this
    omega

/-- The previous and the next facet around the growth polygon, and [i - 1 < i], [i + 1 < i]. -/
def prevF (i : ℕ) : ℕ := Nat.mod (Nat.add i 15) 16

def nextF (i : ℕ) : ℕ := Nat.mod (Nat.add i 1) 16

def ehV (k : ℕ) : ℕ := ctabN 65534 1 k

def ekV (k : ℕ) : ℕ := ctabN 32768 1 k

def fin_prevK : PLift (∀ i : Fin 16, (i - 1).val = prevF i.val ∧ (if i - 1 < i then (1 : ℤ) else 0) = (ehV i.val : ℤ)) :=
  ⟨by decide +kernel⟩

theorem fin_prev : ∀ i : Fin 16, (i - 1).val = prevF i.val ∧ (if i - 1 < i then (1 : ℤ) else 0) = (ehV i.val : ℤ) := fin_prevK.down

def fin_nextK : PLift (∀ i : Fin 16, (i + 1).val = nextF i.val ∧ (if i + 1 < i then (1 : ℤ) else 0) = (ekV i.val : ℤ)) :=
  ⟨by decide +kernel⟩

theorem fin_next : ∀ i : Fin 16, (i + 1).val = nextF i.val ∧ (if i + 1 < i then (1 : ℤ) else 0) = (ekV i.val : ℤ) := fin_nextK.down

/-! The Farkas multipliers (cf1, cf2, cf3, cf0) of the facet pair (i, j): cf1 times
(pot_(i-1) ≤ pot_i - [i-1 < i]) plus cf2 times (pot_(i+1) ≤ pot_i - [i+1 < i]) plus cf3 times
(pot_i ≤ pot_j) plus cf0 times (16 ≤ pot_i) is a contradiction, for every class. -/

def cf1V (k : ℕ) : ℕ := ctabN  4 k

def cf2V (k : ℕ) : ℕ := ctabN 275879080836400049567050771946827341171672982757907976685358534234831965065938415261407353462596456600613765283430549553758493808053392292656444304665481834382297362743304896651718067546102277336448532141345876266237913629390587232531018665788192437318165196351646785627051746019188564400005413376 4 k

def cf3V (k : ℕ) : ℕ := ctabN 17309021489532409254634138180942839434966866512425109958002120284842832063030730883588007299328235098898820027285278786200241997233842805593618639380901418482578918137835181844502316523637271936469497189808568950136226027747452800 3 k

def cf0V (k : ℕ) : ℕ := ctabN  4 k

def cf1 (i j : Fin 16) : ℤ := (cf1V (j.val + 16 * i.val) : ℤ)

def cf2 (i j : Fin 16) : ℤ := (cf2V (j.val + 16 * i.val) : ℤ)

def cf3 (i j : Fin 16) : ℤ := (cf3V (j.val + 16 * i.val) : ℤ)

def cf0 (i j : Fin 16) : ℤ := (cf0V (j.val + 16 * i.val) : ℤ)

/-- The class-independent part of the certificate of (i, j): nonnegative multipliers whose
combination of the gradients vanishes. -/
def certG (i j : Fin 16) : Prop :=
  let h := i - 1
  let k := i + 1
  0 ≤ cf1 i j ∧ 0 ≤ cf2 i j ∧ 0 ≤ cf3 i j ∧ 0 ≤ cf0 i j ∧
    cf1 i j * (Ac h - Ac i) + cf2 i j * (Ac k - Ac i) + cf3 i j * (Ac i - Ac j) - cf0 i j * Ac i = 0 ∧
    cf1 i j * (Bc h - Bc i) + cf2 i j * (Bc k - Bc i) + cf3 i j * (Bc i - Bc j) - cf0 i j * Bc i = 0

/-- The part of the certificate of (i, j) for class s: the combination of the constants is positive. -/
def certC (s : Fin 20) (i j : Fin 16) : Prop :=
  let h := i - 1
  let k := i + 1
  0 < cf1 i j * (Cc s h - Cc s i + (if h < i then 1 else 0)) +
    cf2 i j * (Cc s k - Cc s i + (if k < i then 1 else 0)) + cf3 i j * (Cc s i - Cc s j) +
    cf0 i j * (16 - Cc s i)

/-- j is i or a neighbour of i around the growth polygon. -/
def nearB (i j : ℕ) : Bool := Nat.beq j i || Nat.beq j (nextF i) || Nat.beq j (prevF i)

/-- certG in natural numbers: Ac = AW - 8, Bc = BW - 8, the negative terms moved across. -/
def certGN (i j : ℕ) : Bool :=
  Nat.beq (Nat.add (Nat.add (Nat.add (Nat.mul (cf1V (Nat.add j (Nat.mul 16 i))) (AW (prevF i))) (Nat.mul (cf2V (Nat.add j (Nat.mul 16 i))) (AW (nextF i)))) (Nat.mul (cf3V (Nat.add j (Nat.mul 16 i))) (AW i))) (Nat.mul (cf0V (Nat.add j (Nat.mul 16 i))) 8))
      (Nat.add (Nat.mul (Nat.add (Nat.add (cf1V (Nat.add j (Nat.mul 16 i))) (cf2V (Nat.add j (Nat.mul 16 i)))) (cf0V (Nat.add j (Nat.mul 16 i)))) (AW i)) (Nat.mul (cf3V (Nat.add j (Nat.mul 16 i))) (AW j))) &&
    Nat.beq (Nat.add (Nat.add (Nat.add (Nat.mul (cf1V (Nat.add j (Nat.mul 16 i))) (BW (prevF i))) (Nat.mul (cf2V (Nat.add j (Nat.mul 16 i))) (BW (nextF i)))) (Nat.mul (cf3V (Nat.add j (Nat.mul 16 i))) (BW i))) (Nat.mul (cf0V (Nat.add j (Nat.mul 16 i))) 8))
      (Nat.add (Nat.mul (Nat.add (Nat.add (cf1V (Nat.add j (Nat.mul 16 i))) (cf2V (Nat.add j (Nat.mul 16 i)))) (cf0V (Nat.add j (Nat.mul 16 i)))) (BW i)) (Nat.mul (cf3V (Nat.add j (Nat.mul 16 i))) (BW j)))

/-- certC in natural numbers: Cc = CW - 8, the negative terms moved across. -/
def certCN (s i j : ℕ) : Bool :=
  Nat.blt (Nat.add (Nat.mul (Nat.add (Nat.add (cf1V (Nat.add j (Nat.mul 16 i))) (cf2V (Nat.add j (Nat.mul 16 i)))) (cf0V (Nat.add j (Nat.mul 16 i)))) (CW s i)) (Nat.mul (cf3V (Nat.add j (Nat.mul 16 i))) (CW s j)))
    (Nat.add (Nat.add (Nat.add (Nat.mul (cf1V (Nat.add j (Nat.mul 16 i))) (Nat.add (CW s (prevF i)) (ehV i))) (Nat.mul (cf2V (Nat.add j (Nat.mul 16 i))) (Nat.add (CW s (nextF i)) (ekV i)))) (Nat.mul (cf3V (Nat.add j (Nat.mul 16 i))) (CW s i))) (Nat.mul (cf0V (Nat.add j (Nat.mul 16 i))) 24))

def certGK : PLift ((allR 16 fun i => allR 16 fun j => nearB i j || certGN i j) = true) :=
  ⟨by decide +kernel⟩

/-- The constant parts of the certificates for class s. -/
noncomputable def certS (s : ℕ) : Bool := allR 16 fun i => allR 16 fun j => nearB i j || certCN s i j

/-! The constant parts, checked by the kernel in pieces of consecutive classes. -/

def certCK0 : PLift (allI 0 5 certS = true) :=
  ⟨by decide +kernel⟩

def certCK1 : PLift (allI 5 5 certS = true) :=
  ⟨by decide +kernel⟩

def certCK2 : PLift (allI 10 5 certS = true) :=
  ⟨by decide +kernel⟩

def certCK3 : PLift (allI 15 5 certS = true) :=
  ⟨by decide +kernel⟩

theorem cert_ok (s : ℕ) (hs : s < 20) : certS s = true := by
  rcases (show s < 5 ∨ (5 ≤ s ∧ s < 10) ∨ (10 ≤ s ∧ s < 15) ∨ 15 ≤ s by omega) with h | h | h | h
  · exact allI_get _ _ _ certCK0.down s (by omega) (by omega)
  · exact allI_get _ _ _ certCK1.down s (by omega) (by omega)
  · exact allI_get _ _ _ certCK2.down s (by omega) (by omega)
  · exact allI_get _ _ _ certCK3.down s (by omega) (by omega)

theorem beq_ff (x y : ℕ) (h : x ≠ y) : Nat.beq x y = false := by
  cases hb : Nat.beq x y
  · rfl
  · exact absurd (Nat.eq_of_beq_eq_true hb) h

theorem near_false (i j : Fin 16) (e1 : j ≠ i - 1) (e2 : j ≠ i) (e3 : j ≠ i + 1) :
    nearB i.val j.val = false := by
  obtain ⟨a1, -⟩ := fin_prev i
  obtain ⟨b1, -⟩ := fin_next i
  have n1 : j.val ≠ i.val := fun h => e2 (Fin.ext h)
  have n2 : j.val ≠ nextF i.val := fun h => e3 (Fin.ext (h.trans b1.symm))
  have n3 : j.val ≠ prevF i.val := fun h => e1 (Fin.ext (h.trans a1.symm))
  rw [nearB, beq_ff _ _ n1, beq_ff _ _ n2, beq_ff _ _ n3]
  rfl

/-- The gradient parts of the certificates hold in the integers: the natural-number check moved
across. -/
theorem certG_ok (i j : Fin 16) (e1 : j ≠ i - 1) (e2 : j ≠ i) (e3 : j ≠ i + 1) : certG i j := by
  obtain ⟨a1, -⟩ := fin_prev i
  obtain ⟨b1, -⟩ := fin_next i
  have hk := (allR_iff _ _).1 ((allR_iff _ _).1 certGK.down i.val i.isLt) j.val j.isLt
  rw [near_false i j e1 e2 e3, Bool.false_or] at hk
  simp only [certGN, Bool.and_eq_true, Nat.beq_eq, Nat.add_eq, Nat.mul_eq] at hk
  obtain ⟨hA, hB⟩ := hk
  have cA := congrArg (Nat.cast : ℕ → ℤ) hA
  have cB := congrArg (Nat.cast : ℕ → ℤ) hB
  push_cast at cA cB
  simp only [certG, cf1, cf2, cf3, cf0, A_W, B_W, a1, b1]
  refine ⟨by positivity, by positivity, by positivity, by positivity, by linear_combination cA,
    by linear_combination cB⟩

/-- The constant parts of the certificates hold in the integers: the natural-number check moved
across. -/
theorem certC_ok (s : Fin 20) (i j : Fin 16) (e1 : j ≠ i - 1) (e2 : j ≠ i) (e3 : j ≠ i + 1) :
    certC s i j := by
  obtain ⟨a1, a2⟩ := fin_prev i
  obtain ⟨b1, b2⟩ := fin_next i
  have hk := (allR_iff _ _).1 ((allR_iff _ _).1 (cert_ok s.val s.isLt) i.val i.isLt) j.val j.isLt
  rw [near_false i j e1 e2 e3, Bool.false_or] at hk
  simp only [certCN, Nat.blt_eq, Nat.add_eq, Nat.mul_eq] at hk
  have ck := (Nat.cast_lt (α := ℤ)).mpr hk
  push_cast at ck
  simp only [certC, cf1, cf2, cf3, cf0, a2, b2, C_W, a1, b1]
  ring_nf at ck ⊢
  linarith

theorem farkas4 (v : V) (h i k j : Fin 16) (e1 e2 r l1 l2 l3 l0 : ℤ)
    (hl : 0 ≤ l1 ∧ 0 ≤ l2 ∧ 0 ≤ l3 ∧ 0 ≤ l0)
    (hx : l1 * (Ac h - Ac i) + l2 * (Ac k - Ac i) + l3 * (Ac i - Ac j) - l0 * Ac i = 0)
    (hy : l1 * (Bc h - Bc i) + l2 * (Bc k - Bc i) + l3 * (Bc i - Bc j) - l0 * Bc i = 0)
    (hc : 0 < l1 * (Cc v.2.2 h - Cc v.2.2 i + e1) + l2 * (Cc v.2.2 k - Cc v.2.2 i + e2) +
      l3 * (Cc v.2.2 i - Cc v.2.2 j) + l0 * (r - Cc v.2.2 i))
    (f1 : pot v h ≤ pot v i - e1) (f2 : pot v k ≤ pot v i - e2) (f3 : pot v i ≤ pot v j)
    (f0 : r ≤ pot v i) : False := by
  have g1 := mul_nonpos_of_nonneg_of_nonpos hl.1 (show pot v h - pot v i + e1 ≤ 0 by linarith)
  have g2 := mul_nonpos_of_nonneg_of_nonpos hl.2.1 (show pot v k - pot v i + e2 ≤ 0 by linarith)
  have g3 := mul_nonpos_of_nonneg_of_nonpos hl.2.2.1 (show pot v i - pot v j ≤ 0 by linarith)
  have g0 := mul_nonpos_of_nonneg_of_nonpos hl.2.2.2 (show r - pot v i ≤ 0 by linarith)
  have e : l1 * (pot v h - pot v i + e1) + l2 * (pot v k - pot v i + e2) +
      l3 * (pot v i - pot v j) + l0 * (r - pot v i) =
      l1 * (Cc v.2.2 h - Cc v.2.2 i + e1) + l2 * (Cc v.2.2 k - Cc v.2.2 i + e2) +
        l3 * (Cc v.2.2 i - Cc v.2.2 j) + l0 * (r - Cc v.2.2 i) := by
    simp only [pot]
    linear_combination v.1 * hx + v.2.1 * hy
  linarith

/-- The level of the line of facet i through the points of class s with pot_i = n. -/
def lev (s : Fin 20) (i : Fin 16) (n : ℤ) : ℤ := (n - Cc s i) / gc i

theorem lev_mul (s : Fin 20) (i : Fin 16) (n : ℤ) (hd : (n - Cc s i) % gc i = 0) :
    gc i * lev s i n = n - Cc s i :=
  Int.mul_ediv_cancel' (Int.dvd_of_emod_eq_zero hd)

/-- The bound R in Dm i j * u ≤ R that says pot_j ≤ n - [j < i] on the piece (s, i). -/
def Rb (s : Fin 20) (i j : Fin 16) (n : ℤ) : ℤ :=
  n - (if j < i then 1 else 0) - ka i j * lev s i n - Cc s j

def hi (s : Fin 20) (i : Fin 16) (n : ℤ) : ℤ := Rb s i (i - 1) n / Dm i (i - 1)

def lo (s : Fin 20) (i : Fin 16) (n : ℤ) : ℤ := -(Rb s i (i + 1) n / (-Dm i (i + 1)))

theorem pot_le_iff (s : Fin 20) (i j : Fin 16) (n u : ℤ) :
    pot (par s i (lev s i n) u) j ≤ n - (if j < i then 1 else 0) ↔ Dm i j * u ≤ Rb s i j n := by
  rw [pot_par, Rb]
  constructor <;> intro h <;> linarith

theorem le_hi_iff (s : Fin 20) (i : Fin 16) (n u : ℤ) :
    u ≤ hi s i n ↔ Dm i (i - 1) * u ≤ Rb s i (i - 1) n := by
  rw [hi, Int.le_ediv_iff_mul_le (orient i).1, mul_comm]

theorem lo_le_iff (s : Fin 20) (i : Fin 16) (n u : ℤ) :
    lo s i n ≤ u ↔ Dm i (i + 1) * u ≤ Rb s i (i + 1) n := by
  have hd : 0 < -Dm i (i + 1) := by linarith [(orient i).2]
  rw [lo, neg_le, Int.le_ediv_iff_mul_le hd]
  constructor <;> intro h <;> linarith

theorem ka_self (i : Fin 16) : ka i i = gc i := by
  obtain ⟨h1, h2, -, hb⟩ := prim i
  rw [ka, h1, h2]
  linear_combination (gc i) * hb

theorem Dm_self (i : Fin 16) : Dm i i = 0 := by
  obtain ⟨h1, h2, -, -⟩ := prim i
  rw [Dm, h1, h2]
  ring

theorem pot_par_self (s : Fin 20) (i : Fin 16) (n u : ℤ) (hd : (n - Cc s i) % gc i = 0) :
    pot (par s i (lev s i n) u) i = n := by
  rw [pot_par, ka_self, Dm_self, lev_mul s i n hd]
  ring

/-- From n = 16 on, the points of the interval [lo, hi] are the piece. -/
theorem par_piece (s : Fin 20) (i : Fin 16) (n u : ℤ) (hn : 16 ≤ n)
    (hd : (n - Cc s i) % gc i = 0) (h1 : lo s i n ≤ u) (h2 : u ≤ hi s i n) :
    ∀ j, pot (par s i (lev s i n) u) j ≤ n - (if j < i then 1 else 0) := by
  have hi' := pot_par_self s i n u hd
  have hh := (pot_le_iff s i (i - 1) n u).2 ((le_hi_iff s i n u).1 h2)
  have hk := (pot_le_iff s i (i + 1) n u).2 ((lo_le_iff s i n u).1 h1)
  intro j
  by_cases e1 : j = i - 1
  · rw [e1]; exact hh
  by_cases e2 : j = i
  · simp only [e2, hi', lt_irrefl, if_false, sub_zero, le_refl]
  by_cases e3 : j = i + 1
  · rw [e3]; exact hk
  obtain ⟨c1, c2, c3, c0, cx, cy⟩ := certG_ok i j e1 e2 e3
  have cc := certC_ok s i j e1 e2 e3
  simp only [certC] at cc
  by_contra hne
  have f3 : pot (par s i (lev s i n) u) i ≤ pot (par s i (lev s i n) u) j := by
    have := (ite01 (j < i)).2
    rw [hi']
    linarith [not_le.1 hne]
  exact farkas4 (par s i (lev s i n) u) (i - 1) i (i + 1) j _ _ 16 _ _ _ _ ⟨c1, c2, c3, c0⟩ cx cy cc
    (by rw [hi']; exact hh) (by rw [hi']; exact hk) f3 (by rw [hi']; exact hn)

/-- The class constants lie in [-7, 7]: a natural-number check. -/
def cbK : PLift ((allR 20 fun s => allR 16 fun i => Nat.ble (CW s i) 15 && Nat.ble 8 (Nat.add (CW s i) 7)) = true) :=
  ⟨by decide +kernel⟩

theorem Cbound (s : Fin 20) (j : Fin 16) : -7 ≤ Cc s j ∧ Cc s j ≤ 7 := by
  have h := (allR_iff _ _).1 ((allR_iff _ _).1 cbK.down s.val s.isLt) j.val j.isLt
  simp only [Bool.and_eq_true, Nat.ble_eq, Nat.add_eq] at h
  rw [C_W]
  omega

/-- The box that holds the sphere F = n. -/
noncomputable def Bx (n : ℤ) : Finset V :=
  Finset.Icc (-(1 * n + 7)) (1 * n + 7) ×ˢ
    (Finset.Icc (-(1 * n + 7)) (1 * n + 7) ×ˢ Finset.univ)

/-! Weighted pairs of facets whose gradients add up to a multiple of an axis direction. -/

def box_pairsK : PLift (1 * Ac 6 + 1 * Ac 8 = 10 ∧ 1 * Bc 6 + 1 * Bc 8 = 0 ∧
    1 * Ac 0 + 1 * Ac 14 = (-10) ∧ 1 * Bc 0 + 1 * Bc 14 = 0 ∧
    1 * Ac 12 + 1 * Ac 13 = 0 ∧ 1 * Bc 12 + 1 * Bc 13 = 10 ∧
    1 * Ac 4 + 1 * Ac 5 = 0 ∧ 1 * Bc 4 + 1 * Bc 5 = (-10)) :=
  ⟨by decide +kernel⟩

theorem box_pairs : 1 * Ac 6 + 1 * Ac 8 = 10 ∧ 1 * Bc 6 + 1 * Bc 8 = 0 ∧
    1 * Ac 0 + 1 * Ac 14 = (-10) ∧ 1 * Bc 0 + 1 * Bc 14 = 0 ∧
    1 * Ac 12 + 1 * Ac 13 = 0 ∧ 1 * Bc 12 + 1 * Bc 13 = 10 ∧
    1 * Ac 4 + 1 * Ac 5 = 0 ∧ 1 * Bc 4 + 1 * Bc 5 = (-10) := box_pairsK.down

/-- Each weighted pair of facets bounds one coordinate by F. -/
theorem coord_le (x y : ℤ) (s : Fin 20) :
    10 * x ≤ 2 * F (x, y, s) + 14 ∧
    10 * (-x) ≤ 2 * F (x, y, s) + 14 ∧
    10 * y ≤ 2 * F (x, y, s) + 14 ∧
    10 * (-y) ≤ 2 * F (x, y, s) + 14 := by
  obtain ⟨p1, p2, p3, p4, p5, p6, p7, p8⟩ := box_pairs
  have e0 : 1 * pot (x, y, s) 6 + 1 * pot (x, y, s) 8 =
      10 * x + 1 * Cc s 6 + 1 * Cc s 8 := by
    simp only [pot]; linear_combination x * p1 + y * p2
  have q0 := le_F (x, y, s) 6
  have r0 := le_F (x, y, s) 8
  have k0 := Cbound s 6
  have l0 := Cbound s 8
  have e1 : 1 * pot (x, y, s) 0 + 1 * pot (x, y, s) 14 =
      10 * (-x) + 1 * Cc s 0 + 1 * Cc s 14 := by
    simp only [pot]; linear_combination x * p3 + y * p4
  have q1 := le_F (x, y, s) 0
  have r1 := le_F (x, y, s) 14
  have k1 := Cbound s 0
  have l1 := Cbound s 14
  have e2 : 1 * pot (x, y, s) 12 + 1 * pot (x, y, s) 13 =
      10 * y + 1 * Cc s 12 + 1 * Cc s 13 := by
    simp only [pot]; linear_combination x * p5 + y * p6
  have q2 := le_F (x, y, s) 12
  have r2 := le_F (x, y, s) 13
  have k2 := Cbound s 12
  have l2 := Cbound s 13
  have e3 : 1 * pot (x, y, s) 4 + 1 * pot (x, y, s) 5 =
      10 * (-y) + 1 * Cc s 4 + 1 * Cc s 5 := by
    simp only [pot]; linear_combination x * p7 + y * p8
  have q3 := le_F (x, y, s) 4
  have r3 := le_F (x, y, s) 5
  have k3 := Cbound s 4
  have l3 := Cbound s 5
  refine ⟨?_, ?_, ?_, ?_⟩ <;> linarith

theorem mem_Bx (v : V) (n : ℤ) (h : F v ≤ n) : v ∈ Bx n := by
  obtain ⟨x, y, s⟩ := v
  obtain ⟨b1, b2, b3, b4⟩ := coord_le x y s
  have h0 := F_nonneg (x, y, s)
  simp only [Bx, Finset.mem_product, Finset.mem_Icc, Finset.mem_univ, and_true]
  omega

/-- The piece of the sphere F = n with class s and first maximal facet i. -/
noncomputable def PF (s : Fin 20) (i : Fin 16) (n : ℤ) : Finset V :=
  (Bx n).filter (fun v => v.2.2 = s ∧ F v = n ∧ fi v = i)

theorem piece_eq (s : Fin 20) (i : Fin 16) (n : ℤ) (hn : 16 ≤ n) :
    PF s i n = if (n - Cc s i) % gc i = 0 then
      (Finset.Icc (lo s i n) (hi s i n)).image (par s i (lev s i n)) else ∅ := by
  split_ifs with hd
  · ext v
    simp only [PF, Finset.mem_filter, Finset.mem_image, Finset.mem_Icc]
    constructor
    · rintro ⟨-, hs, hv⟩
      obtain ⟨h1, h2⟩ := (piece_iff v i n).1 hv
      have hl : lev s i n = Ap i * v.1 + Bp i * v.2.1 := by
        rw [lev, ← h1, pot_lev, hs, Int.add_sub_cancel,
          Int.mul_ediv_cancel_left _ (ne_of_gt (prim i).2.2.1)]
      have hv' := par_inv v i
      rw [hs, ← hl] at hv'
      refine ⟨be i * v.1 - al i * v.2.1, ⟨?_, ?_⟩, hv'.symm⟩
      · rw [lo_le_iff, ← pot_le_iff, ← hv']
        exact h2 (i + 1)
      · rw [le_hi_iff, ← pot_le_iff, ← hv']
        exact h2 (i - 1)
    · rintro ⟨u, ⟨h1, h2⟩, rfl⟩
      have hp := par_piece s i n u hn hd h1 h2
      have hv := (piece_iff (par s i (lev s i n) u) i n).2 ⟨pot_par_self s i n u hd, hp⟩
      exact ⟨mem_Bx _ n (le_of_eq hv.1), rfl, hv⟩
  · rw [PF]
    apply Finset.filter_false_of_mem
    rintro v - ⟨hs, hv⟩
    obtain ⟨h1, -⟩ := (piece_iff v i n).1 hv
    apply hd
    rw [← hs, ← h1, pot_lev, Int.add_sub_cancel, Int.mul_emod_right]

/-- The length of the piece (s, i) at level n, as an integer. -/
def inner (s : Fin 20) (i : Fin 16) (n : ℤ) : ℤ :=
  if (n - Cc s i) % gc i = 0 then hi s i n + 1 - lo s i n else 0

theorem card_piece (s : Fin 20) (i : Fin 16) (n : ℤ) (hn : 16 ≤ n) :
    (PF s i n).card = (inner s i n).toNat := by
  rw [piece_eq s i n hn, inner]
  split_ifs
  · rw [Finset.card_image_of_injective _ (par_inj s i _), Int.card_Icc]
  · rfl

/-- The number of points with F = n. -/
noncomputable def cnt (n : ℤ) : ℕ := Set.ncard {v : V | F v = n}

theorem cnt_eq_card (n : ℤ) : cnt n = ((Bx n).filter (fun v => F v = n)).card := by
  rw [cnt, ← Set.ncard_coe_finset]
  congr 1
  ext v
  simp only [Set.mem_ofPred_eq, Finset.coe_filter]
  exact ⟨fun h => ⟨mem_Bx v n (le_of_eq h), h⟩, fun h => h.2⟩

theorem cnt_eq_sum (n : ℤ) : cnt n = ∑ p : Fin 20 × Fin 16, (PF p.1 p.2 n).card := by
  rw [cnt_eq_card, Finset.card_eq_sum_card_fiberwise (f := fun v => (v.2.2, fi v))
    (t := Finset.univ) (fun _ _ => Finset.mem_univ _)]
  refine Finset.sum_congr rfl (fun p _ => ?_)
  rw [PF, Finset.filter_filter]
  congr 1
  apply Finset.filter_congr
  intro v _
  constructor
  · rintro ⟨h1, h2⟩
    rw [← h2]
    exact ⟨rfl, h1, rfl⟩
  · rintro ⟨h1, h2, h3⟩
    exact ⟨h2, by rw [h1, h3]⟩

/-- The closed form of the sphere size: the sum of the piece lengths. -/
def S (n : ℤ) : ℤ := ∑ p : Fin 20 × Fin 16, inner p.1 p.2 n

/-! Shifting n by 30 = gc i * Lq i moves each quotient of a piece length by an integer. -/

def LqV (k : ℕ) : ℕ := ctabN 8070440634227357439 4 k

def LqN (k : ℕ) : ℤ := (LqV k : ℤ)

def Lq (i : Fin 16) : ℤ := LqN i.val

def mhV (k : ℕ) : ℕ := ctabN 14124691750861995087 4 k

def mhN (k : ℕ) : ℤ := (mhV k : ℤ) - 9

def mh (i : Fin 16) : ℤ := mhN i.val

def mkV (k : ℕ) : ℕ := ctabN 3169129718460646064 4 k

def mkN (k : ℕ) : ℤ := (mkV k : ℤ) - 5

def mk (i : Fin 16) : ℤ := mkN i.val

def shift_okK : PLift (∀ i : Fin 16, (30 : ℤ) = gc i * Lq i ∧ 30 - ka i (i - 1) * Lq i = Dm i (i - 1) * mh i ∧ 30 - ka i (i + 1) * Lq i = (-Dm i (i + 1)) * mk i) :=
  ⟨by decide +kernel⟩

theorem shift_ok : ∀ i : Fin 16, (30 : ℤ) = gc i * Lq i ∧ 30 - ka i (i - 1) * Lq i = Dm i (i - 1) * mh i ∧ 30 - ka i (i + 1) * Lq i = (-Dm i (i + 1)) * mk i := shift_okK.down

theorem inner_shift (s : Fin 20) (i : Fin 16) (n : ℤ) :
    inner s i (n + 30) = inner s i n + (if (n - Cc s i) % gc i = 0 then mh i + mk i else 0) := by
  obtain ⟨e0, e1, e2⟩ := shift_ok i
  have hg := (prim i).2.2.1
  have hx : n + 30 - Cc s i = (n - Cc s i) + gc i * Lq i := by linear_combination e0
  have hm : (n + 30 - Cc s i) % gc i = (n - Cc s i) % gc i := by
    rw [hx, Int.add_mul_emod_self_left]
  have hl : lev s i (n + 30) = lev s i n + Lq i := by
    rw [lev, lev, hx, Int.add_mul_ediv_left _ _ (ne_of_gt hg)]
  have r1 : Rb s i (i - 1) (n + 30) = Rb s i (i - 1) n + Dm i (i - 1) * mh i := by
    rw [← e1]; simp only [Rb, hl]; ring
  have r2 : Rb s i (i + 1) (n + 30) = Rb s i (i + 1) n + (-Dm i (i + 1)) * mk i := by
    rw [← e2]; simp only [Rb, hl]; ring
  rw [inner, inner, hm]
  split_ifs
  · simp only [hi, lo, r1, r2]
    rw [Int.add_mul_ediv_left _ _ (ne_of_gt (orient i).1),
      Int.add_mul_ediv_left _ _ (ne_of_gt (show 0 < -Dm i (i + 1) by linarith [(orient i).2]))]
    ring
  · ring

/-- The growth of S over one period. -/
def Gs (n : ℤ) : ℤ :=
  ∑ q : Fin 20 × Fin 16, (if (n - Cc q.1 q.2) % gc q.2 = 0 then mh q.2 + mk q.2 else 0)

theorem S_shift (n : ℤ) : S (n + 30) = S n + Gs n := by
  simp only [S, Gs, inner_shift, Finset.sum_add_distrib]

theorem Gs_periodic (x q : ℤ) : Gs (x + 30 * q) = Gs x := by
  simp only [Gs]
  refine Finset.sum_congr rfl (fun r _ => ?_)
  have e : x + 30 * q - Cc r.1 r.2 = (x - Cc r.1 r.2) + gc r.2 * (Lq r.2 * q) := by
    linear_combination q * (shift_ok r.2).1
  rw [e, Int.add_mul_emod_self_left]

/-! ## The period in natural numbers

On the line of facet i a piece length is (uh i c + vh)/dh i + (uk i c + vk)/dk i + 1 at level c. From
the window start, n = 16 + r with r < 30: the level is QQ - 0 + tauN with tauN = (PP + r) / gc i, on
the levels with gc i ∣ PP + r, and the two numerators plus dh i WH, dk i WK are the natural numbers
numH, numK (`piece_facts`, `inner_nat`). -/

def uhPV (k : ℕ) : ℕ := ctabN 1083326610 2 k

def uhMV (k : ℕ) : ℕ := ctabN 12232336023568 3 k

def ukPV (k : ℕ) : ℕ := ctabN 11270263291920 3 k

def ukMV (k : ℕ) : ℕ := ctabN 1083326610 2 k

def dhV (k : ℕ) : ℕ := ctabN 2785004013968839269 4 k

def dkV (k : ℕ) : ℕ := ctabN 2696075449069101654 4 k

def mhkV (k : ℕ) : ℕ := ctabN 31611 1 k

def uh (i : Fin 16) : ℤ := (uhPV i.val : ℤ) - uhMV i.val

def uk (i : Fin 16) : ℤ := (ukPV i.val : ℤ) - ukMV i.val

def dh (i : Fin 16) : ℤ := dhV i.val

def dk (i : Fin 16) : ℤ := dkV i.val

def tab_facetK : PLift (∀ i : Fin 16, uh i = gc i - ka i (i - 1) ∧ dh i = Dm i (i - 1) ∧ uk i = gc i - ka i (i + 1) ∧ dk i = -Dm i (i + 1) ∧ (mhkV i.val : ℤ) = mh i + mk i) :=
  ⟨by decide +kernel⟩

theorem tab_facet : ∀ i : Fin 16, uh i = gc i - ka i (i - 1) ∧ dh i = Dm i (i - 1) ∧ uk i = gc i - ka i (i + 1) ∧ dk i = -Dm i (i + 1) ∧ (mhkV i.val : ℤ) = mh i + mk i := tab_facetK.down

def PP (s i : ℕ) : ℕ := ctabN 4872811080405917403622542067038216590466595548275170672347937538819471668537512418987118479351459001174405023928721173023006335937651057562420977519206006746071379230500752869611339208769913110700256788583363285727700335908324021653972617387556574262943214515765783833516340141818298794112 3 (Nat.add i (Nat.mul 16 s))

def QQ (s i : ℕ) : ℕ := ctabN  4 (Nat.add i (Nat.mul 16 s))

def AH (s i : ℕ) : ℕ := ctabN  5 (Nat.add i (Nat.mul 16 s))

def AK (s i : ℕ) : ℕ := ctabN  6 (Nat.add i (Nat.mul 16 s))

def WH (s i : ℕ) : ℕ := ctabN  5 (Nat.add i (Nat.mul 16 s))

def WK (s i : ℕ) : ℕ := ctabN  4 (Nat.add i (Nat.mul 16 s))

/-- The constants of every piece at the window start, a natural-number check. -/
noncomputable def pieceOK : Bool :=
  allR 20 fun s => allR 16 fun i =>
    Nat.blt (PP s i) (gcV i) &&
    Nat.beq 24 (Nat.add (Nat.add (Nat.mul (gcV i) (QQ s i)) (PP s i)) (CW s i)) &&
    Nat.beq (Nat.add (Nat.add (Nat.add (Nat.add (AH s i) (Nat.mul (uhMV i) (QQ s i))) (CW s (prevF i))) (ehV i)) (Nat.mul (uhMV i) (LqV i)))
      (Nat.add (Nat.add (Nat.mul (uhPV i) (QQ s i)) (CW s i)) (Nat.mul (dhV i) (WH s i))) &&
    Nat.beq (Nat.add (Nat.add (Nat.add (Nat.add (AK s i) (Nat.mul (ukMV i) (QQ s i))) (CW s (nextF i))) (ekV i)) (Nat.mul (ukMV i) (LqV i)))
      (Nat.add (Nat.add (Nat.mul (ukPV i) (QQ s i)) (CW s i)) (Nat.mul (dkV i) (WK s i)))

def pieceOK_eqK : PLift (pieceOK = true) :=
  ⟨by decide +kernel⟩

theorem pieceOK_eq : pieceOK = true := pieceOK_eqK.down

theorem piece_facts (s : Fin 20) (i : Fin 16) :
    PP s.val i.val < gcV i.val ∧
    (16 : ℤ) - Cc s i = gc i * ((QQ s.val i.val : ℤ) - 0) + PP s.val i.val ∧
    (AH s.val i.val : ℤ) = uh i * ((QQ s.val i.val : ℤ) - 0) +
      (Cc s i - Cc s (i - 1) - (if i - 1 < i then 1 else 0)) + dh i * WH s.val i.val -
      (uhMV i.val : ℤ) * LqV i.val ∧
    (AK s.val i.val : ℤ) = uk i * ((QQ s.val i.val : ℤ) - 0) +
      (Cc s i - Cc s (i + 1) - (if i + 1 < i then 1 else 0)) + dk i * WK s.val i.val -
      (ukMV i.val : ℤ) * LqV i.val := by
  have h := (allR_iff _ _).1 ((allR_iff _ _).1 pieceOK_eq s.val s.isLt) i.val i.isLt
  simp only [Bool.and_eq_true, Nat.blt_eq, Nat.beq_eq, Nat.add_eq, Nat.mul_eq] at h
  obtain ⟨⟨⟨h1, h2⟩, h3⟩, h4⟩ := h
  obtain ⟨a1, a2⟩ := fin_prev i
  obtain ⟨b1, b2⟩ := fin_next i
  have c2 := congrArg (Nat.cast : ℕ → ℤ) h2
  have c3 := congrArg (Nat.cast : ℕ → ℤ) h3
  have c4 := congrArg (Nat.cast : ℕ → ℤ) h4
  push_cast at c2 c3 c4
  refine ⟨h1, ?_, ?_, ?_⟩
  · rw [C_W, show gc i = ((gcV i.val : ℕ) : ℤ) from rfl]
    linear_combination c2
  · rw [a2, C_W, C_W, a1, show uh i = (uhPV i.val : ℤ) - uhMV i.val from rfl,
      show dh i = ((dhV i.val : ℕ) : ℤ) from rfl]
    linear_combination c3
  · rw [b2, C_W, C_W, b1, show uk i = (ukPV i.val : ℤ) - ukMV i.val from rfl,
      show dk i = ((dkV i.val : ℕ) : ℤ) from rfl]
    linear_combination c4

/-- Piece (s, i) at n = 16 + r: the level step, whether the level has points, the two numerators
shifted by WH and WK, and the length plus WH + WK. -/
def tauN (s i r : ℕ) : ℕ := Nat.div (Nat.add (PP s i) r) (gcV i)

def divN (s i r : ℕ) : Bool := Nat.beq (Nat.mod (Nat.add (PP s i) r) (gcV i)) 0

def numH (s i r : ℕ) : ℕ :=
  Nat.add (Nat.add (AH s i) (Nat.mul (uhPV i) (tauN s i r))) (Nat.mul (uhMV i) (Nat.sub (LqV i) (tauN s i r)))

def numK (s i r : ℕ) : ℕ :=
  Nat.add (Nat.add (AK s i) (Nat.mul (ukPV i) (tauN s i r))) (Nat.mul (ukMV i) (Nat.sub (LqV i) (tauN s i r)))

def lenN (s i r : ℕ) : ℕ := Nat.add (Nat.add (Nat.div (numH s i r) (dhV i)) (Nat.div (numK s i r) (dkV i))) 1

def wN (s i : ℕ) : ℕ := Nat.add (WH s i) (WK s i)

/-- The length of piece (s, i) at 16 + r from its natural-number form. -/
def innerZ (s i r : ℕ) : ℤ := if divN s i r = true then (lenN s i r : ℤ) - (wN s i : ℤ) else 0

theorem ediv_shift (X : ℤ) (N W d : ℕ) (hd : 0 < d) (h : X + d * W = N) :
    X / d = ((N / d : ℕ) : ℤ) - W := by
  rw [Int.natCast_ediv, show X = (N : ℤ) + (-(W : ℤ)) * d by linear_combination h,
    Int.add_mul_ediv_right _ _ (by exact_mod_cast hd.ne')]
  ring

theorem div_nat (s : Fin 20) (i : Fin 16) (r : ℕ) :
    ((16 : ℤ) + r - Cc s i) % gc i = 0 ↔ divN s.val i.val r = true := by
  obtain ⟨-, hQ, -, -⟩ := piece_facts s i
  rw [show (16 : ℤ) + r - Cc s i = ((PP s.val i.val + r : ℕ) : ℤ) + gc i * ((QQ s.val i.val : ℤ) - 0) by
    push_cast; linear_combination hQ, Int.add_mul_emod_self_left]
  simp only [divN, Nat.beq_eq, Nat.add_eq, nmod]
  rw [show gc i = ((gcV i.val : ℕ) : ℤ) from rfl, ← Int.natCast_emod, Nat.cast_eq_zero]

theorem inner_nat (s : Fin 20) (i : Fin 16) (r : ℕ) (hr : r < 30) :
    inner s i ((16 : ℤ) + r) = innerZ s.val i.val r := by
  obtain ⟨hP, hQ, hAh, hAk⟩ := piece_facts s i
  obtain ⟨f1, f2, f3, f4, -⟩ := tab_facet i
  obtain ⟨o1, o2⟩ := orient i
  have hL : (30 : ℤ) = gc i * Lq i := (shift_ok i).1
  rw [inner, innerZ]
  by_cases hd : divN s.val i.val r = true
  · rw [if_pos ((div_nat s i r).2 hd), if_pos hd]
    have hg0 : 0 < gcV i.val := by
      have := (prim i).2.2.1
      rw [show gc i = ((gcV i.val : ℕ) : ℤ) from rfl] at this
      exact_mod_cast this
    have hd' : (PP s.val i.val + r) % gcV i.val = 0 := by
      simpa only [divN, Nat.beq_eq, Nat.add_eq, nmod] using hd
    have hτ : tauN s.val i.val r ≤ LqV i.val := by
      have h2 : 30 = gcV i.val * LqV i.val := by
        rw [show gc i = ((gcV i.val : ℕ) : ℤ) from rfl, show Lq i = ((LqV i.val : ℕ) : ℤ) from rfl] at hL
        exact_mod_cast hL
      simp only [tauN, Nat.add_eq, ndiv]
      apply Nat.lt_succ_iff.1
      rw [Nat.div_lt_iff_lt_mul hg0, Nat.succ_eq_add_one]
      nlinarith
    have hτg : ((PP s.val i.val : ℕ) : ℤ) + r = gc i * (tauN s.val i.val r : ℤ) := by
      have := Nat.mul_div_cancel' (Nat.dvd_of_mod_eq_zero hd')
      simp only [tauN, Nat.add_eq, ndiv]
      rw [show gc i = ((gcV i.val : ℕ) : ℤ) from rfl]
      exact_mod_cast this.symm
    have hl : lev s i ((16 : ℤ) + r) = ((QQ s.val i.val : ℤ) - 0) + tauN s.val i.val r := by
      rw [lev, show (16 : ℤ) + r - Cc s i = gc i * (((QQ s.val i.val : ℤ) - 0) + tauN s.val i.val r) by
        linear_combination hQ + hτg, Int.mul_ediv_cancel_left _ (ne_of_gt (prim i).2.2.1)]
    have hka : ka i (i - 1) = gc i - uh i := by linarith
    have hkb : ka i (i + 1) = gc i - uk i := by linarith
    have kh : Rb s i (i - 1) ((16 : ℤ) + r) + (dhV i.val : ℤ) * (WH s.val i.val : ℤ) =
        (numH s.val i.val r : ℤ) := by
      simp only [numH, Nat.add_eq, Nat.mul_eq, Nat.sub_eq]
      push_cast [Nat.cast_sub hτ]
      rw [Rb, hl, hka]
      simp only [uh, dh] at hAh ⊢
      linear_combination hQ + hτg - hAh
    have kk : Rb s i (i + 1) ((16 : ℤ) + r) + (dkV i.val : ℤ) * (WK s.val i.val : ℤ) =
        (numK s.val i.val r : ℤ) := by
      simp only [numK, Nat.add_eq, Nat.mul_eq, Nat.sub_eq]
      push_cast [Nat.cast_sub hτ]
      rw [Rb, hl, hkb]
      simp only [uk, dk] at hAk ⊢
      linear_combination hQ + hτg - hAk
    have dh0 : 0 < dhV i.val := by
      have : (0 : ℤ) < dhV i.val := by rw [show ((dhV i.val : ℕ) : ℤ) = dh i from rfl, f2]; exact o1
      exact_mod_cast this
    have dk0 : 0 < dkV i.val := by
      have : (0 : ℤ) < dkV i.val := by rw [show ((dkV i.val : ℕ) : ℤ) = dk i from rfl, f4]; linarith
      exact_mod_cast this
    rw [hi, lo, ← f2, ← f4, show dh i = ((dhV i.val : ℕ) : ℤ) from rfl,
      show dk i = ((dkV i.val : ℕ) : ℤ) from rfl, ediv_shift _ _ _ _ dh0 kh, ediv_shift _ _ _ _ dk0 kk]
    simp only [lenN, wN, Nat.add_eq, ndiv]
    push_cast
    ring
  · rw [if_neg (fun h => hd ((div_nat s i r).1 h)), if_neg hd]

def dtabV (k : ℕ) : ℕ := ctabN 732013653718633000 6 k

def tblV (k : ℕ) : ℕ := ctabN 951018771206206735 6 k

def initV (k : ℕ) : ℕ := ctabN 43073 4 k

/-- The step of the closed form at residue t mod 10. -/
def dv (t : ℕ) : ℕ := dtabV (t % 10)

/-- The sequence in closed form: b(n + 10) = b(n) + dv (n - 4) for n ≥ 4. -/
def b (n : ℕ) : ℕ :=
  if n < 4 then initV n else dv (n - 4) * ((n - 4) / 10) + tblV ((n - 4) % 10)

theorem b_step (n : ℕ) (hn : 4 ≤ n) : b (n + 10) = b n + dv (n - 4) := by
  rw [b, b, if_neg (show ¬ (n + 10 < 4) by omega), if_neg (show ¬ (n < 4) by omega),
    show n + 10 - 4 = n - 4 + 10 by omega, dv, dv, Nat.add_mod_right,
    Nat.add_div_right _ (by norm_num : 0 < 10)]
  ring

theorem b_shift (n : ℕ) (hn : 4 ≤ n) : b (n + 30) = b n + 3 * dv (n - 4) := by
  rw [b, b, if_neg (show ¬ (n + 30 < 4) by omega), if_neg (show ¬ (n < 4) by omega),
    show n + 30 - 4 = n - 4 + 10 * 3 by omega, dv, dv, Nat.add_mul_mod_self_left,
    Nat.add_mul_div_left _ _ (by norm_num : 0 < 10)]
  ring

/-- b on the residue class of 4 + j mod 10. -/
theorem b_res (k j : ℕ) (hj : j < 10) : b (10 * k + (4 + j)) = dv j * k + tblV j := by
  rw [b, if_neg (show ¬ (10 * k + (4 + j) < 4) by omega),
    show 10 * k + (4 + j) - 4 = j + 10 * k by omega, dv, dv, Nat.add_mul_mod_self_left,
    Nat.add_mul_div_left _ _ (by norm_num : 0 < 10), Nat.mod_eq_of_lt hj, Nat.div_eq_of_lt hj]
  ring

/-- The window at n = 16 + r: every piece length is nonnegative, the closed form agrees with b, and
the growth over 30 terms agrees with the steps. -/
noncomputable def periodR (r : ℕ) : Bool :=
  (allR 20 fun s => allR 16 fun i => !divN s i r || Nat.ble (wN s i) (lenN s i r)) &&
    Nat.beq (sumR 20 fun s => sumR 16 fun i => cond (divN s i r) (Nat.sub (lenN s i r) (wN s i)) 0)
      (b (Nat.add 16 r)) &&
    Nat.beq (sumR 20 fun s => sumR 16 fun i => cond (divN s i r) (mhkV i) 0)
      (Nat.mul 3 (dv (Nat.add 12 r)))

/-! The window n = 16, ..., 45, checked by the kernel in pieces of consecutive levels. -/

def periodK0 : PLift (allI 0 4 periodR = true) :=
  ⟨by decide +kernel⟩

def periodK1 : PLift (allI 4 4 periodR = true) :=
  ⟨by decide +kernel⟩

def periodK2 : PLift (allI 8 4 periodR = true) :=
  ⟨by decide +kernel⟩

def periodK3 : PLift (allI 12 4 periodR = true) :=
  ⟨by decide +kernel⟩

def periodK4 : PLift (allI 16 4 periodR = true) :=
  ⟨by decide +kernel⟩

def periodK5 : PLift (allI 20 4 periodR = true) :=
  ⟨by decide +kernel⟩

def periodK6 : PLift (allI 24 4 periodR = true) :=
  ⟨by decide +kernel⟩

def periodK7 : PLift (allI 28 2 periodR = true) :=
  ⟨by decide +kernel⟩

theorem period_facts (r : ℕ) (hr : r < 30) :
    (∀ s, s < 20 → ∀ i, i < 16 → divN s i r = true → wN s i ≤ lenN s i r) ∧
    (sumR 20 fun s => sumR 16 fun i => cond (divN s i r) (lenN s i r - wN s i) 0) = b (16 + r) ∧
    (sumR 20 fun s => sumR 16 fun i => cond (divN s i r) (mhkV i) 0) = 3 * dv (12 + r) := by
  have h : periodR r = true := by
    rcases (show r < 4 ∨ (4 ≤ r ∧ r < 8) ∨ (8 ≤ r ∧ r < 12) ∨ (12 ≤ r ∧ r < 16) ∨ (16 ≤ r ∧ r < 20) ∨ (20 ≤ r ∧ r < 24) ∨ (24 ≤ r ∧ r < 28) ∨ 28 ≤ r by omega) with h | h | h | h | h | h | h | h
    · exact allI_get _ _ _ periodK0.down r (by omega) (by omega)
    · exact allI_get _ _ _ periodK1.down r (by omega) (by omega)
    · exact allI_get _ _ _ periodK2.down r (by omega) (by omega)
    · exact allI_get _ _ _ periodK3.down r (by omega) (by omega)
    · exact allI_get _ _ _ periodK4.down r (by omega) (by omega)
    · exact allI_get _ _ _ periodK5.down r (by omega) (by omega)
    · exact allI_get _ _ _ periodK6.down r (by omega) (by omega)
    · exact allI_get _ _ _ periodK7.down r (by omega) (by omega)
  simp only [periodR, Bool.and_eq_true, Nat.beq_eq, Nat.add_eq, Nat.mul_eq, Nat.sub_eq] at h
  obtain ⟨⟨h1, h2⟩, h3⟩ := h
  refine ⟨fun s hs i hi hd => ?_, h2, h3⟩
  have h4 := (allR_iff _ _).1 ((allR_iff _ _).1 h1 s hs) i hi
  rw [hd] at h4
  simpa using h4

theorem innerZ_eq (s i r : ℕ) (hs : s < 20) (hi : i < 16) (hr : r < 30) :
    innerZ s i r = ((cond (divN s i r) (lenN s i r - wN s i) 0 : ℕ) : ℤ) := by
  rw [innerZ]
  cases hd : divN s i r
  · simp
  · rw [if_pos rfl, cond_true, Nat.cast_sub ((period_facts r hr).1 s hs i hi hd)]

theorem sumR2 (f : ℕ → ℕ → ℕ) :
    ((sumR 20 fun s => sumR 16 fun i => f s i : ℕ) : ℤ) = ∑ q : Fin 20 × Fin 16, (f q.1.val q.2.val : ℤ) := by
  rw [Fintype.sum_prod_type, sumR_eq, Nat.cast_sum,
    ← Fin.sum_univ_eq_sum_range (fun s => ((sumR 16 fun i => f s i : ℕ) : ℤ)) 20]
  refine Finset.sum_congr rfl (fun s _ => ?_)
  rw [sumR_eq, Nat.cast_sum, ← Fin.sum_univ_eq_sum_range (fun i => (f s.val i : ℤ)) 16]

theorem S_window (r : ℕ) (hr : r < 30) : S ((16 : ℤ) + r) = b (16 + r) := by
  have h := congrArg (Nat.cast : ℕ → ℤ) (period_facts r hr).2.1
  rw [sumR2] at h
  rw [← h, S]
  refine Finset.sum_congr rfl (fun q _ => ?_)
  rw [inner_nat q.1 q.2 r hr, innerZ_eq _ _ _ q.1.isLt q.2.isLt hr]

theorem Gs_window (r : ℕ) (hr : r < 30) : Gs ((16 : ℤ) + r) = ((3 * dv (12 + r) : ℕ) : ℤ) := by
  have h := congrArg (Nat.cast : ℕ → ℤ) (period_facts r hr).2.2
  rw [sumR2] at h
  rw [← h, Gs]
  refine Finset.sum_congr rfl (fun q _ => ?_)
  rcases Bool.eq_false_or_eq_true (divN q.1.val q.2.val r) with hd | hd
  · rw [if_pos ((div_nat q.1 q.2 r).2 hd), hd, cond_true, (tab_facet q.2).2.2.2.2]
  · rw [if_neg (fun h' => by
      have := (div_nat q.1 q.2 r).1 h'
      rw [hd] at this
      exact Bool.noConfusion this), hd]
    rfl

/-- Every piece length is nonnegative from n = 16 on: checked on one period, then shifted. -/
theorem inner_nonneg (s : Fin 20) (i : Fin 16) (n : ℤ) (hn : 16 ≤ n) : 0 ≤ inner s i n := by
  obtain ⟨t, rfl⟩ : ∃ t : ℕ, n = 16 + t := ⟨(n - 16).toNat, by omega⟩
  induction t using Nat.strong_induction_on with
  | _ t ih =>
    by_cases ht : t < 30
    · rw [inner_nat s i t ht, innerZ_eq _ _ _ s.isLt i.isLt ht]
      exact Nat.cast_nonneg _
    · have := ih (t - 30) (by omega) (by omega)
      have e : (16 : ℤ) + t = (16 + (t - 30 : ℕ)) + 30 := by
        push_cast [Nat.cast_sub (by omega : 30 ≤ t)]; ring
      rw [e, inner_shift]
      have hpos : 0 ≤ mh i + mk i := by
        rw [← (tab_facet i).2.2.2.2]
        exact Nat.cast_nonneg _
      split_ifs <;> linarith

theorem cnt_eq_S (n : ℤ) (hn : 16 ≤ n) : (cnt n : ℤ) = S n := by
  rw [cnt_eq_sum, S, Nat.cast_sum]
  refine Finset.sum_congr rfl (fun p _ => ?_)
  rw [card_piece p.1 p.2 n hn]
  exact Int.toNat_of_nonneg (inner_nonneg p.1 p.2 n hn)

/-- The growth of b over 30 terms is that of S, from the window by periodicity. -/
theorem grow (n : ℕ) (hn : 16 ≤ n) : (3 : ℤ) * (dv (n - 4) : ℤ) = Gs n := by
  have hr : (n - 16) % 30 < 30 := Nat.mod_lt _ (by norm_num)
  have e1 : (n : ℤ) = ((16 : ℤ) + (((n - 16) % 30 : ℕ) : ℤ)) + 30 * (((n - 16) / 30 : ℕ) : ℤ) := by
    omega
  have e2 : dv (n - 4) = dv (12 + (n - 16) % 30) := by
    simp only [dv]
    congr 1
    omega
  rw [e1, Gs_periodic, Gs_window _ hr, e2]
  push_cast
  ring

theorem S_eq_b (n : ℕ) (hn : 16 ≤ n) : S n = b n := by
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    by_cases h : n < 46
    · obtain ⟨r, rfl⟩ : ∃ r, n = 16 + r := ⟨n - 16, by omega⟩
      push_cast
      exact S_window r (by omega)
    · have h1 := ih (n - 30) (by omega) (by omega)
      have h2 := S_shift ((n - 30 : ℕ) : ℤ)
      have h3 := b_shift (n - 30) (by omega)
      have h4 := grow (n - 30) (by omega)
      rw [show n - 30 + 30 = n by omega] at h3
      rw [show ((n - 30 : ℕ) : ℤ) + 30 = n by omega] at h2
      rw [h2, h1, h3]
      push_cast
      linarith

/-! ## The small spheres

The points with F ≤ 15 lie in the box -4 ≤ x ≤ 4, -4 ≤ y ≤ 4 (`small_box`). In natural-number
coordinates a = x + 4, b = y + 4 every potential is PtN - NtN (`pot_box`), so F is their largest
difference FN (`F_FN`), and the kernel counts the box points on each level (`smallOK`). -/

theorem small_box (x y : ℤ) (s : Fin 20) (h : F (x, y, s) ≤ 15) :
    -4 ≤ x ∧ x ≤ 4 ∧ -4 ≤ y ∧ y ≤ 4 := by
  obtain ⟨b1, b2, b3, b4⟩ := coord_le x y s
  omega

/-- Potential i at the box point ((a : ℤ) - 4, (b : ℤ) - 4, s) is PtN i a b s - NtN i a b. -/
def PtN (i a b s : ℕ) : ℕ := Nat.add (Nat.add (Nat.add (Nat.mul (AW i) a) 64) (Nat.mul (BW i) b)) (CW s i)

def NtN (i a b : ℕ) : ℕ := Nat.add (Nat.add (Nat.add (Nat.mul (AW i) 4) (Nat.mul (BW i) 4)) 8) (Nat.add (Nat.mul 8 a) (Nat.mul 8 b))

theorem pot_box (a b : ℕ) (s : Fin 20) (i : Fin 16) :
    pot ((a : ℤ) - 4, (b : ℤ) - 4, s) i = (PtN i.val a b s.val : ℤ) - NtN i.val a b := by
  simp only [pot, PtN, NtN, A_W, B_W, C_W, Nat.add_eq, Nat.mul_eq]
  push_cast
  ring

/-- F at the box point (a, b, s), in natural numbers. -/
noncomputable def FN (a b s : ℕ) : ℕ := maxR 16 fun i => Nat.sub (PtN i a b s) (NtN i a b)

theorem F_FN (a b : ℕ) (s : Fin 20) : F ((a : ℤ) - 4, (b : ℤ) - 4, s) = (FN a b s.val : ℤ) := by
  have h0 := F_nonneg ((a : ℤ) - 4, (b : ℤ) - 4, s)
  simp only [FN, Nat.sub_eq]
  apply le_antisymm
  · obtain ⟨k, hk⟩ := F_attained ((a : ℤ) - 4, (b : ℤ) - 4, s)
    have h1 := pot_box a b s k
    have h2 := le_maxR 16 (fun i => PtN i a b s.val - NtN i a b) k.val k.isLt
    omega
  · have h3 : (maxR 16 fun i => PtN i a b s.val - NtN i a b) ≤
        (F ((a : ℤ) - 4, (b : ℤ) - 4, s)).toNat := by
      apply maxR_le
      intro k hk
      have h1 : pot ((a : ℤ) - 4, (b : ℤ) - 4, s) ⟨k, hk⟩ = (PtN k a b s.val : ℤ) - NtN k a b :=
        pot_box a b s ⟨k, hk⟩
      have h2 := le_F ((a : ℤ) - 4, (b : ℤ) - 4, s) ⟨k, hk⟩
      omega
    omega

/-- The number of box points with FN = f. -/
noncomputable def cntB (f : ℕ) : ℕ :=
  sumR 9 fun a => sumR 9 fun b => sumR 20 fun s => cond (Nat.beq (FN a b s) f) 1 0

/-- The small sphere f agrees with b. -/
noncomputable def smallR (f : ℕ) : Bool := Nat.beq (cntB f) (b f)

/-! The small spheres 4 .. 15, checked by the kernel in pieces of consecutive levels. -/

def smallK0 : PLift (allI 4 12 smallR = true) :=
  ⟨by decide +kernel⟩

theorem small_eq (n : ℕ) (h1 : 4 ≤ n) (h2 : n < 16) : cntB n = b n := by
  have h : smallR n = true := by
    exact allI_get _ _ _ smallK0.down n (by omega) (by omega)
  simpa only [smallR, Nat.beq_eq] using h

/-- The box points by natural-number coordinates. -/
def ib (q : ℕ × ℕ × Fin 20) : V := ((q.1 : ℤ) - 4, (q.2.1 : ℤ) - 4, q.2.2)

theorem ib_inj : Function.Injective ib := by
  rintro ⟨a, b, s⟩ ⟨a', b', s'⟩ h
  simp only [ib, Prod.mk.injEq] at h
  obtain ⟨h1, h2, rfl⟩ := h
  have e1 : a = a' := by omega
  have e2 : b = b' := by omega
  rw [e1, e2]

theorem cnt_small (f : ℕ) (hf : f ≤ 15) : cnt f = cntB f := by
  have hs : {v : V | F v = (f : ℤ)} = ↑(((Finset.range 9 ×ˢ (Finset.range 9 ×ˢ Finset.univ)).filter
      (fun q : ℕ × ℕ × Fin 20 => FN q.1 q.2.1 q.2.2.val = f)).image ib) := by
    ext ⟨x, y, s⟩
    simp only [Set.mem_ofPred_eq, Finset.coe_image, Finset.coe_filter, Set.mem_image, Finset.mem_product,
      Finset.mem_range, Finset.mem_univ, and_true, Prod.exists]
    constructor
    · intro h
      obtain ⟨hx1, hx2, hy1, hy2⟩ := small_box x y s (by omega)
      refine ⟨(x + 4).toNat, (y + 4).toNat, s, ⟨⟨by omega, by omega⟩, ?_⟩, ?_⟩
      · have e := F_FN (x + 4).toNat (y + 4).toNat s
        rw [show (((x + 4).toNat : ℕ) : ℤ) - 4 = x by omega,
          show (((y + 4).toNat : ℕ) : ℤ) - 4 = y by omega, h] at e
        exact_mod_cast e.symm
      · simp only [ib, Prod.mk.injEq]
        exact ⟨by omega, by omega, by trivial⟩
    · rintro ⟨a, b, s', ⟨-, hF⟩, he⟩
      rw [← he, ib, F_FN, hF]
  rw [cnt, hs, Set.ncard_coe_finset, Finset.card_image_of_injective _ ib_inj, Finset.card_filter,
    Finset.sum_product, cntB, sumR_eq]
  refine Finset.sum_congr rfl (fun a _ => ?_)
  rw [Finset.sum_product, sumR_eq]
  refine Finset.sum_congr rfl (fun b _ => ?_)
  rw [sumR_eq, ← Fin.sum_univ_eq_sum_range (fun s => cond (Nat.beq (FN a b s) f) 1 0) 20]
  refine Finset.sum_congr rfl (fun s _ => ?_)
  dsimp only
  cases h : Nat.beq (FN a b s.val) f
  · rw [if_neg (Nat.ne_of_beq_eq_false h)]
    rfl
  · rw [if_pos (Nat.eq_of_beq_eq_true h)]
    rfl

/-! ## The coordination sequence

`a n` counts the level set F = n from n = 4 on (`a_eq_cnt`, from `a_eq_F`), and `small_vals`
lists the terms below 4. The terms from 4 to 15 are counted in the box, those from 16 on
are S(n), and all agree with the closed form b (`a_eq_b`). The step from n to n + 10, the closed form
per residue (`a_closed`), the controls, the recurrence and the g.f. follow, their base cases checked by
the kernel on b. -/

theorem a_eq_cnt (n : ℕ) (hn : 4 ≤ n) : a n = cnt n := by
  rw [a_eq_F n hn, cnt]
  congr 1
  ext v
  simp only [Set.mem_ofPred_eq]
  have := F_nonneg v
  omega

theorem a_eq_S (n : ℕ) (hn : 16 ≤ n) : (a n : ℤ) = S n := by
  rw [a_eq_cnt n (by omega)]
  exact cnt_eq_S n (by exact_mod_cast hn)

def smallR0K : PLift ((List.range 4).map b = [1, 4, 8, 10]) :=
  ⟨by decide +kernel⟩

theorem a_lt_R0 (n : ℕ) (hn : n < 4) : a n = b n := by
  have h : (List.range 4).map a = (List.range 4).map b := by
    rw [small_vals]
    exact smallR0K.down.symm
  exact List.map_inj_left.1 h n (List.mem_range.2 hn)

/-- The coordination sequence in closed form. -/
theorem a_eq_b (n : ℕ) : a n = b n := by
  rcases (show n < 4 ∨ (4 ≤ n ∧ n < 16) ∨ 16 ≤ n by omega) with h | ⟨h1, h2⟩ | h
  · exact a_lt_R0 n h
  · rw [a_eq_cnt n h1, cnt_small _ (by omega)]
    exact small_eq n h1 h2
  · have h1 := a_eq_S n h
    rw [S_eq_b n h] at h1
    exact_mod_cast h1

def dconst_baseK : PLift (∀ r : ℕ, r < 10 → dtabV r = 40) :=
  ⟨by decide +kernel⟩

theorem dconst_base : ∀ r : ℕ, r < 10 → dtabV r = 40 := dconst_baseK.down

theorem dv_const : ∀ t : ℕ, dv t = 40 := by
  intro t
  rw [dv]
  exact dconst_base _ (Nat.mod_lt _ (by norm_num))

/-- The step a(n + 10) = a(n) + 40 for n ≥ 4. -/
theorem a_step (n : ℕ) (hn : 4 ≤ n) : a (n + 10) = a n + 40 := by
  rw [a_eq_b, a_eq_b, b_step n hn, dv_const]

/-! The steps and the values on one period, by the kernel in pieces of 8 residues, and the closed form
per residue on each piece. -/

def closedK0 : PLift (dv 0 = 40 ∧ tblV 0 = 15 ∧ dv 1 = 40 ∧ tblV 1 = 20 ∧ dv 2 = 40 ∧ tblV 2 = 23 ∧ dv 3 = 40 ∧ tblV 3 = 30 ∧ dv 4 = 40 ∧ tblV 4 = 32 ∧ dv 5 = 40 ∧ tblV 5 = 34 ∧ dv 6 = 40 ∧ tblV 6 = 40 ∧ dv 7 = 40 ∧ tblV 7 = 44) :=
  ⟨by decide +kernel⟩

def closedK1 : PLift (dv 8 = 40 ∧ tblV 8 = 50 ∧ dv 9 = 40 ∧ tblV 9 = 52) :=
  ⟨by decide +kernel⟩

theorem a_closed0 (k : ℕ) :
    a (10 * k + 4) = 40 * k + 15 ∧
    a (10 * k + 5) = 40 * k + 20 ∧
    a (10 * k + 6) = 40 * k + 23 ∧
    a (10 * k + 7) = 40 * k + 30 ∧
    a (10 * k + 8) = 40 * k + 32 ∧
    a (10 * k + 9) = 40 * k + 34 ∧
    a (10 * k + 10) = 40 * k + 40 ∧
    a (10 * k + 11) = 40 * k + 44 := by
  obtain ⟨c0, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14, c15⟩ := closedK0.down
  simp only [a_eq_b]
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [show 10 * k + 4 = 10 * k + (4 + 0) from rfl, b_res k 0 (by decide), c0, c1]
  · rw [show 10 * k + 5 = 10 * k + (4 + 1) from rfl, b_res k 1 (by decide), c2, c3]
  · rw [show 10 * k + 6 = 10 * k + (4 + 2) from rfl, b_res k 2 (by decide), c4, c5]
  · rw [show 10 * k + 7 = 10 * k + (4 + 3) from rfl, b_res k 3 (by decide), c6, c7]
  · rw [show 10 * k + 8 = 10 * k + (4 + 4) from rfl, b_res k 4 (by decide), c8, c9]
  · rw [show 10 * k + 9 = 10 * k + (4 + 5) from rfl, b_res k 5 (by decide), c10, c11]
  · rw [show 10 * k + 10 = 10 * k + (4 + 6) from rfl, b_res k 6 (by decide), c12, c13]
  · rw [show 10 * k + 11 = 10 * k + (4 + 7) from rfl, b_res k 7 (by decide), c14, c15]

theorem a_closed1 (k : ℕ) :
    a (10 * k + 12) = 40 * k + 50 ∧
    a (10 * k + 13) = 40 * k + 52 := by
  obtain ⟨c16, c17, c18, c19⟩ := closedK1.down
  simp only [a_eq_b]
  refine ⟨?_, ?_⟩
  · rw [show 10 * k + 12 = 10 * k + (4 + 8) from rfl, b_res k 8 (by decide), c16, c17]
  · rw [show 10 * k + 13 = 10 * k + (4 + 9) from rfl, b_res k 9 (by decide), c18, c19]

/-- The closed form per residue of n mod 10, for n ≥ 4. -/
theorem a_closed (k : ℕ) :
    a (10 * k + 4) = 40 * k + 15 ∧
    a (10 * k + 5) = 40 * k + 20 ∧
    a (10 * k + 6) = 40 * k + 23 ∧
    a (10 * k + 7) = 40 * k + 30 ∧
    a (10 * k + 8) = 40 * k + 32 ∧
    a (10 * k + 9) = 40 * k + 34 ∧
    a (10 * k + 10) = 40 * k + 40 ∧
    a (10 * k + 11) = 40 * k + 44 ∧
    a (10 * k + 12) = 40 * k + 50 ∧
    a (10 * k + 13) = 40 * k + 52 := by
  obtain ⟨x0, x1, x2, x3, x4, x5, x6, x7⟩ := a_closed0 k
  obtain ⟨x8, x9⟩ := a_closed1 k
  exact ⟨x0, x1, x2, x3, x4, x5, x6, x7, x8, x9⟩

def controlsK : PLift ((List.range 50).map b = [1, 4, 8, 10, 15, 20, 23, 30, 32, 34, 40, 44, 50, 52, 55, 60, 63, 70, 72, 74, 80, 84, 90, 92, 95, 100, 103, 110, 112, 114, 120, 124, 130, 132, 135, 140, 143, 150, 152, 154, 160, 164, 170, 172, 175, 180, 183, 190, 192, 194]) :=
  ⟨by decide +kernel⟩

/-- Controls: the entry's data a(0..49). -/
theorem controls : (List.range 50).map a =
    [1, 4, 8, 10, 15, 20, 23, 30, 32, 34, 40, 44, 50, 52, 55, 60, 63, 70, 72, 74, 80, 84, 90, 92, 95, 100, 103, 110, 112, 114, 120, 124, 130, 132, 135, 140, 143, 150, 152, 154, 160, 164, 170, 172, 175, 180, 183, 190, 192, 194] := by
  rw [show a = b from funext a_eq_b]
  exact controlsK.down

/-! The steps satisfy the recurrence, on one period of the residues (negative terms moved across). -/

def drec_baseK : PLift (∀ t : ℕ, t < 10 → dv (t + 10) + 2 * dv (t + 8) + 2 * dv (t + 6) + 2 * dv (t + 4) + 2 * dv (t + 2) + dv (t + 0) = 2 * dv (t + 9) + 2 * dv (t + 7) + 2 * dv (t + 5) + 2 * dv (t + 3) + 2 * dv (t + 1)) :=
  ⟨by decide +kernel⟩

theorem drec_base : ∀ t : ℕ, t < 10 → dv (t + 10) + 2 * dv (t + 8) + 2 * dv (t + 6) + 2 * dv (t + 4) + 2 * dv (t + 2) + dv (t + 0) = 2 * dv (t + 9) + 2 * dv (t + 7) + 2 * dv (t + 5) + 2 * dv (t + 3) + 2 * dv (t + 1) := drec_baseK.down

theorem drec (t : ℕ) : (dv (t + 10) : ℤ) = 2 * (dv (t + 9) : ℤ) - 2 * (dv (t + 8) : ℤ) + 2 * (dv (t + 7) : ℤ) - 2 * (dv (t + 6) : ℤ) + 2 * (dv (t + 5) : ℤ) - 2 * (dv (t + 4) : ℤ) + 2 * (dv (t + 3) : ℤ) - 2 * (dv (t + 2) : ℤ) + 2 * (dv (t + 1) : ℤ) - (dv (t + 0) : ℤ) := by
  have e : ∀ o : ℕ, dv (t + o) = dv (t % 10 + o) := fun o => by
    rw [dv, dv, Nat.mod_add_mod]
