theorem gap_bound (n : ℕ) (h : check n = true) : OeisA53000.a n ≤ 1 + n.totient := by
  unfold check at h
  simp only [Bool.and_eq_true, decide_eq_true_eq] at h
  obtain ⟨⟨⟨pos, bound⟩, hp⟩, ht⟩ := h
  have prime := primeCheck_sound (n^2 + offset n) bound hp
  have tot := totientCheck_sound n (offset n) ht
  have le : sInf {p : ℕ | Nat.Prime p ∧ n^2 < p} ≤ n^2 + offset n :=
    Nat.sInf_le ⟨prime, by omega⟩
  unfold OeisA53000.a
  omega

end SquarePrimeGap

theorem OMA.solution : OMA.R_OeisA53000_conjecture_R1.H1 := by
  intro n hn hi
  let b : Fin 100 := ⟨(n-1)/100, by omega⟩
  have passes := SquarePrimeGap.batches b
  have hi' : (n-1)%100 ∈ List.range 100 := List.mem_range.mpr (Nat.mod_lt _ (by decide))
  have pass := List.all_eq_true.mp passes _ hi'
  have address : 100*b.val + (n-1)%100 + 1 = n := by dsimp [b]; omega
  apply SquarePrimeGap.gap_bound
  simpa only [address] using pass
