def offset (n : ℕ) : ℕ :=
  let i := n - 1
  (offsetBlocks[i / 100]?.getD 0 >>> (8 * (i % 100))) % 256

def check (n : ℕ) : Bool :=
  let d := offset n
  let p := n^2 + d
  ((decide (0 < d) && decide (p ≤ 100020001)) && primeCheck p) && totientCheck n d

def checkBlock (b : ℕ) : Bool :=
  (List.range 100).all fun i => check (100*b+i+1)



