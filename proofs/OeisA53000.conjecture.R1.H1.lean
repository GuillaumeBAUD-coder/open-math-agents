import OMAReductions.R_OeisA53000_conjecture_R1
import Mathlib

-- Credit: @jacklarmer.
-- An offset supplies a prime strictly above each square. The proof needs only an
-- upper bound on the first prime, so it suffices to certify that one witness.
namespace SquarePrimeGap



/-- Least common multiple of the positive integers through 10001. -/
def trialMultiple : ℕ := 

def trialDivisors : ℕ → Bool
  | 0 => true
  | k + 1 => (trialMultiple % (k + 1) == 0) && trialDivisors k

lemma trialDivisors_sound {k d : ℕ} (ck : trialDivisors k = true)
    (hd : 0 < d) (le : d ≤ k) : d ∣ trialMultiple := by
  induction k with
  | zero => omega
  | succ k ih =>
    simp only [trialDivisors, Bool.and_eq_true, beq_iff_eq] at ck
    rcases Nat.eq_or_lt_of_le le with rfl | h
    · exact Nat.dvd_of_mod_eq_zero ck.1
    · exact ih ck.2 (by omega)

set_option maxRecDepth 100000 in
set_option maxHeartbeats 5000000 in
lemma trialDivisors_checked : trialDivisors 10001 = true := by decide +kernel

def primeCheck (p : ℕ) : Bool :=
  if p ≤ 10001 then decide p.Prime else decide (p.gcd trialMultiple = 1)

lemma primeCheck_sound (p : ℕ) (bound : p ≤ 100020001)
    (test : primeCheck p = true) : p.Prime := by
  by_cases h : p ≤ 10001
  · simpa [primeCheck, h] using test
  · have gcd_one : p.gcd trialMultiple = 1 := by simpa [primeCheck, h] using test
    by_contra not_prime
    have hf := Nat.minFac_sq_le_self (by omega : 0 < p) not_prime
    have small : p.minFac ≤ 10001 := by
      by_contra! large
      have hsq := Nat.pow_le_pow_left (by omega : 10002 ≤ p.minFac) 2
      omega
    have divides := Nat.dvd_gcd (Nat.minFac_dvd p)
      (trialDivisors_sound trialDivisors_checked (Nat.minFac_pos p) small)
    rw [gcd_one] at divides
    have one := Nat.dvd_one.mp divides
    have two := (Nat.minFac_prime (by omega : p ≠ 1)).two_le
    omega

def coprimeCount (n : ℕ) : ℕ → ℕ
  | 0 => 0
  | k + 1 => coprimeCount n k + if n.gcd k = 1 then 1 else 0

theorem coprimeCount_eq (n k : ℕ) :
    coprimeCount n k = Nat.count (n.Coprime ·) k := by
  induction k with
  | zero => simp [coprimeCount]
  | succ k ih => rw [coprimeCount, ih, Nat.count_succ]

def totientCheck (n d : ℕ) : Bool := decide (d ≤ 1 + coprimeCount n (min n (5 * d)))

theorem totientCheck_sound (n d : ℕ)
    (hc : totientCheck n d = true) : d ≤ 1 + n.totient := by
  have h : d ≤ 1 + coprimeCount n (min n (5 * d)) := of_decide_eq_true hc
  apply h.trans
  apply Nat.add_le_add_left
  rw [coprimeCount_eq, Nat.totient_eq_card_coprime, ← Nat.count_eq_card_filter_range]
  exact Nat.count_monotone _ (min_le_left _ _)

