theorem upZ (N k : ℕ) (hk : k ≤ N + 1) :
    (((N + 1).choose k : ℕ) : ℤ) * ((N : ℤ) + 1 - k) = ((N.choose k : ℕ) : ℤ) * ((N : ℤ) + 1) := by
  have h := Nat.choose_mul_succ_eq N k
  have h' : ((N.choose k * (N + 1) : ℕ) : ℤ) = (((N + 1).choose k * (N + 1 - k) : ℕ) : ℤ) := by
    exact_mod_cast h
  push_cast [Nat.cast_sub hk] at h'
  linear_combination -h'

theorem rightZ (N k : ℕ) (hk : k ≤ N) :
    ((N.choose (k + 1) : ℕ) : ℤ) * ((k : ℤ) + 1) = ((N.choose k : ℕ) : ℤ) * ((N : ℤ) - k) := by
  have h := Nat.choose_succ_right_eq N k
  have h' : ((N.choose (k + 1) * (k + 1) : ℕ) : ℤ) = ((N.choose k * (N - k) : ℕ) : ℤ) := by
    exact_mod_cast h
  push_cast [Nat.cast_sub hk] at h'
  linear_combination h'

/-- The summand of the recurrence for S. -/
def t (n k : ℕ) : ℤ :=
  (4 * ((n : ℤ) + 2) * (17 * (n : ℤ) + 11) * (2 * (n : ℤ) + 3)) * (((n + 2).choose k : ℕ) : ℤ) * (((2 * n + k + 4).choose k : ℕ) : ℤ) +
    (-1207 * ((n : ℤ) + 2) ^ 3 + 2840 * ((n : ℤ) + 2) ^ 2 - 1897 * ((n : ℤ) + 2) + 360) * (((n + 1).choose k : ℕ) : ℤ) * (((2 * n + k + 2).choose k : ℕ) : ℤ) +
    (2 * (17 * (n : ℤ) + 28) * (2 * (n : ℤ) + 1) * ((n : ℤ) + 1)) * ((n.choose k : ℕ) : ℤ) * (((2 * n + k).choose k : ℕ) : ℤ)

/-- The certificate. -/
def H (n j : ℕ) : ℤ :=
  Qf (n : ℤ) ((j : ℤ) + 1) * (((n + 1).choose j : ℕ) : ℤ) * (((2 * n + j + 1).choose j : ℕ) : ℤ)

set_option maxRecDepth 20000 in
set_option maxHeartbeats 4000000 in
theorem pw (n j : ℕ) (hj : j ≤ n + 1) :
    (((n : ℤ) + 1) * (2 * (n : ℤ) + 4) * (2 * (n : ℤ) + 3) * (2 * (n : ℤ) + 2)) * t n (j + 1) = H n (j + 1) - H n j := by
  have hf : ((j : ℤ) + 1) ^ 2 * (((n : ℤ) + 1) * (2 * (n : ℤ) + 4) * (2 * (n : ℤ) + 3) *
      (2 * (n : ℤ) + 2) * (2 * (n : ℤ) + 1)) ≠ 0 := by positivity
  have ra1 := rightZ (n + 1) j hj
  have ra0 : ((n.choose (j + 1) : ℕ) : ℤ) * ((n : ℤ) + 1) =
      (((n + 1).choose (j + 1) : ℕ) : ℤ) * ((n : ℤ) - j) := by
    rcases Nat.lt_or_ge n j with h | h
    · rw [Nat.choose_eq_zero_of_lt (by omega : n < j + 1),
        Nat.choose_eq_zero_of_lt (by omega : n + 1 < j + 1)]
      simp
    · have h0 := upZ n (j + 1) (by omega)
      push_cast at h0
      linear_combination -h0
  have rb1 := rightZ (2 * n + j + 1) j (by omega)
  have rb2 := upZ (2 * n + j + 1) (j + 1) (by omega)
  have rb3 := upZ (2 * n + j + 2) (j + 1) (by omega)
  have rb4 := upZ (2 * n + j + 3) (j + 1) (by omega)
  have rb5 := upZ (2 * n + j + 4) (j + 1) (by omega)
  rw [show 2 * n + j + 1 + 1 = 2 * n + j + 2 from rfl] at rb2
  rw [show 2 * n + j + 2 + 1 = 2 * n + j + 3 from rfl] at rb3
  rw [show 2 * n + j + 3 + 1 = 2 * n + j + 4 from rfl] at rb4
  rw [show 2 * n + j + 4 + 1 = 2 * n + j + 5 from rfl] at rb5
  push_cast at ra1 rb1 rb2 rb3 rb4 rb5
  have hc := core (n : ℤ) (j : ℤ) (((n + 1).choose j : ℕ) : ℤ) ((n.choose (j + 1) : ℕ) : ℤ)
    (((n + 1).choose (j + 1) : ℕ) : ℤ) (((2 * n + j + 1).choose j : ℕ) : ℤ)
    (((2 * n + j + 1).choose (j + 1) : ℕ) : ℤ) (((2 * n + j + 2).choose (j + 1) : ℕ) : ℤ)
    (((2 * n + j + 3).choose (j + 1) : ℕ) : ℤ) (((2 * n + j + 4).choose (j + 1) : ℕ) : ℤ)
    (((2 * n + j + 5).choose (j + 1) : ℕ) : ℤ)
    (by linear_combination ra1) (by linear_combination ra0) (by linear_combination rb1)
    (by linear_combination rb2) (by linear_combination rb3) (by linear_combination rb4)
    (by linear_combination rb5)
  have h3 := (mul_eq_zero.mp hc).resolve_left (fun h0 => hf (by linear_combination h0))
  have p2 : (((n + 2).choose (j + 1) : ℕ) : ℤ) =
      (((n + 1).choose j : ℕ) : ℤ) + (((n + 1).choose (j + 1) : ℕ) : ℤ) := by
    rw [Nat.choose_succ_succ (n + 1) j]
    push_cast
    ring
  unfold t H
  rw [show 2 * n + (j + 1) + 4 = 2 * n + j + 5 by omega, show 2 * n + (j + 1) + 2 = 2 * n + j + 3 by omega,
    show 2 * n + (j + 1) + 1 = 2 * n + j + 2 by omega, show 2 * n + (j + 1) = 2 * n + j + 1 by omega, p2]
  push_cast
  unfold Qf at h3 ⊢
  linear_combination h3

theorem t_zero (n : ℕ) : (((n : ℤ) + 1) * (2 * (n : ℤ) + 4) * (2 * (n : ℤ) + 3) * (2 * (n : ℤ) + 2)) * t n 0 = H n 0 := by
  unfold t H Qf
  simp only [Nat.choose_zero_right, Nat.cast_one, Nat.cast_zero]
  ring

theorem sum_t (n : ℕ) : ∑ k ∈ Finset.range (n + 3), t n k = 0 := by
  have hs : (((n : ℤ) + 1) * (2 * (n : ℤ) + 4) * (2 * (n : ℤ) + 3) * (2 * (n : ℤ) + 2)) * ∑ k ∈ Finset.range (n + 3), t n k = 0 := by
    rw [Finset.sum_range_succ', mul_add, Finset.mul_sum]
    have e : ∑ j ∈ Finset.range (n + 2), (((n : ℤ) + 1) * (2 * (n : ℤ) + 4) * (2 * (n : ℤ) + 3) * (2 * (n : ℤ) + 2)) * t n (j + 1) =
        ∑ j ∈ Finset.range (n + 2), (H n (j + 1) - H n j) :=
      Finset.sum_congr rfl (fun j hj => pw n j (by have := Finset.mem_range.mp hj; omega))
    rw [e, Finset.sum_range_sub, t_zero]
    have hz : H n (n + 2) = 0 := by
      unfold H
      rw [Nat.choose_succ_self]
      simp
    rw [hz]
    ring
  have hpos : (((n : ℤ) + 1) * (2 * (n : ℤ) + 4) * (2 * (n : ℤ) + 3) * (2 * (n : ℤ) + 2) : ℤ) ≠ 0 := by positivity
  exact (mul_eq_zero.mp hs).resolve_left hpos

/-- The recurrence for S. -/
theorem Srec (n : ℕ) : (4 * ((n : ℤ) + 2) * (17 * (n : ℤ) + 11) * (2 * (n : ℤ) + 3)) * S (n + 2) + (-1207 * ((n : ℤ) + 2) ^ 3 + 2840 * ((n : ℤ) + 2) ^ 2 - 1897 * ((n : ℤ) + 2) + 360) * S (n + 1) + (2 * (17 * (n : ℤ) + 28) * (2 * (n : ℤ) + 1) * ((n : ℤ) + 1)) * S n = 0 := by
  have h := sum_t n
  have e2 : S (n + 2) = ∑ k ∈ Finset.range (n + 3),
      (((n + 2).choose k : ℕ) : ℤ) * (((2 * n + k + 4).choose k : ℕ) : ℤ) := by
    unfold S
    refine Finset.sum_congr rfl (fun k _ => ?_)
    rw [show 2 * (n + 2) + k = 2 * n + k + 4 by ring]
  have e1 : S (n + 1) = ∑ k ∈ Finset.range (n + 3),
      (((n + 1).choose k : ℕ) : ℤ) * (((2 * n + k + 2).choose k : ℕ) : ℤ) := by
    unfold S
    rw [Finset.sum_range_succ _ (n + 2), Nat.choose_succ_self]
    simp only [Nat.cast_zero, zero_mul, add_zero]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    rw [show 2 * (n + 1) + k = 2 * n + k + 2 by ring]
  have e0 : S n = ∑ k ∈ Finset.range (n + 3),
      ((n.choose k : ℕ) : ℤ) * (((2 * n + k).choose k : ℕ) : ℤ) := by
    unfold S
    rw [Finset.sum_range_succ _ (n + 2), Finset.sum_range_succ _ (n + 1), Nat.choose_succ_self,
      Nat.choose_eq_zero_of_lt (by omega : n < n + 2)]
    simp
  rw [e2, e1, e0]
  simp only [t, Finset.sum_add_distrib, ← Finset.mul_sum, mul_assoc] at h
  linear_combination h

theorem step (k : ℕ) : ((k : ℤ) + 1) * ((2 * (k + 1)).choose (k + 1) : ℤ) =
    2 * (2 * (k : ℤ) + 1) * ((2 * k).choose k : ℤ) := by
