import OMAReductions.R_OeisA228624_conjecture_1_R1

-- Step OeisA228624.conjecture_1.R1.H1: hypothesis H1 of reduction OeisA228624.conjecture_1.R1
-- Credit: @Williamnowak
-- H1 := ∀ n, 21 < n → n < 89 → OeisA228624.a n ≠ 0

/-!
`a n` is the determinant of the `n × n` matrix with entry `1` where `i + j` (one-based) is a
square and `0` elsewhere. For each `22 ≤ n ≤ 88` we give a prime `p ≤ 7` and a matrix `B` with
`M * B = 1` modulo `p`, so the determinant is nonzero modulo `p` and hence nonzero.

`B` is packed into one natural number in base `β` (`2` when `p = 2`, else `8`): its `(k, j)` entry
is the digit of weight `β ^ (k * n + j)`. Row `i` of `M` has its ones at the `k` with `i + k + 2`
a square, so the check sums at most twelve digits per entry; the kernel evaluates it.
-/

namespace OMA.A228624

/-- The squares from 4 to 169: all squares that occur as `i + j + 2` with `i, j < 88`. -/
def L : List ℕ := [4, 9, 16, 25, 36, 49, 64, 81, 100, 121, 144, 169]

lemma sq_iff {s : ℕ} (h2 : 2 ≤ s) (h : s < 196) : s.sqrt ^ 2 = s ↔ s ∈ L := by
  constructor
  · intro e
    generalize s.sqrt = t at e
    subst e
    have ht : t < 14 := by
      by_contra hc
      have := Nat.pow_le_pow_left (not_lt.1 hc) 2
      omega
    have h1 : 2 ≤ t := by
      by_contra hc
      have := Nat.pow_le_pow_left (show t ≤ 1 by omega) 2
      omega
    interval_cases t <;> decide
  · intro hs
    obtain ⟨t, rfl⟩ : ∃ t, s = t ^ 2 := by
      simp only [L, List.mem_cons, List.not_mem_nil, or_false] at hs
      rcases hs with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
      exacts [⟨2, rfl⟩, ⟨3, rfl⟩, ⟨4, rfl⟩, ⟨5, rfl⟩, ⟨6, rfl⟩, ⟨7, rfl⟩, ⟨8, rfl⟩, ⟨9, rfl⟩,
        ⟨10, rfl⟩, ⟨11, rfl⟩, ⟨12, rfl⟩, ⟨13, rfl⟩]
    rw [Nat.sqrt_eq']

/-- A right inverse of the matrix modulo a prime, packed into `big`, shows `a n ≠ 0`. -/
theorem cert (n p β big : ℕ) (hp : p.Prime) (hn : n ≤ 88)
    (h : ∀ i ∈ Finset.range n, ∀ j ∈ Finset.range n,
      (∑ k ∈ (Finset.range n).filter (fun k => i + k + 2 ∈ L), big / β ^ (k * n + j) % β) % p =
        if i = j then 1 else 0) :
    OeisA228624.a n ≠ 0 := by
  have : Fact p.Prime := ⟨hp⟩
  intro h0
  let M : Matrix (Fin n) (Fin n) ℤ := fun i j =>
    if (i.val + j.val + 2).sqrt ^ 2 = i.val + j.val + 2 then 1 else 0
  change M.det = 0 at h0
  let B : Matrix (Fin n) (Fin n) (ZMod p) := fun k j =>
    ((big / β ^ (k.val * n + j.val) % β : ℕ) : ZMod p)
  have hMB : M.map (Int.castRingHom (ZMod p)) * B = 1 := by
    ext i j
    have h2 := congrArg (Nat.cast : ℕ → ZMod p)
      (h i (Finset.mem_range.2 i.isLt) j (Finset.mem_range.2 j.isLt))
    rw [ZMod.natCast_mod, Nat.cast_sum, Finset.sum_filter] at h2
    have h3 : (∑ k : Fin n, M.map (Int.castRingHom (ZMod p)) i k * B k j) =
        ∑ k ∈ Finset.range n, if i.val + k + 2 ∈ L then
          ((big / β ^ (k * n + j.val) % β : ℕ) : ZMod p) else 0 := by
      rw [← Fin.sum_univ_eq_sum_range (fun k => if i.val + k + 2 ∈ L then
        ((big / β ^ (k * n + j.val) % β : ℕ) : ZMod p) else 0) n]
      refine Finset.sum_congr rfl fun k _ => ?_
      have hs := sq_iff (s := i.val + k.val + 2) (by omega) (by omega)
      rw [Matrix.map_apply]
      change (Int.castRingHom (ZMod p))
          (if (i.val + k.val + 2).sqrt ^ 2 = i.val + k.val + 2 then 1 else 0) *
        ((big / β ^ (k.val * n + j.val) % β : ℕ) : ZMod p) = _
      simp only [hs]
      by_cases hc : i.val + k.val + 2 ∈ L <;> simp [hc]
    rw [Matrix.mul_apply, h3, h2, Matrix.one_apply]
    rcases eq_or_ne i j with rfl | hne
    · simp
    · simp [hne, Fin.val_ne_of_ne hne]
  have hdet := congrArg Matrix.det hMB
  have h4 : (M.map (Int.castRingHom (ZMod p))).det = 0 := by
    rw [← RingHom.mapMatrix_apply, ← RingHom.map_det, h0, map_zero]
  rw [Matrix.det_mul, Matrix.det_one, h4, zero_mul] at hdet
  exact zero_ne_one hdet

