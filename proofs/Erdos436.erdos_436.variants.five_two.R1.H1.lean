import OMAReductions.R_Erdos436_erdos_436_variants_five_two_R1

namespace OMAFive

/-- A candidate `n` with the prime factor lists of `n` and of `n + 1`. -/
abbrev Cand := ℕ × List ℕ × List ℕ

/-- A Boolean primality test by trial division. -/
def isPrimeB (n : ℕ) : Bool :=
  decide (2 ≤ n) && (List.range n).all (fun d => decide (d < 2) || decide (n % d ≠ 0))

lemma isPrimeB_sound {n : ℕ} (h : isPrimeB n = true) : n.Prime := by
  unfold isPrimeB at h
  rw [Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true] at h
  rw [Nat.prime_def_lt]
  refine ⟨h.1, fun m hm hdvd => ?_⟩
  have h2 := h.2 m (List.mem_range.2 hm)
  rw [Bool.or_eq_true, decide_eq_true_eq, decide_eq_true_eq] at h2
  have hm0 : m ≠ 0 := by
    rintro rfl
    rw [Nat.zero_dvd] at hdvd
    omega
  rcases h2 with h1 | h1
  · omega
  · exact absurd (Nat.mod_eq_zero_of_dvd hdvd) h1

/-- Value assigned to a prime, if any. -/
def look (asg : List (ℕ × ℕ)) (p : ℕ) : Option ℕ :=
  match asg with
  | [] => none
  | (q, v) :: rest => if p = q then some v else look rest p

/-- Sum of the assigned values along a factor list, if all are assigned. -/
def sumv (asg : List (ℕ × ℕ)) : List ℕ → Option ℕ
  | [] => some 0
  | p :: l =>
    match look asg p, sumv asg l with
    | some v, some s => some (v + s)
    | _, _ => none

def zeroSum (asg : List (ℕ × ℕ)) (l : List ℕ) : Bool :=
  match sumv asg l with
  | some s => decide (s % 5 = 0)
  | none => false

def okCand (asg : List (ℕ × ℕ)) (c : Cand) : Bool := zeroSum asg c.2.1 && zeroSum asg c.2.2

def static (c : Cand) : Bool :=
  decide (1 ≤ c.1) && decide (c.1 ≤ 7888) && decide (c.2.1.prod = c.1) &&
    decide (c.2.2.prod = c.1 + 1)

/-- Depth-first search over the values of the listed primes. -/
def dfs : List (ℕ × List Cand) → List (ℕ × ℕ) → List Cand → Bool
  | [], asg, cs => cs.any (okCand asg)
  | (p, cs') :: rest, asg, cs =>
    cs.any (okCand asg) || (List.range 5).all (fun v => dfs rest ((p, v) :: asg) cs')

/-- The assignment list agrees with `w` and only mentions primes. -/
def Cons (asg : List (ℕ × ℕ)) (w : ℕ → ZMod 5) : Prop :=
  ∀ p v, look asg p = some v → w p = (v : ZMod 5) ∧ p.Prime

lemma sumv_sound (asg : List (ℕ × ℕ)) (w : ℕ → ZMod 5) (h : Cons asg w) :
    ∀ (l : List ℕ) (s : ℕ), sumv asg l = some s →
      (l.map w).sum = (s : ZMod 5) ∧ ∀ p ∈ l, p.Prime := by
  intro l
  induction l with
  | nil =>
    intro s hs
    simp only [sumv, Option.some.injEq] at hs
    subst hs
    simp
  | cons p l ih =>
    intro s hs
    unfold sumv at hs
    cases hl : look asg p with
    | none => rw [hl] at hs; simp at hs
    | some v =>
      cases hr : sumv asg l with
      | none => rw [hl, hr] at hs; simp at hs
      | some t =>
        rw [hl, hr] at hs
        simp only [Option.some.injEq] at hs
        subst hs
        obtain ⟨hw, hp⟩ := h p v hl
        obtain ⟨h1, h2⟩ := ih t hr
        refine ⟨?_, ?_⟩
        · rw [List.map_cons, List.sum_cons, hw, h1]
          push_cast
          rfl
        · intro q hq
          rcases List.mem_cons.1 hq with rfl | hq
          · exact hp
          · exact h2 q hq

lemma zero_sound (asg : List (ℕ × ℕ)) (w : ℕ → ZMod 5) (h : Cons asg w) (l : List ℕ)
    (hz : zeroSum asg l = true) : (l.map w).sum = 0 ∧ ∀ p ∈ l, p.Prime := by
  unfold zeroSum at hz
  cases hs : sumv asg l with
  | none => rw [hs] at hz; simp at hz
  | some s =>
    rw [hs] at hz
    simp only [decide_eq_true_eq] at hz
    obtain ⟨h1, h2⟩ := sumv_sound asg w h l s hs
    refine ⟨?_, h2⟩
    rw [h1, ZMod.natCast_eq_zero_iff]
    exact Nat.dvd_of_mod_eq_zero hz

lemma cand_sound (asg : List (ℕ × ℕ)) (w : ℕ → ZMod 5) (h : Cons asg w) (c : Cand)
    (hs : static c = true) (ho : okCand asg c = true) :
    ∃ n ∈ Finset.Icc 1 7888, (n.primeFactorsList.map w).sum = 0 ∧
      ((n + 1).primeFactorsList.map w).sum = 0 := by
  obtain ⟨n, l, l'⟩ := c
  simp only [static, Bool.and_eq_true, decide_eq_true_eq] at hs
  obtain ⟨⟨⟨h1, h2⟩, h3⟩, h4⟩ := hs
  simp only [okCand, Bool.and_eq_true] at ho
  obtain ⟨hz, hz'⟩ := ho
  obtain ⟨ha, hpa⟩ := zero_sound asg w h l hz
  obtain ⟨hb, hpb⟩ := zero_sound asg w h l' hz'
  refine ⟨n, Finset.mem_Icc.2 ⟨h1, h2⟩, ?_, ?_⟩
  · have hperm := Nat.primeFactorsList_unique h3 hpa
    rw [← (hperm.map w).sum_eq]
    exact ha
  · have hperm := Nat.primeFactorsList_unique h4 hpb
    rw [← (hperm.map w).sum_eq]
    exact hb

lemma dfs_sound : ∀ (rest : List (ℕ × List Cand)) (asg : List (ℕ × ℕ)) (cs : List Cand),
    (∀ c ∈ cs, static c = true) →
    (∀ e ∈ rest, e.1.Prime ∧ ∀ c ∈ e.2, static c = true) →
    dfs rest asg cs = true → ∀ w : ℕ → ZMod 5, Cons asg w →
    ∃ n ∈ Finset.Icc 1 7888, (n.primeFactorsList.map w).sum = 0 ∧
      ((n + 1).primeFactorsList.map w).sum = 0 := by
  intro rest
  induction rest with
  | nil =>
    intro asg cs hcs _ hd w hw
    simp only [dfs, List.any_eq_true] at hd
    obtain ⟨c, hc, ho⟩ := hd
    exact cand_sound asg w hw c (hcs c hc) ho
  | cons e rest ih =>
    intro asg cs hcs hrest hd w hw
    obtain ⟨p, cs'⟩ := e
    simp only [dfs, Bool.or_eq_true, List.any_eq_true, List.all_eq_true] at hd
    rcases hd with ⟨c, hc, ho⟩ | hall
    · exact cand_sound asg w hw c (hcs c hc) ho
    · have he := hrest (p, cs') (List.mem_cons_self ..)
      have hv : (w p).val ∈ List.range 5 := List.mem_range.2 (ZMod.val_lt (w p))
      have hd' := hall (w p).val hv
      apply ih ((p, (w p).val) :: asg) cs' he.2
        (fun e' he' => hrest e' (List.mem_cons_of_mem _ he')) hd' w
      intro q v hq
      unfold look at hq
      by_cases hqp : q = p
      · rw [if_pos hqp] at hq
        simp only [Option.some.injEq] at hq
        subst hqp
        subst hq
        exact ⟨(ZMod.natCast_zmod_val (w q)).symm, he.1⟩
      · rw [if_neg hqp] at hq
        exact hw q v hq

