def adjL (s : R) : List R := ((((((adjT).getD (s 0).val []).getD (s 1).val []).getD (s 2).val []).getD (s 3).val []).getD (s 4).val []).getD (s 5).val []

def AP (s : R) : Prop := ∀ t : R, (ok s ∧ compat s t) ↔ t ∈ adjL s

def B (a b c d : Fin 3) : Prop :=
  ¬ ((a : ℕ) + (d : ℕ) > max (b : ℕ) (c : ℕ))

instance (a b c d : Fin 3) : Decidable (B a b c d) := by unfold B; infer_instance

def PRp (s : R) : Prop :=
  ok s → ∀ b0 b1 : Fin 3, B (s 0) (s 1) b0 b1 →
    ∀ b2 : Fin 3, B (s 1) (s 2) b1 b2 →
    ∀ b3 : Fin 3, B (s 2) (s 3) b2 b3 →
    ∀ b4 : Fin 3, B (s 3) (s 4) b3 b4 →
    ∀ b5 : Fin 3, B (s 4) (s 5) b4 b5 →
    ![b0, b1, b2, b3, b4, b5] ∈ adjL s

instance (s : R) : Decidable (PRp s) := by unfold PRp; infer_instance

