  simp only [forall_vecCons, forall_vecEmpty]
  decide +kernel

theorem F_eq (n : ℕ) : ∀ s : R, (F n s : ℤ) = α n s := by
  induction n with
  | zero =>
    intro s
    rw [F_zero, B0]
    split_ifs <;> simp
  | succ n ih =>
    intro s
    rw [F_succ, ← T s n]
    push_cast
    apply Finset.sum_congr rfl
    intro t _
    split_ifs
    · exact ih t
    · rfl

