  · show ((C (6 + 0) : ℤ) : ℚ) = _
    rw [show C (6 + 0) = 536601 from by decide +kernel]
    norm_num
theorem closed_n (n : ℕ) (hn : 4 ≤ n) : (a n : ℚ) = (2 * (5472 + 1058 * (-1 : ℚ) ^ n + 2809 * (2 : ℚ) ^ n) + 6142 * (n : ℚ) + 1759 * (n : ℚ) ^ 2 + 266 * (n : ℚ) ^ 3 + 17 * (n : ℚ) ^ 4) / 12 := by
  obtain ⟨k, rfl⟩ : ∃ k, n = k + 4 := ⟨n - 4, by omega⟩
  have h := congrArg (Int.cast : ℤ → ℚ) (aC (k))
  push_cast at h
  have h2 := closedC k
  rw [show (a (k + 4) : ℚ) = ((C (k) : ℤ) : ℚ) from h]
  exact h2


