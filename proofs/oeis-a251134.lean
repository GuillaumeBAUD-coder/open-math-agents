theorem aC (n : ℕ) : (a (n + 4) : ℤ) = C n := by
  rw [show (a (n + 4) : ℤ) = A (n + 4) from N_eq (n + 4), A_C]
  ring

theorem uniqp {K : Type} [CommRing K] (u v : ℕ → K)
    (hu : ∀ n, u (n + 7) = (-2) * u n + 9 * u (n + 1) - 14 * u (n + 2) + 5 * u (n + 3) + 10 * u (n + 4) - 13 * u (n + 5) + 6 * u (n + 6))
    (hv : ∀ n, v (n + 7) = (-2) * v n + 9 * v (n + 1) - 14 * v (n + 2) + 5 * v (n + 3) + 10 * v (n + 4) - 13 * v (n + 5) + 6 * v (n + 6))
    (h0 : u 0 = v 0) (h1 : u 1 = v 1) (h2 : u 2 = v 2) (h3 : u 3 = v 3) (h4 : u 4 = v 4) (h5 : u 5 = v 5) (h6 : u 6 = v 6) : ∀ n, u n = v n := by
  have key : ∀ n, u n = v n ∧ u (n + 1) = v (n + 1) ∧ u (n + 2) = v (n + 2) ∧ u (n + 3) = v (n + 3) ∧ u (n + 4) = v (n + 4) ∧ u (n + 5) = v (n + 5) ∧ u (n + 6) = v (n + 6) := by
    intro n
    induction n with
    | zero => exact ⟨h0, h1, h2, h3, h4, h5, h6⟩
    | succ n ih =>
      obtain ⟨a0, a1, a2, a3, a4, a5, a6⟩ := ih
      refine ⟨a1, a2, a3, a4, a5, a6, ?_⟩
      rw [show n + 1 + 6 = n + 7 from rfl, hu, hv, a0, a1, a2, a3, a4, a5, a6]
  exact fun n => (key n).1

theorem rec_k (k : ℕ) : (a (k + 11) : ℤ) = 6 * (a (k + 10) : ℤ) - 13 * (a (k + 9) : ℤ) + 10 * (a (k + 8) : ℤ) + 5 * (a (k + 7) : ℤ) - 14 * (a (k + 6) : ℤ) + 9 * (a (k + 5) : ℤ) - 2 * (a (k + 4) : ℤ) := by
  have e0 : (a (k + 11) : ℤ) = C (k + 7) := aC (k + 7)
  have e1 : (a (k + 10) : ℤ) = C (k + 6) := aC (k + 6)
  have e2 : (a (k + 9) : ℤ) = C (k + 5) := aC (k + 5)
  have e3 : (a (k + 8) : ℤ) = C (k + 4) := aC (k + 4)
  have e4 : (a (k + 7) : ℤ) = C (k + 3) := aC (k + 3)
  have e5 : (a (k + 6) : ℤ) = C (k + 2) := aC (k + 2)
  have e6 : (a (k + 5) : ℤ) = C (k + 1) := aC (k + 1)
  have e7 : (a (k + 4) : ℤ) = C (k) := aC (k)
  linear_combination e0 - (6) * e1 - (-13) * e2 - (10) * e3 - (5) * e4 - (-14) * e5 - (9) * e6 - (-2) * e7 + C_rec k

