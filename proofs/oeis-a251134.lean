theorem closedC : ∀ m : ℕ, ((C (m + 0) : ℤ) : ℚ) = (2 * (5472 + 1058 * (-1 : ℚ) ^ (m + 4) + 2809 * (2 : ℚ) ^ (m + 4)) + 6142 * ((m + 4 : ℕ) : ℚ) + 1759 * ((m + 4 : ℕ) : ℚ) ^ 2 + 266 * ((m + 4 : ℕ) : ℚ) ^ 3 + 17 * ((m + 4 : ℕ) : ℚ) ^ 4) / 12 := by
  apply uniqp (fun m : ℕ => ((C (m + 0) : ℤ) : ℚ)) (fun m : ℕ => (2 * (5472 + 1058 * (-1 : ℚ) ^ (m + 4) + 2809 * (2 : ℚ) ^ (m + 4)) + 6142 * ((m + 4 : ℕ) : ℚ) + 1759 * ((m + 4 : ℕ) : ℚ) ^ 2 + 266 * ((m + 4 : ℕ) : ℚ) ^ 3 + 17 * ((m + 4 : ℕ) : ℚ) ^ 4) / 12)
  · intro m
    have h := congrArg (Int.cast : ℤ → ℚ) (C_rec (m + 0))
    push_cast at h
    exact h
  · intro m
    try simp only [Nat.add_sub_cancel]
    push_cast
    ring
  · show ((C (0 + 0) : ℤ) : ℚ) = _
    rw [show C (0 + 0) = 14753 from by decide +kernel]
    norm_num
  · show ((C (1 + 0) : ℤ) : ℚ) = _
