theorem C_P (n : ℕ) : C (n + 11) = (-2) * C (n + 4) + 9 * C (n + 5) - 14 * C (n + 6) + 5 * C (n + 7) + 10 * C (n + 8) - 13 * C (n + 9) + 6 * C (n + 10) := by
  have h4 : C (n + 11) = (-2) * C (n + 4) + 9 * C (n + 5) - 14 * C (n + 6) + 5 * C (n + 7) + 10 * C (n + 8) - 13 * C (n + 9) + 6 * C (n + 10) := C_rec (n + 4)
  linear_combination (1) * h4

theorem A_C : ∀ n, A (n + 4) = 1 * C n := by
  apply uniqP (fun n => A (n + 4)) (fun n => 1 * C n)
  · intro n
    exact A_rec (n + 4)
  · intro n
    rw [C_P]
    ring
  · decide +kernel
