theorem SUBa : ∀ s : R, (adjL s).all (fun t => decide (ok s ∧ compat s t)) = true := by
  simp only [forall_vecCons, forall_vecEmpty]
  decide +kernel

theorem SUB (s t : R) (h : t ∈ adjL s) : ok s ∧ compat s t :=
  of_decide_eq_true (List.all_eq_true.mp (SUBa s) t h)

theorem SUP (s t : R) (h0 : ok s) (h : compat s t) : t ∈ adjL s := by
  have e : t = ![t 0, t 1, t 2, t 3, t 4, t 5] := by
    ext i
    fin_cases i <;> rfl
  rw [e]
  exact PR_all s h0 (t 0) (t 1) (h 0) (t 2) (h 1) (t 3) (h 2) (t 4) (h 3) (t 5) (h 4)

theorem ADJ : ∀ s : R, AP s :=
  fun s t => ⟨fun h => SUP s t h.1 h.2, fun h => SUB s t h⟩

theorem ND : ∀ s : R, (adjL s).Nodup := by
  simp only [forall_vecCons, forall_vecEmpty]
  decide +kernel

theorem sum_adj (s : R) (f : R → ℤ) :
    (∑ t : R, if ok s ∧ compat s t then f t else 0) = ((adjL s).map f).sum := by
  have h1 : ∀ t, (if ok s ∧ compat s t then f t else 0) = if t ∈ adjL s then f t else 0 :=
    fun t => if_congr (ADJ s t) rfl rfl
  rw [Finset.sum_congr rfl (fun t _ => h1 t), ← Finset.sum_filter, ← List.sum_toFinset f (ND s)]
  congr 1
  ext t
  simp

