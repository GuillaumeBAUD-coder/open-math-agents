import FormalConjectures.Wikipedia.InverseGalois

-- Problem: Inverse Galois problem — abelian
-- Upstream: formal-conjectures FormalConjectures/Wikipedia/InverseGalois.lean (declaration InverseGalois.inverse_galois_problem.variants.abelian)
-- Credit: @niclorusso (the owner of the agent is credited as the solver)
-- Prove EXACTLY this target. No sorry, no axiom, no native_decide.

/-!
Every finite abelian group `G` is a Galois group over `ℚ`.

For every `g : G` pick a prime `p g ≡ 1 [MOD #G]`, all distinct, and let `m = ∏ g, p g`.
The Galois group of the `m`-th cyclotomic field is `(ZMod m)ˣ ≃* Π g, (ZMod (p g))ˣ` (Chinese
remainder theorem). Each `(ZMod (p g))ˣ` is cyclic of order `p g - 1`, a multiple of the order of
`g`, so it surjects onto the cyclic subgroup generated by `g`. Since `G` is commutative these
maps combine into a surjection `Π g, (ZMod (p g))ˣ →* G`, and the fixed field of its kernel is
Galois over `ℚ` with Galois group `G`.
-/

namespace OMA.InverseGaloisAbelian

open Polynomial IntermediateField

/-- If the Galois group of a finite Galois extension of `ℚ` surjects onto `G`, then `G` is
realizable over `ℚ`: take the fixed field of the kernel. -/
lemma realizable_of_surjective {L : Type} [Field L] [Algebra ℚ L] [FiniteDimensional ℚ L]
    [IsGalois ℚ L] {G : Type*} [Group G] (f : Gal(L/ℚ) →* G) (hf : Function.Surjective f) :
    InverseGalois.IsRealizable ℚ G :=
  ⟨⟨{ L := fixedField f.ker
      to_field := (fixedField f.ker).toField
      to_algebra := (fixedField f.ker).algebra'
      to_isGalois := IsGalois.of_fixedField_normal_subgroup f.ker
      iso := (QuotientGroup.quotientKerEquivOfSurjective f hf).symm.trans
        (IsGalois.normalAutEquivQuotient f.ker) }⟩⟩

/-- A cyclic group surjects onto any cyclic group whose order divides its order. -/
lemma exists_surjective_of_dvd {H G : Type*} [Group H] [Group G] (hH : IsCyclic H)
    (hG : IsCyclic G) (h : Nat.card G ∣ Nat.card H) :
    ∃ f : H →* G, Function.Surjective f := by
  let eH := zmodCyclicMulEquiv hH
  let eG := zmodCyclicMulEquiv hG
  let c : Multiplicative (ZMod (Nat.card H)) →* Multiplicative (ZMod (Nat.card G)) :=
    AddMonoidHom.toMultiplicative (ZMod.castHom h (ZMod (Nat.card G))).toAddMonoidHom
  have hc : Function.Surjective c := by
    intro y
    obtain ⟨x, hx⟩ := ZMod.castHom_surjective h (Multiplicative.toAdd y)
    exact ⟨Multiplicative.ofAdd x, by simp [c, hx]⟩
  refine ⟨eG.toMonoidHom.comp (c.comp eH.symm.toMonoidHom), ?_⟩
  simp only [MonoidHom.coe_comp, MulEquiv.coe_toMonoidHom]
  exact eG.surjective.comp (hc.comp eH.symm.surjective)

/-- Distinct primes `≡ 1 [MOD k]`, indexed by any finite type. -/
lemma exists_primes (ι : Type*) [Finite ι] {k : ℕ} (hk : k ≠ 0) :
    ∃ p : ι → ℕ, Function.Injective p ∧ ∀ i, (p i).Prime ∧ p i ≡ 1 [MOD k] := by
  have : Infinite {p : ℕ | Nat.Prime p ∧ p ≡ 1 [MOD k]} :=
    (Nat.infinite_setOfPred_prime_modEq_one hk).to_subtype
  obtain ⟨n, ⟨e⟩⟩ := Finite.exists_equiv_fin ι
  let emb := Infinite.natEmbedding {p : ℕ | Nat.Prime p ∧ p ≡ 1 [MOD k]}
  refine ⟨fun i => (emb (e i : ℕ)).1, ?_, fun i => (emb (e i : ℕ)).2⟩
  intro i j hij
  apply e.injective
  apply Fin.val_injective
  apply emb.injective
  exact Subtype.ext hij

end OMA.InverseGaloisAbelian

open Polynomial OMA.InverseGaloisAbelian in
theorem OMA.solution : type_of% @InverseGalois.inverse_galois_problem.variants.abelian := by
  intro G _ _
  classical
  obtain ⟨p, hpinj, hp⟩ := exists_primes G (Nat.card_pos (α := G)).ne'
  have hcop : Pairwise (Function.onFun Nat.Coprime p) := fun i j hij =>
    (Nat.coprime_primes (hp i).1 (hp j).1).2 (hpinj.ne hij)
  have hm0 : 0 < ∏ g, p g := Finset.prod_pos fun g _ => (hp g).1.pos
  have : NeZero (∏ g, p g) := ⟨hm0.ne'⟩
  have : NeZero ((∏ g, p g : ℕ) : ℚ) := ⟨Nat.cast_ne_zero.2 hm0.ne'⟩
  have : IsCyclotomicExtension {∏ g, p g} ℚ (CyclotomicField (∏ g, p g) ℚ) :=
    CyclotomicField.isCyclotomicExtension (∏ g, p g) ℚ
  have : FiniteDimensional ℚ (CyclotomicField (∏ g, p g) ℚ) :=
    IsCyclotomicExtension.finiteDimensional {∏ g, p g} ℚ (CyclotomicField (∏ g, p g) ℚ)
  have : IsGalois ℚ (CyclotomicField (∏ g, p g) ℚ) :=
    IsCyclotomicExtension.isGalois {∏ g, p g} ℚ (CyclotomicField (∏ g, p g) ℚ)
  let e1 : Gal(CyclotomicField (∏ g, p g) ℚ/ℚ) ≃* (ZMod (∏ g, p g))ˣ :=
    IsCyclotomicExtension.autEquivPow (CyclotomicField (∏ g, p g) ℚ)
      (cyclotomic.irreducible_rat hm0)
  let e2 : (ZMod (∏ g, p g))ˣ ≃* (Π g, ZMod (p g))ˣ :=
    Units.mapEquiv (ZMod.prodEquivPi p hcop).toMulEquiv
  let e3 : (Π g, ZMod (p g))ˣ ≃* Π g, (ZMod (p g))ˣ := MulEquiv.piUnits
  have hs : ∀ g : G, ∃ s : (ZMod (p g))ˣ →* Subgroup.zpowers g, Function.Surjective s := by
    intro g
    have : Fact (p g).Prime := ⟨(hp g).1⟩
    refine exists_surjective_of_dvd inferInstance inferInstance ?_
    rw [Nat.card_zpowers, Nat.card_eq_fintype_card (α := (ZMod (p g))ˣ), ZMod.card_units]
    exact (orderOf_dvd_natCard g).trans ((Nat.modEq_iff_dvd' (hp g).1.one_le).1 (hp g).2.symm)
  choose s hs using hs
  let φ : ∀ g : G, (ZMod (p g))ˣ →* G := fun g => (Subgroup.zpowers g).subtype.comp (s g)
  have hcomm : Pairwise fun i j => ∀ (x : (ZMod (p i))ˣ) (y : (ZMod (p j))ˣ),
      Commute (φ i x) (φ j y) := fun _ _ _ _ _ => Commute.all _ _
  let F : (Π g, (ZMod (p g))ˣ) →* G := MonoidHom.noncommPiCoprod φ hcomm
  have hF : Function.Surjective F := by
    intro y
    obtain ⟨a, ha⟩ := hs y ⟨y, Subgroup.mem_zpowers y⟩
    refine ⟨Pi.mulSingle y a, ?_⟩
    have h1 : F (Pi.mulSingle y a) = φ y a :=
      MonoidHom.noncommPiCoprod_mulSingle (hcomm := hcomm) φ y a
    rw [h1]
    show ((s y a : Subgroup.zpowers y) : G) = y
    rw [ha]
  refine realizable_of_surjective (F.comp (e3.toMonoidHom.comp (e2.toMonoidHom.comp
    e1.toMonoidHom))) ?_
  simp only [MonoidHom.coe_comp, MulEquiv.coe_toMonoidHom]
  exact hF.comp (e3.surjective.comp (e2.surjective.comp e1.surjective))
