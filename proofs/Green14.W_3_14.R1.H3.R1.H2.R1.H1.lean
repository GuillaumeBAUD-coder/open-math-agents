import OMAReductions.R_Green14_W_3_14_R1_H3_R1_H2_R1

/-!
# Certificate for `Green14.W_3_14.R1.H3.R1.H2.R1.H1`

Proves that every 2-coloring `c : Nat → Bool` with `c 86 = true`, `c 95 = true`,
and `c q = false` for `86 < q < 95` contains either a red 3-term arithmetic progression
or a blue 14-term arithmetic progression in `{0, ..., 181}`.

Uses bit-parallel 256-bit SIMD unit propagation over 182-bit lanes with palindromic
reflection symmetry `x ↦ 181 - x` (which preserves `{86, 95}` and `{87, ..., 94}`),
verifying a freshly generated compact UNSAT search tree via `decide +kernel`.
-/

namespace OMA.W314H2R1H1

private def Goal (c : Nat → Bool) :=
  ∃ (b : Bool) (a d : Nat), 0 < d ∧ a + (if b then 2 else 13)*d < 182 ∧
    ∀ t : Fin 14, t.val ≤ (if b then 2 else 13) → c (a+t.val*d) = b

private def Bit (m i : Nat) := m.testBit i = true

@[simp] private lemma bit_or {a b i} : Bit (a ||| b) i ↔ Bit a i ∨ Bit b i := by
  simp [Bit]
@[simp] private lemma bit_and {a b i} : Bit (a &&& b) i ↔ Bit a i ∧ Bit b i := by
  simp [Bit]
@[simp] private lemma bit_down {a k i} : Bit (a >>> k) i ↔ Bit a (i+k) := by
  simp [Bit, Nat.add_comm]
private lemma bit_up {a k i} : Bit (a <<< k) i ↔ k ≤ i ∧ Bit a (i-k) := by
  simp [Bit]
private def low (n : Nat) := (1 <<< n) - 1
@[simp] private lemma bit_low {n i} : Bit (low n) i ↔ i < n := by
  simp [Bit, low, Nat.shiftLeft_eq]

private def joinBits (k a b : Nat) := (a &&& low k) ||| (b <<< k)
private lemma join_lo {k a b i} (hi : i < k) : Bit (joinBits k a b) i ↔ Bit a i := by
  simp [joinBits, bit_up, hi, Nat.not_le_of_gt hi]
private lemma join_hi {k a b i} (hi : k ≤ i) : Bit (joinBits k a b) i ↔ Bit b (i-k) := by
  simp [joinBits, bit_up, hi, Nat.not_lt_of_ge hi]

private def tiles : Nat → Nat → Nat
  | 0, m => m
  | n+1, m =>
    let v := tiles n m
    v ||| (v <<< (256 * 2^n))

private lemma tiles_bound (n : Nat) {m : Nat} (hm : m < 2^256) : tiles n m < 2^(256*2^n) := by
  induction n with
  | zero => simpa [tiles] using hm
  | succ n ih =>
    rw [tiles]
    apply Nat.or_lt_two_pow
    · exact lt_of_lt_of_le ih (Nat.pow_le_pow_right (by decide) (by simp [Nat.pow_succ]))
    · rw [Nat.shiftLeft_eq, Nat.pow_succ, show 256*(2^n*2) = 256*2^n+256*2^n by omega, Nat.pow_add]
      exact Nat.mul_lt_mul_of_pos_right ih (Nat.two_pow_pos _)

private lemma tile_bit (n : Nat) {m j x : Nat} (hm : m < 2^256) (hj : j < 2^n) (hx : x < 256) :
    Bit (tiles n m) (256*j+x) ↔ Bit m x := by
  induction n generalizing j with
  | zero =>
    have : j = 0 := by simpa using hj
    simp [tiles, this]
  | succ n ih =>
    rw [tiles, bit_or, bit_up]
    by_cases h : j < 2^n
    · have hlt : 256*j+x < 256*2^n := by omega
      simp [Nat.not_le_of_gt hlt, ih h]
    · have hh : j - 2^n < 2^n := by rw [Nat.pow_succ] at hj; omega
      have hle : 256*2^n ≤ 256*j+x := by omega
      have hzero : ¬ Bit (tiles n m) (256*j+x) := by
        have hbound := lt_of_lt_of_le (tiles_bound n hm) (Nat.pow_le_pow_right (by decide : 0 < 2) hle)
        simp [Bit, Nat.testBit_lt_two_pow hbound]
      simp only [hzero, false_or, hle, true_and]
      rw [show 256*j+x - 256*2^n = 256*(j-2^n)+x by omega]
      exact ih hh

private def AtBit (j m x : Nat) := Bit m (256*j+x)
private def Fact (c : Nat → Bool) (b : Bool) (j m : Nat) :=
  ∀ x, x < 182 → AtBit j m x → c x = b

private lemma fact_or {c b j a d} (fa : Fact c b j a) (fd : Fact c b j d) :
    Fact c b j (a ||| d) :=
  fun x hx h => (bit_or.mp h).elim (fa x hx) (fd x hx)

private lemma fact_and_left {c b j a d} (fa : Fact c b j a) : Fact c b j (a &&& d) :=
  fun x hx h => fa x hx (bit_and.mp h).1

private def Masked (g m : Nat) := ∀ j x, j < 2^g → 182 ≤ x → x < 256 → ¬ AtBit j m x

private lemma masked_M (g : Nat) : Masked g (tiles g (low 182)) := by
  intro j x hj hlo hhi h
  have := bit_low.mp ((tile_bit g (by decide : low 182 < 2^256) hj hhi).mp h)
  omega

private lemma masked_and_M {g m : Nat} : Masked g (m &&& tiles g (low 182)) :=
  fun j x hj hlo hhi h => masked_M g j x hj hlo hhi (bit_and.mp h).2

private lemma masked_and_left {g a b : Nat} (ha : Masked g a) : Masked g (a &&& b) :=
  fun j x hj hlo hhi h => ha j x hj hlo hhi (bit_and.mp h).1

private lemma masked_or {g a b : Nat} (ha : Masked g a) (hb : Masked g b) : Masked g (a ||| b) :=
  fun j x hj hlo hhi h => (bit_or.mp h).elim (ha j x hj hlo hhi) (hb j x hj hlo hhi)

private def shR1 (M k m : Nat) : Nat := (m >>> k) &&& M
private def shL1 (M k m : Nat) : Nat := (m <<< k) &&& M
private def shR (M k m : Nat) : Nat :=
  if k ≤ 74 then shR1 M k m else shR1 M (k - 74) (shR1 M 74 m)
private def shL (M k m : Nat) : Nat :=
  if k ≤ 74 then shL1 M k m else shL1 M (k - 74) (shL1 M 74 m)

private lemma masked_shR1 {g k m : Nat} : Masked g (shR1 (tiles g (low 182)) k m) := masked_and_M
private lemma masked_shL1 {g k m : Nat} : Masked g (shL1 (tiles g (low 182)) k m) := masked_and_M
private lemma masked_shR {g k m : Nat} : Masked g (shR (tiles g (low 182)) k m) := by
  unfold shR; split_ifs <;> exact masked_and_M
private lemma masked_shL {g k m : Nat} : Masked g (shL (tiles g (low 182)) k m) := by
  unfold shL; split_ifs <;> exact masked_and_M

private lemma shR1_at {g k m j x : Nat} (hj : j < 2^g) (hx : x < 182) (hk : k ≤ 74)
    (hm : Masked g m) (h : AtBit j (shR1 (tiles g (low 182)) k m) x) :
    x + k < 182 ∧ AtBit j m (x + k) := by
  have h1 : Bit m (256*j + (x + k)) := by
    simpa [Nat.add_assoc] using bit_down.mp (bit_and.mp h).1
  by_cases hlt : x + k < 182
  · exact ⟨hlt, h1⟩
  · exact False.elim (hm j (x + k) hj (by omega) (by omega) h1)

private lemma shL1_at {g k m j x : Nat} (hj : j < 2^g) (hx : x < 182) (hk : k ≤ 74)
    (hm : Masked g m) (h : AtBit j (shL1 (tiles g (low 182)) k m) x) :
    k ≤ x ∧ AtBit j m (x - k) := by
  obtain ⟨hle, hb⟩ := bit_up.mp (bit_and.mp h).1
  by_cases hkx : k ≤ x
  · refine ⟨hkx, ?_⟩
    simpa [AtBit, show 256*j + x - k = 256*j + (x - k) by omega] using hb
  · cases j with
    | zero => omega
    | succ j' =>
      have hpos : 256 * (j' + 1) + x - k = 256 * j' + (256 + x - k) := by omega
      rw [hpos] at hb
      exact False.elim (hm j' (256 + x - k) (by omega) (by omega) (by omega) hb)

private lemma shR_at {g k m j x : Nat} (hj : j < 2^g) (hx : x < 182) (hk : k ≤ 148)
    (hm : Masked g m) (h : AtBit j (shR (tiles g (low 182)) k m) x) :
    x + k < 182 ∧ AtBit j m (x + k) := by
  unfold shR at h
  split_ifs at h with h74
  · exact shR1_at hj hx h74 hm h
  · obtain ⟨h1, hb1⟩ := shR1_at hj hx (by omega) masked_shR1 h
    obtain ⟨h2, hb2⟩ := shR1_at hj h1 (by decide) hm hb1
    exact ⟨by omega, by simpa [AtBit, show x + (k - 74) + 74 = x + k by omega] using hb2⟩

private lemma shL_at {g k m j x : Nat} (hj : j < 2^g) (hx : x < 182) (hk : k ≤ 148)
    (hm : Masked g m) (h : AtBit j (shL (tiles g (low 182)) k m) x) :
    k ≤ x ∧ AtBit j m (x - k) := by
  unfold shL at h
  split_ifs at h with h74
  · exact shL1_at hj hx h74 hm h
  · obtain ⟨h1, hb1⟩ := shL1_at hj hx (by omega) masked_shL1 h
    obtain ⟨h2, hb2⟩ := shL1_at hj (by omega) (by decide) hm hb1
    exact ⟨by omega, by simpa [AtBit, show x - (k - 74) - 74 = x - k by omega] using hb2⟩

private def force3 (M d r : Nat) : Nat :=
  let r1 := shR M d r
  let r2 := shR M d r1
  (r1 &&& r2) ||| shL M d (r &&& r2) ||| shL M d (shL M d (r &&& r1))

private lemma force3_sound {c : Nat → Bool} {j g d r : Nat}
    (hj : j < 2^g) (hn : ¬ Goal c) (hd : 0 < d) (hd' : d ≤ 90)
    (hm : Masked g r) (fr : Fact c true j r) :
    Fact c false j (force3 (tiles g (low 182)) d r) := by
  intro x hx hh
  unfold force3 at hh
  have no3 (a : Nat) (hb : a + 2*d < 182) (h0 : c a = true) (h1 : c (a+d) = true) (h2 : c (a+2*d) = true) : False := by
    apply hn
    refine ⟨true, a, d, hd, hb, ?_⟩
    intro t ht
    change t.val ≤ 2 at ht
    have hv : t.val = 0 ∨ t.val = 1 ∨ t.val = 2 := by omega
    rcases hv with h | h | h
    · simpa [h] using h0
    · simpa [h] using h1
    · simpa [h] using h2
  rcases bit_or.mp hh with h | h
  · rcases bit_or.mp h with h | h
    · obtain ⟨h1, h2⟩ := bit_and.mp h
      obtain ⟨hx1, br1⟩ := shR_at hj hx (by omega) hm h1
      obtain ⟨hx1', br1'⟩ := shR_at hj hx (by omega) masked_shR h2
      obtain ⟨hx2, br2⟩ := shR_at hj hx1' (by omega) hm br1'
      have c1 := fr _ hx1 br1
      have c2 := fr _ hx2 br2
      cases hc : c x with
      | false => rfl
      | true => exact False.elim (no3 x (by omega) hc c1 (by simpa [show x + d + d = x + 2*d by omega] using c2))
    · obtain ⟨hdx, h'⟩ := shL_at hj hx (by omega) (masked_and_left hm) h
      obtain ⟨b0, b2⟩ := bit_and.mp h'
      obtain ⟨hx1, br1⟩ := shR_at hj (by omega) (by omega) masked_shR b2
      obtain ⟨hx2, br2⟩ := shR_at hj hx1 (by omega) hm br1
      have c0 := fr _ (by omega) b0
      have c2 := fr _ hx2 br2
      cases hc : c x with
      | false => rfl
      | true =>
        exact False.elim (no3 (x - d) (by omega) c0
          (by simpa [show x - d + d = x by omega] using hc)
          (by simpa [show x - d + 2*d = x - d + d + d by omega] using c2))
  · obtain ⟨hdx1, h1⟩ := shL_at hj hx (by omega) masked_shL h
    obtain ⟨hdx2, h2⟩ := shL_at hj (by omega) (by omega) (masked_and_left hm) h1
    obtain ⟨b0, b1⟩ := bit_and.mp h2
    obtain ⟨hx1, br1⟩ := shR_at hj (by omega) (by omega) hm b1
    have c0 := fr _ (by omega) b0
    have c1 := fr _ hx1 br1
    cases hc : c x with
    | false => rfl
    | true =>
      exact False.elim (no3 (x - d - d) (by omega) c0 c1
        (by simpa [show x - d - d + 2*d = x by omega] using hc))

private def Need (c : Nat → Bool) (j d n m : Nat) :=
  ∀ a, a < 182 → AtBit j m a → a + (n - 1) * d < 182 ∧ ∃ t < n, c (a + t * d) = true

private def Run (c : Nat → Bool) (j d n m : Nat) :=
  ∀ a, a < 182 → AtBit j m a → a + (n - 1) * d < 182 ∧ ∀ t < n, c (a + t * d) = false

private lemma run1_ok {c j d b} (fb : Fact c false j b) : Run c j d 1 b := by
  intro a ha h
  refine ⟨by simp; omega, ?_⟩
  intro t ht
  have ht0 : t = 0 := by omega
  subst ht0
  simpa using fb a ha h

private lemma run_join {c j g d p q m1 m2}
    (hj : j < 2^g) (hp : 0 < p) (hq : 0 < q) (hpd : p * d ≤ 74) (hm2 : Masked g m2)
    (h1 : Run c j d p m1) (h2 : Run c j d q m2) :
    Run c j d (p + q) (m1 &&& shR1 (tiles g (low 182)) (p * d) m2) := by
  intro a ha h
  obtain ⟨b1, b2⟩ := bit_and.mp h
  obtain ⟨ha2, bm2⟩ := shR1_at hj ha hpd hm2 b2
  obtain ⟨hb1, hf1⟩ := h1 a ha b1
  obtain ⟨hb2, hf2⟩ := h2 (a + p * d) ha2 bm2
  have hsum : (p + q - 1) * d = p * d + (q - 1) * d := by
    rw [← Nat.add_mul]; congr 1; omega
  refine ⟨by rw [hsum]; omega, ?_⟩
  intro t ht
  by_cases htp : t < p
  · exact hf1 t htp
  · have hq' := hf2 (t - p) (by omega)
    have heq : a + p * d + (t - p) * d = a + t * d := by
      rw [Nat.sub_mul]
      have := Nat.mul_le_mul_right d (show p ≤ t by omega)
      omega
    rwa [heq] at hq'

private lemma st14_need {c j g d} (hj : j < 2^g) (hn : ¬ Goal c) (hd : 0 < d) (hd' : d ≤ 13) :
    Need c j d 14
      (shR1 (tiles g (low 182)) (5*d)
        (shR1 (tiles g (low 182)) (4*d)
          (shR1 (tiles g (low 182)) (4*d) (tiles g (low 182))))) := by
  intro a ha h
  obtain ⟨h1, b1⟩ := shR1_at hj ha (by omega) masked_shR1 h
  obtain ⟨h2, b2⟩ := shR1_at hj h1 (by omega) masked_shR1 b1
  obtain ⟨h3, _⟩ := shR1_at hj h2 (by omega) (masked_M g) b2
  have hbound : a + 13 * d < 182 := by omega
  refine ⟨hbound, ?_⟩
  by_contra! hall
  apply hn
  refine ⟨false, a, d, hd, hbound, ?_⟩
  intro t _
  have hne := hall t.val t.isLt
  cases hc : c (a + t.val * d) with
  | false => rfl
  | true => exact False.elim (hne hc)

private lemma need_or {c j d n m1 m2} (h1 : Need c j d n m1) (h2 : Need c j d n m2) :
    Need c j d n (m1 ||| m2) :=
  fun a ha h => (bit_or.mp h).elim (h1 a ha) (h2 a ha)

private lemma need_left {c j g d p q st r}
    (hj : j < 2^g) (hp : 0 < p) (hq : 0 < q) (hpd : p * d ≤ 148) (hmr : Masked g r)
    (hs : Need c j d (p + q) st) (hr : Run c j d q r) :
    Need c j d p (st &&& shR (tiles g (low 182)) (p * d) r) := by
  intro a ha h
  obtain ⟨b1, b2⟩ := bit_and.mp h
  obtain ⟨hb, t, ht, hct⟩ := hs a ha b1
  obtain ⟨ha2, br⟩ := shR_at hj ha hpd hmr b2
  obtain ⟨_, hfr⟩ := hr (a + p * d) ha2 br
  have hle : (p - 1) * d ≤ (p + q - 1) * d := Nat.mul_le_mul_right d (by omega)
  refine ⟨by omega, ?_⟩
  by_cases htp : t < p
  · exact ⟨t, htp, hct⟩
  · have hf := hfr (t - p) (by omega)
    have heq : a + p * d + (t - p) * d = a + t * d := by
      rw [Nat.sub_mul]
      have := Nat.mul_le_mul_right d (show p ≤ t by omega)
      omega
    rw [heq, hct] at hf
    exact Bool.noConfusion hf

private lemma need_right {c j g d p q st r}
    (hj : j < 2^g) (_hp : 0 < p) (hq : 0 < q) (hpd : p * d ≤ 148) (hmst : Masked g st)
    (hs : Need c j d (p + q) st) (hr : Run c j d p r) :
    Need c j d q (shL (tiles g (low 182)) (p * d) (st &&& r)) := by
  intro a ha h
  obtain ⟨hpa, hsr⟩ := shL_at hj ha hpd (masked_and_left hmst) h
  obtain ⟨bst, br⟩ := bit_and.mp hsr
  obtain ⟨hb, t, ht, hct⟩ := hs (a - p * d) (by omega) bst
  obtain ⟨_, hfr⟩ := hr (a - p * d) (by omega) br
  have hsum : (p + q - 1) * d = p * d + (q - 1) * d := by
    rw [← Nat.add_mul]; congr 1; omega
  refine ⟨by rw [hsum] at hb; omega, ?_⟩
  by_cases htp : t < p
  · have hf := hfr t htp
    rw [hct] at hf
    exact Bool.noConfusion hf
  · refine ⟨t - p, by omega, ?_⟩
    have heq : a + (t - p) * d = a - p * d + t * d := by
      rw [Nat.sub_mul]
      have := Nat.mul_le_mul_right d (show p ≤ t by omega)
      omega
    rwa [heq]

private lemma need_left1 {c j g d p q st r}
    (hj : j < 2^g) (hp : 0 < p) (hq : 0 < q) (hpd : p * d ≤ 74) (hmr : Masked g r)
    (hs : Need c j d (p + q) st) (hr : Run c j d q r) :
    Need c j d p (st &&& shR1 (tiles g (low 182)) (p * d) r) := by
  have h := need_left hj hp hq (by omega) hmr hs hr
  simpa [shR, hpd] using h

private lemma need_right1 {c j g d p q st r}
    (hj : j < 2^g) (hp : 0 < p) (hq : 0 < q) (hpd : p * d ≤ 74) (hmst : Masked g st)
    (hs : Need c j d (p + q) st) (hr : Run c j d p r) :
    Need c j d q (shL1 (tiles g (low 182)) (p * d) (st &&& r)) := by
  have h := need_right hj hp hq (by omega) hmst hs hr
  simpa [shL, hpd] using h

private lemma force2_ok {c j g d st b}
    (hj : j < 2^g) (hd : d ≤ 74) (hmst : Masked g st) (hmb : Masked g b)
    (hs : Need c j d 2 st) (fb : Fact c false j b) :
    Fact c true j
      ((st &&& shR1 (tiles g (low 182)) d b) ||| shL1 (tiles g (low 182)) d (st &&& b)) := by
  intro x hx h
  rcases bit_or.mp h with h1 | h2
  · obtain ⟨bst, br⟩ := bit_and.mp h1
    obtain ⟨_, t, ht, hct⟩ := hs x hx bst
    obtain ⟨hx1, bb⟩ := shR1_at hj hx hd hmb br
    have hf1 := fb _ hx1 bb
    have hv : t = 0 ∨ t = 1 := by omega
    rcases hv with rfl | rfl
    · simpa using hct
    · simp only [Nat.one_mul] at hct; rw [hf1] at hct; exact Bool.noConfusion hct
  · obtain ⟨hdx, hsb⟩ := shL1_at hj hx hd (masked_and_left hmst) h2
    obtain ⟨bst, bb⟩ := bit_and.mp hsb
    obtain ⟨_, t, ht, hct⟩ := hs (x - d) (by omega) bst
    have hf0 := fb _ (by omega) bb
    have hv : t = 0 ∨ t = 1 := by omega
    rcases hv with rfl | rfl
    · simp only [Nat.zero_mul, Nat.add_zero] at hct; rw [hf0] at hct; exact Bool.noConfusion hct
    · rw [Nat.one_mul, show x - d + d = x by omega] at hct; exact hct

private lemma force3_need_ok {c j g d st b}
    (hj : j < 2^g) (hd : 2 * d ≤ 74) (hmst : Masked g st) (hmb : Masked g b)
    (hs : Need c j d 3 st) (fb : Fact c false j b) :
    Fact c true j
      (((st &&& shR1 (tiles g (low 182)) d b &&& shR1 (tiles g (low 182)) (2 * d) b) |||
        shL1 (tiles g (low 182)) d (st &&& b &&& shR1 (tiles g (low 182)) (2 * d) b)) |||
       shL1 (tiles g (low 182)) (2 * d) (st &&& b &&& shR1 (tiles g (low 182)) d b)) := by
  intro x hx h
  rcases bit_or.mp h with h12 | h3
  · rcases bit_or.mp h12 with h1 | h2
    · obtain ⟨h1a, br2⟩ := bit_and.mp h1
      obtain ⟨bst, br1⟩ := bit_and.mp h1a
      obtain ⟨_, t, ht, hct⟩ := hs x hx bst
      obtain ⟨hx1, bb1⟩ := shR1_at hj hx (by omega) hmb br1
      obtain ⟨hx2, bb2⟩ := shR1_at hj hx hd hmb br2
      have hf1 := fb _ hx1 bb1
      have hf2 := fb _ hx2 bb2
      have hv : t = 0 ∨ t = 1 ∨ t = 2 := by omega
      rcases hv with rfl | rfl | rfl
      · simpa using hct
      · simp only [Nat.one_mul] at hct; rw [hf1] at hct; exact Bool.noConfusion hct
      · rw [hf2] at hct; exact Bool.noConfusion hct
    · obtain ⟨hdx, h'⟩ := shL1_at hj hx (by omega) (masked_and_left (masked_and_left hmst)) h2
      obtain ⟨h2a, br2⟩ := bit_and.mp h'
      obtain ⟨bst, bb0⟩ := bit_and.mp h2a
      obtain ⟨_, t, ht, hct⟩ := hs (x - d) (by omega) bst
      obtain ⟨hx2, bb2⟩ := shR1_at hj (by omega) hd hmb br2
      have hf0 := fb _ (by omega) bb0
      have hf2 := fb _ hx2 bb2
      have hv : t = 0 ∨ t = 1 ∨ t = 2 := by omega
      rcases hv with rfl | rfl | rfl
      · simp only [Nat.zero_mul, Nat.add_zero] at hct; rw [hf0] at hct; exact Bool.noConfusion hct
      · rw [Nat.one_mul, show x - d + d = x by omega] at hct; exact hct
      · rw [hf2] at hct; exact Bool.noConfusion hct
  · obtain ⟨hdx, h'⟩ := shL1_at hj hx hd (masked_and_left (masked_and_left hmst)) h3
    obtain ⟨h3a, br1⟩ := bit_and.mp h'
    obtain ⟨bst, bb0⟩ := bit_and.mp h3a
    obtain ⟨_, t, ht, hct⟩ := hs (x - 2 * d) (by omega) bst
    obtain ⟨hx1, bb1⟩ := shR1_at hj (by omega) (by omega) hmb br1
    have hf0 := fb _ (by omega) bb0
    have hf1 := fb _ hx1 bb1
    have hv : t = 0 ∨ t = 1 ∨ t = 2 := by omega
    rcases hv with rfl | rfl | rfl
    · simp only [Nat.zero_mul, Nat.add_zero] at hct; rw [hf0] at hct; exact Bool.noConfusion hct
    · simp only [Nat.one_mul] at hct; rw [hf1] at hct; exact Bool.noConfusion hct
    · simpa [show x - 2 * d + 2 * d = x by omega] using hct

private def force14 (M d b : Nat) : Nat :=
  let b2 := b &&& shR1 M d b
  let b3 := b2 &&& shR1 M (2*d) b
  let b4 := b2 &&& shR1 M (2*d) b2
  let b7 := b4 &&& shR1 M (4*d) b3
  let st14 := shR1 M (5*d) (shR1 M (4*d) (shR1 M (4*d) M))
  let st7 := (st14 &&& shR M (7*d) b7) ||| shL M (7*d) (st14 &&& b7)
  let st4 := st7 &&& shR1 M (4*d) b3
  let st3 := shL1 M (4*d) (st7 &&& b4)
  let st2 := (st4 &&& shR1 M (2*d) b2) ||| shL1 M (2*d) (st4 &&& b2)
  let f2 := (st2 &&& shR1 M d b) ||| shL1 M d (st2 &&& b)
  let f3 := (st3 &&& shR1 M d b &&& shR1 M (2*d) b) |||
            shL1 M d (st3 &&& b &&& shR1 M (2*d) b) |||
            shL1 M (2*d) (st3 &&& b &&& shR1 M d b)
  f2 ||| f3

private lemma force14_sound {c : Nat → Bool} {j g d b : Nat}
    (hj : j < 2^g) (hn : ¬ Goal c) (hd : 0 < d) (hd' : d ≤ 13)
    (hmb : Masked g b) (fb : Fact c false j b) :
    Fact c true j (force14 (tiles g (low 182)) d b) := by
  unfold force14
  have hr1 : Run c j d 1 b := run1_ok fb
  have hr2 : Run c j d 2 (b &&& shR1 (tiles g (low 182)) d b) := by
    simpa [Nat.one_mul] using run_join (p := 1) (q := 1) hj (by decide) (by decide) (by omega) hmb hr1 hr1
  have hmb2 : Masked g (b &&& shR1 (tiles g (low 182)) d b) := masked_and_left hmb
  have hr3 : Run c j d 3 ((b &&& shR1 (tiles g (low 182)) d b) &&& shR1 (tiles g (low 182)) (2*d) b) :=
    run_join (p := 2) (q := 1) hj (by decide) (by decide) (by omega) hmb hr2 hr1
  have hmb3 : Masked g ((b &&& shR1 (tiles g (low 182)) d b) &&& shR1 (tiles g (low 182)) (2*d) b) :=
    masked_and_left hmb2
  have hr4 : Run c j d 4 ((b &&& shR1 (tiles g (low 182)) d b) &&& shR1 (tiles g (low 182)) (2*d) (b &&& shR1 (tiles g (low 182)) d b)) :=
    run_join (p := 2) (q := 2) hj (by decide) (by decide) (by omega) hmb2 hr2 hr2
  have hr7 : Run c j d 7
      (((b &&& shR1 (tiles g (low 182)) d b) &&& shR1 (tiles g (low 182)) (2*d) (b &&& shR1 (tiles g (low 182)) d b)) &&&
       shR1 (tiles g (low 182)) (4*d) ((b &&& shR1 (tiles g (low 182)) d b) &&& shR1 (tiles g (low 182)) (2*d) b)) :=
    run_join (p := 4) (q := 3) hj (by decide) (by decide) (by omega) hmb3 hr4 hr3
  have hmb7 : Masked g
      (((b &&& shR1 (tiles g (low 182)) d b) &&& shR1 (tiles g (low 182)) (2*d) (b &&& shR1 (tiles g (low 182)) d b)) &&&
       shR1 (tiles g (low 182)) (4*d) ((b &&& shR1 (tiles g (low 182)) d b) &&& shR1 (tiles g (low 182)) (2*d) b)) :=
    masked_and_left (masked_and_left hmb2)
  have h14 := st14_need hj hn hd hd'
  have h7 := need_or
    (need_left (p := 7) (q := 7) hj (by decide) (by decide) (by omega) hmb7 h14 hr7)
    (need_right (p := 7) (q := 7) hj (by decide) (by decide) (by omega) masked_shR1 h14 hr7)
  have h4 := need_left1 (p := 4) (q := 3) hj (by decide) (by decide) (by omega) hmb3 h7 hr3
  have h3 := need_right1 (p := 4) (q := 3) hj (by decide) (by decide) (by omega)
    (masked_or (masked_and_left masked_shR1) masked_shL) h7 hr4
  have h2 := need_or
    (need_left1 (p := 2) (q := 2) hj (by decide) (by decide) (by omega) hmb2 h4 hr2)
    (need_right1 (p := 2) (q := 2) hj (by decide) (by decide) (by omega)
      (masked_and_left (masked_or (masked_and_left masked_shR1) masked_shL)) h4 hr2)
  exact fact_or
    (force2_ok hj (by omega)
      (masked_or (masked_and_left (masked_and_left (masked_or (masked_and_left masked_shR1) masked_shL))) masked_shL1)
      hmb h2 fb)
    (force3_need_ok hj (by omega) masked_shL1 hmb h3 fb)

private def gather (f : Nat → Nat) : Nat → Nat
  | 0 => 0
  | n+1 => gather f n ||| f (n+1)

private lemma gather_ok {c b j n f} (h : ∀ d, 0 < d → d ≤ n → Fact c b j (f d)) :
    Fact c b j (gather f n) := by
  induction n with
  | zero => intro x _ hh; simp [gather, AtBit, Bit] at hh
  | succ n ih =>
    exact fact_or (ih (fun d hd hb => h d hd (by omega))) (h (n+1) (by omega) (by omega))

private def State := Nat × Nat
private def Valid (c : Nat → Bool) (j : Nat) (s : State) :=
  Fact c true j s.1 ∧ Fact c false j s.2

private def ValidM (c : Nat → Bool) (g j : Nat) (s : State) :=
  Valid c j s ∧ Masked g s.1 ∧ Masked g s.2

private def step (M : Nat) (s : State) : State :=
  let b := (s.2 ||| gather (fun d => force3 M d s.1) 90) &&& M
  ((s.1 ||| gather (fun d => force14 M d b) 13) &&& M, b)

private lemma step_sound {c j g s} (hj : j < 2^g) (hn : ¬ Goal c) (hs : ValidM c g j s) :
    ValidM c g j (step (tiles g (low 182)) s) := by
  unfold step
  let b := (s.2 ||| gather (fun d => force3 (tiles g (low 182)) d s.1) 90) &&& tiles g (low 182)
  have fb : Fact c false j b :=
    fact_and_left (fact_or hs.1.2 (gather_ok (n := 90) fun d hd hb => force3_sound hj hn hd hb hs.2.1 hs.1.1))
  have fr : Fact c true j ((s.1 ||| gather (fun d => force14 (tiles g (low 182)) d b) 13) &&& tiles g (low 182)) :=
    fact_and_left (fact_or hs.1.1 (gather_ok (n := 13) fun d hd hb => force14_sound hj hn hd hb masked_and_M fb))
  exact ⟨⟨fr, fb⟩, masked_and_M, masked_and_M⟩

private def advance (M : Nat) : Nat → State → State
  | 0, s => s
  | n+1, s => advance M n (step M s)

private lemma advance_sound {c j g} (hj : j < 2^g) (hn : ¬ Goal c) (n : Nat) (s : State)
    (hs : ValidM c g j s) : ValidM c g j (advance (tiles g (low 182)) n s) := by
  induction n generalizing s with
  | zero => exact hs
  | succ n ih => exact ih _ (step_sound hj hn hs)

private def diffuse : Nat → Nat → Nat
  | 0, m => m
  | n+1, m =>
    let v := diffuse n m
    v ||| (v >>> (2^n))

private lemma diffuse_bit (n m i) (h : Bit (diffuse n m) i) : ∃ x < 2^n, Bit m (i + x) := by
  induction n generalizing i with
  | zero => exact ⟨0, by decide, by simpa [diffuse] using h⟩
  | succ n ih =>
    rcases bit_or.mp h with h | h
    · obtain ⟨x, hx, hb⟩ := ih _ h
      exact ⟨x, by rw [Nat.pow_succ]; omega, hb⟩
    · obtain ⟨x, hx, hb⟩ := ih _ (bit_down.mp h)
      exact ⟨2^n + x, by rw [Nat.pow_succ]; omega, by simpa [Nat.add_assoc] using hb⟩

private def closed (g size M : Nat) (s : State) : Bool :=
  let clashes := s.1 &&& s.2 &&& M
  let roots := tiles g 1 &&& low (256 * size)
  (diffuse 8 clashes &&& roots) == roots

private lemma closed_false {c j g n s} (hj : j < 2^g) (hj' : j < n) (hs : Valid c j s) :
    closed g n (tiles g (low 182)) s ≠ true := by
  intro h
  have hh := beq_iff_eq.mp h
  have hroot : Bit (tiles g 1 &&& low (256 * n)) (256 * j) := by
    apply bit_and.mpr
    refine ⟨?_, bit_low.mpr (by omega)⟩
    exact (tile_bit g (m := 1) (x := 0) (by decide) hj (by decide)).mpr (by rfl)
  rw [← hh] at hroot
  obtain ⟨x, hx, hc⟩ := diffuse_bit 8 _ _ (bit_and.mp hroot).1
  obtain ⟨colors, mask⟩ := bit_and.mp hc
  have hx' := bit_low.mp ((tile_bit g (by decide : low 182 < 2^256) hj hx).mp mask)
  obtain ⟨hr, hb⟩ := bit_and.mp colors
  exact Bool.noConfusion ((hs.1 x hx' hr).symm.trans (hs.2 x hx' hb))

private structure Block where
  size : Nat
  red : Nat
  blue : Nat
  tailCode : Nat

private def leaf (s : State) (next : Nat) : Block := ⟨1, s.1, s.2, next⟩

private def collect : Nat → Nat → State → Block
  | 0, code, s => leaf s code
  | h+1, code, s =>
    if code % 2 = 0 then leaf s (code >>> 1) else
    let p := (code >>> 1) % 256
    let bit := 1 <<< p
    let l := collect h (code >>> 9) (s.1 ||| bit, s.2)
    let r := collect h l.tailCode (s.1, s.2 ||| bit)
    ⟨l.size + r.size, joinBits (256 * l.size) l.red r.red,
      joinBits (256 * l.size) l.blue r.blue, r.tailCode⟩

private lemma set_color {c b p m} (h : Fact c b 0 m) (hp : c p = b) :
    Fact c b 0 (m ||| (1 <<< p)) := by
  intro x hx he
  rcases bit_or.mp he with h1 | h2
  · exact h x hx h1
  · have e : p = x := by simpa [AtBit, Bit, Nat.shiftLeft_eq, Nat.testBit_two_pow] using h2
    exact e ▸ hp

private lemma join_left {c b j n a d} (hj : j < n) (h : Fact c b j a) :
    Fact c b j (joinBits (256 * n) a d) :=
  fun x hx hb => h x hx ((join_lo (by omega : 256 * j + x < 256 * n)).mp hb)

private lemma join_right {c b j n a d} (h : Fact c b j d) :
    Fact c b (n + j) (joinBits (256 * n) a d) := by
  intro x hx hb
  have he := (join_hi (by omega : 256 * n ≤ 256 * (n + j) + x)).mp hb
  exact h x hx (by simpa [AtBit, show 256 * (n + j) + x - 256 * n = 256 * j + x by omega] using he)

private lemma collect_cover {c} (h code s) (hs : Valid c 0 s) :
    let z := collect h code s
    ∃ j < z.size, Valid c j (z.red, z.blue) := by
  induction h generalizing code s with
  | zero => exact ⟨0, Nat.zero_lt_succ _, hs⟩
  | succ h ih =>
    simp only [collect]
    split
    · exact ⟨0, Nat.zero_lt_succ _, hs⟩
    · let p := (code >>> 1) % 256
      let l := collect h (code >>> 9) (s.1 ||| (1 <<< p), s.2)
      cases hp : c p with
      | true =>
        obtain ⟨j, hj, hv⟩ := ih (code >>> 9) (s.1 ||| (1 <<< p), s.2) ⟨set_color hs.1 hp, hs.2⟩
        exact ⟨j, lt_of_lt_of_le hj (Nat.le_add_right ..), join_left hj hv.1, join_left hj hv.2⟩
      | false =>
        obtain ⟨j, hj, hv⟩ := ih l.tailCode (s.1, s.2 ||| (1 <<< p)) ⟨hs.1, set_color hs.2 hp⟩
        exact ⟨l.size + j, Nat.add_lt_add_left hj l.size, join_right hv.1, join_right hv.2⟩

private def reject (g rounds height code : Nat) (s : State) : Bool :=
  let z := collect (height + 1) code s
  let M := tiles g (low 182)
  decide (z.size ≤ 2^g) && closed g z.size M (advance M rounds (z.red &&& M, z.blue &&& M))

private def Impossible (s : State) := ∀ c, ¬ Goal c → Valid c 0 s → False

private lemma of_check {g rounds height code : Nat} {s} (h : reject g rounds height code s = true) :
    Impossible s := by
  intro c hn hs
  obtain ⟨j, hj, hv⟩ := collect_cover (height + 1) code s hs
  simp only [reject, Bool.and_eq_true, decide_eq_true_eq] at h
  have hj' := lt_of_lt_of_le hj h.1
  have hvm : ValidM c g j ( (collect (height + 1) code s).red &&& tiles g (low 182),
                            (collect (height + 1) code s).blue &&& tiles g (low 182) ) :=
    ⟨⟨fact_and_left hv.1, fact_and_left hv.2⟩, masked_and_M, masked_and_M⟩
  exact closed_false hj' hj (advance_sound hj' hn rounds _ hvm).1 h.2

private lemma branch (p : Nat) {r b : Nat}
    (hl : Impossible (r ||| (1 <<< p), b)) (hr : Impossible (r, b ||| (1 <<< p))) :
    Impossible (r, b) := by
  intro c hn hs
  cases hp : c p with
  | true => exact hl c hn ⟨set_color hs.1 hp, hs.2⟩
  | false => exact hr c hn ⟨hs.1, set_color hs.2 hp⟩

private def SymMask (m : Nat) := ∀ x, x < 182 → Bit m x → Bit m (181 - x)

private lemma goal_reflect {c : Nat → Bool} (h : Goal (fun x => c (181 - x))) : Goal c := by
  obtain ⟨b, a, d, hd, hb, hm⟩ := h
  let L : Nat := if b then 2 else 13
  change a + L * d < 182 at hb
  refine ⟨b, 181 - (a + L * d), d, hd, by change 181 - (a + L * d) + L * d < 182; omega, ?_⟩
  intro t ht
  change t.val ≤ L at ht
  have hL : L ≤ 13 := by cases b <;> decide
  have ht' : L - t.val < 14 := by omega
  have hmul := Nat.mul_le_mul_right d ht
  have hsub := hm ⟨L - t.val, ht'⟩ (by change L - t.val ≤ L; omega)
  have heq : 181 - (a + (L - t.val) * d) = 181 - (a + L * d) + t.val * d := by
    rw [Nat.sub_mul]; omega
  simpa only [heq] using hsub

private lemma sym_branch (u : Nat) {r b : Nat}
    (hr : SymMask r) (hb : SymMask b)
    (h1 : Impossible (r ||| (1 <<< u), b))
    (h2 : Impossible (r, b ||| (1 <<< u) ||| (1 <<< (181 - u)))) :
    Impossible (r, b) := by
  intro c hn hs
  cases hu1 : c u with
  | true => exact h1 c hn ⟨set_color hs.1 hu1, hs.2⟩
  | false =>
    cases hu2 : c (181 - u) with
    | false => exact h2 c hn ⟨hs.1, set_color (set_color hs.2 hu1) hu2⟩
    | true =>
      let c' := fun x => c (181 - x)
      have hn' : ¬ Goal c' := fun hg => hn (goal_reflect hg)
      have hr' : Fact c' true 0 r := fun x hx hbit => by
        simpa [c'] using hs.1 (181 - x) (by omega) (by simpa [AtBit] using hr x hx (by simpa [AtBit] using hbit))
      have hb' : Fact c' false 0 b := fun x hx hbit => by
        simpa [c'] using hs.2 (181 - x) (by omega) (by simpa [AtBit] using hb x hx (by simpa [AtBit] using hbit))
      exact h1 c' hn' ⟨set_color hr' (by simpa [c'] using hu2), hb'⟩

private lemma sym_of_decide {m : Nat}
    (h : ∀ x : Fin 182, m.testBit x.val = true → m.testBit (181 - x.val) = true) :
    SymMask m := fun x hx hb => h ⟨x, hx⟩ hb

