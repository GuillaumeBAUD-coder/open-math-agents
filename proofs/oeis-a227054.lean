def wit (n : ℕ) : ℕ × ℕ := tbl.getD n (0, 0)

lemma wit_ok : ∀ n ∈ Finset.range 730, n = 0 ∨ n ∈ L ∨
    (1 ≤ (wit n).1 ∧ n * T (wit n).1 = T (wit n).2) := by
  decide +kernel

lemma L_small : ∀ n ∈ L, ∀ k ∈ Finset.range 27, 1 ≤ k →
    (Nat.sqrt (8 * (n * T k) + 1)) ^ 2 ≠ 8 * (n * T k) + 1 := by
  decide +kernel

lemma L_sq : ∀ n ∈ L, ∃ m ∈ Finset.range 28, n = m * m ∧ 2 ≤ m := by
  decide +kernel

lemma T_eq (k : ℕ) : 2 * T k = k * (k + 1) := by
  unfold T
  have : 2 ∣ k * (k + 1) := by
    rcases Nat.even_or_odd k with h | h
    · exact (h.two_dvd).mul_right _
    · exact (Even.two_dvd (Nat.even_add_one.mpr (Nat.not_even_iff_odd.mpr h))).mul_left _
  omega

lemma zero_of_mem (n : ℕ) (hn : n ∈ L) : IsZero n := by
  rintro ⟨k, j, hk, h⟩
  obtain ⟨m, hm27', rfl, hm2⟩ := L_sq n hn
  have hm27 : m ≤ 27 := by have := Finset.mem_range.mp hm27'; omega
  have hT := T_eq k
  have hT2 := T_eq j
  have e : (m * (2 * k + 1) : ℤ) ^ 2 - (2 * j + 1 : ℤ) ^ 2 = (m : ℤ) ^ 2 - 1 := by
    have h1 : ((m * m * T k : ℕ) : ℤ) = (T j : ℤ) := by exact_mod_cast h
    have h2 : (2 * (T k : ℤ)) = k * (k + 1) := by exact_mod_cast hT
    have h3 : (2 * (T j : ℤ)) = j * (j + 1) := by exact_mod_cast hT2
    push_cast at h1
    nlinarith
  have hm : (2 : ℤ) ≤ m := by exact_mod_cast hm2
  set X : ℤ := m * (2 * k + 1) with hX
  set Y : ℤ := 2 * j + 1 with hY
  have hk1 : (1 : ℤ) ≤ k := by exact_mod_cast hk
  have hXpos : 0 < X := by rw [hX]; positivity
  have hYpos : 0 < Y := by rw [hY]; positivity
  have hgt : Y < X := by nlinarith [sq_nonneg (X - Y), sq_nonneg (X + Y)]
  have hsum : X + Y ≤ (m : ℤ) ^ 2 - 1 := by nlinarith
  have hk' : k < 27 := by
    have : (m : ℤ) * (2 * k + 1) ≤ (m : ℤ) ^ 2 - 1 := by nlinarith
    have hmk : (2 * (k : ℤ) + 1) < m := by nlinarith
    have : (m : ℤ) ≤ 27 := by exact_mod_cast hm27
    omega
  have hjs := T_eq j
  have hsq : 8 * (m * m * T k) + 1 = (2 * j + 1) ^ 2 := by
    rw [h]; nlinarith
  apply L_small (m * m) hn k (Finset.mem_range.mpr hk') hk
  rw [hsq, Nat.sqrt_eq']

