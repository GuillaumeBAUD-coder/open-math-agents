theorem OMA.solution : type_of% @OMA.S_oeis_a227054.main := by
  intro n hn1 hn2
  open OMA.S_oeis_a227054 in
  by_cases hL : n ∈ L
  · exact ⟨fun _ => hL, fun _ => zero_of_mem n hL⟩
  · refine ⟨fun hz => ?_, fun h => absurd h hL⟩
    exfalso
    rcases wit_ok n (Finset.mem_range.mpr (by omega)) with h | h | ⟨h1, h2⟩
    · omega
    · exact hL h
    · exact hz ⟨_, _, h1, h2⟩
