private abbrev Literal := Nat × Bool
private abbrev Clause := List Literal
private abbrev Assignment := Nat × Nat

private def Holds (c : Nat → Bool) (clause : Clause) : Prop :=
  ∃ l ∈ clause, c l.1 = l.2

private def Agrees (c : Nat → Bool) (a : Assignment) : Prop :=
  ∀ i, (a.1.testBit i = true → c i = true) ∧ (a.2.testBit i = true → c i = false)

private def assign (a : Assignment) (l : Literal) : Assignment :=
  if l.2 then (a.1 ||| 2 ^ l.1, a.2) else (a.1, a.2 ||| 2 ^ l.1)

private lemma agrees_empty (c : Nat → Bool) : Agrees c (0, 0) := by
  intro i
  simp [Nat.zero_testBit]

private lemma agrees_assign {c : Nat → Bool} {a : Assignment} {l : Literal}
    (ha : Agrees c a) (hl : c l.1 = l.2) : Agrees c (assign a l) := by
  intro i
  obtain ⟨j, b⟩ := l
  cases b
  · refine ⟨(ha i).1, ?_⟩
    simp only [assign, Bool.false_eq_true, if_false, Nat.testBit_or, Nat.testBit_two_pow,
      Bool.or_eq_true, decide_eq_true_eq]
    rintro (h | rfl)
    · exact (ha i).2 h
    · exact hl
  · refine ⟨?_, (ha i).2⟩
    simp only [assign, if_true, Nat.testBit_or, Nat.testBit_two_pow,
      Bool.or_eq_true, decide_eq_true_eq]
    rintro (h | rfl)
    · exact (ha i).1 h
    · exact hl

private def assumeFalse (clause : Clause) : Assignment :=
  clause.foldl (fun a l => assign a (l.1, !l.2)) (0, 0)

private lemma agrees_assumeFalse {c : Nat → Bool} {clause : Clause}
    (h : ¬ Holds c clause) : Agrees c (assumeFalse clause) := by
  have auxiliary (ls : Clause) (a : Assignment) (ha : Agrees c a)
      (hn : ¬ Holds c ls) : Agrees c (ls.foldl (fun a l => assign a (l.1, !l.2)) a) := by
    induction ls generalizing a with
    | nil => exact ha
    | cons l ls ih =>
      have hnHead : c l.1 = !l.2 := by
        have hne : c l.1 ≠ l.2 := fun eq => hn ⟨l, List.mem_cons_self, eq⟩
        cases hc : c l.1 <;> cases hl : l.2 <;> simp_all
      exact ih _ (agrees_assign ha hnHead)
        (fun ⟨m, hm, eq⟩ => hn ⟨m, List.mem_cons_of_mem _ hm, eq⟩)
  exact auxiliary clause _ (agrees_empty c) h

private def remaining (a : Assignment) (clause : Clause) : Clause :=
  clause.filter fun l => !((if l.2 then a.2 else a.1).testBit l.1)

private lemma holds_remaining {c : Nat → Bool} {a : Assignment} {clause : Clause}
    (ha : Agrees c a) (hc : Holds c clause) : Holds c (remaining a clause) := by
  obtain ⟨⟨i, b⟩, hi, hc⟩ := hc
  refine ⟨(i, b), List.mem_filter.mpr ⟨hi, ?_⟩, hc⟩
  cases b
  · cases hb : a.1.testBit i
    · simp [hb]
    · simp_all [(ha i).1 hb]
  · cases hb : a.2.testBit i
    · simp [hb]
    · simp_all [(ha i).2 hb]

private inductive Store where
  | empty
  | leaf (clause : Clause)
  | branch (even odd : Store)

private def lookup (i : Nat) : Store → Option Clause
  | .empty => none
  | .leaf cl => some cl
  | .branch lo hi => if i % 2 = 0 then lookup (i / 2) lo else lookup (i / 2) hi

private def record : Nat → Nat → Clause → Store → Store
  | 0, _, cl, _ => .leaf cl
  | fuel + 1, i, cl, .branch lo hi =>
    if i % 2 = 0 then .branch (record fuel (i / 2) cl lo) hi
    else .branch lo (record fuel (i / 2) cl hi)
  | fuel + 1, i, cl, _ =>
    if i % 2 = 0 then .branch (record fuel (i / 2) cl .empty) .empty
    else .branch .empty (record fuel (i / 2) cl .empty)

private def Sound (c : Nat → Bool) : Store → Prop
  | .empty => True
  | .leaf cl => Holds c cl
  | .branch lo hi => Sound c lo ∧ Sound c hi

private lemma lookup_sound {c : Nat → Bool} {db : Store} (h : Sound c db)
    {i : Nat} {cl : Clause} (hcl : lookup i db = some cl) : Holds c cl := by
  induction db generalizing i with
  | empty => simp [lookup] at hcl
  | leaf row =>
    have he : row = cl := Option.some.inj hcl
    exact he ▸ h
  | branch lo hi ihLo ihHi =>
    change Sound c lo ∧ Sound c hi at h
    by_cases he : i % 2 = 0
    · exact ihLo h.1 (by simpa only [lookup, if_pos he] using hcl)
    · exact ihHi h.2 (by simpa only [lookup, if_neg he] using hcl)

private lemma record_sound {c : Nat → Bool} {db : Store} {cl : Clause}
    (hdb : Sound c db) (hcl : Holds c cl) (fuel i : Nat) : Sound c (record fuel i cl db) := by
  induction fuel generalizing db i with
  | zero => exact hcl
  | succ fuel ih =>
    cases db with
    | empty =>
      by_cases he : i % 2 = 0 <;> simp only [record, he, if_true, if_false, Sound, and_true, true_and] <;>
        exact ih (db := .empty) trivial _
    | leaf row =>
      by_cases he : i % 2 = 0 <;> simp only [record, he, if_true, if_false, Sound, and_true, true_and] <;>
        exact ih (db := .empty) trivial _
    | branch lo hi =>
      change Sound c lo ∧ Sound c hi at hdb
      by_cases he : i % 2 = 0
      · simpa only [record, if_pos he, Sound] using And.intro (ih hdb.1 (i / 2)) hdb.2
      · simpa only [record, if_neg he, Sound] using And.intro hdb.1 (ih hdb.2 (i / 2))

private def closes (db : Store) (a : Assignment) : List Nat → Bool
  | [] => false
  | i :: rest =>
    match lookup i db with
    | none => false
    | some cl =>
      match remaining a cl with
      | [] => true
      | [l] => closes db (assign a l) rest
      | _ => false

private lemma closes_sound {c : Nat → Bool} {db : Store} (hdb : Sound c db)
    {a : Assignment} {hints : List Nat} (ha : Agrees c a)
    (hclose : closes db a hints = true) : False := by
  induction hints generalizing a with
  | nil => simp [closes] at hclose
  | cons i rest ih =>
    cases hlookup : lookup i db with
    | none => simp [closes, hlookup] at hclose
    | some cl =>
      have hh := holds_remaining ha (lookup_sound hdb hlookup)
      cases hrem : remaining a cl with
      | nil => simp [hrem, Holds] at hh
      | cons l ls =>
        cases ls with
        | nil =>
          have hl : c l.1 = l.2 := by simpa [hrem, Holds] using hh
          exact ih (agrees_assign ha hl) (by simpa [closes, hlookup, hrem] using hclose)
        | cons m ls => simp [closes, hlookup, hrem] at hclose

private def unpack (width : Nat) : Nat → Nat → List Nat
  | 0, _ => []
  | fuel + 1, packed =>
    if packed = 0 then []
    else packed % (2 ^ width) :: unpack width fuel (packed / 2 ^ width)

private def learnClause (packed : Nat) : Clause :=
  (unpack 8 240 packed).map fun n => ((n - 1) / 2, n % 2 == 0)

private def learnHints (packed : Nat) : List Nat :=
  (unpack 14 600 packed).map fun n => n - 1

private def verify (db : Store) (i : Nat) : List (Nat × Nat) → Bool
  | [] => false
  | (lits, hints) :: rest =>
    let cl := learnClause lits
    if closes db (assumeFalse cl) (learnHints hints) then
      if cl.isEmpty then true
      else verify (record 14 i cl db) (i + 1) rest
    else false

private lemma verify_sound {c : Nat → Bool} {db : Store} {i : Nat} {rows : List (Nat × Nat)}
    (hdb : Sound c db) (hverify : verify db i rows = true) : False := by
  induction rows generalizing db i with
  | nil => simp [verify] at hverify
  | cons p rest ih =>
    obtain ⟨lits, hints⟩ := p
    let cl := learnClause lits
    change (if closes db (assumeFalse cl) (learnHints hints) = true then
      if cl.isEmpty then true else verify (record 14 i cl db) (i + 1) rest
      else false) = true at hverify
    split at hverify
    next hc =>
      have hcl : Holds c cl := by
        by_contra h
        exact closes_sound hdb (agrees_assumeFalse h) hc
      cases he : cl with
      | nil => simp [he, Holds] at hcl
      | cons l ls =>
        rw [he] at hverify
        exact ih (record_sound hdb (he ▸ hcl) 14 i) (by simpa using hverify)
    next => contradiction


private def reflectIndex (i : ℕ) : ℕ := min i (237 - i)

private theorem reflect_color (c : ℕ → Bool) (sym : ∀ i < 238, c (237 - i) = c i)
    (i : ℕ) (hi : i < 238) : c (reflectIndex i) = c i := by
  unfold reflectIndex
  by_cases h : i ≤ 237 - i
  · rw [min_eq_left h]
  · rw [min_eq_right (by omega), sym i hi]

private theorem reflected_witness (c : ℕ → Bool)
    (sym : ∀ i < 238, c (237 - i) = c i)
    (progress : ∀ (b : Bool) (a d : ℕ), 0 < d →
      a + ((if b then 16 else 3) - 1) * d < 238 →
      ∃ t < (if b then 16 else 3), c (a + t * d) = b)
    (b : Bool) (a d : ℕ) (hd : 0 < d)
    (ha : a + ((if b then 16 else 3) - 1) * d < 238) :
    ∃ t < (if b then 16 else 3), c (reflectIndex (a + t * d)) = b := by
  obtain ⟨t, ht, he⟩ := progress b a d hd ha
  have hle : t ≤ (if b then 16 else 3) - 1 := by omega
  have htd : a + t * d ≤ a + ((if b then 16 else 3) - 1) * d :=
    Nat.add_le_add_left (Nat.mul_le_mul_right d hle) a
  exact ⟨t, ht, (reflect_color c sym _ (htd.trans_lt ha)).trans he⟩

private def progressionClauses (b : Bool) : List Clause :=
  let length := if b then 16 else 3
  (List.range (237 / (length - 1))).flatMap fun step =>
    let d := step + 1
    (List.range ((237 - (length - 1) * d) / 2 + 1)).map fun a =>
      ((List.range length).map fun t => (reflectIndex (a + t * d), b)).eraseDups

private def initialClauses : List Clause :=
  [[(113, true)], [(114, false)], [(115, false)], [(116, false)], [(117, false)], [(118, false)]] ++
    (progressionClauses false ++ progressionClauses true)

private def introduce (db : Store) (i : Nat) : List Clause → Store
  | [] => db
  | cl :: rest => introduce (record 14 i cl db) (i + 1) rest

private lemma introduce_sound {c : Nat → Bool} {db : Store} {i : Nat} {clauses : List Clause}
    (hdb : Sound c db) (hclauses : ∀ cl ∈ clauses, Holds c cl) :
    Sound c (introduce db i clauses) := by
  induction clauses generalizing db i with
  | nil => exact hdb
  | cons cl rest ih =>
    exact ih (record_sound hdb (hclauses cl List.mem_cons_self) 14 i)
      (fun cl hm => hclauses cl (List.mem_cons_of_mem _ hm))

private lemma progression_sound (c : Nat → Bool)
    (sym : ∀ i < 238, c (237 - i) = c i)
    (progress : ∀ (b : Bool) (a d : ℕ), 0 < d →
      a + ((if b then 16 else 3) - 1) * d < 238 →
      ∃ t < (if b then 16 else 3), c (a + t * d) = b)
    (b : Bool) (cl : Clause) (hcl : cl ∈ progressionClauses b) : Holds c cl := by
  let length : Nat := if b then 16 else 3
  unfold progressionClauses at hcl
  obtain ⟨step, hstep, hm⟩ := List.mem_flatMap.mp hcl
  obtain ⟨a, ha, rfl⟩ := List.mem_map.mp hm
  have hstep' : step + 1 ≤ 237 / (length - 1) := by
    have h := List.mem_range.mp hstep
    exact Nat.succ_le_of_lt h
  have hprod : (length - 1) * (step + 1) ≤ 237 := by
    calc
      _ ≤ (237 / (length - 1)) * (length - 1) := by
        rw [Nat.mul_comm (length - 1) (step + 1)]
        exact Nat.mul_le_mul_right _ hstep'
      _ ≤ _ := Nat.div_mul_le_self _ _
  have ha' : a < (237 - (length - 1) * (step + 1)) / 2 + 1 := List.mem_range.mp ha
  have hbound : a + (length - 1) * (step + 1) < 238 := by omega
  obtain ⟨t, ht, eq⟩ := reflected_witness c sym progress b a (step + 1) (by omega) hbound
  refine ⟨(reflectIndex (a + t * (step + 1)), b), ?_, eq⟩
  exact List.mem_eraseDups.mpr (List.mem_map.mpr ⟨t, List.mem_range.mpr ht, rfl⟩)

