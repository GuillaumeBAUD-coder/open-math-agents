private lemma initialClauses_sound (c : Nat → Bool)
    (red : c 113 = true) (tail : ∀ j, 113 < j → j ≤ 118 → c j = false)
    (sym : ∀ i < 238, c (237 - i) = c i)
    (progress : ∀ (b : Bool) (a d : ℕ), 0 < d →
      a + ((if b then 16 else 3) - 1) * d < 238 →
      ∃ t < (if b then 16 else 3), c (a + t * d) = b) :
    ∀ cl ∈ initialClauses, Holds c cl := by
  intro cl hm
  rw [initialClauses, List.mem_append, List.mem_append] at hm
  rcases hm with hu | hShort | hLong
  · simp only [List.mem_cons, List.not_mem_nil, or_false] at hu
    rcases hu with rfl | rfl | rfl | rfl | rfl | rfl
    · exact ⟨(113, true), List.mem_cons_self, red⟩
    · exact ⟨(114, false), List.mem_cons_self, tail 114 (by decide) (by decide)⟩
    · exact ⟨(115, false), List.mem_cons_self, tail 115 (by decide) (by decide)⟩
    · exact ⟨(116, false), List.mem_cons_self, tail 116 (by decide) (by decide)⟩
    · exact ⟨(117, false), List.mem_cons_self, tail 117 (by decide) (by decide)⟩
    · exact ⟨(118, false), List.mem_cons_self, tail 118 (by decide) (by decide)⟩
  · exact progression_sound c sym progress false cl hShort
  · exact progression_sound c sym progress true cl hLong

private theorem unsat_of_certificate {c : Nat → Bool} {initial : List Clause}
    {rows : List (Nat × Nat)} (hs : ∀ cl ∈ initial, Holds c cl)
    (hv : verify (introduce .empty 0 initial) initial.length rows = true) : False :=
  @verify_sound c (introduce .empty 0 initial) initial.length rows
    (introduce_sound (db := .empty) (i := 0) trivial hs) hv

set_option maxHeartbeats 0 in
set_option maxRecDepth 32768 in
private theorem certificate_checks :
    verify (introduce .empty 0 initialClauses) initialClauses.length proofRows = true := by
  decide +kernel

set_option maxHeartbeats 0 in
set_option maxRecDepth 32768 in
theorem OMA.solution : OMA.R_Green14_W_3_16_R2_H2_R1_H2_R1.H2 := by
  intro c red tail valid
  change ∀ j, 113 < j → j ≤ 118 → c j = false at tail
  change (∀ i < 238, c (237 - i) = c i) ∧
    (∀ (b : Bool) (a d : ℕ), 0 < d → a + ((if b then 16 else 3) - 1) * d < 238 →
      ∃ t < (if b then 16 else 3), c (a + t * d) = b) at valid
  exact @unsat_of_certificate c initialClauses proofRows
    (initialClauses_sound c red tail valid.1 valid.2) certificate_checks
