    vec 1 (q, r, P') = if ok2 q r then ∑ s : Row, (if vs q r s then
      ∑ P : Fin 3 → Bool, (if upd q P = P' then vec 0 (r, s, P) else 0) else 0) else 0 := by
  decide +kernel

