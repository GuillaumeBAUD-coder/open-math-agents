theorem S0_card (r s : Row) (P : Fin 3 → Bool) :
    (S 0 (r, s, P)).card =
      if Good (![r, s] : Fin 2 → Row) ∧ colFlag (![r, s] : Fin 2 → Row) = P then 1 else 0 := by
  have e : S 0 (r, s, P) =
      if Good (![r, s] : Fin 2 → Row) ∧ colFlag (![r, s] : Fin 2 → Row) = P then {![r, s]}
      else ∅ := by
    ext B
    have hB : B = ![B 0, B 1] := by
      funext i; fin_cases i <;> rfl
    simp only [S, mem_filter, mem_univ, true_and, key, Prod.mk.injEq]
    split_ifs with h
    · rw [mem_singleton]
      constructor
      · rintro ⟨-, h0, h1, -⟩
        rw [hB, h0, h1]
      · rintro rfl
        exact ⟨h.1, rfl, rfl, h.2⟩
    · simp only [Finset.notMem_empty, iff_false]
      rintro ⟨hg, h0, h1, hc⟩
      have hB' : B = ![r, s] := by rw [hB, h0, h1]
      subst hB'
      exact h ⟨hg, hc⟩
  rw [e]
  split_ifs <;> simp

theorem base0 : ∀ σ : St, (S 0 σ).card = vec 0 σ := by
  rintro ⟨r, s, P⟩
  rw [S0_card]
  revert r s P
  decide +kernel

def ok2 (q r : Row) : Prop := List.ofFn q ≤ List.ofFn r ∧ hs q r

instance (q r : Row) : Decidable (ok2 q r) := by unfold ok2 hs; infer_instance

instance (q r s : Row) : Decidable (vs q r s) := by unfold vs; infer_instance

theorem factor (q r : Row) (P' : Fin 3 → Bool) (x : Row → (Fin 3 → Bool) → ℕ) :
    (∑ s : Row, ∑ P : Fin 3 → Bool, if tr q r s ∧ upd q P = P' then x s P else 0) =
      if ok2 q r then ∑ s : Row, (if vs q r s then
        ∑ P : Fin 3 → Bool, (if upd q P = P' then x s P else 0) else 0) else 0 := by
  by_cases h : ok2 q r
  · rw [if_pos h]
    refine sum_congr rfl fun s _ => ?_
    by_cases hv : vs q r s
    · rw [if_pos hv]
      exact sum_congr rfl fun P _ =>
        if_congr ⟨fun hc => hc.2, fun hc => ⟨⟨h.1, h.2, hv⟩, hc⟩⟩ rfl rfl
    · rw [if_neg hv]
      exact sum_eq_zero fun P _ => if_neg fun hc => hv hc.1.2.2
  · rw [if_neg h]
    exact sum_eq_zero fun s _ => sum_eq_zero fun P _ => if_neg fun hc => h ⟨hc.1.1, hc.1.2.1⟩

