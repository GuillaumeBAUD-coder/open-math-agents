theorem vec_step' (k : ℕ) (hk : k < 14) (q r : Row) (P' : Fin 3 → Bool) :
    vec (k + 1) (q, r, P') = if ok2 q r then ∑ s : Row, (if vs q r s then
      ∑ P : Fin 3 → Bool, (if upd q P = P' then vec k (r, s, P) else 0) else 0) else 0 := by
  interval_cases k
  · exact vstep0 q r P'
  · exact vstep1 q r P'
  · exact vstep2 q r P'
  · exact vstep3 q r P'
  · exact vstep4 q r P'
  · exact vstep5 q r P'
  · exact vstep6 q r P'
  · exact vstep7 q r P'
  · exact vstep8 q r P'
  · exact vstep9 q r P'
  · exact vstep10 q r P'
  · exact vstep11 q r P'
  · exact vstep12 q r P'
  · exact vstep13 q r P'
theorem vec_step (k : ℕ) (hk : k < 14) (q r : Row) (P' : Fin 3 → Bool) :
    vec (k + 1) (q, r, P') = ∑ s : Row, ∑ P : Fin 3 → Bool,
      if tr q r s ∧ upd q P = P' then vec k (r, s, P) else 0 := by
  rw [vec_step' k hk q r P', factor]

theorem cardS : ∀ k : ℕ, k ≤ 14 → ∀ σ : St, (S k σ).card = vec k σ := by
  intro k
  induction k with
  | zero => intro _; exact base0
  | succ k ih =>
    intro hk ⟨q, r, P'⟩
    rw [card_S_succ, vec_step k (by omega) q r P']
    refine sum_congr rfl fun s _ => sum_congr rfl fun P _ => ?_
    rw [ih (by omega)]

def D (m : ℕ) (σ : St) : ℤ :=
  ((S (m + 4) σ).card : ℤ) - 4 * (S (m + 3) σ).card + 6 * (S (m + 2) σ).card - 4 * (S (m + 1) σ).card + (S m σ).card

theorem D_succ (m : ℕ) (q r : Row) (P' : Fin 3 → Bool) :
    D (m + 1) (q, r, P') = ∑ s : Row, ∑ P : Fin 3 → Bool,
      if tr q r s ∧ upd q P = P' then D m (r, s, P) else 0 := by
  have e : D (m + 1) (q, r, P') = ((S ((m + 4) + 1) (q, r, P')).card : ℤ) - 4 * (S ((m + 3) + 1) (q, r, P')).card + 6 * (S ((m + 2) + 1) (q, r, P')).card - 4 * (S ((m + 1) + 1) (q, r, P')).card + (S (m + 1) (q, r, P')).card := rfl
  rw [e, card_S_succ (m + 4), card_S_succ (m + 3), card_S_succ (m + 2), card_S_succ (m + 1), card_S_succ m]
  push_cast
  simp only [Finset.mul_sum, ← Finset.sum_sub_distrib, ← Finset.sum_add_distrib]
  refine sum_congr rfl fun s _ => sum_congr rfl fun P _ => ?_
  split_ifs <;> simp [D]

theorem D10 : ∀ σ : St, D 10 σ = 0 := by
  intro σ
  simp only [D]
  rw [cardS 14 (by norm_num), cardS 13 (by norm_num), cardS 12 (by norm_num), cardS 11 (by norm_num), cardS 10 (by norm_num)]
  revert σ
  decide +kernel

theorem D_zero (m : ℕ) (hm : 10 ≤ m) : ∀ σ : St, D m σ = 0 := by
  induction m, hm using Nat.le_induction with
  | base => exact D10
  | succ m _ ih =>
    rintro ⟨q, r, P'⟩
    rw [D_succ]
    refine sum_eq_zero fun s _ => sum_eq_zero fun P _ => ?_
    rw [ih]; simp

def ψ (σ : St) : Prop := σ.2.2 = fun _ => true

instance : DecidablePred ψ := fun σ => by unfold ψ; infer_instance

theorem valid_iff {m : ℕ} (A : Fin (m + 2) → Row) : IsValid A ↔ Good A ∧ ψ (key A) := by
  unfold IsValid Good ψ key
  rw [cols_iff, funext_iff]
  tauto

theorem a_eq (m : ℕ) : (a (m + 1) : ℤ) = ∑ σ : St, if ψ σ then ((S m σ).card : ℤ) else 0 := by
  have h : a (m + 1) = (univ.filter (fun B : Fin (m + 2) → Row => Good B ∧ ψ (key B))).card := by
    rw [a, Nat.card_congr (Equiv.subtypeEquivRight valid_iff), Nat.card_eq_fintype_card,
      Fintype.card_subtype]
  rw [h, card_filter_key]
  push_cast
  rfl

