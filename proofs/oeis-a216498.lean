import OMAStatements.S_oeis_a216498

/-!
# Disproof of oeis-a216498

The statement says the set S of primes p admitting no d > 0 with p - d, ..., p - 5d all prime
has largest element 2521081. We show 2668453 is in S, so 2521081 is not an upper bound.

For p = 2668453, if p - kd is prime for k = 1..5 then d is divisible by 2, 3 and 5 (otherwise one
of p - kd is even, a multiple of 3 or a multiple of 5 while exceeding it). So d = 30 j with
1 <= j <= 17789. For each such j a witness q * 8 + k is listed: q is a proper factor of
p - 30 j k, checked by the kernel.
-/

namespace A216498D

/-- The witness w = q * 8 + k is valid for j: 1 <= k <= 5 and q is a proper factor of
2668453 - 30 * j * k. -/
def chk (j w : ℕ) : Bool :=
  Nat.ble 1 (w % 8) && Nat.ble (w % 8) 5 && Nat.ble 2 (w / 8) &&
    Nat.blt (w / 8) (2668453 - 30 * j * (w % 8)) &&
    Nat.beq ((2668453 - 30 * j * (w % 8)) % (w / 8)) 0

/-- Consecutive witnesses for j, j + 1, j + 2, ... -/
def chunkOk : ℕ → List ℕ → Bool
  | _, [] => true
  | j, w :: ws => chk j w && chunkOk (j + 1) ws

theorem not_prime_of_chk {j w : ℕ} (h : chk j w = true) :
    ∃ k : ℕ, 1 ≤ k ∧ k ≤ 5 ∧ ¬ (2668453 - 30 * j * k).Prime := by
  simp only [chk, Bool.and_eq_true, Nat.ble_eq, Nat.blt_eq, Nat.beq_eq] at h
  obtain ⟨⟨⟨⟨h1, h5⟩, h2⟩, hlt⟩, hmod⟩ := h
  refine ⟨w % 8, h1, h5, fun hp => ?_⟩
  rcases hp.eq_one_or_self_of_dvd (w / 8) (Nat.dvd_of_mod_eq_zero hmod) with h | h <;> omega

theorem of_chunkOk : ∀ (ws : List ℕ) (j : ℕ), chunkOk j ws = true →
    ∀ i, j ≤ i → i < j + ws.length → ∃ k : ℕ, 1 ≤ k ∧ k ≤ 5 ∧ ¬ (2668453 - 30 * i * k).Prime
  | [], j, _, i, h1, h2 => by simp at h2; omega
  | w :: ws, j, h, i, h1, h2 => by
    simp only [chunkOk, Bool.and_eq_true] at h
    rcases Nat.eq_or_lt_of_le h1 with rfl | hlt
    · exact not_prime_of_chk h.1
    · exact of_chunkOk ws (j + 1) h.2 i (by omega) (by simp at h2; omega)

