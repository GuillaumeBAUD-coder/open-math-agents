private def target : ℕ :=
  (((2 ^ 19800 - 1) : ℕ) <<< 201) ^^^
    ((2 : ℕ) ^ 211 ||| (2 : ℕ) ^ 226 ||| (2 : ℕ) ^ 541 ||| (2 : ℕ) ^ 701)

private theorem covers_target : coverWord &&& target = target := by decide +kernel

private theorem possible (n : ℕ) (hn : 200 < n) (hbound : n ≤ 20000)
    (hmiss : n ∉ ({211, 226, 541, 701} : Finset ℕ)) :
    ∃ x ∈ centers, 2 * x < n ∧ n - x ∈ centers := by
  have hnot (m : ℕ) (hm : m ∈ ({211, 226, 541, 701} : Finset ℕ)) : m ≠ n :=
    fun h => hmiss (h ▸ hm)
  have ht : target.testBit n = true := by
    have hh : n - 201 < 19800 := by omega
    rw [target, Nat.testBit_xor, Nat.testBit_shiftLeft, Nat.testBit_two_pow_sub_one]
    simp only [Nat.testBit_lor, Nat.testBit_two_pow, show 201 ≤ n by omega, hh,
      hnot 211 (by decide), hnot 226 (by decide), hnot 541 (by decide), hnot 701 (by decide),
      decide_true, decide_false] <;> rfl
  have hcover := congrArg (fun w : ℕ => w.testBit n) covers_target
  rw [Nat.testBit_land, ht] at hcover
  have hcover' : coverWord.testBit n = true := by simpa using hcover
  rw [← coverWord_eq] at hcover'
  obtain ⟨x, hx, hbit⟩ := (bitUnion_test contribution centers n).mp hcover'
  simp only [contribution, Nat.testBit_shiftLeft, Nat.testBit_shiftRight,
    Bool.and_eq_true_iff, decide_eq_true_eq] at hbit
  have heq : x + 1 + (n - (2 * x + 1)) = n - x := by omega
  rw [heq, ← centerWord_eq] at hbit
  obtain ⟨y, hy, hyEq⟩ := (bitUnion_test (fun z => (2 : ℕ) ^ z) centers (n - x)).mp hbit.2
  have hy' : y = n - x := by simpa [Nat.testBit_two_pow] using hyEq
  exact ⟨x, hx, by omega, hy' ▸ hy⟩

private theorem center_prime {n : ℕ} (hn : n ∈ centers) :
    (6 * n - 1).Prime ∧ (6 * n + 1).Prime := by
  have h := Bool.and_eq_true_iff.mp (List.all_eq_true.mp primes_ok n hn)
  exact ⟨prime_of_flag h.1, prime_of_flag h.2⟩

end TwinCenterBits

open TwinCenterBits

theorem OMA.solution : OMA.R_OeisA187759_conjecture_R1.H1 := by
  intro n hn hbound hmiss
  obtain ⟨x, hcx, hxn, hcy⟩ := possible n hn hbound hmiss
  have hpx := center_prime hcx
  have hpy := center_prime hcy
  have hx : 0 < x := by
    by_contra h
    have hx0 : x = 0 := by omega
    simp [hx0] at hpx
  have hxmem : x ∈ Icc 1 ((n - 1) / 2) := by
    apply mem_Icc.mpr
    omega
  let f (t : ℕ) : ℕ :=
    if (6 * t - 1).Prime ∧ (6 * t + 1).Prime ∧
      (6 * (n - t) - 1).Prime ∧ (6 * (n - t) + 1).Prime then 1 else 0
  change 0 < ∑ t ∈ Icc 1 ((n - 1) / 2), f t
  have hfx : f x = 1 := by simp [f, hpx.1, hpx.2, hpy.1, hpy.2]
  have hsum : f x ≤ ∑ t ∈ Icc 1 ((n - 1) / 2), f t :=
    single_le_sum (fun _ _ => Nat.zero_le _) hxmem
  omega