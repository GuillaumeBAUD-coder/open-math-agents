private def bitUnion (f : ℕ → ℕ) : List ℕ → ℕ
  | [] => 0
  | x :: xs => f x ||| bitUnion f xs

private theorem bitUnion_append (f : ℕ → ℕ) (xs ys : List ℕ) :
    bitUnion f (xs ++ ys) = bitUnion f xs ||| bitUnion f ys := by
  induction xs with
  | nil => simp [bitUnion]
  | cons x xs ih => simp [bitUnion, ih, Nat.or_assoc]

private theorem bitUnion_test (f : ℕ → ℕ) (xs : List ℕ) (n : ℕ) :
    (bitUnion f xs).testBit n = true ↔ ∃ x ∈ xs, (f x).testBit n = true := by
  induction xs with
  | nil => simp [bitUnion]
  | cons x xs ih =>
    simp only [bitUnion, Nat.testBit_lor, Bool.or_eq_true, ih, List.mem_cons]
    constructor
    · rintro (h | ⟨y, hy, ht⟩)
      · exact ⟨x, Or.inl rfl, h⟩
      · exact ⟨y, Or.inr hy, ht⟩
    · rintro ⟨y, rfl | hy, ht⟩
      · exact Or.inl ht
      · exact Or.inr ⟨y, hy, ht⟩

private def primeFlag (n : ℕ) : Bool :=
  decide (2 ≤ n ∧ n.minFac = n)

private theorem prime_of_flag {n : ℕ} (h : primeFlag n = true) : n.Prime :=
  Nat.prime_def_minFac.mpr (of_decide_eq_true h)

private def centerFlag (n : ℕ) : Bool :=
  primeFlag (6 * n - 1) && primeFlag (6 * n + 1)

