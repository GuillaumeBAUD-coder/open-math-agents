theorem OMA.solution : OMA.R_OeisA229969_conjecture_4_R1.H1 := by
  intro n h1 h2
  obtain ⟨a, b, p1, p2, p3, hx⟩ := OMA.h (n - 5) (by omega)
  rw [show n - 5 + 5 = n by omega] at b p2 p3
  refine ⟨3 * (OMA.T.getD (n - 5) 0 / 4194304 + 1), OMA.T.getD (n - 5) 0 % 1024,
    n - 3 * (OMA.T.getD (n - 5) 0 / 4194304 + 1) - OMA.T.getD (n - 5) 0 % 1024, a, by omega, by omega,
    by omega, OMA.pr_prime _ _ p1, OMA.pr_prime _ _ p2, OMA.pr_prime _ _ p3⟩
