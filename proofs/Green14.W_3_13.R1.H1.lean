private theorem one_closed : Closed oneSeed := by
  have he : oneSeed = fromBits false 0x40000000000000000000 0xfffffffffffffffffffe7fffffffffffffffffff := by decide +kernel
  rw [he]
  exact c724

private theorem oneMask_good : ∀ x : Fin 160, x.val ≤ 78 ∨ 80 < x.val →
    oneMask.testBit (5*x.val) = true := by decide +kernel

private theorem zero_impossible {d : Nat} (hd : 0 < d) (he : d ≤ 13)
    {S : Nat → Prop} (h : SymmetricCase d S) : False := by
  have hg : Good S (mark 79) := mark_good h.triples h.center (by decide)
  have ha (x : Nat) (hx : S x) : (preMask d).testBit (5*x) = true :=
    preMask_good ⟨d,by omega⟩ ⟨x,by have := h.bound x hx; omega⟩ (h.allowed x hx)
  apply all_zero_seeds d hd he S (fun x hx => by have := h.bound x hx; omega)
    h.triples (hits_of (small:=true) h.meets)
  · exact join_good hg (mark_good h.triples h.left (by omega))
  · exact add_safe hg ha h.left

private theorem gap_one_impossible {r : Fin 160 → Bool} (hn : ¬ Goal r)
    (hr : r (Fin.ofNat 160 78) = true)
    (hb : ∀ i : Fin 160, 78 < i.val → i.val < 81 → r i = false) : False := by
  obtain ⟨S,hs,ht,hm,hseed,ha⟩ := normalized_one hn hr hb
  apply one_closed S (fun x hx => by have := hs x hx; omega) ht (hits_of (small:=false) hm)
  · exact mark_good ht hseed (by decide)
  · intro x hx
    exact oneMask_good ⟨x,hs x hx⟩ (ha x hx)

end OMA.Green14Near

open OMA.Green14Near in
theorem OMA.solution : OMA.R_Green14_W_3_13_R1.H1 := by
  intro r j _ hhi hr hb
  change Goal r
  apply Classical.byContradiction
  intro hn
  rcases (show j.val = 0 ∨ j.val = 1 by omega) with hj | hj
  · obtain ⟨d,hd,he,S,hs⟩ := normalized_zero hn (by simpa only [hj] using hr)
    exact zero_impossible hd he hs
  · apply gap_one_impossible hn (by simpa only [hj] using hr)
    simpa only [hj] using hb
