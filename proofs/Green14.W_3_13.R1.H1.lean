private def R (o : Nat) (r : Fin 160 → Bool) (x : Nat) : Prop :=
  o ≤ x ∧ x < o + 160 ∧ r (Fin.ofNat 160 (x - o)) = true

private theorem noTriple_of {r : Fin 160 → Bool} (hn : ¬ Goal r) (o : Nat) :
    NoTriple (R o r) := by
  intro a d hd h₀ h₁ h₂
  obtain ⟨ha, _, h₀⟩ := h₀
  obtain ⟨_, _, h₁⟩ := h₁
  obtain ⟨_, he, h₂⟩ := h₂
  apply hn
  have hend : a - o + 2 * d < 160 := by omega
  refine ⟨true, ⟨a - o, by omega⟩, ⟨d, by omega⟩, hd, hend, ?_⟩
  intro t ht
  change t.val ≤ 2 at ht
  change r (Fin.ofNat 160 (a - o + t.val * d)) = true
  rcases (show t.val = 0 ∨ t.val = 1 ∨ t.val = 2 by omega) with hz | hu | ht
  · simpa only [hz, Nat.zero_mul, Nat.add_zero] using h₀
  · simpa only [hu, Nat.one_mul, show a + d - o = a - o + d by omega] using h₁
  · simpa only [ht, show a + 2 * d - o = a - o + 2 * d by omega] using h₂

private theorem red_hits {r : Fin 160 → Bool} (hn : ¬ Goal r) {o a d : Nat}
    (ha : o ≤ a) (hd : 0 < d) (he : a + 12 * d < o + 160) :
    ∃ t ≤ 12, R o r (a + t * d) := by
  apply Classical.byContradiction
  intro h
  apply hn
  have hend : a - o + 12 * d < 160 := by omega
  refine ⟨false, ⟨a - o, by omega⟩, ⟨d, by omega⟩, hd, hend, ?_⟩
  intro t ht
  change t.val ≤ 12 at ht
  change r (Fin.ofNat 160 (a - o + t.val * d)) = false
  cases hv : r (Fin.ofNat 160 (a - o + t.val * d)) with
  | false => rfl
  | true =>
    exfalso
    apply h
    have htd : t.val * d ≤ 12 * d := Nat.mul_le_mul_right d ht
    refine ⟨t.val, ht, by omega, by omega, ?_⟩
    simpa only [show a + t.val * d - o = a - o + t.val * d by omega] using hv

-- The centered 159-site restriction is the observation of ZedingZhang in PR 5287.
private def LineMeets (n : Nat) (S : Nat → Prop) : Prop :=
  ∀ a d, 0 < d → a + 12*d < n → ∃ t ≤ 12, S (a+t*d)

private theorem base_bit : ∀ d : Fin 14, 0 < d.val → ∀ t : Fin 13,
    bases[d.val-1]!.testBit (5*(t.val*d.val)) = true := by decide +kernel

private theorem lineBit {d : Nat} (hd : 0 < d) (hd' : d ≤ 13) {t : Nat} (ht : t ≤ 12) (a : Nat) :
    (bases[d-1]! <<< (5*a)).testBit (5*(a+t*d)) = true := by
  simpa [Nat.testBit_shiftLeft, Nat.mul_add, Nat.le_add_right] using
    base_bit ⟨d,by omega⟩ hd ⟨t,by omega⟩

private theorem hits_of {small : Bool} {S : Nat → Prop}
    (hm : LineMeets (if small then 159 else 160) S) : Hits small S := by
  intro i
  let d := i/161+1
  let e := i%161
  by_cases h : 12*d ≤ e ∧ e < (if small then 159 else 160)
  · have hd : 0 < d := by dsimp [d]; omega
    have hc : (if small then 159 else 160) ≤ 160 := by cases small <;> decide
    have hd' : d ≤ 13 := by omega
    obtain ⟨t, ht, hr⟩ := hm (e-12*d) d hd (by omega)
    refine ⟨_, ?_, hr⟩
    simpa only [pattern, show 12*(i/161+1) ≤ i%161 ∧ i%161 < (if small then 159 else 160) from h, true_and, if_true] using lineBit hd hd' ht (e-12*d)
  · have he : 0+12*1 < (if small then 159 else 160) := by cases small <;> decide
    obtain ⟨t,ht,hr⟩ := hm 0 1 (by decide) he
    refine ⟨_, ?_, hr⟩
    simpa [pattern, show ¬(12*(i/161+1) ≤ i%161 ∧ i%161 < (if small then 159 else 160)) from h] using lineBit (d:=1) (by decide) (by decide) ht 0


private def Flip159 (S : Nat → Prop) (x : Nat) : Prop := x ≤ 158 ∧ S (158-x)

private theorem flip_noTriple {S : Nat → Prop} (hn : NoTriple S) :
    NoTriple (Flip159 S) := by
  intro a d hd h₀ h₁ h₂
  obtain ⟨_,h₀⟩ := h₀
  obtain ⟨_,h₁⟩ := h₁
  obtain ⟨he,h₂⟩ := h₂
  apply hn (158-(a+2*d)) d hd h₂
  · simpa only [show 158-(a+2*d)+d = 158-(a+d) by omega] using h₁
  · simpa only [show 158-(a+2*d)+2*d = 158-a by omega] using h₀

private theorem flip_lineMeets {S : Nat → Prop} (hh : LineMeets 159 S) :
    LineMeets 159 (Flip159 S) := by
  intro a d hd he
  obtain ⟨t,ht,hr⟩ := hh (158-(a+12*d)) d hd (by omega)
  have hmul := Nat.mul_le_mul_right d ht
  refine ⟨12-t, by omega, ?_, ?_⟩
  · rw [Nat.sub_mul]
    omega
  · have heq : 158-(a+(12-t)*d) = 158-(a+12*d)+t*d := by
      rw [Nat.sub_mul]
      omega
    exact heq.symm ▸ hr

private theorem first_radius {P : Nat → Prop} {n : Nat} (h : P n) :
    ∃ d, P d ∧ ∀ k, k < d → ¬P k := by
  induction n using Nat.strongRecOn with
  | ind n ih =>
    by_cases small : ∃ k, k < n ∧ P k
    · obtain ⟨k,hkn,hk⟩ := small
      exact ih k hkn hk
    · exact ⟨n,h,fun k hk hp => small ⟨k,hk,hp⟩⟩

private theorem h1_normal_allowed {d : Nat} (hd : 0 < d) (hd' : d ≤ 13)
    {S : Nat → Prop} (hn : NoTriple S) (hcenter : S 79) (hleft : S (79-d))
    (hempty : ∀ k, 0 < k → k < d → ¬S (79-k) ∧ ¬S (79+k)) :
    ∀ x, S x → x ≤ 79-d ∨ x = 79 ∨ 79+d < x := by
  intro x hx
  by_cases h₁ : x ≤ 79-d
  · exact Or.inl h₁
  by_cases h₂ : x = 79
  · exact Or.inr (Or.inl h₂)
  by_cases h₃ : 79+d < x
  · exact Or.inr (Or.inr h₃)
  exfalso
  by_cases hlo : x < 79
  · have hf := (hempty (79-x) (by omega) (by omega)).1
    apply hf
    simpa only [show 79-(79-x) = x by omega] using hx
  by_cases hface : x = 79+d
  · apply hn (79-d) d hd hleft
    · simpa only [show 79-d+d = 79 by omega] using hcenter
    · simpa only [show 79-d+2*d = x by omega] using hx
  have hf := (hempty (x-79) (by omega) (by omega)).2
  apply hf
  simpa only [show 79+(x-79) = x by omega] using hx

private structure SymmetricCase (d : Nat) (S : Nat → Prop) : Prop where
  bound : ∀ x, S x → x ≤ 158
  triples : NoTriple S
  meets : LineMeets 159 S
  center : S 79
  left : S (79-d)
  allowed : ∀ x, S x → x ≤ 79-d ∨ x = 79 ∨ 79+d < x

private theorem normalized_zero {r : Fin 160 → Bool} (hn : ¬ Goal r)
    (hred : r (Fin.ofNat 160 79) = true) :
    ∃ d, 0 < d ∧ d ≤ 13 ∧ ∃ S : Nat → Prop, SymmetricCase d S := by
  let S := fun x => x ≤ 158 ∧ R 0 r x
  have bound (x : Nat) (hx : S x) : x ≤ 158 := hx.1
  have triples : NoTriple S := fun a d hd h₀ h₁ h₂ =>
    noTriple_of hn 0 a d hd h₀.2 h₁.2 h₂.2
  have meets : LineMeets 159 S := by
    intro a d hd he
    obtain ⟨t,ht,hr⟩ := red_hits hn (o:=0) (a:=a) (by omega) hd (by omega)
    have hmul := Nat.mul_le_mul_right d ht
    exact ⟨t,ht,by omega,hr⟩
  have center : S 79 := ⟨by decide,by decide,by decide,hred⟩
  let P := fun k => 0 < k ∧ k ≤ 13 ∧ (S (79-k) ∨ S (79+k))
  obtain ⟨t,ht,hr⟩ := meets 80 1 (by decide) (by decide)
  have hex : P (1+t) := by
    refine ⟨by omega,by omega,Or.inr ?_⟩
    simpa only [Nat.mul_one, show 79+(1+t)=80+t by omega] using hr
  obtain ⟨d,⟨hd,hd',hnear⟩,hmin⟩ := first_radius hex
  have bothBlue (k : Nat) (hk : 0 < k) (hkd : k < d) : ¬S (79-k) ∧ ¬S (79+k) :=
    ⟨fun hl => hmin k hkd ⟨hk, by omega, Or.inl hl⟩,
     fun hr => hmin k hkd ⟨hk, by omega, Or.inr hr⟩⟩
  refine ⟨d,hd,hd',?_⟩
  rcases hnear with hl | hr
  · exact ⟨S,bound,triples,meets,center,hl,h1_normal_allowed hd hd' triples center hl bothBlue⟩
  · have fc : Flip159 S 79 := ⟨by decide,center⟩
    have fl : Flip159 S (79-d) := by
      exact ⟨by omega,by simpa only [show 158-(79-d)=79+d by omega] using hr⟩
    have empty (k : Nat) (hk : 0 < k) (hkd : k < d) :
        ¬Flip159 S (79-k) ∧ ¬Flip159 S (79+k) := by
      refine ⟨fun h => (bothBlue k hk hkd).2 ?_,fun h => (bothBlue k hk hkd).1 ?_⟩
      · simpa only [show 158-(79-k)=79+k by omega] using h.2
      · simpa only [show 158-(79+k)=79-k by omega] using h.2
    exact ⟨Flip159 S, fun _ h => h.1, flip_noTriple triples, flip_lineMeets meets,
      fc, fl, h1_normal_allowed hd hd' (flip_noTriple triples) fc fl empty⟩

private theorem normalized_one {r : Fin 160 → Bool} (hn : ¬ Goal r)
    (hr : r (Fin.ofNat 160 78) = true)
    (hb : ∀ i : Fin 160, 78 < i.val → i.val < 81 → r i = false) :
    ∃ S : Nat → Prop, (∀ x, S x → x < 160) ∧ NoTriple S ∧ LineMeets 160 S ∧
      S 78 ∧ (∀ x, S x → x ≤ 78 ∨ 80 < x) := by
  refine ⟨R 0 r, fun x hx => hx.2.1, noTriple_of hn 0, ?_, ⟨by decide,by decide,hr⟩, ?_⟩
  · intro a d hd he
    exact red_hits hn (by omega) hd he
  · intro x hx
    by_cases hl : x ≤ 78
    · exact Or.inl hl
    by_cases hu : 80 < x
    · exact Or.inr hu
    exfalso
    have hx' : x < 160 := hx.2.1
    have hval : (Fin.ofNat 160 x).val = x := by
      simp only [Fin.val_ofNat, Nat.mod_eq_of_lt hx']
    have hb' := hb (Fin.ofNat 160 x) (by omega) (by omega)
    have hr' : r (Fin.ofNat 160 x) = true := hx.2.2
    rw [hb'] at hr'
    cases hr'

