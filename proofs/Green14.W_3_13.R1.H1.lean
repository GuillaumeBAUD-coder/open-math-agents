private def R (o : Nat) (r : Fin 160 → Bool) (x : Nat) : Prop :=
  o ≤ x ∧ x < o + 160 ∧ r (Fin.ofNat 160 (x - o)) = true

private theorem noTriple_of {r : Fin 160 → Bool} (hn : ¬ Goal r) (o : Nat) :
    NoTriple (R o r) := by
  intro a d hd h₀ h₁ h₂
  obtain ⟨ha, _, h₀⟩ := h₀
  obtain ⟨_, _, h₁⟩ := h₁
  obtain ⟨_, he, h₂⟩ := h₂
  apply hn
  have hend : a - o + 2 * d < 160 := by omega
  refine ⟨true, ⟨a - o, by omega⟩, ⟨d, by omega⟩, hd, hend, ?_⟩
  intro t ht
  change t.val ≤ 2 at ht
  change r (Fin.ofNat 160 (a - o + t.val * d)) = true
  rcases (show t.val = 0 ∨ t.val = 1 ∨ t.val = 2 by omega) with hz | hu | ht
  · simpa only [hz, Nat.zero_mul, Nat.add_zero] using h₀
  · simpa only [hu, Nat.one_mul, show a + d - o = a - o + d by omega] using h₁
  · simpa only [ht, show a + 2 * d - o = a - o + 2 * d by omega] using h₂

private theorem red_hits {r : Fin 160 → Bool} (hn : ¬ Goal r) {o a d : Nat}
    (ha : o ≤ a) (hd : 0 < d) (he : a + 12 * d < o + 160) :
    ∃ t ≤ 12, R o r (a + t * d) := by
  apply Classical.byContradiction
  intro h
  apply hn
  have hend : a - o + 12 * d < 160 := by omega
  refine ⟨false, ⟨a - o, by omega⟩, ⟨d, by omega⟩, hd, hend, ?_⟩
  intro t ht
  change t.val ≤ 12 at ht
  change r (Fin.ofNat 160 (a - o + t.val * d)) = false
  cases hv : r (Fin.ofNat 160 (a - o + t.val * d)) with
  | false => rfl
  | true =>
    exfalso
    apply h
    have htd : t.val * d ≤ 12 * d := Nat.mul_le_mul_right d ht
    refine ⟨t.val, ht, by omega, by omega, ?_⟩
    simpa only [show a + t.val * d - o = a - o + t.val * d by omega] using hv

-- The centered 159-site restriction is the observation of ZedingZhang in PR 5287.
private def LineMeets (n : Nat) (S : Nat → Prop) : Prop :=
  ∀ a d, 0 < d → a + 12*d < n → ∃ t ≤ 12, S (a+t*d)

private def Flip159 (S : Nat → Prop) (x : Nat) : Prop := x ≤ 158 ∧ S (158-x)

private theorem flip_noTriple {S : Nat → Prop} (hn : NoTriple S) :
    NoTriple (Flip159 S) := by
  intro a d hd h₀ h₁ h₂
  obtain ⟨_,h₀⟩ := h₀
  obtain ⟨_,h₁⟩ := h₁
  obtain ⟨he,h₂⟩ := h₂
  apply hn (158-(a+2*d)) d hd h₂
  · simpa only [show 158-(a+2*d)+d = 158-(a+d) by omega] using h₁
  · simpa only [show 158-(a+2*d)+2*d = 158-a by omega] using h₀

private theorem flip_lineMeets {S : Nat → Prop} (hh : LineMeets 159 S) :
    LineMeets 159 (Flip159 S) := by
  intro a d hd he
  obtain ⟨t,ht,hr⟩ := hh (158-(a+12*d)) d hd (by omega)
  have hmul := Nat.mul_le_mul_right d ht
  refine ⟨12-t, by omega, ?_, ?_⟩
  · rw [Nat.sub_mul]
    omega
  · have heq : 158-(a+(12-t)*d) = 158-(a+12*d)+t*d := by
      rw [Nat.sub_mul]
      omega
    exact heq.symm ▸ hr

private structure NearCase (S : Nat → Prop) : Prop where
  bound : ∀ x, S x → x ≤ 157
  triples : NoTriple S
  meets : LineMeets 158 S
  center : S 78
  shape : (¬S 79 ∧ ¬S 80) ∨ (S 76 ∧ S 79)

private theorem shiftWindow {T : Nat → Prop} (ht : NoTriple T)
    (hm : LineMeets 159 T) (hr : T 79)
    (shape : (¬T 80 ∧ ¬T 81) ∨ (T 77 ∧ T 80)) : ∃ S, NearCase S := by
  let S := fun x => x ≤ 157 ∧ T (x+1)
  refine ⟨S, fun _ h => h.1, ?_, ?_, ⟨by decide, hr⟩, ?_⟩
  · intro a d hd h₀ h₁ h₂
    apply ht (a+1) d hd h₀.2
    · simpa only [show a+1+d=(a+d)+1 by omega] using h₁.2
    · simpa only [show a+1+2*d=(a+2*d)+1 by omega] using h₂.2
  · intro a d hd he
    obtain ⟨t, h, hred⟩ := hm (a+1) d hd (by omega)
    have htd := Nat.mul_le_mul_right d h
    exact ⟨t, h, by omega, by simpa only [show a+1+t*d = a+t*d+1 by omega] using hred⟩
  · rcases shape with ⟨h₁,h₂⟩|⟨h₁,h₂⟩
    · exact Or.inl ⟨fun h => h₁ h.2, fun h => h₂ h.2⟩
    · exact Or.inr ⟨⟨by decide,h₁⟩,⟨by decide,h₂⟩⟩

private theorem windowZero {r : Fin 160 → Bool} (hn : ¬Goal r)
    (ha : r (Fin.ofNat 160 79) = true) : ∃ S, NearCase S := by
  let T := fun x => x ≤ 158 ∧ R 0 r x
  have ht : NoTriple T := fun a d hd h₀ h₁ h₂ => noTriple_of hn 0 a d hd h₀.2 h₁.2 h₂.2
  have hm : LineMeets 159 T := by
    intro a d hd he
    obtain ⟨t,h,hr⟩ := red_hits hn (o:=0) (a:=a) (by omega) hd (by omega)
    have htd := Nat.mul_le_mul_right d h
    exact ⟨t,h,by omega,hr⟩
  have hc : T 79 := ⟨by decide,by decide,by decide,ha⟩
  have flip := shiftWindow (T:=Flip159 T) (flip_noTriple ht) (flip_lineMeets hm)
    (show Flip159 T 79 from ⟨by decide,hc⟩)
  by_cases h80 : T 80
  · have h78 : ¬T 78 := fun h => ht 78 1 (by decide) h hc h80
    by_cases h77 : T 77
    · exact shiftWindow ht hm hc (Or.inr ⟨h77,h80⟩)
    · exact flip (Or.inl ⟨fun h => h78 h.2, fun h => h77 h.2⟩)
  · by_cases h81 : T 81
    · have h77 : ¬T 77 := fun h => ht 77 2 (by decide) h hc h81
      by_cases h78 : T 78
      · exact flip (Or.inr ⟨⟨by decide,h81⟩,⟨by decide,h78⟩⟩)
      · exact flip (Or.inl ⟨fun h => h78 h.2, fun h => h77 h.2⟩)
    · exact shiftWindow ht hm hc (Or.inl ⟨h80,h81⟩)

private theorem windowOne {r : Fin 160 → Bool} (hn : ¬Goal r)
    (ha : r (Fin.ofNat 160 78) = true)
    (hb : ∀ i : Fin 160, 78 < i.val → i.val < 81 → r i = false) : ∃ S, NearCase S := by
  let S := fun x => x ≤ 157 ∧ R 0 r x
  refine ⟨S, fun _ h => h.1, ?_, ?_, ⟨by decide,by decide,by decide,ha⟩, Or.inl ⟨?_,?_⟩⟩
  · exact fun a d hd h₀ h₁ h₂ => noTriple_of hn 0 a d hd h₀.2 h₁.2 h₂.2
  · intro a d hd he
    obtain ⟨t,h,hr⟩ := red_hits hn (o:=0) (a:=a) (by omega) hd (by omega)
    have htd := Nat.mul_le_mul_right d h
    exact ⟨t,h,by omega,hr⟩
  · intro h
    have he : r (Fin.ofNat 160 79) = true := h.2.2.2
    rw [hb (Fin.ofNat 160 79) (by decide) (by decide)] at he
    cases he
  · intro h
    have he : r (Fin.ofNat 160 80) = true := h.2.2.2
    rw [hb (Fin.ofNat 160 80) (by decide) (by decide)] at he
    cases he

private theorem base_bit : ∀ d : Fin 14, 0 < d.val → ∀ t : Fin 13,
    bases[d.val-1]!.testBit (5*(t.val*d.val)) = true := by decide +kernel

private theorem lineBit {d : Nat} (hd : 0 < d) (hd' : d ≤ 13) {t : Nat} (ht : t ≤ 12) (a : Nat) :
    (bases[d-1]! <<< (5*a)).testBit (5*(a+t*d)) = true := by
  simpa [Nat.testBit_shiftLeft, Nat.mul_add, Nat.le_add_right] using
    base_bit ⟨d,by omega⟩ hd ⟨t,by omega⟩

private theorem hits_of {S : Nat → Prop} (hm : LineMeets 158 S) : Hits S := by
  intro i
  let d := i/161+1
  let e := i%161
  by_cases h : 12*d ≤ e ∧ e < 158
  · have hd : 0 < d := by dsimp [d]; omega
    have hd' : d ≤ 13 := by omega
    obtain ⟨t, ht, hr⟩ := hm (e-12*d) d hd (by omega)
    refine ⟨_, ?_, hr⟩
    simpa only [pattern, show 12*(i/161+1) ≤ i%161 ∧ i%161 < 158 from h, true_and, if_true] using lineBit hd hd' ht (e-12*d)
  · obtain ⟨t,ht,hr⟩ := hm 0 1 (by decide) (by decide)
    refine ⟨_, ?_, hr⟩
    simpa [pattern, show ¬(12*(i/161+1) ≤ i%161 ∧ i%161 < 158) from h] using lineBit (d:=1) (by decide) (by decide) ht 0


private def seedA : State := ((mark 78,0x21084210842108421084210842108421084210842108421084210842108421084210842108421084210842108421084200042108421084210842108421084210842108421084210842108421084210842108421084210842108421084210842108421),pointHits 78)
private def seedB : State := leftStep (leftStep ((mark 78,0x21084210842108421084210842108421084210842108421084210842108421084210842108421084210842108421084210842108421084210842108421084210842108421084210842108421084210842108421084210842108421084210842108421),pointHits 78) 79) 76

private theorem solvedA : Closed seedA := by
  have h : seedA = fromBits 0x40000000000000000000 0x3ffffffffffffffffffe7fffffffffffffffffff := by decide +kernel
  rw [h]
  exact c773

private theorem solvedB : Closed seedB := by
  have h : seedB = fromBits 0xd0000000000000000000 0x3ffffffffffffffffffad9ffffffffffffffffff := by decide +kernel
  rw [h]
  exact c800

private theorem impossible {S : Nat → Prop} (h : NearCase S) : False := by
  have bound (x : Nat) (hx : S x) : x ≤ 160 := by have := h.bound x hx; omega
  have good := mark_good h.triples h.center (by decide)
  rcases h.shape with ⟨h79,h80⟩ | ⟨h76,h79⟩
  · apply solvedA S bound h.triples (hits_of h.meets) good
