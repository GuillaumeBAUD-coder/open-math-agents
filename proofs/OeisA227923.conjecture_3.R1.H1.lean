def OMA.chk (n c : ℕ) : Bool :=
    decide (0 < (c % 4096)) &&
    decide ((c % 4096) < n) &&
    OMA.pb (6 * (c % 4096) - 1) (c / 4096 % 4096) &&
    OMA.pb (12 * (c % 4096) - 1) (c / 4096 % 4096) &&
    OMA.pb (6 * (n - (c % 4096)) + 1) (c / 4096 % 4096) &&
    OMA.pb (6 * (n - (c % 4096)) + 5) (c / 4096 % 4096)

