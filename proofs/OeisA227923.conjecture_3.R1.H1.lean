theorem OMA.h : ∀ i < 1000, OMA.chk (i + 2) (OMA.T.getD i 0) = true := by
  decide +kernel

theorem OMA.solution : OMA.R_OeisA227923_conjecture_3_R1.H1 := by
  intro n h1 h2
  have h := OMA.h (n - 2) (by omega)
  rw [show n - 2 + 2 = n by omega] at h
  generalize OMA.T.getD (n - 2) 0 = c at h
  simp only [OMA.chk, Bool.and_eq_true, decide_eq_true_eq] at h
  obtain ⟨⟨⟨⟨⟨a0, a1⟩, p0⟩, p1⟩, p2⟩, p3⟩ := h
  exact ⟨(c % 4096), (n - (c % 4096)), a0, by omega, by omega, OMA.pb_prime p0, OMA.pb_prime p1,
    OMA.pb_prime p2, OMA.pb_prime p3⟩
