/-- The generating function. -/
theorem gf : PowerSeries.mk (fun n => (a n : ℚ)) * (X ^ 14 + X ^ 13 + X ^ 12 - X ^ 9 - X ^ 8 - 2 * X ^ 7 - X ^ 6 - X ^ 5 + X ^ 2 + X + 1) =
      X ^ 14 + 6 * X ^ 13 + 16 * X ^ 12 + 32 * X ^ 11 + 49 * X ^ 10 + 67 * X ^ 9 + 79 * X ^ 8 + 83 * X ^ 7 + 79 * X ^ 6 + 67 * X ^ 5 + 49 * X ^ 4 + 32 * X ^ 3 + 16 * X ^ 2 + 6 * X + 1 := by
  set A : ℚ⟦X⟧ := PowerSeries.mk (fun n => (a n : ℚ)) with hA
  rw [gf_den A, gf_num]
  ext n
  have hc : ∀ k, coeff k A = (b k : ℚ) := fun k => by rw [hA, coeff_mk, a_eq_b]
  simp only [map_add, map_sub, coeff_C_mul, coeff_mul_C, coeff_X_pow, coeff_mul_X_pow', hc]
  rcases Nat.lt_or_ge n 15 with hn | hn
  · linarith [gf_low n hn]
  · obtain ⟨q, rfl⟩ : ∃ q, n = q + 15 := ⟨n - 15, by omega⟩
    linarith [gf_high q]

end Count

