theorem OMA.solution : OMA.R_Green14_W_3_13_R1.H3 := by
  intro r j lo hi red blue
  have hj : j.val = 4 ∨ j.val = 5 ∨ j.val = 6 := by omega
  rcases hj with h | h | h
  · exact OMA.CentralGap160.center4 r (by simpa [h] using red) (by simpa [h] using blue)
  · exact OMA.CentralGap160.center5 r (by simpa [h] using red) (by simpa [h] using blue)
