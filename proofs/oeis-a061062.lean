import OMAStatements.S_oeis_a061062

namespace OMA.P_oeis_a061062

open OMA.S_oeis_a061062

private def run (p : ℕ) : ℕ → ℕ → ℕ → ℕ → ℕ × ℕ × ℕ
  | 0, k, f, a => (k, f, a)
  | n + 1, k, f, a => run p n (k + 1) ((f * (k + 1)) % p) ((a + f * f) % p)

private def GoodState (p : ℕ) (s : ℕ × ℕ × ℕ) : Prop :=
  s.2.1 = s.1.factorial % p ∧ s.2.2 = (∑ j ∈ Finset.range s.1, j.factorial ^ 2) % p

private lemma goodState_run (p : ℕ) :
    ∀ (n k f a : ℕ), GoodState p (k, f, a) → GoodState p (run p n k f a) := by
  intro n
  induction n with
  | zero => intro k f a h; exact h
  | succ n ih =>
    intro k f a ⟨hf, ha⟩
    dsimp only at hf ha
    apply ih
    constructor
    · dsimp only
      rw [hf, Nat.factorial_succ, mul_comm, Nat.mul_mod_mod]
    · dsimp only
      rw [Finset.sum_range_succ, ha, hf, sq]
      rw [Nat.add_mod, Nat.mod_mod, Nat.mul_mod, Nat.mod_mod, ← Nat.mul_mod]
      conv_rhs => rw [Nat.add_mod]

private lemma goodState_step {n k f a k' f' a' : ℕ}
    (h : GoodState 20879 (k, f, a)) (heq : run 20879 n k f a = (k', f', a')) :
    GoodState 20879 (k', f', a') := heq ▸ goodState_run 20879 n k f a h

private lemma prime_20879 : Nat.Prime 20879 := by norm_num

