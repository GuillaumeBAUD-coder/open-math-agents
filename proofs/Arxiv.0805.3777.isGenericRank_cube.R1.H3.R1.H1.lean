import OMAReductions.R_Arxiv_0805_3777_isGenericRank_cube_R1_H3_R1

/-! Dimensions one and two have diagonal configurations. In dimensions four and
seven the displayed binary configurations have surjective tangent matrices.
Each column mask encodes the rows in lexicographic order. The preimage masks
give the linear combinations producing the unit vectors modulo two. A nonzero
determinant modulo two lifts the verified rank bound to the complex numbers. -/

namespace TensorRankSpanning


def coordinates_span (n r : ℕ) : Prop :=
  ∃ a b c : Fin r → Fin n → ℂ, ∀ T : Fin n → Fin n → Fin n → ℂ,
    ∃ u v w : Fin r → Fin n → ℂ, ∀ i j k,
      T i j k = ∑ t, (u t i * (b t j * c t k) +
        a t i * (v t j * c t k) + a t i * (b t j * w t k))

def delta {n : ℕ} (t i : Fin n) : ℂ := if i = t then 1 else 0

lemma sum_delta_pair {n : ℕ} (i j : Fin n) (v : Fin n → ℂ) :
    (∑ t, delta t i * delta t j * v t) = if i = j then v i else 0 := by
  classical
  rw [Finset.sum_eq_single i]
  · by_cases h : i = j
    · subst j; simp [delta]
    · simp [delta, h, Ne.symm h]
  · intro t _ ht
    simp [delta, Ne.symm ht]
  · simp

/-- When every triple has a repeated index, diagonal simple tensors span all
coordinate directions through their tangent spaces. -/
lemma diagonal_spans (n : ℕ) (repeat_idx : ∀ i j k : Fin n, i = j ∨ i = k ∨ j = k) :
    coordinates_span n n := by
  classical
  refine ⟨delta, delta, delta, ?_⟩
  intro T
  let u (t i : Fin n) := T i t t
  let v (t j : Fin n) := if j = t then 0 else T t j t
  let w (t k : Fin n) := if k = t then 0 else T t t k
  refine ⟨u, v, w, ?_⟩
  intro i j k
  have he : (∑ t, (u t i * (delta t j * delta t k) +
      delta t i * (v t j * delta t k) + delta t i * (delta t j * w t k))) =
      (∑ t, delta t j * delta t k * u t i) +
      (∑ t, delta t i * delta t k * v t j) +
       ∑ t, delta t i * delta t j * w t k := by
    rw [← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro t _
    ring
  rw [he, sum_delta_pair, sum_delta_pair, sum_delta_pair]
  dsimp only [u, v, w]
  by_cases hij : i = j
  · subst j
    by_cases hik : i = k
    · subst k; simp
    · simp [hik, Ne.symm hik]
  · by_cases hik : i = k
    · subst k; simp [hij, Ne.symm hij]
    · have hjk : j = k := ((repeat_idx i j k).resolve_left hij).resolve_left hik
      subst k; simp [hij]

end TensorRankSpanning

namespace TensorRankCertificates

def intBit (b : Bool) : ℤ := if b then 1 else 0
def fieldBit (b : Bool) : ZMod 2 := if b then 1 else 0

lemma cast_intBit (b : Bool) : ((intBit b : ℤ) : ZMod 2) = fieldBit b := by cases b <;> rfl

lemma fieldBit_xor (a b : Bool) : fieldBit (a ^^ b) = fieldBit a + fieldBit b := by
  cases a <;> cases b <;> decide

/-- XOR of the columns whose index occurs in the mask. -/
def xorColumns (cols : ℕ → ℕ) (mask : ℕ) : ℕ → ℕ
  | 0 => 0
  | m + 1 => xorColumns cols mask m ^^^ (if mask.testBit m then cols m else 0)

lemma xorColumns_entry (cols : ℕ → ℕ) (mask row m : ℕ) :
    fieldBit ((xorColumns cols mask m).testBit row) =
      ∑ j ∈ Finset.range m, fieldBit ((cols j).testBit row) * fieldBit (mask.testBit j) := by
  induction m with
  | zero => simp [xorColumns, fieldBit]
  | succ m ih =>
    rw [xorColumns, Nat.testBit_xor, fieldBit_xor, ih, Finset.sum_range_succ]
    cases mask.testBit m <;> simp [fieldBit]

lemma complex_surjectivity {ι κ : Type} [Fintype ι] [DecidableEq ι] [Fintype κ]
    (A : Matrix ι κ ℤ) (B : Matrix κ ι ℤ)
    (hab : A.map (Int.castRingHom (ZMod 2)) * B.map (Int.castRingHom (ZMod 2)) = 1) :
    Function.Surjective (A.map (Int.castRingHom ℂ)).mulVec := by
  let C := A * B
  have h2 : ((C.det : ℤ) : ZMod 2) = 1 := by
    change (Int.castRingHom (ZMod 2)) C.det = 1
    rw [RingHom.map_det, RingHom.mapMatrix_apply, show C = A * B from rfl, Matrix.map_mul, hab,
      Matrix.det_one]
  have hne : C.det ≠ 0 := by
    intro he
    rw [he, Int.cast_zero] at h2
    exact zero_ne_one h2
  have hu : IsUnit (C.map (Int.castRingHom ℂ)).det := by
    apply isUnit_iff_ne_zero.mpr
    rw [← RingHom.mapMatrix_apply, ← RingHom.map_det]
    change (C.det : ℂ) ≠ 0
    exact_mod_cast hne
  have hsurj : Function.Surjective (C.map (Int.castRingHom ℂ)).mulVec :=
    Matrix.mulVec_surjective_iff_isUnit.mpr ((Matrix.isUnit_iff_isUnit_det _).mpr hu)
  intro y
  obtain ⟨x, hx⟩ := hsurj y
  refine ⟨(B.map (Int.castRingHom ℂ)).mulVec x, ?_⟩
  rw [Matrix.mulVec_mulVec, ← Matrix.map_mul]
  exact hx

lemma surjective_of_certificate {d m : ℕ} (A : Matrix (Fin d) (Fin m) ℤ) (cols masks : ℕ → ℕ)
    (hcols : ∀ i j, A i j = intBit ((cols j.val).testBit i.val))
    (hcheck : ∀ i : Fin d, xorColumns cols (masks i.val) m = 2 ^ i.val) :
    Function.Surjective (A.map (Int.castRingHom ℂ)).mulVec := by
  let B : Matrix (Fin m) (Fin d) ℤ := fun j i => intBit ((masks i.val).testBit j.val)
  apply complex_surjectivity A B
  ext i j
  rw [Matrix.mul_apply, Matrix.one_apply]
  calc
    _ = ∑ k : Fin m, fieldBit ((cols k.val).testBit i.val) * fieldBit ((masks j.val).testBit k.val) := by
      apply Finset.sum_congr rfl
      intro k _
      change ((A i k : ℤ) : ZMod 2) * ((intBit ((masks j.val).testBit k.val) : ℤ) : ZMod 2) = _
      rw [hcols, cast_intBit, cast_intBit]
    _ = ∑ k ∈ Finset.range m, fieldBit ((cols k).testBit i.val) * fieldBit ((masks j.val).testBit k) := by
      exact Fin.sum_univ_eq_sum_range (fun k => fieldBit ((cols k).testBit i.val) *
        fieldBit ((masks j.val).testBit k)) m
    _ = fieldBit ((xorColumns cols (masks j.val) m).testBit i.val) := (xorColumns_entry _ _ _ _).symm
    _ = _ := by
      rw [hcheck j, Nat.testBit_two_pow]
      by_cases h : i = j
      · subst j; simp [fieldBit]
      · have hji : j.val ≠ i.val := fun hv => h (Fin.ext hv.symm)
        simp [h, hji, fieldBit]

abbrev Row (n : ℕ) := Fin n × Fin n × Fin n
abbrev Column (n r : ℕ) := Fin r × Fin 3 × Fin n

def flat (m n k : ℕ) : Fin m × Fin n × Fin k ≃ Fin (m * (n * k)) :=
  (Equiv.prodCongr (Equiv.refl _) finProdFinEquiv).trans finProdFinEquiv

lemma flat_val {m n k : ℕ} (x : Fin m × Fin n × Fin k) :
    (flat m n k x).val = (x.1.val * n + x.2.1.val) * k + x.2.2.val := by
  rcases x with ⟨i, j, l⟩
  change l.val + k * j.val + n * k * i.val = (i.val * n + j.val) * k + l.val
  ring

def tangentMatrix {n r : ℕ} (a b c : Fin r → Fin n → ℤ) : Matrix (Row n) (Column n r) ℤ :=
  fun (i, j, k) (t, e, h) =>
    if e = 0 then (if h = i then b t j * c t k else 0)
    else if e = 1 then (if h = j then a t i * c t k else 0)
    else (if h = k then a t i * b t j else 0)

lemma coordinates_of_matrix {n r : ℕ} (a b c : Fin r → Fin n → ℤ)
    (hs : Function.Surjective ((tangentMatrix a b c).map (Int.castRingHom ℂ)).mulVec) :
    TensorRankSpanning.coordinates_span n r := by
  classical
  refine ⟨fun t i => a t i, fun t j => b t j, fun t k => c t k, ?_⟩
  intro T
  obtain ⟨x, hx⟩ := hs (fun z => T z.1 z.2.1 z.2.2)
  refine ⟨fun t i => x (t, 0, i), fun t j => x (t, 1, j), fun t k => x (t, 2, k), ?_⟩
  intro i j k
  refine (congrFun hx (i, j, k)).symm.trans ?_
  change (∑ z : Column n r, ((tangentMatrix a b c (i,j,k) z : ℤ) : ℂ) * x z) = _
  rw [Fintype.sum_prod_type]
  apply Finset.sum_congr rfl
  intro t _
  rw [Fintype.sum_prod_type, Fin.sum_univ_three]
  simp [tangentMatrix, apply_ite, ite_mul, Finset.sum_ite_eq']
  ring

lemma surjective_reindex {ι κ δ μ : Type} [Fintype κ] [Fintype μ]
    (M : Matrix δ μ ℂ) (e : ι ≃ δ) (f : κ ≃ μ)
    (hs : Function.Surjective M.mulVec) : Function.Surjective (M.submatrix e f).mulVec := by
  intro y
  obtain ⟨v, hv⟩ := hs (y ∘ e.symm)
  use v ∘ f
  rw [Matrix.submatrix_mulVec_equiv]
  have he : (v ∘ f) ∘ f.symm = v := by funext j; simp
  rw [he, hv]
  funext j
  simp

/-- A bounded Boolean loop used to verify the finite certificates. -/
def allBelow (p : ℕ → Bool) : ℕ → Bool
  | 0 => true
  | n + 1 => allBelow p n && p n

lemma allBelow_spec (p : ℕ → Bool) (n : ℕ) :
    allBelow p n = true ↔ ∀ i < n, p i = true := by
  induction n with
  | zero => simp [allBelow]
  | succ n ih =>
    simp only [allBelow, Bool.and_eq_true, ih]
    constructor
    · rintro ⟨hl, hn⟩ i hi
      rcases Nat.lt_or_eq_of_le (Nat.le_of_lt_succ hi) with h | rfl
      · exact hl i h
      · exact hn
    · intro h
      exact ⟨fun i hi => h i (by omega), h n (by omega)⟩

def tangentBit (a b c : ℕ → ℕ) (t e h i j k : ℕ) : Bool :=
  if e = 0 then (if h = i then (b t).testBit j && (c t).testBit k else false)
  else if e = 1 then (if h = j then (a t).testBit i && (c t).testBit k else false)
  else (if h = k then (a t).testBit i && (b t).testBit j else false)

def validColumns (n r : ℕ) (a b c cols : ℕ → ℕ) : Bool :=
  allBelow (fun t => allBelow (fun e => allBelow (fun h =>
    allBelow (fun i => allBelow (fun j => allBelow (fun k =>
      ((cols ((t * 3 + e) * n + h)).testBit ((i * n + j) * n + k) ==
        tangentBit a b c t e h i j k)) n) n) n) n) 3) r

def validInverse (d m : ℕ) (cols masks : ℕ → ℕ) : Bool :=
  allBelow (fun j => xorColumns cols (masks j) m == 2 ^ j) d

lemma intBit_and (b c : Bool) : intBit (b && c) = intBit b * intBit c := by
  cases b <;> cases c <;> rfl

lemma intBit_entry {n : ℕ} (h i : Fin n) (b c : Bool) :
    (if h = i then intBit b * intBit c else 0) =
      intBit (if h.val = i.val then b && c else false) := by
  by_cases e : h = i
  · subst i; simp [intBit_and]
  · have hne : h.val ≠ i.val := fun eq => e (Fin.ext eq)
    simp only [if_neg e, if_neg hne]
    rfl

lemma coordinates_of_binary_certificate (n r : ℕ) (a b c cols masks : ℕ → ℕ)
    (hcols : validColumns n r a b c cols = true)
    (hinv : validInverse (n * (n * n)) (r * (3 * n)) cols masks = true) :
    TensorRankSpanning.coordinates_span n r := by
  classical
  let vec (w : ℕ → ℕ) (t : Fin r) (i : Fin n) := intBit ((w t.val).testBit i.val)
  let A : Matrix (Fin (n * (n * n))) (Fin (r * (3 * n))) ℤ :=
    fun i j => intBit ((cols j.val).testBit i.val)
  have hA : Function.Surjective (A.map (Int.castRingHom ℂ)).mulVec := by
    apply surjective_of_certificate A cols masks (fun _ _ => rfl)
    intro i
    exact beq_iff_eq.mp ((allBelow_spec _ _).mp hinv i.val i.isLt)
  apply coordinates_of_matrix (vec a) (vec b) (vec c)
  have he : (tangentMatrix (vec a) (vec b) (vec c)).map (Int.castRingHom ℂ) =
      (A.map (Int.castRingHom ℂ)).submatrix (flat n n n) (flat r 3 n) := by
    ext ⟨i,j,k⟩ ⟨t,e,h⟩
    simp only [validColumns, allBelow_spec, beq_iff_eq] at hcols
    have hm := hcols t.val t.isLt e.val e.isLt h.val h.isLt i.val i.isLt j.val j.isLt k.val k.isLt
    change (Int.castRingHom ℂ) (tangentMatrix (vec a) (vec b) (vec c) (i,j,k) (t,e,h)) =
      (Int.castRingHom ℂ) (intBit ((cols (flat r 3 n (t,e,h)).val).testBit (flat n n n (i,j,k)).val))
    rw [flat_val, flat_val]
    change _ = (Int.castRingHom ℂ) (intBit ((cols ((t.val * 3 + e.val) * n + h.val)).testBit
      ((i.val * n + j.val) * n + k.val)))
    rw [hm]
    apply congrArg (Int.castRingHom ℂ)
    fin_cases e
    · exact intBit_entry h i _ _
    · exact intBit_entry h j _ _
    · exact intBit_entry h k _ _
  rw [he]
  exact surjective_reindex _ _ _ hA

end TensorRankCertificates

