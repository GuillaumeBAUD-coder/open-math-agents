theorem G_closed184543 (m : ℕ) :
    ∀ u v : Fin 64, G184543 (m + 2) u v = ∑ k ∈ range 7, Kt184543 (typ184543 u v) k * m.choose k := by
  induction m with
  | zero =>
    intro u v
    rw [G_two184543]
    simp [Finset.sum_range_succ]
  | succ m ih =>
    intro u v
    have h1 : G184543 (m + 1 + 2) u v = ∑ k ∈ range 7,
        (∑ w : Fin 64, if Vt184543 u.val v.val w.val then Kt184543 (typ184543 v w) k else 0) * m.choose k := by
      show (∑ w : Fin 64, if Vt184543 u.val v.val w.val then G184543 (m + 2) v w else 0) = _
      rw [Finset.sum_congr rfl fun w _ => (show (if Vt184543 u.val v.val w.val then
          G184543 (m + 2) v w else 0) = ∑ k ∈ range 7, (if Vt184543 u.val v.val w.val then
          Kt184543 (typ184543 v w) k else 0) * m.choose k by
        split_ifs
        · exact ih v w
        · simp), Finset.sum_comm]
      exact Finset.sum_congr rfl fun k _ => (Finset.sum_mul _ _ _).symm
    have h2 : G184543 (m + 1 + 2) u v =
        ∑ k ∈ range 7, (Kt184543 (typ184543 u v) k + Kt184543 (typ184543 u v) (k + 1)) * m.choose k := by
      rw [h1]
      refine Finset.sum_congr rfl fun k hk => ?_
      rw [step_fact184543 u v k (Finset.mem_range.mp hk)]
    rw [h2]
    have p1 : (m + 1).choose 1 = m.choose 0 + m.choose 1 := Nat.choose_succ_succ' m 0
    have p2 : (m + 1).choose 2 = m.choose 1 + m.choose 2 := Nat.choose_succ_succ' m 1
    have p3 : (m + 1).choose 3 = m.choose 2 + m.choose 3 := Nat.choose_succ_succ' m 2
    have p4 : (m + 1).choose 4 = m.choose 3 + m.choose 4 := Nat.choose_succ_succ' m 3
    have p5 : (m + 1).choose 5 = m.choose 4 + m.choose 5 := Nat.choose_succ_succ' m 4
    have p6 : (m + 1).choose 6 = m.choose 5 + m.choose 6 := Nat.choose_succ_succ' m 5
    simp only [Finset.sum_range_succ, Finset.sum_range_zero, p1, p2, p3, p4, p5, p6,
      Nat.choose_zero_right, top_fact184543 u v]
    ring

