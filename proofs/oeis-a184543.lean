import OMAStatements.S_oeis_a184543
import Mathlib

/-!
Proof of the conjectures for A184543 ((n+2) X 6 binary arrays whose 3 X 3 subblocks have rows and
columns in lexicographically nondecreasing order).

The condition `Good` of the statement only involves three consecutive rows, so splitting off the
first row (`good_cons184543`) gives a transfer recursion on pairs of rows: `T (m + 1) x y` is the sum
of `T m y z` over the rows `z` with `TriOK x y z`, and `a n` is the sum of `T n x y`. On the
binary codes of rows, `TriOK` becomes a Boolean test `Vt184543` (each window of three columns compares
as numbers, `TriOK_code184543`), and `T` becomes the recursion `G184543`.

The 4096 pairs of codes fall into 8 types (`typ184543`); for `n ≥ 0`,
`G (n + 2) u v = Sum_k Kt (typ u v) k * C(n, k)`, proved by induction using Pascal's rule and the
kernel-checked identities `step_fact184543` (the successors of a pair of type `t` have coefficient
sums `Kt t k + Kt t (k + 1)`). Summing over all pairs gives `a (n + 2)` as a combination of
binomials, which expands to the closed form; `a 1` is checked directly. The recurrence and the
generating function follow by comparing coefficients.
-/

namespace OMA.Helpers

open OMA.S_oeis_a184543 Finset

/-- A row of the array. -/
abbrev Row184543 := Fin 6 → Fin 2

theorem good_cons184543 {m : ℕ} (x : Row184543) (B : Fin (m + 2) → Row184543) :
    Good (Fin.cons x B : Fin (m + 3) → Row184543) ↔ TriOK x (B 0) (B 1) ∧ Good B := by
  constructor
  · intro h
    refine ⟨?_, fun i j l hj hl => ?_⟩
    · have h1 := h 0 (0 : Fin (m + 2)).succ (1 : Fin (m + 2)).succ
        (by simp only [Fin.val_succ, Fin.val_zero])
        (by simp only [Fin.val_succ, Fin.val_zero, Fin.val_one])
      rwa [Fin.cons_zero, Fin.cons_succ, Fin.cons_succ] at h1
    · have h1 := h i.succ j.succ l.succ (by simp only [Fin.val_succ]; omega)
        (by simp only [Fin.val_succ]; omega)
      rwa [Fin.cons_succ, Fin.cons_succ, Fin.cons_succ] at h1
  · rintro ⟨h0, h⟩ i j l hj hl
    cases i using Fin.cases with
    | zero =>
      have ej : j = (0 : Fin (m + 2)).succ := Fin.ext (by
        simp only [Fin.val_succ, Fin.val_zero] at hj ⊢; omega)
      have el : l = (1 : Fin (m + 2)).succ := Fin.ext (by
        rw [ej] at hl; simp only [Fin.val_succ, Fin.val_zero, Fin.val_one] at hl ⊢; omega)
      subst ej el
      rwa [Fin.cons_zero, Fin.cons_succ, Fin.cons_succ]
    | succ i =>
      have hj0 : (j : ℕ) ≠ 0 := by simp only [Fin.val_succ] at hj; omega
      have hl0 : (l : ℕ) ≠ 0 := by omega
      obtain ⟨j', rfl⟩ : ∃ j' : Fin (m + 2), j = j'.succ :=
        ⟨j.pred (fun e => hj0 (by rw [e]; rfl)), (Fin.succ_pred _ _).symm⟩
      obtain ⟨l', rfl⟩ : ∃ l' : Fin (m + 2), l = l'.succ :=
        ⟨l.pred (fun e => hl0 (by rw [e]; rfl)), (Fin.succ_pred _ _).symm⟩
      rw [Fin.cons_succ, Fin.cons_succ, Fin.cons_succ]
      exact h i j' l' (by simp only [Fin.val_succ] at hj; omega)
        (by simp only [Fin.val_succ] at hl; omega)

instance decTriOK184543 (x y z : Row184543) : Decidable (TriOK x y z) := by
  unfold TriOK Lex3
  infer_instance

/-- The number of ways to continue the rows `x, y` by `m` more rows. -/
noncomputable def T184543 (m : ℕ) (x y : Row184543) : ℕ := by
  classical
  exact ∑ B : Fin m → Row184543,
    if Good (Fin.cons x (Fin.cons y B) : Fin (m + 2) → Row184543) then 1 else 0

theorem T_zero184543 (x y : Row184543) : T184543 0 x y = 1 := by
  classical
  unfold T184543
  rw [Fintype.sum_unique, if_pos]
  intro i j l hj hl
  have := l.isLt
  omega

theorem T_succ184543 (m : ℕ) (x y : Row184543) :
    T184543 (m + 1) x y = ∑ z : Row184543, if TriOK x y z then T184543 m y z else 0 := by
  classical
  unfold T184543
  rw [Fintype.sum_equiv (Fin.consEquiv fun _ => Row184543).symm _
    (fun p => if Good (Fin.cons x (Fin.cons y (Fin.cons p.1 p.2)) : Fin (m + 3) → Row184543)
      then 1 else 0) (fun B => by simp), Fintype.sum_prod_type]
  refine Finset.sum_congr rfl fun z _ => ?_
  by_cases hv : TriOK x y z
  · rw [if_pos hv]
    refine Finset.sum_congr rfl fun B _ => if_congr ?_ rfl rfl
    rw [good_cons184543]
    simp only [Fin.cons_zero, Fin.cons_one]
    exact and_iff_right hv
  · rw [if_neg hv]
    refine Finset.sum_eq_zero fun B _ => if_neg ?_
    rw [good_cons184543]
    simp only [Fin.cons_zero, Fin.cons_one]
    exact fun h => hv h.1

theorem a_eq184543 (n : ℕ) : a n = ∑ x : Row184543, ∑ y : Row184543, T184543 n x y := by
  classical
  have h1 : a n = ∑ A : Fin (n + 2) → Row184543, if Good A then 1 else 0 := by
    unfold a
    rw [Nat.card_eq_fintype_card, Fintype.card_subtype, Finset.card_filter]
  rw [h1, Fintype.sum_equiv (Fin.consEquiv fun _ => Row184543).symm _
    (fun p => if Good (Fin.cons p.1 p.2 : Fin (n + 2) → Row184543) then 1 else 0)
    (fun A => by simp), Fintype.sum_prod_type]
  refine Finset.sum_congr rfl fun x _ => ?_
  rw [Fintype.sum_equiv (Fin.consEquiv fun _ => Row184543).symm _
    (fun p => if Good (Fin.cons x (Fin.cons p.1 p.2) : Fin (n + 2) → Row184543) then 1 else 0)
    (fun A => by simp), Fintype.sum_prod_type]
  refine Finset.sum_congr rfl fun y _ => ?_
  unfold T184543
  exact Finset.sum_congr rfl fun B _ => if_congr Iff.rfl rfl rfl

/-- The row with code `c`: the bits of `c`, most significant first. -/
def row184543 (c : Fin 64) : Row184543 := fun j => ⟨c.val / 2 ^ (5 - j.val) % 2, Nat.mod_lt _ (by norm_num)⟩

theorem row_injective184543 : Function.Injective row184543 := by
  decide +kernel

theorem row_bijective184543 : Function.Bijective row184543 := by
  rw [Fintype.bijective_iff_injective_and_card]
  exact ⟨row_injective184543, by simp⟩

theorem lex3_iff184543 : ∀ a b c a' b' c' : Fin 2,
    Lex3 a b c a' b' c' ↔ 4 * a.val + 2 * b.val + c.val ≤ 4 * a'.val + 2 * b'.val + c'.val := by
  unfold Lex3
  decide

/-- The conditions of `TriOK` on the window of columns `t, t + 1, t + 2`. -/
def Win184543 (u v w : Row184543) (t : ℕ) (ht : t + 2 < 6) : Prop :=
  Lex3 (u ⟨t, by omega⟩) (u ⟨t + 1, by omega⟩) (u ⟨t + 2, ht⟩)
      (v ⟨t, by omega⟩) (v ⟨t + 1, by omega⟩) (v ⟨t + 2, ht⟩) ∧
    Lex3 (v ⟨t, by omega⟩) (v ⟨t + 1, by omega⟩) (v ⟨t + 2, ht⟩)
      (w ⟨t, by omega⟩) (w ⟨t + 1, by omega⟩) (w ⟨t + 2, ht⟩) ∧
    Lex3 (u ⟨t, by omega⟩) (v ⟨t, by omega⟩) (w ⟨t, by omega⟩)
      (u ⟨t + 1, by omega⟩) (v ⟨t + 1, by omega⟩) (w ⟨t + 1, by omega⟩) ∧
    Lex3 (u ⟨t + 1, by omega⟩) (v ⟨t + 1, by omega⟩) (w ⟨t + 1, by omega⟩)
      (u ⟨t + 2, ht⟩) (v ⟨t + 2, ht⟩) (w ⟨t + 2, ht⟩)

theorem TriOK_iff184543 (u v w : Row184543) : TriOK u v w ↔ ∀ t (ht : t + 2 < 6), Win184543 u v w t ht := by
  constructor
  · intro h t ht
    exact h ⟨t, by omega⟩ ⟨t + 1, by omega⟩ ⟨t + 2, ht⟩ rfl rfl
  · intro h j j' j'' h1 h2
    have ht : (j : ℕ) + 2 < 6 := by have := j''.isLt; omega
    have e1 : j' = ⟨j + 1, by clear h1 h2; omega⟩ := Fin.ext h1
    have e2 : j'' = ⟨j + 2, ht⟩ := Fin.ext (by rw [h2, h1])
    subst e1 e2
    exact h j ht

/-- Bit `t` of the code `x`, the most significant first. -/
def bt184543 (x t : ℕ) : ℕ := x / 2 ^ (5 - t) % 2

/-- The window test on codes. -/
def WT184543 (u v w t : ℕ) : Bool :=
  decide (4 * bt184543 u t + 2 * bt184543 u (t + 1) + bt184543 u (t + 2) ≤
      4 * bt184543 v t + 2 * bt184543 v (t + 1) + bt184543 v (t + 2)) &&
    decide (4 * bt184543 v t + 2 * bt184543 v (t + 1) + bt184543 v (t + 2) ≤
      4 * bt184543 w t + 2 * bt184543 w (t + 1) + bt184543 w (t + 2)) &&
    decide (4 * bt184543 u t + 2 * bt184543 v t + bt184543 w t ≤
      4 * bt184543 u (t + 1) + 2 * bt184543 v (t + 1) + bt184543 w (t + 1)) &&
    decide (4 * bt184543 u (t + 1) + 2 * bt184543 v (t + 1) + bt184543 w (t + 1) ≤
      4 * bt184543 u (t + 2) + 2 * bt184543 v (t + 2) + bt184543 w (t + 2))

theorem Win_iff184543 (u v w : Fin 64) (t : ℕ) (ht : t + 2 < 6) :
    Win184543 (row184543 u) (row184543 v) (row184543 w) t ht ↔ WT184543 u.val v.val w.val t = true := by
  simp only [Win184543, lex3_iff184543, WT184543, Bool.and_eq_true, decide_eq_true_eq, and_assoc]
  rfl

/-- `TriOK` on codes. -/
def Vt184543 (u v w : ℕ) : Bool := WT184543 u v w 0 && WT184543 u v w 1 && WT184543 u v w 2 && WT184543 u v w 3

theorem TriOK_code184543 (u v w : Fin 64) :
    TriOK (row184543 u) (row184543 v) (row184543 w) ↔ Vt184543 u.val v.val w.val = true := by
  rw [TriOK_iff184543]
  simp only [Vt184543, Bool.and_eq_true]
  constructor
  · intro h
    exact ⟨⟨⟨(Win_iff184543 u v w 0 (by norm_num)).1 (h 0 (by norm_num)), (Win_iff184543 u v w 1 (by norm_num)).1 (h 1 (by norm_num))⟩, (Win_iff184543 u v w 2 (by norm_num)).1 (h 2 (by norm_num))⟩, (Win_iff184543 u v w 3 (by norm_num)).1 (h 3 (by norm_num))⟩
  · rintro ⟨⟨⟨h0, h1⟩, h2⟩, h3⟩ t ht
    have : t = 0 ∨ t = 1 ∨ t = 2 ∨ t = 3 := by omega
    rcases this with rfl | rfl | rfl | rfl
    · exact (Win_iff184543 u v w 0 ht).2 h0
    · exact (Win_iff184543 u v w 1 ht).2 h1
    · exact (Win_iff184543 u v w 2 ht).2 h2
    · exact (Win_iff184543 u v w 3 ht).2 h3

/-- The transfer recursion on codes. -/
def G184543 : ℕ → Fin 64 → Fin 64 → ℕ
  | 0, _, _ => 1
  | m + 1, u, v => ∑ w : Fin 64, if Vt184543 u.val v.val w.val then G184543 m v w else 0

theorem T_eq_G184543 (m : ℕ) : ∀ u v : Fin 64, T184543 m (row184543 u) (row184543 v) = G184543 m u v := by
  induction m with
  | zero => intro u v; rw [T_zero184543]; rfl
  | succ m ih =>
    intro u v
    rw [T_succ184543, ← row_bijective184543.sum_comp]
    simp only [G184543]
    refine Finset.sum_congr rfl fun w _ => ?_
    rw [ih v w]
    exact if_congr (TriOK_code184543 u v w) rfl rfl

theorem a_eq_G184543 (n : ℕ) : a n = ∑ u : Fin 64, ∑ v : Fin 64, G184543 n u v := by
  rw [a_eq184543, ← row_bijective184543.sum_comp]
  refine Finset.sum_congr rfl fun u _ => ?_
  rw [← row_bijective184543.sum_comp]
  exact Finset.sum_congr rfl fun v _ => T_eq_G184543 n u v

