import OMAReductions.R_Erdos848_erdos_848_R2_H2_R1

import Mathlib


/-!
Finite prefix of Erdős 848 through 210007.
The window induction and cardinality argument are adapted from Deldor14's
merged proof of Erdos848.erdos_848.R2.H1 for the prefix through 20007.
JarethWayneHill generated the extended colorings and supplied the
cube-root squarefreeness check. Each color class contains at most one
member of an admissible set. The kernel checks each window separately.
-/


namespace E848PrefixReflect

private def primorialValue : ℕ := 

set_option maxRecDepth 100000 in
set_option maxHeartbeats 100000000 in
private theorem value_eq : primorialValue = primorial 3600 := by decide +kernel

private theorem value_sqfree : Squarefree primorialValue := by
  rw [value_eq, primorial_eq_prod_primesLE, ← primeFactors_primorial]
  exact Nat.squarefree_prod_primeFactors _

private theorem residual {r : ℕ} (pos : 0 < r) (bound : r < 3600 ^ 3)
    (cop : r.Coprime primorialValue)
    (ns : r = 1 ∨ Nat.sqrt r * Nat.sqrt r ≠ r) : Squarefree r := by
  have large (p : ℕ) (hp : p.Prime) (hpr : p ∣ r) : 3600 < p := by
    by_contra! small
    have hd : p ∣ primorialValue := by
      rw [value_eq]
      exact hp.dvd_primorial_iff.mpr small
    have done := Nat.dvd_gcd hpr hd
    rw [show r.gcd primorialValue = 1 from cop] at done
    exact hp.ne_one (Nat.dvd_one.mp done)
  apply Nat.squarefree_iff_prime_squarefree.mpr
  intro p hp hpp
  obtain ⟨k, hk⟩ := hpp
  have dp : p ∣ r := ⟨p*k, by rw [hk, Nat.mul_assoc]⟩
  have big := large p hp dp
  have kpos : 0 < k := by
    by_contra! h
    simp [show k = 0 by omega] at hk
    omega
  by_cases one : k = 1
  · have he : r = p * p := by simpa [one] using hk
    rcases ns with h | h
    · have := hp.two_le
      nlinarith
    · rw [he, Nat.sqrt_mul_self] at h
      exact h rfl
  · have prime := Nat.minFac_prime one
    have dk : k ∣ r := ⟨p*p, by rw [hk, Nat.mul_comm k]⟩
    have bigk := large k.minFac prime ((Nat.minFac_dvd k).trans dk)
    have kle := Nat.le_of_dvd kpos (Nat.minFac_dvd k)
    have low : 3600 * 3600 * 3600 ≤ p * p * k :=
      Nat.mul_le_mul (Nat.mul_le_mul (by omega) (by omega)) (by omega)
    norm_num at bound low
    omega

def fast (n : ℕ) : Bool :=
  let g := n.gcd primorialValue
  let r := n / g
  decide (0 < r ∧ r < 3600 ^ 3 ∧ g.Coprime r ∧ r.Coprime primorialValue ∧
    (r = 1 ∨ Nat.sqrt r * Nat.sqrt r ≠ r))

theorem sound {n : ℕ} (h : fast n = true) : Squarefree n := by
  let g := n.gcd primorialValue
  let r := n / g
  change decide (0 < r ∧ r < 3600 ^ 3 ∧ g.Coprime r ∧ r.Coprime primorialValue ∧
    (r = 1 ∨ Nat.sqrt r * Nat.sqrt r ≠ r)) = true at h
  obtain ⟨pos, bound, cop, remcop, ns⟩ := of_decide_eq_true h
  have hg : Squarefree g := value_sqfree.squarefree_of_dvd (Nat.gcd_dvd_right _ _)
  have hr := residual pos bound remcop ns
  have e : r * g = n := Nat.div_mul_cancel (Nat.gcd_dvd_left _ _)
  exact e ▸ (Nat.squarefree_mul cop.symm).mpr ⟨hr, hg⟩

end E848PrefixReflect


