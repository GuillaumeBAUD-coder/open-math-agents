lemma S_sq : S * S = R := by
  have := bs_sq (R - 1) (by simp [R])
  unfold S; rw [this]; ring

noncomputable def DD : PowerSeries ℚ := 2 - 2 * X
noncomputable def NN : PowerSeries ℚ := 1 - X - X ^ 2 + X ^ 3 - S
noncomputable def AA : PowerSeries ℚ := NN * DD⁻¹

lemma hA : AA * DD = NN := by
  unfold AA
  rw [mul_assoc, PowerSeries.inv_mul_cancel _ (by simp [DD]), mul_one]

lemma hdD : derivative ℚ DD = -2 := by
  simp [DD] <;> ring
lemma hdR : derivative ℚ R = 6*X^5 + 10*X^4 - 20*X^3 + 12*X^2 - 2*X - 2 := by
  simp [R] <;> ring
lemma hdN : derivative ℚ NN = 3*X^2 - 2*X - 1 + (0) * S + (-1) * derivative ℚ S := by
  simp [NN] <;> ring

lemma ode : ((2) * X ^ 2 + (-4) * X ^ 3 + (8) * X ^ 4 + (-2) * X ^ 5 + (-2) * X ^ 6) * AA + ((1) * X ^ 1 + (-2) * X ^ 2 + (-1) * X ^ 3 + (4) * X ^ 4 + (-5) * X ^ 5 + (2) * X ^ 6 + (1) * X ^ 7) * derivative ℚ AA = ((4) * X ^ 4 + (-3) * X ^ 5 + (-1) * X ^ 7 : PowerSeries ℚ) := by
  have r1 := hA
  have r2 : derivative ℚ AA * DD + AA * derivative ℚ DD = derivative ℚ NN := by
    have := congrArg (derivative ℚ) hA
    rw [Derivation.leibniz] at this
    simp only [smul_eq_mul] at this
    rw [← this]; ring
  have r4 := sqrt_ode S R S_sq
  have hK : (2 * R * DD ^ 2 : PowerSeries ℚ) ≠ 0 := by
    intro h
    have := congrArg constantCoeff h
    simp [R, DD] at this
  apply mul_left_cancel₀ hK
  rw [hdD, hdN] at r2
  rw [hdR] at r4
  unfold NN at r1
  unfold DD at r1 r2
  unfold R at r4
  unfold DD R
  linear_combination (12*X^13 + 32*X^12 - 104*X^11 - 48*X^10 + 420*X^9 - 648*X^8 + 456*X^7 - 40*X^6 - 180*X^5 + 136*X^4 - 32*X^3 - 8*X^2 + 4*X) * r1 + (-4*X^14 - 12*X^13 + 40*X^12 + 24*X^11 - 204*X^10 + 348*X^9 - 272*X^8 + 16*X^7 + 164*X^6 - 148*X^5 + 40*X^4 + 24*X^3 - 20*X^2 + 4*X) * r2 + (2*X^8 + 2*X^7 - 14*X^6 + 18*X^5 - 10*X^4 - 2*X^3 + 6*X^2 - 2*X) * r4

lemma ha (n : ℕ) : a n = coeff (n + 2) AA := rfl

lemma rec_a (k : ℕ) : (((k + 6 : ℕ) : ℚ) + 2) * a (k + 6) + (-2*((k + 6 : ℕ) : ℚ) - 2) * a (k + 5) + (2 - ((k + 6 : ℕ) : ℚ)) * a (k + 4) + (4*((k + 6 : ℕ) : ℚ) - 8) * a (k + 3) + (18 - 5*((k + 6 : ℕ) : ℚ)) * a (k + 2) + (2*((k + 6 : ℕ) : ℚ) - 8) * a (k + 1) + (((k + 6 : ℕ) : ℚ) - 6) * a (k + 0) = 0 := by
  have h := congrArg (coeff (k + 8)) ode
  simp only [add_mul, sub_mul, neg_mul, one_mul, map_add, map_sub, map_neg, mul_assoc, cm2, cm3, cm4, cm5, cm6, cm7, cm8, cm10, cm12, cm16, cm20, cm28, coeff_X_pow_mul', coeff_derivative] at h
  simp [PowerSeries.coeff_X] at h
  simp only [ha]
  simp only [Nat.add_assoc, Nat.reduceAdd] at h ⊢
  push_cast at h ⊢
  linear_combination h

