import OMAStatements.S_arxiv_2311_12318
import Mathlib.Data.ZMod.Basic
import Mathlib.Algebra.Order.BigOperators.Group.Finset
import Mathlib.Tactic.Linarith

/-!
# 3-cube-free subsets of `ℤ_N` have at most `2N/3` elements (Meng, arXiv:2311.12318)

Problem: https://lefttosolve.com/p/arxiv-2311.12318

Upper bound (Meng's Theorem 3.1 argument):
* If some `x, 2x ∈ A`, then for every `t` one of `t, t + x, t + 2x` is outside `A`
  (else the cube generated by `{x, x, t}` lies in `A`). So `ℤ_N` is covered by three
  translates of `Aᶜ`, and `N ≤ 3 (N - |A|)`.
* Otherwise doubling maps `A` into `Aᶜ`, and doubling is at most 2-to-1 on `ℤ_N`
  (`2d = 0` forces `d.val ∈ {0, N/2}`), so `|A| ≤ 2 (N - |A|)`.

Tightness for `3 ∣ N`: `A = {a : a.val % 3 ∈ {1, 2}}`. Reduction mod 3 is additive, and
no `u, v, w ∈ ℤ_3 \ {0}` have `u+v, v+w, u+w, u+v+w` all nonzero (checked by `decide`).
`A` has `2N/3` elements by counting residues in `[0, N)`.
-/

open Finset OMA.S_arxiv_2311_12318

namespace OMA.Arxiv231112318

variable {N : ℕ} [NeZero N]

/-- `2d = 0` in `ℤ_N` forces `d ∈ {0, N/2}`. -/
theorem two_mul_eq_zero (d : ZMod N) (h : 2 * d = 0) :
    d = 0 ∨ d = ((N / 2 : ℕ) : ZMod N) := by
  have hv := ZMod.val_lt d
  have h2 : ((2 * d.val : ℕ) : ZMod N) = 0 := by
    push_cast; rw [ZMod.natCast_zmod_val]; exact h
  rw [ZMod.natCast_eq_zero_iff] at h2
  obtain ⟨c, hc⟩ := h2
  have hc2 : c < 2 := by
    by_contra hh
    push Not at hh
    have : N * 2 ≤ N * c := Nat.mul_le_mul_left N hh
    omega
  interval_cases c
  · left
    have : d.val = 0 := by omega
    rw [← ZMod.natCast_zmod_val d, this]; simp
  · right
    have : d.val = N / 2 := by omega
    rw [← ZMod.natCast_zmod_val d, this]

theorem fiber_le_two (s : Finset (ZMod N)) (b : ZMod N) :
    #{a ∈ s | 2 * a = b} ≤ 2 := by
  by_cases hne : ({a ∈ s | 2 * a = b} : Finset (ZMod N)).Nonempty
  · obtain ⟨a₀, ha₀⟩ := hne
    have hsub : ({a ∈ s | 2 * a = b} : Finset (ZMod N)) ⊆ {a₀, a₀ + ((N / 2 : ℕ) : ZMod N)} := by
      intro a ha
      rw [mem_filter] at ha ha₀
      have : 2 * (a - a₀) = 0 := by rw [mul_sub, ha.2, ha₀.2, sub_self]
      rcases two_mul_eq_zero _ this with h | h
      · simp [sub_eq_zero.mp h]
      · simp [← h]
    exact (card_le_card hsub).trans (card_le_two)
  · rw [not_nonempty_iff_eq_empty.mp hne]; simp

theorem bound (A : Finset (ZMod N)) (hA : CubeFree (A : Set (ZMod N))) :
    3 * A.card ≤ 2 * N := by
  have hcompl : (Aᶜ).card = N - A.card := by
    rw [card_compl, ZMod.card]
  have hAN : A.card ≤ N := by
    have := card_le_univ A; rwa [ZMod.card] at this
  by_cases hx : ∃ x ∈ A, 2 * x ∈ A
  · obtain ⟨x, hxA, h2x⟩ := hx
    have hcover : (univ : Finset (ZMod N)) ⊆
        Aᶜ ∪ (Aᶜ.image (fun t => t - x)) ∪ (Aᶜ.image (fun t => t - 2 * x)) := by
      intro t _
      by_contra hcon
      simp only [mem_union, mem_compl, mem_image, not_or, not_exists, not_and] at hcon
      obtain ⟨⟨h0, h1⟩, h2⟩ := hcon
      have ht : t ∈ A := by simpa using h0
      have ht1 : t + x ∈ A := by
        by_contra hh; exact h1 (t + x) hh (by ring)
      have ht2 : t + 2 * x ∈ A := by
        by_contra hh; exact h2 (t + 2 * x) hh (by ring)
      apply hA x x t
      intro y hy
      simp only [cube, Set.mem_insert_iff, Set.mem_singleton_iff] at hy
      rcases hy with rfl | rfl | rfl | rfl | rfl | rfl | rfl
      · exact hxA
      · exact hxA
      · exact ht
      · rw [← two_mul]; exact h2x
      · rw [add_comm]; exact ht1
      · rw [add_comm]; exact ht1
      · rw [show x + x + t = t + 2 * x by ring]; exact ht2
    have h1 := card_le_card hcover
    rw [card_univ, ZMod.card] at h1
    have h2 := card_union_le (Aᶜ ∪ Aᶜ.image (fun t => t - x)) (Aᶜ.image (fun t => t - 2 * x))
    have h2' := card_union_le Aᶜ (Aᶜ.image (fun t => t - x))
    have h3 : (Aᶜ.image (fun t => t - x)).card = (Aᶜ).card :=
      card_image_of_injective _ (sub_left_injective)
    have h4 : (Aᶜ.image (fun t => t - 2 * x)).card = (Aᶜ).card :=
      card_image_of_injective _ (sub_left_injective)
    omega
  · push Not at hx
    have hmaps : A.image (fun a => 2 * a) ⊆ Aᶜ := by
      intro b hb
      obtain ⟨a, ha, rfl⟩ := mem_image.mp hb
      simpa using hx a ha
    have h1 : A.card ≤ 2 * (A.image (fun a => 2 * a)).card :=
      card_le_mul_card_image A 2 (fun b _ => fiber_le_two A b)
    have h2 := card_le_card hmaps
    omega

theorem count_range (m : ℕ) :
    #{k ∈ range (3 * m) | k % 3 = 1 ∨ k % 3 = 2} = 2 * m := by
  induction m with
  | zero => simp
  | succ m ih =>
    rw [show 3 * (m + 1) = 3 * m + 1 + 1 + 1 by ring]
    rw [range_add_one, range_add_one, range_add_one]
    rw [filter_insert, filter_insert, filter_insert]
    have e0 : ¬ ((3 * m) % 3 = 1 ∨ (3 * m) % 3 = 2) := by omega
    have e1 : (3 * m + 1) % 3 = 1 ∨ (3 * m + 1) % 3 = 2 := by omega
    have e2 : (3 * m + 1 + 1) % 3 = 1 ∨ (3 * m + 1 + 1) % 3 = 2 := by omega
    rw [if_pos e2, if_pos e1, if_neg e0]
    rw [card_insert_of_notMem, card_insert_of_notMem, ih]
    · ring
    all_goals first | (simp; done) | (simp; omega)

end OMA.Arxiv231112318

open OMA.Arxiv231112318 in
theorem OMA.solution : type_of% @OMA.S_arxiv_2311_12318.main := by
  intro N _
  refine ⟨fun A hA => bound A hA, fun h3 => ?_⟩
  obtain ⟨m, rfl⟩ := h3
  let A : Finset (ZMod (3 * m)) := univ.filter (fun a => a.val % 3 = 1 ∨ a.val % 3 = 2)
  have hmem : ∀ a : ZMod (3 * m), a ∈ A ↔ a.val % 3 = 1 ∨ a.val % 3 = 2 := by
    intro a; simp [A]
  -- reduction mod 3
  let r : ZMod (3 * m) → ZMod 3 := fun a => ((a.val : ℕ) : ZMod 3)
  have hr_add : ∀ a b, r (a + b) = r a + r b := by
    intro a b
    simp only [r]
    rw [ZMod.val_add, ← Nat.cast_add, ZMod.natCast_eq_natCast_iff']
    exact Nat.mod_mod_of_dvd _ (Dvd.intro m rfl)
  have hr_mem : ∀ a, a ∈ A ↔ r a ≠ 0 := by
    intro a
    rw [hmem]
    simp only [r, ne_eq, ZMod.natCast_eq_zero_iff, Nat.dvd_iff_mod_eq_zero]
    omega
  refine ⟨A, hmem, ?_, ?_⟩
  · intro x y z hsub
    have key : ∀ u v w : ZMod 3, u ≠ 0 → v ≠ 0 → w ≠ 0 → u + v ≠ 0 → v + w ≠ 0 →
        u + w ≠ 0 → u + v + w ≠ 0 → False := by decide
    have hx := (hr_mem x).mp (hsub (by simp [cube]))
    have hy := (hr_mem y).mp (hsub (by simp [cube]))
    have hz := (hr_mem z).mp (hsub (by simp [cube]))
    have hxy := (hr_mem (x + y)).mp (hsub (by simp [cube]))
    have hyz := (hr_mem (y + z)).mp (hsub (by simp [cube]))
    have hxz := (hr_mem (x + z)).mp (hsub (by simp [cube]))
    have hxyz := (hr_mem (x + y + z)).mp (hsub (by simp [cube]))
    rw [hr_add] at hxy hyz hxz
    rw [hr_add, hr_add] at hxyz
    exact key _ _ _ hx hy hz hxy hyz hxz hxyz
  · have hcard : A.card = #{k ∈ range (3 * m) | k % 3 = 1 ∨ k % 3 = 2} := by
      apply card_bij (fun a _ => a.val)
      · intro a ha
        rw [mem_filter, mem_range]
        exact ⟨ZMod.val_lt a, (hmem a).mp ha⟩
      · intro a _ b _ h
        exact ZMod.val_injective _ h
      · intro k hk
        rw [mem_filter, mem_range] at hk
        refine ⟨(k : ZMod (3 * m)), ?_, ZMod.val_cast_of_lt hk.1⟩
        rw [hmem, ZMod.val_cast_of_lt hk.1]
        exact hk.2
    rw [hcard, count_range]
    ring
