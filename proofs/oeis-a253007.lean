  have e0 : Cnt 0 = t0 := by
    funext r
    have h : ∀ c0 c1 c2 c3 : Fin 7,
        (if ZA 0 (dig 7 (by norm_num) ((c0 : ℕ) + (c1 : ℕ) * 7 + (c2 : ℕ) * 49 + (c3 : ℕ) * 343)) = true then 1 else 0) = t0 (dig 7 (by norm_num) ((c0 : ℕ) + (c1 : ℕ) * 7 + (c2 : ℕ) * 49 + (c3 : ℕ) * 343)) := by
