theorem period_facts (r : ℕ) (hr : r < 84) :
    (∀ s, s < 26 → ∀ i, i < 14 → divN s i r = true → wN s i ≤ lenN s i r) ∧
    (sumR 26 fun s => sumR 14 fun i => cond (divN s i r) (lenN s i r - wN s i) 0) = b (15 + r) ∧
    (sumR 26 fun s => sumR 14 fun i => cond (divN s i r) (mhkV i) 0) = 3 * dv (9 + r) := by
  have h : periodR r = true := by
    rcases (show r < 4 ∨ (4 ≤ r ∧ r < 8) ∨ (8 ≤ r ∧ r < 12) ∨ (12 ≤ r ∧ r < 16) ∨ (16 ≤ r ∧ r < 20) ∨ (20 ≤ r ∧ r < 24) ∨ (24 ≤ r ∧ r < 28) ∨ (28 ≤ r ∧ r < 32) ∨ (32 ≤ r ∧ r < 36) ∨ (36 ≤ r ∧ r < 40) ∨ (40 ≤ r ∧ r < 44) ∨ (44 ≤ r ∧ r < 48) ∨ (48 ≤ r ∧ r < 52) ∨ (52 ≤ r ∧ r < 56) ∨ (56 ≤ r ∧ r < 60) ∨ (60 ≤ r ∧ r < 64) ∨ (64 ≤ r ∧ r < 68) ∨ (68 ≤ r ∧ r < 72) ∨ (72 ≤ r ∧ r < 76) ∨ (76 ≤ r ∧ r < 80) ∨ 80 ≤ r by omega) with h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h
    · exact allI_get _ _ _ periodK0.down r (by omega) (by omega)
    · exact allI_get _ _ _ periodK1.down r (by omega) (by omega)
    · exact allI_get _ _ _ periodK2.down r (by omega) (by omega)
    · exact allI_get _ _ _ periodK3.down r (by omega) (by omega)
    · exact allI_get _ _ _ periodK4.down r (by omega) (by omega)
    · exact allI_get _ _ _ periodK5.down r (by omega) (by omega)
    · exact allI_get _ _ _ periodK6.down r (by omega) (by omega)
    · exact allI_get _ _ _ periodK7.down r (by omega) (by omega)
    · exact allI_get _ _ _ periodK8.down r (by omega) (by omega)
    · exact allI_get _ _ _ periodK9.down r (by omega) (by omega)
    · exact allI_get _ _ _ periodK10.down r (by omega) (by omega)
    · exact allI_get _ _ _ periodK11.down r (by omega) (by omega)
    · exact allI_get _ _ _ periodK12.down r (by omega) (by omega)
    · exact allI_get _ _ _ periodK13.down r (by omega) (by omega)
    · exact allI_get _ _ _ periodK14.down r (by omega) (by omega)
    · exact allI_get _ _ _ periodK15.down r (by omega) (by omega)
    · exact allI_get _ _ _ periodK16.down r (by omega) (by omega)
    · exact allI_get _ _ _ periodK17.down r (by omega) (by omega)
    · exact allI_get _ _ _ periodK18.down r (by omega) (by omega)
    · exact allI_get _ _ _ periodK19.down r (by omega) (by omega)
    · exact allI_get _ _ _ periodK20.down r (by omega) (by omega)
  simp only [periodR, Bool.and_eq_true, Nat.beq_eq, Nat.add_eq, Nat.mul_eq, Nat.sub_eq] at h
  obtain ⟨⟨h1, h2⟩, h3⟩ := h
  refine ⟨fun s hs i hi hd => ?_, h2, h3⟩
  have h4 := (allR_iff _ _).1 ((allR_iff _ _).1 h1 s hs) i hi
  rw [hd] at h4
  simpa using h4

theorem innerZ_eq (s i r : ℕ) (hs : s < 26) (hi : i < 14) (hr : r < 84) :
    innerZ s i r = ((cond (divN s i r) (lenN s i r - wN s i) 0 : ℕ) : ℤ) := by
  rw [innerZ]
  cases hd : divN s i r
  · simp
  · rw [if_pos rfl, cond_true, Nat.cast_sub ((period_facts r hr).1 s hs i hi hd)]

theorem sumR2 (f : ℕ → ℕ → ℕ) :
    ((sumR 26 fun s => sumR 14 fun i => f s i : ℕ) : ℤ) = ∑ q : Fin 26 × Fin 14, (f q.1.val q.2.val : ℤ) := by
  rw [Fintype.sum_prod_type, sumR_eq, Nat.cast_sum,
    ← Fin.sum_univ_eq_sum_range (fun s => ((sumR 14 fun i => f s i : ℕ) : ℤ)) 26]
  refine Finset.sum_congr rfl (fun s _ => ?_)
  rw [sumR_eq, Nat.cast_sum, ← Fin.sum_univ_eq_sum_range (fun i => (f s.val i : ℤ)) 14]

theorem S_window (r : ℕ) (hr : r < 84) : S ((15 : ℤ) + r) = b (15 + r) := by
  have h := congrArg (Nat.cast : ℕ → ℤ) (period_facts r hr).2.1
  rw [sumR2] at h
  rw [← h, S]
  refine Finset.sum_congr rfl (fun q _ => ?_)
  rw [inner_nat q.1 q.2 r hr, innerZ_eq _ _ _ q.1.isLt q.2.isLt hr]

theorem Gs_window (r : ℕ) (hr : r < 84) : Gs ((15 : ℤ) + r) = ((3 * dv (9 + r) : ℕ) : ℤ) := by
  have h := congrArg (Nat.cast : ℕ → ℤ) (period_facts r hr).2.2
  rw [sumR2] at h
  rw [← h, Gs]
  refine Finset.sum_congr rfl (fun q _ => ?_)
  rcases Bool.eq_false_or_eq_true (divN q.1.val q.2.val r) with hd | hd
  · rw [if_pos ((div_nat q.1 q.2 r).2 hd), hd, cond_true, (tab_facet q.2).2.2.2.2]
  · rw [if_neg (fun h' => by
      have := (div_nat q.1 q.2 r).1 h'
      rw [hd] at this
      exact Bool.noConfusion this), hd]
    rfl

/-- Every piece length is nonnegative from n = 15 on: checked on one period, then shifted. -/
theorem inner_nonneg (s : Fin 26) (i : Fin 14) (n : ℤ) (hn : 15 ≤ n) : 0 ≤ inner s i n := by
  obtain ⟨t, rfl⟩ : ∃ t : ℕ, n = 15 + t := ⟨(n - 15).toNat, by omega⟩
  induction t using Nat.strong_induction_on with
  | _ t ih =>
    by_cases ht : t < 84
    · rw [inner_nat s i t ht, innerZ_eq _ _ _ s.isLt i.isLt ht]
      exact Nat.cast_nonneg _
    · have := ih (t - 84) (by omega) (by omega)
      have e : (15 : ℤ) + t = (15 + (t - 84 : ℕ)) + 84 := by
        push_cast [Nat.cast_sub (by omega : 84 ≤ t)]; ring
      rw [e, inner_shift]
      have hpos : 0 ≤ mh i + mk i := by
        rw [← (tab_facet i).2.2.2.2]
        exact Nat.cast_nonneg _
      split_ifs <;> linarith

theorem cnt_eq_S (n : ℤ) (hn : 15 ≤ n) : (cnt n : ℤ) = S n := by
  rw [cnt_eq_sum, S, Nat.cast_sum]
  refine Finset.sum_congr rfl (fun p _ => ?_)
  rw [card_piece p.1 p.2 n hn]
  exact Int.toNat_of_nonneg (inner_nonneg p.1 p.2 n hn)

/-- The growth of b over 84 terms is that of S, from the window by periodicity. -/
theorem grow (n : ℕ) (hn : 15 ≤ n) : (3 : ℤ) * (dv (n - 6) : ℤ) = Gs n := by
  have hr : (n - 15) % 84 < 84 := Nat.mod_lt _ (by norm_num)
  have e1 : (n : ℤ) = ((15 : ℤ) + (((n - 15) % 84 : ℕ) : ℤ)) + 84 * (((n - 15) / 84 : ℕ) : ℤ) := by
    omega
  have e2 : dv (n - 6) = dv (9 + (n - 15) % 84) := by
    simp only [dv]
    congr 1
    omega
  rw [e1, Gs_periodic, Gs_window _ hr, e2]
  push_cast
  ring

theorem S_eq_b (n : ℕ) (hn : 15 ≤ n) : S n = b n := by
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    by_cases h : n < 99
    · obtain ⟨r, rfl⟩ : ∃ r, n = 15 + r := ⟨n - 15, by omega⟩
      push_cast
      exact S_window r (by omega)
    · have h1 := ih (n - 84) (by omega) (by omega)
      have h2 := S_shift ((n - 84 : ℕ) : ℤ)
      have h3 := b_shift (n - 84) (by omega)
      have h4 := grow (n - 84) (by omega)
      rw [show n - 84 + 84 = n by omega] at h3
      rw [show ((n - 84 : ℕ) : ℤ) + 84 = n by omega] at h2
      rw [h2, h1, h3]
      push_cast
      linarith

/-! ## The small spheres

The points with F ≤ 14 lie in the box -3 ≤ x ≤ 3, -3 ≤ y ≤ 3 (`small_box`). In natural-number
coordinates a = x + 3, b = y + 3 every potential is PtN - NtN (`pot_box`), so F is their largest
difference FN (`F_FN`), and the kernel counts the box points on each level (`smallOK`). -/

theorem small_box (x y : ℤ) (s : Fin 26) (h : F (x, y, s) ≤ 14) :
    -3 ≤ x ∧ x ≤ 3 ∧ -3 ≤ y ∧ y ≤ 3 := by
  obtain ⟨b1, b2, b3, b4⟩ := coord_le x y s
  omega

/-- Potential i at the box point ((a : ℤ) - 3, (b : ℤ) - 3, s) is PtN i a b s - NtN i a b. -/
def PtN (i a b s : ℕ) : ℕ := Nat.add (Nat.add (Nat.add (Nat.mul (AW i) a) 96) (Nat.mul (BW i) b)) (CW s i)

def NtN (i a b : ℕ) : ℕ := Nat.add (Nat.add (Nat.add (Nat.mul (AW i) 3) (Nat.mul (BW i) 3)) 16) (Nat.add (Nat.mul 16 a) (Nat.mul 16 b))

theorem pot_box (a b : ℕ) (s : Fin 26) (i : Fin 14) :
    pot ((a : ℤ) - 3, (b : ℤ) - 3, s) i = (PtN i.val a b s.val : ℤ) - NtN i.val a b := by
  simp only [pot, PtN, NtN, A_W, B_W, C_W, Nat.add_eq, Nat.mul_eq]
  push_cast
  ring

/-- F at the box point (a, b, s), in natural numbers. -/
noncomputable def FN (a b s : ℕ) : ℕ := maxR 14 fun i => Nat.sub (PtN i a b s) (NtN i a b)

theorem F_FN (a b : ℕ) (s : Fin 26) : F ((a : ℤ) - 3, (b : ℤ) - 3, s) = (FN a b s.val : ℤ) := by
  have h0 := F_nonneg ((a : ℤ) - 3, (b : ℤ) - 3, s)
  simp only [FN, Nat.sub_eq]
  apply le_antisymm
  · obtain ⟨k, hk⟩ := F_attained ((a : ℤ) - 3, (b : ℤ) - 3, s)
    have h1 := pot_box a b s k
    have h2 := le_maxR 14 (fun i => PtN i a b s.val - NtN i a b) k.val k.isLt
    omega
  · have h3 : (maxR 14 fun i => PtN i a b s.val - NtN i a b) ≤
        (F ((a : ℤ) - 3, (b : ℤ) - 3, s)).toNat := by
      apply maxR_le
      intro k hk
      have h1 : pot ((a : ℤ) - 3, (b : ℤ) - 3, s) ⟨k, hk⟩ = (PtN k a b s.val : ℤ) - NtN k a b :=
        pot_box a b s ⟨k, hk⟩
      have h2 := le_F ((a : ℤ) - 3, (b : ℤ) - 3, s) ⟨k, hk⟩
      omega
    omega

/-- The number of box points with FN = f. -/
noncomputable def cntB (f : ℕ) : ℕ :=
  sumR 7 fun a => sumR 7 fun b => sumR 26 fun s => cond (Nat.beq (FN a b s) f) 1 0

/-- The small sphere f agrees with b. -/
noncomputable def smallR (f : ℕ) : Bool := Nat.beq (cntB f) (b f)

/-! The small spheres 6 .. 14, checked by the kernel in pieces of consecutive levels. -/

def smallK0 : PLift (allI 6 9 smallR = true) :=
  ⟨by decide +kernel⟩

theorem small_eq (n : ℕ) (h1 : 6 ≤ n) (h2 : n < 15) : cntB n = b n := by
  have h : smallR n = true := by
    exact allI_get _ _ _ smallK0.down n (by omega) (by omega)
  simpa only [smallR, Nat.beq_eq] using h

/-- The box points by natural-number coordinates. -/
def ib (q : ℕ × ℕ × Fin 26) : V := ((q.1 : ℤ) - 3, (q.2.1 : ℤ) - 3, q.2.2)

theorem ib_inj : Function.Injective ib := by
  rintro ⟨a, b, s⟩ ⟨a', b', s'⟩ h
  simp only [ib, Prod.mk.injEq] at h
  obtain ⟨h1, h2, rfl⟩ := h
  have e1 : a = a' := by omega
  have e2 : b = b' := by omega
  rw [e1, e2]

theorem cnt_small (f : ℕ) (hf : f ≤ 14) : cnt f = cntB f := by
  have hs : {v : V | F v = (f : ℤ)} = ↑(((Finset.range 7 ×ˢ (Finset.range 7 ×ˢ Finset.univ)).filter
      (fun q : ℕ × ℕ × Fin 26 => FN q.1 q.2.1 q.2.2.val = f)).image ib) := by
    ext ⟨x, y, s⟩
    simp only [Set.mem_ofPred_eq, Finset.coe_image, Finset.coe_filter, Set.mem_image, Finset.mem_product,
      Finset.mem_range, Finset.mem_univ, and_true, Prod.exists]
    constructor
    · intro h
      obtain ⟨hx1, hx2, hy1, hy2⟩ := small_box x y s (by omega)
      refine ⟨(x + 3).toNat, (y + 3).toNat, s, ⟨⟨by omega, by omega⟩, ?_⟩, ?_⟩
      · have e := F_FN (x + 3).toNat (y + 3).toNat s
        rw [show (((x + 3).toNat : ℕ) : ℤ) - 3 = x by omega,
          show (((y + 3).toNat : ℕ) : ℤ) - 3 = y by omega, h] at e
        exact_mod_cast e.symm
      · simp only [ib, Prod.mk.injEq]
        exact ⟨by omega, by omega, by trivial⟩
    · rintro ⟨a, b, s', ⟨-, hF⟩, he⟩
      rw [← he, ib, F_FN, hF]
  rw [cnt, hs, Set.ncard_coe_finset, Finset.card_image_of_injective _ ib_inj, Finset.card_filter,
    Finset.sum_product, cntB, sumR_eq]
  refine Finset.sum_congr rfl (fun a _ => ?_)
  rw [Finset.sum_product, sumR_eq]
  refine Finset.sum_congr rfl (fun b _ => ?_)
  rw [sumR_eq, ← Fin.sum_univ_eq_sum_range (fun s => cond (Nat.beq (FN a b s) f) 1 0) 26]
  refine Finset.sum_congr rfl (fun s _ => ?_)
  dsimp only
  cases h : Nat.beq (FN a b s.val) f
  · rw [if_neg (Nat.ne_of_beq_eq_false h)]
    rfl
  · rw [if_pos (Nat.eq_of_beq_eq_true h)]
    rfl

/-! ## The coordination sequence

`a n` counts the level set F = n from n = 6 on (`a_eq_cnt`, from `a_eq_F`), and `small_vals`
lists the terms below 6. The terms from 6 to 14 are counted in the box, those from 15 on
are S(n), and all agree with the closed form b (`a_eq_b`). The step from n to n + 28, the closed form
per residue (`a_closed`), the controls, the recurrence and the g.f. follow, their base cases checked by
the kernel on b. -/

theorem a_eq_cnt (n : ℕ) (hn : 6 ≤ n) : a n = cnt n := by
  rw [a_eq_F n hn, cnt]
  congr 1
  ext v
  simp only [Set.mem_ofPred_eq]
  have := F_nonneg v
  omega

theorem a_eq_S (n : ℕ) (hn : 15 ≤ n) : (a n : ℤ) = S n := by
  rw [a_eq_cnt n (by omega)]
  exact cnt_eq_S n (by exact_mod_cast hn)

def smallR0K : PLift ((List.range 6).map b = [1, 3, 8, 11, 12, 19]) :=
  ⟨by decide +kernel⟩

theorem a_lt_R0 (n : ℕ) (hn : n < 6) : a n = b n := by
  have h : (List.range 6).map a = (List.range 6).map b := by
    rw [small_vals]
    exact smallR0K.down.symm
  exact List.map_inj_left.1 h n (List.mem_range.2 hn)

/-- The coordination sequence in closed form. -/
theorem a_eq_b (n : ℕ) : a n = b n := by
  rcases (show n < 6 ∨ (6 ≤ n ∧ n < 15) ∨ 15 ≤ n by omega) with h | ⟨h1, h2⟩ | h
  · exact a_lt_R0 n h
  · rw [a_eq_cnt n h1, cnt_small _ (by omega)]
    exact small_eq n h1 h2
  · have h1 := a_eq_S n h
    rw [S_eq_b n h] at h1
    exact_mod_cast h1

def dconst_baseK : PLift (∀ r : ℕ, r < 28 → dtabV r = 104) :=
