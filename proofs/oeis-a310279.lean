open PowerSeries in
/-- The denominator times A, as a sum of monomials. -/
theorem gf_den (A : ℚ⟦X⟧) : A * (X ^ 10 - X ^ 9 + X ^ 8 - X ^ 7 - X ^ 3 + X ^ 2 - X + 1) = C 1 * A - C 1 * (A * X ^ 1) + C 1 * (A * X ^ 2) - C 1 * (A * X ^ 3) - C 1 * (A * X ^ 7) + C 1 * (A * X ^ 8) - C 1 * (A * X ^ 9) + C 1 * (A * X ^ 10) := by
  simp only [map_one]
  ring

open PowerSeries in
/-- The numerator as a sum of monomials. -/
theorem gf_num : (-X ^ 15 + X ^ 14 - 2 * X ^ 13 + X ^ 12 + X ^ 11 - X ^ 10 + 6 * X ^ 9 + 4 * X ^ 8 + 7 * X ^ 7 + 6 * X ^ 6 + 10 * X ^ 5 + 6 * X ^ 4 + 5 * X ^ 3 + 6 * X ^ 2 + 2 * X + 1 : ℚ⟦X⟧) = X ^ 0 * C 1 + X ^ 1 * C 2 + X ^ 2 * C 6 + X ^ 3 * C 5 + X ^ 4 * C 6 + X ^ 5 * C 10 + X ^ 6 * C 6 + X ^ 7 * C 7 + X ^ 8 * C 4 + X ^ 9 * C 6 - X ^ 10 * C 1 + X ^ 11 * C 1 + X ^ 12 * C 1 - X ^ 13 * C 2 + X ^ 14 * C 1 - X ^ 15 * C 1 := by
  simp only [map_ofNat, map_one]
  ring

open PowerSeries in
/-- The generating function. -/
theorem gf : PowerSeries.mk (fun n => (a n : ℚ)) * (X ^ 10 - X ^ 9 + X ^ 8 - X ^ 7 - X ^ 3 + X ^ 2 - X + 1) =
      -X ^ 15 + X ^ 14 - 2 * X ^ 13 + X ^ 12 + X ^ 11 - X ^ 10 + 6 * X ^ 9 + 4 * X ^ 8 + 7 * X ^ 7 + 6 * X ^ 6 + 10 * X ^ 5 + 6 * X ^ 4 + 5 * X ^ 3 + 6 * X ^ 2 + 2 * X + 1 := by
  set A : ℚ⟦X⟧ := PowerSeries.mk (fun n => (a n : ℚ)) with hA
  rw [gf_den A, gf_num]
  ext n
  have hc : ∀ k, coeff k A = (b k : ℚ) := fun k => by rw [hA, coeff_mk, a_eq_b]
  simp only [map_add, map_sub, coeff_C_mul, coeff_mul_C, coeff_X_pow, coeff_mul_X_pow', hc]
  rcases Nat.lt_or_ge n 16 with hn | hn
  · linarith [gf_low n hn]
  · obtain ⟨q, rfl⟩ : ∃ q, n = q + 16 := ⟨n - 16, by omega⟩
    linarith [gf_high q]

