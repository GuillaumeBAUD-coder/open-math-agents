theorem dconst_base : ∀ r : ℕ, r < 28 → dtabV r = 104 := dconst_baseK.down

theorem dv_const : ∀ t : ℕ, dv t = 104 := by
  intro t
  rw [dv]
  exact dconst_base _ (Nat.mod_lt _ (by norm_num))

/-- The step a(n + 28) = a(n) + 104 for n ≥ 6. -/
theorem a_step (n : ℕ) (hn : 6 ≤ n) : a (n + 28) = a n + 104 := by
  rw [a_eq_b, a_eq_b, b_step n hn, dv_const]

