        have h := b_step (v + 15) (le_trans (by decide : 6 ≤ 15) (Nat.le_add_left _ v))
        rw [show v + 15 + 28 = v + 43 from Nat.add_assoc _ _ _,
          show v + 15 - 6 = v + 9 from Nat.add_sub_assoc (by decide : 6 ≤ 15) v] at h
