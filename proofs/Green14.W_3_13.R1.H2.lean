import OMAReductions.R_Green14_W_3_13_R1

/-!
# The middle two central gaps for W(3,13)

Formal proof and search certificate by @anmolspace. Ahmed, Kullmann, and Snevily
determined the van der Waerden number. The central-gap reduction is due to
NickLeko in PR 3990. The bit-mask arguments adapt PR 4877 and its credited
predecessors MrSeizy, Vincent T. Mossman, and PanPapag.

Choose the first red point to the right of the given red point. Its distance g
is at most thirteen. For distances five through nine, restrict to a symmetric
window of length 165-g. Reflection puts the nearest red point outside the gap
on the left. For distances ten through thirteen, a common 159-site window
suffices. An exhaustive certificate excludes the resulting 64 configurations.

The checker prioritizes a progression without an available red point, then a
progression with a unique candidate. Its tape encodes common binary choices by a candidate's rank in a two-site
progression and records other choices by position. Presence flags and offsets
locate the two subtrees independently. When the trace indicates an immediate
split, the checker can branch without searching for a forced point. Every
choice is justified by case splitting on the point's color.
-/

namespace OMA.GreenH2Windows

private def NoTriple (R : Nat → Prop) :=
  ∀ a d, 0 < d → R a → R (a+d) → R (a+2*d) → False

private theorem distinct_terms {R : Nat → Prop} (hn : NoTriple R) {u v w : Nat}
    (hu : R u) (hv : R v) (hw : R w) (he : u+w=2*v) (hne : u ≠ w) : False := by
  rcases (show u < w ∨ w < u by omega) with h | h
  · exact hn u (v-u) (by omega) hu (by simpa only [show u+(v-u)=v by omega] using hv)
      (by simpa only [show u+2*(v-u)=w by omega] using hw)
  · exact hn w (v-w) (by omega) hw (by simpa only [show w+(v-w)=v by omega] using hv)
      (by simpa only [show w+2*(v-w)=u by omega] using hu)

-- Four views of the chosen red positions give every forbidden third point
-- by shifts. The last two views compress even and odd positions separately.
private structure Marks where
  rev : Nat
  dbl : Nat
  ev : Nat
  od : Nat
  deriving DecidableEq

private def mark (q : Nat) : Marks :=
  ⟨1 <<< (5*(160-q)), 1 <<< (10*q),
    if q%2=0 then 1 <<< (5*(q/2)) else 0,
    if q%2=1 then 1 <<< (5*(q/2)) else 0⟩

private def join (s t : Marks) : Marks :=
  ⟨s.rev ||| t.rev, s.dbl ||| t.dbl, s.ev ||| t.ev, s.od ||| t.od⟩

private def forbidden (s : Marks) (p : Nat) : Nat :=
  ((s.rev <<< (10*p)) >>> 800) ||| (s.dbl >>> (5*p)) |||
    ((if p%2=0 then s.ev else s.od) <<< (5*((p+1)/2)))

private def Good (R : Nat → Prop) (s : Marks) :=
  ∀ p t, R p → R t → t ≠ p → (forbidden s p).testBit (5*t) = false

private theorem mark_good {R : Nat → Prop} (hn : NoTriple R)
    {q : Nat} (hq : R q) (hq' : q ≤ 160) : Good R (mark q) := by
  intro p t hp ht hne
  have h₁ : t+q ≠ 2*p := fun he =>
    distinct_terms hn ht hp hq he (by rintro rfl; omega)
  have h₂ : t+p ≠ 2*q := fun he => distinct_terms hn ht hq hp he hne
  have h₃ : p+q ≠ 2*t := fun he =>
    distinct_terms hn hp ht hq he (by rintro rfl; omega)
  have single (x i : Nat) : (1 <<< x : Nat).testBit i = decide (x=i) := by
    rw [Nat.shiftLeft_eq, Nat.one_mul, Nat.testBit_two_pow]
  unfold forbidden mark
  by_cases ep : p%2=0 <;> by_cases eqo : q%2=1 <;> by_cases eqe : q%2=0 <;>
    simp only [ep, eqe, eqo, if_true, if_false, Nat.testBit_or, Nat.testBit_shiftRight, single,
    Nat.testBit_shiftLeft, Nat.zero_testBit, Bool.or_eq_false_iff,
    Bool.and_eq_false_imp, decide_eq_true_eq, decide_eq_false_iff_not]
  all_goals (repeat' apply And.intro) <;> intros <;> first | trivial | omega | simp

private theorem join_good {R : Nat → Prop} {s u : Marks} (hs : Good R s) (hu : Good R u) :
    Good R (join s u) := by
  intro p t hp ht hn
  have h₁ := hs p t hp ht hn
  have h₂ := hu p t hp ht hn
  unfold forbidden at *
  unfold join
  by_cases ep : p%2=0 <;> simp_all [Nat.testBit_or, Nat.testBit_shiftRight, Nat.testBit_shiftLeft]

private def addRed (s : Marks) (a p : Nat) : Marks × Nat :=
  let bad := forbidden s p
  (join s (mark p), (a ^^^ (a &&& bad)) ||| (1 <<< (5*p)))

private def Bad (hit : (Nat → Prop) → Prop) (seed : Marks × Nat) :=
  ∀ R : Nat → Prop, (∀ x, R x → x ≤ 160) → NoTriple R → hit R →
    Good R seed.1 → (∀ x, R x → seed.2.testBit (5*x) = true) → False

private theorem add_safe {R : Nat → Prop} {s : Marks} {a p : Nat} (hs : Good R s)
    (ha : ∀ x, R x → a.testBit (5*x) = true) (hp : R p) :
    ∀ x, R x → (addRed s a p).2.testBit (5*x) = true := by
  intro x hx
  by_cases he : x = p
  · simp [addRed, he, Nat.shiftLeft_eq]
  · simp [addRed, Nat.testBit_xor, ha x hx, hs p x hp hx he]

private def bases : Array Nat := #[0x1084210842108421,0x1004010040100401004010040100401,0x1000200040008001000200040008001000200040008001,0x1000010000100001000010000100001000010000100001000010000100001,0x1000000800000400000200000100000080000040000020000010000008000004000002000001,0x1000000040000001000000040000001000000040000001000000040000001000000040000001000000040000001,0x1000000002000000004000000008000000010000000020000000040000000080000000100000000200000000400000000800000001,0x1000000000100000000010000000001000000000100000000010000000001000000000100000000010000000001000000000100000000010000000001,0x1000000000008000000000040000000000200000000001000000000008000000000040000000000200000000001000000000008000000000040000000000200000000001,0x1000000000000400000000000100000000000040000000000010000000000004000000000001000000000000400000000000100000000000040000000000010000000000004000000000001,0x1000000000000020000000000000400000000000008000000000000100000000000002000000000000040000000000000800000000000010000000000000200000000000004000000000000080000000000001,0x1000000000000001000000000000001000000000000001000000000000001000000000000001000000000000001000000000000001000000000000001000000000000001000000000000001000000000000001000000000000001,0x1000000000000000080000000000000004000000000000000200000000000000010000000000000000800000000000000040000000000000002000000000000000100000000000000008000000000000000400000000000000020000000000000001]

private def pattern (n : Nat) (i : Nat) : Nat :=
  let e := i % 161
  let d := i / 161 + 1
  if 12*d ≤ e ∧ e < n then
    bases[d-1]! <<< (5*(e-12*d))
  else bases[0]!

private def Hits (n : Nat) (R : Nat → Prop) :=
  ∀ i, ∃ t, (pattern n i).testBit (5*t) = true ∧ R t

private def pointIndex (x : Nat) : Nat :=
  (( : Nat) >>> (8*((x ^^^ (x-1))%173))) % 256

private def slotIndex (x : Nat) : Nat :=
  (( : Nat) >>> (12*((x ^^^ (x-1))%2099))) % 4096

private def convolution : Nat := 
private def slots : Nat := 
private def high : Nat := slots <<< 4
private def fieldMask : Nat := slots * 31
-- The fifth bit of each progression records whether it already meets red.
private def pointHits (p : Nat) : Nat := ((convolution <<< (5*p)) &&& slots) <<< 4

private def redHits (board : Nat) : Nat :=
  high - ((high - ((board * convolution) &&& fieldMask)) &&& high)

private def erase (a p : Nat) := a ^^^ (a &&& (1 <<< (5*p)))

private theorem erase_safe {R : Nat → Prop} {a p : Nat}
    (ha : ∀ x, R x → a.testBit (5*x) = true) (hp : ¬R p) :
    ∀ x, R x → (erase a p).testBit (5*x) = true := by
  intro t ht
  have hne : p ≠ t := fun he => hp (he ▸ ht)
  simp [erase, Nat.testBit_xor, ha t ht, Nat.shiftLeft_eq, Nat.testBit_two_pow, show 5*p ≠ 5*t by omega]


private abbrev State := (Marks × Nat) × (Nat × Nat)
private def leftStep (s : State) (p : Nat) : State :=
  (addRed s.1.1 s.1.2 p, (s.2.1 ||| pointHits p, s.2.2))
private def rightStep (s : State) (p : Nat) : State :=
  ((s.1.1, erase s.1.2 p), s.2)
private def Closed (s : State) := Bad (Hits s.2.2) s.1

private def matchGate (leaves : Array {s // Closed s}) (i : Nat) (s : State) : Bool :=
  match leaves[i]? with
  | none => false
  | some v => v.val == s

private theorem gate_sound (leaves : Array {s // Closed s}) (k : Nat) (s : State)
    (h : matchGate leaves k s = true) : Closed s := by
  unfold matchGate at h
  split at h
  · contradiction
  · rename_i v _
    exact (beq_iff_eq.mp h) ▸ v.property

-- Ranks 1, 0, 2, 3 and 4 have successively longer prefix codes.
-- Eleven bits carry the rarer ranks and previously verified subtree references.
private def word (tape i : Nat) : Nat :=
  let v := tape >>> i
  if v%2=0 then 449 else if v%4=1 then 448 else
  if v%8=3 then 256+(v>>>3)%256 else if v%16=7 then 193 else
  if v%32=15 then 192 else if v%64=31 then (v>>>6)%256 else 161+(v>>>6)%32

private def width (op : Nat) : Nat :=
  if op=449 then 1 else if op=448 then 2 else if 256≤op then 11 else
  if op=193 then 4 else if op=192 then 5 else if op<161 then 14 else 11

private def masks : Array Nat := #[,,,,]

private def active (s : State) : Nat := masks[s.2.2-156]! &&& (high-s.2.1)
private def counts (s : State) : Nat := high - ((s.1.2 * convolution) &&& fieldMask)

private def forced (mask tallies : Nat) : Nat :=
  let one := (tallies+slots) &&& mask
  if one=0 then 2093 else
    let zero := tallies &&& mask
    slotIndex (if zero=0 then one else zero)

private def firstSlot (mask : Nat) : Nat → Nat → Nat
  | 0, _ => 0
  | k+1, tallies =>
    let candidates := tallies &&& mask
    if candidates=0 then firstSlot mask k (tallies+slots) else slotIndex candidates

private def choose (s : State) (op mask tallies : Nat) : Nat × Nat :=
  if op < 161 then (op,2093) else
    let line := firstSlot mask 12 (tallies + 2*slots)
    let points := pattern s.2.2 line &&& s.1.2
    let red := if op=192 then pointIndex points else pointIndex (points &&& (points-1))
    (red,line)

private def view (tape : Nat) (i : Nat) : Nat :=
  (tape >>> i) % 131072

private def gateCode (op : Nat) : Bool := decide (161≤op ∧ op<192)

private def body (i op fields : Nat) : Nat :=
  let kind := fields%4
  i+width op+2+(if kind=3 then (if fields%8=7 then 15 else 1) else 0)

/-- Find the end of a short encoded subtree, without evaluating any coloring. -/
private def skipProgram (tape : Nat) : Nat → Nat → Nat → Nat
  | 0, i, _ => i
  | k+1, i, pending =>
    if pending=0 then i else
      let op := word tape i
      if gateCode op then skipProgram tape k (i+width op) (pending-1) else
        let fields := view tape (i+width op)
        let kind := fields%4
        let first := body i op fields
        if kind=3 && fields%8=7 then
          skipProgram tape k (first+fields/8) pending
        else skipProgram tape k first (pending-1+kind%2+kind/2)

private def forcedSlot (hint mask tallies op : Nat) (present : Bool) : Nat :=
  if hint<2093 then hint else if present && decide (256≤op) then 2093 else forced mask tallies

private def visit (leaves : Array {s // Closed s}) (tape : Nat) :
    Nat → Nat → State → Nat → Bool → Bool
  | 0, _, _, _, _ => false
  | fuel+1, i, s, hint, present =>
    let op := word tape i
    if present && gateCode op && matchGate leaves (op-161) s then true else
      let mask := active s
      let tallies := counts s
      let slot := forcedSlot hint mask tallies op present
      if slot<2093 then
        let rest := pattern s.2.2 slot &&& s.1.2
        if rest=0 then true else
          let p := pointIndex rest
          if rest=1 <<< (5*p) then visit leaves tape fuel i (leftStep s p) 2093 present else false
      else if present && !gateCode op then
        let pick := choose s (op%256) mask tallies
        let fields := view tape (i+width op)
        let kind := fields%4
        let first := body i op fields
        let second := if kind=3 then
          (if fields%8=7 then first+fields/8 else skipProgram tape 250 first 1)
          else first
        visit leaves tape fuel first (leftStep s pick.1) 2093 (kind%2==1) &&
        visit leaves tape fuel second (rightStep s pick.1) pick.2 (kind/2==1)
      else false

private theorem visit_sound {tape : Nat} (leaves : Array {s // Closed s})
    (fuel i : Nat) (s : State) (hint : Nat) (present : Bool)
    (hw : visit leaves tape fuel i s hint present = true) : Closed s := by
  induction fuel generalizing i s hint present with
  | zero => contradiction
  | succ fuel ih =>
    simp only [visit] at hw
    split at hw
    · rename_i h
      exact gate_sound leaves _ s (Bool.and_eq_true_iff.mp h).2
    · intro R bound hn hit hs ha
      split at hw
      · let slot := forcedSlot hint (active s) (counts s) (word tape i) present
        obtain ⟨t,hbit,ht⟩ := hit slot
        have hr : (pattern s.2.2 slot &&& s.1.2).testBit (5*t) = true := by simp [hbit, ha t ht]
        split at hw
        · rename_i hz
          change pattern s.2.2 slot &&& s.1.2=0 at hz
          simp [hz] at hr
        · split at hw
          · rename_i hsingle
            let p := pointIndex (pattern s.2.2 slot &&& s.1.2)
            change pattern s.2.2 slot &&& s.1.2=1 <<< (5*p) at hsingle
            rw [hsingle,Nat.shiftLeft_eq,Nat.one_mul,Nat.testBit_two_pow] at hr
            have hp : R p := (show t=p by have := of_decide_eq_true hr; omega) ▸ ht
            exact ih _ _ _ _ hw R bound hn hit (join_good hs (mark_good hn hp (bound _ hp))) (add_safe hs ha hp)
          · contradiction
      · split at hw
        · obtain ⟨hl,hr⟩ := Bool.and_eq_true_iff.mp hw
          by_cases hp : R (choose s ((word tape i)%256) (active s) (counts s)).1
          · exact ih _ _ _ _ hl R bound hn hit (join_good hs (mark_good hn hp (bound _ hp))) (add_safe hs ha hp)
          · exact ih _ _ _ _ hr R bound hn hit hs (erase_safe ha hp)
        · contradiction

private theorem certify {s : State} (tape : Nat) (leaves : Array {s // Closed s})
    (h : visit leaves tape 145 0 s 2093 (tape != 0) = true) : Closed s :=
  visit_sound leaves 145 0 s 2093 (tape != 0) h

private def densePoint (v : Nat) : Nat :=
  (( : Nat) >>> (8*((v ^^^ (v-1))%173)))%256

private def paint : Nat → Nat → Marks × Nat → Marks × Nat
  | 0, _, acc => acc
  | fuel+1, v, acc =>
    if v = 0 then acc else
      let p := densePoint v
      paint fuel (v &&& (v-1)) (join acc.1 (mark p), acc.2 ||| (1 <<< (5*p)))

