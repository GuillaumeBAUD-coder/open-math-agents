private def Goal (r : Fin 160 → Bool) :=
  ∃ (b : Bool) (a d : Fin 160), 0 < d.val ∧ a.val + (if b then 2 else 12)*d.val < 160 ∧
    ∀ t : Fin 13, t.val ≤ (if b then 2 else 12) → r (Fin.ofNat 160 (a.val + t.val*d.val)) = b

private lemma shift {width o : ℕ} (hw : o + width ≤ 160) (r : Fin 160 → Bool)
    (h : ∃ (b : Bool) (a d : ℕ), 0 < d ∧ a + (if b then 12 else 2)*d < width ∧
      ∀ t ≤ (if b then 12 else 2), (!r (Fin.ofNat 160 (o+(a+t*d)))) = b) : Goal r := by
  obtain ⟨b,a,d,hd,he,hh⟩ := h
  have hlen : (if b then 12 else 2 : ℕ) ≥ 1 := by cases b <;> decide
  have hdb := Nat.mul_le_mul_right d hlen
  refine ⟨!b, ⟨o+a, by omega⟩, ⟨d, by omega⟩, hd, ?_, ?_⟩
  · have hend : o + (a + (if b then 12 else 2)*d) < 160 := by omega
    cases b <;> simpa [Nat.add_assoc] using hend
  · intro t ht
    cases b <;> simp_all [Nat.add_assoc]

private lemma from2 (r : Fin 160 → Bool) (hr : r (Fin.ofNat 160 77) = true)
    (hb : ∀ x, 77 < x → x ≤ 81 → r (Fin.ofNat 160 x) = false) : Goal r := by
  apply shift (width := 160) (o := 0) (by decide)
  simpa only [Mono, Nat.zero_add] using
    Gap2.gap (fun x => !r (Fin.ofNat 160 x)) (by simp only [hr, Bool.not_true])
      (fun x hlo hhi => by simp only [hb x hlo hhi, Bool.not_false])

private lemma from3 (r : Fin 160 → Bool) (hr : r (Fin.ofNat 160 76) = true)
    (hb : ∀ x, 76 < x → x ≤ 82 → r (Fin.ofNat 160 x) = false) : Goal r := by
  apply shift (width := 160) (o := 0) (by decide)
  simpa only [Mono, Nat.zero_add] using
