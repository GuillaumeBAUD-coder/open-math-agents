import OMAReductions.R_Green14_W_3_13_R1

/-!
The 160-point coloring computation proves the two middle gaps of the reduction
by NickLeko (PR 3990). The mathematical value is due to Ahmed, Kullmann and
Snevily. The soundness proof and bit-mask propagation adapt PR 4877 and its
predecessors by MrSeizy, Vincent T. Mossman and PanPapag. We regenerate the
search tree for these two gaps and store candidate ranks in a packed tape.
-/

namespace OMA.Green14Middle



private def NoTriple (R : Nat → Prop) :=
  ∀ a d, 0 < d → R a → R (a+d) → R (a+2*d) → False

private lemma distinct_terms {R : Nat → Prop} (hn : NoTriple R) {u v w : Nat}
    (hu : R u) (hv : R v) (hw : R w) (he : u+w=2*v) (hne : u ≠ w) : False := by
  rcases lt_or_gt_of_ne hne with h | h
  · exact hn u (v-u) (by omega) hu (by simpa only [show u+(v-u)=v by omega] using hv)
      (by simpa only [show u+2*(v-u)=w by omega] using hw)
  · exact hn w (v-w) (by omega) hw (by simpa only [show w+(v-w)=v by omega] using hv)
      (by simpa only [show w+2*(v-w)=u by omega] using hu)

-- Four views of the chosen red positions give every forbidden third point
-- by shifts. The last two views compress even and odd positions separately.
private structure Marks where
  rev : Nat
  dbl : Nat
  ev : Nat
  od : Nat
  deriving DecidableEq

private def mark (q : Nat) : Marks :=
  ⟨1 <<< (9*(159-q)), 1 <<< (18*q),
    if q%2=0 then 1 <<< (9*(q/2)) else 0,
    if q%2=1 then 1 <<< (9*(q/2)) else 0⟩

private def join (s t : Marks) : Marks :=
  ⟨s.rev ||| t.rev, s.dbl ||| t.dbl, s.ev ||| t.ev, s.od ||| t.od⟩

private def forbidden (s : Marks) (p : Nat) : Nat :=
  ((s.rev <<< (18*p)) >>> 1431) ||| (s.dbl >>> (9*p)) |||
    ((if p%2=0 then s.ev else s.od) <<< (9*((p+1)/2)))

private def Good (R : Nat → Prop) (s : Marks) :=
  ∀ p t, R p → R t → t ≠ p → (forbidden s p).testBit (9*t) = false

private lemma mark_good {R : Nat → Prop} (hn : NoTriple R)
    {q : Nat} (hq : R q) (hq' : q ≤ 159) : Good R (mark q) := by
  intro p t hp ht hne
  have h₁ : t+q ≠ 2*p := fun he =>
    distinct_terms hn ht hp hq he (by rintro rfl; omega)
  have h₂ : t+p ≠ 2*q := fun he => distinct_terms hn ht hq hp he hne
  have h₃ : p+q ≠ 2*t := fun he =>
    distinct_terms hn hp ht hq he (by rintro rfl; omega)
  have single (x i : Nat) : (1 <<< x : Nat).testBit i = decide (x=i) := by
    rw [Nat.shiftLeft_eq, one_mul, Nat.testBit_two_pow]
  unfold forbidden mark
  split_ifs <;> simp only [Nat.testBit_or, Nat.testBit_shiftRight, single,
    Nat.testBit_shiftLeft, Nat.zero_testBit, Bool.or_eq_false_iff,
    Bool.and_eq_false_imp, decide_eq_true_eq, decide_eq_false_iff_not]
  all_goals (repeat' apply And.intro) <;> intros <;> first | trivial | omega

private lemma join_good {R : Nat → Prop} {s u : Marks} (hs : Good R s) (hu : Good R u) :
    Good R (join s u) := by
  intro p t hp ht hn
  have h₁ := hs p t hp ht hn
  have h₂ := hu p t hp ht hn
  unfold forbidden at *
  unfold join
  split_ifs at * <;> simp_all [Nat.testBit_or, Nat.testBit_shiftRight, Nat.testBit_shiftLeft]

private def addRed (s : Marks) (a p : Nat) : Marks × Nat :=
  let bad := forbidden s p
  (join s (mark p), (a ^^^ (a &&& bad)) ||| (1 <<< (9*p)))

private def Bad (hit : (Nat → Prop) → Prop) (seed : Marks × Nat) :=
  ∀ R : Nat → Prop, (∀ x, R x → x ≤ 159) → NoTriple R → hit R →
    Good R seed.1 → (∀ x, R x → seed.2.testBit (9*x) = true) → False

private lemma add_safe {R : Nat → Prop} {s : Marks} {a p : Nat} (hs : Good R s)
    (ha : ∀ x, R x → a.testBit (9*x) = true) (hp : R p) :
    ∀ x, R x → (addRed s a p).2.testBit (9*x) = true := by
  intro x hx
  by_cases he : x = p
  · simp [addRed, he, Nat.shiftLeft_eq]
  · simp [addRed, Nat.testBit_xor, ha x hx, hs p x hp hx he]

private def bases : Array Nat := #[0x1008040201008040201008040201,0x1000040001000040001000040001000040001000040001000040001,0x1000000200000040000008000001000000200000040000008000001000000200000040000008000001,0x1000000001000000001000000001000000001000000001000000001000000001000000001000000001000000001000000001000000001,0x1000000000008000000000040000000000200000000001000000000008000000000040000000000200000000001000000000008000000000040000000000200000000001,0x1000000000000040000000000001000000000000040000000000001000000000000040000000000001000000000000040000000000001000000000000040000000000001000000000000040000000000001,0x1000000000000000200000000000000040000000000000008000000000000001000000000000000200000000000000040000000000000008000000000000001000000000000000200000000000000040000000000000008000000000000001,0x1000000000000000001000000000000000001000000000000000001000000000000000001000000000000000001000000000000000001000000000000000001000000000000000001000000000000000001000000000000000001000000000000000001000000000000000001,0x1000000000000000000008000000000000000000040000000000000000000200000000000000000001000000000000000000008000000000000000000040000000000000000000200000000000000000001000000000000000000008000000000000000000040000000000000000000200000000000000000001,0x1000000000000000000000040000000000000000000001000000000000000000000040000000000000000000001000000000000000000000040000000000000000000001000000000000000000000040000000000000000000001000000000000000000000040000000000000000000001000000000000000000000040000000000000000000001,,,]

private def pattern (i : Nat) : Nat :=
  let e := i%160
  let d := i/160+1
  if 12*d ≤ e ∧ e < 160 then bases[d-1]! <<< (9*(e-12*d)) else bases[0]!

private def Hits (R : Nat → Prop) := ∀ i, ∃ t, (pattern i).testBit (9*t) = true ∧ R t

-- Each digit counts the remaining candidates for a progression. A chosen
-- point receives a bonus of fourteen, so a progression already hit is skipped.
-- Residue lookup for a position bit and for a progression-count flag.
private def pointIndex (x : Nat) : Nat :=
  (( : Nat) >>> (8*((x ^^^ (x-1))%173))) % 256

private def slotIndex (x : Nat) : Nat :=
  (( : Nat) >>> (12*((x ^^^ (x-1))%2099))) % 4096

private def convolution : Nat := 
private def slots : Nat := 
private def high : Nat := slots <<< 8
private def fieldMask : Nat := slots * 511
private def erase (a p : Nat) := a ^^^ (a &&& (1 <<< (9*p)))

private lemma erase_safe {R : Nat → Prop} {a p : Nat}
    (ha : ∀ x, R x → a.testBit (9*x) = true) (hp : ¬R p) :
    ∀ x, R x → (erase a p).testBit (9*x) = true := by
  intro t ht
  have hne : p ≠ t := fun he => hp (he ▸ ht)
  simp [erase, Nat.testBit_xor, ha t ht, Nat.shiftLeft_eq, hne]


private def forced (a bonus : Nat) : Nat :=
  let sums := ((a ||| bonus) * convolution) &&& fieldMask
  let z := (high - sums) &&& high
  if z != 0 then slotIndex z else
    let o := ((high + slots) - sums) &&& high
    if o != 0 then slotIndex o else 2080

private abbrev State := (Marks × Nat) × Nat
private def leftStep (s : State) (p : Nat) : State :=
  (addRed s.1.1 s.1.2 p, s.2 ||| (14 <<< (9*p)))
private def rightStep (s : State) (p : Nat) : State :=
  ((s.1.1, erase s.1.2 p), s.2)
private def Closed (s : State) := Bad Hits s.1

private def matchGate (leaves : Array {s // Closed s}) (i : Nat) (s : State) : Bool :=
  match leaves[i]? with
  | none => false
  | some v => v.val == s

private lemma gate_sound (leaves : Array {s // Closed s}) (k : Nat) (s : State)
    (h : matchGate leaves k s = true) : Closed s := by
  unfold matchGate at h
  split at h
  · contradiction
  · rename_i v _
    exact (beq_iff_eq.mp h) ▸ v.property

-- Each branching choice is a rank in a progression with few remaining points.
-- Two bits encode the three common ranks. The extended form encodes larger
-- ranks and references to independently checked subtrees.
private def word (tape : Array Nat) (i : Nat) : Nat :=
  let v := (tape[i/128]?.getD 0 >>> (2*(i%128))) % 256
  if v % 4 = 3 then 3 + v/4 else v%4

private def width (op : Nat) : Nat := if op < 3 then 1 else 4

private def tight (sums : Nat) : Nat → Nat → Nat
  | 0, _ => 0
  | fuel+1, k =>
    let hits := (high + k*slots - sums) &&& high
    if hits != 0 then slotIndex hits else tight sums fuel (k+1)

private def dropPoints : Nat → Nat → Nat
  | 0, v => v
  | n+1, v => dropPoints n (v &&& (v-1))

private def pick (s : State) (rk : Nat) : Nat :=
  let sums := ((s.1.2 ||| s.2) * convolution) &&& fieldMask
  let slot := tight sums 12 2
  pointIndex (dropPoints rk (pattern slot &&& s.1.2))

-- Return one plus the next tape index. The value zero reports a failed check.
-- Only an actual split or subtree reference consumes a tape entry.
private def visit (leaves : Array {s // Closed s}) (tape : Array Nat) :
    Nat → Nat → State → Nat
  | 0, _, _ => 0
  | fuel+1, i, s =>
    let op := word tape i
    if op ≥ 16 && matchGate leaves (op-16) s then i+width op+1 else
      let slot := forced s.1.2 s.2
      if slot < 2080 then
        let rest := pattern slot &&& s.1.2
        if rest = 0 then i+1 else
          let p := pointIndex rest
          if rest = (1 <<< (9*p)) then visit leaves tape fuel i (leftStep s p) else 0
      else if op < 16 then
        let next := visit leaves tape fuel (i+width op) (leftStep s (pick s op))
        if next = 0 then 0 else visit leaves tape fuel (next-1) (rightStep s (pick s op))
      else 0

private lemma visit_sound {tape : Array Nat} (leaves : Array {s // Closed s})
    (fuel i : Nat) (s : State) (hw : visit leaves tape fuel i s ≠ 0) : Closed s := by
  induction fuel generalizing i s with
  | zero => simp [visit] at hw
  | succ fuel ih =>
    simp only [visit] at hw
    split at hw
    · rename_i he
      exact gate_sound leaves _ s (Bool.and_eq_true_iff.mp he).2
    · intro R bound hn hit hs ha
      split at hw
      · let slot := forced s.1.2 s.2
        obtain ⟨t,hbit,ht⟩ := hit slot
        have hr : (pattern slot &&& s.1.2).testBit (9*t) = true := by simp [hbit, ha t ht]
        split at hw
        · rename_i hz
          change pattern slot &&& s.1.2 = 0 at hz
          simp [hz] at hr
        · split at hw
          · rename_i hsingle
            let p := pointIndex (pattern slot &&& s.1.2)
            change pattern slot &&& s.1.2 = 1 <<< (9*p) at hsingle
            rw [hsingle, Nat.shiftLeft_eq, one_mul, Nat.testBit_two_pow] at hr
            have hp : R p := (show t = p by have := of_decide_eq_true hr; omega) ▸ ht
            exact ih _ _ hw R bound hn hit (join_good hs (mark_good hn hp (bound _ hp))) (add_safe hs ha hp)
          · contradiction
      · split at hw
        · split at hw
          · contradiction
          · rename_i hleft
            by_cases hp : R (pick s (word tape i))
            · exact ih _ _ hleft R bound hn hit (join_good hs (mark_good hn hp (bound _ hp))) (add_safe hs ha hp)
            · exact ih _ _ hw R bound hn hit hs (erase_safe ha hp)
        · contradiction

private lemma certify {s : State} (tape : Array Nat) (leaves : Array {s // Closed s})
    (h : visit leaves tape 145 0 s ≠ 0) : Closed s := visit_sound leaves 145 0 s h

-- Expand a conventional board mask into base-512 digits and reconstruct its
-- reflected, doubled and parity masks. The encoder is only used at chunk boundaries.
private def boardMask (red : Nat) (place : Nat → Nat) :=
  (List.range 160).foldl (fun z i => if red.testBit i then z ||| (1 <<< place i) else z) 0

private def fromBits (red allow : Nat) : State :=
  let oddMask := 0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
  let evenMask := 0x5555555555555555555555555555555555555555
  ((⟨boardMask red (fun i => 9*(159-i)), boardMask red (fun i => 18*i),
     boardMask (red &&& evenMask) (fun i => 9*(i/2)), boardMask (red &&& oddMask) (fun i => 9*(i/2))⟩,
    boardMask allow (fun i => 9*i)), 14 * boardMask red (fun i => 9*i))

private def Mono (r : Nat → Bool) := ∃ (b : Bool) (a d : ℕ),
  0 < d ∧ a + (if b then 12 else 2)*d < 160 ∧
  ∀ t ≤ (if b then 12 else 2), r (a+t*d) = b

private def Red (r : Nat → Bool) (x : Nat) := x < 160 ∧ r x = false

private lemma triple_free {r : Nat → Bool} (hn : ¬ Mono r) : NoTriple (Red r) := by
  intro a d hd h₀ h₁ h₂
  apply hn
  refine ⟨false, a, d, hd, h₂.1, ?_⟩
  intro t ht
  change t ≤ 2 at ht
  rcases (show t=0 ∨ t=1 ∨ t=2 by omega) with he|he|he
  · simpa [he] using h₀.2
  · simpa [he] using h₁.2
  · simpa [he] using h₂.2

private lemma base_bit : ∀ d : Fin 14, 0 < d.val → ∀ t : Fin 13,
    bases[d.val-1]!.testBit (9*(t.val*d.val)) = true := by decide +kernel

private lemma hit_at {r : Nat → Bool} {a d : Nat} (hn : ¬ Mono r)
    (hd : 0 < d) (hb : a+12*d < 160) :
    ∃ t, (bases[d-1]! <<< (9*a)).testBit (9*t) = true ∧ Red r t := by
  by_contra! bad
  apply hn
  refine ⟨true, a, d, hd, hb, ?_⟩
  intro t ht
  change t ≤ 12 at ht
  have hle := Nat.mul_le_mul_right d ht
  have hm : (bases[d-1]! <<< (9*a)).testBit (9*(a+t*d)) = true := by
    simpa [Nat.testBit_shiftLeft, Nat.mul_add, Nat.le_add_right] using
      base_bit ⟨d,by omega⟩ hd ⟨t,by omega⟩
  cases he : r (a + t*d) with
  | false => exact False.elim (bad _ hm ⟨by omega, he⟩)
  | true => rfl

private lemma hit_all {r : Nat → Bool} (hn : ¬ Mono r) : Hits (Red r) := by
  intro i
  dsimp only [pattern]
  split
  · apply hit_at hn <;> omega
  · simpa using hit_at (a:=0) (d:=1) hn (by decide) (by decide)


