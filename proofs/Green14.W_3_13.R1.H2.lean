  v

private def fromBits (n red allow : Nat) : State :=
  let acc := paint 161 red (⟨0,0,0,0⟩,0)
  ((acc.1,widen allow),(redHits acc.2,n))

private abbrev Cover (n red allow : Nat) := Closed (fromBits n red allow)

