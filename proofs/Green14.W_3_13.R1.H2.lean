private def Goal (r : Fin 160 → Bool) :=
  ∃ (b : Bool) (a d : Fin 160), 0 < d.val ∧ a.val + (if b then 2 else 12)*d.val < 160 ∧
    ∀ t : Fin 13, t.val ≤ (if b then 2 else 12) → r (Fin.ofNat 160 (a.val + t.val*d.val)) = b

private def R (o : Nat) (r : Fin 160 → Bool) (x : Nat) : Prop :=
  o ≤ x ∧ x < o + 160 ∧ r (Fin.ofNat 160 (x - o)) = true

private theorem noTriple_of {r : Fin 160 → Bool} (hn : ¬ Goal r) (o : Nat) :
    NoTriple (R o r) := by
  intro a d hd h₀ h₁ h₂
  obtain ⟨ha, _, h₀⟩ := h₀
  obtain ⟨_, _, h₁⟩ := h₁
  obtain ⟨_, he, h₂⟩ := h₂
  apply hn
  have hend : a - o + 2 * d < 160 := by omega
  refine ⟨true, ⟨a - o, by omega⟩, ⟨d, by omega⟩, hd, hend, ?_⟩
  intro t ht
  change t.val ≤ 2 at ht
  change r (Fin.ofNat 160 (a - o + t.val * d)) = true
  rcases (show t.val = 0 ∨ t.val = 1 ∨ t.val = 2 by omega) with hz | hu | ht
  · simpa only [hz, Nat.zero_mul, Nat.add_zero] using h₀
  · simpa only [hu, Nat.one_mul, show a + d - o = a - o + d by omega] using h₁
  · simpa only [ht, show a + 2 * d - o = a - o + 2 * d by omega] using h₂

private theorem red_hits {r : Fin 160 → Bool} (hn : ¬ Goal r) {o a d : Nat}
    (ha : o ≤ a) (hd : 0 < d) (he : a + 12 * d < o + 160) :
    ∃ t ≤ 12, R o r (a + t * d) := by
  apply Classical.byContradiction
  intro h
  apply hn
  have hend : a - o + 12 * d < 160 := by omega
  refine ⟨false, ⟨a - o, by omega⟩, ⟨d, by omega⟩, hd, hend, ?_⟩
  intro t ht
  change t.val ≤ 12 at ht
  change r (Fin.ofNat 160 (a - o + t.val * d)) = false
  cases hv : r (Fin.ofNat 160 (a - o + t.val * d)) with
  | false => rfl
  | true =>
    exfalso
    apply h
    have htd : t.val * d ≤ 12 * d := Nat.mul_le_mul_right d ht
    refine ⟨t.val, ht, by omega, by omega, ?_⟩
    simpa only [show a + t.val * d - o = a - o + t.val * d by omega] using hv

private def LineMeets (n : Nat) (S : Nat → Prop) : Prop :=
  ∀ a d, 0 < d → a+12*d<n → ∃ t ≤ 12, S (a+t*d)

private structure Window (n : Nat) (S : Nat → Prop) : Prop where
  inside : ∀ x, S x → x<n
  triples : NoTriple S
  meets : LineMeets n S

private def slice (n off : Nat) (S : Nat → Prop) (x : Nat) : Prop := x<n ∧ S (off+x)

private theorem slice_window {m n off : Nat} {S : Nat → Prop} (h : Window m S)
    (hn : off+n ≤ m) : Window n (slice n off S) := by
  refine ⟨fun _ hx => hx.1, ?_, ?_⟩
  · intro a d hd h₀ h₁ h₂
    exact h.triples (off+a) d hd h₀.2 (by simpa [Nat.add_assoc] using h₁.2)
      (by simpa [Nat.add_assoc] using h₂.2)
  · intro a d hd hend
    obtain ⟨t,ht,hs⟩ := h.meets (off+a) d hd (by omega)
    exact ⟨t,ht,by have := Nat.mul_le_mul_right d ht; omega, by simpa [Nat.add_assoc] using hs⟩

private def mirror (n : Nat) (S : Nat → Prop) (x : Nat) := x<n ∧ S (n-1-x)

private theorem mirror_window {n : Nat} {S : Nat → Prop} (h : Window n S) : Window n (mirror n S) := by
  refine ⟨fun _ hx => hx.1, ?_, ?_⟩
  · intro a d hd h₀ h₁ h₂
    apply h.triples (n-1-(a+2*d)) d hd h₂.2
    · simpa only [show n-1-(a+2*d)+d=n-1-(a+d) by have := h₂.1; omega] using h₁.2
    · simpa only [show n-1-(a+2*d)+2*d=n-1-a by have := h₂.1; omega] using h₀.2
  · intro a d hd he
    obtain ⟨t,ht,hs⟩ := h.meets (n-1-(a+12*d)) d hd (by omega)
    have hmul := Nat.mul_le_mul_right d ht
    refine ⟨12-t,by omega, ?_, ?_⟩
    · rw [Nat.sub_mul]; omega
    · simpa only [show n-1-(a+(12-t)*d)=n-1-(a+12*d)+t*d by rw [Nat.sub_mul]; omega] using hs

private theorem least {P : Nat → Prop} (v : Nat) (hv : P v) :
    ∃ k ≤ v, P k ∧ ∀ t < k, ¬P t := by
  induction v using Nat.strongRecOn with
  | ind v ih =>
    by_cases earlier : ∃ t < v, P t
    · obtain ⟨t,ht,hP⟩ := earlier
      obtain ⟨k,hk,hQ,hm⟩ := ih t ht hP
      exact ⟨k,by omega,hQ,hm⟩
    · exact ⟨v,by omega,hv,fun t ht h => earlier ⟨t,ht,h⟩⟩

private structure Arrangement (n p q u : Nat) (S : Nat → Prop) : Prop where
  window : Window n S
  leftRed : S p
  rightRed : S q
  blue : ∀ x, p<x → x<q → ¬S x
  extra : u>0 → S (p-u)
  nearBlue : ∀ t, 0<t → t<u → ¬S (p-t) ∧ ¬S (q+t)

private theorem orient {n p q : Nat} {S : Nat → Prop} (h : Window n S)
    (hc : p+q+1=n) (enough : 13≤p) (hpq : p<q)
    (hp : S p) (hq : S q) (blue : ∀ x, p<x → x<q → ¬S x) :
    ∃ u, 1≤u ∧ u≤13 ∧ ∃ T, Arrangement n p q u T := by
  obtain ⟨k,hk,hS⟩ := h.meets (p-13) 1 (by decide) (by omega)
  let P := fun u => 0<u ∧ (S (p-u) ∨ S (q+u))
  have ex : P (13-k) := ⟨by omega,Or.inl (by
    simpa only [Nat.mul_one, show p-13+k=p-(13-k) by omega] using hS)⟩
  obtain ⟨u,hu,huP,hmin⟩ := least (P:=P) (13-k) ex
  obtain ⟨positive, side⟩ := huP
  have near (t : Nat) (ht : 0<t) (ht' : t<u) : ¬S (p-t) ∧ ¬S (q+t) :=
    ⟨fun a => hmin t ht' ⟨ht, Or.inl a⟩, fun a => hmin t ht' ⟨ht,Or.inr a⟩⟩
  refine ⟨u,by omega,by omega,?_⟩
  rcases side with hl|hr
  · exact ⟨S,h,hp,hq,blue,fun _ => hl,near⟩
  · refine ⟨mirror n S,mirror_window h,?_,?_,?_,?_,?_⟩
    · exact ⟨by omega, (show n-1-p=q by omega) ▸ hq⟩
    · exact ⟨by omega, (show n-1-q=p by omega) ▸ hp⟩
    · intro a h₁ h₂ hm
      exact blue (n-1-a) (by omega) (by omega) hm.2
    · intro _
      exact ⟨by omega, (show n-1-(p-u)=q+u by omega) ▸ hr⟩
    · intro t ht hlt
      obtain ⟨nl,nr⟩ := near t ht hlt
      exact ⟨fun a => nr ((show n-1-(p-t)=q+t by omega) ▸ a.2),
        fun a => nl ((show n-1-(q+t)=p-t by omega) ▸ a.2)⟩

private theorem original_window {r : Fin 160 → Bool} (hn : ¬ Goal r) : Window 160 (R 0 r) := by
  exact ⟨fun x hx => by have := hx.2.1; omega, noTriple_of hn 0,
    fun a d hd he => red_hits hn (by omega) hd (by omega)⟩

private theorem cases_for {r : Fin 160 → Bool} {j : Fin 7} (hn : ¬ Goal r)
    (hlo : 2≤j.val) (hhi : j.val≤3)
    (hr : r (Fin.ofNat 160 (79-j.val))=true)
    (hb : ∀ i : Fin 160, 79-j.val<i.val → i.val<80+j.val → r i=false) :
    (∃ g u T, 5≤g ∧ g≤9 ∧ 1≤u ∧ u≤13 ∧ Arrangement (165-g) (82-g) 82 u T) ∨
    (∃ g T, 10≤g ∧ g≤13 ∧ Arrangement 159 76 (76+g) 0 T) := by
  let S := R 0 r
  let x := 79-j.val
  have hx : 76≤x ∧ x≤77 := by dsimp [x]; omega
  have win : Window 160 S := original_window hn
  have base : S x := ⟨by omega,by omega,by simpa [S,x] using hr⟩
  obtain ⟨k,hk,hS⟩ := win.meets (x+1) 1 (by decide) (by omega)
  let P := fun g => 0<g ∧ S (x+g)
  have e : P (1+k) := ⟨by omega,by simpa [Nat.add_assoc] using hS⟩
  obtain ⟨g,hg,⟨hgpos,hred⟩,minimal⟩ := least (P:=P) (1+k) e
  have gap : 2*j.val<g := by
    apply Classical.byContradiction
    intro h
    let i := Fin.ofNat 160 (x+g)
    have hi : i.val=x+g := by dsimp [i]; exact Nat.mod_eq_of_lt (by omega)
    have eq := hb i (by rw [hi]; dsimp [x] at *; omega) (by rw [hi]; dsimp [x] at *; omega)
    have red : r i=true := by simpa [S,R,i] using hred.2.2
    simp [eq] at red
  have noMid (a : Nat) (ha : x<a) (hb : a<x+g) : ¬S a := by
    intro h
    exact minimal (a-x) (by omega) ⟨by omega, by simpa only [show x+(a-x)=a by omega] using h⟩
  by_cases small : g≤9
  · left
    let p := 82-g
    let n := 165-g
    let off := x-p
    let T := slice n off S
    have hp : 13≤p ∧ p<82 := by dsimp [p]; omega
    have shifted : off+p=x := by dsimp [off,p,x] at *; omega
    have sum : off+82=x+g := by dsimp [off,p,x] at *; omega
    have length : off+n≤160 := by dsimp [off,n,p,x] at *; omega
    have hh : Window n T := slice_window win length
    have r₁ : T p := ⟨by dsimp [n,p]; omega,by simpa only [shifted] using base⟩
    have r₂ : T 82 := ⟨by dsimp [n]; omega,by simpa only [sum] using hred⟩
    have blue (a : Nat) (aa : p<a) (ab : a<82) : ¬T a :=
      fun ha => noMid (off+a) (by omega) (by omega) ha.2
    obtain ⟨u,h₁,h₂,U,hU⟩ := orient hh (by dsimp [n,p]; omega) hp.1 hp.2 r₁ r₂ blue
    exact ⟨g,u,U,by omega,small,h₁,h₂,hU⟩
  · right
    let off := x-76
    let T := slice 159 off S
    have h₁ : off+76=x := by dsimp [off]; omega
    have h₂ : off+(76+g)=x+g := by omega
    refine ⟨g,T,by omega,by omega,slice_window win (by dsimp [off]; omega),?_,?_,?_,?_,?_⟩
    · exact ⟨by decide, by simpa only [h₁] using base⟩
    · exact ⟨by omega, by simpa only [h₂] using hred⟩
    · intro a aa ab ha
      exact noMid (off+a) (by omega) (by omega) ha.2
    · omega
    · intro t _ ht; omega
private theorem base_bit : ∀ d : Fin 14, 0 < d.val → ∀ t : Fin 13,
    bases[d.val-1]!.testBit (5*(t.val*d.val)) = true := by decide +kernel

private theorem lineBit {d : Nat} (hd : 0 < d) (hd' : d ≤ 13) {t : Nat} (ht : t ≤ 12) (a : Nat) :
    (bases[d-1]! <<< (5*a)).testBit (5*(a+t*d)) = true := by
  simpa [Nat.testBit_shiftLeft, Nat.mul_add, Nat.le_add_right] using
    base_bit ⟨d,by omega⟩ hd ⟨t,by omega⟩

private theorem hits_window {n : Nat} {S : Nat → Prop} (hn : 13≤n ∧ n≤161) (hm : LineMeets n S) : Hits n S := by
  intro i
  let d := i/161+1
  let e := i%161
  by_cases h : 12*d ≤ e ∧ e < n
  · have hd : 0 < d := by dsimp [d]; omega
    have hd' : d ≤ 13 := by omega
    obtain ⟨t, ht, hr⟩ := hm (e-12*d) d hd (by omega)
    refine ⟨_, ?_, hr⟩
    simpa only [pattern, show 12*(i/161+1) ≤ i%161 ∧ i%161 < n from h, true_and, if_true] using lineBit hd hd' ht (e-12*d)
  · obtain ⟨t,ht,hr⟩ := hm 0 1 (by decide) (by omega)
    refine ⟨_, ?_, hr⟩
    simpa [pattern, show ¬(12*(i/161+1) ≤ i%161 ∧ i%161 < n) from h] using lineBit (d:=1) (by decide) (by decide) ht 0


private def Permitted (p q u x : Nat) := (x≤p ∨ q≤x) ∧ (x≤p-u ∨ p≤x) ∧ (x≤q ∨ q+u≤x)

private instance (p q u x : Nat) : Decidable (Permitted p q u x) :=
  inferInstanceAs (Decidable ((x≤p ∨ q≤x) ∧ (x≤p-u ∨ p≤x) ∧ (x≤q ∨ q+u≤x)))

private def planted (n p q u raw : Nat) : State :=
  let s : State := ((mark p,widen raw),(pointHits p,n))
  let t := leftStep s q
  if u=0 then t else leftStep t (p-u)

private theorem checked {n p q u r a : Nat} {S : Nat → Prop} (raw : Nat)
    (h : Arrangement n p q u S) (hc : Cover n r a) (hn : 13≤n ∧ n≤161)
    (ha : ∀ i : Fin n, Permitted p q u i.val → (widen raw).testBit (5*i.val)=true)
    (he : planted n p q u raw = fromBits n r a) : False := by
  have lim : ∀ x, S x → x≤160 := fun x hx => by have := h.window.inside x hx; omega
  have hp := mark_good h.window.triples h.leftRed (lim _ h.leftRed)
  have hq := mark_good h.window.triples h.rightRed (lim _ h.rightRed)
  have both := join_good hp hq
  have amb : ∀ x, S x → (widen raw).testBit (5*x)=true := by
    intro x hx
    apply ha ⟨x,h.window.inside _ hx⟩
    change (x≤p ∨ q≤x) ∧ (x≤p-u ∨ p≤x) ∧ (x≤q ∨ q+u≤x)
    refine ⟨?_,?_,?_⟩
    · by_cases a : p<x
      · exact Or.inr (Nat.le_of_not_gt (fun b => h.blue x a b hx))
      · omega
    · by_cases a : x<p
      · left
        apply Classical.byContradiction
        intro b
        have t := (h.nearBlue (p-x) (by omega) (by omega)).1
        rw [show p-(p-x)=x by omega] at t
        exact t hx
      · omega
    · by_cases a : q<x
      · right
        apply Classical.byContradiction
        intro b
        have t := (h.nearBlue (x-q) (by omega) (by omega)).2
        rw [show q+(x-q)=x by omega] at t
        exact t hx
      · omega
  have safeQ := add_safe hp amb h.rightRed
  have hit := hits_window hn h.window.meets
  have cl : Closed (planted n p q u raw) := he ▸ hc
  by_cases e : u=0
  · simp only [planted,e,if_true] at cl
    exact cl S lim h.window.triples hit both safeQ
  · simp only [planted,if_neg e] at cl
    have hu := h.extra (by omega)
    exact cl S lim h.window.triples hit (join_good both (mark_good h.window.triples hu (lim _ hu)))
      (add_safe both safeQ hu)
