    Nat.cast_zero, cast_bk, cast_ind] at hq
  linarith

/-- The coefficient identity of the g.f. from 17 on, from the recurrence. -/
theorem gf_high (q : ℕ) :
    1 * (b (q + 17) : ℚ) - 1 * (if 2 ≤ q + 17 then (b (q + 17 - 2) : ℚ) else 0) - 1 * (if 6 ≤ q + 17 then (b (q + 17 - 6) : ℚ) else 0) + 1 * (if 8 ≤ q + 17 then (b (q + 17 - 8) : ℚ) else 0) =
      (if q + 17 = 0 then (1 : ℚ) else 0) * 1 + (if q + 17 = 1 then (1 : ℚ) else 0) * 5 + (if q + 17 = 2 then (1 : ℚ) else 0) * 7 + (if q + 17 = 3 then (1 : ℚ) else 0) * 8 + (if q + 17 = 4 then (1 : ℚ) else 0) * 12 + (if q + 17 = 5 then (1 : ℚ) else 0) * 10 + (if q + 17 = 6 then (1 : ℚ) else 0) * 6 + (if q + 17 = 7 then (1 : ℚ) else 0) * 8 + (if q + 17 = 8 then (1 : ℚ) else 0) * 3 + (if q + 17 = 9 then (1 : ℚ) else 0) * 1 + (if q + 17 = 10 then (1 : ℚ) else 0) * 1 + (if q + 17 = 12 then (1 : ℚ) else 0) * 2 - (if q + 17 = 14 then (1 : ℚ) else 0) * 2 - (if q + 17 = 16 then (1 : ℚ) else 0) * 2 := by
  have h : (b (q + 17) : ℤ) = b (q + 15) + b (q + 11) - b (q + 9) := b_recur (q + 0)
  have hq := congrArg (fun z : ℤ => (z : ℚ)) h
  push_cast at hq
  simp only [show q + 17 - 2 = q + 15 from Nat.add_sub_assoc (by decide : 2 ≤ 17) q, show q + 17 - 6 = q + 11 from Nat.add_sub_assoc (by decide : 6 ≤ 17) q, show q + 17 - 8 = q + 9 from Nat.add_sub_assoc (by decide : 8 ≤ 17) q, show 2 ≤ q + 17 from le_trans (by decide : 2 ≤ 17) (Nat.le_add_left 17 q), show 6 ≤ q + 17 from le_trans (by decide : 6 ≤ 17) (Nat.le_add_left 17 q), show 8 ≤ q + 17 from le_trans (by decide : 8 ≤ 17) (Nat.le_add_left 17 q), show ¬ q + 17 = 0 from Nat.ne_of_gt (lt_of_lt_of_le (by decide : 0 < 17) (Nat.le_add_left 17 q)), show ¬ q + 17 = 1 from Nat.ne_of_gt (lt_of_lt_of_le (by decide : 1 < 17) (Nat.le_add_left 17 q)), show ¬ q + 17 = 2 from Nat.ne_of_gt (lt_of_lt_of_le (by decide : 2 < 17) (Nat.le_add_left 17 q)), show ¬ q + 17 = 3 from Nat.ne_of_gt (lt_of_lt_of_le (by decide : 3 < 17) (Nat.le_add_left 17 q)), show ¬ q + 17 = 4 from Nat.ne_of_gt (lt_of_lt_of_le (by decide : 4 < 17) (Nat.le_add_left 17 q)), show ¬ q + 17 = 5 from Nat.ne_of_gt (lt_of_lt_of_le (by decide : 5 < 17) (Nat.le_add_left 17 q)), show ¬ q + 17 = 6 from Nat.ne_of_gt (lt_of_lt_of_le (by decide : 6 < 17) (Nat.le_add_left 17 q)), show ¬ q + 17 = 7 from Nat.ne_of_gt (lt_of_lt_of_le (by decide : 7 < 17) (Nat.le_add_left 17 q)), show ¬ q + 17 = 8 from Nat.ne_of_gt (lt_of_lt_of_le (by decide : 8 < 17) (Nat.le_add_left 17 q)), show ¬ q + 17 = 9 from Nat.ne_of_gt (lt_of_lt_of_le (by decide : 9 < 17) (Nat.le_add_left 17 q)), show ¬ q + 17 = 10 from Nat.ne_of_gt (lt_of_lt_of_le (by decide : 10 < 17) (Nat.le_add_left 17 q)), show ¬ q + 17 = 12 from Nat.ne_of_gt (lt_of_lt_of_le (by decide : 12 < 17) (Nat.le_add_left 17 q)), show ¬ q + 17 = 14 from Nat.ne_of_gt (lt_of_lt_of_le (by decide : 14 < 17) (Nat.le_add_left 17 q)), show ¬ q + 17 = 16 from Nat.ne_of_gt (lt_of_lt_of_le (by decide : 16 < 17) (Nat.le_add_left 17 q)), if_true, if_false]
  linear_combination (1) * hq

open PowerSeries in
/-- The denominator times A, as a sum of monomials. -/
theorem gf_den (A : ℚ⟦X⟧) : A * (X ^ 8 - X ^ 6 - X ^ 2 + 1) = C 1 * A - C 1 * (A * X ^ 2) - C 1 * (A * X ^ 6) + C 1 * (A * X ^ 8) := by
  simp only [map_one]
  ring

open PowerSeries in
/-- The numerator as a sum of monomials. -/
theorem gf_num : (-2 * X ^ 16 - 2 * X ^ 14 + 2 * X ^ 12 + X ^ 10 + X ^ 9 + 3 * X ^ 8 + 8 * X ^ 7 + 6 * X ^ 6 + 10 * X ^ 5 + 12 * X ^ 4 + 8 * X ^ 3 + 7 * X ^ 2 + 5 * X + 1 : ℚ⟦X⟧) = X ^ 0 * C 1 + X ^ 1 * C 5 + X ^ 2 * C 7 + X ^ 3 * C 8 + X ^ 4 * C 12 + X ^ 5 * C 10 + X ^ 6 * C 6 + X ^ 7 * C 8 + X ^ 8 * C 3 + X ^ 9 * C 1 + X ^ 10 * C 1 + X ^ 12 * C 2 - X ^ 14 * C 2 - X ^ 16 * C 2 := by
  simp only [map_ofNat, map_one]
  ring

open PowerSeries in
/-- The generating function. -/
theorem gf : PowerSeries.mk (fun n => (a n : ℚ)) * (X ^ 8 - X ^ 6 - X ^ 2 + 1) =
      -2 * X ^ 16 - 2 * X ^ 14 + 2 * X ^ 12 + X ^ 10 + X ^ 9 + 3 * X ^ 8 + 8 * X ^ 7 + 6 * X ^ 6 + 10 * X ^ 5 + 12 * X ^ 4 + 8 * X ^ 3 + 7 * X ^ 2 + 5 * X + 1 := by
  set A : ℚ⟦X⟧ := PowerSeries.mk (fun n => (a n : ℚ)) with hA
  rw [gf_den A, gf_num]
  ext n
  have hc : ∀ k, coeff k A = (b k : ℚ) := fun k => by rw [hA, coeff_mk, a_eq_b]
  simp only [map_add, map_sub, coeff_C_mul, coeff_mul_C, coeff_X_pow, coeff_mul_X_pow', hc]
  rcases Nat.lt_or_ge n 17 with hn | hn
  · linarith [gf_low n hn]
  · obtain ⟨q, rfl⟩ : ∃ q, n = q + 17 := ⟨n - 17, by omega⟩
    linarith [gf_high q]

