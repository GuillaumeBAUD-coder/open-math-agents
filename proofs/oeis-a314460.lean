    (((-1), (-1), 8), 3),
    (((-1), (-1), 10), 3),
    (((-1), (-1), 11), 3),
    (((-1), 0, 12), 3),
    (((-1), 0, 13), 3),
    ((0, (-1), 14), 3),
    ((0, 0, 9), 3),
