private def Mono (r : Nat → Bool) := ∃ (b : Bool) (a d : ℕ),
  0 < d ∧ a + (if b then 13 else 2)*d < 182 ∧
  ∀ t ≤ (if b then 13 else 2), r (a+t*d) = b

private def Red (r : Nat → Bool) (x : Nat) := x < 182 ∧ r x = false

private lemma triple_free {r : Nat → Bool} (hn : ¬ Mono r) : NoTriple (Red r) := by
  intro a d hd h₀ h₁ h₂
  apply hn
  refine ⟨false, a, d, hd, h₂.1, ?_⟩
  intro t ht
  change t ≤ 2 at ht
  rcases (show t=0 ∨ t=1 ∨ t=2 by omega) with he|he|he
  · simpa [he] using h₀.2
  · simpa [he] using h₁.2
  · simpa [he] using h₂.2

private lemma base_bit : ∀ d : Fin 15, 0 < d.val → ∀ t : Fin 14,
    bases[d.val-1]!.testBit (8*(t.val*d.val)) = true := by decide +kernel

private lemma hit_at {r : Nat → Bool} {a d : Nat} (hn : ¬ Mono r)
    (hd : 0 < d) (hb : a+13*d < 182) :
    ∃ t, (bases[d-1]! <<< (8*a)).testBit (8*t) = true ∧ Red r t := by
  by_contra! bad
  apply hn
  refine ⟨true, a, d, hd, hb, ?_⟩
  intro t ht
  change t ≤ 13 at ht
  have hle := Nat.mul_le_mul_right d ht
