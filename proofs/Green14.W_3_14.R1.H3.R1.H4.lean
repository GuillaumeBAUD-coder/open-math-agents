import OMAReductions.R_Green14_W_3_14_R1_H3_R1

/-!
Certificate search and exact-target adapter: Hanan Beer (@hananzlt), assisted by Codex.
This proves the next-red-99 case in Genbox's reduction PR6260 of NickLeko's
W(3,14) reduction PR4039. It is one auxiliary step, not the full W(3,14) theorem.
The verifier and soundness proof adapt ZedingZhang PR5267 and MrSeizy PR4877,
with predecessor contributions by Vincent T. Mossman and PanPapag. Compact
bit dilation and center guidance adapt ZedingZhang PR5707; the 8-bit fused
count-and-choice evaluator follows ZedingZhang PR5985. Genbox's first-red
partition is preserved. Upstream attribution to Halldon and Dominic Dabish
(PR591) is preserved. The mathematical value is due to Ahmed, Kullmann and Snevily.
All finite search output is untrusted; Lean checks every certificate chunk.
-/

namespace OMA.Green14Next99



private def NoTriple (R : Nat → Prop) :=
  ∀ a d, 0 < d → R a → R (a+d) → R (a+2*d) → False

private lemma distinct_terms {R : Nat → Prop} (hn : NoTriple R) {u v w : Nat}
    (hu : R u) (hv : R v) (hw : R w) (he : u+w=2*v) (hne : u ≠ w) : False := by
  rcases lt_or_gt_of_ne hne with h | h
  · exact hn u (v-u) (by omega) hu (by simpa only [show u+(v-u)=v by omega] using hv)
      (by simpa only [show u+2*(v-u)=w by omega] using hw)
  · exact hn w (v-w) (by omega) hw (by simpa only [show w+(v-w)=v by omega] using hv)
      (by simpa only [show w+2*(v-w)=u by omega] using hu)

-- Four views of the chosen red positions give every forbidden third point
-- by shifts. The last two views compress even and odd positions separately.
private structure Marks where
  rev : Nat
  dbl : Nat
  ev : Nat
  od : Nat
  deriving DecidableEq

private def mark (q : Nat) : Marks :=
  ⟨1 <<< (8*(181-q)), 1 <<< (16*q),
    if q%2=0 then 1 <<< (8*(q/2)) else 0,
    if q%2=1 then 1 <<< (8*(q/2)) else 0⟩

private def join (s t : Marks) : Marks :=
  ⟨s.rev ||| t.rev, s.dbl ||| t.dbl, s.ev ||| t.ev, s.od ||| t.od⟩

private def forbidden (s : Marks) (p : Nat) : Nat :=
  ((s.rev <<< (16*p)) >>> 1448) ||| (s.dbl >>> (8*p)) |||
    ((if p%2=0 then s.ev else s.od) <<< (8*((p+1)/2)))

private def Good (R : Nat → Prop) (s : Marks) :=
  ∀ p t, R p → R t → t ≠ p → (forbidden s p).testBit (8*t) = false

private lemma mark_good {R : Nat → Prop} (hn : NoTriple R)
    {q : Nat} (hq : R q) (hq' : q ≤ 181) : Good R (mark q) := by
  intro p t hp ht hne
  have h₁ : t+q ≠ 2*p := fun he =>
    distinct_terms hn ht hp hq he (by rintro rfl; omega)
  have h₂ : t+p ≠ 2*q := fun he => distinct_terms hn ht hq hp he hne
  have h₃ : p+q ≠ 2*t := fun he =>
    distinct_terms hn hp ht hq he (by rintro rfl; omega)
  have single (x i : Nat) : (1 <<< x : Nat).testBit i = decide (x=i) := by
    rw [Nat.shiftLeft_eq, one_mul, Nat.testBit_two_pow]
  unfold forbidden mark
  split_ifs <;> simp only [Nat.testBit_or, Nat.testBit_shiftRight, single,
    Nat.testBit_shiftLeft, Nat.zero_testBit, Bool.or_eq_false_iff,
    Bool.and_eq_false_imp, decide_eq_true_eq, decide_eq_false_iff_not]
  all_goals (repeat' apply And.intro) <;> intros <;> first | trivial | omega

private lemma join_good {R : Nat → Prop} {s u : Marks} (hs : Good R s) (hu : Good R u) :
    Good R (join s u) := by
  intro p t hp ht hn
  have h₁ := hs p t hp ht hn
  have h₂ := hu p t hp ht hn
  unfold forbidden at *
  unfold join
  split_ifs at * <;> simp_all [Nat.testBit_or, Nat.testBit_shiftRight, Nat.testBit_shiftLeft]

private def addRed (s : Marks) (a p : Nat) : Marks × Nat :=
  let bad := forbidden s p
  (join s (mark p), (a ^^^ (a &&& bad)) ||| (1 <<< (8*p)))

private def Bad (hit : (Nat → Prop) → Prop) (seed : Marks × Nat) :=
  ∀ R : Nat → Prop, (∀ x, R x → x ≤ 181) → NoTriple R → hit R →
    Good R seed.1 → (∀ x, R x → seed.2.testBit (8*x) = true) → False

private lemma add_safe {R : Nat → Prop} {s : Marks} {a p : Nat} (hs : Good R s)
    (ha : ∀ x, R x → a.testBit (8*x) = true) (hp : R p) :
    ∀ x, R x → (addRed s a p).2.testBit (8*x) = true := by
  intro x hx
  by_cases he : x = p
  · simp [addRed, he, Nat.shiftLeft_eq]
  · simp [addRed, Nat.testBit_xor, ha x hx, hs p x hp hx he]

private def bases : Array Nat := #[0x101010101010101010101010101, 0x10001000100010001000100010001000100010001000100010001, 0x1000001000001000001000001000001000001000001000001000001000001000001000001000001, 0x100000001000000010000000100000001000000010000000100000001000000010000000100000001000000010000000100000001, 0x10000000001000000000100000000010000000001000000000100000000010000000001000000000100000000010000000001000000000100000000010000000001, 0x1000000000001000000000001000000000001000000000001000000000001000000000001000000000001000000000001000000000001000000000001000000000001000000000001000000000001, 0x100000000000001000000000000010000000000000100000000000001000000000000010000000000000100000000000001000000000000010000000000000100000000000001000000000000010000000000000100000000000001, 0x10000000000000001000000000000000100000000000000010000000000000001000000000000000100000000000000010000000000000001000000000000000100000000000000010000000000000001000000000000000100000000000000010000000000000001, 0x1000000000000000001000000000000000001000000000000000001000000000000000001000000000000000001000000000000000001000000000000000001000000000000000001000000000000000001000000000000000001000000000000000001000000000000000001000000000000000001, 0x100000000000000000001000000000000000000010000000000000000000100000000000000000001000000000000000000010000000000000000000100000000000000000001000000000000000000010000000000000000000100000000000000000001000000000000000000010000000000000000000100000000000000000001, 0x10000000000000000000001000000000000000000000100000000000000000000010000000000000000000001000000000000000000000100000000000000000000010000000000000000000001000000000000000000000100000000000000000000010000000000000000000001000000000000000000000100000000000000000000010000000000000000000001, , , ]

private def pattern (i : Nat) : Nat :=
  let e := i%182
  let d := i/182+1
  if 13*d ≤ e ∧ e < 182 then bases[d-1]! <<< (8*(e-13*d)) else bases[0]!

private def Hits (R : Nat → Prop) := ∀ i, ∃ t, (pattern i).testBit (8*t) = true ∧ R t

-- Each digit counts the remaining candidates for a progression. A chosen
-- point receives a bonus of fifteen, so a progression already hit is skipped.
-- Residue lookup for a position bit and for a progression-count flag.
private def pointIndex (x : Nat) : Nat :=
  (( : Nat) >>> (8*((x ^^^ (x-1))%379))) % 256

private def slotIndex (x : Nat) : Nat :=
  (( : Nat) >>> (12*((x ^^^ (x-1))%5171))) % 4096

private def convolution : Nat := 
private def slots : Nat := 
private def high : Nat := slots <<< 7
private def fieldMask : Nat := slots * 255
private def erase (a p : Nat) := a ^^^ (a &&& (1 <<< (8*p)))

private lemma erase_safe {R : Nat → Prop} {a p : Nat}
    (ha : ∀ x, R x → a.testBit (8*x) = true) (hp : ¬R p) :
    ∀ x, R x → (erase a p).testBit (8*x) = true := by
  intro t ht
  have hne : p ≠ t := fun he => hp (he ▸ ht)
  simp [erase, Nat.testBit_xor, ha t ht, Nat.shiftLeft_eq, hne]


private abbrev State := (Marks × Nat) × Nat
private def leftStep (s : State) (p : Nat) : State :=
  (addRed s.1.1 s.1.2 p, s.2 ||| (15 <<< (8*p)))
private def rightStep (s : State) (p : Nat) : State :=
  ((s.1.1, erase s.1.2 p), s.2)
private def Closed (s : State) := Bad Hits s.1

private def matchGate (leaves : Array {s // Closed s}) (i : Nat) (s : State) : Bool :=
  match leaves[i]? with
  | none => false
  | some v => v.val == s

private lemma gate_sound (leaves : Array {s // Closed s}) (k : Nat) (s : State)
    (h : matchGate leaves k s = true) : Closed s := by
  unfold matchGate at h
  split at h
  · contradiction
  · rename_i v _
    exact (beq_iff_eq.mp h) ▸ v.property

-- Each branching choice is a rank in a progression with few remaining points.
-- Two bits encode the three common ranks. The extended form encodes larger
-- ranks and references to independently checked subtrees.
-- A word stores only its nonzero base-four digits. Each ten-bit record
-- consists of a two-bit value and an eight-bit position (at most 130).
private def unpackWord : Nat → Nat → Nat
  | 0, _ => 0
  | fuel+1, n =>
    if n = 0 then 0 else
      ((n % 4) <<< (2*((n/4)%256))) ||| unpackWord fuel (n/1024)

private def word (tape : Array Nat) (i : Nat) : Nat :=
  let v := (unpackWord 131 (tape[i/128]?.getD 0) >>> (2*(i%128))) % 256
  if v % 4 = 3 then 3 + v/4 else v%4

private def width (op : Nat) : Nat := if op < 3 then 1 else 4

private def tight (sums : Nat) : Nat → Nat → Nat
  | 0, _ => 0
  | fuel+1, k =>
    let hits := (high + k*slots - sums) &&& high
    if hits != 0 then slotIndex hits else tight sums fuel (k+1)

private def dropPoints : Nat → Nat → Nat
  | 0, v => v
  | n+1, v => dropPoints n (v &&& (v-1))

private def distance (p : Nat) : Nat := (2*p-181)+(181-2*p)

private def closest : Nat → Nat → Nat → Nat
  | 0, _, best => best
  | fuel+1, rest, best =>
    if rest = 0 then best else
      let p := pointIndex rest
      let candidate := if distance p < distance best then p else best
      if 181 ≤ 2*p then candidate else closest fuel (rest &&& (rest-1)) candidate

-- One convolution supplies the forced test and branching heuristic. Values below
-- 2548 select an explicitly checked progression; larger values encode a point.
private def choose (s : State) : Nat :=
  let sums := ((s.1.2 ||| s.2) * convolution) &&& fieldMask
  let z := (high - sums) &&& high
  if z != 0 then slotIndex z else
    let o := ((high + slots) - sums) &&& high
    if o != 0 then slotIndex o else
      2548 + closest 14 (pattern (tight sums 13 2) &&& s.1.2) 182

-- Return one plus the next tape index. The value zero reports a failed check.
-- Only an actual split or subtree reference consumes a tape entry.
private def visit (leaves : Array {s // Closed s}) (tape : Array Nat) :
    Nat → Nat → State → Nat
  | 0, _, _ => 0
  | fuel+1, i, s =>
    let op := word tape i
    if op ≥ 16 && matchGate leaves (op-16) s then i+width op+1 else
      let slot := choose s
      if slot < 2548 then
        let rest := pattern slot &&& s.1.2
        if rest = 0 then i+1 else
          let p := pointIndex rest
          if rest = (1 <<< (8*p)) then visit leaves tape fuel i (leftStep s p) else 0
      else if op < 16 then
        match visit leaves tape fuel (i+width op) (leftStep s (choose s - 2548)) with
        | 0 => 0
        | next+1 => visit leaves tape fuel next (rightStep s (choose s - 2548))
      else 0

private lemma visit_sound {tape : Array Nat} (leaves : Array {s // Closed s})
    (fuel i : Nat) (s : State) (hw : visit leaves tape fuel i s ≠ 0) : Closed s := by
  induction fuel generalizing i s with
  | zero => simp [visit] at hw
  | succ fuel ih =>
    simp only [visit] at hw
    split at hw
    · rename_i he
      exact gate_sound leaves _ s (Bool.and_eq_true_iff.mp he).2
    · intro R bound hn hit hs ha
      split at hw
      · let slot := choose s
        obtain ⟨t,hbit,ht⟩ := hit slot
        have hr : (pattern slot &&& s.1.2).testBit (8*t) = true := by simp [hbit, ha t ht]
        split at hw
        · rename_i hz
          change pattern slot &&& s.1.2 = 0 at hz
          simp [hz] at hr
        · split at hw
          · rename_i hsingle
            let p := pointIndex (pattern slot &&& s.1.2)
            change pattern slot &&& s.1.2 = 1 <<< (8*p) at hsingle
            rw [hsingle, Nat.shiftLeft_eq, one_mul, Nat.testBit_two_pow] at hr
            have hp : R p := (show t = p by have := of_decide_eq_true hr; omega) ▸ ht
            exact ih _ _ hw R bound hn hit (join_good hs (mark_good hn hp (bound _ hp))) (add_safe hs ha hp)
          · contradiction
      · split at hw
        · split at hw
          · contradiction
          · rename_i next hleft
            have hl : visit leaves tape fuel (i+width (word tape i))
                (leftStep s (choose s - 2548)) ≠ 0 := by
              rw [hleft]
              omega
            by_cases hp : R (choose s - 2548)
            · exact ih _ _ hl R bound hn hit (join_good hs (mark_good hn hp (bound _ hp))) (add_safe hs ha hp)
            · exact ih _ _ hw R bound hn hit hs (erase_safe ha hp)
        · contradiction

private lemma certify {s : State} (tape : Array Nat) (leaves : Array {s // Closed s})
    (h : visit leaves tape 190 0 s ≠ 0) : Closed s := visit_sound leaves 190 0 s h

-- Expand a conventional board mask into base-256 digits and reconstruct its
-- reflected, doubled and parity masks. The encoder is only used at chunk boundaries.
private def boardMask (red : Nat) (place : Nat → Nat) :=
  (List.range 182).foldl (fun z i => if red.testBit i then z ||| (1 <<< place i) else z) 0

private def fromBits (red allow : Nat) : State :=
  let oddMask := 0x2aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
  let evenMask := 0x15555555555555555555555555555555555555555555555
  ((⟨boardMask red (fun i => 8*(181-i)), boardMask red (fun i => 16*i),
     boardMask (red &&& evenMask) (fun i => 8*(i/2)), boardMask (red &&& oddMask) (fun i => 8*(i/2))⟩,
    boardMask allow (fun i => 8*i)), 15 * boardMask red (fun i => 8*i))

private def spread (x : Nat) : Nat :=
  let x := (x ||| (x <<< 1792)) &&& 
  let x := (x ||| (x <<< 896)) &&& 
  let x := (x ||| (x <<< 448)) &&& 
  let x := (x ||| (x <<< 224)) &&& 
  let x := (x ||| (x <<< 112)) &&& 
  let x := (x ||| (x <<< 56)) &&& 
  let x := (x ||| (x <<< 28)) &&& 
  let x := (x ||| (x <<< 14)) &&& 
  let x := (x ||| (x <<< 7)) &&& 
  x

private def packedSeed (rev dbl ev od allow red : Nat) : State :=
  ((⟨spread rev, spread dbl, spread ev, spread od⟩, spread allow), 15 * spread red)

private abbrev C (s : State) : Prop := Closed s
private abbrev S := packedSeed
private abbrev V {s : State} (tape : Array Nat) (leaves : Array {s // Closed s})
    (h : visit leaves tape 190 0 s ≠ 0) : Closed s := certify tape leaves h

