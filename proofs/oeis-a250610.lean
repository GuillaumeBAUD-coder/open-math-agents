theorem PR_all : ∀ s : R, PRp s := by
  refine (forall_vecCons _).mpr (fun a0 => (forall_vecCons _).mpr (fun a1 => (forall_vecCons _).mpr (fun a2 => (forall_vecCons _).mpr (fun a3 => ?_))))
  fin_cases a0 <;> fin_cases a1 <;> fin_cases a2 <;> fin_cases a3
  · exact PR_0_0_0_0
  · exact PR_0_0_0_1
  · exact PR_0_0_1_0
  · exact PR_0_0_1_1
  · exact PR_0_1_0_0
