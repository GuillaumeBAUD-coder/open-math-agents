theorem closedC : ∀ m : ℕ, 1 * C m = (fun n : ℕ => (128 + 2 ^ (n + 7) + 410 * ((n : ℕ) : ℤ) + 219 * ((n : ℕ) : ℤ) ^ 2 : ℤ)) (m + 1) := by
  apply uniqp (fun m : ℕ => 1 * C m) (fun m : ℕ => (fun n : ℕ => (128 + 2 ^ (n + 7) + 410 * ((n : ℕ) : ℤ) + 219 * ((n : ℕ) : ℤ) ^ 2 : ℤ)) (m + 1))
  · intro m
    show 1 * C (m + 4) = _
    rw [C_rec]
    ring
  · intro m
    show (fun n : ℕ => (128 + 2 ^ (n + 7) + 410 * ((n : ℕ) : ℤ) + 219 * ((n : ℕ) : ℤ) ^ 2 : ℤ)) (m + 4 + 1) = _
    simp only []
    push_cast
    ring
  · show 1 * C 0 = (fun n : ℕ => (128 + 2 ^ (n + 7) + 410 * ((n : ℕ) : ℤ) + 219 * ((n : ℕ) : ℤ) ^ 2 : ℤ)) (0 + 1)
    rw [show C 0 = 1013 from by decide +kernel]
    norm_num
  · show 1 * C 1 = (fun n : ℕ => (128 + 2 ^ (n + 7) + 410 * ((n : ℕ) : ℤ) + 219 * ((n : ℕ) : ℤ) ^ 2 : ℤ)) (1 + 1)
    rw [show C 1 = 2336 from by decide +kernel]
    norm_num
  · show 1 * C 2 = (fun n : ℕ => (128 + 2 ^ (n + 7) + 410 * ((n : ℕ) : ℤ) + 219 * ((n : ℕ) : ℤ) ^ 2 : ℤ)) (2 + 1)
    rw [show C 2 = 4353 from by decide +kernel]
    norm_num
  · show 1 * C 3 = (fun n : ℕ => (128 + 2 ^ (n + 7) + 410 * ((n : ℕ) : ℤ) + 219 * ((n : ℕ) : ℤ) ^ 2 : ℤ)) (3 + 1)
    rw [show C 3 = 7320 from by decide +kernel]
    norm_num

