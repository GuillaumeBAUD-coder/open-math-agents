theorem T (s : R) : ∀ n, (∑ t : R, if ok s ∧ compat s t then α n t else 0) = α (n + 1) s := by
  apply uniqP (fun n => ∑ t : R, if ok s ∧ compat s t then α n t else 0) (fun n => α (n + 1) s)
  · intro n
    simp only [α_rec, Finset.mul_sum, ← Finset.sum_add_distrib, ← Finset.sum_sub_distrib]
    apply Finset.sum_congr rfl
    intro t _
    split_ifs <;> ring
  · intro n
    exact α_rec (n + 1) s
  · exact T0 s
  · exact T1 s
  · exact T2 s
  · exact T3 s

theorem B0 : ∀ s : R, α 0 s = if ok s then 1 else 0 := by
  simp only [forall_vecCons, forall_vecEmpty]
  decide +kernel

theorem F_eq (n : ℕ) : ∀ s : R, (F n s : ℤ) = α n s := by
  induction n with
  | zero =>
    intro s
    rw [F_zero, B0]
    split_ifs <;> simp
  | succ n ih =>
    intro s
    rw [F_succ, ← T s n]
    push_cast
    apply Finset.sum_congr rfl
    intro t _
    split_ifs
    · exact ih t
    · rfl

def A : ℕ → ℤ
  | 0 => 256
  | 1 => 1013
  | 2 => 2336
  | 3 => 4353
  | n + 4 => (-2) * A n + 7 * A (n + 1) - 9 * A (n + 2) + 5 * A (n + 3)

theorem A_rec (n : ℕ) : A (n + 4) = (-2) * A n + 7 * A (n + 1) - 9 * A (n + 2) + 5 * A (n + 3) := by
  rw [A]

theorem U0 : (∑ s : R, if True then α 0 s else 0) = A 0 := by
  simp only [sum_vecCons, sum_vecEmpty]
  decide +kernel

theorem U1 : (∑ s : R, if True then α 1 s else 0) = A 1 := by
  simp only [sum_vecCons, sum_vecEmpty]
  decide +kernel

theorem U2 : (∑ s : R, if True then α 2 s else 0) = A 2 := by
  simp only [sum_vecCons, sum_vecEmpty]
  decide +kernel

theorem U3 : (∑ s : R, if True then α 3 s else 0) = A 3 := by
  simp only [sum_vecCons, sum_vecEmpty]
  decide +kernel

theorem U : ∀ n, (∑ s : R, if True then α n s else 0) = A n := by
  apply uniqP (fun n => ∑ s : R, if True then α n s else 0) A
  · intro n
    simp only [α_rec, Finset.mul_sum, ← Finset.sum_add_distrib, ← Finset.sum_sub_distrib]
    apply Finset.sum_congr rfl
    intro s _
    split_ifs <;> ring
  · exact A_rec
  · exact U0
  · exact U1
  · exact U2
  · exact U3

theorem N_eq (n : ℕ) : (a n : ℤ) = A n := by
  unfold a
  rw [Nat.card_congr (Equiv.subtypeEquivRight
      (p := fun x : Fin (n + 1) → R => Good n x)
      (q := fun y : Fin (n + 1) → R => Walk y)
      (fun x => ⟨fun h => ⟨fun _ => trivial, h⟩, fun h => h.2⟩)), Nat.card_eq_fintype_card,
    Fintype.card_subtype, Finset.card_filter, sum_F, ← U n]
  push_cast
  apply Finset.sum_congr rfl
  intro s _
  exact F_eq n s

def C : ℕ → ℤ
  | 0 => 1013
  | 1 => 2336
  | 2 => 4353
  | 3 => 7320
  | n + 4 => (-2) * C n + 7 * C (n + 1) - 9 * C (n + 2) + 5 * C (n + 3)

theorem C_rec (n : ℕ) : C (n + 4) = (-2) * C n + 7 * C (n + 1) - 9 * C (n + 2) + 5 * C (n + 3) := by
  rw [C]

theorem C_P (n : ℕ) : C (n + 4) = (-2) * C n + 7 * C (n + 1) - 9 * C (n + 2) + 5 * C (n + 3) := by
  have h0 : C (n + 4) = (-2) * C n + 7 * C (n + 1) - 9 * C (n + 2) + 5 * C (n + 3) := C_rec (n)
  linear_combination (1) * h0

theorem A_C : ∀ n, A (n + 1) = 1 * C n := by
  apply uniqP (fun n => A (n + 1)) (fun n => 1 * C n)
  · intro n
    exact A_rec (n + 1)
  · intro n
    rw [C_P]
    ring
  · decide +kernel
  · decide +kernel
  · decide +kernel
  · decide +kernel

theorem aC (n : ℕ) : (a (n + 1) : ℤ) = C n := by
  rw [N_eq, A_C]
  ring

theorem uniqp {K : Type} [CommRing K] (u v : ℕ → K)
    (hu : ∀ n, u (n + 4) = (-2) * u n + 7 * u (n + 1) - 9 * u (n + 2) + 5 * u (n + 3))
    (hv : ∀ n, v (n + 4) = (-2) * v n + 7 * v (n + 1) - 9 * v (n + 2) + 5 * v (n + 3))
    (h0 : u 0 = v 0) (h1 : u 1 = v 1) (h2 : u 2 = v 2) (h3 : u 3 = v 3) : ∀ n, u n = v n := by
  have key : ∀ n, u n = v n ∧ u (n + 1) = v (n + 1) ∧ u (n + 2) = v (n + 2) ∧ u (n + 3) = v (n + 3) := by
    intro n
    induction n with
    | zero => exact ⟨h0, h1, h2, h3⟩
    | succ n ih =>
      obtain ⟨a0, a1, a2, a3⟩ := ih
      refine ⟨a1, a2, a3, ?_⟩
      rw [show n + 1 + 3 = n + 4 from rfl, hu, hv, a0, a1, a2, a3]
  exact fun n => (key n).1

