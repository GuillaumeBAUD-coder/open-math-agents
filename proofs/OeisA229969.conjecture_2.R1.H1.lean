def OMA.chk (n c : ℕ) : Bool :=
    decide (0 < (c % 4096)) &&
    decide ((c / 16777216) + (c % 4096) < n) &&
    decide ((c / 16777216) = 3 ∨ (c / 16777216) = 4 ∨ (c / 16777216) = 6 ∨ (c / 16777216) = 10 ∨ (c / 16777216) = 15) &&
    OMA.pb (2 * (c % 4096) - 1) (c / 4096 % 4096) &&
    OMA.pb (2 * (n - (c / 16777216) - (c % 4096)) - 1) (c / 4096 % 4096) &&
    OMA.pb (2 * (c / 16777216) * (c % 4096) - 1) (c / 4096 % 4096) &&
    OMA.pb (2 * (c / 16777216) * (n - (c / 16777216) - (c % 4096)) - 1) (c / 4096 % 4096) &&
    OMA.pb (2 * (c % 4096) * (n - (c / 16777216) - (c % 4096)) - 1) (c / 4096 % 4096)

