private theorem countCorrect (s len : ℕ) (h : s + len ≤ 1210000) :
    Nat.primeCounting' (s + len) = Nat.primeCounting' s + scan s len := by
  induction len with
  | zero => simp [scan]
  | succ len ih =>
    have hle : s + len ≤ 1210000 := by omega
    change Nat.count Nat.Prime (s + len + 1) = Nat.count Nat.Prime s + scan s (len + 1)
    rw [Nat.count_succ, show Nat.count Nat.Prime (s + len) =
      Nat.count Nat.Prime s + scan s len from ih hle, scan]
    simp only [fastPrime_correct hle, Nat.add_assoc]

