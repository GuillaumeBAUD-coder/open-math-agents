private theorem fastPi_correct {x : ℕ} (h : x + 1 ≤ 1204993) :
    fastPi x = Nat.primeCounting x := by
  have hblock : (x + 1) / 128 ≤ finalCheckpoint := by
    change (x + 1) / 128 ≤ 9414
    omega
  have hsplit : (x + 1) / 128 * 128 + (x + 1) % 128 = x + 1 := by omega
  rw [fastPi, checkpointCorrect _ hblock, ← countCorrect]
  · rw [hsplit]
    rfl
  · omega

private def validWitness (n : ℕ) : Prop :=
  let k := lookup witnesses 8 n
  1 ≤ k ∧ k < n ∧ (k + 2) * n + 1 ≤ 1204993 ∧
    fastPi ((k + 1) * n) - fastPi (k * n) =
      fastPi ((k + 2) * n) - fastPi ((k + 1) * n)

private instance (n : ℕ) : Decidable (validWitness n) :=
  inferInstanceAs (Decidable (let k := lookup witnesses 8 n
    1 ≤ k ∧ k < n ∧ (k + 2) * n + 1 ≤ 1204993 ∧
      fastPi ((k + 1) * n) - fastPi (k * n) =
        fastPi ((k + 2) * n) - fastPi ((k + 1) * n)))

private def checkWitness (n : ℕ) : Bool :=
  if 2 ≤ n ∧ n ≤ 5000 then decide (validWitness n) else true

