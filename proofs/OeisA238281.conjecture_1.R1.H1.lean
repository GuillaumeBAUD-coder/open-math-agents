private theorem coprime_list {n : ℕ} (hn : n.Prime) {bound : ℕ} (hnlarge : n > bound)
    (l : List ℕ) (hl : l.all (fun d => 0 < d && d ≤ bound) = true) :
    n.Coprime l.prod := by
  induction l with
  | nil => simp
  | cons d l ih =>
    simp only [List.all_cons, Bool.and_eq_true, decide_eq_true_eq] at hl
    rw [List.prod_cons, Nat.coprime_mul_iff_right]
    exact ⟨hn.coprime_iff_not_dvd.mpr
      (fun hd => (not_le_of_gt hnlarge) ((Nat.le_of_dvd hl.1.1 hd).trans hl.1.2)),
      ih hl.2⟩

