private theorem witnessChecks : ∀ i : Fin 4999, validWitness (i.val + 2) := by
  intro i
  let n := i.val + 2
  have hi := i.isLt
  have hq : n / 128 < 40 := by dsimp [n]; omega
  have hmem : n ∈ List.range' (n / 128 * 128) 128 := by
    rw [List.mem_range'_1]
    omega
  have hc := List.all_eq_true.mp (witnessBatches _ hq) _ hmem
  have hn : 2 ≤ n ∧ n ≤ 5000 := by dsimp [n]; omega
  exact of_decide_eq_true (by simpa only [checkWitness, if_pos hn] using hc)

theorem result : OMA.R_OeisA238281_conjecture_1_R1.H1 := by
  intro n hn hnmax
  have hw := witnessChecks ⟨n - 2, by omega⟩
  have he : n - 2 + 2 = n := by omega
  change validWitness (n - 2 + 2) at hw
  rw [he] at hw
  obtain ⟨hk, hkn, hbound, heq⟩ := hw
  let k := lookup witnesses 8 n
  have h0 : k * n + 1 ≤ 1204993 :=
    (Nat.add_le_add_right (Nat.mul_le_mul_right n (by omega)) 1).trans hbound
  have h1 : (k + 1) * n + 1 ≤ 1204993 :=
    (Nat.add_le_add_right (Nat.mul_le_mul_right n (by omega)) 1).trans hbound
  rw [fastPi_correct h0, fastPi_correct h1, fastPi_correct hbound] at heq
  change Nat.primeCounting ((k + 1) * n) - Nat.primeCounting (k * n) =
    Nat.primeCounting ((k + 2) * n) - Nat.primeCounting ((k + 1) * n) at heq
  unfold OeisA238281.a
  have hmem : k ∈ Ico 1 n := mem_Ico.mpr ⟨hk, hkn⟩
  have hle : (1 : ℕ) ≤ ∑ j ∈ Ico 1 n,
      if Nat.primeCounting ((j + 1) * n) - Nat.primeCounting (j * n) =
         Nat.primeCounting ((j + 2) * n) - Nat.primeCounting ((j + 1) * n)
      then 1 else 0 := by
    have h := single_le_sum (f := fun j =>
      if Nat.primeCounting ((j + 1) * n) - Nat.primeCounting (j * n) =
         Nat.primeCounting ((j + 2) * n) - Nat.primeCounting ((j + 1) * n)
      then 1 else 0) (fun j _ => Nat.zero_le _) hmem
    simpa only [if_pos heq] using h
  exact Nat.succ_le_iff.mp hle

