section Proof_a270218

lemma a_rec_shift (n : ℕ) :
    (a (n + 4) : ℤ) = 7 * a (n + 3) - 14 * a (n + 2) + 8 * a (n + 1) := by
  simp only [a, Scale129.sampled_eq _ 129 rfl, Scale129.count_rec n]
  ring

lemma a_init :
    (a 0 : ℤ) = 1 ∧ (a 1 : ℤ) = 4 ∧ (a 2 : ℤ) = 28 ∧ (a 3 : ℤ) = 140 ∧ (a 4 : ℤ) = 620 := by
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · rw [a, Scale129.sampled_fast 0 129 rfl]; decide +kernel
  · rw [a, Scale129.sampled_fast 1 129 rfl]; decide +kernel
  · rw [a, Scale129.sampled_fast 2 129 rfl]; decide +kernel
  · rw [a, Scale129.sampled_fast 3 129 rfl]; decide +kernel
  · rw [a, Scale129.sampled_fast 4 129 rfl]; decide +kernel

lemma recurrence (n : ℕ) (hn : 3 < n) :
    (a n : ℤ) = 7 * a (n - 1) - 14 * a (n - 2) + 8 * a (n - 3) := by
  by_cases hsmall : n < 4
  · rcases a_init with ⟨_, v1, v2, v3, v4⟩
    interval_cases n <;> norm_num [v1, v2, v3, v4]
  · simpa only [show n - 4 + 4 = n by omega,
      show n - 4 + 3 = n - 1 by omega,
      show n - 4 + 2 = n - 2 by omega,
      show n - 4 + 1 = n - 3 by omega] using a_rec_shift (n - 4)

lemma qBinom2_zero (m : ℕ) : qBinom2 m 0 = 1 := by
  cases m <;> rfl

lemma qBinom2_one (m : ℕ) : (qBinom2 m 1 : ℤ) = 2 ^ m - 1 := by
  induction m with
  | zero => rfl
  | succ m ih =>
    have hstep : qBinom2 (m + 1) 1 = qBinom2 m 0 + 2 ^ 1 * qBinom2 m 1 := rfl
    rw [hstep, qBinom2_zero]
    push_cast
    rw [ih, pow_succ]
    ring

lemma qBinom2_two (m : ℕ) : 3 * (A006095 (m + 1) : ℤ) = 1 - 3 * 2 ^ m + 2 ^ (1 + 2 * m) := by
  unfold A006095
  induction m with
  | zero => decide
  | succ m ih =>
    have hstep : qBinom2 (m + 2) 2 = qBinom2 (m + 1) 1 + 2 ^ 2 * qBinom2 (m + 1) 2 := rfl
    have hcast : 3 * (qBinom2 (m + 2) 2 : ℤ) =
        3 * (qBinom2 (m + 1) 1 : ℤ) + 4 * (3 * (qBinom2 (m + 1) 2 : ℤ)) := by
      rw [hstep]; push_cast; ring
    rw [hcast, qBinom2_one (m + 1), ih,
        show 1 + 2 * (m + 1) = (1 + 2 * m) + 2 by omega]
    simp only [pow_add]
    ring

lemma a_closed_mul3 (n : ℕ) (hn : 0 < n) :
    3 * (a n : ℤ) = 4 * (1 - 3 * 2 ^ n + 2 ^ (1 + 2 * n)) := by
  induction n using Nat.strong_induction_on with
  | h n ih =>
    by_cases h : n < 4
    · rcases a_init with ⟨_, v1, v2, v3, _⟩
      interval_cases n <;> norm_num [v1, v2, v3]
    · have hr := recurrence n (by omega)
      have h1 := ih (n - 1) (by omega) (by omega)
      have h2 := ih (n - 2) (by omega) (by omega)
      have h3 := ih (n - 3) (by omega) (by omega)
      have hn1 : n = (n - 3) + 3 := by omega
      have hn2 : n - 1 = (n - 3) + 2 := by omega
      have hn3 : n - 2 = (n - 3) + 1 := by omega
      have e0 : 1 + 2 * ((n - 3) + 3) = (1 + 2 * (n - 3)) + 6 := by omega
      have e1 : 1 + 2 * ((n - 3) + 2) = (1 + 2 * (n - 3)) + 4 := by omega
      have e2 : 1 + 2 * ((n - 3) + 1) = (1 + 2 * (n - 3)) + 2 := by omega
      have key : 3 * (a n : ℤ) = 7 * (3 * (a (n - 1) : ℤ)) - 14 * (3 * (a (n - 2) : ℤ)) +
          8 * (3 * (a (n - 3) : ℤ)) := by linarith only [hr]
      rw [key, h1, h2, h3]
      conv_rhs => rw [hn1]
      rw [hn2, hn3, e0, e1, e2]
      simp only [pow_add]
      ring

lemma a_eq_4_ref (n : ℕ) (hn : 0 < n) : a n = 4 * A006095 (n + 1) := by
  have h1 := a_closed_mul3 n hn
  have h2 := qBinom2_two n
  omega

lemma a_closed_div (n : ℕ) (hn : 0 < n) :
    (a n : ℤ) = 4 * (1 - 3 * 2 ^ n + 2 ^ (1 + 2 * n)) / 3 := by
  have h1 := a_closed_mul3 n hn
  have h2 := qBinom2_two n
  omega

set_option maxHeartbeats 1000000 in
lemma gf_eq :
    PowerSeries.mk (fun n => (a n : ℤ)) * ((1 - X) * (1 - 2 * X) * (1 - 4 * X)) =
      1 - 3 * X + 14 * X ^ 2 - 8 * X ^ 3 := by
  let s := PowerSeries.mk (fun n => (a n : ℤ))
  have hd : s * ((1 - X) * (1 - 2 * X) * (1 - 4 * X)) =
      s * X ^ 0 + (-7 : ℤ) • (s * X ^ 1) + (14 : ℤ) • (s * X ^ 2) +
      (-8 : ℤ) • (s * X ^ 3) := by
    simp only [zsmul_eq_mul]; push_cast; ring
  have hp : (1 - 3 * X + 14 * X ^ 2 - 8 * X ^ 3 : PowerSeries ℤ) =
      X ^ 0 + (-3 : ℤ) • X ^ 1 + (14 : ℤ) • X ^ 2 + (-8 : ℤ) • X ^ 3 := by
    simp only [zsmul_eq_mul]; push_cast; ring
  rw [hd, hp]
  ext n
  simp only [map_add, map_zsmul, coeff_mul_X_pow', coeff_X_pow, s, coeff_mk]
  by_cases hn : n < 4
  · rcases a_init with ⟨v0, v1, v2, v3, _⟩
    interval_cases n <;> norm_num [zsmul_eq_mul, v0, v1, v2, v3]
  · have hr := recurrence n (by omega)
    simp only [if_pos (show 0 ≤ n by omega), Nat.sub_zero, zsmul_eq_mul,
      if_pos (show 1 ≤ n by omega), if_pos (show 2 ≤ n by omega),
      if_pos (show 3 ≤ n by omega),
      if_neg (show n ≠ 0 by omega), if_neg (show n ≠ 1 by omega),
      if_neg (show n ≠ 2 by omega), if_neg (show n ≠ 3 by omega)]
    norm_num
    linarith only [hr]

end Proof_a270218

