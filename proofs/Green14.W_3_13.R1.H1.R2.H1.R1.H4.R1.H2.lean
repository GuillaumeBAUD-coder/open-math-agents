    (h78 : S 78) (h79 : ¬S 79) (h80 : ¬S 80) (h77 : ¬S 77) (h81 : ¬S 81) (h76 : ¬S 76) (h75 : ¬S 75) (h82 : ¬S 82) (h74 : S 74) : False := by
