namespace OMA.Green14H4R1H2

private def NoTriple (R : Nat → Prop) :=
  ∀ a d, 0 < d → R a → R (a+d) → R (a+2*d) → False

private theorem distinct_terms {R : Nat → Prop} (hn : NoTriple R) {u v w : Nat}
    (hu : R u) (hv : R v) (hw : R w) (he : u+w=2*v) (hne : u ≠ w) : False := by
  rcases (show u < w ∨ w < u by omega) with h | h
  · exact hn u (v-u) (by omega) hu (by simpa only [show u+(v-u)=v by omega] using hv)
      (by simpa only [show u+2*(v-u)=w by omega] using hw)
  · exact hn w (v-w) (by omega) hw (by simpa only [show w+(v-w)=v by omega] using hv)
      (by simpa only [show w+2*(v-w)=u by omega] using hu)

-- Four views of the chosen red positions give every forbidden third point
-- by shifts. The last two views compress even and odd positions separately.
private structure Marks where
  rev : Nat
  dbl : Nat
  ev : Nat
  od : Nat
  deriving DecidableEq

private def mark (q : Nat) : Marks :=
  ⟨1 <<< (5*(160-q)), 1 <<< (10*q),
    if q%2=0 then 1 <<< (5*(q/2)) else 0,
    if q%2=1 then 1 <<< (5*(q/2)) else 0⟩

private def join (s t : Marks) : Marks :=
  ⟨s.rev ||| t.rev, s.dbl ||| t.dbl, s.ev ||| t.ev, s.od ||| t.od⟩

private def forbidden (s : Marks) (p : Nat) : Nat :=
  ((s.rev <<< (10*p)) >>> 800) ||| (s.dbl >>> (5*p)) |||
    ((if p%2=0 then s.ev else s.od) <<< (5*((p+1)/2)))

private def Good (R : Nat → Prop) (s : Marks) :=
  ∀ p t, R p → R t → t ≠ p → (forbidden s p).testBit (5*t) = false

private theorem mark_good {R : Nat → Prop} (hn : NoTriple R)
    {q : Nat} (hq : R q) (hq' : q ≤ 160) : Good R (mark q) := by
  intro p t hp ht hne
  have h₁ : t+q ≠ 2*p := fun he =>
    distinct_terms hn ht hp hq he (by rintro rfl; omega)
  have h₂ : t+p ≠ 2*q := fun he => distinct_terms hn ht hq hp he hne
  have h₃ : p+q ≠ 2*t := fun he =>
    distinct_terms hn hp ht hq he (by rintro rfl; omega)
  have single (x i : Nat) : (1 <<< x : Nat).testBit i = decide (x=i) := by
    rw [Nat.shiftLeft_eq, Nat.one_mul, Nat.testBit_two_pow]
  unfold forbidden mark
  by_cases ep : p%2=0 <;> by_cases eqo : q%2=1 <;> by_cases eqe : q%2=0 <;>
    simp only [ep, eqe, eqo, if_true, if_false, Nat.testBit_or, Nat.testBit_shiftRight, single,
    Nat.testBit_shiftLeft, Nat.zero_testBit, Bool.or_eq_false_iff,
    Bool.and_eq_false_imp, decide_eq_true_eq, decide_eq_false_iff_not]
  all_goals (repeat' apply And.intro) <;> intros <;> first | trivial | omega | simp

private theorem join_good {R : Nat → Prop} {s u : Marks} (hs : Good R s) (hu : Good R u) :
    Good R (join s u) := by
  intro p t hp ht hn
  have h₁ := hs p t hp ht hn
  have h₂ := hu p t hp ht hn
  unfold forbidden at *
  unfold join
  by_cases ep : p%2=0 <;> simp_all [Nat.testBit_or, Nat.testBit_shiftRight, Nat.testBit_shiftLeft]

private def addRed (s : Marks) (a p : Nat) : Marks × Nat :=
  let bad := forbidden s p
  (join s (mark p), (a ^^^ (a &&& bad)) ||| (1 <<< (5*p)))

private def Bad (hit : (Nat → Prop) → Prop) (seed : Marks × Nat) :=
  ∀ R : Nat → Prop, (∀ x, R x → x ≤ 160) → NoTriple R → hit R →
    Good R seed.1 → (∀ x, R x → seed.2.testBit (5*x) = true) → False

private theorem add_safe {R : Nat → Prop} {s : Marks} {a p : Nat} (hs : Good R s)
    (ha : ∀ x, R x → a.testBit (5*x) = true) (hp : R p) :
    ∀ x, R x → (addRed s a p).2.testBit (5*x) = true := by
  intro x hx
  by_cases he : x = p
  · simp [addRed, he, Nat.shiftLeft_eq]
  · simp [addRed, Nat.testBit_xor, ha x hx, hs p x hp hx he]

private def bases : Array Nat := #[0x1084210842108421,0x1004010040100401004010040100401,0x1000200040008001000200040008001000200040008001,0x1000010000100001000010000100001000010000100001000010000100001,0x1000000800000400000200000100000080000040000020000010000008000004000002000001,0x1000000040000001000000040000001000000040000001000000040000001000000040000001000000040000001,0x1000000002000000004000000008000000010000000020000000040000000080000000100000000200000000400000000800000001,0x1000000000100000000010000000001000000000100000000010000000001000000000100000000010000000001000000000100000000010000000001,0x1000000000008000000000040000000000200000000001000000000008000000000040000000000200000000001000000000008000000000040000000000200000000001,0x1000000000000400000000000100000000000040000000000010000000000004000000000001000000000000400000000000100000000000040000000000010000000000004000000000001,0x1000000000000020000000000000400000000000008000000000000100000000000002000000000000040000000000000800000000000010000000000000200000000000004000000000000080000000000001,0x1000000000000001000000000000001000000000000001000000000000001000000000000001000000000000001000000000000001000000000000001000000000000001000000000000001000000000000001000000000000001,0x1000000000000000080000000000000004000000000000000200000000000000010000000000000000800000000000000040000000000000002000000000000000100000000000000008000000000000000400000000000000020000000000000001]

private def pattern (i : Nat) : Nat :=
  let e := i % 161
  let d := i / 161 + 1
  if 12*d ≤ e ∧ e < 158 then
    bases[d-1]! <<< (5*(e-12*d))
  else bases[0]!

private def Hits (R : Nat → Prop) :=
  ∀ i, ∃ t, (pattern i).testBit (5*t) = true ∧ R t

private def pointIndex (x : Nat) : Nat :=
  (( : Nat) >>> (8*((x ^^^ (x-1))%173))) % 256

private def slotIndex (x : Nat) : Nat :=
  (( : Nat) >>> (12*((x ^^^ (x-1))%2099))) % 4096

private def convolution : Nat := 
private def slots : Nat := 
private def mask158 : Nat := 
private def high : Nat := slots <<< 4
private def fieldMask : Nat := slots * 31
-- The fifth bit of each progression records whether it already meets red.
private def pointHits (p : Nat) : Nat := ((convolution <<< (5*p)) &&& slots) <<< 4

private def redHits (board : Nat) : Nat :=
  high - ((high - ((board * convolution) &&& fieldMask)) &&& high)

private def erase (a p : Nat) := a ^^^ (a &&& (1 <<< (5*p)))

private theorem erase_safe {R : Nat → Prop} {a p : Nat}
    (ha : ∀ x, R x → a.testBit (5*x) = true) (hp : ¬R p) :
    ∀ x, R x → (erase a p).testBit (5*x) = true := by
  intro t ht
  have hne : p ≠ t := fun he => hp (he ▸ ht)
  simp [erase, Nat.testBit_xor, ha t ht, Nat.shiftLeft_eq, show 5*p ≠ 5*t by omega]


private abbrev State := (Marks × Nat) × Nat
private def leftStep (s : State) (p : Nat) : State :=
  (addRed s.1.1 s.1.2 p, s.2 ||| pointHits p)
private def rightStep (s : State) (p : Nat) : State :=
  ((s.1.1, erase s.1.2 p), s.2)
private def Closed (s : State) := Bad Hits s.1

private def matchGate (leaves : Array {s // Closed s}) (i : Nat) (s : State) : Bool :=
  match leaves[i]? with
  | none => false
  | some v => v.val == s

private theorem gate_sound (leaves : Array {s // Closed s}) (k : Nat) (s : State)
    (h : matchGate leaves k s = true) : Closed s := by
  unfold matchGate at h
  split at h
  · contradiction
  · rename_i v _
    exact (beq_iff_eq.mp h) ▸ v.property

-- Ranks 1, 0, 2, 3 and 4 have successively longer prefix codes.
-- Eleven bits carry the rarer ranks and previously verified subtree references.
private def word (tape : Array Nat) (i : Nat) : Nat :=
  let v := (tape[i/512]?.getD 0 >>> (i%512)) % 2048
  if v%2=0 then 1 else if v%4=1 then 0 else if v%8=3 then 2 else
    if v%16=7 then 3 else if v%32=15 then 4 else 5+v/32

private def width (op : Nat) : Nat :=
  if op=1 then 1 else if op=0 then 2 else if op=2 then 3 else
    if op=3 then 4 else if op=4 then 5 else 11

private def firstSlot (mask : Nat) : Nat → Nat → Nat
  | 0, _ => 0
  | fuel+1, tallies =>
    let hits := tallies &&& mask
    if hits != 0 then slotIndex hits else firstSlot mask fuel (tallies+slots)

private def selectSlot (s : State) : Nat :=
  let available := high - ((s.1.2 * convolution) &&& fieldMask)
  firstSlot (mask158 &&& (high - s.2)) 14 available

private def dropPoints : Nat → Nat → Nat
  | 0, v => v
  | n+1, v => dropPoints n (v &&& (v-1))

-- The return value is one plus the next cursor, or zero if the check fails.
private def visit (leaves : Array {s // Closed s}) (tape : Array Nat) :
    Nat → Nat → State → Nat
  | 0, _, _ => 0
  | fuel+1, i, s =>
    let op := word tape i
    if op ≥ 32 && matchGate leaves (op-32) s then i+width op+1 else
      let rest := pattern (selectSlot s) &&& s.1.2
      if rest = 0 then i+1 else
        let p := pointIndex rest
        if rest = (1 <<< (5*p)) then visit leaves tape fuel i (leftStep s p) else
          if op < 32 then
            let q := pointIndex (dropPoints op rest)
            let next := visit leaves tape fuel (i+width op) (leftStep s q)
            if next = 0 then 0 else visit leaves tape fuel (next-1) (rightStep s q)
          else 0

private theorem visit_sound {tape : Array Nat} (leaves : Array {s // Closed s})
    (fuel i : Nat) (s : State) (hw : visit leaves tape fuel i s ≠ 0) : Closed s := by
  induction fuel generalizing i s with
  | zero => simp [visit] at hw
  | succ fuel ih =>
    simp only [visit] at hw
    split at hw
    · rename_i he
      exact gate_sound leaves _ s (Bool.and_eq_true_iff.mp he).2
    · intro R bound hn hit hs ha
      let slot := selectSlot s
      obtain ⟨t,hbit,ht⟩ := hit slot
      have hr : (pattern slot &&& s.1.2).testBit (5*t) = true := by
        simp [hbit, ha t ht]
      split at hw
      · rename_i hz
        change pattern slot &&& s.1.2 = 0 at hz
        simp [hz] at hr
      · split at hw
        · rename_i hsingle
          let p := pointIndex (pattern slot &&& s.1.2)
          change pattern slot &&& s.1.2 = 1 <<< (5*p) at hsingle
          rw [hsingle, Nat.shiftLeft_eq, Nat.one_mul, Nat.testBit_two_pow] at hr
          have hp : R p := (show t = p by have := of_decide_eq_true hr; omega) ▸ ht
          exact ih _ _ hw R bound hn hit
            (join_good hs (mark_good hn hp (bound _ hp))) (add_safe hs ha hp)
        · split at hw
          · split at hw
            · contradiction
            · rename_i hleft
              let q := pointIndex (dropPoints (word tape i) (pattern slot &&& s.1.2))
              by_cases hq : R q
              · exact ih _ _ hleft R bound hn hit
                  (join_good hs (mark_good hn hq (bound _ hq))) (add_safe hs ha hq)
              · exact ih _ _ hw R bound hn hit hs (erase_safe ha hq)
          · contradiction

private theorem certify {s : State} (tape : Array Nat) (leaves : Array {s // Closed s})
    (h : visit leaves tape 145 0 s ≠ 0) : Closed s := visit_sound leaves 145 0 s h

private def densePoint (v : Nat) : Nat :=
  (( : Nat) >>> (8*((v ^^^ (v-1))%173)))%256

private def paint : Nat → Nat → Marks × Nat → Marks × Nat
  | 0, _, acc => acc
  | fuel+1, v, acc =>
    if v = 0 then acc else
      let p := densePoint v
      paint fuel (v &&& (v-1)) (join acc.1 (mark p), acc.2 ||| (1 <<< (5*p)))

