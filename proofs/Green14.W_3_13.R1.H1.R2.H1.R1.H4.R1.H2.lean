  have start (x : Nat) (hx : S x) : (0x21084210842108421084210842108421084210842108421084210842108421084210842108421084210842108421080000040000421084210842108421084210842108421084210842108421084210842108421084210842108421084210842108421 : Nat).testBit (5*x) = true := by
