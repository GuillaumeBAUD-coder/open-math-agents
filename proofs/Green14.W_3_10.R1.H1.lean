lemma center0 (r : Fin 97 → Bool) (hr : r (Fin.ofNat 97 48) = true)
    (hb : ∀ i : Fin 97, 48 < i.val → i.val < 48 → r i = false) : Mono r := by
  by_contra hn
  apply node192 (Red r) (noTriple_of_not_mono hn) (all_hit hn)
  · intro x hx
    have he : x = 48 := by simpa using hx
    exact he ▸ ⟨by decide,hr⟩
  · intro x hx
    obtain ⟨hx,hrx⟩ := hx
    have hh : x ≤ 48 ∨ 48 ≤ x := by
      by_contra! outside
      have hblue := hb ⟨x,hx⟩ outside.1 outside.2
      have he : Fin.ofNat 97 x = ⟨x,hx⟩ := Fin.ext (Nat.mod_eq_of_lt hx)
      exact Bool.noConfusion (hrx.symm.trans ((congrArg r he).trans hblue))
    have mask : ∀ t : Fin 97, t.val ≤ 48 ∨ 48 ≤ t.val → (0x1ffffffffffffffffffffffff : ℕ).testBit t.val = true := by decide +kernel
    exact mask ⟨x,hx⟩ hh

