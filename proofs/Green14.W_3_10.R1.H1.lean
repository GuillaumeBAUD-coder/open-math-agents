lemma center0 (r : Fin 97 → Bool) (hr : r (Fin.ofNat 97 48) = true)
    (hb : ∀ i : Fin 97, 48 < i.val → i.val < 48 → r i = false) : Mono r := by
  by_contra hn
  apply node59 (Red r) (noTriple_of_not_mono hn) (all_hit hn)
  · intro x hx
    have he : x = 48 := by simpa using hx
    exact he ▸ ⟨by decide, hr⟩
  · intro x hx
    obtain ⟨hxlt, hred⟩ := hx
    have hbound : x ≤ 48 ∨ 48 ≤ x := by
      by_contra! bad
      have hblue := hb ⟨x, hxlt⟩ bad.1 bad.2
      have he : (Fin.ofNat 97 x) = ⟨x, hxlt⟩ := Fin.ext (Nat.mod_eq_of_lt hxlt)
      exact Bool.noConfusion (hred.symm.trans ((congrArg r he).trans hblue))
    have hbits : ∀ t : Fin 97, t.val ≤ 48 ∨ 48 ≤ t.val →
        Nat.testBit 0x1ffffffffffffffffffffffff t.val = true := by decide +kernel
    exact hbits ⟨x, hxlt⟩ hbound

lemma center1 (r : Fin 97 → Bool) (hr : r (Fin.ofNat 97 47) = true)
    (hb : ∀ i : Fin 97, 47 < i.val → i.val < 49 → r i = false) : Mono r := by
  by_contra hn
  apply node109 (Red r) (noTriple_of_not_mono hn) (all_hit hn)
  · intro x hx
    have he : x = 47 := by simpa using hx
    exact he ▸ ⟨by decide, hr⟩
  · intro x hx
    obtain ⟨hxlt, hred⟩ := hx
    have hbound : x ≤ 47 ∨ 49 ≤ x := by
      by_contra! bad
      have hblue := hb ⟨x, hxlt⟩ bad.1 bad.2
      have he : (Fin.ofNat 97 x) = ⟨x, hxlt⟩ := Fin.ext (Nat.mod_eq_of_lt hxlt)
      exact Bool.noConfusion (hred.symm.trans ((congrArg r he).trans hblue))
    have hbits : ∀ t : Fin 97, t.val ≤ 47 ∨ 49 ≤ t.val →
        Nat.testBit 0x1fffffffffffeffffffffffff t.val = true := by decide +kernel
    exact hbits ⟨x, hxlt⟩ hbound

end OMA.Progressions

theorem OMA.solution : OMA.R_Green14_W_3_10_R1.H1 := by
  intro r j hj hj' hr hb
  have he : j.val = 0 ∨ j.val = 1 := by omega
  rcases he with he | he
  · exact OMA.Progressions.center0 r (by simpa [he] using hr) (by simpa [he] using hb)
  · exact OMA.Progressions.center1 r (by simpa [he] using hr) (by simpa [he] using hb)
