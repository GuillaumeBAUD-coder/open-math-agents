lemma center1 (r : Fin 97 → Bool) (hr : r (Fin.ofNat 97 47) = true)
    (hb : ∀ i : Fin 97, 47 < i.val → i.val < 49 → r i = false) : Mono r := by
  by_contra hn
  apply node342 (Red r) (noTriple_of_not_mono hn) (all_hit hn)
  · intro x hx
    have he : x = 47 := by simpa using hx
    exact he ▸ ⟨by decide,hr⟩
  · intro x hx
    obtain ⟨hx,hrx⟩ := hx
    have hh : x ≤ 47 ∨ 49 ≤ x := by
      by_contra! outside
      have hblue := hb ⟨x,hx⟩ outside.1 outside.2
      have he : Fin.ofNat 97 x = ⟨x,hx⟩ := Fin.ext (Nat.mod_eq_of_lt hx)
      exact Bool.noConfusion (hrx.symm.trans ((congrArg r he).trans hblue))
    have mask : ∀ t : Fin 97, t.val ≤ 47 ∨ 49 ≤ t.val → (0x1fffffffffffeffffffffffff : ℕ).testBit t.val = true := by decide +kernel
    exact mask ⟨x,hx⟩ hh

end OMA.Progressions

theorem OMA.solution : OMA.R_Green14_W_3_10_R1.H1 := by
  intro r j hlo hhi hr hb
  have hh : j.val = 0 ∨ j.val = 1 := by omega
  rcases hh with h | h
  · exact OMA.Progressions.center0 r (by simpa [h] using hr) (by simpa [h] using hb)
  · exact OMA.Progressions.center1 r (by simpa [h] using hr) (by simpa [h] using hb)
