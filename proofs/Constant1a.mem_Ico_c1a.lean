namespace C1aUpper

/-- Use an explicit radix throughout to avoid reducing a large concrete packed
power merely to unify two ways of writing the small radix exponent. -/
theorem guarded_conv_with_radix {B k w N A M : ℕ}
    (hbase : B = 2 ^ (k + 1)) (hw : w ≤ k + 1)
    (hA : A < B ^ N)
    (hA_low : A &&& ((2 ^ w - 1) * unitMask B N) = A)
    (hnoCarry : N * (2 ^ w - 1) ^ 2 < B)
    (hY_low : (A * A) &&& ((2 ^ k - 1) * unitMask B (2 * N)) = A * A)
    (hM : M < 2 ^ k)
    (hguard : ((A * A) + (2 ^ k - 1 - M) * unitMask B (2 * N)) &&&
      ((2 ^ k) * unitMask B (2 * N)) = 0) :
    ∀ m < 2 * N, conv N (digit B A) m ≤ M := by
  subst B
  exact kron_guard_cert hw hA hA_low hnoCarry hY_low hM hguard

end C1aUpper


noncomputable def OMA.answer : ℝ :=
  (63026560313 : ℝ) / 41943040000

namespace C1aUpper.Witness
open Finset

set_option maxHeartbeats 0 in
set_option maxRecDepth 4096 in
theorem certified_compact_upper : Constant1a.C1a ≤ OMA.answer := by
  have hsize : A < B ^ N := by decide +kernel
  have hheight : A &&& ((2 ^ 20 - 1) * unitMask B N) = A := by decide +kernel
  have hsum : S ≤ ∑ i ∈ range N, digit B A i := by
    have checkSum : S = A % (B - 1) := by decide +kernel
    rw [checkSum]
    exact packed_mod_le_digit_sum B A N (by decide +kernel) hsize
  have hsquare : (A * A) &&& ((2 ^ 58 - 1) * unitMask B (2 * N)) = A * A := by
    decide +kernel
  have hguard : ((A * A) + (2 ^ 58 - 1 - M) * unitMask B (2 * N)) &&&
      ((2 ^ 58) * unitMask B (2 * N)) = 0 := by decide +kernel
  have hcoeff : ∀ m < 2 * N, conv N (digit B A) m ≤ M :=
    guarded_conv_with_radix (B := B) (k := 58) (w := 20) (N := N) (A := A) (M := M)
      (by decide +kernel) (by decide +kernel) hsize hheight (by decide +kernel)
      hsquare (by decide +kernel) hguard
  have bound := C1a_le_of_steps N (by decide) (digit B A) M S (by decide) hsum hcoeff
  have value : (2 * (N : ℝ) * M) / (S : ℝ) ^ 2 = OMA.answer := by
    unfold N M S OMA.answer
    norm_num
  rwa [value] at bound

end C1aUpper.Witness

theorem OMA.solution : Constant1a.mem_Ico_c1a.answer = OMA.answer → type_of% @Constant1a.mem_Ico_c1a := by
  intro h
  change Constant1a.C1a ≤ Constant1a.mem_Ico_c1a.answer ∧ Constant1a.mem_Ico_c1a.answer < (1.5028628587 : ℝ)
  rw [h]
  exact ⟨C1aUpper.Witness.certified_compact_upper, by norm_num [OMA.answer]⟩
