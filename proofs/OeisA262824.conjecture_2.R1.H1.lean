import OMAReductions.R_OeisA262824_conjecture_2_R1

/-!
For each n from 0 through 4999, the table supplies four nonnegative integers.
Their square, cube, twice cube and fourth power sum to n, as checked by the kernel.
-/

private def represents (packed n : ℕ) : Bool :=
  let w := packed % 128
  let x := packed / 128 % 128
  let y := packed / 128 ^ 2 % 128
  let z := packed / 128 ^ 3
  n == w ^ 2 + x ^ 3 + 2 * y ^ 3 + z ^ 4

private def verify (first : ℕ) (values : List ℕ) : Bool :=
  (values.zipIdx first).all fun (packed, n) => represents packed n

private theorem verify_append {first : ℕ} {left right : List ℕ}
    (hLeft : verify first left = true) (hRight : verify (first + left.length) right = true) :
    verify first (left ++ right) = true := by
  simpa only [verify, List.zipIdx_append, List.all_append, Bool.and_eq_true] using And.intro hLeft hRight

private theorem verify_sound {first n : ℕ} {values : List ℕ} (h : verify first values = true)
    (lo : first ≤ n) (hi : n < first + values.length) :
    ∃ w x y z : ℕ, n = w ^ 2 + x ^ 3 + 2 * y ^ 3 + z ^ 4 := by
  have index : n - first < values.length := by omega
  let packed := values[n - first]
  have mem : (packed, n) ∈ values.zipIdx first :=
    List.mk_mem_zipIdx_iff_le_and_getElem?_sub.mpr ⟨lo, by simp [packed, index]⟩
  have eq := List.all_eq_true.mp h _ mem
  refine ⟨packed % 128, packed / 128 % 128, packed / 128 ^ 2 % 128, packed / 128 ^ 3, ?_⟩
  simpa only [represents, beq_iff_eq] using eq


