private lemma unique {x y z w : Nat} (hz : 0 < z)
    (hn : x^2+y^2+z^2+w^2 = 69383)
    (hs : isSquare ((5*x^2+7*y^2+9*z^2)*y*z) = true) :
    x = 187 ∧ y = 147 ∧ z = 6 ∧ w = 113 := by
  have bound (v : Nat) (h : v^2 ≤ 69383) : v < 264 := by
    by_contra! e
    have := Nat.pow_le_pow_left e 2
    omega
  have xy := pairChecked (bound x (by omega)) (bound y (by omega))
  have zw := pairChecked (bound z (by omega)) (bound w (by omega))
  have hxy : x^2+y^2 ≤ 69383 := by omega
  have hzw : z^2+w^2 ≤ 69383 := by omega
  have e1 : 69383 - (x^2+y^2) = z^2+w^2 := by omega
  have e2 : 69383 - (z^2+w^2) = x^2+y^2 := by omega
  simp only [pairOK,if_pos hxy,if_pos hzw,e1,e2,Bool.and_eq_true] at xy zw
  have hzw' := zw.2
  have hxy' := xy.2
  simp only [xy.1,Bool.not_true,Bool.false_or,Bool.and_eq_true] at hzw'
  simp only [zw.1,Bool.not_true,Bool.false_or,Bool.and_eq_true] at hxy'
  have member := List.contains_iff_mem.mp hzw'.1
  have all := hxy'.2
  have hh := List.all_eq_true.mp all (z,w) member
  simpa [allowed,hz,hn,hs,and_assoc] using hh

private lemma counted : a 69383 = 1 := by
  unfold a
  have value (x y z w : Nat) (hz : 0 < z) :
      (if x^2+y^2+z^2+w^2 == 69383 && isSquare ((5*x^2+7*y^2+9*z^2)*y*z) then 1 else 0 : Nat) =
      (if x=187 ∧ y=147 ∧ z=6 ∧ w=113 then 1 else 0) := by
    by_cases h : x=187 ∧ y=147 ∧ z=6 ∧ w=113
    · obtain ⟨rfl,rfl,rfl,rfl⟩ := h
      decide +kernel
    · have hn : ¬ (x^2+y^2+z^2+w^2 = 69383 ∧ isSquare ((5*x^2+7*y^2+9*z^2)*y*z) = true) :=
        fun H => h (unique hz H.1 H.2)
      simp [h,hn]
  calc
    _ = ∑ x ∈ Finset.range (69383+1), ∑ y ∈ Finset.range (69383+1),
          ∑ z ∈ Finset.Ico 1 (69383+1), ∑ w ∈ Finset.range (69383+1),
            (if x=187 ∧ y=147 ∧ z=6 ∧ w=113 then 1 else 0 : Nat) := by
      apply Finset.sum_congr rfl
      intro x _
      apply Finset.sum_congr rfl
      intro y _
      apply Finset.sum_congr rfl
      intro z hz
      apply Finset.sum_congr rfl
      intro w _
      exact value _ _ _ _ (Finset.mem_Ico.mp hz).1
    _ = 1 := by
      simp only [ite_and]
      simp [Finset.sum_ite_irrel,Finset.sum_ite_eq']

end OMA.FourSquares
open OMA.FourSquares in
theorem OMA.solution : type_of% @OeisA261876.conjecture_2 := by
  intro h
  obtain ⟨k,m,hm,he⟩ := (h 69383).mp counted
  cases k with
  | zero => norm_num at he; subst m; norm_num [specialSet] at hm
  | succ k => rw [pow_succ] at he; have H : 4 ∣ 69383 := ⟨4^k*m,by rw [he]; ring⟩; norm_num at H
