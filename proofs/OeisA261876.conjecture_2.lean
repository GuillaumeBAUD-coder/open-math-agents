private def buckets (i : Nat) := (bucketsData[i/32]!).getD (i%32) 0

private def possible (t : Nat) := (cover (t/256)).testBit (t%256)
private def decode : Nat → Nat → List (Nat × Nat)
  | 0, _ => []
  | j+1, v =>
    let e := v % 262144 - 1
    (e % 512,e/512) :: decode j (v/262144)
private def candidates (t : Nat) :=
  let v := buckets (t%2048)
  decode ((v.log2/18)+1) v

private def allowed (x y : Nat) (p : Nat × Nat) : Bool :=
  let z := p.1
  let w := p.2
  !(0 < z && x^2+y^2+z^2+w^2 == 69383 &&
    isSquare ((5*x^2+7*y^2+9*z^2)*y*z)) ||
    (x == 187 && y == 147 && z == 6 && w == 113)

private def pairOK (x y : Nat) : Bool :=
  let t := x^2+y^2
  if t ≤ 69383 then
    possible t && (!possible (69383-t) ||
      ((candidates t).contains (x,y) && (candidates (69383-t)).all (allowed x y)))
  else true

private def row (x : Nat) := (List.range 264).all (pairOK x)
