lemma mid (n : ℕ) (h1 : 84 ≤ n) (h2 : n < 1266) : 7 ≤ ways n := by
  have l0 : W0.length = 200 := rfl
  have l1 : W1.length = 200 := rfl
  have l2 : W2.length = 200 := rfl
  have l3 : W3.length = 200 := rfl
