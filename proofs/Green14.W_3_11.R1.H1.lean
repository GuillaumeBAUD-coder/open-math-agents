import OMAReductions.R_Green14_W_3_11_R1

/-!
The forbidden-position search and the progression-mask argument are adapted
from the proof of Green14.W_3_11.R1.H3 in open-math-agents.
Here both center conditions are covered by a single 113-position interval.
If its position 55 is red, the following tree rules out avoiding a red
three-term progression while meeting every eleven-term progression in red.
At a progression instruction the available positions are either empty or
a singleton. An empty intersection closes the branch. A singleton forces
its unique position red. A split instruction checks both colors of a point.
The four masks stored at subtree boundaries represent the chosen red
positions reflected, doubled, and compressed by parity.
-/

namespace OMA.Center55

private def NoTriple (R : Nat → Prop) :=
  ∀ a d, 0 < d → R a → R (a+d) → R (a+2*d) → False

private lemma distinct_terms {R : Nat → Prop} (hn : NoTriple R) {u v w : Nat}
    (hu : R u) (hv : R v) (hw : R w) (he : u+w=2*v) (hne : u ≠ w) : False := by
  rcases lt_or_gt_of_ne hne with h | h
  · exact hn u (v-u) (by omega) hu (by simpa only [show u+(v-u)=v by omega] using hv)
      (by simpa only [show u+2*(v-u)=w by omega] using hw)
  · exact hn w (v-w) (by omega) hw (by simpa only [show w+(v-w)=v by omega] using hv)
      (by simpa only [show w+2*(v-w)=u by omega] using hu)

-- Four views of the chosen red positions give every forbidden third point
-- by shifts. The last two views compress even and odd positions separately.
private structure Marks where
  rev : Nat
  dbl : Nat
  ev : Nat
  od : Nat
  deriving DecidableEq

private def mark (q : Nat) : Marks :=
  ⟨1 <<< (112-q), 1 <<< (2*q),
    if q%2=0 then 1 <<< (q/2) else 0,
    if q%2=1 then 1 <<< (q/2) else 0⟩

private def join (s t : Marks) : Marks :=
  ⟨s.rev ||| t.rev, s.dbl ||| t.dbl, s.ev ||| t.ev, s.od ||| t.od⟩

private def forbidden (s : Marks) (p : Nat) : Nat :=
  ((s.rev <<< (2*p)) >>> 112) ||| (s.dbl >>> p) |||
    ((if p%2=0 then s.ev else s.od) <<< ((p+1)/2))

private def Good (R : Nat → Prop) (s : Marks) :=
  ∀ p t, R p → R t → t ≠ p → (forbidden s p).testBit t = false

private lemma mark_good {R : Nat → Prop} (hn : NoTriple R)
    {q : Nat} (hq : R q) (hq' : q ≤ 112) : Good R (mark q) := by
  intro p t hp ht hne
  have h₁ : t+q ≠ 2*p := fun he =>
    distinct_terms hn ht hp hq he (by rintro rfl; omega)
  have h₂ : t+p ≠ 2*q := fun he => distinct_terms hn ht hq hp he hne
  have h₃ : p+q ≠ 2*t := fun he =>
    distinct_terms hn hp ht hq he (by rintro rfl; omega)
  have single (x i : Nat) : (1 <<< x : Nat).testBit i = decide (x=i) := by
    rw [Nat.shiftLeft_eq, one_mul, Nat.testBit_two_pow]
  unfold forbidden mark
  split_ifs <;> simp only [Nat.testBit_or, Nat.testBit_shiftRight, single,
    Nat.testBit_shiftLeft, Nat.zero_testBit, Bool.or_eq_false_iff,
    Bool.and_eq_false_imp, decide_eq_true_eq, decide_eq_false_iff_not]
  all_goals (repeat' apply And.intro) <;> intros <;> first | trivial | omega

private lemma join_good {R : Nat → Prop} {s u : Marks} (hs : Good R s) (hu : Good R u) :
    Good R (join s u) := by
  intro p t hp ht hn
  have h₁ := hs p t hp ht hn
  have h₂ := hu p t hp ht hn
  unfold forbidden at *
  unfold join
  split_ifs at * <;> simp_all [Nat.testBit_or, Nat.testBit_shiftRight, Nat.testBit_shiftLeft]

private def addRed (s : Marks) (a p : Nat) : Marks × Nat :=
  let bad := forbidden s p
  (join s (mark p), (a ^^^ (a &&& bad)) ||| (1 <<< p))

private def Bad (hit : (Nat → Prop) → Prop) (seed : Marks × Nat) :=
  ∀ R : Nat → Prop, (∀ x, R x → x ≤ 112) → NoTriple R → hit R →
    Good R seed.1 → (∀ x, R x → seed.2.testBit x = true) → False

private lemma add_safe {R : Nat → Prop} {s : Marks} {a p : Nat} (hs : Good R s)
    (ha : ∀ x, R x → a.testBit x = true) (hp : R p) :
    ∀ x, R x → (addRed s a p).2.testBit x = true := by
  intro x hx
  by_cases he : x = p
  · simp [addRed, he, Nat.shiftLeft_eq]
  · simp [addRed, Nat.testBit_xor, ha x hx, hs p x hp hx he]

private def bases : Array Nat := #[1, 0x7ff, 0x155555, 0x49249249, 0x11111111111, 0x4210842108421, 0x1041041041041041, 0x408102040810204081, 0x101010101010101010101, 0x40201008040201008040201, 0x10040100401004010040100401, 0x4008010020040080100200400801]

private def pattern (i : Nat) : Nat :=
  let a := i%128
  let d := i/128+1
  if a+10*d < 113 then bases[d]! <<< a else bases[1]!

private def Hits (R : Nat → Prop) := ∀ i, ∃ t, (pattern i).testBit t = true ∧ R t

private def gate (leaves : Array {s // Bad Hits s}) (k : Nat) (s : Marks × Nat) : Bool :=
  match leaves[k]? with
  | some leaf => leaf.val == s
  | none => false

private lemma gate_sound (leaves : Array {s // Bad Hits s}) (k : Nat) (s : Marks × Nat)
    (h : gate leaves k s = true) : Bad Hits s := by
  unfold gate at h
  split at h
  · rename_i leaf he
    exact (beq_iff_eq.mp h) ▸ leaf.property
  · contradiction

-- Each 11-bit instruction gives a progression, a splitting position,
-- or a reference to a previously verified subtree.
private def word (tape : Array Nat) (i : Nat) : Nat :=
  (tape[i/64]! >>> (11*(i%64))) % 2048

private def walk (leaves : Array {s // Bad Hits s}) (tape : Array Nat) :
    Nat → Nat → Marks × Nat → Bool
  | 0, _, _ => false
  | fuel+1, i, s =>
    let z := word tape i
    if z < 1408 then
      let rest := pattern z &&& s.2
      if rest = 0 then true else
        let p := rest.log2
        (rest == (1 <<< p)) && walk leaves tape fuel (i+1) (addRed s.1 s.2 p)
    else if z < 1536 then
      let p := z-1408
      walk leaves tape fuel (i+2) (addRed s.1 s.2 p) &&
        walk leaves tape fuel (i+word tape (i+1)) (s.1, s.2 ^^^ (s.2 &&& (1 <<< p)))
    else gate leaves (z-1536) s

private lemma walk_sound {tape : Array Nat} (leaves : Array {s // Bad Hits s})
    (fuel i : Nat) (s : Marks × Nat) (hw : walk leaves tape fuel i s = true) : Bad Hits s := by
  induction fuel generalizing i s with
  | zero => simp [walk] at hw
  | succ fuel ih =>
    intro R bound hn hit hs ha
    simp only [walk] at hw
    split at hw
    · obtain ⟨t,hbit,ht⟩ := hit (word tape i)
      have hrest : (pattern (word tape i) &&& s.2).testBit t = true := by simp [hbit,ha t ht]
      split at hw
      · rename_i hzero
        simp [hzero] at hrest
      · simp only [Bool.and_eq_true] at hw
        obtain ⟨hpow,hstep⟩ := hw
        rw [beq_iff_eq.mp hpow, Nat.shiftLeft_eq, one_mul, Nat.testBit_two_pow] at hrest
        have hp := (of_decide_eq_true hrest) ▸ ht
        apply ih _ _ hstep R bound hn hit
        · exact join_good hs (mark_good hn hp (bound _ hp))
        · exact add_safe hs ha hp
    · split at hw
      · simp only [Bool.and_eq_true] at hw
        obtain ⟨hl,hr⟩ := hw
        by_cases hp : R (word tape i - 1408)
        · exact ih _ _ hl R bound hn hit (join_good hs (mark_good hn hp (bound _ hp))) (add_safe hs ha hp)
        · apply ih _ _ hr R bound hn hit hs
          intro t ht
          have hne : word tape i - 1408 ≠ t := fun he => hp (he ▸ ht)
          simp [Nat.testBit_xor, ha t ht, Nat.shiftLeft_eq, hne]
      · exact gate_sound leaves _ s hw R bound hn hit hs ha

private lemma certify {s : Marks × Nat} (tape : Array Nat) (leaves : Array {s // Bad Hits s})
    (h : walk leaves tape 120 0 s = true) : Bad Hits s := walk_sound leaves 120 0 s h

