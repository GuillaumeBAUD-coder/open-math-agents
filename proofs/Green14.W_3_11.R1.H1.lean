private def Mono (r : Fin 114 → Bool) := ∃ (b : Bool) (a d : Fin 114), 0 < d.val ∧
  a.val + (if b then 2 else 10) * d.val < 114 ∧
  ∀ t : Fin 11, t.val ≤ (if b then 2 else 10) →
    r (Fin.ofNat 114 (a.val+t.val*d.val)) = b

private def Red (r : Fin 114 → Bool) (o x : Nat) :=
  x < 113 ∧ r (Fin.ofNat 114 (o+x)) = true

private lemma triple_free {r : Fin 114 → Bool} {o : Nat} (ho : o ≤ 1)
    (hn : ¬ Mono r) : NoTriple (Red r o) := by
  intro a d hd h₀ h₁ h₂
  obtain ⟨hb,hc⟩ := h₂
  apply hn
  refine ⟨true, ⟨o+a,by omega⟩, ⟨d,by omega⟩, hd, by change o+a+2*d<114; omega, ?_⟩
  intro t ht
  change t.val ≤ 2 at ht
  rcases (show t.val=0 ∨ t.val=1 ∨ t.val=2 by omega) with he|he|he
  · simpa [he] using h₀.2
  · simpa [he, Nat.add_assoc] using h₁.2
  · simpa [he, Nat.add_assoc] using hc

private lemma base_bit : ∀ d : Fin 12, 0 < d.val → ∀ t : Fin 11,
    bases[d.val]!.testBit (t.val*d.val) = true := by decide +kernel

private lemma hit_at {r : Fin 114 → Bool} {o a d : Nat} (ho : o ≤ 1) (hn : ¬ Mono r)
    (hd : 0 < d) (hb : a+10*d < 113) :
    ∃ t, (bases[d]! <<< a).testBit t = true ∧ Red r o t := by
  by_contra! bad
  apply hn
  refine ⟨false, ⟨o+a,by omega⟩, ⟨d,by omega⟩, hd, by change o+a+10*d<114; omega, ?_⟩
  intro t _
  have ht := Nat.mul_le_mul_right d (show t.val ≤ 10 by omega)
  have hm : (bases[d]! <<< a).testBit (a+t.val*d) = true := by
    simpa [Nat.testBit_shiftLeft, Nat.le_add_right] using base_bit ⟨d,by omega⟩ hd t
  apply Bool.eq_false_iff.mpr
  intro hred
  exact bad _ hm ⟨by omega, by simpa [Nat.add_assoc] using hred⟩

private lemma hit_all {r : Fin 114 → Bool} {o : Nat} (ho : o ≤ 1) (hn : ¬ Mono r) :
    Hits (Red r o) := by
  intro i
  dsimp only [pattern]
  split
  · exact hit_at ho hn (by omega) (by assumption)
  · simpa using hit_at (a:=0) (d:=1) ho hn (by decide) (by decide)

private lemma from_center {r : Fin 114 → Bool} {o : Nat} (ho : o ≤ 1)
    (hr : r (Fin.ofNat 114 (o+55)) = true) : Mono r := by
  by_contra hn
  have hred : Red r o 55 := ⟨by decide, hr⟩
  have hb : ∀ x, Red r o x → x ≤ 112 := fun _ hx => Nat.le_of_lt_succ hx.1
  refine n209 (Red r o) hb (triple_free ho hn) (hit_all ho hn) ?_ ?_
  · change Good (Red r o) (mark 55)
    exact mark_good (triple_free ho hn) hred (by decide)
  · intro x hx
    have h : ∀ i : Fin 113, (0x1ffffffffffffffffffffffffffff : Nat).testBit i.val = true := by
      decide +kernel
    exact h ⟨x,hx.1⟩

end OMA.Center55

-- Credit: @MrSeizy
theorem OMA.solution : OMA.R_Green14_W_3_11_R1.H1 := by
  intro r j _ hj hr _
  rcases (show j.val=0 ∨ j.val=1 by omega) with he|he
  · exact OMA.Center55.from_center (o:=1) (by decide) (by simpa [he] using hr)
  · exact OMA.Center55.from_center (o:=0) (by decide) (by simpa [he] using hr)
