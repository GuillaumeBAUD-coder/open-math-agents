  have hAsub : A ⊆ Icc 1 149 := union_subset hB hRsub
  have h149A : 149 ∈ A := mem_union_left R h149
  have hA9 : A.card = 9 := by
    dsimp [A]
    rw [card_union_of_disjoint hdisj_RB.symm, hc, hR3]
  have hAsd : Erdos1.IsSumDistinctSet A 149 := by
    refine ⟨hAsub, ?_⟩
    intro ⟨S, hSA⟩ ⟨T, hTA⟩ hsum
    dsimp at hsum
    suffices hST : S = T by subst hST; rfl
    by_contra hne
    have hSA' : S ⊆ B ∪ R := mem_powerset.mp hSA
    have hTA' : T ⊆ B ∪ R := mem_powerset.mp hTA
    let S' : Finset ℕ := S \ T
    let T' : Finset ℕ := T \ S
    have hS'sub : S' ⊆ B ∪ R := sdiff_subset.trans hSA'
    have hT'sub : T' ⊆ B ∪ R := sdiff_subset.trans hTA'
    have hdisjST : Disjoint S' T' := disjoint_sdiff_sdiff
    have hne' : S' ≠ T' := by
      intro heq
      have hT'empty : T' = ∅ :=
        eq_empty_of_forall_notMem fun x hx => disjoint_left.mp (heq ▸ hdisjST) hx hx
      have hS'empty : S' = ∅ := heq.trans hT'empty
      exact hne (Subset.antisymm (sdiff_eq_empty_iff_subset.mp hS'empty)
        (sdiff_eq_empty_iff_subset.mp hT'empty))
    have hsum' : S'.sum id = T'.sum id := by
      have hS'eq' : S \ (S ∩ T) = S' := by ext x; simp [S']
      have hT'eq' : T \ (T ∩ S) = T' := by ext x; simp [T']
      have hs1 : S'.sum id + (S ∩ T).sum id = S.sum id := by
        rw [← hS'eq', sum_sdiff inter_subset_left]
      have hs2 : T'.sum id + (T ∩ S).sum id = T.sum id := by
        rw [← hT'eq', sum_sdiff inter_subset_left]
      rw [inter_comm T S] at hs2
      omega
    let U : Finset ℕ := S' ∩ R
    let SB : Finset ℕ := S' ∩ B
    let V : Finset ℕ := T' ∩ R
    let TB : Finset ℕ := T' ∩ B
    have hUR : U ⊆ R := inter_subset_right
    have hVR : V ⊆ R := inter_subset_right
    have hSBB : SB ⊆ B := inter_subset_right
    have hTBB : TB ⊆ B := inter_subset_right
    have hdisjUV : Disjoint U V := hdisjST.mono inter_subset_left inter_subset_left
    have hdisjSBU : Disjoint SB U := hdisj_RB.symm.mono inter_subset_right inter_subset_right
    have hdisjTBV : Disjoint TB V := hdisj_RB.symm.mono inter_subset_right inter_subset_right
    have hS'eq : S' = SB ∪ U := by
      ext x
      simp only [mem_union, mem_inter, SB, U]
      constructor
      · intro hx
        rcases mem_union.mp (hS'sub hx) with hxB | hxR
        · exact Or.inl ⟨hx, hxB⟩
        · exact Or.inr ⟨hx, hxR⟩
      · rintro (⟨hx, _⟩ | ⟨hx, _⟩) <;> exact hx
    have hT'eq : T' = TB ∪ V := by
      ext x
      simp only [mem_union, mem_inter, TB, V]
      constructor
      · intro hx
        rcases mem_union.mp (hT'sub hx) with hxB | hxR
        · exact Or.inl ⟨hx, hxB⟩
        · exact Or.inr ⟨hx, hxR⟩
      · rintro (⟨hx, _⟩ | ⟨hx, _⟩) <;> exact hx
    have hS'sum : S'.sum id = SB.sum id + U.sum id := by
      rw [hS'eq, sum_union hdisjSBU]
    have hT'sum : T'.sum id = TB.sum id + V.sum id := by
      rw [hT'eq, sum_union hdisjTBV]
    have hUV_D : ((U.sum id : ℕ) : ℤ) - (V.sum id : ℕ) ∈ D := by
      have hTBP : ((TB.sum id : ℕ) : ℤ) ∈ P :=
        mem_image.mpr ⟨TB, mem_powerset.mpr hTBB, rfl⟩
      have hSBP : ((SB.sum id : ℕ) : ℤ) ∈ P :=
        mem_image.mpr ⟨SB, mem_powerset.mpr hSBB, rfl⟩
      have heqZ : ((U.sum id : ℕ) : ℤ) - (V.sum id : ℕ) = (TB.sum id : ℕ) - (SB.sum id : ℕ) := by
        omega
      rw [heqZ]
      exact mem_sub.mpr ⟨_, hTBP, _, hSBP, rfl⟩
    have hVU_D : ((V.sum id : ℕ) : ℤ) - (U.sum id : ℕ) ∈ D := by
      have := hDneg _ hUV_D
      convert this using 1
      ring
    have hUVcard : U.card + V.card ≤ 3 := by
      rw [← card_union_of_disjoint hdisjUV, ← hR3]
      exact card_le_card (union_subset hUR hVR)
    have hnotzero : U.card + V.card ≠ 0 := by
      intro hz
      have hU0 : U = ∅ := card_eq_zero.mp (by omega)
      have hV0 : V = ∅ := card_eq_zero.mp (by omega)
      have hSBsum : SB.sum id = TB.sum id := by
        rw [hU0, sum_empty] at hS'sum
        rw [hV0, sum_empty] at hT'sum
        omega
      have hSBeqTB := hBsd SB (mem_powerset.mpr hSBB) TB (mem_powerset.mpr hTBB) hSBsum
      apply hne'
      rw [hS'eq, hT'eq, hU0, hV0, hSBeqTB]
    have hnotone : U.card + V.card ≠ 1 := by
      intro h1
      have handle1 : ∀ (X : Finset ℕ), X ⊆ R → X.card = 1 → ((X.sum id : ℕ) : ℤ) ∈ D → False := by
        intro X hXR hXc hXD
        rcases card_eq_one.mp hXc with ⟨r, rfl⟩
        have hrR : r ∈ R := hXR (mem_singleton_self r)
        simp only [sum_singleton, id_eq] at hXD
        exact (hRmem r hrR).2.2 hXD
      rcases (by omega : (U.card = 1 ∧ V.card = 0) ∨ (U.card = 0 ∧ V.card = 1)) with ⟨hU1, hV0⟩ | ⟨hU0, hV1⟩
      · have hVe : V = ∅ := card_eq_zero.mp hV0
        rw [hVe, sum_empty, Nat.cast_zero, sub_zero] at hUV_D
        exact handle1 U hUR hU1 hUV_D
      · have hUe : U = ∅ := card_eq_zero.mp hU0
        rw [hUe, sum_empty, Nat.cast_zero, sub_zero] at hVU_D
        exact handle1 V hVR hV1 hVU_D
    have hnottwo : U.card + V.card ≠ 2 := by
      intro h2
      have handle_pair : ∀ (X : Finset ℕ), X ⊆ R → X.card = 2 → ((X.sum id : ℕ) : ℤ) ∈ D → False := by
        intro X hXR hXc hXD
        rcases card_eq_two.mp hXc with ⟨x, y, hxy, rfl⟩
        have hxR : x ∈ R := hXR (mem_insert_self x {y})
        have hyR : y ∈ R := hXR (mem_insert_of_mem (mem_singleton_self y))
        simp only [sum_pair hxy, id_eq] at hXD
        rcases lt_or_gt_of_ne hxy with hlt | hlt
        · have hadd : (y : ℤ) + x ∈ D := by convert hXD using 1; push_cast; ring
          exact (hedges x hxR y hyR hlt).2 hadd
        · have hadd : (x : ℤ) + y ∈ D := by convert hXD using 1; push_cast; ring
          exact (hedges y hyR x hxR hlt).2 hadd
      rcases (by omega : (U.card = 2 ∧ V.card = 0) ∨ (U.card = 0 ∧ V.card = 2) ∨ (U.card = 1 ∧ V.card = 1)) with
        ⟨hU2, hV0⟩ | ⟨hU0, hV2⟩ | ⟨hU1, hV1⟩
      · have hVe : V = ∅ := card_eq_zero.mp hV0
        rw [hVe, sum_empty, Nat.cast_zero, sub_zero] at hUV_D
        exact handle_pair U hUR hU2 hUV_D
      · have hUe : U = ∅ := card_eq_zero.mp hU0
        rw [hUe, sum_empty, Nat.cast_zero, sub_zero] at hVU_D
        exact handle_pair V hVR hV2 hVU_D
      · rcases card_eq_one.mp hU1 with ⟨x, hUx⟩
        rcases card_eq_one.mp hV1 with ⟨y, hVy⟩
        have hxR : x ∈ R := hUR (hUx ▸ mem_singleton_self x)
        have hyR : y ∈ R := hVR (hVy ▸ mem_singleton_self y)
        have hxy : x ≠ y := by
          intro hxy
          have := disjoint_left.mp hdisjUV (hUx ▸ mem_singleton_self x) (hVy ▸ hxy ▸ mem_singleton_self x)
          exact this
        rw [hUx, hVy, sum_singleton, sum_singleton, id_eq] at hUV_D hVU_D
        rcases lt_or_gt_of_ne hxy with hlt | hlt
        · exact (hedges x hxR y hyR hlt).1 hVU_D
        · exact (hedges y hyR x hxR hlt).1 hUV_D
    have hUV3 : U.card + V.card = 3 := by omega
    have hUVeqR : U ∪ V = R := by
      apply eq_of_subset_of_card_le (union_subset hUR hVR)
      rw [card_union_of_disjoint hdisjUV, hUV3, hR3]
    have hVeq : V = R \ U := by
      rw [← hUVeqR, union_sdiff_left, sdiff_eq_self_of_disjoint hdisjUV.symm]
    rw [hVeq] at hUV_D
    exact hnone U (mem_powerset.mpr hUR) hUV_D
  exact OMA.Erdos1H149.no_nine_sum_distinct_149 hAsd hA9 h149A

end
