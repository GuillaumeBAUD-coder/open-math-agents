private def checkList (n : ℕ) : List ℕ → Bool
  | [] => true
  | p :: ps => decide (n * n < p ∧ p < (n + 1) * (n + 1)) && isPrimeBool p && checkList (n + 1) ps

private lemma checkList_sound : ∀ (l : List ℕ) (n : ℕ), checkList n l = true →
    ∀ i : ℕ, i < l.length →
      let p := l.getD i 0
      (n + i) ^ 2 < p ∧ p < (n + i + 1) ^ 2 ∧ p.Prime := by
  intro l
  induction l with
  | nil => intro _ _ i hi; simp at hi
  | cons p ps ih =>
    intro n hok i hi
    unfold checkList at hok
    rw [Bool.and_eq_true, Bool.and_eq_true, decide_eq_true_eq] at hok
    cases i with
    | zero =>
      simp only [List.getD_cons_zero, add_zero]
      exact ⟨by rw [sq]; exact hok.1.1.1, by rw [sq]; exact hok.1.1.2, isPrimeBool_sound hok.1.2⟩
    | succ j =>
      simp only [List.getD_cons_succ, List.length_cons] at hi ⊢
      have hres := ih (n + 1) hok.2 j (by omega)
      have heq : n + 1 + j = n + (j + 1) := by omega
      rwa [heq] at hres

private lemma witnesses_len : witnesses.length = 1000 := by decide +kernel
private lemma witnesses_ok : checkList 1 witnesses = true := by decide +kernel

end LegendreR1H1Proof

theorem OMA.solution : OMA.R_LegendreConjecture_legendre_conjecture_R1.H1 := by
  intro n h1 h2
  have hlt : n - 1 < LegendreR1H1Proof.witnesses.length := by rw [LegendreR1H1Proof.witnesses_len]; omega
  have h := LegendreR1H1Proof.checkList_sound LegendreR1H1Proof.witnesses 1
    LegendreR1H1Proof.witnesses_ok (n - 1) hlt
  have hne : 1 + (n - 1) = n := by omega
  rw [hne] at h
  exact ⟨LegendreR1H1Proof.witnesses.getD (n - 1) 0, ⟨h.1, h.2.1⟩, h.2.2⟩
