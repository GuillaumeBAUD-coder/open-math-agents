theorem OMA.solution : OMA.R_LegendreConjecture_legendre_conjecture_R1.H1 := by
  show ∀ n ≥ 1, n ≤ 1000 → ∃ p ∈ Set.Ioo (n ^ 2) ((n + 1) ^ 2), Nat.Prime p
  intro n hn hle
  have hok : okL n = true := by
    by_cases h0 : n < 101
    · exact chunk_sound c0 hn h0
    by_cases h1 : n < 201
    · exact chunk_sound c1 (by omega) h1
    by_cases h2 : n < 301
    · exact chunk_sound c2 (by omega) h2
    by_cases h3 : n < 401
    · exact chunk_sound c3 (by omega) h3
    by_cases h4 : n < 501
    · exact chunk_sound c4 (by omega) h4
    by_cases h5 : n < 601
    · exact chunk_sound c5 (by omega) h5
    by_cases h6 : n < 701
    · exact chunk_sound c6 (by omega) h6
    by_cases h7 : n < 801
    · exact chunk_sound c7 (by omega) h7
    by_cases h8 : n < 901
    · exact chunk_sound c8 (by omega) h8
    exact chunk_sound c9 (by omega) (by omega)
  simp only [okL, Bool.and_eq_true, decide_eq_true_eq] at hok
  obtain ⟨⟨h1, h2⟩, h3⟩ := hok
  exact ⟨_, ⟨h2, h3⟩, isP_prime h1 (by nlinarith)⟩
