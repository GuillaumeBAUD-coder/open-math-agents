def okL (n : ℕ) : Bool :=
  isP (n + 2) (W.getD (n - 1) 0) && n ^ 2 < W.getD (n - 1) 0 && W.getD (n - 1) 0 < (n + 1) ^ 2

def chunk (a b : ℕ) : Bool := (List.range (b - a)).all fun i => okL (a + i)

theorem chunk_sound {a b n : ℕ} (h : chunk a b = true) (h1 : a ≤ n) (h2 : n < b) : okL n = true := by
  have := List.all_eq_true.mp h (n - a) (List.mem_range.mpr (by omega))
  simpa [show a + (n - a) = n by omega] using this

