def isP (m p : ℕ) : Bool := 2 ≤ p && (List.range m).all fun d => d < 2 || p < d * d || p % d != 0

theorem isP_prime {m p : ℕ} (h : isP m p = true) (hp : p < m * m) : p.Prime := by
  simp only [isP, Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true, List.mem_range, Bool.or_eq_true,
    bne_iff_ne, ne_eq] at h
  by_contra hnp
  have hsq := Nat.minFac_sq_le_self (by omega) hnp
  have hd := Nat.minFac_dvd p
  have hm := (Nat.minFac_prime (by omega : p ≠ 1)).two_le
  have hlt : p.minFac < m := by nlinarith
  rcases h.2 _ hlt with (h3 | h3) | h3
  · omega
  · nlinarith
  · exact h3 (Nat.mod_eq_zero_of_dvd hd)

