theorem v0 : Nat.centralBinom 0 = c0 := by
  rw [Nat.centralBinom_zero]
  rfl

theorem v2480 : Nat.centralBinom 2480 = c2480 := by
  have h := cb_spec 2480 0 c0 c2480 v0.symm t2480
  exact h

theorem v4000 : Nat.centralBinom 4000 = c4000 := by
  have h := cb_spec 1520 2480 c2480 c4000 v2480.symm t4000
  exact h

theorem v8000 : Nat.centralBinom 8000 = c8000 := by
  have h := cb_spec 4000 4000 c4000 c8000 v4000.symm t8000
  exact h

theorem v8178 : Nat.centralBinom 8178 = c8178 := by
  have h := cb_spec 178 8000 c8000 c8178 v8000.symm t8178
  exact h

theorem v12000 : Nat.centralBinom 12000 = c12000 := by
  have h := cb_spec 3822 8178 c8178 c12000 v8178.symm t12000
  exact h

theorem v16000 : Nat.centralBinom 16000 = c16000 := by
  have h := cb_spec 4000 12000 c12000 c16000 v12000.symm t16000
