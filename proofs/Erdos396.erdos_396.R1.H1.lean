set_option maxRecDepth 100000 in
theorem w2 : Nat.descFactorial 2480 3 ∣ Nat.centralBinom 2480 := by
  have hd : Nat.descFactorial 2480 3 = 2480 * 2479 * 2478 := by
    simp [Nat.descFactorial]
  rw [hd, v2480]
  exact Nat.dvd_of_mod_eq_zero (by decide +kernel)

set_option maxRecDepth 100000 in
theorem w3 : Nat.descFactorial 8178 4 ∣ Nat.centralBinom 8178 := by
  have hd : Nat.descFactorial 8178 4 = 8178 * 8177 * 8176 * 8175 := by
    simp [Nat.descFactorial]
  rw [hd, v8178]
  exact Nat.dvd_of_mod_eq_zero (by decide +kernel)

set_option maxRecDepth 100000 in
theorem w4 : Nat.descFactorial 45153 5 ∣ Nat.centralBinom 45153 := by
  have hd : Nat.descFactorial 45153 5 = 45153 * 45152 * 45151 * 45150 * 45149 := by
    simp [Nat.descFactorial]
  rw [hd, v45153]
  exact Nat.dvd_of_mod_eq_zero (by decide +kernel)

theorem w0 : Nat.descFactorial 1 1 ∣ Nat.centralBinom 1 := by
  decide

theorem w1 : Nat.descFactorial 2 2 ∣ Nat.centralBinom 2 := by
  decide

theorem small (k : ℕ) (hk : k ≤ 4) : ∃ n : ℕ, Nat.descFactorial n (k + 1) ∣ Nat.centralBinom n := by
  interval_cases k
  · exact ⟨1, w0⟩
  · exact ⟨2, w1⟩
  · exact ⟨2480, w2⟩
  · exact ⟨8178, w3⟩
  · exact ⟨45153, w4⟩

end OMA.E396

theorem OMA.solution : OMA.R_Erdos396_erdos_396_R1.H1 := by
  intro k hk
  exact OMA.E396.small k hk
