import OMAReductions.R_Erdos396_erdos_396_R1

-- Erdős 396 for k <= 4: n (n - 1) ... (n - k) divides C(2n, n) for n = 1, 2, 2480, 8178, 45153 (k = 0, ..., 4).
-- These are the least witnesses (found by a direct search; the values 2480, 8178, 45153 are also listed on
-- erdosproblems.com/396). The proof here is original: the kernel runs the recurrence
-- (m + 1) C(2m + 2, m + 1) = 2 (2m + 1) C(2m, m) in blocks of 4000 steps between stored values of C(2m, m)
-- (cb, cb_spec, using Mathlib's Nat.succ_mul_centralBinom_succ), and then checks the divisibility.
-- Known examples, not progress on the question for general k.

namespace OMA.E396

/-- Run the recurrence `(m + 1) * centralBinom (m + 1) = 2 * (2 * m + 1) * centralBinom m` for `f`
steps from `(m, c)` and compare the result with `c'`. -/
def cb : ℕ → ℕ → ℕ → ℕ → Bool
  | 0, _, c, c' => decide (c = c')
  | f + 1, m, c, c' => cb f (m + 1) (2 * (2 * m + 1) * c / (m + 1)) c'

theorem cb_spec : ∀ (f m c c' : ℕ), c = Nat.centralBinom m → cb f m c c' = true →
    Nat.centralBinom (m + f) = c' := by
  intro f
  induction f with
  | zero =>
    intro m c c' hc h
    rw [cb, decide_eq_true_eq] at h
    rw [Nat.add_zero, ← hc, h]
  | succ f ih =>
    intro m c c' hc h
    rw [cb] at h
    have hstep : 2 * (2 * m + 1) * c / (m + 1) = Nat.centralBinom (m + 1) := by
      rw [hc, ← Nat.succ_mul_centralBinom_succ]
      exact Nat.mul_div_cancel_left _ (Nat.succ_pos m)
    have h2 := ih (m + 1) _ c' hstep h
    have e : m + 1 + f = m + (f + 1) := by omega
    rwa [e] at h2

