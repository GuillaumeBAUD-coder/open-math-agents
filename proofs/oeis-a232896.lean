import OMAStatements.S_oeis_a232896
import Mathlib.Data.Nat.Fib.Basic
import Mathlib.Data.Finset.Card
import Mathlib.Data.List.TakeDrop
import Mathlib.Data.Finset.Image
import Mathlib.Tactic.NormNum
import Mathlib.Tactic.Linarith

/-!
The first occurrence of 2d+1 follows exactly the full list through depth d-1.
Reachable odd values form an initial interval; reachable even values, divided
by two, form the bounded single-root tree generated by x+1 and 2x. Its binary
parity decomposition counts those values by Fibonacci numbers.

Source: Clark Kimberling's conjecture in https://oeis.org/A232896.
The unchanged statement was contributed by @KoaOkano.
Known related single-root generation count: Kimberling and Moses,
The infinite Fibonacci tree and other trees generated by rules,
Fibonacci Quarterly 52(5) (2014), 136–149, Corollary 2.2.
https://www.fq.math.ca/Papers1/52-5/Kimberling.pdf
Our target contribution is the exact two-root reachability and position bridge.
-/

namespace A232896Proof

def B : ℕ → Finset ℕ
  | 0 => {1}
  | 1 => {1, 2}
  | n + 2 => insert 1 ((B (n + 1)).image (fun x => 2 * x) ∪
      (B n).image (fun x => 2 * x + 1))

theorem mem_B_step {n x : ℕ} :
    x ∈ B (n + 2) ↔ x = 1 ∨
      (∃ y ∈ B (n + 1), 2 * y = x) ∨ (∃ y ∈ B n, 2 * y + 1 = x) := by
  rw [B]
  simp only [Finset.mem_insert, Finset.mem_union, Finset.mem_image]

theorem one_mem_B (n : ℕ) : 1 ∈ B n := by
  cases n with
  | zero => simp [B]
  | succ n =>
    cases n with
    | zero => simp [B]
    | succ n => exact mem_B_step.mpr (Or.inl rfl)

theorem B_pos {n x : ℕ} (hx : x ∈ B n) : 0 < x := by
  induction n using Nat.twoStepInduction generalizing x with
  | zero => simp only [B, Finset.mem_singleton] at hx; omega
  | one => simp only [B, Finset.mem_insert, Finset.mem_singleton] at hx; omega
  | more n h0 h1 =>
    rcases mem_B_step.mp hx with rfl | ⟨y, hy, rfl⟩ | ⟨y, hy, rfl⟩
    · omega
    · have := h1 hy; omega
    · omega

theorem B_subset_succ (n : ℕ) : B n ⊆ B (n + 1) := by
  induction n using Nat.twoStepInduction with
  | zero => decide
  | one => decide
  | more n h0 h1 =>
    intro x hx
    rcases mem_B_step.mp hx with rfl | ⟨y, hy, rfl⟩ | ⟨y, hy, rfl⟩
    · exact one_mem_B _
    · exact mem_B_step.mpr (Or.inr (Or.inl ⟨y, h1 hy, rfl⟩))
    · exact mem_B_step.mpr (Or.inr (Or.inr ⟨y, h0 hy, rfl⟩))

theorem B_mono : Monotone B := by
  exact monotone_nat_of_le_succ B_subset_succ

theorem double_mem_B {n x : ℕ} (hx : x ∈ B n) : 2 * x ∈ B (n + 1) := by
  cases n with
  | zero => simp only [B, Finset.mem_singleton] at hx; subst x; decide
  | succ n => exact mem_B_step.mpr (Or.inr (Or.inl ⟨x, hx, rfl⟩))

theorem odd_mem_B {n x : ℕ} (hx : x ∈ B n) : 2 * x + 1 ∈ B (n + 2) :=
  mem_B_step.mpr (Or.inr (Or.inr ⟨x, hx, rfl⟩))

theorem add_one_mem_B {n x : ℕ} (hx : x ∈ B n) : x + 1 ∈ B (n + 1) := by
  induction n using Nat.twoStepInduction generalizing x with
  | zero => simp only [B, Finset.mem_singleton] at hx; subst x; decide
  | one =>
    simp only [B, Finset.mem_insert, Finset.mem_singleton] at hx
    rcases hx with rfl | rfl <;> decide
  | more n h0 h1 =>
    rcases mem_B_step.mp hx with rfl | ⟨y, hy, rfl⟩ | ⟨y, hy, rfl⟩
    · exact double_mem_B (one_mem_B _)
    · exact odd_mem_B hy
    · have h := B_subset_succ (n + 2) (double_mem_B (h0 hy))
      convert h using 1; omega

theorem linear_mem_B (k : ℕ) : k + 1 ∈ B k := by
  induction k with
  | zero => exact one_mem_B 0
  | succ k ih => exact add_one_mem_B ih

theorem odd_small_mem_B {k n : ℕ} (h : k ≤ n) : 2 * k + 1 ∈ B (n + 1) := by
  cases k with
  | zero => simpa using one_mem_B (n + 1)
  | succ k => exact B_mono (by omega) (odd_mem_B (linear_mem_B k))

theorem B_succ_eq (n : ℕ) :
    B (n + 1) = insert 1 ((B n).image (fun x => x + 1) ∪
      (B n).image (fun x => 2 * x)) := by
  apply Finset.Subset.antisymm
  · intro x hx
    cases n with
    | zero => simpa [B] using hx
    | succ n =>
      rcases mem_B_step.mp hx with rfl | ⟨y, hy, rfl⟩ | ⟨y, hy, rfl⟩
      · exact Finset.mem_insert_self _ _
      · exact Finset.mem_insert_of_mem (Finset.mem_union_right _ (Finset.mem_image.mpr ⟨y, hy, rfl⟩))
      · exact Finset.mem_insert_of_mem (Finset.mem_union_left _
          (Finset.mem_image.mpr ⟨2 * y, double_mem_B hy, rfl⟩))
  · intro x hx
    simp only [Finset.mem_insert, Finset.mem_union, Finset.mem_image] at hx
    rcases hx with rfl | ⟨y, hy, rfl⟩ | ⟨y, hy, rfl⟩
    · exact one_mem_B _
    · exact add_one_mem_B hy
    · exact double_mem_B hy

theorem card_B_step (n : ℕ) :
    (B (n + 2)).card = (B (n + 1)).card + (B n).card + 1 := by
  have hd : Disjoint ((B (n + 1)).image (fun x => 2 * x))
      ((B n).image (fun x => 2 * x + 1)) := by
    apply Finset.disjoint_left.mpr
    intro x hx hy
    rcases Finset.mem_image.mp hx with ⟨u, hu, rfl⟩
    rcases Finset.mem_image.mp hy with ⟨v, hv, he⟩
    omega
  have hn : 1 ∉ ((B (n + 1)).image (fun x => 2 * x) ∪
      (B n).image (fun x => 2 * x + 1)) := by
    intro h
    rcases Finset.mem_union.mp h with h | h
    · rcases Finset.mem_image.mp h with ⟨u, hu, he⟩; omega
    · rcases Finset.mem_image.mp h with ⟨u, hu, he⟩
      have := B_pos hu
      omega
  rw [B, Finset.card_insert_of_notMem hn, Finset.card_union_of_disjoint hd]
  have hi : Function.Injective (fun x : ℕ => 2 * x) := by
    intro a b h
    change 2 * a = 2 * b at h
    omega
  have hj : Function.Injective (fun x : ℕ => 2 * x + 1) := by
    intro a b h
    change 2 * a + 1 = 2 * b + 1 at h
    omega
  rw [Finset.card_image_of_injective _ hi, Finset.card_image_of_injective _ hj]

theorem card_B (n : ℕ) : (B n).card + 1 = Nat.fib (n + 3) := by
  induction n using Nat.twoStepInduction with
  | zero => decide
  | one => decide
  | more n h0 h1 =>
    rw [card_B_step]
    have h1' : (B (n + 1)).card + 1 = Nat.fib (n + 4) := by
      simpa only [Nat.add_assoc] using h1
    have hf : Nat.fib (n + 5) = Nat.fib (n + 3) + Nat.fib (n + 4) := by
      simpa only [Nat.add_assoc] using (@Nat.fib_add_two (n + 3))
    change (B (n + 1)).card + (B n).card + 1 + 1 = Nat.fib (n + 5)
    omega

end A232896Proof

open OMA.S_oeis_a232896

namespace A232896Proof

theorem target_mem_through (d : ℕ) : 2*d+1 ∈ through d := by
  induction d with
  | zero => simp [through]
  | succ d ih =>
      simp only [through, List.mem_append, List.mem_flatMap]
      right
      refine ⟨2*d+1, ih, ?_⟩
      simp [children]
      omega

/-- An odd target first appears as the first child of its odd predecessor. -/
theorem takeWhile_children (xs : List ℕ) (d : ℕ) :
    (xs.flatMap children).takeWhile (fun y => decide (y ≠ 2*d+3)) =
      (xs.takeWhile (fun y => decide (y ≠ 2*d+1))).flatMap children := by
  induction xs with
  | nil => rfl
  | cons x xs ih =>
      by_cases hx : x = 2*d+1
      · subst x
        simp [children, List.flatMap_cons, show 2*d+1+2=2*d+3 by omega]
      · have he : 2*x ≠ 2*d+3 := by omega
        simp [children, List.flatMap_cons, hx, he]
        simpa using ih

/-- The whole previous breadth-first list occurs before the first new odd value. -/
theorem prefix_through (d : ℕ) :
    (through (d+1)).takeWhile (fun y => decide (y ≠ 2*(d+1)+1)) = through d := by
  induction d with
  | zero => norm_num [through, children]
  | succ d ih =>
      have h1 : (1 : ℕ) ≠ 2*(d+1+1)+1 := by omega
      have h2 : (2 : ℕ) ≠ 2*(d+1+1)+1 := by omega
      rw [show through (d+1+1) = [1,2] ++ (through (d+1)).flatMap children by rfl]
      simp only [List.cons_append, List.nil_append, List.takeWhile_cons, h1, h2,
        ne_eq, not_false_eq_true, decide_true, ite_true]
      rw [show 2*(d+1+1)+1 = 2*(d+1)+3 by omega, takeWhile_children]
      rw [ih]
      rfl

theorem position_succ (d : ℕ) :
    position (through (d+1)) (2*(d+1)+1) = (through d).toFinset.card+1 := by
  simp only [position, prefix_through]

end A232896Proof

open OMA.S_oeis_a232896

namespace A232896Proof

theorem mem_through_succ (n x : ℕ) :
    x ∈ through (n+1) ↔ x=1 ∨ x=2 ∨
      ∃ y ∈ through n, x=y+2 ∨ x=2*y := by
  simp [through, children]

/-- The two-root tree consists of an initial odd interval and twice the
bounded binary tree. This is the bridge absent from the known Fibonacci count. -/
theorem mem_through_iff (n x : ℕ) :
    x ∈ through n ↔ (∃ k ≤ n, x=2*k+1) ∨ (∃ y ∈ B n, x=2*y) := by
  induction n generalizing x with
  | zero =>
      constructor
      · intro hx
        simp only [through, List.mem_cons, List.not_mem_nil, or_false] at hx
        rcases hx with rfl | rfl
        · exact Or.inl ⟨0, le_rfl, by omega⟩
        · exact Or.inr ⟨1, one_mem_B 0, rfl⟩
      · rintro (⟨k, hk, rfl⟩ | ⟨y, hy, rfl⟩)
        · have : k=0 := by omega
          subst k
          simp [through]
        · have : y=1 := by simpa [B] using hy
          subst y
          simp [through]
  | succ n ih =>
      rw [mem_through_succ]
      constructor
      · rintro (rfl | rfl | ⟨y, hy, hxy⟩)
        · exact Or.inl ⟨0, by omega, by omega⟩
        · exact Or.inr ⟨1, one_mem_B (n+1), rfl⟩
        · rcases (ih y).mp hy with ⟨k, hk, rfl⟩ | ⟨z, hz, rfl⟩
          · rcases hxy with rfl | rfl
            · exact Or.inl ⟨k+1, by omega, by omega⟩
            · exact Or.inr ⟨2*k+1, odd_small_mem_B hk, rfl⟩
          · rcases hxy with rfl | rfl
            · exact Or.inr ⟨z+1, add_one_mem_B hz, by omega⟩
            · exact Or.inr ⟨2*z, double_mem_B hz, rfl⟩
      · rintro (⟨k, hk, rfl⟩ | ⟨y, hy, rfl⟩)
        · cases k with
          | zero => exact Or.inl rfl
          | succ k =>
              right; right
              exact ⟨2*k+1, (ih _).mpr (Or.inl ⟨k, by omega, rfl⟩),
                Or.inl (by omega)⟩
        · rw [B_succ_eq] at hy
          simp only [Finset.mem_insert, Finset.mem_union, Finset.mem_image] at hy
          rcases hy with rfl | ⟨z, hz, rfl⟩ | ⟨z, hz, rfl⟩
          · exact Or.inr (Or.inl rfl)
          · exact Or.inr (Or.inr ⟨2*z, (ih _).mpr (Or.inr ⟨z, hz, rfl⟩),
              Or.inl (by omega)⟩)
          · exact Or.inr (Or.inr ⟨2*z, (ih _).mpr (Or.inr ⟨z, hz, rfl⟩),
              Or.inr rfl⟩)

theorem through_finset (n : ℕ) :
    (through n).toFinset =
      (Finset.range (n+1)).image (fun k => 2*k+1) ∪ (B n).image (2*·) := by
  ext x
  simp only [List.mem_toFinset, mem_through_iff, Finset.mem_union,
    Finset.mem_image, Finset.mem_range]
  constructor
  · rintro (⟨k, hk, hx⟩ | ⟨y, hy, hx⟩)
    · exact Or.inl ⟨k, by omega, hx.symm⟩
    · exact Or.inr ⟨y, hy, hx.symm⟩
  · rintro (⟨k, hk, hx⟩ | ⟨y, hy, hx⟩)
    · exact Or.inl ⟨k, by omega, hx.symm⟩
    · exact Or.inr ⟨y, hy, hx.symm⟩

theorem card_through (n : ℕ) :
    (through n).toFinset.card = n+1+(B n).card := by
  rw [through_finset, Finset.card_union_of_disjoint]
  · rw [Finset.card_image_of_injective _ (by intro a b h; change 2*a+1=2*b+1 at h; omega),
      Finset.card_image_of_injective _ (by intro a b h; change 2*a=2*b at h; omega), Finset.card_range]
  · apply Finset.disjoint_left.mpr
    intro x hx hy
    obtain ⟨k, _, hk⟩ := Finset.mem_image.mp hx
    obtain ⟨y, _, hy⟩ := Finset.mem_image.mp hy
    omega

theorem position_eq_fib (d : ℕ) :
    position (through d) (2*d+1) = Nat.fib (d+2)+d := by
  cases d with
  | zero => norm_num [position, through]
  | succ d =>
      rw [position_succ, card_through]
      have h := card_B d
      convert (show d+1+(B d).card+1 = Nat.fib (d+3)+(d+1) by omega) using 1

end A232896Proof

namespace A232896Proof
open OMA.S_oeis_a232896

theorem term_eq (d : ℕ) : term d = (Nat.fib (d+2) : ℤ) + d := by
  induction d using Nat.strong_induction_on with
  | h d ih =>
    match d with
    | 0 => norm_num [term]
    | 1 => norm_num [term, Nat.fib_add_two]
    | 2 => norm_num [term, Nat.fib_add_two]
    | 3 => norm_num [term, Nat.fib_add_two]
    | k+4 =>
      rw [term, ih (k+3) (by omega), ih (k+2) (by omega),
        ih (k+1) (by omega), ih k (by omega)]
      have h4 := congrArg (fun z : ℕ => (z : ℤ)) (Nat.fib_add_two (n := k+2))
      have h5 := congrArg (fun z : ℕ => (z : ℤ)) (Nat.fib_add_two (n := k+3))
      have h6 := congrArg (fun z : ℕ => (z : ℤ)) (Nat.fib_add_two (n := k+4))
      norm_num only [Nat.add_assoc, Nat.reduceAdd, Nat.cast_add, Nat.cast_ofNat] at h4 h5 h6 ⊢
      linarith only [h4, h5, h6]

end A232896Proof

open OMA.S_oeis_a232896

namespace A232896Proof

theorem solution :
    ∀ d : ℕ, 2*d+1 ∈ through d ∧
      (position (through d) (2*d+1) : ℤ) = term d := by
  intro d
  refine ⟨target_mem_through d, ?_⟩
  rw [position_eq_fib, term_eq]
  exact Nat.cast_add _ _

end A232896Proof

theorem OMA.solution : type_of% @OMA.S_oeis_a232896.main := by
  exact A232896Proof.solution
