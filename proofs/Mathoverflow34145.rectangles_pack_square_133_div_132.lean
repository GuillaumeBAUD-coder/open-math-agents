import FormalConjectures.Mathoverflow.«34145»

/-!
The recent packing into a square of side 501/500 uses a finite packing and dyadic
shelves. For the square of side 133/132, only the first 511 certified placements
are needed. The remaining shelves lie above the unit square in a strip of height
1/256, which fits since 1 + 1/256 < 133/132.

The finite certificate and its checker are adapted from steveDOTdigital's PR #437.
The shelf proof is adapted from PR #402 and the gluing argument from PR #322.
-/

namespace OMA.FinitePacking

open Mathoverflow34145 Set

private structure Box where
  index : ℕ
  x : ℕ
  y : ℕ

-- All coordinates use this integer grid. The cell dimensions round the
-- exact side lengths up, and the verifier checks these bounds independently.
private def D : ℕ := 720720000000
private def Box.w (b : Box) := (D+b.index)/(b.index+1)
private def Box.h (b : Box) := (D+b.index+1)/(b.index+2)
private def Box.right (b : Box) := b.x+b.w
private def Box.top (b : Box) := b.y+b.h
private def Fits (b : Box) : Prop :=
  b.right ≤ D ∧ b.top ≤ D ∧ D ≤ b.w*(b.index+1) ∧ D ≤ b.h*(b.index+2)
private def Apart (a b : Box) : Prop :=
  (a.right ≤ b.x ∨ b.right ≤ a.x) ∨ (a.top ≤ b.y ∨ b.top ≤ a.y)

private instance : Std.Symm Apart where
  symm a b h := by
    rcases h with (h|h)|(h|h)
    exacts [Or.inl (Or.inr h), Or.inl (Or.inl h), Or.inr (Or.inr h), Or.inr (Or.inl h)]

-- Boxes are sorted by their left edge. Stop checking later boxes once the
-- current box ends to the left of the rest of the list.
private def clear (a : Box) : List Box → Bool
  | [] => true
  | b :: bs => if a.right ≤ b.x then true else
      decide (a.top ≤ b.y ∨ b.top ≤ a.y) && clear a bs

private def verify (xmin : ℕ) : List Box → Bool
  | [] => true
  | b :: bs => decide (xmin ≤ b.x ∧ b.right ≤ D ∧ b.top ≤ D ∧
      D ≤ b.w*(b.index+1) ∧ D ≤ b.h*(b.index+2)) && clear b bs && verify b.x bs

private def indices : List Box → ℕ
  | [] => 0
  | b :: bs => 2^b.index ||| indices bs

private lemma covered {xs : List Box} {n : ℕ} (h : (indices xs).testBit n = true) :
    ∃ b ∈ xs, b.index = n := by
  induction xs with
  | nil => simp [indices] at h
  | cons b bs ih =>
    simp only [indices, Nat.testBit_or, Nat.testBit_two_pow, Bool.or_eq_true, decide_eq_true_eq] at h
    rcases h with h | h
    · exact ⟨b, by simp, h⟩
    · obtain ⟨v,hv,eq⟩ := ih h
      exact ⟨v, List.mem_cons_of_mem _ hv, eq⟩

private lemma clear_sound (a : Box) {xs : List Box} (h : clear a xs = true)
    (sorted : xs.Pairwise (fun b c => b.x ≤ c.x)) : ∀ b ∈ xs, Apart a b := by
  induction xs with
  | nil => simp
  | cons b bs ih =>
    obtain ⟨first, rest⟩ := List.pairwise_cons.1 sorted
    intro c hc
    rw [clear] at h
    split at h
    · rename_i sep
      rcases List.mem_cons.1 hc with rfl | hc
      · exact Or.inl (Or.inl sep)
      · exact Or.inl (Or.inl (sep.trans (first c hc)))
    · obtain ⟨sep, ht⟩ := Bool.and_eq_true_iff.mp h
      rcases List.mem_cons.1 hc with rfl | hc
      · exact Or.inr (of_decide_eq_true sep)
      · exact ih ht rest c hc

private lemma sound {xs : List Box} {xmin : ℕ} (h : verify xmin xs = true) :
    (∀ b ∈ xs, xmin ≤ b.x ∧ Fits b) ∧
    xs.Pairwise (fun b c => b.x ≤ c.x) ∧ xs.Pairwise Apart := by
  induction xs generalizing xmin with
  | nil => simp
  | cons b bs ih =>
    obtain ⟨hh, tail⟩ := Bool.and_eq_true_iff.mp h
    obtain ⟨bounds, checks⟩ := Bool.and_eq_true_iff.mp hh
    have hb : xmin ≤ b.x ∧ Fits b := by
      unfold Fits
      exact of_decide_eq_true bounds
    obtain ⟨all, sorted, pairs⟩ := ih tail
    refine ⟨?_, List.pairwise_cons.2 ⟨fun c hc => (all c hc).1, sorted⟩,
      List.pairwise_cons.2 ⟨clear_sound b checks sorted, pairs⟩⟩
    intro c hc
    rcases List.mem_cons.1 hc with rfl | hc
    · exact hb
    · exact ⟨hb.1.trans (all c hc).1, (all c hc).2⟩

private noncomputable def scaled (u : ℕ) : ℝ := u / D

private lemma scaled_mono {u v : ℕ} (h : u ≤ v) : scaled u ≤ scaled v :=
  div_le_div_of_nonneg_right (by exact_mod_cast h) (Nat.cast_nonneg _)

private lemma scaled_add (u v : ℕ) : scaled (u+v) = scaled u + scaled v := by
  simp [scaled, Nat.cast_add, add_div]

private lemma from_certificate (xs : List Box) (checked : verify 0 xs = true)
    (ids : indices xs = 2^511-1) :
    ∃ f : Configuration, (∀ n < 511, (f.rect n).toSet ⊆ Icc 0 1 ×ˢ Icc 0 1) ∧
      ∀ m < 511, ∀ n < 511, m ≠ n →
        interior (f.rect m).toSet ∩ interior (f.rect n).toSet = ∅ := by
  classical
  obtain ⟨all, _, pair⟩ := sound checked
  have has (n : ℕ) (hn : n < 511) : ∃ b ∈ xs, b.index = n := by
    apply covered
    simpa only [ids, Nat.testBit_two_pow_sub_one, decide_eq_true_eq] using hn
  let pick (n : ℕ) : Box := if hn : n < 511 then (has n hn).choose else ⟨n,0,0⟩
  have spec (n : ℕ) (hn : n < 511) : pick n ∈ xs ∧ (pick n).index = n := by
    simpa only [pick, dif_pos hn] using (has n hn).choose_spec
  let f : Configuration := {
    rect n := ⟨1/(n+1), 1/(n+2), (scaled (pick n).x, scaled (pick n).y), 0⟩
    rect_width _ := rfl
    rect_height _ := rfl }
  have cell (n : ℕ) (hn : n < 511) : (f.rect n).toSet ⊆
      Icc (scaled (pick n).x) (scaled (pick n).right) ×ˢ
      Icc (scaled (pick n).y) (scaled (pick n).top) := by
    obtain ⟨hb,hi⟩ := spec n hn
    obtain ⟨_, _, hw, hh⟩ := (all _ hb).2
    rw [hi] at hw hh
    have Dpos : 0 < (D : ℝ) := by norm_num [D]
    have coord {k a t : ℝ} {v : ℕ} (hk : 0 < k) (size : (D : ℝ) ≤ v*k)
        (ht : t ∈ Icc 0 1) : a + (1/k)*t ∈ Icc a (a+scaled v) := by
      have hk' : 1/k ≤ scaled v := (div_le_div_iff₀ hk Dpos).2 (by simpa using size)
      exact ⟨le_add_of_nonneg_right (mul_nonneg (by positivity) ht.1),
        add_le_add_right ((mul_le_of_le_one_right (by positivity) ht.2).trans hk') a⟩
    rintro _ ⟨_, ⟨p, hp, rfl⟩, rfl⟩
    change 0 ≤ p.1 ∧ p.1 ≤ 1 ∧ 0 ≤ p.2 ∧ p.2 ≤ 1 at hp
    simp only [f, rigidMotion, scale, Real.Angle.cos_zero, Real.Angle.sin_zero, mul_one,
      mul_zero, sub_zero, add_zero, Box.right, Box.top, scaled_add]
    have hw' : (D : ℝ) ≤ ((pick n).w : ℝ) * ((n : ℝ)+1) := by exact_mod_cast hw
    have hh' : (D : ℝ) ≤ ((pick n).h : ℝ) * ((n : ℝ)+2) := by exact_mod_cast hh
    exact ⟨coord (k := (n : ℝ)+1) (add_pos_of_nonneg_of_pos (Nat.cast_nonneg n) zero_lt_one) hw' ⟨hp.1,hp.2.1⟩,
      coord (k := (n : ℝ)+2) (add_pos_of_nonneg_of_pos (Nat.cast_nonneg n) (by norm_num : (0 : ℝ) < 2)) hh' hp.2.2⟩
  refine ⟨f, ?_, ?_⟩
  · intro n hn p hp
    obtain ⟨hx, hy⟩ := cell n hn hp
    obtain ⟨xr,yt,_,_⟩ := (all _ (spec n hn).1).2
    have one : scaled D = 1 := by norm_num [scaled,D]
    have nonneg (u : ℕ) : 0 ≤ scaled u := div_nonneg (Nat.cast_nonneg _) (Nat.cast_nonneg _)
    exact ⟨⟨(nonneg _).trans hx.1, one ▸ hx.2.trans (scaled_mono xr)⟩,
      ⟨(nonneg _).trans hy.1, one ▸ hy.2.trans (scaled_mono yt)⟩⟩
  · intro m hm n hn hmn
    have different : pick m ≠ pick n := fun e =>
      hmn ((spec m hm).2.symm.trans ((congrArg Box.index e).trans (spec n hn).2))
    have sep := pair.forall (spec m hm).1 (spec n hn).1 different
    apply Set.eq_empty_iff_forall_notMem.2
    intro p hp
    have hm' := interior_mono (cell m hm) hp.1
    have hn' := interior_mono (cell n hn) hp.2
    simp only [interior_prod_eq, interior_Icc] at hm' hn'
    rcases sep with (h|h)|(h|h)
    · exact (scaled_mono h).not_gt (hn'.1.1.trans hm'.1.2)
    · exact (scaled_mono h).not_gt (hm'.1.1.trans hn'.1.2)
    · exact (scaled_mono h).not_gt (hn'.2.1.trans hm'.2.2)
    · exact (scaled_mono h).not_gt (hm'.2.1.trans hn'.2.2)

