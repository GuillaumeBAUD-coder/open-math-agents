theorem relaxed_of_finGoal {n : ℕ} : finGoal n → relaxedGoal n := by
  rintro ⟨P, z, hP, hz10, hpal, hlen, hdvd, hσ⟩
  exact ⟨P, z, hP, fun hz => dvd10_of_tz_pos (hz10 ▸ hz), hpal,
    hlen, hdvd, hσ⟩


