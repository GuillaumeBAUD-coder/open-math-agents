import OMAReductions.R_Erdos1160_erdos_1160_variants_sum_R1_H2_R1
import Mathlib

-- Step Erdos1160.erdos_1160.variants.sum.R1.H2.R1.H1: hypothesis H1 of reduction Erdos1160.erdos_1160.variants.sum.R1.H2.R1
-- Credit: @OrangeHeadz
-- H1 := ∀ᶠ m : ℕ in atTop, 2 ^ (2 * m^3) ≤ g (2^m)^27 * 2 ^ (13 * m^2)
--
-- Higman's lower bound (1960) for the number of groups of order 2^m, by an explicit family.
-- For c : Sym2 (Fin r) → F_2^t we put a group structure on F_2^r × F_2^t,
--   (x, z) * (y, w) = (x + y, z + w + B_c(x, y)),   B_c(x, y) = sum over i ≤ j of x_i y_j c_{ij}.
-- If the values of c span F_2^t (equivalently: the squares generate 0 × F_2^t), an isomorphism between two
-- such groups is governed by a pair of additive maps (A, C) with B_c(A x, A x) = C (B_c0(x, x)), and A, C are
-- determined by their values on the standard basis. So each isomorphism class contains at most 2^(r^2 + t^2)
-- spanning parameters, while there are at least 2^(D t - 1) of them, D = r (r + 1) / 2.

open Filter CategoryTheory Erdos1160

namespace OMA.Hig

abbrev V (n : ℕ) := Fin n → ZMod 2

lemma add_self_V {n : ℕ} (x : V n) : x + x = 0 := by
  funext i
  exact CharTwo.add_self_eq_zero (x i)

/-- The bilinear map attached to a parameter. -/
def bet {r t : ℕ} (c : Sym2 (Fin r) → V t) (x y : V r) : V t :=
  ∑ i, ∑ j, if i ≤ j then (x i * y j) • c (s(i, j)) else 0

lemma bet_add_left {r t : ℕ} (c : Sym2 (Fin r) → V t) (x x' y : V r) :
    bet c (x + x') y = bet c x y + bet c x' y := by
  simp only [bet, Pi.add_apply, add_mul, add_smul]
  rw [← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun j _ => ?_
  split_ifs <;> simp

lemma bet_add_right {r t : ℕ} (c : Sym2 (Fin r) → V t) (x y y' : V r) :
    bet c x (y + y') = bet c x y + bet c x y' := by
  simp only [bet, Pi.add_apply, mul_add, add_smul]
  rw [← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun j _ => ?_
  split_ifs <;> simp

lemma bet_zero_left {r t : ℕ} (c : Sym2 (Fin r) → V t) (y : V r) : bet c 0 y = 0 := by
  simp [bet]

lemma bet_zero_right {r t : ℕ} (c : Sym2 (Fin r) → V t) (x : V r) : bet c x 0 = 0 := by
  simp [bet]

lemma bet_single {r t : ℕ} (c : Sym2 (Fin r) → V t) (a b : Fin r) :
    bet c (Pi.single a 1) (Pi.single b 1) = if a ≤ b then c (s(a, b)) else 0 := by
  unfold bet
  rw [Finset.sum_eq_single a, Finset.sum_eq_single b]
  · simp
  · intro j _ hj
    simp [hj]
  · simp
  · intro i _ hi
    simp [Pi.single_apply, hi]
  · simp

/-- The twisted product. -/
structure Tw (r t : ℕ) (c : Sym2 (Fin r) → V t) where
  a : V r
  z : V t

variable {r t : ℕ} {c : Sym2 (Fin r) → V t}

lemma Tw.ext' {p q : Tw r t c} (h1 : p.a = q.a) (h2 : p.z = q.z) : p = q := by
  obtain ⟨a, z⟩ := p
  obtain ⟨a', z'⟩ := q
  simp only at h1 h2
  subst h1
  subst h2
  rfl

instance : Mul (Tw r t c) := ⟨fun p q => ⟨p.a + q.a, p.z + q.z + bet c p.a q.a⟩⟩
instance : One (Tw r t c) := ⟨⟨0, 0⟩⟩
instance : Inv (Tw r t c) := ⟨fun p => ⟨p.a, p.z + bet c p.a p.a⟩⟩

@[simp] lemma mul_a (p q : Tw r t c) : (p * q).a = p.a + q.a := rfl
@[simp] lemma mul_z (p q : Tw r t c) : (p * q).z = p.z + q.z + bet c p.a q.a := rfl
@[simp] lemma one_a : (1 : Tw r t c).a = 0 := rfl
@[simp] lemma one_z : (1 : Tw r t c).z = 0 := rfl
@[simp] lemma inv_a (p : Tw r t c) : (p⁻¹).a = p.a := rfl
@[simp] lemma inv_z (p : Tw r t c) : (p⁻¹).z = p.z + bet c p.a p.a := rfl

instance : Group (Tw r t c) := Group.ofLeftAxioms
  (by
    intro p q u
    apply Tw.ext'
    · simp [add_assoc]
    · simp only [mul_a, mul_z, bet_add_left, bet_add_right]
      abel)
  (by
    intro p
    apply Tw.ext'
    · simp
    · simp [bet_zero_left])
  (by
    intro p
    apply Tw.ext'
    · simp [add_self_V]
    · simp only [mul_z, inv_z, inv_a, one_z]
      rw [add_assoc]
      exact add_self_V _)

def Tw.equivProd : Tw r t c ≃ V r × V t where
  toFun p := (p.a, p.z)
  invFun q := ⟨q.1, q.2⟩
  left_inv p := by cases p; rfl
  right_inv q := rfl

instance : Finite (Tw r t c) := Finite.of_equiv _ (Tw.equivProd (c := c)).symm

lemma card_Tw : Nat.card (Tw r t c) = 2 ^ (r + t) := by
  rw [Nat.card_congr (Tw.equivProd (c := c)), Nat.card_prod]
  simp [Nat.card_eq_fintype_card, pow_add]

/-- The subgroup of elements with trivial first coordinate. -/
def Zs (c : Sym2 (Fin r) → V t) : Subgroup (Tw r t c) where
  carrier := {p | p.a = 0}
  mul_mem' := by
    intro p q hp hq
    simp only [Set.mem_ofPred_eq] at hp hq ⊢
    simp [hp, hq]
  one_mem' := rfl
  inv_mem' := by
    intro p hp
    exact hp

/-- The subgroup generated by the squares. -/
def Sq (c : Sym2 (Fin r) → V t) : Subgroup (Tw r t c) :=
  Subgroup.closure (Set.range fun g : Tw r t c => g * g)

lemma Sq_a {g : Tw r t c} (hg : g ∈ Sq c) : g.a = 0 := by
  have h : Sq c ≤ Zs c := by
    refine (Subgroup.closure_le _).2 ?_
    rintro _ ⟨y, rfl⟩
    exact add_self_V _
  exact h hg

lemma map_Sq {c0 : Sym2 (Fin r) → V t} (e : Tw r t c0 →* Tw r t c) {g : Tw r t c0}
    (hg : g ∈ Sq c0) : e g ∈ Sq c := by
  have h : Sq c0 ≤ (Sq c).comap e := by
    refine (Subgroup.closure_le _).2 ?_
    rintro _ ⟨y, rfl⟩
    refine Subgroup.subset_closure ⟨e y, ?_⟩
    simp
  exact h hg

/-- The squares generate the second factor. -/
def Full (c : Sym2 (Fin r) → V t) : Prop := ∀ z : V t, (⟨0, z⟩ : Tw r t c) ∈ Sq c

lemma e_a_zero {c0 : Sym2 (Fin r) → V t} (h0 : Full c0) (e : Tw r t c0 →* Tw r t c) (z : V t) :
    (e ⟨0, z⟩).a = 0 := Sq_a (map_Sq e (h0 z))

lemma A_add {c0 : Sym2 (Fin r) → V t} (h0 : Full c0) (e : Tw r t c0 →* Tw r t c) (x y : V r) :
    (e ⟨x + y, 0⟩).a = (e ⟨x, 0⟩).a + (e ⟨y, 0⟩).a := by
  have h : ((⟨x, 0⟩ : Tw r t c0) * ⟨y, 0⟩) = ⟨x + y, 0⟩ * ⟨0, bet c0 x y⟩ := by
    apply Tw.ext'
    · simp
    · simp [bet_zero_right]
  have h2 := congrArg (fun g => (e g).a) h
  simp only [map_mul, mul_a, e_a_zero h0 e, add_zero] at h2
  exact h2.symm

lemma C_add {c0 : Sym2 (Fin r) → V t} (h0 : Full c0) (e : Tw r t c0 →* Tw r t c) (z w : V t) :
    (e ⟨0, z + w⟩).z = (e ⟨0, z⟩).z + (e ⟨0, w⟩).z := by
  have h : ((⟨0, z⟩ : Tw r t c0) * ⟨0, w⟩) = ⟨0, z + w⟩ := by
    apply Tw.ext'
    · simp
    · simp [bet_zero_right]
  have h2 := congrArg (fun g => (e g).z) h
  simp only [map_mul, mul_z, e_a_zero h0 e, bet_zero_right, add_zero] at h2
  exact h2.symm

lemma A_surj {c0 : Sym2 (Fin r) → V t} (h0 : Full c0) (e : Tw r t c0 ≃* Tw r t c) (y : V r) :
    ∃ x : V r, (e ⟨x, 0⟩).a = y := by
  refine ⟨(e.symm ⟨y, 0⟩).a, ?_⟩
  have h : e.symm ⟨y, 0⟩ = (⟨(e.symm ⟨y, 0⟩).a, 0⟩ : Tw r t c0) * ⟨0, (e.symm ⟨y, 0⟩).z⟩ := by
    apply Tw.ext'
    · simp
    · simp [bet_zero_right]
  have h2 := congrArg (fun g => (e g).a) h
  simp only [map_mul, mul_a, MulEquiv.apply_symm_apply] at h2
  have h3 := e_a_zero h0 e.toMonoidHom (e.symm ⟨y, 0⟩).z
  simp only [MulEquiv.toMonoidHom_eq_coe, MonoidHom.coe_coe] at h3
  rw [h3, add_zero] at h2
  exact h2.symm

lemma sq_rel {c0 : Sym2 (Fin r) → V t} (e : Tw r t c0 →* Tw r t c) (x : V r) :
    bet c (e ⟨x, 0⟩).a (e ⟨x, 0⟩).a = (e ⟨0, bet c0 x x⟩).z := by
  have h : ((⟨x, 0⟩ : Tw r t c0) * ⟨x, 0⟩) = ⟨0, bet c0 x x⟩ := by
    apply Tw.ext'
    · simp [add_self_V]
    · simp
  have h2 := congrArg (fun g => (e g).z) h
  simp only [map_mul, mul_z, add_self_V, zero_add] at h2
  exact h2

lemma additive_det {n : ℕ} {M : Type*} [AddCommGroup M] (f g : V n → M)
    (hf : ∀ x y, f (x + y) = f x + f y) (hg : ∀ x y, g (x + y) = g x + g y)
    (h : ∀ i, f (Pi.single i 1) = g (Pi.single i 1)) : f = g := by
  have hf0 : f 0 = 0 := by
    have h0 := hf 0 0
    simpa using h0
  have hg0 : g 0 = 0 := by
    have h0 := hg 0 0
    simpa using h0
  have key : AddMonoidHom.mk' f hf = AddMonoidHom.mk' g hg := by
    apply AddMonoidHom.functions_ext
    intro i x
    have hx : ∀ b : ZMod 2, b = 0 ∨ b = 1 := by decide
    rcases hx x with rfl | rfl
    · simp [hf0, hg0]
    · exact h i
  funext x
  exact DFunLike.congr_fun key x

lemma bet_pair (c : Sym2 (Fin r) → V t) (i j : Fin r) (hij : i < j) :
    bet c (Pi.single i 1 + Pi.single j 1) (Pi.single i 1 + Pi.single j 1) =
      c (s(i, i)) + c (s(i, j)) + c (s(j, j)) := by
  rw [bet_add_left, bet_add_right, bet_add_right, bet_single, bet_single, bet_single, bet_single]
  simp only [le_refl, if_true, hij.le, not_le.mpr hij, if_false, zero_add]

lemma bet_diag_inj {c c' : Sym2 (Fin r) → V t} (h : ∀ x, bet c x x = bet c' x x) : c = c' := by
  have hd : ∀ i, c (s(i, i)) = c' (s(i, i)) := by
    intro i
    have := h (Pi.single i 1)
    simpa [bet_single] using this
  have hlt : ∀ i j, i < j → c (s(i, j)) = c' (s(i, j)) := by
    intro i j hij
    have h1 := h (Pi.single i 1 + Pi.single j 1)
    rw [bet_pair c i j hij, bet_pair c' i j hij, hd i, hd j] at h1
    exact add_left_cancel (add_right_cancel h1)
  funext p
  induction p using Sym2.ind with
  | _ i j =>
    rcases lt_trichotomy i j with hij | rfl | hij
    · exact hlt i j hij
    · exact hd i
    · rw [Sym2.eq_swap]
      exact hlt j i hij

lemma fibre_inj {c0 c c' : Sym2 (Fin r) → V t} (h0 : Full c0)
    (e : Tw r t c0 ≃* Tw r t c) (e' : Tw r t c0 ≃* Tw r t c')
    (hA : ∀ i, (e ⟨Pi.single i 1, 0⟩).a = (e' ⟨Pi.single i 1, 0⟩).a)
    (hC : ∀ j, (e ⟨0, Pi.single j 1⟩).z = (e' ⟨0, Pi.single j 1⟩).z) : c = c' := by
  have hAA : (fun x : V r => (e ⟨x, 0⟩).a) = fun x : V r => (e' ⟨x, 0⟩).a :=
    additive_det _ _ (A_add h0 e.toMonoidHom) (A_add h0 e'.toMonoidHom) hA
  have hCC : (fun z : V t => (e ⟨0, z⟩).z) = fun z : V t => (e' ⟨0, z⟩).z :=
    additive_det _ _ (C_add h0 e.toMonoidHom) (C_add h0 e'.toMonoidHom) hC
  apply bet_diag_inj
  intro y
  obtain ⟨x, rfl⟩ := A_surj h0 e y
  have h1 := sq_rel e.toMonoidHom x
  have h2 := sq_rel e'.toMonoidHom x
  have h3 : (e ⟨x, 0⟩).a = (e' ⟨x, 0⟩).a := congrFun hAA x
  have h4 : (e ⟨0, bet c0 x x⟩).z = (e' ⟨0, bet c0 x x⟩).z := congrFun hCC (bet c0 x x)
  simp only [MulEquiv.toMonoidHom_eq_coe, MonoidHom.coe_coe] at h1 h2
  rw [h1, h3, h2, h4]

lemma cancel3 {n : ℕ} (u v w : V n) : u + v + w + u + w = v := by
  have h : u + v + w + u + w = v + (u + u) + (w + w) := by abel
  rw [h, add_self_V, add_self_V, add_zero, add_zero]

/-- Second coordinates reachable by products of squares. -/
def Tsub (c : Sym2 (Fin r) → V t) : AddSubgroup (V t) where
  carrier := {z | (⟨0, z⟩ : Tw r t c) ∈ Sq c}
  zero_mem' := (Sq c).one_mem
  add_mem' := by
    intro z w hz hw
    have h : ((⟨0, z⟩ : Tw r t c) * ⟨0, w⟩) = ⟨0, z + w⟩ := by
      apply Tw.ext'
      · simp
      · simp [bet_zero_right]
    simp only [Set.mem_ofPred_eq] at hz hw ⊢
    rw [← h]
    exact (Sq c).mul_mem hz hw
  neg_mem' := by
    intro z hz
    have hneg : -z = z := by
      funext i
      exact ZMod.neg_eq_self_mod_two (z i)
    simp only [Set.mem_ofPred_eq] at hz ⊢
    rw [hneg]
    exact hz

lemma sq_mem_Tsub (c : Sym2 (Fin r) → V t) (x : V r) : bet c x x ∈ Tsub c := by
  have h : ((⟨x, 0⟩ : Tw r t c) * ⟨x, 0⟩) = ⟨0, bet c x x⟩ := by
    apply Tw.ext'
    · simp [add_self_V]
    · simp
  change (⟨0, bet c x x⟩ : Tw r t c) ∈ Sq c
  rw [← h]
  exact Subgroup.subset_closure ⟨_, rfl⟩

lemma c_mem_Tsub (c : Sym2 (Fin r) → V t) (p : Sym2 (Fin r)) : c p ∈ Tsub c := by
  have hd : ∀ i, c (s(i, i)) ∈ Tsub c := by
    intro i
    have h := sq_mem_Tsub c (Pi.single i 1)
    rw [bet_single] at h
    simpa using h
  have hlt : ∀ i j, i < j → c (s(i, j)) ∈ Tsub c := by
    intro i j hij
    have h := sq_mem_Tsub c (Pi.single i 1 + Pi.single j 1)
    rw [bet_pair c i j hij] at h
    have h2 := (Tsub c).add_mem ((Tsub c).add_mem h (hd i)) (hd j)
    rwa [cancel3] at h2
  induction p using Sym2.ind with
  | _ i j =>
    rcases lt_trichotomy i j with hij | rfl | hij
    · exact hlt i j hij
    · exact hd i
    · rw [Sym2.eq_swap]
      exact hlt j i hij

lemma exists_orth (c : Sym2 (Fin r) → V t) (hc : ¬ Full c) :
    ∃ w : V t, w ≠ 0 ∧ ∀ p, w ⬝ᵥ c p = 0 := by
  have hlt : (Tsub c).toZModSubmodule 2 < ⊤ := by
    rw [lt_top_iff_ne_top]
    intro htop
    apply hc
    intro z
    have hz : z ∈ (Tsub c).toZModSubmodule 2 := by
      rw [htop]
      trivial
    exact hz
  obtain ⟨f, hf, hle⟩ := Submodule.exists_le_ker_of_lt_top _ hlt
  have hval : ∀ (j : Fin t) (a : ZMod 2), f (Pi.single j a) = f (Pi.single j 1) * a := by
    intro j a
    have ha : ∀ b : ZMod 2, b = 0 ∨ b = 1 := by decide
    rcases ha a with rfl | rfl
    · simp
    · simp
  have hfz : ∀ z : V t, f z = (fun j => f (Pi.single j 1)) ⬝ᵥ z := by
    intro z
    conv_lhs => rw [← Finset.univ_sum_single z]
    rw [map_sum]
    simp only [dotProduct]
    exact Finset.sum_congr rfl (fun j _ => hval j (z j))
  refine ⟨fun j => f (Pi.single j 1), ?_, ?_⟩
  · intro hw
    apply hf
    apply LinearMap.ext
    intro z
    rw [hfz z, hw]
    simp
  · intro p
    rw [← hfz]
    have hp : c p ∈ (Tsub c).toZModSubmodule 2 := c_mem_Tsub c p
    exact hle hp

lemma card_orth (w : V t) (hw : w ≠ 0) :
    2 * (Finset.univ.filter fun z : V t => w ⬝ᵥ z = 0).card ≤ 2 ^ t := by
  classical
  obtain ⟨j, hj⟩ : ∃ j, w j ≠ 0 := by
    by_contra h
    exact hw (funext fun j => by
      by_contra hne
      exact h ⟨j, hne⟩)
  have hj1 : w j = 1 := by
    have ha : ∀ a : ZMod 2, a ≠ 0 → a = 1 := by decide
    exact ha _ hj
  have h1 : (Finset.univ.filter fun z : V t => w ⬝ᵥ z = 0).card ≤
      (Finset.univ.filter fun z : V t => ¬ w ⬝ᵥ z = 0).card := by
    apply Finset.card_le_card_of_injOn (fun z => z + Pi.single j 1)
    · intro z hz
      simp only [Finset.coe_filter, Finset.mem_univ, true_and, Set.mem_ofPred_eq] at hz ⊢
      rw [dotProduct_add, hz, dotProduct_single, hj1]
      simp
    · intro a _ b _ hab
      exact add_right_cancel hab
  have h2 : (Finset.univ.filter fun z : V t => w ⬝ᵥ z = 0).card +
      (Finset.univ.filter fun z : V t => ¬ w ⬝ᵥ z = 0).card = 2 ^ t := by
    rw [Finset.card_filter_add_card_filter_not]
    simp
  omega

lemma card_full (r t : ℕ) (ht : 1 ≤ t) (hD : t + 1 ≤ (r + 1).choose 2)
    (P : Finset (Sym2 (Fin r) → V t)) (hP : ∀ c, c ∈ P ↔ Full c) :
    2 ^ ((r + 1).choose 2 * t - 1) ≤ P.card := by
  classical
  have hcompl : Pᶜ ⊆ (Finset.univ.filter fun w : V t => w ≠ 0).biUnion
      (fun w => Fintype.piFinset fun _ : Sym2 (Fin r) =>
        Finset.univ.filter fun z : V t => w ⬝ᵥ z = 0) := by
    intro c hc
    rw [Finset.mem_compl, hP] at hc
    obtain ⟨w, hw, hwc⟩ := exists_orth c hc
    simp only [Finset.mem_biUnion, Finset.mem_filter, Finset.mem_univ, true_and,
      Fintype.mem_piFinset]
    exact ⟨w, hw, hwc⟩
  have h2t : 2 ^ t = 2 * 2 ^ (t - 1) := by
    rw [← pow_succ']
    congr 1
    omega
  have hK : ∀ w ∈ (Finset.univ.filter fun w : V t => w ≠ 0),
      (Fintype.piFinset fun _ : Sym2 (Fin r) =>
        Finset.univ.filter fun z : V t => w ⬝ᵥ z = 0).card ≤ (2 ^ (t - 1)) ^ ((r + 1).choose 2) := by
    intro w hw
    rw [Fintype.card_piFinset, Finset.prod_const, Finset.card_univ, Sym2.card, Fintype.card_fin]
    apply Nat.pow_le_pow_left
    have h := card_orth w (by simpa using hw)
    omega
  have hc1 : Pᶜ.card ≤ 2 ^ t * (2 ^ (t - 1)) ^ ((r + 1).choose 2) := by
    calc Pᶜ.card ≤ _ := Finset.card_le_card hcompl
      _ ≤ ∑ w ∈ (Finset.univ.filter fun w : V t => w ≠ 0),
            (Fintype.piFinset fun _ : Sym2 (Fin r) =>
              Finset.univ.filter fun z : V t => w ⬝ᵥ z = 0).card := Finset.card_biUnion_le
      _ ≤ ∑ _w ∈ (Finset.univ.filter fun w : V t => w ≠ 0),
            (2 ^ (t - 1)) ^ ((r + 1).choose 2) := Finset.sum_le_sum hK
      _ = (Finset.univ.filter fun w : V t => w ≠ 0).card * (2 ^ (t - 1)) ^ ((r + 1).choose 2) := by
          rw [Finset.sum_const, smul_eq_mul]
      _ ≤ 2 ^ t * (2 ^ (t - 1)) ^ ((r + 1).choose 2) := by
          apply Nat.mul_le_mul_right
          calc (Finset.univ.filter fun w : V t => w ≠ 0).card
              ≤ (Finset.univ : Finset (V t)).card := Finset.card_filter_le _ _
            _ = 2 ^ t := by simp
  have htot : P.card + Pᶜ.card = 2 ^ ((r + 1).choose 2 * t) := by
    rw [Finset.card_add_card_compl]
    simp [Sym2.card, ← pow_mul, mul_comm]
  have hpow : 2 ^ t * (2 ^ (t - 1)) ^ ((r + 1).choose 2) ≤ 2 ^ ((r + 1).choose 2 * t - 1) := by
    rw [← pow_mul, ← pow_add]
    apply Nat.pow_le_pow_right (by norm_num)
    obtain ⟨u, rfl⟩ : ∃ u, t = u + 1 := ⟨t - 1, by omega⟩
    simp only [Nat.add_sub_cancel]
    have h3 : (r + 1).choose 2 * (u + 1) = u * (r + 1).choose 2 + (r + 1).choose 2 := by ring
    omega
  have hpos : 1 ≤ (r + 1).choose 2 * t := Nat.mul_pos (by omega) (by omega)
  have h2 : 2 ^ ((r + 1).choose 2 * t) = 2 * 2 ^ ((r + 1).choose 2 * t - 1) := by
    rw [← pow_succ']
    congr 1
    omega
  omega

lemma choose_two_mul (n : ℕ) : (n + 1).choose 2 * 2 = n * (n + 1) := by
  induction n with
  | zero => simp
  | succ k ih =>
    have h : (k + 1 + 1).choose 2 = (k + 1) + (k + 1).choose 2 := by
      rw [Nat.choose_succ_succ' (k + 1) 1, Nat.choose_one_right]
    rw [h, add_mul, ih]
    ring

lemma final_arith (G a b x y : ℕ) (h : 2 ^ a ≤ 2 ^ b * G) (hn : x + 27 * b ≤ 27 * a + y) :
    2 ^ x ≤ G ^ 27 * 2 ^ y := by
  have h1 : 2 ^ (x + 27 * b) ≤ 2 ^ (27 * a + y) := Nat.pow_le_pow_right (by norm_num) hn
  have h2 : (2 ^ a) ^ 27 ≤ (2 ^ b * G) ^ 27 := Nat.pow_le_pow_left h 27
  have h4 : 2 ^ (27 * b) * 2 ^ x ≤ 2 ^ (27 * b) * (G ^ 27 * 2 ^ y) := by
    calc 2 ^ (27 * b) * 2 ^ x = 2 ^ (x + 27 * b) := by ring
      _ ≤ 2 ^ (27 * a + y) := h1
      _ = (2 ^ a) ^ 27 * 2 ^ y := by ring
      _ ≤ (2 ^ b * G) ^ 27 * 2 ^ y := Nat.mul_le_mul_right _ h2
      _ = 2 ^ (27 * b) * (G ^ 27 * 2 ^ y) := by ring
  exact Nat.le_of_mul_le_mul_left h4 (by positivity)

lemma finite_order_classes (n : ℕ) :
    (Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) ''
      {G : FiniteGrp.{0} | Nat.card G = n}).Finite := by
  let _ : Finite (Group (Fin n)) :=
    Finite.of_injective (fun h : Group (Fin n) => h.mul) (fun _ _ h => Group.ext h)
  let q := Quotient.mk (isIsomorphicSetoid FiniteGrp.{0})
  let code (h : Group (Fin n)) := let _ := h; q (FiniteGrp.of (Fin n))
  apply (Set.finite_range code).subset
  rintro _ ⟨G, hG, rfl⟩
  let _ := Fintype.ofFinite G
  have hh : Fintype.card G = n := (Nat.card_eq_fintype_card (α := G)).symm.trans hG
  let e : Fin n ≃ G := (Fintype.equivFinOfCardEq hh).symm
  let h := e.group
  let _ := h
  let K : FiniteGrp := FiniteGrp.of (Fin n)
  let eg : K ≃* G := e.mulEquiv
  exact ⟨h, Quotient.sound ⟨InducedCategory.isoMk (F := FiniteGrp.toGrp)
    (MulEquiv.toGrpIso (X := K.toGrp) (Y := G.toGrp) eg)⟩⟩

/-- The isomorphism class of the twisted product. -/
noncomputable def cls (c : Sym2 (Fin r) → V t) : Quotient (isIsomorphicSetoid FiniteGrp.{0}) :=
  Quotient.mk _ (FiniteGrp.of (Tw r t c))

lemma equiv_of_cls {c0 c : Sym2 (Fin r) → V t} (h : cls c0 = cls c) :
    Nonempty (Tw r t c0 ≃* Tw r t c) := by
  obtain ⟨i⟩ := Quotient.exact h
  let f : Tw r t c0 →* Tw r t c := ConcreteCategory.hom i.hom
  let g : Tw r t c →* Tw r t c0 := ConcreteCategory.hom i.inv
  exact ⟨{ toFun := f
           invFun := g
           left_inv := fun x => i.hom_inv_id_apply x
           right_inv := fun x => i.inv_hom_id_apply x
           map_mul' := f.map_mul }⟩

lemma main_count (r t : ℕ) (ht : 1 ≤ t) (hD : t + 1 ≤ (r + 1).choose 2) :
    2 ^ ((r + 1).choose 2 * t - 1) ≤ 2 ^ (r * r + t * t) * g (2 ^ (r + t)) := by
  classical
  let P : Finset (Sym2 (Fin r) → V t) := Finset.univ.filter Full
  have h1 := card_full r t ht hD P (by intro c; simp [P])
  have h2 : (P.image cls).card ≤ g (2 ^ (r + t)) := by
    unfold g
    rw [← Set.ncard_coe_finset]
    apply Set.ncard_le_ncard _ (finite_order_classes _)
    intro x hx
    simp only [Finset.coe_image, Set.mem_image, Finset.mem_coe] at hx
    obtain ⟨c, _, rfl⟩ := hx
    exact ⟨FiniteGrp.of (Tw r t c), card_Tw, rfl⟩
  have h3 : P.card ≤ 2 ^ (r * r + t * t) * (P.image cls).card := by
    apply Finset.card_le_mul_card_image
    intro a ha
    obtain ⟨c0, hc0, rfl⟩ := Finset.mem_image.mp ha
    have hfull0 : Full c0 := by simpa [P] using hc0
    have hex : ∀ c : Sym2 (Fin r) → V t, cls c = cls c0 → Nonempty (Tw r t c0 ≃* Tw r t c) :=
      fun c h => equiv_of_cls h.symm
    let dat : (Sym2 (Fin r) → V t) → (Fin r → V r) × (Fin t → V t) := fun c =>
      if h : cls c = cls c0 then
        (fun i => ((hex c h).some ⟨Pi.single i 1, 0⟩).a,
          fun j => ((hex c h).some ⟨0, Pi.single j 1⟩).z)
      else (0, 0)
    calc (P.filter fun c => cls c = cls c0).card
        ≤ (Finset.univ : Finset ((Fin r → V r) × (Fin t → V t))).card := by
          apply Finset.card_le_card_of_injOn dat (fun _ _ => Finset.mem_univ _)
          intro c hc c' hc' hdd
          have hc2 : cls c = cls c0 := (Finset.mem_filter.mp hc).2
          have hc2' : cls c' = cls c0 := (Finset.mem_filter.mp hc').2
          simp only [dat, dif_pos hc2, dif_pos hc2', Prod.mk.injEq] at hdd
          exact fibre_inj hfull0 _ _ (fun i => congrFun hdd.1 i) (fun j => congrFun hdd.2 j)
      _ = 2 ^ (r * r + t * t) := by
          simp [pow_add, ← pow_mul]
  calc 2 ^ ((r + 1).choose 2 * t - 1) ≤ P.card := h1
    _ ≤ 2 ^ (r * r + t * t) * (P.image cls).card := h3
    _ ≤ 2 ^ (r * r + t * t) * g (2 ^ (r + t)) := Nat.mul_le_mul_left _ h2

lemma numeric (t e : ℕ) (he : e < 3) (ht : 10 ≤ t) :
    2 * (3 * t + e) ^ 3 + 27 * ((2 * t + e) * (2 * t + e) + t * t) + 27
      ≤ 27 * ((2 * t + e + 1).choose 2 * t) + 13 * (3 * t + e) ^ 2 := by
  have h2 := choose_two_mul (2 * t + e)
  obtain ⟨k, rfl⟩ : ∃ k, t = k + 10 := ⟨t - 10, by omega⟩
  have hD : (2 * (k + 10) + e + 1).choose 2 * (k + 10) * 2
      = (2 * (k + 10) + e) * (2 * (k + 10) + e + 1) * (k + 10) := by
    rw [← h2]
    ring
  interval_cases e
  · nlinarith [hD, Nat.zero_le k, Nat.zero_le (k ^ 2)]
  · nlinarith [hD, Nat.zero_le k, Nat.zero_le (k ^ 2)]
  · nlinarith [hD, Nat.zero_le k, Nat.zero_le (k ^ 2)]

end OMA.Hig

theorem OMA.solution : OMA.R_Erdos1160_erdos_1160_variants_sum_R1_H2_R1.H1 := by
  unfold OMA.R_Erdos1160_erdos_1160_variants_sum_R1_H2_R1.H1
  refine Filter.eventually_atTop.mpr ⟨32, fun m hm => ?_⟩
  obtain ⟨t, e, he, rfl⟩ : ∃ t e, e < 3 ∧ m = 3 * t + e :=
    ⟨m / 3, m % 3, Nat.mod_lt _ (by norm_num), by omega⟩
  have ht : 10 ≤ t := by omega
  have h2 := OMA.Hig.choose_two_mul (2 * t + e)
  have hD : t + 1 ≤ (2 * t + e + 1).choose 2 := by nlinarith
  have hcount := OMA.Hig.main_count (2 * t + e) t (by omega) hD
  have hrt : 2 * t + e + t = 3 * t + e := by ring
  rw [hrt] at hcount
  have hnum := OMA.Hig.numeric t e he ht
  have hpos : 1 ≤ (2 * t + e + 1).choose 2 * t := Nat.mul_pos (by omega) (by omega)
  refine OMA.Hig.final_arith _ _ _ _ _ hcount ?_
  omega
