lemma center3 (r : Fin 97 → Bool) (hr : r (Fin.ofNat 97 45) = true)
    (hb : ∀ i : Fin 97, 45 < i.val → i.val < 51 → r i = false) : Mono r := by
  by_contra hn
  apply node158 (Red r) (noTriple_of_not_mono hn) (all_hit hn)
  · intro x hx
    have he : x = 45 := by simpa using hx
    exact he ▸ ⟨by decide,hr⟩
  · intro x hx
    obtain ⟨hx,hrx⟩ := hx
    have hh : x ≤ 45 ∨ 51 ≤ x := by
      by_contra! outside
      have hblue := hb ⟨x,hx⟩ outside.1 outside.2
      have he : Fin.ofNat 97 x = ⟨x,hx⟩ := Fin.ext (Nat.mod_eq_of_lt hx)
      exact Bool.noConfusion (hrx.symm.trans ((congrArg r he).trans hblue))
    have mask : ∀ t : Fin 97, t.val ≤ 45 ∨ 51 ≤ t.val → (0x1fffffffffff83fffffffffff : ℕ).testBit t.val = true := by decide +kernel
    exact mask ⟨x,hx⟩ hh

end OMA.Progressions

theorem OMA.solution : OMA.R_Green14_W_3_10_R1.H2 := by
  intro r j hlo hhi hr hb
  have hh : j.val = 2 ∨ j.val = 3 := by omega
  rcases hh with h | h
  · exact OMA.Progressions.center2 r (by simpa [h] using hr) (by simpa [h] using hb)
  · exact OMA.Progressions.center3 r (by simpa [h] using hr) (by simpa [h] using hb)
