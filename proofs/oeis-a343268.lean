import OMAStatements.S_oeis_a343268
import Mathlib

/-!
# Exactly four positive binary squares

A positive binary square is a word of bits repeated twice. The MFCS 2018 paper
by Madhusudan, Nowotka, Rajasekaran and Shallit asks whether 1772 is the
largest integer outside the fourfold sumset.

The exceptional integer is excluded by checking pairs of pair sums. Direct
bitset addition handles 1773 through 10000. Then 19088 residue witnesses in
sixteen overlapping-width constructions cover 10001 through 34078720. Each
witness in its interval supplies two or three fixed positive summands, and
one or two summands of the same power-of-two width complete the total.

Above that range, an integer construction using widths H, 2H and kH covers
two overlapping bands for every dyadic scale, with k chosen as 8 or 32.
-/

namespace OMA.A343268Exception

open OMA.S_oeis_a343268

private def values : List ℕ :=
  [3, 10, 15, 36, 45, 54, 63, 136, 153, 170, 187, 204, 221, 238, 255,
   528, 561, 594, 627, 660, 693, 726, 759, 792, 825, 858, 891, 924, 957, 990, 1023]

private theorem mem_values {a : ℕ} (ha : IsBinSquare a) (h : a ≤ 1772) : a ∈ values := by
  obtain ⟨k, m, hk, hlow, hupp, rfl⟩ := ha
  have hk5 : k ≤ 5 := by
    by_contra! hlarge
    have h32 : 32 ≤ 2 ^ (k - 1) :=
      Nat.pow_le_pow_right (by decide : 0 < 2) (show 5 ≤ k - 1 by omega)
    have h64 : 64 ≤ 2 ^ k :=
      Nat.pow_le_pow_right (by decide : 0 < 2) (show 6 ≤ k by omega)
    have hbig := Nat.mul_le_mul (h32.trans hlow) (Nat.add_le_add_right h64 1)
    omega
  interval_cases k <;> norm_num at hlow hupp <;> interval_cases m <;> decide

/-- Bit s is set for the sums of two entries in values. Each use of the
certificate below checks its asserted bit directly. -/
private def pairBit (s : ℕ) : Bool :=
  Nat.testBit  s

set_option maxRecDepth 6000 in
private theorem pair_present :
    ∀ a ∈ values, ∀ b ∈ values, pairBit (a + b) = true := by decide +kernel

set_option maxRecDepth 6000 in
private theorem complement_absent :
    ∀ c ∈ values, ∀ d ∈ values, c + d ≤ 1772 → pairBit (1772 - (c + d)) = false := by
  decide +kernel

theorem not_four : ¬ ∃ a b c d : ℕ,
    IsBinSquare a ∧ IsBinSquare b ∧ IsBinSquare c ∧ IsBinSquare d ∧
    a + b + c + d = 1772 := by
  rintro ⟨a, b, c, d, ha, hb, hc, hd, hs⟩
  have hleft := pair_present a (mem_values ha (by omega)) b (mem_values hb (by omega))
  have hright := complement_absent c (mem_values hc (by omega)) d (mem_values hd (by omega))
    (by omega)
  have hsum : 1772 - (c + d) = a + b := by omega
  simpa [hsum, hleft] using hright

end OMA.A343268Exception

