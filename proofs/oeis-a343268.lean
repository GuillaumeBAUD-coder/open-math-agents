   (4, 9), (4, 10), (4, 11), (4, 12), (4, 13), (4, 14), (4, 15), (5, 16),
   (5, 17), (5, 18), (5, 19), (5, 20), (5, 21), (5, 22), (5, 23), (5, 24),
   (5, 25), (5, 26), (5, 27), (5, 28), (5, 29), (5, 30), (5, 31), (6, 32),
   (6, 33), (6, 34), (6, 35), (6, 36), (6, 37), (6, 38), (6, 39), (6, 40),
   (6, 41), (6, 42), (6, 43), (6, 44), (6, 45), (6, 46), (6, 47), (6, 48),
   (6, 49), (6, 50), (6, 51), (6, 52), (6, 53), (6, 54), (6, 55), (6, 56),
   (6, 57), (6, 58), (6, 59), (6, 60), (6, 61), (6, 62), (6, 63), (7, 64),
   (7, 65), (7, 66), (7, 67), (7, 68), (7, 69), (7, 70), (7, 71), (7, 72),
   (7, 73), (7, 74), (7, 75), (7, 76), (7, 77)]

private def value (p : ℕ × ℕ) : ℕ := p.2 * (2 ^ p.1 + 1)

private theorem inputs_valid :
    ∀ p ∈ inputs, 1 ≤ p.1 ∧ 2 ^ (p.1 - 1) ≤ p.2 ∧ p.2 < 2 ^ p.1 := by
  decide +kernel

/-- A left shift adds one summand to each represented total. -/
private def expand (mask : ℕ) : List (ℕ × ℕ) → ℕ
  | [] => 0
  | p :: ps => (mask <<< value p) ||| expand mask ps

private theorem expand_sound (mask n : ℕ) (ps : List (ℕ × ℕ)) :
    (expand mask ps).testBit n = true →
      ∃ p ∈ ps, value p ≤ n ∧ mask.testBit (n - value p) = true := by
  induction ps with
  | nil => simp [expand]
  | cons p ps ih =>
    intro h
    simp only [expand, Nat.testBit_or, Nat.testBit_shiftLeft, Bool.or_eq_true_iff,
      Bool.and_eq_true_iff, decide_eq_true_eq] at h
    rcases h with hp | hp
    · exact ⟨p, by simp, hp.1, hp.2⟩
    · obtain ⟨q, hq, hl, hb⟩ := ih hp
      exact ⟨q, List.mem_cons_of_mem _ hq, hl, hb⟩

private theorem predecessor (mask n : ℕ) (h : (expand mask inputs).testBit n = true) :
    ∃ a : ℕ, IsBinSquare a ∧ a ≤ n ∧ mask.testBit (n - a) = true := by
  obtain ⟨p, hp, hl, hb⟩ := expand_sound mask n inputs h
  obtain ⟨hk, hm₁, hm₂⟩ := inputs_valid p hp
  exact ⟨value p, ⟨p.1, p.2, hk, hm₁, hm₂, rfl⟩, hl, hb⟩

private def mask1 : ℕ := 

private theorem mask1_ok : mask1 = expand 1 inputs := by decide +kernel

private def mask2 : ℕ := 

private theorem mask2_ok : mask2 = expand mask1 inputs := by decide +kernel

private def mask3 : ℕ := 

private theorem mask3_ok : mask3 = expand mask2 inputs := by decide +kernel

private theorem terminal :
    (((expand mask3 inputs) >>> 1773) &&& (2^8228-1)) = 2^8228-1 := by
  decide +kernel

/-- Each integer in this interval is the sum of four binary squares. -/
theorem covers (n : ℕ) (hl : 1772 < n) (hu : n ≤ 10000) :
    ∃ a b c d : ℕ, IsBinSquare a ∧ IsBinSquare b ∧ IsBinSquare c ∧ IsBinSquare d ∧
      a + b + c + d = n := by
  let i := n - 1773
  have hi : i < 8228 := by dsimp [i]; omega
  have hn : 1773 + i = n := by dsimp [i]; omega
  have ht := congrArg (fun v : ℕ => v.testBit i) terminal
  have h4 : (expand mask3 inputs).testBit n = true := by
    simpa only [Nat.testBit_and, Nat.testBit_shiftRight, Nat.testBit_two_pow_sub_one,
      decide_eq_true hi, Bool.and_true, hn] using ht
  obtain ⟨d, hd, hdn, h3⟩ := predecessor mask3 n h4
  rw [mask3_ok] at h3
  obtain ⟨c, hc, hcn, h2⟩ := predecessor mask2 _ h3
  rw [mask2_ok] at h2
  obtain ⟨b, hb, hbn, h1⟩ := predecessor mask1 _ h2
  rw [mask1_ok] at h1
  obtain ⟨a, ha, han, h0⟩ := predecessor 1 _ h1
  have hz := Nat.testBit_one_eq_true_iff_self_eq_zero.mp h0
  exact ⟨a, b, c, d, ha, hb, hc, hd, by omega⟩

end OMA.BinaryInitial

namespace OMA.BinaryAtlas

open OMA.S_oeis_a343268

/-- The number obtained by writing the binary digits of a mantissa twice. -/
def v (m : ℕ) : ℕ := m * (2 ^ (Nat.log2 m + 1) + 1)

def repr (n : ℕ) : Prop :=
  ∃ a b c d : ℕ, IsBinSquare a ∧ IsBinSquare b ∧ IsBinSquare c ∧
    IsBinSquare d ∧ a + b + c + d = n

/-- A row supplies either three fixed summands and one variable summand,
or two fixed summands and two variable summands. Its interval covers
every integer in the indicated residue class. -/
def rowFits (k t lo hi r m1 m2 m3 : ℕ) : Prop :=
  let L := 2 ^ k
  let R := v m1 + v m2 + v m3
  0 < m1 ∧ 0 < m2 ∧ ((t = 1 ∧ 0 < m3) ∨ (t = 2 ∧ m3 = 0)) ∧
    R % (L + 1) = r ∧
    R + t * (L / 2) * (L + 1) ≤ lo ∧ hi ≤ R + t * (L - 1) * (L + 1)

instance (k t lo hi r m1 m2 m3 : ℕ) : Decidable (rowFits k t lo hi r m1 m2 m3) := by
  unfold rowFits
  infer_instance

theorem v_isBinSquare {m : ℕ} (hm : 0 < m) : IsBinSquare (v m) := by
  refine ⟨Nat.log2 m + 1, m, by omega, ?_, ?_, rfl⟩
  · simpa [Nat.log2_eq_log_two] using (Nat.pow_log_le_self 2 (Nat.ne_of_gt hm))
  · simpa [Nat.log2_eq_log_two] using (Nat.lt_pow_succ_log_self (by decide : 1 < 2) m)

private theorem half_pow {k : ℕ} (hk : 1 ≤ k) : 2 ^ (k - 1) = (2 ^ k : ℕ) / 2 := by
  cases k with
  | zero => omega
  | succ j => simp [pow_succ]

theorem repr_of_row {k t lo hi n m1 m2 m3 : ℕ}
    (hk : 1 ≤ k) (hlo : lo ≤ n) (hhi : n ≤ hi)
    (h : rowFits k t lo hi (n % (2 ^ k + 1)) m1 m2 m3) : repr n := by
  let L : ℕ := 2 ^ k
  let s := L + 1
  let R := v m1 + v m2 + v m3
  change 0 < m1 ∧ 0 < m2 ∧ ((t = 1 ∧ 0 < m3) ∨ (t = 2 ∧ m3 = 0)) ∧
    R % s = n % s ∧ R + t * (L / 2) * s ≤ lo ∧ hi ≤ R + t * (L - 1) * s at h
  obtain ⟨hm1, hm2, ht, hmod, hmin, hmax⟩ := h
  have hs : 0 < s := by dsimp [s]; omega
  have hL : 0 < L := by dsimp [L]; positivity
  have hRn : R ≤ n := by omega
  have hdiv : R / s ≤ n / s := Nat.div_le_div_right hRn
  let q := n / s - R / s
  have hadd : R / s + q = n / s := by dsimp [q]; omega
  have heq : R + q * s = n := by
    calc
      R + q * s = (R % s + s * (R / s)) + s * q := by
        rw [Nat.mod_add_div, Nat.mul_comm s q]
      _ = R % s + s * (R / s + q) := by rw [Nat.mul_add, Nat.add_assoc]
      _ = n := by rw [hadd, hmod, Nat.mod_add_div]
  have lower : t * (L / 2) ≤ q :=
    Nat.le_of_mul_le_mul_right (show t * (L / 2) * s ≤ q * s by omega) hs
  have upper : q ≤ t * (L - 1) :=
    Nat.le_of_mul_le_mul_right (show q * s ≤ t * (L - 1) * s by omega) hs
  have half : 2 ^ (k - 1) = L / 2 := half_pow hk
  have width (m : ℕ) (hl : L / 2 ≤ m) (hu : m ≤ L - 1) : IsBinSquare (m * s) := by
    refine ⟨k, m, hk, ?_, ?_, rfl⟩
    · rw [half]
      exact hl
    · change m < L
      omega
  rcases ht with ⟨ht, hm3⟩ | ⟨ht, hm3⟩
  · simp only [ht, one_mul] at lower upper
    exact ⟨v m1, v m2, v m3, q * s, v_isBinSquare hm1, v_isBinSquare hm2,
      v_isBinSquare hm3, width q lower upper, heq⟩
  · simp only [ht] at lower upper
    have hsplit : q / 2 + (q + 1) / 2 = q := by omega
    refine ⟨v m1, v m2, (q / 2) * s, ((q + 1) / 2) * s,
      v_isBinSquare hm1, v_isBinSquare hm2, width _ (by omega) (by omega),
      width _ (by omega) (by omega), ?_⟩
    calc
      v m1 + v m2 + q / 2 * s + (q + 1) / 2 * s =
          (v m1 + v m2) + (q / 2 + (q + 1) / 2) * s := by rw [Nat.add_mul, Nat.add_assoc]
      _ = n := by
        rw [hsplit]
        simpa only [R, hm3, show v 0 = 0 by rfl, Nat.add_zero] using heq

end OMA.BinaryAtlas

