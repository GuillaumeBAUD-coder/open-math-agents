/-- A word holds up to sixteen rows. Each row gives two or three positive mantissas. -/
private def codeAt (data : Array ℕ) (bits t i : ℕ) : ℕ :=
  (data[i / 16]!) >>> (i % 16 * (if t = 1 then 3 else 2) * bits)

private def column (code bits slot : ℕ) : ℕ :=
  (code >>> (slot * bits)) &&& ((1 <<< bits) - 1)

private def rowOK (data : Array ℕ) (bits k t lo hi i : ℕ) : Bool :=
  let code := codeAt data bits t i
  decide (rowFits k t lo hi i (column code bits 0) (column code bits 1)
    (if t = 1 then column code bits 2 else 0))

private def scan (f : ℕ → Bool) (start : ℕ) : ℕ → Bool
  | 0 => true
  | n+1 => scan f start n && f (start+n)

private def IntervalOK (f : ℕ → Bool) (lo hi : ℕ) : Prop :=
  ∀ i, lo ≤ i → i < hi → f i = true

private theorem checked (f : ℕ → Bool) (start count : ℕ)
    (h : scan f start count = true) : IntervalOK f start (start+count) := by
  intro i hlo hhi
  induction count with
  | zero => omega
  | succ count ih =>
    have hBoth : scan f start count = true ∧ f (start+count) = true := by
      simpa only [scan, Bool.and_eq_true] using h
    by_cases hlt : i < start+count
    · exact ih hBoth.1 hlt
    · have heq : i = start+count := by omega
      simpa only [heq] using hBoth.2

private theorem combine {f : ℕ → Bool} {a b c : ℕ} (hl : IntervalOK f a b)
    (hr : IntervalOK f b c) : IntervalOK f a c := by
  intro i ha hc
  by_cases hb : i < b
  · exact hl i ha hb
  · exact hr i (by omega) hc

private theorem inBand (data : Array ℕ) (bits k t lo hi n : ℕ) (hk : 1 ≤ k)
    (hn : lo ≤ n) (hn' : n ≤ hi)
    (good : IntervalOK (rowOK data bits k t lo hi) 0 (2^k+1)) : repr n := by
  let i := n % (2^k+1)
  have hi' : i < 2^k+1 := Nat.mod_lt _ (by omega)
  have h := good i (by omega) hi'
  unfold rowOK at h
  exact repr_of_row hk hn hn' (of_decide_eq_true h)

