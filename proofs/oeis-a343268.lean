namespace A343268Four

open OMA.S_oeis_a343268

abbrev Four (n : ℕ) : Prop :=
  ∃ a b c d : ℕ, IsBinSquare a ∧ IsBinSquare b ∧ IsBinSquare c ∧ IsBinSquare d ∧ a+b+c+d=n

private def ZBin (n : ℤ) := ∃ a : ℕ, IsBinSquare a ∧ (a : ℤ) = n

private lemma assemble {n : ℕ} {a b c d : ℤ}
    (ha : ZBin a) (hb : ZBin b) (hc : ZBin c) (hd : ZBin d) (he : a+b+c+d=n) : Four n := by
  obtain ⟨w,hw,rfl⟩ := ha
  obtain ⟨x,hx,rfl⟩ := hb
  obtain ⟨y,hy,rfl⟩ := hc
  obtain ⟨z,hz,rfl⟩ := hd
  exact ⟨w,x,y,z,hw,hx,hy,hz,by exact_mod_cast he⟩

private lemma binary {d m : ℤ} (hp : ∃ e : ℕ, d = (2 : ℤ)^e)
    (lo : d ≤ m) (hi : m < 2*d) : ZBin (m*(2*d+1)) := by
  obtain ⟨e,rfl⟩ := hp
  have hm : 0 ≤ m := le_trans (by positivity) lo
  have hm' : (m.toNat : ℤ) = m := Int.toNat_of_nonneg hm
  have hlo : (2 : ℕ)^e ≤ m.toNat := by
    exact_mod_cast (show (2 : ℤ)^e ≤ (m.toNat : ℤ) by rw [hm']; exact lo)
  have hhi : m.toNat < 2*(2 : ℕ)^e := by
    exact_mod_cast (show (m.toNat : ℤ) < 2*(2 : ℤ)^e by rw [hm']; exact hi)
  refine ⟨m.toNat*(2^(e+1)+1), ⟨e+1,m.toNat,by omega,by simpa using hlo,
    by simpa [pow_succ, Nat.mul_comm] using hhi,rfl⟩,?_⟩
  push_cast
  rw [hm', pow_succ]
  ring

private lemma splitPair (d m : ℤ) (hd : 1 ≤ d) (hl : 2*d ≤ m) (hu : m ≤ 4*d-2) :
    ∃ x y : ℤ, d ≤ x ∧ x < 2*d ∧ d ≤ y ∧ y < 2*d ∧ x+y=m := by
  by_cases hh : m ≤ 3*d-1
  · exact ⟨d,m-d,by omega,by omega,by omega,by omega,by omega⟩
  · exact ⟨m-(2*d-1),2*d-1,by omega,by omega,by omega,by omega,by omega⟩

/-- The consecutive weights k-1,k-2 cover an interval of at least 2kh+1
values. The two explicit Euclidean divisions find a witness near one of
the two endpoints of the allowed u-interval. -/
private lemma box (k h w : ℤ) (hk : k=8 ∨ k=32) (hh : 128 ≤ h)
    (hl : k^2 ≤ w) (hu : w ≤ k^2 + 2*k*h) :
    ∃ u v : ℤ, 0 ≤ u ∧ u < h ∧ 0 ≤ v ∧ v < 2*h ∧ (k-1)*u+(k-2)*v=w := by
  by_cases hv : w ≤ (k-2)*(2*h-1)
  · let u := w % (k-2)
    let v := w / (k-2) - u
    refine ⟨u,v,?_,?_,?_,?_,?_⟩
    all_goals rcases hk with rfl | rfl <;> dsimp [u,v] at * <;> omega
  · let u := h-1 - ((h-1-w) % (k-2))
    let v := -((h-1-w) / (k-2)) - u
    refine ⟨u,v,?_,?_,?_,?_,?_⟩
    all_goals rcases hk with rfl | rfl <;> dsimp [u,v] at * <;> omega

private lemma obtainCoefficients (k h a n : ℤ) (hk : k=8 ∨ k=32) (hh : 128 ≤ h) :
    ∃ A B C : ℤ, a*h ≤ A ∧ A < (a+1)*h ∧ 2*h ≤ B ∧ B < 4*h ∧
      n = (2*h+1)*A+(4*h+1)*B+(2*k*h+1)*C := by
  let M := 2*k*h+1
  let z := k*n-(k-1)*(a*h)-(k-2)*(2*h)-k^2
  let w := z % M + k^2
  have hM : 0 < M := by rcases hk with rfl | rfl <;> dsimp [M] <;> omega
  have h1 := Int.emod_nonneg z (ne_of_gt hM)
  have h2 := Int.emod_lt_of_pos z hM
  obtain ⟨u,v,hu0,huh,hv0,hvh,hw⟩ := box k h w hk hh
    (by dsimp [w]; omega) (by dsimp [w,M] at *; omega)
  let T := z / M
  let A := a*h+u
  let B := 2*h+v
  let C := n-A-B-(2*h)*T
  have hz := Int.emod_add_mul_ediv z M
  have eq : k*n-(k-1)*A-(k-2)*B = M*T := by
    dsimp only [A,B,T]
    dsimp only [w] at hw
    dsimp only [z] at hz hw ⊢
    linarith
  refine ⟨A,B,C,by dsimp [A];omega,?_,by dsimp [B];omega,by dsimp [B];omega,?_⟩
  · dsimp [A]
    linarith
  · dsimp only [C]
    dsimp only [M] at eq
    linear_combination -(2*h)*eq

/-- Once the short coefficients have been chosen, the two size
inequalities on n automatically put C inside the requested box. -/
private lemma highBounds (k h c n A B C : ℤ) (hc : c=1 ∨ c=2) (hh : 128 ≤ h)
    (hw : (k=32 ∧ (64*c+1)*(2*k*h)^2 ≤ 128*n ∧ n ≤ c*(2*k*h)^2) ∨
          (k=8 ∧ c*(2*k*h)^2 ≤ n ∧ 32*n ≤ (32*c+1)*(2*k*h)^2))
    (ha : (3-c)*h ≤ A) (ha' : A < ((3-c)+1)*h)
    (hb : 2*h ≤ B) (hb' : B < 4*h)
    (he : n = (2*h+1)*A+(4*h+1)*B+(2*k*h+1)*C) :
    c*k*h ≤ C ∧ C ≤ c*(2*k*h-1) := by
  have haL := mul_le_mul_of_nonneg_left ha (show 0 ≤ 2*h+1 by omega)
  have haU := mul_le_mul_of_nonneg_left ha'.le (show 0 ≤ 2*h+1 by omega)
  have hbL := mul_le_mul_of_nonneg_left hb (show 0 ≤ 4*h+1 by omega)
  have hbU := mul_le_mul_of_nonneg_left hb'.le (show 0 ≤ 4*h+1 by omega)
  have hsq := mul_nonneg (show 0 ≤ h by omega) (show 0 ≤ h-100 by omega)
  have hk : k=32 ∨ k=8 := hw.imp And.left And.left
  have hp : 0 < 2*k*h+1 := by rcases hk with rfl | rfl <;> omega
  constructor
  · by_contra! bad
    have hp' := mul_pos (show 0 < c*k*h-C by omega) hp
    rcases hw with ⟨rfl,hn0,hn1⟩ | ⟨rfl,hn0,hn1⟩ <;>
      rcases hc with rfl | rfl <;> nlinarith only [he,haU,hbU,hsq,hh,hp',hn0]
  · by_contra! bad
    have hp' := mul_pos (show 0 < C-c*(2*k*h-1) by omega) hp
    rcases hw with ⟨rfl,hn0,hn1⟩ | ⟨rfl,hn0,hn1⟩ <;>
      rcases hc with rfl | rfl <;> nlinarith only [he,haL,hbL,hsq,hh,hp',hn1]

private lemma localBand (k h c : ℤ) (n : ℕ) (hc : c=1 ∨ c=2) (hh : 128 ≤ h)
    (hp : ∃ p : ℕ, h=(2:ℤ)^p)
    (hw : (k=32 ∧ (64*c+1)*(2*k*h)^2 ≤ 128*(n:ℤ) ∧ (n:ℤ) ≤ c*(2*k*h)^2) ∨
          (k=8 ∧ c*(2*k*h)^2 ≤ (n:ℤ) ∧ 32*(n:ℤ) ≤ (32*c+1)*(2*k*h)^2)) : Four n := by
  have hk : k=8 ∨ k=32 := (hw.imp And.left And.left).symm
  obtain ⟨A,B,C,ha,ha',hb,hb',he⟩ := obtainCoefficients k h (3-c) n hk hh
  obtain ⟨hl,hu⟩ := highBounds k h c n A B C hc hh hw ha ha' hb hb' he
  obtain ⟨e,hpow⟩ := hp
  have mPow : ∃ p : ℕ, 2*h=(2:ℤ)^p := ⟨e+1, by rw [hpow,pow_succ];ring⟩
  have lPow : ∃ p : ℕ, k*h=(2:ℤ)^p := by
    rcases hk with rfl | rfl
    · exact ⟨e+3, by rw [hpow,pow_add];ring⟩
    · exact ⟨e+5, by rw [hpow,pow_add];ring⟩
  have mid := binary mPow hb (show B < 2*(2*h) by omega)
  have lowPow : ∃ p : ℕ, h=(2:ℤ)^p := ⟨e,hpow⟩
  have hkh : 1 ≤ k*h := by rcases hk with rfl | rfl <;> omega
  rcases hc with rfl | rfl
  · obtain ⟨X,Y,hx,hx',hy,hy',hxy⟩ := splitPair h A (by omega) (by linarith) (by linarith)
    have lowX := binary lowPow hx hx'
    have lowY := binary lowPow hy hy'
    have last := binary lPow (show k*h ≤ C by linarith) (show C < 2*(k*h) by nlinarith)
    apply assemble lowX lowY mid last
    rw [← hxy] at he
    linear_combination -he
  · have low := binary lowPow (show h ≤ A by linarith) (show A < 2*h by linarith)
    obtain ⟨X,Y,hx,hx',hy,hy',hxy⟩ := splitPair (k*h) C hkh (by nlinarith) (by nlinarith)
    have lastX := binary lPow hx hx'
    have lastY := binary lPow hy hy'
    apply assemble low mid lastX lastY
    rw [← hxy] at he
    linear_combination -he

private lemma powerBound (e : ℕ) : (e : ℤ)+1 ≤ (2:ℤ)^e := by
  induction e with
  | zero => norm_num
  | succ e ih =>
    rw [pow_succ]
    push_cast
    have : 0 ≤ (e : ℤ) := Int.natCast_nonneg e
    linarith

private lemma band (s : ℕ) (c : ℤ) (n : ℕ) (hc : c=1 ∨ c=2)
    (hlo : (64*c+1)*(8192*(2:ℤ)^s)^2 ≤ 128*(n:ℤ))
    (hhi : 32*(n:ℤ) ≤ (32*c+1)*(8192*(2:ℤ)^s)^2) : Four n := by
  have hs := powerBound s
  by_cases hn : (n:ℤ) ≤ c*(8192*(2:ℤ)^s)^2
  · apply localBand 32 (128*(2:ℤ)^s) c n hc (by linarith) ⟨s+7,by rw [pow_add];ring⟩
    left
    have hw : (2:ℤ)*32*(128*2^s)=8192*2^s := by ring
    rw [hw]
    exact ⟨rfl,hlo,hn⟩
  · apply localBand 8 (512*(2:ℤ)^s) c n hc (by linarith) ⟨s+9,by rw [pow_add];ring⟩
    right
    have hw : (2:ℤ)*8*(512*2^s)=8192*2^s := by ring
    rw [hw]
    exact ⟨rfl,by omega,hhi⟩

private lemma scaleCover (s n : ℕ)
    (hl : 65*(8192*(2:ℤ)^s)^2 ≤ 128*(n:ℤ))
    (hu : 32*(n:ℤ) ≤ 65*(8192*(2:ℤ)^s)^2) : Four n := by
  by_cases hc : 32*(n:ℤ) ≤ 33*(8192*(2:ℤ)^s)^2
  · apply band s 1 n (Or.inl rfl)
    · convert hl using 1 <;> norm_num
    · convert hc using 1 <;> norm_num
  · apply band s 2 n (Or.inr rfl)
    · nlinarith [sq_nonneg (8192*(2:ℤ)^s)]
    · convert hu using 1 <;> norm_num

private lemma reach (s n : ℕ) (hn : 34078720 ≤ n)
    (hu : 32*(n:ℤ) ≤ 65*(8192*(2:ℤ)^s)^2) : Four n := by
  induction s with
  | zero =>
    apply scaleCover 0 n _ hu
    norm_num
    exact_mod_cast (show 4362076160 ≤ 128*n by omega)
  | succ s ih =>
    by_cases prev : 32*(n:ℤ) ≤ 65*(8192*(2:ℤ)^s)^2
    · exact ih prev
    · apply scaleCover (s+1) n _ hu
      rw [pow_succ]
      nlinarith

theorem analytic (n : ℕ) (hn : 34078720 ≤ n) : Four n := by
  apply reach n n hn
  have h := powerBound n
  nlinarith [sq_nonneg ((2:ℤ)^n-1), Int.natCast_nonneg n]

end A343268Four

theorem OMA.solution : type_of% @OMA.S_oeis_a343268.main := by
  constructor
  · exact OMA.A343268Exception.not_four
  · intro n hn
    by_contra h
    have hl : 1772 < n := by omega
    apply hn
    by_cases hs : n ≤ 10000
    · exact OMA.BinaryInitial.covers n hl hs
    by_cases hm : n ≤ 34078720
    · exact OMA.BinaryAtlas.finiteMiddle n (by omega) hm
    exact A343268Four.analytic n (by omega)
