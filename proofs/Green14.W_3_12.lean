private def Mono (r : Nat → Bool) := ∃ (b : Bool) (a d : ℕ),
  0 < d ∧ a + (if b then 11 else 2)*d < 134 ∧
  ∀ t ≤ (if b then 11 else 2), r (a+t*d) = b

private def Red (r : Nat → Bool) (x : Nat) := x < 134 ∧ r x = false

private lemma triple_free {r : Nat → Bool} (hn : ¬ Mono r) : NoTriple (Red r) := by
  intro a d hd h₀ h₁ h₂
  apply hn
  refine ⟨false, a, d, hd, h₂.1, ?_⟩
  intro t ht
  change t ≤ 2 at ht
  rcases (show t=0 ∨ t=1 ∨ t=2 by omega) with he|he|he
  · simpa [he] using h₀.2
  · simpa [he] using h₁.2
  · simpa [he] using h₂.2

private lemma base_bit : ∀ d : Fin 13, 0 < d.val → ∀ t : Fin 12,
    bases[d.val-1]!.testBit (9*(t.val*d.val)) = true := by decide +kernel

private lemma hit_at {r : Nat → Bool} {a d : Nat} (hn : ¬ Mono r)
    (hd : 0 < d) (hb : a+11*d < 134) :
    ∃ t, (bases[d-1]! <<< (9*a)).testBit (9*t) = true ∧ Red r t := by
  by_contra! bad
  apply hn
  refine ⟨true, a, d, hd, hb, ?_⟩
  intro t ht
  change t ≤ 11 at ht
  have hle := Nat.mul_le_mul_right d ht
  have hm : (bases[d-1]! <<< (9*a)).testBit (9*(a+t*d)) = true := by
    simpa [Nat.testBit_shiftLeft, Nat.mul_add, Nat.le_add_right] using
      base_bit ⟨d,by omega⟩ hd ⟨t,by omega⟩
  cases he : r (a + t*d) with
  | false => exact False.elim (bad _ hm ⟨by omega, he⟩)
  | true => rfl

private lemma hit_all {r : Nat → Bool} (hn : ¬ Mono r) : Hits (Red r) := by
  intro i
  dsimp only [pattern]
  split
  · apply hit_at hn <;> omega
  · simpa using hit_at (a:=0) (d:=1) hn (by decide) (by decide)


private theorem asymmetric (r : Nat → Bool) (ha : r 66 = false) (hb : r 67 = true) : Mono r := by
  by_contra hn
  have tr := triple_free hn
  apply complete (Red r) (fun _ hx => by have := hx.1; omega) tr (hit_all hn)
  · exact mark_good tr (show Red r 66 from ⟨by decide, ha⟩) (by decide)
  · intro x hx
    have he : x ≠ 67 := by rintro rfl; have := hx.2; simp_all
    have mask : ∀ i : Fin 134, i.val ≠ 67 → ( : Nat).testBit (9*i.val) = true := by decide +kernel
    exact mask ⟨x,hx.1⟩ he
private theorem mirror_ap (r : ℕ → Bool)
    (h : ∃ (b : Bool) (a d : ℕ), 0 < d ∧ a + (if b then 11 else 2) * d < 134 ∧
      ∀ t ≤ (if b then 11 else 2), (fun i => r (133 - i)) (a + t * d) = b) :
    ∃ (b : Bool) (a d : ℕ), 0 < d ∧ a + (if b then 11 else 2) * d < 134 ∧
      ∀ t ≤ (if b then 11 else 2), r (a + t * d) = b := by
  obtain ⟨b, a, d, hd, he, hm⟩ := h
  generalize hL : (if b then 11 else 2) = L at he hm
  refine ⟨b, 133 - (a + L*d), d, hd, ?_, ?_⟩
  · rw [hL]; omega
  · rw [hL]
    intro t ht
    have hh := hm (L - t) (by omega)
    have hmul := Nat.mul_le_mul_right d ht
    simp only at hh
    rw [Nat.sub_mul] at hh
    simpa only [show 133 - (a + (L*d - t*d)) = 133 - (a + L*d) + t*d by omega] using hh


private theorem same_middle (r : Nat → Bool) (hn : ¬ Mono r) : r 66 = r 67 := by
  cases ha : r 66 <;> cases hb : r 67
  · rfl
  · exact (hn (asymmetric r ha hb)).elim
  · exact (hn (mirror_ap r (asymmetric (fun i => r (133-i)) hb ha))).elim
  · rfl

private def Mono135 (r : Nat → Bool) := ∃ (b : Bool) (a d : ℕ),
  0 < d ∧ a+(if b then 11 else 2)*d < 135 ∧ ∀ t ≤ (if b then 11 else 2), r (a+t*d) = b

private lemma shift {r : Nat → Bool} {o : Nat} (ho : o ≤ 1)
    (hm : Mono (fun i => r (o+i))) : Mono135 r := by
  obtain ⟨b,a,d,hd,he,hc⟩ := hm
  refine ⟨b,o+a,d,hd,by omega,?_⟩
  intro t ht
  simpa only [Nat.add_assoc] using hc t ht

private theorem some_progression (r : Nat → Bool) : Mono135 r := by
  by_contra hn
  have eq0 : r 66 = r 67 := same_middle r (fun h => hn (shift (o:=0) (by decide)
    (by simpa using h)))
  have eq1 : r 67 = r 68 := same_middle (fun i => r (1+i))
    (fun h => hn (shift (o:=1) (by decide) h))
  cases h : r 67 with
  | false =>
    apply hn
    refine ⟨false,66,1,by decide,by decide,?_⟩
    intro t ht
    change t ≤ 2 at ht
    interval_cases t <;> first | exact eq0.trans h | exact h | exact eq1.symm.trans h
  | true => exact hn (OMA.Window131.center (eq0.trans h) h (eq1.symm.trans h))


