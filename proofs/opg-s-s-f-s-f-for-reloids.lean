import OMAStatements.S_opg_s_s_f_s_f_for_reloids
import Mathlib.Order.Filter.Basic

/-!
# `S(S(f)) = S(f)` fails for reloids

Problem: https://lefttosolve.com/p/opg-s-s-f-s-f-for-reloids

The formal statement asserts `S (S f) = S f` for every filter `f` on `A × A`, where
`S f = ⨆ n, fⁿ`. We give a counterexample on `A = ℕ × ℕ` (a point is `(label, level)`).

* `E 1 c` is the relation "go up one level, to a point whose label is at least `c`", and `f` is
  the filter generated by the decreasing chain `E 1 0 ⊇ E 1 1 ⊇ ⋯`.
* `fⁱ` (for `i ≥ 1`) is exactly the filter generated by the chain `E i c`, `c ∈ ℕ`, where `E i c`
  is "go up `i` levels, to a point whose label is at least `c`" (`pow_sub`, `pow_mem`).
* `K` = the diagonal together with all pairs "go up `m ≥ 1` levels, to a label at least `m`".
  Since `E n n ⊆ K`, the set `K` lies in every `fⁿ`, so `K ∈ S f`.
* A member `G` of `S f` contains `E 1 c` for one fixed `c`, and a member `F` of `S f` contains
  some `E i c'` for every `i`. Hence `G ∘ F` contains every pair "go up at least two levels, to a
  label at least `c`" (`W c`): the label threshold of the last step is the fixed number `c`,
  however many levels are climbed. So every member of `(S f)²` contains some `W c`.
* `K` contains no `W c`: the pair `((0, 0), (c, c + 2))` climbs `c + 2` levels to the label `c`.
  So `K ∉ (S f)²`, hence `K ∉ S (S f)`, although `K ∈ S f`.
-/

open OMA.S_opg_s_s_f_s_f_for_reloids

namespace OMA.ReloidSSProof

/-- Points: `(label, level)`. -/
abbrev P := ℕ × ℕ

/-- `E 0 c` is the diagonal; for `i ≥ 1`, `E i c` is "up `i` levels, target label `≥ c`". -/
def E (i c : ℕ) : Set (P × P) :=
  {p | (i = 0 ∧ p.1 = p.2) ∨ (1 ≤ i ∧ p.2.2 = p.1.2 + i ∧ c ≤ p.2.1)}

theorem E_anti {i c c' : ℕ} (h : c ≤ c') : E i c' ⊆ E i c := by
  rintro p (⟨h0, hp⟩ | ⟨h1, h2, h3⟩)
  · exact Or.inl ⟨h0, hp⟩
  · exact Or.inr ⟨h1, h2, le_trans h h3⟩

/-- The filter generated by the chain `E i c`, `c ∈ ℕ`. -/
def Psi (i : ℕ) : Filter (P × P) where
  sets := {s | ∃ c, E i c ⊆ s}
  univ_sets := ⟨0, Set.subset_univ _⟩
  sets_of_superset := fun ⟨c, hc⟩ h => ⟨c, hc.trans h⟩
  inter_sets := fun ⟨c, hc⟩ ⟨d, hd⟩ =>
    ⟨max c d, Set.subset_inter ((E_anti (le_max_left c d)).trans hc)
      ((E_anti (le_max_right c d)).trans hd)⟩

/-- The counterexample reloid. -/
def f : Filter (P × P) := Psi 1

/-- "Up at least two levels, target label `≥ c`". -/
def W (c : ℕ) : Set (P × P) := {p | p.1.2 + 2 ≤ p.2.2 ∧ c ≤ p.2.1}

theorem W_anti {c c' : ℕ} (h : c ≤ c') : W c' ⊆ W c := by
  rintro p ⟨h1, h2⟩
  exact ⟨h1, le_trans h h2⟩

/-- The filter generated by the chain `W c`. -/
def Theta : Filter (P × P) where
  sets := {s | ∃ c, W c ⊆ s}
  univ_sets := ⟨0, Set.subset_univ _⟩
  sets_of_superset := fun ⟨c, hc⟩ h => ⟨c, hc.trans h⟩
  inter_sets := fun ⟨c, hc⟩ ⟨d, hd⟩ =>
    ⟨max c d, Set.subset_inter ((W_anti (le_max_left c d)).trans hc)
      ((W_anti (le_max_right c d)).trans hd)⟩

/-- The separating set. -/
def K : Set (P × P) := {p | p.1 = p.2 ∨ (p.1.2 < p.2.2 ∧ p.2.2 - p.1.2 ≤ p.2.1)}

theorem pow_succ (g : Filter (P × P)) (n : ℕ) :
    rldPow g (n + 1) = rldComp g (rldPow g n) := rfl

/-- Every member of `fⁱ` contains some `E i c`. -/
theorem pow_sub : ∀ i : ℕ, ∀ s ∈ rldPow f i, ∃ c, E i c ⊆ s := by
  intro i
  induction i with
  | zero =>
    intro s hs
    refine ⟨0, ?_⟩
    have hs' : {p : P × P | p.1 = p.2} ⊆ s := Filter.mem_principal.1 hs
    rintro p (⟨_, hp⟩ | ⟨h1, _, _⟩)
    · exact hs' hp
    · omega
  | succ i ih =>
    have key : Psi (i + 1) ≤ rldPow f (i + 1) := by
      rw [pow_succ]
      refine Filter.le_generate_iff.2 ?_
      rintro s ⟨F, hF, G, hG, rfl⟩
      obtain ⟨c2, h2⟩ := ih F hF
      obtain ⟨c1, h1⟩ : ∃ c, E 1 c ⊆ G := hG
      refine ⟨max c1 c2, ?_⟩
      rintro p (⟨h0, _⟩ | ⟨_, hl, hc⟩)
      · omega
      · rcases Nat.eq_zero_or_pos i with hi | hi
        · subst hi
          refine ⟨p.1, h2 (Or.inl ⟨rfl, rfl⟩), h1 (Or.inr ⟨le_refl _, ?_, ?_⟩)⟩
          · show p.2.2 = p.1.2 + 1
            omega
          · show c1 ≤ p.2.1
            exact le_trans (le_max_left _ _) hc
        · refine ⟨(c2, p.1.2 + i), h2 (Or.inr ⟨hi, rfl, le_refl _⟩),
            h1 (Or.inr ⟨le_refl _, ?_, ?_⟩)⟩
          · show p.2.2 = p.1.2 + i + 1
            omega
          · show c1 ≤ p.2.1
            exact le_trans (le_max_left _ _) hc
    intro s hs
    exact key hs

/-- Every `E i c` is a member of `fⁱ`. -/
theorem pow_mem : ∀ i c : ℕ, E i c ∈ rldPow f i := by
  intro i
  induction i with
  | zero =>
    intro c
    refine Filter.mem_principal.2 ?_
    intro p hp
    exact Or.inl ⟨rfl, hp⟩
  | succ i ih =>
    intro c
    rw [pow_succ]
    have hgen : relComp (E 1 c) (E i c) ∈ rldComp f (rldPow f i) :=
      Filter.mem_generate_of_mem ⟨E i c, ih c, E 1 c, ⟨c, subset_rfl⟩, rfl⟩
    refine Filter.mem_of_superset hgen ?_
    rintro p ⟨b, hb1, hb2⟩
    rcases hb2 with ⟨h10, _⟩ | ⟨_, hl2, hc2⟩
    · omega
    · have hl2' : p.2.2 = b.2 + 1 := hl2
      have hc2' : c ≤ p.2.1 := hc2
      rcases hb1 with ⟨h0, hpb⟩ | ⟨hi, hl, _⟩
      · have hpb' : p.1 = b := hpb
        refine Or.inr ⟨by omega, ?_, hc2'⟩
        rw [hl2', ← hpb', h0]
      · have hl' : b.2 = p.1.2 + i := hl
        refine Or.inr ⟨by omega, ?_, hc2'⟩
        omega

theorem K_mem : K ∈ S f := by
  show K ∈ ⨆ n, rldPow f n
  refine Filter.mem_iSup.2 fun n => ?_
  refine Filter.mem_of_superset (pow_mem n n) ?_
  rintro p (⟨_, hp⟩ | ⟨h1, hl, hc⟩)
  · exact Or.inl hp
  · refine Or.inr ⟨?_, ?_⟩
    · omega
    · omega

/-- `g ≤ g¹`: every member of `g ∘ id` is a member of `g`. -/
theorem le_pow_one (g : Filter (P × P)) : g ≤ rldPow g (0 + 1) := by
  rw [pow_succ]
  refine Filter.le_generate_iff.2 ?_
  rintro s ⟨F, hF, G, hG, rfl⟩
  have hF' : {p : P × P | p.1 = p.2} ⊆ F := Filter.mem_principal.1 hF
  refine Filter.mem_of_superset hG ?_
  intro p hp
  exact ⟨p.1, hF' (show (p.1, p.1).1 = (p.1, p.1).2 from rfl), hp⟩

/-- Every member of `(S f)²` contains some `W c`. -/
theorem theta_le : Theta ≤ rldPow (S f) (0 + 1 + 1) := by
  rw [pow_succ]
  refine Filter.le_generate_iff.2 ?_
  rintro s ⟨F, hF, G, hG, rfl⟩
  have hF' : F ∈ S f := le_pow_one (S f) hF
  have hFi : ∀ i, F ∈ rldPow f i := Filter.mem_iSup.1 hF'
  have hG1 : G ∈ rldPow f 1 := Filter.mem_iSup.1 hG 1
  obtain ⟨c, hc⟩ := pow_sub 1 G hG1
  refine ⟨c, ?_⟩
  rintro p ⟨hp1, hp2⟩
  obtain ⟨c', hc'⟩ := pow_sub (p.2.2 - p.1.2 - 1) F (hFi _)
  refine ⟨(c', p.1.2 + (p.2.2 - p.1.2 - 1)), hc' (Or.inr ⟨by omega, rfl, le_refl _⟩),
    hc (Or.inr ⟨le_refl _, ?_, hp2⟩)⟩
  show p.2.2 = p.1.2 + (p.2.2 - p.1.2 - 1) + 1
  omega

theorem K_not_mem : K ∉ S (S f) := by
  intro h
  have h2 : K ∈ rldPow (S f) (0 + 1 + 1) :=
    (Filter.mem_iSup (f := fun n => rldPow (S f) n)).1 h (0 + 1 + 1)
  obtain ⟨c, hc⟩ : ∃ c, W c ⊆ K := theta_le h2
  have hmem : (((0, 0), (c, c + 2)) : P × P) ∈ W c := by
    refine ⟨?_, le_refl _⟩
    show 0 + 2 ≤ c + 2
    omega
  rcases hc hmem with h | ⟨_, h⟩
  · have h' : (0 : ℕ) = c + 2 := congrArg Prod.snd h
    omega
  · have h' : c + 2 - 0 ≤ c := h
    omega

end OMA.ReloidSSProof

theorem OMA.disproof : ¬ (type_of% @OMA.S_opg_s_s_f_s_f_for_reloids.main) := by
  intro h
  have heq := h OMA.ReloidSSProof.P OMA.ReloidSSProof.f
  apply OMA.ReloidSSProof.K_not_mem
  rw [heq]
  exact OMA.ReloidSSProof.K_mem
