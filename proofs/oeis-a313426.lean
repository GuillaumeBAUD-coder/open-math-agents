/-- The denominator times A, as a sum of monomials. -/
theorem gf_den (A : ℚ⟦X⟧) : A * ((X - 1) ^ 2 * (X ^ 2 + 1) * (X ^ 4 + 1) * (X ^ 4 + X ^ 3 + X ^ 2 + X + 1) ^ 2) = C 1 * A + C 1 * (A * X ^ 2) + C 1 * (A * X ^ 4) - C 2 * (A * X ^ 5) + C 1 * (A * X ^ 6) - C 2 * (A * X ^ 7) - C 2 * (A * X ^ 9) + C 1 * (A * X ^ 10) - C 2 * (A * X ^ 11) + C 1 * (A * X ^ 12) + C 1 * (A * X ^ 14) + C 1 * (A * X ^ 16) := by
  simp only [map_ofNat, map_one]
  ring

