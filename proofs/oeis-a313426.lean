/-- The numerator as a sum of monomials. -/
theorem gf_num : ((X + 1) ^ 2 * (X ^ 2 - X + 1) * (X ^ 12 + 4 * X ^ 11 + 7 * X ^ 10 + 10 * X ^ 9 + 15 * X ^ 8 + 16 * X ^ 7 + 16 * X ^ 6 + 16 * X ^ 5 + 15 * X ^ 4 + 10 * X ^ 3 + 7 * X ^ 2 + 4 * X + 1) : ℚ⟦X⟧) = X ^ 0 * C 1 + X ^ 1 * C 5 + X ^ 2 * C 11 + X ^ 3 * C 18 + X ^ 4 * C 30 + X ^ 5 * C 42 + X ^ 6 * C 49 + X ^ 7 * C 57 + X ^ 8 * C 62 + X ^ 9 * C 57 + X ^ 10 * C 49 + X ^ 11 * C 42 + X ^ 12 * C 30 + X ^ 13 * C 18 + X ^ 14 * C 11 + X ^ 15 * C 5 + X ^ 16 * C 1 := by
  simp only [map_ofNat, map_one]
