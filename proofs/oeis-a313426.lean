/-- The generating function. -/
theorem gf : PowerSeries.mk (fun n => (a n : ℚ)) * ((X - 1) ^ 2 * (X ^ 2 + 1) * (X ^ 4 + 1) * (X ^ 4 + X ^ 3 + X ^ 2 + X + 1) ^ 2) =
      (X + 1) ^ 2 * (X ^ 2 - X + 1) * (X ^ 12 + 4 * X ^ 11 + 7 * X ^ 10 + 10 * X ^ 9 + 15 * X ^ 8 + 16 * X ^ 7 + 16 * X ^ 6 + 16 * X ^ 5 + 15 * X ^ 4 + 10 * X ^ 3 + 7 * X ^ 2 + 4 * X + 1) := by
  set A : ℚ⟦X⟧ := PowerSeries.mk (fun n => (a n : ℚ)) with hA
  rw [gf_den A, gf_num]
  ext n
  have hc : ∀ k, coeff k A = (b k : ℚ) := fun k => by rw [hA, coeff_mk, a_eq_b]
