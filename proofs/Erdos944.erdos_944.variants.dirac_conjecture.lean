private theorem table_sub : ∀ x y : Vertex, tableAdj x y = true → adjB x y = true := by
  decide

theorem tablePuncture_sub (d x y : Vertex) (h : tablePuncture d x y = true) :
    (graph.deleteEdges {s(0,d)}).Adj x y := by
  apply (puncture_eq d x y).1
  simp only [tablePuncture, Bool.and_eq_true] at h
  simp only [puncture, Bool.and_eq_true]
  exact ⟨table_sub x y h.1,h.2⟩

theorem not_colorable_origin {d a : Vertex}
    (hedge : tablePuncture d 0 a = true) (hcert : refutes (tablePuncture d) (initially a)) :
    ¬ (graph.deleteEdges {s(0,d)}).Colorable 3 := by
  rintro ⟨f⟩
  have hneq := f.valid (tablePuncture_sub d 0 a hedge)
  obtain ⟨p,h0,h1⟩ := paint_permutation (f 0) (f a) hneq
  apply hcert (fun x => p (f x)) ?_ (initially_consistent h0 h1)
  intro x y hxy he
  exact f.valid (tablePuncture_sub d x y hxy) (p.injective he)

theorem transport_edge (e : graph ≃g graph) (a b : Vertex)
    (h : ¬ (graph.deleteEdges {s(a,b)}).Colorable 3) :
    ¬ (graph.deleteEdges {s(e a,e b)}).Colorable 3 := by
  rintro ⟨c⟩
  apply h
  refine ⟨SimpleGraph.Coloring.mk (fun x => c (e x)) ?_⟩
  intro x y hxy
  obtain ⟨hadj,hnot⟩ := SimpleGraph.deleteEdges_adj.1 hxy
  apply c.valid
  refine SimpleGraph.deleteEdges_adj.2 ⟨e.map_rel_iff.2 hadj, ?_⟩
  simp only [Set.mem_singleton_iff, Sym2.eq_iff] at hnot ⊢
  rintro (⟨hx,hy⟩ | ⟨hx,hy⟩)
  · exact hnot (Or.inl ⟨e.injective hx,e.injective hy⟩)
  · exact hnot (Or.inr ⟨e.injective hx,e.injective hy⟩)

theorem no_three_after_edge
    (h5 : ¬ (graph.deleteEdges {s((0:Vertex),5)}).Colorable 3)
    (h26 : ¬ (graph.deleteEdges {s((0:Vertex),26)}).Colorable 3)
    (h30 : ¬ (graph.deleteEdges {s((0:Vertex),30)}).Colorable 3)
    (h33 : ¬ (graph.deleteEdges {s((0:Vertex),33)}).Colorable 3) (q : Sym2 Vertex) :
    ¬ (graph.deleteEdges {q}).Colorable 3 := by
  have hbase : ¬ graph.Colorable 3 := fun hc =>
    h5 (hc.mono_left (fun _ _ hadj => (SimpleGraph.deleteEdges_adj.1 hadj).1))
  have h55 : ¬ (graph.deleteEdges {s((0:Vertex),55)}).Colorable 3 := by
    have h := transport_edge (transitiveIso 55) 0 5 h5
    rw [transitiveIso_zero, show transitiveIso 55 5 = 0 by decide, Sym2.eq_swap] at h
    exact h
  have h37 : ¬ (graph.deleteEdges {s((0:Vertex),37)}).Colorable 3 := by
    have h := transport_edge (transitiveIso 37) 0 26 h26
    rw [transitiveIso_zero, show transitiveIso 37 26 = 0 by decide, Sym2.eq_swap] at h
    exact h
  have horigin (d : Vertex) (hd : graph.Adj 0 d) :
      ¬ (graph.deleteEdges {s((0:Vertex),d)}).Colorable 3 := by
    have hh := (adjB_iff 0 d).1 hd
    obtain ⟨i, rfl⟩ := hh
    fin_cases i
    · exact h5
    · exact h55
    · exact h26
    · exact h37
    · exact h30
    · exact h33
  induction q using Sym2.inductionOn with
  | hf a b =>
    by_cases h : graph.Adj a b
    · let e := transitiveIso a
      have ha : e 0 = a := transitiveIso_zero a
      have hh : graph.Adj 0 (e.symm b) := by
        apply e.map_rel_iff.1
        rwa [ha, RelIso.apply_symm_apply]
      have h' := transport_edge e 0 (e.symm b) (horigin _ hh)
      rwa [ha, RelIso.apply_symm_apply] at h'
    · intro hc
      apply hbase
      apply hc.mono_left
      intro x y hxy
      refine SimpleGraph.deleteEdges_adj.2 ⟨hxy, ?_⟩
      simp only [Set.mem_singleton_iff, Sym2.eq_iff]
      rintro (⟨rfl,rfl⟩ | ⟨rfl,rfl⟩)
      · exact h hxy
      · exact h hxy.symm

