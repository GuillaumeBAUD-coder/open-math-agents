private theorem assemble {V : Type u} [Fintype V] [DecidableEq V] (G : SimpleGraph V) (v₀ : V)
    (hdel : ∀ v : V, ∃ c : {x : V // x ≠ v} → Paint,
      ∀ x y, G.Adj x.val y.val → c x ≠ c y)
    (hn : ∀ e : Sym2 V, ¬ (G.deleteEdges {e}).Colorable 3) :
    G.IsErdos944 4 1 := by
  classical
  have hbase : ¬ G.Colorable 3 := fun hc =>
    hn s(v₀,v₀) (hc.mono_left (fun _ _ hadj => (SimpleGraph.deleteEdges_adj.1 hadj).1))
  have hc : G.Colorable 4 := by
    obtain ⟨c,hc⟩ := hdel v₀
    let g (x : V) : Fin 4 :=
      if hx : x = v₀ then Fin.last 3 else (c ⟨x,hx⟩).castSucc
    refine ⟨SimpleGraph.Coloring.mk g ?_⟩
    intro x y hxy
    by_cases hx : x = v₀ <;> by_cases hy : y = v₀
    · exact (hxy.ne (hx.trans hy.symm)).elim
    · rw [show g x = Fin.last 3 from dif_pos hx,
        show g y = (c ⟨y,hy⟩).castSucc from dif_neg hy]
      exact (Fin.castSucc_ne_last _).symm
    · rw [show g x = (c ⟨x,hx⟩).castSucc from dif_neg hx,
        show g y = Fin.last 3 from dif_pos hy]
      exact Fin.castSucc_ne_last _
    · simpa [g,hx,hy] using hc ⟨x,hx⟩ ⟨y,hy⟩ hxy
  have hχ : G.chromaticNumber = (3 : ℕ∞)+1 :=
    SimpleGraph.chromaticNumber_eq_iff_colorable_not_colorable.mpr ⟨hc,hbase⟩
  refine ⟨⟨hχ,?_⟩,?_⟩
  · intro v
    obtain ⟨c,hc⟩ := hdel v
    let H := (⊤ : G.Subgraph).deleteVerts ({v} : Set V)
    have hv (x : H.verts) : x.val ≠ v := x.property.2
    have hcol : H.coe.Colorable 3 :=
      ⟨SimpleGraph.Coloring.mk (fun x => c ⟨x.val,hv x⟩) (by
        intro x y hxy
        exact hc _ _ (H.coe_adj_sub x y hxy))⟩
    change H.coe.chromaticNumber < (⊤ : G.Subgraph).coe.chromaticNumber
    have htop := SimpleGraph.chromaticNumber_mono_of_hom
      (SimpleGraph.Subgraph.topIso (G := G)).symm.toHom
    apply lt_of_lt_of_le _ htop
    rw [hχ]
    exact hcol.chromaticNumber_le.trans_lt (ENat.natCast_lt_add_one_iff.mpr le_rfl)
  · intro edges hcrit
    by_contra! hncard
    let _ : Nonempty (Sym2 V) := ⟨s(v₀,v₀)⟩
    obtain ⟨e,he⟩ := (Set.ncard_le_one_iff_subset_singleton (s := edges)).mp hncard
    have hlt : (G.deleteEdges edges).chromaticNumber < (3 : ℕ∞)+1 := hχ ▸ hcrit
    have hle : (G.deleteEdges edges).chromaticNumber ≤ (3 : ℕ∞) :=
      (ENat.lt_add_one_iff (ENat.natCast_ne_top 3)).mp hlt
    exact hn e ((SimpleGraph.chromaticNumber_le_iff_colorable.mp hle).mono_left
      (SimpleGraph.deleteEdges_anti he))

