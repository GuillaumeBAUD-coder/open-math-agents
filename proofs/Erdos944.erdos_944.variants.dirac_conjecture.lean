open Erdos944
open scoped Sym2

namespace DiracFour

abbrev Vertex := Fin 60
abbrev Paint := Fin 3

def multiply (x y : Vertex) : Vertex :=
  Fin.ofNat 60 (5*((x.val/5+y.val/5)%12)+(x.val%5+2^(x.val/5)*(y.val%5))%5)

def directions : List Vertex := [5, 55, 26, 37, 30, 33]

def adjB (x y : Vertex) : Bool := (directions.map (multiply x)).contains y

def puncture (d x y : Vertex) : Bool :=
  adjB x y && !((x == 0 && y == d) || (x == d && y == 0))

def adjacencyMasks : Array ℕ := #[
  36028944188702752, 72057888377405504, 144115743468814464, 288230421785739520, 576460842531291648,
  17699560227841, 1314259994626, 2628519989252, 5223753981960, 9382356074512,
