  2858730233267200, 4626744931780608, 9219405003100160, 18438810006200320, 1974722900279296,
  154318656015204352, 308637312030408704, 582371726948696064, 47850746309509120, 94610777084264448,
  112589991759052816, 225179983518105601, 450359967036211202, 865817036960301060, 614741366332719112,
  576460786696716549, 36028865805550090, 72057731611099188, 144115463222198345, 288230926444396690,
  1100585372200, 2201170743408, 4402341486785, 8804682973570, 17609365915396,
  35218731967552, 70437463935104, 140874927838464, 281749854661120, 563499709321248,
  1126999435350016, 2253998838194176, 4507997676388352, 9015995352744960, 18031990704474112,
  36063981665255424, 72127963329495040, 144255925618802688, 288511851205099520, 577023702410199040,
  1125902633140225, 2251804226093058, 4503608419680260, 9007216839360520, 18014400392724496]

def tableAdj (x y : Vertex) : Bool := (adjacencyMasks[x.val]!).testBit y.val

def tablePuncture (d x y : Vertex) : Bool :=
  tableAdj x y && !((x == 0 && y == d) || (x == d && y == 0))

abbrev State := ℕ × ℕ × ℕ

def singletonMask (v : Vertex) : ℕ := 1 <<< v.val

theorem mem_singletonMask (v w : Vertex) :
    (singletonMask v).testBit w.val = true ↔ w = v := by
  simp only [singletonMask, Nat.testBit_shiftLeft, Bool.and_eq_true,
    decide_eq_true_eq, Nat.testBit_one_eq_true_iff_self_eq_zero]
  exact ⟨fun h => Fin.ext (by omega), fun h => by subst w; simp⟩

def bits (s : State) (c : Paint) : ℕ :=
  if c = 0 then s.1 else if c = 1 then s.2.1 else s.2.2

def initially (a : Vertex) : State := (singletonMask 0, singletonMask a, 0)

def addPending (s : State) : Option (Vertex × Paint) → State
  | none => s
  | some (v,c) =>
    if c = 0 then (s.1 ||| singletonMask v, s.2)
    else if c = 1 then (s.1, s.2.1 ||| singletonMask v, s.2.2)
    else (s.1, s.2.1, s.2.2 ||| singletonMask v)

theorem bits_add (s : State) (v : Vertex) (c d : Paint) :
    bits (addPending s (some (v,c))) d =
      if d = c then bits s d ||| singletonMask v else bits s d := by
  fin_cases c <;> fin_cases d <;> rfl

/-- A token below 60 branches on that vertex. A token at least 60 names a vertex of the
    earlier assignment that rules out the current branch. -/
def tokenVertex (n : ℕ) : Vertex := Fin.ofNat 60 n

def replay (adj : Vertex → Vertex → Bool) :
    Nat → State → Option (Vertex × Paint) → List ℕ → Option (List ℕ)
  | 0, _, _, _ => none
  | _+1, _, _, [] => none
  | fuel+1, state, p, token :: tail =>
    if 60 ≤ token then
      match p with
      | some (v,c) =>
        if adj v (tokenVertex token) && (bits state c).testBit (tokenVertex token).val
          then some tail else none
      | none => none
    else
      let v := tokenVertex token
      let state' := addPending state p
      (replay adj fuel state' (some (v,0)) tail).bind fun t =>
        (replay adj fuel state' (some (v,1)) t).bind fun u =>
          replay adj fuel state' (some (v,2)) u

def consistent (state : State) (f : Vertex → Paint) : Prop :=
  ∀ v c, (bits state c).testBit v.val = true → f v = c

def pending (f : Vertex → Paint) : Option (Vertex × Paint) → Prop
  | none => True
  | some (v,c) => f v = c

theorem consistent_addPending {state : State} {f : Vertex → Paint}
    (hs : consistent state f) {p : Option (Vertex × Paint)} (hp : pending f p) :
    consistent (addPending state p) f := by
  cases p with
  | none => exact hs
  | some pair =>
    obtain ⟨v,c⟩ := pair
    intro w d hw
    rw [bits_add] at hw
    by_cases h : d = c
    · subst d
      rw [if_pos rfl, Nat.testBit_or, Bool.or_eq_true] at hw
      rcases hw with hw | hw
      · exact hs w c hw
      · rwa [(mem_singletonMask v w).1 hw]
    · apply hs w d
      simpa only [if_neg h] using hw

theorem replay_sound (adj : Vertex → Vertex → Bool) (f : Vertex → Paint)
    (hproper : ∀ x y, adj x y = true → f x ≠ f y)
    (fuel : Nat) (state : State) (p : Option (Vertex × Paint)) (code : List ℕ)
    (hs : consistent state f) (hp : pending f p) :
    replay adj fuel state p code = none := by
  induction fuel generalizing state p code with
  | zero => rfl
  | succ fuel ih =>
    cases code with
    | nil => rfl
    | cons token tail =>
      by_cases ht : 60 ≤ token
      · simp only [replay, ht, if_pos]
        cases p with
        | none => rfl
        | some pair =>
          obtain ⟨v,c⟩ := pair
          let w := tokenVertex token
          change (if adj v w && ((bits state c).testBit w.val) then some tail else none) = none
          have hbad : ¬(adj v w && ((bits state c).testBit w.val)) = true := by
            intro h
            have hab : adj v w = true ∧ ((bits state c).testBit w.val) = true := by
              simpa only [Bool.and_eq_true] using h
            exact hproper v w hab.1 (hp.trans (hs w c hab.2).symm)
          simp [hbad]
      · simp only [replay, ht]
        let v := tokenVertex token
        let S := addPending state p
        have hS : consistent S f := consistent_addPending hs hp
        change ((replay adj fuel S (some (v,0)) tail).bind fun t =>
          (replay adj fuel S (some (v,1)) t).bind fun u =>
            replay adj fuel S (some (v,2)) u) = none
        have hcolors : f v = 0 ∨ f v = 1 ∨ f v = 2 := by
          have hlt := (f v).isLt
          have hn : (f v).val = 0 ∨ (f v).val = 1 ∨ (f v).val = 2 := by omega
          rcases hn with h | h | h
          · exact Or.inl (Fin.ext h)
          · exact Or.inr (Or.inl (Fin.ext h))
          · exact Or.inr (Or.inr (Fin.ext h))
        rcases hcolors with h₀ | h₁ | h₂
        · simp [ih S (some (v,0)) tail hS h₀]
        · cases he : replay adj fuel S (some (v,0)) tail with
          | none => rfl
          | some t => simp [ih S (some (v,1)) t hS h₁]
        · cases he : replay adj fuel S (some (v,0)) tail with
          | none => rfl
          | some t =>
            simp only [Option.bind_some]
            cases he' : replay adj fuel S (some (v,1)) t with
            | none => rfl
            | some u => exact ih S (some (v,2)) u hS h₂


def refutes (adj : Vertex → Vertex → Bool) (s : State) : Prop :=
  ∀ f : Vertex → Paint, (∀ v w, adj v w = true → f v ≠ f w) → consistent s f → False

theorem refutes_replay {adj : Vertex → Vertex → Bool} {s : State} {code : List ℕ} {fuel : ℕ}
    (h : (replay adj fuel s none code).isSome = true) : refutes adj s := by
  intro f hf hs
  rw [replay_sound adj f hf fuel s none code hs trivial] at h
  cases h

def generator (i : Fin 6) : Vertex := directions[i.val]!

theorem generator_mem (i : Fin 6) : generator i ∈ directions := by
  fin_cases i <;> decide

theorem mem_generators {v : Vertex} (h : v ∈ directions) :
    ∃ i : Fin 6, generator i = v := by
  exact (show ∀ x : Vertex, x ∈ directions → ∃ i : Fin 6, generator i = x by decide) v h

theorem adjB_iff (x y : Vertex) :
    adjB x y = true ↔ ∃ i : Fin 6, multiply x (generator i) = y := by
  simp only [adjB, List.contains_iff_mem, List.mem_map]
  constructor
  · rintro ⟨g,hg,rfl⟩
    obtain ⟨i, rfl⟩ := mem_generators hg
    exact ⟨i,rfl⟩
  · rintro ⟨i,rfl⟩
    exact ⟨generator i,generator_mem i,rfl⟩

set_option maxRecDepth 25000 in
set_option maxHeartbeats 0 in
private theorem adjB_reverse (x : Vertex) (i : Fin 6) :
    adjB (multiply x (generator i)) x = true := by
  revert x i
  decide

set_option maxRecDepth 25000 in
set_option maxHeartbeats 0 in
private theorem adjB_nondiagonal (x : Vertex) : adjB x x = false := by
  revert x
  decide

def graph : SimpleGraph Vertex where
  Adj x y := adjB x y = true
  symm := by
    constructor
    intro x y h
    obtain ⟨i,rfl⟩ := (adjB_iff x y).1 h
    exact adjB_reverse x i
  loopless := by
    constructor
    intro x h
    have hf := adjB_nondiagonal x
    simp_all

instance : DecidableRel graph.Adj :=
  fun x y => inferInstanceAs (Decidable (adjB x y = true))

theorem puncture_eq (d x y : Vertex) :
    puncture d x y = true ↔ (graph.deleteEdges {s(0,d)}).Adj x y := by
  simp only [puncture, graph, SimpleGraph.deleteEdges_adj, Bool.and_eq_true,
    Set.mem_singleton_iff, Sym2.eq_iff]
  grind

private def shiftA (v : Vertex) : Vertex := multiply 5 v
private def shiftB (v : Vertex) : Vertex := multiply 1 v
private def unshiftA (v : Vertex) : Vertex := multiply 55 v
private def unshiftB (v : Vertex) : Vertex := multiply 4 v

private theorem shift_preserves (T : Vertex ≃ Vertex)
    (hT : ∀ x i, T (multiply x (generator i)) = multiply (T x) (generator i))
    (x y : Vertex) : graph.Adj (T x) (T y) ↔ graph.Adj x y := by
  change adjB (T x) (T y) = true ↔ adjB x y = true
  rw [adjB_iff, adjB_iff]
  constructor
  · rintro ⟨i,h⟩
    exact ⟨i,T.injective ((hT x i).trans h)⟩
  · rintro ⟨i,h⟩
    exact ⟨i,(hT x i).symm.trans (congrArg T h)⟩

private def equivA : Vertex ≃ Vertex :=
  ⟨shiftA,unshiftA,by decide,by decide⟩

private def equivB : Vertex ≃ Vertex :=
  ⟨shiftB,unshiftB,by decide,by decide⟩

set_option maxRecDepth 25000 in
set_option maxHeartbeats 0 in
private theorem equivA_rule :
    ∀ (x : Vertex) (i : Fin 6),
      equivA (multiply x (generator i)) = multiply (equivA x) (generator i) := by
  decide

set_option maxRecDepth 25000 in
set_option maxHeartbeats 0 in
private theorem equivB_rule :
    ∀ (x : Vertex) (i : Fin 6),
      equivB (multiply x (generator i)) = multiply (equivB x) (generator i) := by
  decide

def automorphismA : graph ≃g graph :=
  ⟨equivA,shift_preserves equivA equivA_rule _ _⟩

def automorphismB : graph ≃g graph :=
  ⟨equivB,shift_preserves equivB equivB_rule _ _⟩

private def repeatIso (f : graph ≃g graph) : ℕ → graph ≃g graph
  | 0 => RelIso.refl graph.Adj
  | n+1 => (repeatIso f n).trans f

def transitiveIso (v : Vertex) : graph ≃g graph :=
  (repeatIso automorphismA (v.val/5)).trans (repeatIso automorphismB (v.val%5))

theorem transitiveIso_zero : ∀ v : Vertex, transitiveIso v 0 = v := by
  decide

def deletedPaint : Vertex → Paint := ![
  0, 2, 0, 0, 1, 0, 0, 2, 1, 0, 1, 2, 0, 0, 2, 2, 0, 1, 2, 1,
  1, 2, 2, 1, 0, 0, 0, 0, 2, 1, 2, 1, 2, 1, 0, 1, 2, 1, 0, 2,
  2, 0, 2, 1, 1, 1, 2, 0, 0, 0, 0, 0, 1, 2, 1, 2, 1, 2, 1, 0]

set_option maxRecDepth 25000 in
set_option maxHeartbeats 0 in
theorem deletedPaint_proper : ∀ x y : Vertex, x ≠ 0 → y ≠ 0 →
    graph.Adj x y → deletedPaint x ≠ deletedPaint y := by
  decide

theorem coloring_without_vertex (v : Vertex) :
    ∃ c : {x : Vertex // x ≠ v} → Paint,
      ∀ x y, graph.Adj x.val y.val → c x ≠ c y := by
  let e := transitiveIso v
  let c (x : {x : Vertex // x ≠ v}) := deletedPaint (e.symm x.val)
  have he (x : {x : Vertex // x ≠ v}) : e.symm x.val ≠ 0 := by
    intro h
    have h' := congrArg e h
    apply x.2
    simpa only [RelIso.apply_symm_apply, e, transitiveIso_zero] using h'
  exact ⟨c, fun x y h => deletedPaint_proper _ _ (he x) (he y) (e.symm.map_rel_iff.2 h)⟩

theorem paint_permutation (a b : Paint) (h : a ≠ b) :
    ∃ p : Equiv.Perm Paint, p a = 0 ∧ p b = 1 := by
  let f := Equiv.swap a 0
  have hf : f a = 0 := Equiv.swap_apply_left _ _
  have hne : a ≠ f.symm 1 := by
    intro heq
    have hh := congrArg f heq
    rw [hf, f.apply_symm_apply] at hh
    contradiction
  refine ⟨f.setValue b 1, ?_, Equiv.setValue_eq _ _ _⟩
  change f (Equiv.swap b (f.symm 1) a) = 0
  rwa [Equiv.swap_apply_of_ne_of_ne h hne]

theorem initially_consistent {a : Vertex} {f : Vertex → Paint} (h0 : f 0 = 0) (h1 : f a = 1) :
    consistent (initially a) f := by
  intro x c h
  fin_cases c
  · change (singletonMask 0).testBit x.val = true at h
    rwa [(mem_singletonMask 0 x).1 h]
  · change (singletonMask a).testBit x.val = true at h
    rwa [(mem_singletonMask a x).1 h]
  · change (0 : ℕ).testBit x.val = true at h
    simp at h

