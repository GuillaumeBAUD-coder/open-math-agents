private theorem recurrence (n : ℕ) (hn : 8 ≤ n) :
    (a n : ℚ) = 6 * (a (n-1) : ℚ) - 11 * (a (n-2) : ℚ) + 6 * (a (n-3) : ℚ) := by
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 8 := ⟨n - 8, by omega⟩
  have h : total (v (m+7)) = 6 * total (v (m+6)) - 11 * total (v (m+5)) + 6 * total (v (m+4)) := by
    simp only [total_eq]
    rw [Finset.mul_sum, Finset.mul_sum, Finset.mul_sum, ← Finset.sum_sub_distrib,
      ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [Finset.mul_sum, Finset.mul_sum, Finset.mul_sum, ← Finset.sum_sub_distrib,
      ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun j _ => ?_
    split_ifs with hij
    · exact differences m i j hij
    · ring
  have e0 := value (m+7)
  have e1 := value (m+6)
  have e2 := value (m+5)
  have e3 := value (m+4)
  simp only [show m + 8 - 1 = m + 6 + 1 by omega, show m + 8 - 2 = m + 5 + 1 by omega,
    show m + 8 - 3 = m + 4 + 1 by omega, show m + 8 = m + 7 + 1 by omega]
  have : (a (m+7+1) : ℤ) = 6 * a (m+6+1) - 11 * a (m+5+1) + 6 * a (m+4+1) := by
    rw [e0, e1, e2, e3]; exact h
  exact_mod_cast this

private theorem closed (n : ℕ) (hn : 4 < n) :
    (a n : ℚ) = 1655 + 247 * 2 ^ n + 49 * 3 ^ (n - 1) := by
  induction n using Nat.strong_induction_on with
  | h n ih =>
