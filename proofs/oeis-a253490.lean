private def T : Fin 8 → Fin 81 → Fin 81 → ℤ :=
  ![fun _ _ => 1, T1, T2, T3, T4, T5, T6, T7]

private theorem table_step0 : ∀ i j : Fin 81, pairOK (dec i) (dec j) →
    T 1 i j = stepC (T 0) i j := by decide +kernel

private theorem table_step1 : ∀ i j : Fin 81, pairOK (dec i) (dec j) →
    T 2 i j = stepC (T 1) i j := by decide +kernel

private theorem table_step2 : ∀ i j : Fin 81, pairOK (dec i) (dec j) →
    T 3 i j = stepC (T 2) i j := by decide +kernel

private theorem table_step3 : ∀ i j : Fin 81, pairOK (dec i) (dec j) →
    T 4 i j = stepC (T 3) i j := by decide +kernel

private theorem table_step4 : ∀ i j : Fin 81, pairOK (dec i) (dec j) →
    T 5 i j = stepC (T 4) i j := by decide +kernel

private theorem table_step5 : ∀ i j : Fin 81, pairOK (dec i) (dec j) →
    T 6 i j = stepC (T 5) i j := by decide +kernel

private theorem table_step6 : ∀ i j : Fin 81, pairOK (dec i) (dec j) →
    T 7 i j = stepC (T 6) i j := by decide +kernel

private theorem table_step (k : Fin 7) : ∀ i j : Fin 81, pairOK (dec i) (dec j) →
    T k.succ i j = stepC (T k.castSucc) i j := by
  fin_cases k
  · exact table_step0
  · exact table_step1
  · exact table_step2
  · exact table_step3
  · exact table_step4
  · exact table_step5
  · exact table_step6

private theorem initial_eq (k : Fin 8) : ∀ i j : Fin 81, pairOK (dec i) (dec j) →
    v k.val (dec i) (dec j) = T k i j := by
  induction k using Fin.induction with
  | zero =>
    intro i j _
    simp only [Fin.val_zero, zero_v]
    rfl
  | succ k ih =>
    intro i j hij
    simp only [Fin.val_castSucc] at ih
    rw [Fin.val_succ, succ_v, step_eq, table_step k i j hij]
    unfold stepC
    exact Finset.sum_congr rfl fun l hl => ih j l (mem_succ hl)

set_option maxHeartbeats 4000000 in
private theorem differences (n : ℕ) : ∀ i j : Fin 81, pairOK (dec i) (dec j) →
    v (n+7) (dec i) (dec j) = 6 * v (n+6) (dec i) (dec j) - 11 * v (n+5) (dec i) (dec j) +
      6 * v (n+4) (dec i) (dec j) := by
  induction n with
  | zero =>
    intro i j hij
    have e4 : v 4 (dec i) (dec j) = T 4 i j := initial_eq 4 i j hij
    have e5 : v 5 (dec i) (dec j) = T 5 i j := initial_eq 5 i j hij
    have e6 : v 6 (dec i) (dec j) = T 6 i j := initial_eq 6 i j hij
    have e7 : v 7 (dec i) (dec j) = T 7 i j := initial_eq 7 i j hij
    simp only [Nat.zero_add, e4, e5, e6, e7]
    clear e4 e5 e6 e7
    revert i j hij
    decide +kernel
  | succ n ih =>
    intro i j hij
    change v ((n+7)+1) (dec i) (dec j) = _
    rw [succ_v (n+7), step_eq]
    unfold stepC
    rw [Finset.sum_congr rfl (fun l hl => ih j l (mem_succ hl))]
    simp only [Finset.sum_add_distrib, Finset.sum_sub_distrib, ← Finset.mul_sum]
    have sum_v (t : ℕ) :
        (∑ l ∈ Finset.univ.filter (fun l : Fin 81 => next (dec i) (dec j) (dec l)),
          v t (dec j) (dec l)) = v (t+1) (dec i) (dec j) := by rw [succ_v, step_eq]; rfl
    simp only [sum_v]

private theorem initial_total (k : Fin 8) :
    total (v k.val) = ∑ i : Fin 81, ∑ j : Fin 81, if pairOK (dec i) (dec j) then T k i j else 0 := by
  rw [total_eq]
  refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
  split_ifs with h
  · exact initial_eq k i j h
  · rfl

