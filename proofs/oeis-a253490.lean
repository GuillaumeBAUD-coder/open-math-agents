private abbrev Row := Fin 4 → Fin 3

/-- The value of the 2 X 2 block of rows p, q at columns j, j + 1. -/
private def Dv (p q : Row) (j : ℕ) (hj : j < 3) : ℤ :=
  ((p ⟨j, by omega⟩).val : ℤ) + ((q ⟨j + 1, by omega⟩).val : ℤ) -
    ((p ⟨j + 1, by omega⟩).val : ℤ) - ((q ⟨j, by omega⟩).val : ℤ)

private def pairOK (p q : Row) : Prop :=
  Dv p q 0 (by omega) ≤ Dv p q 1 (by omega) ∧ Dv p q 1 (by omega) ≤ Dv p q 2 (by omega)

private instance (p q : Row) : Decidable (pairOK p q) := by unfold pairOK; infer_instance

private def vert (p q r : Row) : Prop :=
  Dv p q 0 (by omega) ≤ Dv q r 0 (by omega) ∧ Dv p q 1 (by omega) ≤ Dv q r 1 (by omega) ∧
    Dv p q 2 (by omega) ≤ Dv q r 2 (by omega)

private def anti (p q r : Row) : Prop :=
  Dv p q 1 (by omega) ≤ Dv q r 0 (by omega) ∧ Dv p q 2 (by omega) ≤ Dv q r 1 (by omega)

private def next (p q r : Row) : Prop := pairOK q r ∧ vert p q r ∧ anti p q r

private instance (p q r : Row) : Decidable (next p q r) := by
  unfold next vert anti; infer_instance

private theorem fin4_cases (j j' j'' : Fin 4) (h1 : j'.val = j.val + 1) (h2 : j''.val = j'.val + 1) :
    (j = 0 ∧ j' = 1 ∧ j'' = 2) ∨ (j = 1 ∧ j' = 2 ∧ j'' = 3) := by
  fin_cases j <;> fin_cases j' <;> fin_cases j'' <;> simp_all

private theorem fin4_cases2 (j j' : Fin 4) (h1 : j'.val = j.val + 1) :
    (j = 0 ∧ j' = 1) ∨ (j = 1 ∧ j' = 2) ∨ (j = 2 ∧ j' = 3) := by
  fin_cases j <;> fin_cases j' <;> simp_all

private theorem hor_iff {m : ℕ} (x : Fin (m + 1) → Row) :
    Horizontal x ↔ ∀ i : Fin m, pairOK (x i.castSucc) (x i.succ) := by
  constructor
  · intro h i
    exact ⟨h i.castSucc i.succ (by simp) 0 1 2 rfl rfl, h i.castSucc i.succ (by simp) 1 2 3 rfl rfl⟩
  · intro h i i' hi j j' j'' hj hj'
    have hlt : i.val < m := by omega
    have e1 : i = (⟨i.val, hlt⟩ : Fin m).castSucc := Fin.ext rfl
    have e2 : i' = (⟨i.val, hlt⟩ : Fin m).succ := Fin.ext (by simp [hi])
    have hh := h ⟨i.val, hlt⟩
    rw [← e1, ← e2] at hh
    rcases fin4_cases j j' j'' hj hj' with ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩
    · exact hh.1
    · exact hh.2

private theorem vert_iff {m : ℕ} (x : Fin (m + 2) → Row) :
    Vertical x ↔ ∀ i : Fin m, vert (x i.castSucc.castSucc) (x i.castSucc.succ) (x i.succ.succ) := by
  constructor
  · intro h i
    have hs := fun j j' (hj : j'.val = j.val + 1) =>
      h i.castSucc.castSucc i.castSucc.succ i.succ.succ (by simp) (by simp) j j' hj
    exact ⟨hs 0 1 rfl, hs 1 2 rfl, hs 2 3 rfl⟩
  · intro h i i' i'' hi hi' j j' hj
    have hlt : i.val < m := by omega
    have e1 : i = (⟨i.val, hlt⟩ : Fin m).castSucc.castSucc := Fin.ext rfl
    have e2 : i' = (⟨i.val, hlt⟩ : Fin m).castSucc.succ := Fin.ext (by simp [hi])
    have e3 : i'' = (⟨i.val, hlt⟩ : Fin m).succ.succ := Fin.ext (by simp [hi', hi])
    have hh := h ⟨i.val, hlt⟩
    rw [← e1, ← e2, ← e3] at hh
    rcases fin4_cases2 j j' hj with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · exact hh.1
    · exact hh.2.1
    · exact hh.2.2

private theorem anti_iff {m : ℕ} (x : Fin (m + 2) → Row) :
    Antidiagonal x ↔ ∀ i : Fin m, anti (x i.castSucc.castSucc) (x i.castSucc.succ) (x i.succ.succ) := by
  constructor
  · intro h i
    have hs := fun j j' j'' (hj : j'.val = j.val + 1) (hj' : j''.val = j'.val + 1) =>
      h i.castSucc.castSucc i.castSucc.succ i.succ.succ (by simp) (by simp) j j' j'' hj hj'
    exact ⟨hs 0 1 2 rfl rfl, hs 1 2 3 rfl rfl⟩
  · intro h i i' i'' hi hi' j j' j'' hj hj'
    have hlt : i.val < m := by omega
    have e1 : i = (⟨i.val, hlt⟩ : Fin m).castSucc.castSucc := Fin.ext rfl
    have e2 : i' = (⟨i.val, hlt⟩ : Fin m).castSucc.succ := Fin.ext (by simp [hi])
    have e3 : i'' = (⟨i.val, hlt⟩ : Fin m).succ.succ := Fin.ext (by simp [hi', hi])
    have hh := h ⟨i.val, hlt⟩
    rw [← e1, ← e2, ← e3] at hh
    rcases fin4_cases j j' j'' hj hj' with ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩
    · exact hh.1
    · exact hh.2

private def good {n : ℕ} (p q : Row) (x : Fin n → Row) : Prop :=
  ∀ i : Fin n,
    let y : Fin (n+2) → Row := Fin.cons p (Fin.cons q x)
    next (y i.castSucc.castSucc) (y i.castSucc.succ) (x i)

private theorem array_iff {n : ℕ} (x : Fin (n+2) → Row) :
    (Horizontal x ∧ Vertical x ∧ Antidiagonal x) ↔
      pairOK (x 0) (x 1) ∧ good (x 0) (x 1) (fun i => x i.succ.succ) := by
  have reconstruct : Fin.cons (x 0) (Fin.cons (x 1) (fun i : Fin n => x i.succ.succ)) = x := by
    funext j
    refine Fin.cases rfl (fun i => ?_) j
    exact Fin.cases rfl (fun _ => rfl) i
  simp only [hor_iff, vert_iff, anti_iff, good, reconstruct, next]
  rw [Fin.forall_fin_succ]
  simp only [Fin.succ_castSucc]
  constructor
  · rintro ⟨⟨h0, h1⟩, h2, h3⟩
    exact ⟨h0, fun i => ⟨h1 i, h2 i, h3 i⟩⟩
  · rintro ⟨h0, h⟩
    exact ⟨⟨h0, fun i => (h i).1⟩, fun i => (h i).2.1, fun i => (h i).2.2⟩

private theorem split_good {n : ℕ} (p q : Row) (x : Fin (n+1) → Row) :
    good p q x ↔ next p q (x 0) ∧ good q (x 0) (fun i => x i.succ) := by
  simp only [good, Fin.forall_fin_succ]
  have reconstruct : Fin.cons (x 0) (fun i => x i.succ) = x := Fin.cons_self_tail _
  rw [reconstruct]
  exact Iff.rfl

private abbrev Chain (n : ℕ) (p q : Row) := {x : Fin n → Row // good p q x}

private noncomputable instance (n : ℕ) (p q : Row) : Fintype (Chain n p q) := Fintype.ofFinite _

private def splitChain (n : ℕ) (p q : Row) :
    Chain (n+1) p q ≃ (Σ r : {r : Row // next p q r}, Chain n q r.val) where
  toFun x :=
    let h := (split_good p q x.val).mp x.property
    ⟨⟨x.val 0,h.1⟩,⟨fun i => x.val i.succ,h.2⟩⟩
  invFun y := ⟨Fin.cons y.1.val y.2.val,(split_good _ _ _).mpr (by
    simpa only [Fin.cons_zero,Fin.cons_succ] using And.intro y.1.property y.2.property)⟩
  left_inv x := Subtype.ext (Fin.cons_self_tail _)
  right_inv y := by rcases y with ⟨⟨r,hr⟩,⟨x,hx⟩⟩; rfl

private abbrev Pair := {pq : Row × Row // pairOK pq.1 pq.2}

private def splitArray (n : ℕ) :
    {x : Fin (n+2) → Row // Horizontal x ∧ Vertical x ∧ Antidiagonal x} ≃
      (Σ pq : Pair, Chain n pq.val.1 pq.val.2) where
  toFun x :=
    let h := (array_iff x.val).mp x.property
    ⟨⟨(x.val 0, x.val 1), h.1⟩, ⟨fun i => x.val i.succ.succ, h.2⟩⟩
  invFun y := ⟨Fin.cons y.1.val.1 (Fin.cons y.1.val.2 y.2.val), (array_iff _).mpr
    ⟨y.1.property, y.2.property⟩⟩
  left_inv x := by
    apply Subtype.ext
    funext i
    refine Fin.cases rfl (fun j => ?_) i
    exact Fin.cases rfl (fun _ => rfl) j
  right_inv y := by rcases y with ⟨⟨⟨p, q⟩, hp⟩, ⟨x, hx⟩⟩; rfl

private noncomputable def v (n : ℕ) (p q : Row) : ℤ := Fintype.card (Chain n p q)

private def step (f : Row → Row → ℤ) (p q : Row) : ℤ :=
  ∑ r : {r : Row // next p q r}, f q r.val

private theorem succ_v (n : ℕ) : v (n+1) = step (v n) := by
  funext p q
  simp [step, v, Fintype.card_congr (splitChain n p q), Fintype.card_sigma]

private theorem zero_v : v 0 = fun _ _ => 1 := by
  funext p q
  have : Unique (Chain 0 p q) :=
    { default := ⟨Fin.elim0, fun i => i.elim0⟩
      uniq := fun _ => Subtype.ext (funext fun i => i.elim0) }
  simp [v]

private def total (f : Row → Row → ℤ) : ℤ := ∑ pq : Pair, f pq.val.1 pq.val.2

private theorem value (n : ℕ) : (a (n+1) : ℤ) = total (v n) := by
  have h := Fintype.card_congr (splitArray n)
  simp only [Fintype.card_sigma] at h
  unfold a total v
  rw [← Fintype.card_subtype, h]
  push_cast
  rfl

private def code (r : Row) : Fin 81 :=
  ⟨27 * (r 0).val + 9 * (r 1).val + 3 * (r 2).val + (r 3).val, by omega⟩

private def dec (i : Fin 81) : Row := fun j =>
  ⟨(i.val / 3 ^ (3 - j.val)) % 3, Nat.mod_lt _ (by norm_num)⟩

private theorem code_dec : ∀ i : Fin 81, code (dec i) = i := by decide +kernel

private theorem dec_code : ∀ r : Row, dec (code r) = r := by decide +kernel

private def eR : Row ≃ Fin 81 where
  toFun := code
  invFun := dec
  left_inv := dec_code
  right_inv := code_dec

private theorem total_eq (f : Row → Row → ℤ) :
    total f = ∑ i : Fin 81, ∑ j : Fin 81, if pairOK (dec i) (dec j) then f (dec i) (dec j) else 0 := by
  unfold total
  rw [← Fintype.sum_prod_type' (f := fun i j => if pairOK (dec i) (dec j) then f (dec i) (dec j) else 0),
    ← Finset.sum_filter]
  let e : Pair ≃ {ij : Fin 81 × Fin 81 // pairOK (dec ij.1) (dec ij.2)} :=
    { toFun := fun pq => ⟨(code pq.val.1, code pq.val.2), by
        rw [dec_code, dec_code]; exact pq.property⟩
      invFun := fun ij => ⟨(dec ij.val.1, dec ij.val.2), ij.property⟩
      left_inv := fun pq => Subtype.ext (Prod.ext (dec_code _) (dec_code _))
      right_inv := fun ij => Subtype.ext (Prod.ext (code_dec _) (code_dec _)) }
  rw [Fintype.sum_equiv e _ (fun ij => f (dec ij.val.1) (dec ij.val.2)) (fun pq => by
    show f pq.val.1 pq.val.2 = f (dec (code pq.val.1)) (dec (code pq.val.2))
    rw [dec_code, dec_code])]
  symm
  apply Finset.sum_subtype
  intro ij
  simp only [Finset.mem_filter, Finset.mem_univ, true_and]

private def stepC (f : Fin 81 → Fin 81 → ℤ) (i j : Fin 81) : ℤ :=
  ∑ l ∈ Finset.univ.filter (fun l : Fin 81 => next (dec i) (dec j) (dec l)), f j l

private theorem step_eq (f : Row → Row → ℤ) (i j : Fin 81) :
    step f (dec i) (dec j) = stepC (fun a b => f (dec a) (dec b)) i j := by
  unfold step stepC
  let e : {r : Row // next (dec i) (dec j) r} ≃ {l : Fin 81 // next (dec i) (dec j) (dec l)} :=
    { toFun := fun r => ⟨code r.val, by rw [dec_code]; exact r.property⟩
      invFun := fun l => ⟨dec l.val, l.property⟩
      left_inv := fun r => Subtype.ext (dec_code _)
      right_inv := fun l => Subtype.ext (code_dec l.val) }
  rw [Fintype.sum_equiv e _ (fun l => f (dec j) (dec l.val)) (fun r => by
    show f (dec j) r.val = f (dec j) (dec (code r.val))
    rw [dec_code])]
  exact (Finset.sum_subtype _ (fun l => by simp only [Finset.mem_filter, Finset.mem_univ, true_and]) (fun l => f (dec j) (dec l))).symm

private theorem mem_succ {i j l : Fin 81}
    (h : l ∈ Finset.univ.filter (fun l : Fin 81 => next (dec i) (dec j) (dec l))) :
    pairOK (dec j) (dec l) := (Finset.mem_filter.mp h).2.1

