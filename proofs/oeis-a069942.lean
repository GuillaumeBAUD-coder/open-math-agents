private def key (p a b : ℕ) [Fact p.Prime] :
    (shortCurve p a b).toAffine.Point → Option (ZMod p × Bool)
  | .zero => none
  | .some x y _ => some (x, decide (y.val ≤ (-y).val))

private theorem key_injective (p a b : ℕ) [Fact p.Prime] : Function.Injective (key p a b) := by
  intro P Q h
  cases P with
  | zero => cases Q <;> simp_all [key]
  | some x y hy =>
    cases Q with
    | zero => simp [key] at h
    | some z t ht =>
      simp only [key, Option.some.injEq, Prod.mk.injEq] at h
      rcases h with ⟨rfl,hh⟩
      have hy' := ((shortCurve p a b).toAffine.equation_iff x y).mp hy.1
      have ht' := ((shortCurve p a b).toAffine.equation_iff x t).mp ht.1
      simp [shortCurve] at hy' ht'
      rcases sq_eq_sq_iff_eq_or_eq_neg.mp (hy'.trans ht'.symm) with rfl | hneg
      · rfl
      · have htneg : t = -y := by rw [hneg, neg_neg]
        subst t
        simp only [neg_neg, decide_eq_decide] at hh
        have hval : y.val = (-y).val := by omega
        have heq := ZMod.val_injective p hval
        congr 1

private theorem bound (p a b : ℕ) [Fact p.Prime] :
    Fintype.card (shortCurve p a b).toAffine.Point ≤ 2*p+1 := by
  simpa [mul_comm, ZMod.card] using Fintype.card_le_of_injective _ (key_injective p a b)

theorem weakStep {n a b x y u q : ℕ} {ws : List ℕ} (hq : q.Prime)
    (hn : 3 < n) (hmod : n % 6 = 1 ∨ n % 6 = 5)
    (hcurve : onCurve n a b x y = true)
    (hdisc : (4*a*a*a + 27*b*b)*u % n = 1)
    (hsize : 2*n.sqrt+1 < q)
    (hreplay : replayDone n a b q (.affine x y) ws = true) : n.Prime := by
  by_contra hnp
  let p := n.minFac
  have hp := Nat.minFac_prime (by omega : n ≠ 1)
  have hd : p ∣ n := Nat.minFac_dvd n
  have hpSq : p * p ≤ n := by simpa [p, pow_two] using Nat.minFac_sq_le_self (by omega : 0 < n) hnp
  letI : Fact p.Prime := ⟨hp⟩
  have hp3 := prime_divisor_gt_three hp hd hmod
  obtain ⟨P, hP, hp0⟩ := startingPoint_rep hp hp3 hd hdisc hcurve
  have hz := replay_zero hd (by omega) _ P hP (replayDone_eq_true_iff.mp hreplay)
  have hle := (prime_order_le_card hq hp0 hz).trans (bound p a b)
  have hps : p ≤ n.sqrt := Nat.le_sqrt.mpr hpSq
  omega
end Hex.ECPP

