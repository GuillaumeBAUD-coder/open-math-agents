open OMA.S_oeis_a069942
open scoped Pointwise

private def P : ℕ := 

private def fastRev (fuel n acc : ℕ) : ℕ :=
  match fuel with
  | 0 => acc
  | j+1 => if n = 0 then acc else fastRev j (n / 10) (10 * acc + n % 10)

private theorem fastRev_eq (fuel n acc : ℕ) (h : n < 10 ^ fuel) :
    fastRev fuel n acc = acc * 10 ^ (Nat.digits 10 n).length + rev10 n := by
  induction fuel generalizing n acc with
  | zero => have : n = 0 := by simpa using h
            simp [this, fastRev, rev10]
  | succ j ih =>
    by_cases hn : n = 0
    · simp [hn, fastRev, rev10]
    · have hdiv : n/10 < 10^j := (Nat.div_lt_iff_lt_mul (by decide)).2 (by simpa [pow_succ] using h)
      rw [fastRev, if_neg hn, ih _ _ hdiv]
      simp [rev10, Nat.digits_def' (by decide : 1 < 10) (Nat.pos_of_ne_zero hn), Nat.ofDigits_append, Nat.ofDigits_singleton, pow_succ]
      ring

private theorem reversal_certificate (n : ℕ) (hn : n < 10^1100) :
    rev10 n = fastRev 1100 n 0 := by simp [fastRev_eq 1100 n 0 hn]

set_option maxRecDepth 200000 in
set_option maxHeartbeats 0 in
theorem complete_except_primality (hp : P.Prime) : ¬ (type_of% @OMA.S_oeis_a069942.main) := by
  intro h
  have hproper : (5947*P).properDivisors = (insert (5947*P) (5947*P).properDivisors).erase (5947*P) := by simp
  have hneq : 5947 * P ≠ 0 := by decide +kernel
  rw [Nat.insert_self_properDivisors hneq, Nat.divisors_mul, hp.divisors] at hproper
  have hm : Nat.divisors 5947 = {1,19,313,5947} := by
    rw [show (5947 : ℕ) = 19*313 by decide, Nat.divisors_mul, (by decide : Nat.Prime 19).divisors, (by decide : Nat.Prime 313).divisors]
    decide +kernel
  rw [hm] at hproper
  have d := h (5947*P) (by
    refine ⟨by decide +kernel, ?_⟩
    rw [hproper]
    have hs : (({1,19,313,5947} : Finset ℕ) * {1,P}).erase (5947*P) = {1,19,313,5947,P,19*P,313*P} := by decide +kernel
    rw [hs]
    have he : ∀ x ∈ ({1,19,313,5947,P,19*P,313*P} : Finset ℕ), x < 10^1100 := by decide +kernel
    rw [reversal_certificate _ (by decide +kernel), Finset.sum_congr rfl fun x hx => reversal_certificate x (he x hx)]
    decide +kernel)
  exact (by decide +kernel : ¬3 ∣ 5947*P) d

theorem OMA.disproof : ¬ (type_of% @OMA.S_oeis_a069942.main) :=
  complete_except_primality PictureCert.h0
