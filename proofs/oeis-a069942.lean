inductive HCoord
  | inf | pt (x y z : ℕ)

private structure State where
  pt : HCoord
  prod : ℕ
  invs : List (ℕ × ℕ × ℕ)

private def padd (n a : ℕ) (s : State) (B : HCoord) : State :=
  match s.pt, B with
  | .inf, Q => {s with pt := Q}
  | _, .inf => s
  | .pt x y z, .pt X Y Z => Id.run do
    let dx := modSub n (X*z) (x*Z)
    let yy := Y*z % n
    let yY := y*Z % n
    let zz := z*Z % n
    if dx == 0 && (yy+yY)%n == 0 then return {s with pt := .inf}
    let (num,den,u,v) := if dx == 0 then
      ((3*x*x + a*(z*z%n))%n, 2*y*z %n, 2*y%n, z)
      else (modSub n yy yY, dx, dx, zz)
    let dd := den*den %n
    let z3 := dd*zz %n
    let x3 := modSub n ((num*num%n)*zz) (dd*((x*Z+X*z)%n))
    let y3 := modSub n (num * modSub n (x*z3) (x3*z)) ((den*y%n)*z3)
    let k := den*z%n
    return ⟨.pt (x3*k%n) y3 (z3*k%n), s.prod*u%n, (u,v,s.prod)::s.invs⟩

private def pwalk (n a q : ℕ) (base : HCoord) : ℕ → State → State
  | 0, s => s
  | i+1, s =>
    let s' := padd n a s s.pt
    let t := if q.testBit i then padd n a s' base else s'
    pwalk n a q base i t

private def finish (n : ℕ) : List (ℕ × ℕ × ℕ) → ℕ → List ℕ → List ℕ
  | [], _, w => w
  | (u,v,b)::tail, k, w => finish n tail (k*u%n) ((v*(k*b%n)%n)::w)

def witnesses (n a x y q inv : ℕ) : List ℕ :=
  let s := pwalk n a q (.pt x y 1) (HexArith.bitLength q) ⟨.inf,1,[]⟩
  finish n s.invs inv []

end Hex.ECPP

