private def hasPair (index : ℕ) : Bool := pairBit (index / 2048) (index % 2048)

private def cubePairs (bound : ℕ) (accept : ℕ → ℕ → Bool) : Bool :=
  (List.range bound).all (fun x => (List.range bound).all (fun y => accept (x + 1) (y + 1)))

private theorem fromPairs {bound : ℕ} {p : ℕ → ℕ → Bool} (h : cubePairs bound p = true)
    {x y : ℕ} (hx : 0 < x) (hx' : x ≤ bound) (hy : 0 < y) (hy' : y ≤ bound) : p x y = true := by
  unfold cubePairs at h
  rw [List.all_eq_true] at h
  have hxMem : x - 1 ∈ List.range bound := List.mem_range.mpr (by omega)
  have hyMem : y - 1 ∈ List.range bound := List.mem_range.mpr (by omega)
  have hstep := List.all_eq_true.mp (h _ hxMem) _ hyMem
  simpa only [Nat.sub_add_cancel (by omega : 1 ≤ x), Nat.sub_add_cancel (by omega : 1 ≤ y)] using hstep

set_option maxRecDepth 8192 in
set_option maxHeartbeats 1000000 in
private theorem allSums :
    cubePairs 70 (fun x y => if x^3 + y^3 ≤ 71^3 then hasPair (x^3 + y^3) else true) =
      true := by decide +kernel

private def avoids (k : ℕ) : Bool :=
  cubePairs (k - 1) (fun y z => !(hasPair (k^3 - (y^3 + z^3))))

private theorem belowOfCube {k v q : ℕ} (hq : 0 < q) (h : k^3 = v^3 + q) : v < k := by
  by_contra! hk
  have hle : k^3 ≤ v^3 := Nat.pow_le_pow_left hk 3
  omega

private theorem notTerm (k : ℕ) (hk : k ≤ 71) (havoid : avoids k = true) : ¬ IsTerm k := by
  rintro ⟨w, x, y, z, hw, hx, hy, hz, h⟩
  have hw' : w < k := belowOfCube (q := x^3 + y^3 + z^3) (by positivity) (by omega)
  have hx' : x < k := belowOfCube (q := w^3 + y^3 + z^3) (by positivity) (by omega)
  have hy' : y < k := belowOfCube (q := w^3 + x^3 + z^3) (by positivity) (by omega)
  have hz' : z < k := belowOfCube (q := w^3 + x^3 + y^3) (by positivity) (by omega)
  have hmax : k ^ 3 ≤ 71 ^ 3 := Nat.pow_le_pow_left hk 3
  have hsum : w^3 + x^3 ≤ 71^3 := by omega
  have hyes := fromPairs allSums hw (by omega) hx (by omega)
  rw [if_pos hsum] at hyes
  change cubePairs (k - 1) (fun y z => !(hasPair (k^3 - (y^3 + z^3)))) = true at havoid
  have hno := fromPairs havoid hy (by omega) hz (by omega)
  have hc : k^3 - (y^3 + z^3) = w^3 + x^3 := by omega
  rw [hc, hyes] at hno
  contradiction

private def exceptions : Finset ℕ := {0, 1, 2, 3, 4, 5, 6, 8, 9, 10, 11, 15, 16, 17, 19, 22, 27, 29, 47, 58, 61, 71}

set_option maxRecDepth 8192 in
set_option maxHeartbeats 1000000 in
private theorem allAvoid : ∀ k ∈ exceptions, k ≤ 71 ∧ avoids k = true := by decide +kernel

end FourCubeExclusions

theorem OMA.solution : OMA.R_oeis_a274334_R1.H3 := by
  intro k hk
  have h := FourCubeExclusions.allAvoid k hk
  exact FourCubeExclusions.notTerm k h.1 h.2