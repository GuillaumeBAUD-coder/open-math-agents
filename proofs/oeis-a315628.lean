theorem a_closed1 (k : ℕ) :
    a (30 * k + 14) = 164 * k + 76 ∧
    a (30 * k + 15) = 160 * k + 82 ∧
    a (30 * k + 16) = 164 * k + 88 ∧
    a (30 * k + 17) = 160 * k + 90 ∧
    a (30 * k + 18) = 164 * k + 98 ∧
    a (30 * k + 19) = 160 * k + 100 ∧
