open PowerSeries in
/-- The denominator times A, as a sum of monomials. -/
theorem gf_den (A : ℚ⟦X⟧) : A * (X ^ 16 - X ^ 10 - X ^ 6 + 1) = C 1 * A - C 1 * (A * X ^ 6) - C 1 * (A * X ^ 10) + C 1 * (A * X ^ 16) := by
  simp only [map_one]
  ring

open PowerSeries in
/-- The numerator as a sum of monomials. -/
theorem gf_num : (-2 * X ^ 21 - 2 * X ^ 20 + 2 * X ^ 18 + X ^ 16 + 6 * X ^ 15 + 14 * X ^ 14 + 18 * X ^ 13 + 18 * X ^ 12 + 28 * X ^ 11 + 35 * X ^ 10 + 32 * X ^ 9 + 32 * X ^ 8 + 28 * X ^ 7 + 33 * X ^ 6 + 28 * X ^ 5 + 18 * X ^ 4 + 16 * X ^ 3 + 12 * X ^ 2 + 6 * X + 1 : ℚ⟦X⟧) = X ^ 0 * C 1 + X ^ 1 * C 6 + X ^ 2 * C 12 + X ^ 3 * C 16 + X ^ 4 * C 18 + X ^ 5 * C 28 + X ^ 6 * C 33 + X ^ 7 * C 28 + X ^ 8 * C 32 + X ^ 9 * C 32 + X ^ 10 * C 35 + X ^ 11 * C 28 + X ^ 12 * C 18 + X ^ 13 * C 18 + X ^ 14 * C 14 + X ^ 15 * C 6 + X ^ 16 * C 1 + X ^ 18 * C 2 - X ^ 20 * C 2 - X ^ 21 * C 2 := by
  simp only [map_ofNat, map_one]
  ring

open PowerSeries in
/-- The generating function. -/
theorem gf : PowerSeries.mk (fun n => (a n : ℚ)) * (X ^ 16 - X ^ 10 - X ^ 6 + 1) =
      -2 * X ^ 21 - 2 * X ^ 20 + 2 * X ^ 18 + X ^ 16 + 6 * X ^ 15 + 14 * X ^ 14 + 18 * X ^ 13 + 18 * X ^ 12 + 28 * X ^ 11 + 35 * X ^ 10 + 32 * X ^ 9 + 32 * X ^ 8 + 28 * X ^ 7 + 33 * X ^ 6 + 28 * X ^ 5 + 18 * X ^ 4 + 16 * X ^ 3 + 12 * X ^ 2 + 6 * X + 1 := by
  set A : ℚ⟦X⟧ := PowerSeries.mk (fun n => (a n : ℚ)) with hA
  rw [gf_den A, gf_num]
