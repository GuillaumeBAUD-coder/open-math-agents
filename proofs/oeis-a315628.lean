/-! The steps satisfy the recurrence, on one period of the residues (negative terms moved across). -/

def drec_baseK : PLift (∀ t : ℕ, t < 30 → dv (t + 16) + dv (t + 0) = dv (t + 10) + dv (t + 6)) :=
  ⟨by decide +kernel⟩

theorem drec_base : ∀ t : ℕ, t < 30 → dv (t + 16) + dv (t + 0) = dv (t + 10) + dv (t + 6) := drec_baseK.down

theorem drec (t : ℕ) : (dv (t + 16) : ℤ) = (dv (t + 10) : ℤ) + (dv (t + 6) : ℤ) - (dv (t + 0) : ℤ) := by
  have e : ∀ o : ℕ, dv (t + o) = dv (t % 30 + o) := fun o => by
    rw [dv, dv, Nat.mod_add_mod]
  rw [e 0, e 6, e 10, e 16]
  have h := congrArg (Nat.cast : ℕ → ℤ) (drec_base (t % 30) (Nat.mod_lt _ (by norm_num)))
  push_cast at h
  linarith

/-! The recurrence on its first 30 terms, by the kernel (negative terms moved across). -/

def recur_baseK : PLift (∀ q : ℕ, q < 30 → b (q + 22) + b (q + 6) = b (q + 16) + b (q + 12)) :=
  ⟨by decide +kernel⟩

theorem recur_base : ∀ q : ℕ, q < 30 → b (q + 22) + b (q + 6) = b (q + 16) + b (q + 12) := recur_baseK.down

theorem b_recur (q : ℕ) : (b (q + 22) : ℤ) = b (q + 16) + b (q + 12) - b (q + 6) := by
  induction q using Nat.strong_induction_on with
  | _ q ih =>
    rcases (show q < 30 ∨ 30 ≤ q by omega) with hq | hq
    · have h := congrArg (Nat.cast : ℕ → ℤ) (recur_base q hq)
      push_cast at h
      linarith
    · obtain ⟨v, rfl⟩ : ∃ v, q = v + 30 := ⟨q - 30, by omega⟩
      have h0 : (b (v + 22) : ℤ) = b (v + 16) + b (v + 12) - b (v + 6) := ih (v + 0) (by omega)
      have hd := drec v
      have s6 : (b (v + 36) : ℤ) = b (v + 6) + dv (v + 0) := by
        have h := b_step (v + 6) (le_trans (by decide : 6 ≤ 6) (Nat.le_add_left _ v))
        rw [show v + 6 + 30 = v + 36 from Nat.add_assoc _ _ _,
          show v + 6 - 6 = v + 0 from Nat.add_sub_assoc (by decide : 6 ≤ 6) v] at h
        exact_mod_cast h
      have s12 : (b (v + 42) : ℤ) = b (v + 12) + dv (v + 6) := by
        have h := b_step (v + 12) (le_trans (by decide : 6 ≤ 12) (Nat.le_add_left _ v))
        rw [show v + 12 + 30 = v + 42 from Nat.add_assoc _ _ _,
          show v + 12 - 6 = v + 6 from Nat.add_sub_assoc (by decide : 6 ≤ 12) v] at h
        exact_mod_cast h
      have s16 : (b (v + 46) : ℤ) = b (v + 16) + dv (v + 10) := by
        have h := b_step (v + 16) (le_trans (by decide : 6 ≤ 16) (Nat.le_add_left _ v))
        rw [show v + 16 + 30 = v + 46 from Nat.add_assoc _ _ _,
          show v + 16 - 6 = v + 10 from Nat.add_sub_assoc (by decide : 6 ≤ 16) v] at h
        exact_mod_cast h
      have s22 : (b (v + 52) : ℤ) = b (v + 22) + dv (v + 16) := by
        have h := b_step (v + 22) (le_trans (by decide : 6 ≤ 22) (Nat.le_add_left _ v))
        rw [show v + 22 + 30 = v + 52 from Nat.add_assoc _ _ _,
          show v + 22 - 6 = v + 16 from Nat.add_sub_assoc (by decide : 6 ≤ 22) v] at h
        exact_mod_cast h
      show (b (v + 52) : ℤ) = b (v + 46) + b (v + 42) - b (v + 36)
      linear_combination s22 - (1) * s16 - (1) * s12 - (-1) * s6 + h0 + hd

/-- The recurrence. -/
theorem recur : ∀ n : ℕ, 21 < n → (a n : ℤ) = a (n - 6) + a (n - 10) - a (n - 16) := by
  intro n hn
  obtain ⟨q, rfl⟩ : ∃ q, n = q + 22 := ⟨n - 22, by omega⟩
  rw [show q + 22 - 6 = q + 16 from Nat.add_sub_assoc (by decide : 6 ≤ 22) q, show q + 22 - 10 = q + 12 from Nat.add_sub_assoc (by decide : 10 ≤ 22) q, show q + 22 - 16 = q + 6 from Nat.add_sub_assoc (by decide : 16 ≤ 22) q]
  simp only [a_eq_b]
  exact b_recur q

/-- b (n - k) for k ≤ n, and [n = j]: the shapes of the coefficients of the g.f. -/
def bk (n k : ℕ) : ℕ := cond (Nat.ble k n) (b (Nat.sub n k)) 0

def ind (n j : ℕ) : ℕ := cond (Nat.beq n j) 1 0

theorem cast_bk (n k : ℕ) : ((bk n k : ℕ) : ℚ) = if k ≤ n then ((b (n - k) : ℕ) : ℚ) else 0 := by
  rw [bk]
  by_cases h : k ≤ n
  · rw [if_pos h, Nat.ble_eq_true_of_le h]
    rfl
  · rw [if_neg h]
    cases hb : Nat.ble k n
    · simp
    · exact absurd (Nat.le_of_ble_eq_true hb) h

theorem cast_ind (n j : ℕ) : ((ind n j : ℕ) : ℚ) = if n = j then 1 else 0 := by
  rw [ind]
  by_cases h : n = j
  · subst h
    rw [Nat.beq_refl, if_pos rfl]
    simp
  · rw [if_neg h, beq_ff _ _ h]
    simp

