def okD (i : ℕ) : Bool := PA.getD i 0 ≤ 4210 + 2 * i && tw (PA.getD i 0) && tw (4210 + 2 * i - PA.getD i 0)

def chunk (a b : ℕ) : Bool := (List.range (b - a)).all fun i => okD (a + i)

theorem chunk_sound {a b n : ℕ} (h : chunk a b = true) (h1 : a ≤ n) (h2 : n < b) : okD n = true := by
  have := List.all_eq_true.mp h (n - a) (List.mem_range.mpr (by omega))
  simpa [show a + (n - a) = n by omega] using this

