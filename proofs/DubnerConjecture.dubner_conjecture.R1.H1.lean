    ∃ p q : ℕ, DubnerConjecture.IsTwinPrime p ∧ DubnerConjecture.IsTwinPrime q ∧ p + q = n := by
  intro n h1 h2 he
  obtain ⟨k, hk⟩ := he
  have hi : k - 2105 < 2896 := by omega
  have hok := okD_all (k - 2105) hi
  simp only [okD, Bool.and_eq_true, decide_eq_true_eq] at hok
  obtain ⟨⟨h3, h4⟩, h5⟩ := hok
  have hn : 4210 + 2 * (k - 2105) = n := by omega
  rw [hn] at h3 h5
  refine ⟨PA.getD (k - 2105) 0, n - PA.getD (k - 2105) 0, tw_sound h4 (by omega), tw_sound h5 (by omega), by omega⟩

theorem OMA.solution : OMA.R_DubnerConjecture_dubner_conjecture_R1.H1 := sol
