/-!
# A semiring with one maximal left ideal and several maximal right ideals

In any semiring the left ideal generated by `x` is `R x`, so `x` lies in a proper left ideal
exactly when it has no left inverse. Hence there is a unique maximal left ideal as soon as the
elements without a left inverse are closed under addition, and there are at least two maximal
right ideals as soon as `1 = a + b` with neither `a` nor `b` right invertible.

The example. Order the bicyclic monoid `{c^i s^j}` (with `s c = 1`) by `c ≤ 1`, that is
`c^i s^j ≤ c^k s^l` iff `k ≤ i` and `j ≤ l`. Its lower sets form an idempotent semiring `LS`
(union, and lower closure of the product). The left invertible elements of `LS` are exactly the
principal lower sets `C l` of the powers `c^l`, and everything below a `C l` is zero or again some
`C m`. The semiring `T` consists of the pairs `(A, B)` of lower sets with `A = 0 ↔ B = 0`. In `T`
we have `1 = (1, C 1) + (C 1, 1)`, and neither summand is right invertible, while a sum is left
invertible only if one of its summands is.
-/

namespace OMA

/-- A lower set of the ordered bicyclic monoid: the pair `(i, j)` stands for `c^i s^j`, and lower
sets are closed under increasing `i` and decreasing `j`. -/
structure LS where
  s : ℕ → ℕ → Prop
  low : ∀ i j i' j', i ≤ i' → j' ≤ j → s i j → s i' j'

namespace LS

theorem ext' {A B : LS} (h : ∀ i j, A.s i j ↔ B.s i j) : A = B := by
  cases A with
  | mk sA lA =>
    cases B with
    | mk sB lB =>
      have hs : sA = sB := by
        funext i j
        exact propext (h i j)
      subst hs
      rfl

def zero : LS := ⟨fun _ _ => False, fun _ _ _ _ _ _ h => h⟩

def one : LS := ⟨fun _ j => j = 0, fun _ j _ j' _ hj (h : j = 0) => (by omega : j' = 0)⟩

def add (A B : LS) : LS :=
  ⟨fun i j => A.s i j ∨ B.s i j, fun i j i' j' hi hj h =>
    h.elim (fun h => Or.inl (A.low i j i' j' hi hj h)) (fun h => Or.inr (B.low i j i' j' hi hj h))⟩

/-- Lower closure of the product, where `(a, b) * (c, d) = (a + (c - b), d + (b - c))`. -/
def mul (A B : LS) : LS :=
  ⟨fun i j => ∃ a b c d, A.s a b ∧ B.s c d ∧ a + (c - b) ≤ i ∧ j ≤ d + (b - c),
    fun i j i' j' hi hj h => by
      obtain ⟨a, b, c, d, hA, hB, h1, h2⟩ := h
      exact ⟨a, b, c, d, hA, hB, by omega, by omega⟩⟩

theorem mul_def (A B : LS) (i j : ℕ) :
    (mul A B).s i j ↔ ∃ a b c d, A.s a b ∧ B.s c d ∧ a + (c - b) ≤ i ∧ j ≤ d + (b - c) :=
  Iff.rfl

theorem add_def (A B : LS) (i j : ℕ) : (add A B).s i j ↔ A.s i j ∨ B.s i j := Iff.rfl

theorem mul_assoc' (A B C : LS) : mul (mul A B) C = mul A (mul B C) := by
  refine ext' fun i j => ?_
  rw [mul_def, mul_def]
  constructor
  · intro h
    obtain ⟨x, y, c, d, hAB, hC, h3, h4⟩ := h
    rw [mul_def] at hAB
    obtain ⟨a, b, e, f, hA, hB, h1, h2⟩ := hAB
    refine ⟨a, b, e + (c - f), d + (f - c), hA, ?_, by omega, by omega⟩
    rw [mul_def]
    exact ⟨e, f, c, d, hB, hC, le_refl _, le_refl _⟩
  · intro h
    obtain ⟨a, b, x, y, hA, hBC, h3, h4⟩ := h
    rw [mul_def] at hBC
    obtain ⟨e, f, c, d, hB, hC, h1, h2⟩ := hBC
    refine ⟨a + (e - b), f + (b - e), c, d, ?_, hC, by omega, by omega⟩
    rw [mul_def]
    exact ⟨a, b, e, f, hA, hB, le_refl _, le_refl _⟩

theorem one_mul' (A : LS) : mul one A = A := by
  refine ext' fun i j => ?_
  rw [mul_def]
  constructor
  · intro h
    obtain ⟨a, b, c, d, hb, hA, h1, h2⟩ := h
    have hb' : b = 0 := hb
    exact A.low c d i j (by omega) (by omega) hA
  · intro h
    exact ⟨0, 0, i, j, rfl, h, by omega, by omega⟩

theorem mul_one' (A : LS) : mul A one = A := by
  refine ext' fun i j => ?_
  rw [mul_def]
  constructor
  · intro h
    obtain ⟨a, b, c, d, hA, hd, h1, h2⟩ := h
    have hd' : d = 0 := hd
    exact A.low a b i j (by omega) (by omega) hA
  · intro h
    exact ⟨i, j, 0, 0, h, rfl, by omega, by omega⟩

theorem left_distrib' (A B C : LS) : mul A (add B C) = add (mul A B) (mul A C) := by
  refine ext' fun i j => ?_
  rw [add_def, mul_def, mul_def, mul_def]
  constructor
  · intro h
    obtain ⟨a, b, c, d, hA, hBC, h1, h2⟩ := h
    rcases hBC with hB | hC
    · exact Or.inl ⟨a, b, c, d, hA, hB, h1, h2⟩
    · exact Or.inr ⟨a, b, c, d, hA, hC, h1, h2⟩
  · intro h
    rcases h with h | h
    · obtain ⟨a, b, c, d, hA, hB, h1, h2⟩ := h
      exact ⟨a, b, c, d, hA, Or.inl hB, h1, h2⟩
    · obtain ⟨a, b, c, d, hA, hC, h1, h2⟩ := h
      exact ⟨a, b, c, d, hA, Or.inr hC, h1, h2⟩

theorem right_distrib' (A B C : LS) : mul (add A B) C = add (mul A C) (mul B C) := by
  refine ext' fun i j => ?_
  rw [add_def, mul_def, mul_def, mul_def]
  constructor
  · intro h
    obtain ⟨a, b, c, d, hAB, hC, h1, h2⟩ := h
    rcases hAB with hA | hB
    · exact Or.inl ⟨a, b, c, d, hA, hC, h1, h2⟩
    · exact Or.inr ⟨a, b, c, d, hB, hC, h1, h2⟩
  · intro h
    rcases h with h | h
    · obtain ⟨a, b, c, d, hA, hC, h1, h2⟩ := h
      exact ⟨a, b, c, d, Or.inl hA, hC, h1, h2⟩
    · obtain ⟨a, b, c, d, hB, hC, h1, h2⟩ := h
      exact ⟨a, b, c, d, Or.inr hB, hC, h1, h2⟩

theorem zero_mul' (A : LS) : mul zero A = zero := by
  refine ext' fun i j => ?_
  rw [mul_def]
  constructor
  · intro h
    obtain ⟨a, b, c, d, hz, _, _, _⟩ := h
    exact False.elim hz
  · intro h
    exact False.elim h

theorem mul_zero' (A : LS) : mul A zero = zero := by
  refine ext' fun i j => ?_
  rw [mul_def]
  constructor
  · intro h
    obtain ⟨a, b, c, d, _, hz, _, _⟩ := h
    exact False.elim hz
  · intro h
    exact False.elim h

theorem add_assoc' (A B C : LS) : add (add A B) C = add A (add B C) :=
  ext' fun _ _ => or_assoc

theorem add_comm' (A B : LS) : add A B = add B A :=
  ext' fun _ _ => or_comm

theorem zero_add' (A : LS) : add zero A = A :=
  ext' fun _ _ => ⟨fun h => h.elim False.elim id, Or.inr⟩

theorem add_zero' (A : LS) : add A zero = A :=
  ext' fun _ _ => ⟨fun h => h.elim id False.elim, Or.inl⟩

def nsmul : ℕ → LS → LS
  | 0, _ => zero
  | n + 1, A => add (nsmul n A) A

instance : Semiring LS where
  add := add
  add_assoc := add_assoc'
  zero := zero
  zero_add := zero_add'
  add_zero := add_zero'
  nsmul := nsmul
  nsmul_zero := fun _ => rfl
  nsmul_succ := fun _ _ => rfl
  add_comm := add_comm'
  mul := mul
  left_distrib := left_distrib'
  right_distrib := right_distrib'
  zero_mul := zero_mul'
  mul_zero := mul_zero'
  mul_assoc := mul_assoc'
  one := one
  one_mul := one_mul'
  mul_one := mul_one'

theorem s_add (A B : LS) (i j : ℕ) : (A + B).s i j ↔ A.s i j ∨ B.s i j := Iff.rfl

theorem s_mul (A B : LS) (i j : ℕ) :
    (A * B).s i j ↔ ∃ a b c d, A.s a b ∧ B.s c d ∧ a + (c - b) ≤ i ∧ j ≤ d + (b - c) :=
  Iff.rfl

theorem s_one (i j : ℕ) : (1 : LS).s i j ↔ j = 0 := Iff.rfl

theorem s_zero (i j : ℕ) : (0 : LS).s i j ↔ False := Iff.rfl

/-- The principal lower set of `c^l`. -/
def C (l : ℕ) : LS :=
  ⟨fun i j => l ≤ i ∧ j = 0, fun i j i' j' hi hj (h : l ≤ i ∧ j = 0) =>
    (⟨by omega, by omega⟩ : l ≤ i' ∧ j' = 0)⟩

/-- The principal lower set of `s^l`. -/
def U (l : ℕ) : LS :=
  ⟨fun _ j => j ≤ l, fun _ j _ j' _ hj (h : j ≤ l) => (by omega : j' ≤ l)⟩

theorem s_C (l i j : ℕ) : (C l).s i j ↔ l ≤ i ∧ j = 0 := Iff.rfl

theorem s_U (l i j : ℕ) : (U l).s i j ↔ j ≤ l := Iff.rfl

theorem U_mul_C (l : ℕ) : U l * C l = 1 := by
  refine ext' fun i j => ?_
  rw [s_mul, s_one]
  constructor
  · intro h
    obtain ⟨a, b, c, d, hb, hcd, h1, h2⟩ := h
    rw [s_U] at hb
    rw [s_C] at hcd
    omega
  · intro hj
    refine ⟨0, l, l, 0, ?_, ?_, by omega, by omega⟩
    · rw [s_U]
    · rw [s_C]
      exact ⟨le_refl l, rfl⟩

/-- A left invertible lower set is some `C l`. -/
theorem eq_C_of_mul_eq_one (V A : LS) (h : V * A = 1) : ∃ l, A = C l := by
  have h00 : (V * A).s 0 0 := by
    rw [h, s_one]
  rw [s_mul] at h00
  obtain ⟨a, b, c, d, hV, hA, h1, h2⟩ := h00
  have key : ∀ c' d', A.s c' d' → d' = 0 ∧ b ≤ c' := by
    intro c' d' hA'
    have hp : (V * A).s (a + (c' - b)) (d' + (b - c')) := by
      rw [s_mul]
      exact ⟨a, b, c', d', hV, hA', le_refl _, le_refl _⟩
    rw [h, s_one] at hp
    omega
  have hcd := key c d hA
  have hd : d = 0 := hcd.1
  have hcb : c = b := by omega
  rw [hd, hcb] at hA
  refine ⟨b, ext' fun i j => ?_⟩
  rw [s_C]
  constructor
  · intro hs
    have hk := key i j hs
    exact ⟨hk.2, hk.1⟩
  · intro hij
    have hj : j = 0 := hij.2
    rw [hj]
    exact A.low b 0 i 0 hij.1 (le_refl 0) hA

/-- Everything below a `C l` is zero or some `C m`. -/
theorem zero_or_C_of_add (A B : LS) (l : ℕ) (h : A + B = C l) : A = 0 ∨ ∃ m, A = C m := by
  classical
  have sub : ∀ i j, A.s i j → j = 0 := by
    intro i j hs
    have hab : (A + B).s i j := by
      rw [s_add]
      exact Or.inl hs
    rw [h, s_C] at hab
    exact hab.2
  by_cases hne : ∃ i, A.s i 0
  · right
    refine ⟨Nat.find hne, ext' fun i j => ?_⟩
    rw [s_C]
    constructor
    · intro hs
      have hj := sub i j hs
      rw [hj] at hs
      exact ⟨Nat.find_min' hne hs, hj⟩
    · intro hij
      have hj : j = 0 := hij.2
      rw [hj]
      exact A.low _ 0 i 0 hij.1 (le_refl 0) (Nat.find_spec hne)
  · left
    refine ext' fun i j => ?_
    rw [s_zero]
    constructor
    · intro hs
      have hj := sub i j hs
      rw [hj] at hs
      exact hne ⟨i, hs⟩
    · intro hf
      exact False.elim hf

theorem C_ne_zero (l : ℕ) : C l ≠ 0 := by
  intro h
  have hs : (C l).s l 0 := by
    rw [s_C]
    exact ⟨le_refl l, rfl⟩
  rw [h, s_zero] at hs
  exact hs

theorem U_ne_zero (l : ℕ) : U l ≠ 0 := by
  intro h
  have hs : (U l).s 0 0 := by
    rw [s_U]
    exact Nat.zero_le l
  rw [h, s_zero] at hs
  exact hs

theorem one_ne_zero' : (1 : LS) ≠ 0 := by
  intro h
  have hs : (1 : LS).s 0 0 := by
    rw [s_one]
  rw [h, s_zero] at hs
  exact hs

theorem eq_zero_of_forall (A : LS) (h : ∀ i j, ¬ A.s i j) : A = 0 :=
  ext' fun i j => ⟨fun hs => (h i j hs).elim, fun hf => False.elim hf⟩

theorem add_eq_zero' (A B : LS) : A + B = 0 ↔ A = 0 ∧ B = 0 := by
  constructor
  · intro h
    have key : ∀ i j, ¬ (A + B).s i j := by
      intro i j hs
      rw [h, s_zero] at hs
      exact hs
    refine ⟨eq_zero_of_forall A fun i j hs => key i j ?_, eq_zero_of_forall B fun i j hs => key i j ?_⟩
    · rw [s_add]
      exact Or.inl hs
    · rw [s_add]
      exact Or.inr hs
  · intro h
    rw [h.1, h.2, add_zero]

theorem mul_eq_zero' (A B : LS) : A * B = 0 ↔ A = 0 ∨ B = 0 := by
  constructor
  · intro h
    by_contra hcon
    have hA : A ≠ 0 := fun hA => hcon (Or.inl hA)
    have hB : B ≠ 0 := fun hB => hcon (Or.inr hB)
    have nA : ∃ a b, A.s a b := by
      by_contra hn
      exact hA (eq_zero_of_forall A fun i j hs => hn ⟨i, j, hs⟩)
    have nB : ∃ c d, B.s c d := by
      by_contra hn
      exact hB (eq_zero_of_forall B fun i j hs => hn ⟨i, j, hs⟩)
    obtain ⟨a, b, ha⟩ := nA
    obtain ⟨c, d, hc⟩ := nB
    have hp : (A * B).s (a + (c - b)) (d + (b - c)) := by
      rw [s_mul]
      exact ⟨a, b, c, d, ha, hc, le_refl _, le_refl _⟩
    rw [h, s_zero] at hp
    exact hp
  · intro h
    rcases h with h | h
    · rw [h, zero_mul]
    · rw [h, mul_zero]

/-- `C 1` has no right inverse. -/
theorem C_one_mul_ne_one (V : LS) : C 1 * V ≠ 1 := by
  intro h
  have h00 : (C 1 * V).s 0 0 := by
    rw [h, s_one]
  rw [s_mul] at h00
  obtain ⟨a, b, c, d, hab, _, h1, _⟩ := h00
  rw [s_C] at hab
  omega

theorem one_add_C_one : (1 : LS) + C 1 = 1 := by
  refine ext' fun i j => ?_
  rw [s_add, s_one, s_C]
  exact ⟨fun h => h.elim id fun h => h.2, Or.inl⟩

theorem C_one_add_one : C 1 + (1 : LS) = 1 := by
  rw [add_comm]
  exact one_add_C_one

end LS

/-- Pairs of lower sets that vanish together. -/
def T : Subsemiring (LS × LS) where
  carrier := {p | p.1 = 0 ↔ p.2 = 0}
  mul_mem' := by
    intro p q hp hq
    have hp' : p.1 = 0 ↔ p.2 = 0 := hp
    have hq' : q.1 = 0 ↔ q.2 = 0 := hq
    show (p * q).1 = 0 ↔ (p * q).2 = 0
    rw [Prod.fst_mul, Prod.snd_mul, LS.mul_eq_zero', LS.mul_eq_zero']
    exact or_congr hp' hq'
  one_mem' := by
    show (1 : LS × LS).1 = 0 ↔ (1 : LS × LS).2 = 0
    exact ⟨fun h => (LS.one_ne_zero' h).elim, fun h => (LS.one_ne_zero' h).elim⟩
  add_mem' := by
    intro p q hp hq
    have hp' : p.1 = 0 ↔ p.2 = 0 := hp
    have hq' : q.1 = 0 ↔ q.2 = 0 := hq
    show (p + q).1 = 0 ↔ (p + q).2 = 0
    rw [Prod.fst_add, Prod.snd_add, LS.add_eq_zero', LS.add_eq_zero']
    exact and_congr hp' hq'
  zero_mem' := by
    show (0 : LS × LS).1 = 0 ↔ (0 : LS × LS).2 = 0
    rw [Prod.fst_zero, Prod.snd_zero]

theorem T_mem (x : T) : x.1.1 = 0 ↔ x.1.2 = 0 := x.2

theorem T_inv (x : T) (p q : ℕ) (h1 : x.1.1 = LS.C p) (h2 : x.1.2 = LS.C q) :
    ∃ z : T, z * x = 1 := by
  have hmem : ((LS.U p, LS.U q) : LS × LS) ∈ T := by
    show LS.U p = 0 ↔ LS.U q = 0
    exact ⟨fun h => (LS.U_ne_zero p h).elim, fun h => (LS.U_ne_zero q h).elim⟩
  refine ⟨⟨(LS.U p, LS.U q), hmem⟩, ?_⟩
  apply Subtype.ext
  apply Prod.ext
  · show LS.U p * x.1.1 = 1
    rw [h1]
    exact LS.U_mul_C p
  · show LS.U q * x.1.2 = 1
    rw [h2]
    exact LS.U_mul_C q

theorem T_step (x y z : T) (hz : z * (x + y) = 1) (hx : x.1.1 ≠ 0) : ∃ w : T, w * x = 1 := by
  have e1 : z.1.1 * (x.1.1 + y.1.1) = 1 := congrArg (fun w : T => w.1.1) hz
  have e2 : z.1.2 * (x.1.2 + y.1.2) = 1 := congrArg (fun w : T => w.1.2) hz
  obtain ⟨l, hl⟩ := LS.eq_C_of_mul_eq_one _ _ e1
  obtain ⟨m, hm⟩ := LS.eq_C_of_mul_eq_one _ _ e2
  have hx2 : x.1.2 ≠ 0 := fun h => hx ((T_mem x).mpr h)
  rcases LS.zero_or_C_of_add _ _ l hl with h0 | ⟨p, hp⟩
  · exact (hx h0).elim
  · rcases LS.zero_or_C_of_add _ _ m hm with h0 | ⟨q, hq⟩
    · exact (hx2 h0).elim
    · exact T_inv x p q hp hq

/-- In `T`, a left invertible sum has a left invertible summand. -/
theorem T_local (x y : T) (h : ∃ z, z * (x + y) = 1) :
    (∃ z, z * x = 1) ∨ (∃ z, z * y = 1) := by
  obtain ⟨z, hz⟩ := h
  by_cases hx : x.1.1 = 0
  · right
    refine T_step y x z (by rw [add_comm]; exact hz) ?_
    intro hy
    have e1 : z.1.1 * (x.1.1 + y.1.1) = 1 := congrArg (fun w : T => w.1.1) hz
    rw [hx, hy, add_zero, mul_zero] at e1
    exact LS.one_ne_zero' e1.symm
  · left
    exact T_step x y z hz hx

/-- If the elements without a left inverse are closed under addition, they form the unique
maximal left ideal. -/
theorem unique_maximal_of_local {R : Type} [Semiring R] (hz : ¬ ∃ z : R, z * 0 = 1)
    (h : ∀ x y : R, (∃ z, z * (x + y) = 1) → (∃ z, z * x = 1) ∨ (∃ z, z * y = 1)) :
    ∃! I : Ideal R, I.IsMaximal := by
  let M : Ideal R :=
    { carrier := {x | ¬ ∃ z, z * x = 1}
      add_mem' := by
        intro a b ha hb hab
        rcases h a b hab with h1 | h1
        · exact ha h1
        · exact hb h1
      zero_mem' := hz
      smul_mem' := by
        intro c x hx hcx
        obtain ⟨z, hz'⟩ := hcx
        have hz2 : z * (c * x) = 1 := hz'
        exact hx ⟨z * c, by rw [mul_assoc]; exact hz2⟩ }
  have hmem : ∀ x : R, x ∈ M ↔ ¬ ∃ z, z * x = 1 := fun _ => Iff.rfl
  have hM1 : (1 : R) ∉ M := by
    rw [hmem]
    exact fun h1 => h1 ⟨1, mul_one 1⟩
  have hMmax : M.IsMaximal := by
    rw [Ideal.isMaximal_iff]
    refine ⟨hM1, fun J x _ hxM hxJ => ?_⟩
    rw [hmem, not_not] at hxM
    obtain ⟨z, hzx⟩ := hxM
    rw [← hzx]
    exact J.mul_mem_left z hxJ
  refine ⟨M, hMmax, fun J hJ => ?_⟩
  have hJM : J ≤ M := by
    intro x hxJ
    rw [hmem]
    intro hcon
    obtain ⟨z, hzx⟩ := hcon
    apply hJ.ne_top
    rw [Ideal.eq_top_iff_one, ← hzx]
    exact J.mul_mem_left z hxJ
  exact hJ.eq_of_le hMmax.ne_top hJM

/-- If `1 = a + b` with neither summand right invertible, there are two maximal right ideals. -/
theorem two_maximal_right {R : Type} [Semiring R] (a b : R) (hab : a + b = 1)
    (ha : ¬ ∃ z, a * z = 1) (hb : ¬ ∃ z, b * z = 1) :
    ∃ I J : Ideal Rᵐᵒᵖ, I.IsMaximal ∧ J.IsMaximal ∧ I ≠ J := by
  have key : ∀ c : R, (¬ ∃ z, c * z = 1) →
      Ideal.span ({MulOpposite.op c} : Set Rᵐᵒᵖ) ≠ ⊤ := by
    intro c hc htop
    have h1 : (1 : Rᵐᵒᵖ) ∈ Ideal.span ({MulOpposite.op c} : Set Rᵐᵒᵖ) := by
      rw [htop]
      exact Submodule.mem_top
    rw [Ideal.mem_span_singleton'] at h1
    obtain ⟨y, hy⟩ := h1
    apply hc
    refine ⟨MulOpposite.unop y, ?_⟩
    have h2 := congrArg MulOpposite.unop hy
    rw [MulOpposite.unop_mul, MulOpposite.unop_op, MulOpposite.unop_one] at h2
    exact h2
  obtain ⟨I, hI, haI⟩ := Ideal.exists_le_maximal _ (key a ha)
  obtain ⟨J, hJ, hbJ⟩ := Ideal.exists_le_maximal _ (key b hb)
  refine ⟨I, J, hI, hJ, fun hIJ => ?_⟩
  have h1 : MulOpposite.op a ∈ I := haI (Ideal.subset_span rfl)
  have h2 : MulOpposite.op b ∈ I := by
    rw [hIJ]
    exact hbJ (Ideal.subset_span rfl)
  have h3 : (1 : Rᵐᵒᵖ) ∈ I := by
    have h4 := I.add_mem h1 h2
    rw [← MulOpposite.op_add, hab, MulOpposite.op_one] at h4
    exact h4
  exact hI.ne_top ((Ideal.eq_top_iff_one I).mpr h3)

theorem T_zero_not_inv : ¬ ∃ z : T, z * 0 = 1 := by
  intro h
  obtain ⟨z, hz⟩ := h
  rw [mul_zero] at hz
  have e1 : (0 : LS) = 1 := congrArg (fun w : T => w.1.1) hz
  exact LS.one_ne_zero' e1.symm

theorem T_mem_a : (((1 : LS), LS.C 1) : LS × LS) ∈ T := by
  show (1 : LS) = 0 ↔ LS.C 1 = 0
  exact ⟨fun h => (LS.one_ne_zero' h).elim, fun h => (LS.C_ne_zero 1 h).elim⟩

theorem T_mem_b : ((LS.C 1, (1 : LS)) : LS × LS) ∈ T := by
  show LS.C 1 = 0 ↔ (1 : LS) = 0
  exact ⟨fun h => (LS.C_ne_zero 1 h).elim, fun h => (LS.one_ne_zero' h).elim⟩

theorem T_a_add_b : (⟨((1 : LS), LS.C 1), T_mem_a⟩ : T) + ⟨(LS.C 1, (1 : LS)), T_mem_b⟩ = 1 := by
  apply Subtype.ext
  apply Prod.ext
  · show (1 : LS) + LS.C 1 = 1
    exact LS.one_add_C_one
  · show LS.C 1 + (1 : LS) = 1
    exact LS.C_one_add_one

theorem T_a_not_right : ¬ ∃ z : T, (⟨((1 : LS), LS.C 1), T_mem_a⟩ : T) * z = 1 := by
  intro h
  obtain ⟨z, hz⟩ := h
  have e2 : LS.C 1 * z.1.2 = 1 := congrArg (fun w : T => w.1.2) hz
  exact LS.C_one_mul_ne_one _ e2

theorem T_b_not_right : ¬ ∃ z : T, (⟨(LS.C 1, (1 : LS)), T_mem_b⟩ : T) * z = 1 := by
  intro h
  obtain ⟨z, hz⟩ := h
  have e1 : LS.C 1 * z.1.1 = 1 := congrArg (fun w : T => w.1.1) hz
  exact LS.C_one_mul_ne_one _ e1

end OMA

theorem OMA.solution : type_of% @Mathoverflow486451.exists_semiring_unique_left_maximal_not_unique_right_maximal := by
  refine ⟨↥OMA.T, inferInstance, ?_, ?_⟩
  · exact OMA.unique_maximal_of_local OMA.T_zero_not_inv OMA.T_local
  · exact OMA.two_maximal_right _ _ OMA.T_a_add_b OMA.T_a_not_right OMA.T_b_not_right
