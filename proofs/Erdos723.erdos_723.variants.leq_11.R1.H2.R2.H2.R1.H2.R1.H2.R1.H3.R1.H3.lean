def word (s : Finset (Fin 60)) : Nat := ((List.finRange 60).map fun p => if p∈s then 2^p.val else 0).foldr Nat.lor 0

def key (s : Fin 15 → Fin 6 → Finset (Fin 60)) := ((List.range 344).map fun j =>
