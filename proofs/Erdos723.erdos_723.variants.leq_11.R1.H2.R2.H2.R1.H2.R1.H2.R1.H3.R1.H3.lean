      obtain ⟨a,ha,rfl⟩ := actual p hp
      obtain ⟨b,hb,rfl⟩ := actual q hq
      have hcard := valid_s.2.2.2 g h i l groups
      exact congrArg Fin.val (Finset.card_le_one.mp hcard a
        (Finset.mem_inter.mpr ⟨ha,(point_in_row hk a).mp bp⟩) b
        (Finset.mem_inter.mpr ⟨hb,(point_in_row hk b).mp bq⟩)))
    exact ⟨k, hk, by simpa [restrictRows, groups, Nat.testBit_xor, dk, full_bit, ←show ps = indices 6 (rowAt g j.val) from rfl, none]⟩

lemma allBranches_sound {f : Nat → Branch → Bool} (cs : List Branch) (w j : Nat)
    (bj : w.testBit j = true) (ok : allBranches f w cs = true) :
    ∃ c, f j c = true := by
  induction cs generalizing w with
  | nil =>
    simp [allBranches] at ok
    simp [ok] at bj
  | cons c cs ih =>
    simp only [allBranches, Bool.and_eq_true, decide_eq_true_eq] at ok
    by_cases same : j=tag c
    · exact ⟨c,same ▸ ok.1.2⟩
    apply ih _ _ ok.2
    have lt : j < tag c := by
      by_contra! ge
      have ge' : tag c + 1 ≤ j := by omega
      have h := Nat.pow_le_pow_right (n:=2) (by decide) ge'
      have bound := Nat.ge_two_pow_of_testBit bj
      omega
    simp [Nat.testBit_mod_two_pow, bj, lt]

theorem checkTree_sound (n : Nat) (c : Branch) (d : Fin 15 → Nat)
    (checked : checkTree n c d = true) {s} (h : valid s) (pos : possible s d) : False := by
  induction n generalizing c d with
  | zero => simp [checkTree] at checked
  | succ n ih =>
    obtain ⟨v, cs⟩ := c
    let g : Fin 15 := ⟨(v%1024/60)%15, Nat.mod_lt _ (by decide)⟩
    let p : Fin 60 := ⟨v%1024%60, Nat.mod_lt _ (by decide)⟩
    change (((g == 0 || decide (9 ≤ g.val)) && decide (allowed g p)) &&
      allBranches (fun j c => checkTree n c (restrictRows d g j)) (col g p.val &&& d g) cs) = true at checked
    simp only [Bool.and_eq_true, Bool.or_eq_true, beq_iff_eq, decide_eq_true_eq] at checked
    obtain ⟨i, hp, _⟩ := h.2.2.1 g p checked.1.2
    obtain ⟨k,eq,b⟩ := pos g checked.1.1 i
    have both : (col g p.val &&& d g).testBit k.val = true := by
      simp [Nat.testBit_land,(point_in_row eq p).mpr hp,b]
    obtain ⟨child,hc⟩ := allBranches_sound cs _ _ both checked.2
    exact ih child _ hc (restrict_possible h pos g i k eq b)

lemma key_bit (s : Assignment) (j : Nat) :
    (key s).testBit j = true ↔ j<344 ∧ ∃ i, catalogue.idxOf (word (s 0 i)) = j := by
  rw [key, fold_bit, exists_map]
  constructor
  · rintro ⟨k,hk,b⟩
    split at b
    · rename_i found
      have kj : k=j := by simpa [Nat.testBit_two_pow] using b
      subst k
      obtain ⟨i,_,e⟩ := List.any_eq_true.mp found
      exact ⟨List.mem_range.mp hk,i,beq_iff_eq.mp e⟩
    · simp at b
  · rintro ⟨lt,i,e⟩
    refine ⟨j,List.mem_range.mpr lt,?_⟩
    have b : (List.finRange 6).any (fun k => catalogue.idxOf (word (s 0 k)) == j) = true :=
      List.any_eq_true.mpr ⟨i,List.mem_finRange i,beq_iff_eq.mpr e⟩
    simp [b,Nat.testBit_two_pow_self]

def lower : Nat := 0x8000000000004000000020000000000800000000000000000000010000002000000000000
def upper : Nat := 0x8000000040000000020000000000000000000000200000000100000000200000000000000

lemma window {k : Nat} (lo : lower < k) (hi : k ≤ upper) :
    k.testBit 291 = true ∧ ∀ j, k.testBit j = true → j=291 ∨ j<259 := by
  have a : 2^291 ≤ lower := by decide +kernel
  have b : upper < 2^291 + 2^259 := by decide +kernel
  have c : upper < 2^(291+1) := by decide +kernel
  have bounds := Nat.testBit_of_two_pow_le_and_two_pow_add_one_gt (n:=k) (i:=291) (by omega) (by omega)
  refine ⟨bounds, fun j hb => ?_⟩
  have h2 := Nat.ge_two_pow_of_testBit hb
  have le : j ≤ 291 := by
    by_contra! ne
    have := Nat.pow_le_pow_right (n:=2) (by decide) ne
    omega
  by_cases eq : j=291
  · exact Or.inl eq
  right
  have bm : (k % 2^291).testBit j = true := by simp [Nat.testBit_mod_two_pow, hb, show j < 291 by omega]
  have d := Nat.ge_two_pow_of_testBit bm
  have quotient : k / 2^291 = 1 := by
    apply (Nat.div_eq_iff (by decide : 0 < 2^291)).mpr
    constructor <;> omega
  have factor := Nat.mod_add_div k (2^291)
  rw [quotient, Nat.mul_one] at factor
  by_contra! ge
  have := Nat.pow_le_pow_right (n:=2) (by decide) ge
  omega

lemma initial_possible {s : Assignment} (h : valid s) (lo : lower < key s) (hi : key s ≤ upper) :
    possible s (restrictRows start 0 291) := by
  have catLen : catalogue.length = 344 := by simp [catalogue_exact, rowList]
  have catRow (i : Fin 6) : word (s 0 i) ∈ catalogue := by
    rw [catalogue_exact, ←table_exact 0 (Or.inl rfl)]
    exact rows_complete h _ _
  have lookup (i : Fin 6) : rowAt 0 (catalogue.idxOf (word (s 0 i))) = word (s 0 i) := by
    have idx := List.getElem?_idxOf (catRow i)
    have lt := List.idxOf_lt_length_of_mem (catRow i)
    rw [catLen] at lt
    generalize catalogue.idxOf (word (s 0 i)) = n at *
    simpa [catalogue_exact, rowList, List.getElem?_eq_getElem, lt] using idx
  obtain ⟨top, other⟩ := window lo hi
  have pos : possible s start := by
    intro g hg i
    by_cases zero : g=0
    · subst g
      let j := catalogue.idxOf (word (s 0 i))
      have small : j<344 := catLen ▸ List.idxOf_lt_length_of_mem (catRow i)
      have bit := (key_bit s j).mpr ⟨small,i,rfl⟩
      refine ⟨⟨j,small⟩,lookup i,?_⟩
      rcases other j bit with e|e <;> simp [start,Nat.testBit_two_pow,e]
    · have hm := rows_complete h g i
      rw [table_exact g hg] at hm
      obtain ⟨j,_,eq⟩ := List.mem_map.mp hm
      exact ⟨j, eq, by simp [start,zero,full_bit]⟩
  obtain ⟨_,i,eq⟩ := (key_bit s 291).mp top
  apply restrict_possible h pos 0 i (⟨291,by decide⟩ : Fin 344)
  · simpa only [eq] using lookup i
  · decide +kernel

def state : List Nat → Fin 15 → Nat
  | [] => restrictRows start 0 291
  | j :: js => restrictRows (state js) 0 j

-- The first five choices are all in group zero. At their frontier the
-- remaining refutations may be checked independently.
def prefixOK (paths : List (List Nat)) : Nat → Branch → List Nat → Bool
  | 0, _, path => paths.contains path
  | n+1, .node v cs, path =>
    let p : Fin 60 := ⟨v%1024%60, Nat.mod_lt _ (by decide)⟩
    decide (allowed 0 p) &&
      allBranches (fun j c => prefixOK paths n c (j :: path)) (col 0 p.val &&& state path 0) cs

lemma prefix_sound (paths : List (List Nat)) {s} (vs : valid s)
    (excl : ∀ p ∈ paths, ¬possible s (state p))
    (n : Nat) (b : Branch) (path : List Nat) (ok : prefixOK paths n b path = true)
    (pos : possible s (state path)) : False := by
  induction n generalizing b path with
  | zero =>
    exact excl path (List.contains_iff_mem.mp ok) pos
  | succ n ih =>
    obtain ⟨v,cs⟩ := b
    let p : Fin 60 := ⟨v%1024%60,Nat.mod_lt _ (by decide)⟩
    change (decide (allowed 0 p) && allBranches _ _ cs) = true at ok
    simp only [Bool.and_eq_true] at ok
    obtain ⟨hp, children⟩ := ok
    obtain ⟨i,mem,_⟩ := vs.2.2.1 0 p (of_decide_eq_true hp)
    obtain ⟨k,eq,live⟩ := pos 0 (Or.inl rfl) i
    have bit : (col 0 p.val &&& state path 0).testBit k.val = true := by
      simp [(point_in_row eq p).mpr mem,live]
    obtain ⟨child,hc⟩ := allBranches_sound cs _ _ bit children
    exact ih child (k.val :: path) hc (restrict_possible vs pos 0 i k eq live)
