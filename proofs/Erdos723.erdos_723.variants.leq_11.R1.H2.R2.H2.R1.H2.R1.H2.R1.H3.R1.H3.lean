-- Enumerate an exact cover by choosing the set over the highest uncovered bit.
def covers {α : Type} (mask : α → Nat) (pool : Nat → List α) :
    Nat → Nat → List (List α)
  | 0, w => if w = 0 then [[]] else []
  | n+1, w => if w = 0 then [[]] else
      (pool w.log2).flatMap fun x =>
        if mask x &&& w == mask x then
          (covers mask pool n (w ^^^ mask x)).map (x :: ·)
        else []

lemma covers_complete {α : Type} [DecidableEq α] (mask : α → Nat)
    (pool : Nat → List α) (n w : Nat) (t : Finset α)
    (size : t.card ≤ n)
    (listed : ∀ x ∈ t, ∀ j, (mask x).testBit j = true → x ∈ pool j)
    (nonzero : ∀ x ∈ t, mask x ≠ 0)
    (inside : ∀ x ∈ t, ∀ j, (mask x).testBit j = true → w.testBit j = true)
    (unique : ∀ j, w.testBit j = true → ∃! x, x ∈ t ∧ (mask x).testBit j = true) :
    ∃ xs ∈ covers mask pool n w, xs.toFinset = t := by
  have empty (hw : w = 0) : t = ∅ := by
    apply Finset.eq_empty_iff_forall_notMem.mpr
    intro x hx
    obtain ⟨j, hj⟩ := Nat.exists_testBit_of_ne_zero (nonzero x hx)
    simpa [hw] using inside x hx j hj
  induction n generalizing w t with
  | zero =>
    have ht : t = ∅ := Finset.card_eq_zero.mp (by omega)
    have hw : w = 0 := by
      by_contra h
      obtain ⟨x, hx, _⟩ := unique _ (Nat.testBit_log2 h)
      simpa [ht] using hx.1
    exact ⟨[], by simp [covers, hw], by simp [ht]⟩
  | succ n ih =>
    by_cases hw : w = 0
    · exact ⟨[], by simp [covers, hw], by simp [empty hw]⟩
    obtain ⟨x, ⟨hx, hb⟩, _⟩ := unique _ (Nat.testBit_log2 hw)
    have sub : mask x &&& w = mask x := by
      apply Nat.eq_of_testBit_eq
      intro j
      rw [Nat.testBit_land]
      cases h : (mask x).testBit j <;> simp [*, inside x hx j]
    have rest (y) (hy : y ∈ t.erase x) (j) (b : (mask y).testBit j = true) :
        (w ^^^ mask x).testBit j = true := by
      obtain ⟨hne, ht⟩ := Finset.mem_erase.mp hy
      have bw := inside y ht j b
      have bx : (mask x).testBit j = false := by
        cases eq : (mask x).testBit j
        · rfl
        obtain ⟨z, _, only⟩ := unique j bw
        exact False.elim (hne ((only y ⟨ht,b⟩).trans (only x ⟨hx,eq⟩).symm))
      simp [Nat.testBit_xor, bw, bx]
    obtain ⟨xs, mem, hxs⟩ := ih (w ^^^ mask x) (t.erase x)
      (by rw [Finset.card_erase_of_mem hx]; have := Finset.card_pos.mpr ⟨x,hx⟩; omega)
      (fun y hy => listed y (Finset.mem_of_mem_erase hy))
      (fun y hy => nonzero y (Finset.mem_of_mem_erase hy)) rest (by
        intro j b
        rw [Nat.testBit_xor] at b
        have bx : (mask x).testBit j = false := by
          cases h : (mask x).testBit j
          · rfl
          simp [h, inside x hx j h] at b
        have bw : w.testBit j = true := by simpa [bx] using b
        obtain ⟨z, ⟨hz, bit⟩, only⟩ := unique j bw
        refine ⟨z, ⟨Finset.mem_erase.mpr ⟨?_,hz⟩,bit⟩, ?_⟩
        · rintro rfl
          simp [bx] at bit
        · exact fun y hy => only y ⟨Finset.mem_of_mem_erase hy.1,hy.2⟩)
      (by intro h; apply Finset.eq_empty_iff_forall_notMem.mpr; intro y hy
          obtain ⟨j,b⟩ := Nat.exists_testBit_of_ne_zero (nonzero y (Finset.mem_of_mem_erase hy))
          simpa [h] using rest y hy j b)
    refine ⟨x :: xs, ?_, by simp [hxs, hx]⟩
    simp only [covers, if_neg hw, List.mem_flatMap]
    exact ⟨x, listed x hx _ hb, by simpa [sub] using List.mem_map_of_mem (f := (x :: ·)) mem⟩

-- The fold lemma follows the packed-mask argument in @avivorly’s merged
-- first-group indexing proof (FiniteSearchMasks.foldr_or_testBit).
lemma fold_bit (ws : List Nat) (j : Nat) :
    (ws.foldr Nat.lor 0).testBit j = true ↔ ∃ w ∈ ws, w.testBit j = true := by
  induction ws with
  | nil => simp
  | cons w ws ih =>
    change (w ||| ws.foldr Nat.lor 0).testBit j = true ↔ _
    simp [ih]

lemma exists_map {α β : Type} {xs : List α} {f : α → β} {P : β → Prop} :
    (∃ y ∈ xs.map f, P y) ↔ ∃ x ∈ xs, P (f x) := by simp

lemma word_bit (t : Finset (Fin 60)) (j : Nat) :
    (word t).testBit j = true ↔ ∃ p ∈ t, p.val = j := by
  rw [word, fold_bit]
  simp only [exists_map]
  constructor
  · rintro ⟨p, _, h⟩
    split at h
    · exact ⟨p, by assumption, by simpa [Nat.testBit_two_pow] using h⟩
    · simp at h
  · rintro ⟨p, hp, rfl⟩
    exact ⟨p, List.mem_finRange p, by simp [hp, Nat.testBit_two_pow_self]⟩

def pack (ps : List (Fin 60)) : Nat := (ps.map (fun p => 2^p.val)).foldr Nat.lor 0

lemma pack_eq (ps : List (Fin 60)) : pack ps = word ps.toFinset := by
  apply Nat.eq_of_testBit_eq
  intro j
  apply Bool.eq_iff_iff.mpr
  rw [pack, fold_bit, word_bit]
  simp [exists_map, Nat.testBit_two_pow]

