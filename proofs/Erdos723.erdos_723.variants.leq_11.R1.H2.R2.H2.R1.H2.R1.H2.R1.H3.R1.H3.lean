lemma rows_complete {s} (h : valid s) (g : Fin 15) (i : Fin 6) :
    word (s g i) ∈ rawRows g := by
  have ep : ∀ p : Fin 60, endpoints p ≠ 0 ∧ endpoints p < 2^15 := by decide +kernel
  have vb : ∀ g : Fin 15, vertexMask g < 2^15 := by decide +kernel
  have vr : ∀ g m : Fin 15, (vertexMask g).testBit m.val = true ↔ required g m := by
    unfold required; decide +kernel
  have ins : ∀ (g : Fin 15) (p : Fin 60) (m : Fin 15), allowed g p →
      (endpoints p).testBit m.val = true → (vertexMask g).testBit m.val = true := by decide +kernel
  obtain ⟨xs, mem, eq⟩ := covers_complete endpoints (pointPool g) 60 (vertexMask g) (s g i)
    (by simpa using Finset.card_le_univ (s g i))
    (by intro p hp j hj; simp [pointPool, h.1 g i p hp, hj])
    (fun p _ => (ep p).1)
    (by intro p hp j hj
        have b := Nat.ge_two_pow_of_testBit hj
        have : j < 15 := by by_contra! hn; exact (Nat.not_le_of_gt (ep p).2) (le_trans (Nat.pow_le_pow_right (by decide) hn) b)
        exact ins g p ⟨j,this⟩ (h.1 g i p hp) hj)
    (by intro j hj
        have b := Nat.ge_two_pow_of_testBit hj
        have : j < 15 := by by_contra! hn; exact (Nat.not_le_of_gt (vb g)) (le_trans (Nat.pow_le_pow_right (by decide) hn) b)
        exact h.2.1 g i ⟨j,this⟩ ((vr g ⟨j,this⟩).mp hj))
  exact List.mem_map.mpr ⟨xs,mem,by rw [pack_eq,eq]⟩
