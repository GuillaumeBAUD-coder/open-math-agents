def indices : Nat → Nat → List Nat
  | 0, _ => []
  | n+1, w => if w=0 then [] else w.log2 :: indices n (w % 2^w.log2)

def effects (g : Fin 15) : List Nat → Nat × Nat
  | [] => (0,0)
  | p :: ps =>
    let (once, twice) := effects g ps
    let c := col g p
    (once ||| c, twice ||| (once &&& c))

def restrictRows (d : Fin 15 → Nat) (g : Fin 15) (j : Nat) (h : Fin 15) :=
  let (once, twice) := effects h (indices 6 (rowAt g j))
  d h &&& (if g = h then (2^j ||| (full ^^^ once)) else full ^^^ twice)

inductive Branch where
  | node (label : Nat) (children : List Branch)

def tag : Branch → Nat
  | .node label _ => label / 1024

def allBranches (f : Nat → Branch → Bool) : Nat → List Branch → Bool
  | w, [] => w == 0
  | w, c :: cs =>
      let j := tag c
      decide (w < 2^(j+1)) && f j c && allBranches f (w % 2^j) cs

def checkTree : Nat → Branch → (Fin 15 → Nat) → Bool
  | 0, _, _ => false
  | n+1, .node v cs, d =>
    let g : Fin 15 := ⟨(v%1024/60)%15, Nat.mod_lt _ (by decide)⟩
    let p : Fin 60 := ⟨v%1024%60, Nat.mod_lt _ (by decide)⟩
    ((g == 0 || 9 ≤ g.val) && decide (allowed g p)) &&
      allBranches (fun j c => checkTree n c (restrictRows d g j)) (col g p.val &&& d g) cs

def start (g : Fin 15) : Nat := if g = 0 then 2^291 ||| (2^259-1) else full

lemma indices_sound (n w p : Nat) (h : p ∈ indices n w) : w.testBit p = true := by
  induction n generalizing w with
  | zero => simp [indices] at h
  | succ n ih =>
    by_cases e : w=0
    · simp [indices,e] at h
    simp only [indices, if_neg e, List.mem_cons] at h
    rcases h with rfl | h
    · exact Nat.testBit_log2 e
    · have := ih _ h
      rw [Nat.testBit_mod_two_pow, Bool.and_eq_true] at this
      exact this.2

lemma indices_nodup (n w : Nat) : (indices n w).Nodup := by
  induction n generalizing w with
  | zero => simp [indices]
  | succ n ih =>
    by_cases e : w=0
    · simp [indices,e]
    simp only [indices, if_neg e, List.nodup_cons]
    refine ⟨fun h => ?_, ih _⟩
    have := indices_sound _ _ _ h
    simp [Nat.testBit_mod_two_pow] at this

lemma hits (g : Fin 15) (ps : List Nat) (i : Nat) :
    (effects g ps).1.testBit i = true ↔ ∃ p ∈ ps, (col g p).testBit i = true := by
  induction ps with
  | nil => simp [effects]
  | cons p ps ih => simp [effects, ih, or_comm]

lemma no_double (g : Fin 15) (ps : List Nat) (i : Nat) (nd : ps.Nodup)
    (single : ∀ p ∈ ps, ∀ q ∈ ps, (col g p).testBit i = true →
              (col g q).testBit i = true → p=q) :
    (effects g ps).2.testBit i = false := by
  induction ps with
  | nil => simp [effects]
  | cons p ps ih =>
    obtain ⟨hn,nd⟩ := List.nodup_cons.mp nd
    have tail := ih nd (fun a ha b hb => single a (.tail _ ha) b (.tail _ hb))
    simp only [effects, Nat.testBit_lor, Nat.testBit_land, tail, Bool.false_or]
    cases h : (col g p).testBit i with
    | false => simp
    | true =>
      simp only [Bool.and_true]
      cases e : (effects g ps).1.testBit i with
      | false => rfl
      | true =>
        obtain ⟨q,hq,bq⟩ := (hits g ps i).mp e
        exact (hn ((single p (.head _) q (.tail _ hq) h bq) ▸ hq)).elim

abbrev Assignment := Fin 15 → Fin 6 → Finset (Fin 60)

def possible (s : Assignment) (d : Fin 15 → Nat) := ∀ g, active g → ∀ i,
