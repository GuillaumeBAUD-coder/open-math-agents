    (col g p.val).testBit k.val = true ↔ p ∈ t := by
  rw [col_exact, eq, word_bit]
  exact ⟨fun ⟨a,ha,e⟩ => Fin.ext e ▸ ha, fun hp => ⟨p,hp,rfl⟩⟩

lemma full_bit (i : Fin 344) : full.testBit i.val = true := by simp [full, i.isLt]

