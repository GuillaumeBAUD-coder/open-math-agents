-- One bit from each 344-bit column forms a row.  Since 2^344 is
-- congruent to 2 modulo 2^343-1, a remainder packs these bits together.
def lane : Nat → Nat
  | 0 => 0
  | n+1 => 1 + 2^344 * lane n
def gather : Nat → Nat → Nat
  | 0, _ => 0
  | n+1, w => w%2 + 2 * gather n (w >>> 344)

lemma gather_lt (n w : Nat) : gather n w < 2^n := by
  induction n generalizing w with
  | zero => simp [gather]
  | succ n ih =>
    rw [gather, pow_succ]
    have := ih (w >>> 344)
    omega

lemma gather_bit (n w p : Nat) (hp : p<n) :
    (gather n w).testBit p = w.testBit (344*p) := by
  induction n generalizing w p with
  | zero => omega
  | succ n ih =>
    cases p with
    | zero => simp [gather, Nat.add_mul_mod_self_left]
    | succ p =>
      rw [gather, Nat.testBit_succ, Nat.add_mul_div_left _ _ (by decide : 0<2)]
      rw [show (w%2)/2=0 by omega, Nat.zero_add, ih _ _ (by omega)]
      simp [Nat.mul_succ, Nat.add_comm]

lemma lane_step (w n : Nat) :
    w &&& lane (n+1) = w%2 + 2^344 * ((w >>> 344) &&& lane n) := by
  let b := 2^344
  have pos : 0<b := by decide +kernel
  have low : (w &&& lane (n+1)) % b = w%2 := by
    rw [Nat.and_mod_two_pow, lane, Nat.add_mul_mod_self_left]
    have one : 1 % b = 1 := by decide +kernel
    change w%b &&& (1%b) = w%2
    rw [one, Nat.and_one_is_mod, Nat.mod_mod_of_dvd]
    exact ⟨2^343, by decide +kernel⟩
  have high : (w &&& lane (n+1)) / b = (w >>> 344) &&& lane n := by
    change (w &&& lane (n+1)) / 2^344 = _
    rw [←Nat.shiftRight_eq_div_pow, Nat.shiftRight_and_distrib, lane, Nat.shiftRight_eq_div_pow (1 + _)]
    rw [Nat.add_mul_div_left _ _ pos, show 1 / 2^344 = 0 by decide +kernel, Nat.zero_add]
  have := Nat.mod_add_div (w &&& lane (n+1)) b
  simpa only [low,high] using this.symm

def modulus : Nat := 2^343-1
lemma lane_gather (n w : Nat) (hn : n ≤ 60) :
    (w &&& lane n) % modulus = gather n w := by
  induction n generalizing w with
  | zero => simp [lane,gather]
  | succ n ih =>
    rw [lane_step, Nat.add_mod, Nat.mul_mod, ih _ (by omega)]
    have b : 2^344 % modulus = 2 := by decide +kernel
    rw [b, Nat.add_mod_mod, Nat.mod_add_mod]
    apply Nat.mod_eq_of_lt
    exact lt_trans (gather_lt (n+1) w) (lt_of_le_of_lt (Nat.pow_le_pow_right (by decide) hn)
      (by decide +kernel : (2:Nat)^60 < modulus))

