lemma center5 (r : Fin 114 → Bool) (hr : r (Fin.ofNat 114 51) = true)
    (hb : ∀ i : Fin 114, 51 < i.val → i.val < 62 → r i = false) : Mono r := by
  by_contra hn
  apply node24 (Red r) (noTriple_of_not_mono hn) (all_hit hn)
  · intro x hx
    have he : x = 51 := by simpa using hx
    exact he ▸ ⟨by decide, hr⟩
  · intro x hx
    obtain ⟨h114,hred⟩ := hx
    have hbound : x ≤ 51 ∨ 62 ≤ x := by
      by_contra! bad
      have hblue := hb ⟨x,h114⟩ bad.1 bad.2
      have he : (Fin.ofNat 114 x) = ⟨x,h114⟩ := Fin.ext (Nat.mod_eq_of_lt h114)
      exact Bool.noConfusion (hred.symm.trans ((congrArg r he).trans hblue))
    have hbits : ∀ t : Fin 114, t.val ≤ 51 ∨ 62 ≤ t.val →
        Nat.testBit 0x3ffffffffffffc00fffffffffffff t.val = true := by decide +kernel
    exact hbits ⟨x,h114⟩ hbound

lemma center4 (r : Fin 114 → Bool) (hr : r (Fin.ofNat 114 52) = true)
    (hb : ∀ i : Fin 114, 52 < i.val → i.val < 61 → r i = false) : Mono r := by
  by_contra hn
  apply node109 (Red r) (noTriple_of_not_mono hn) (all_hit hn)
  · intro x hx
    have he : x = 52 := by simpa using hx
    exact he ▸ ⟨by decide, hr⟩
  · intro x hx
    obtain ⟨h114,hred⟩ := hx
    have hbound : x ≤ 52 ∨ 61 ≤ x := by
      by_contra! bad
      have hblue := hb ⟨x,h114⟩ bad.1 bad.2
      have he : (Fin.ofNat 114 x) = ⟨x,h114⟩ := Fin.ext (Nat.mod_eq_of_lt h114)
      exact Bool.noConfusion (hred.symm.trans ((congrArg r he).trans hblue))
    have hbits : ∀ t : Fin 114, t.val ≤ 52 ∨ 61 ≤ t.val →
        Nat.testBit 0x3ffffffffffffe01fffffffffffff t.val = true := by decide +kernel
    exact hbits ⟨x,h114⟩ hbound

end OMA.Progressions

theorem OMA.solution : OMA.R_Green14_W_3_11_R1.H3 := by
  intro r j hj hj' hr hb
  have he : j.val = 4 ∨ j.val = 5 := by omega
  rcases he with he | he
  · exact OMA.Progressions.center4 r (by simpa [he] using hr) (by simpa [he] using hb)
  · exact OMA.Progressions.center5 r (by simpa [he] using hr) (by simpa [he] using hb)
