/-! ### Arrays as functions on ℕ × ℕ -/

/-- The array `x` as a function on `ℕ × ℕ`, with 0 outside. -/
def ext {n : ℕ} (x : Fin 7 → Fin n → Fin 2) (i j : ℕ) : ℕ :=
  if h : i < 7 ∧ j < n then (x ⟨i, h.1⟩ ⟨j, h.2⟩).val else 0

theorem ext_eq {n : ℕ} (x : Fin 7 → Fin n → Fin 2) {i j : ℕ} (hi : i < 7) (hj : j < n) :
    ext x i j = (x ⟨i, hi⟩ ⟨j, hj⟩).val := dif_pos ⟨hi, hj⟩

theorem ext_lt {n : ℕ} (x : Fin 7 → Fin n → Fin 2) (i j : ℕ) : ext x i j < 2 := by
  unfold ext
  split_ifs
  · exact Fin.isLt _
  · norm_num

/-- The conditions of `Good` for a function on `ℕ × ℕ` and `n` columns. -/
def GoodN (X : ℕ → ℕ → ℕ) (n : ℕ) : Prop :=
  (∀ i j, i < 7 → j + 1 < n → X i j ≤ X i (j + 1)) ∧
  (∀ i j, i + 1 < 7 → j + 1 < n → X i j ≤ X (i + 1) (j + 1)) ∧
  (∀ i1 i2 i3 j1 j2 j3, i1 < i2 → i2 < i3 → i3 < 7 → j1 < n → j2 < n → j3 < n →
    i1 + j1 = i2 + j2 → i2 + j2 = i3 + j3 → ¬ (X i2 j2 < X i1 j1 ∧ X i2 j2 < X i3 j3))

theorem good_iff {n : ℕ} (x : Fin 7 → Fin n → Fin 2) : Good x ↔ GoodN (ext x) n := by
  constructor
  · rintro ⟨h1, h2, h3⟩
    refine ⟨fun i j hi hj => ?_, fun i j hi hj => ?_, fun i1 i2 i3 j1 j2 j3 a b c d e f g h => ?_⟩
    · rw [ext_eq x hi (by omega), ext_eq x hi hj]
      exact h1 ⟨i, hi⟩ ⟨j, by omega⟩ ⟨j + 1, hj⟩ rfl
    · rw [ext_eq x (by omega) (by omega), ext_eq x hi hj]
      exact h2 ⟨i, by omega⟩ ⟨i + 1, hi⟩ ⟨j, by omega⟩ ⟨j + 1, hj⟩ rfl rfl
    · rw [ext_eq x (by omega) e, ext_eq x (by omega) d, ext_eq x c f]
      exact h3 ⟨i1, by omega⟩ ⟨i2, by omega⟩ ⟨i3, c⟩ ⟨j1, d⟩ ⟨j2, e⟩ ⟨j3, f⟩
        (Fin.mk_lt_mk.mpr a) (Fin.mk_lt_mk.mpr b) g h
  · rintro ⟨h1, h2, h3⟩
    refine ⟨fun i j j' hj => ?_, fun i i' j j' hi hj => ?_,
      fun i1 i2 i3 j1 j2 j3 a b g h => ?_⟩
    · have := h1 i.val j.val i.isLt (by omega)
      rw [ext_eq x i.isLt j.isLt, ← hj, ext_eq x i.isLt j'.isLt] at this
      exact this
    · have := h2 i.val j.val (by omega) (by omega)
      rw [ext_eq x i.isLt j.isLt, ← hi, ← hj, ext_eq x i'.isLt j'.isLt] at this
      exact this
    · have := h3 i1.val i2.val i3.val j1.val j2.val j3.val a b i3.isLt j1.isLt j2.isLt j3.isLt g h
      rw [ext_eq x i1.isLt j1.isLt, ext_eq x i2.isLt j2.isLt, ext_eq x i3.isLt j3.isLt] at this
      exact this

/-- The conditions involving a new last column `c` after `n` columns of `X`. -/
def LocalN (X : ℕ → ℕ → ℕ) (n : ℕ) (c : ℕ → ℕ) : Prop :=
  (∀ i, i < 7 → 1 ≤ n → X i (n - 1) ≤ c i) ∧
  (∀ i, i + 1 < 7 → 1 ≤ n → X i (n - 1) ≤ c (i + 1)) ∧
  (∀ i1 i2 i3, i1 < i2 → i2 < i3 → i3 < 7 → i3 - i1 ≤ n →
    ¬ (X i2 (n - (i2 - i1)) < c i1 ∧ X i2 (n - (i2 - i1)) < X i3 (n - (i3 - i1))))

theorem goodN_snoc (X X' : ℕ → ℕ → ℕ) (n : ℕ) (c : ℕ → ℕ)
    (hX : ∀ i j, j < n → X' i j = X i j) (hc : ∀ i, X' i n = c i) :
    GoodN X' (n + 1) ↔ GoodN X n ∧ LocalN X n c := by
  constructor
  · rintro ⟨h1, h2, h3⟩
    refine ⟨⟨fun i j hi hj => ?_, fun i j hi hj => ?_,
      fun i1 i2 i3 j1 j2 j3 a b c' d e f g h => ?_⟩,
      fun i hi hn => ?_, fun i hi hn => ?_, fun i1 i2 i3 a b c' d => ?_⟩
    · have := h1 i j hi (by omega)
      rwa [hX i j (by omega), hX i (j + 1) hj] at this
    · have := h2 i j hi (by omega)
      rwa [hX i j (by omega), hX (i + 1) (j + 1) hj] at this
    · have := h3 i1 i2 i3 j1 j2 j3 a b c' (by omega) (by omega) (by omega) g h
      rwa [hX i1 j1 d, hX i2 j2 e, hX i3 j3 f] at this
    · have := h1 i (n - 1) hi (by omega)
      rwa [hX i (n - 1) (by omega), show n - 1 + 1 = n by omega, hc] at this
    · have := h2 i (n - 1) hi (by omega)
      rwa [hX i (n - 1) (by omega), show n - 1 + 1 = n by omega, hc] at this
    · have := h3 i1 i2 i3 n (n - (i2 - i1)) (n - (i3 - i1)) a b c' (by omega) (by omega)
        (by omega) (by omega) (by omega)
      rwa [hc, hX i2 (n - (i2 - i1)) (by omega), hX i3 (n - (i3 - i1)) (by omega)] at this
  · rintro ⟨⟨h1, h2, h3⟩, l1, l2, l3⟩
    refine ⟨fun i j hi hj => ?_, fun i j hi hj => ?_,
      fun i1 i2 i3 j1 j2 j3 a b c' d e f g h => ?_⟩
    · rw [hX i j (by omega)]
      by_cases hjn : j + 1 < n
      · rw [hX i (j + 1) hjn]
        exact h1 i j hi hjn
      · rw [show j + 1 = n by omega, hc]
        have := l1 i hi (by omega)
        rwa [show n - 1 = j by omega] at this
    · rw [hX i j (by omega)]
      by_cases hjn : j + 1 < n
      · rw [hX (i + 1) (j + 1) hjn]
        exact h2 i j hi hjn
      · rw [show j + 1 = n by omega, hc]
        have := l2 i hi (by omega)
        rwa [show n - 1 = j by omega] at this
    · rw [hX i2 j2 (by omega), hX i3 j3 (by omega)]
      by_cases hj1 : j1 < n
      · rw [hX i1 j1 hj1]
        exact h3 i1 i2 i3 j1 j2 j3 a b c' hj1 (by omega) (by omega) g h
      · rw [show j1 = n by omega, hc]
        have := l3 i1 i2 i3 a b c' (by omega)
        rwa [show n - (i2 - i1) = j2 by omega, show n - (i3 - i1) = j3 by omega] at this

/-! ### Window codes -/

theorem bitN_enc : ∀ (l : List ℕ), (∀ b ∈ l, b < 2) → ∀ p, bitN (enc l) p = l.getD p 0
  | [], _, p => by simp [bitN, enc]
  | b :: l, h, p => by
    have hb : b < 2 := h b (List.mem_cons_self)
    have ih := bitN_enc l (fun b' hb' => h b' (List.mem_cons_of_mem _ hb'))
    cases p with
    | zero =>
      simp only [bitN, enc, pow_zero, Nat.div_one, List.getD_cons_zero]
      omega
    | succ p =>
      rw [List.getD_cons_succ, ← ih p]
      unfold bitN
      rw [enc, pow_succ', ← Nat.div_div_eq_div_mul, show (b + 2 * enc l) / 2 = enc l by omega]

theorem enc_lt : ∀ (l : List ℕ), (∀ b ∈ l, b < 2) → enc l < 2 ^ l.length
  | [], _ => by simp [enc]
  | b :: l, h => by
    have hb : b < 2 := h b (List.mem_cons_self)
    have ih := enc_lt l (fun b' hb' => h b' (List.mem_cons_of_mem _ hb'))
    rw [enc, List.length_cons, pow_succ]
    omega

theorem bitN_lt (s p : ℕ) : bitN s p < 2 := Nat.mod_lt _ (by norm_num)

/-- The window bit at position `p` of `X` after `n` columns. -/
def Yb (X : ℕ → ℕ → ℕ) (n p : ℕ) : ℕ :=
  if distOf p ≤ n then X (rowOf p) (n - distOf p) else 0

/-- The window code of `X` after `n` columns. -/
def code (X : ℕ → ℕ → ℕ) (n : ℕ) : ℕ := enc ((List.range 22).map (Yb X n))

theorem Yb_lt {X : ℕ → ℕ → ℕ} (hX : ∀ i j, X i j < 2) (n p : ℕ) : Yb X n p < 2 := by
  unfold Yb
  split_ifs
  · exact hX _ _
  · norm_num

theorem bits_mem {X : ℕ → ℕ → ℕ} (hX : ∀ i j, X i j < 2) (n : ℕ) :
    ∀ b ∈ (List.range 22).map (Yb X n), b < 2 := by
  intro b hb
  obtain ⟨p, _, rfl⟩ := List.mem_map.mp hb
  exact Yb_lt hX n p

theorem bitN_code {X : ℕ → ℕ → ℕ} (hX : ∀ i j, X i j < 2) (n : ℕ) {p : ℕ} (hp : p < 22) :
    bitN (code X n) p = Yb X n p := by
  unfold code
  rw [bitN_enc _ (bits_mem hX n)]
  simp [hp]

theorem code_lt {X : ℕ → ℕ → ℕ} (hX : ∀ i j, X i j < 2) (n : ℕ) : code X n < 4194304 := by
  have := enc_lt _ (bits_mem hX n)
  rw [List.length_map, List.length_range] at this
  unfold code
  norm_num at this
  exact this

theorem code_zero (X : ℕ → ℕ → ℕ) : code X 0 = 0 := by
  have h : ∀ p ∈ List.range 22, Yb X 0 p = (fun _ => 0) p := by
    intro p hp
    have hp' := List.mem_range.mp hp
    have hd : ∀ p < 22, 1 ≤ distOf p := by decide
    unfold Yb
    rw [if_neg (by have := hd p hp'; omega)]
  unfold code
  rw [List.map_congr_left h]
  rfl

/-- Finite facts about the window positions. -/
theorem pos_facts : ∀ i < 7, ∀ d < 7, 1 ≤ d → d ≤ i →
    posW i d < 22 ∧ rowOf (posW i d) = i ∧ distOf (posW i d) = d := by
  decide

theorem start_facts : ∀ i < 7, startR i < 22 ∧ rowOf (startR i) = i ∧ distOf (startR i) = 1 := by
  decide

theorem prev_facts : ∀ p < 22, distOf p ≠ 1 →
    2 ≤ distOf p ∧ rowOf (p - 1) = rowOf p ∧ distOf (p - 1) = distOf p - 1 := by
  decide

theorem row_facts : ∀ p < 22, rowOf p < 7 ∧ 1 ≤ distOf p := by
  decide

theorem allR_iff (p : ℕ → Bool) : ∀ n lo, allR lo n p = true ↔ ∀ i, lo ≤ i → i < lo + n → p i = true
  | 0, lo => by
    simp only [allR, true_iff]
    intro i h1 h2
    omega
  | n + 1, lo => by
    rw [allR, Bool.and_eq_true, allR_iff p n (lo + 1)]
    constructor
    · rintro ⟨h0, h⟩ i h1 h2
      rcases Nat.eq_or_lt_of_le h1 with rfl | h1'
      · exact h0
      · exact h i h1' (by omega)
    · intro h
      exact ⟨h lo le_rfl (by omega), fun i h1 h2 => h i (by omega) (by omega)⟩

theorem tb (x i : ℕ) : x.testBit i = true ↔ bitN x i = 1 := by
  rw [Nat.testBit_eq_decide_div_mod_eq, decide_eq_true_eq]
  rfl

theorem or_eq_self_iff (x y : ℕ) :
    x ||| y = y ↔ ∀ i, x.testBit i = true → y.testBit i = true := by
  constructor
  · intro h i hx
    rw [← h, Nat.testBit_or, hx, Bool.true_or]
  · intro h
    apply Nat.eq_of_testBit_eq
    intro i
    rw [Nat.testBit_or]
    cases hx : x.testBit i
    · rw [Bool.false_or]
    · rw [h i hx, Bool.true_or]

theorem and_eq_zero_iff' (x y : ℕ) :
    x &&& y = 0 ↔ ∀ i, x.testBit i = true → y.testBit i = false := by
  constructor
  · intro h i hx
    have := congrArg (fun z => z.testBit i) h
    simp only [Nat.testBit_and, hx, Bool.true_and, Nat.zero_testBit] at this
    exact this
  · intro h
    apply Nat.eq_of_testBit_eq
    intro i
    rw [Nat.testBit_and, Nat.zero_testBit]
    cases hx : x.testBit i
    · rw [Bool.false_and]
    · rw [h i hx, Bool.true_and]

theorem r7_eq : r7 = List.range 7 := rfl

theorem r22_eq : r22 = List.range 22 := rfl

theorem bitN_enc7 (f : ℕ → ℕ) (hf : ∀ i, f i < 2) (i : ℕ) :
    bitN (enc (r7.map f)) i = if i < 7 then f i else 0 := by
  rw [r7_eq, bitN_enc _ (by
    intro b hb
    obtain ⟨j, _, rfl⟩ := List.mem_map.mp hb
    exact hf j)]
  by_cases hi : i < 7 <;> simp [hi]

theorem reqBit_lt (s i : ℕ) : reqBit s i < 2 := by
  unfold reqBit
  have := bitN_lt s (startR i)
  have := bitN_lt s (startR (i - 1))
  split_ifs <;> omega

theorem locb_iff (s cc : ℕ) : locb s cc = true ↔
    (∀ i < 7, reqBit s i ≤ bitN cc i) ∧ (∀ i < 7, badB s i = true → bitN cc i = 0) := by
  unfold locb
  rw [Bool.and_eq_true, Nat.beq_eq, Nat.beq_eq, or_eq_self_iff, and_eq_zero_iff']
  have hr := bitN_enc7 (reqBit s) (reqBit_lt s)
  have hb := bitN_enc7 (fun i => if badB s i = true then 1 else 0)
    (fun i => by split_ifs <;> norm_num)
  refine and_congr ⟨fun h i hi => ?_, fun h i hx => ?_⟩ ⟨fun h i hi hbad => ?_, fun h i hx => ?_⟩
  · have h1 := reqBit_lt s i
    have h2 := bitN_lt cc i
    by_contra hlt
    have hq : reqBit s i = 1 := by omega
    have := (tb cc i).mp (h i ((tb _ i).mpr (by unfold reqv; rw [hr, if_pos hi]; exact hq)))
    omega
  · rw [tb] at hx ⊢
    unfold reqv at hx
    rw [hr] at hx
    split_ifs at hx with hi
    · have := h i hi
      have := bitN_lt cc i
      omega
  · have hf := h i ((tb _ i).mpr (by unfold badv; rw [hb, if_pos hi, if_pos hbad]))
    have h3 := bitN_lt cc i
    rcases Nat.lt_or_ge (bitN cc i) 1 with h4 | h4
    · omega
    · rw [(tb cc i).mpr (by omega)] at hf
      exact absurd hf (by decide)
  · rw [tb] at hx
    unfold badv at hx
    rw [hb] at hx
    split_ifs at hx with hi hbad
    · have := h i hi hbad
      cases hc : cc.testBit i
      · rfl
      · rw [tb] at hc
        omega

theorem local_iff {X : ℕ → ℕ → ℕ} (hX : ∀ i j, X i j < 2) (n : ℕ) (c : ℕ → ℕ)
    (s cc : ℕ) (hs : ∀ p < 22, bitN s p = Yb X n p) (hc : ∀ i < 7, bitN cc i = c i) :
    LocalN X n c ↔ locb s cc = true := by
  have hrow : ∀ i < 7, bitN s (startR i) = if 1 ≤ n then X i (n - 1) else 0 := by
    intro i hi
    obtain ⟨h1, h2, h3⟩ := start_facts i hi
    rw [hs _ h1, Yb, h2, h3]
  have hpos : ∀ i d, i < 7 → 1 ≤ d → d ≤ i →
      bitN s (posW i d) = if d ≤ n then X i (n - d) else 0 := by
    intro i d hi h1 h2
    obtain ⟨g1, g2, g3⟩ := pos_facts i hi d (by omega) h1 h2
    rw [hs _ g1, Yb, g2, g3]
  have hc2 : ∀ i < 7, c i < 2 := fun i hi => by
    rw [← hc i hi]
    exact bitN_lt cc i
  have hbad : ∀ i1 < 7, badB s i1 = true ↔ ∃ i2 i3, i1 < i2 ∧ i2 < i3 ∧ i3 < 7 ∧
      bitN s (posW i2 (i2 - i1)) < bitN s (posW i3 (i3 - i1)) := by
    intro i1 hi1
    unfold badB
    constructor
    · intro h
      by_contra hne
      simp only [not_exists, not_and, not_lt] at hne
      have hA : allR (i1 + 1) (6 - i1) (fun i2 => allR (i2 + 1) (6 - i2) (fun i3 =>
          !(decide (bitN s (posW i2 (i2 - i1)) < bitN s (posW i3 (i3 - i1)))))) = true := by
        rw [allR_iff]
        intro i2 h12 h2
        rw [allR_iff]
        intro i3 h23 h3
        simp only [Bool.not_eq_true', decide_eq_false_iff_not, not_lt]
        exact hne i2 i3 (by omega) (by omega) (by omega)
      rw [hA] at h
      exact absurd h (by decide)
    · rintro ⟨i2, i3, h12, h23, h3, hlt⟩
      cases hA : allR (i1 + 1) (6 - i1) (fun i2 => allR (i2 + 1) (6 - i2) (fun i3 =>
          !(decide (bitN s (posW i2 (i2 - i1)) < bitN s (posW i3 (i3 - i1)))))) with
      | false => rfl
      | true =>
        exfalso
        rw [allR_iff] at hA
        have := hA i2 (by omega) (by omega)
        rw [allR_iff] at this
        have := this i3 (by omega) (by omega)
        simp only [Bool.not_eq_true', decide_eq_false_iff_not, not_lt] at this
        omega
  rw [locb_iff]
  unfold LocalN
  constructor
  · rintro ⟨h1, h2, h3⟩
    refine ⟨fun i hi => ?_, fun i1 hi1 hb => ?_⟩
    · unfold reqBit
      rw [hrow i hi, hc i hi]
      apply max_le
      · by_cases hn : 1 ≤ n
        · rw [if_pos hn]
          exact h1 i hi hn
        · rw [if_neg hn]
          exact Nat.zero_le _
      · by_cases h0 : i = 0
        · rw [if_pos h0]
          exact Nat.zero_le _
        · rw [if_neg h0, hrow (i - 1) (by omega)]
          by_cases hn : 1 ≤ n
          · rw [if_pos hn]
            have := h2 (i - 1) (by omega) hn
            rwa [show i - 1 + 1 = i by omega] at this
          · rw [if_neg hn]
            exact Nat.zero_le _
    · obtain ⟨i2, i3, h12, h23, h3', hlt⟩ := (hbad i1 hi1).mp hb
      rw [hpos i2 (i2 - i1) (by omega) (by omega) (by omega),
        hpos i3 (i3 - i1) (by omega) (by omega) (by omega)] at hlt
      rw [hc i1 hi1]
      by_cases hn : i3 - i1 ≤ n
      · rw [if_pos (by omega : i2 - i1 ≤ n), if_pos hn] at hlt
        have hneg := h3 i1 i2 i3 h12 h23 h3' hn
        have := hc2 i1 hi1
        have := hX i3 (n - (i3 - i1))
        by_contra hne
        exact hneg ⟨by omega, hlt⟩
      · rw [if_neg hn] at hlt
        omega
  · rintro ⟨h1, h2⟩
    refine ⟨fun i hi hn => ?_, fun i hi hn => ?_, fun i1 i2 i3 h12 h23 h3 hn => ?_⟩
    · have := h1 i hi
      unfold reqBit at this
      rw [hrow i hi, if_pos hn, hc i hi] at this
      exact le_trans (le_max_left _ _) this
    · have := h1 (i + 1) hi
      unfold reqBit at this
      rw [if_neg (by omega), show i + 1 - 1 = i by omega, hrow i (by omega), if_pos hn,
        hc (i + 1) hi] at this
      exact le_trans (le_max_right _ _) this
    · rintro ⟨ha, hb⟩
      have hbad' : badB s i1 = true := (hbad i1 (by omega)).mpr ⟨i2, i3, h12, h23, h3, by
        rw [hpos i2 (i2 - i1) (by omega) (by omega) (by omega),
          hpos i3 (i3 - i1) (by omega) (by omega) (by omega), if_pos (by omega), if_pos hn]
        exact hb⟩
      have := h2 i1 (by omega) hbad'
      rw [hc i1 (by omega)] at this
      omega

theorem code_snoc {X X' : ℕ → ℕ → ℕ} (hX2 : ∀ i j, X i j < 2) (n : ℕ) (c : ℕ → ℕ) (cc : ℕ)
    (hX : ∀ i j, j < n → X' i j = X i j) (hc : ∀ i, X' i n = c i)
    (hcc : ∀ i < 7, bitN cc i = c i) :
    code X' (n + 1) = tauc (code X n) cc := by
  unfold tauc
  rw [r22_eq]
  conv_lhs => unfold code
  congr 1
  apply List.map_congr_left
  intro p hp
  have hp' := List.mem_range.mp hp
  obtain ⟨r7, d1⟩ := row_facts p hp'
  unfold nb
  by_cases hd : distOf p = 1
  · rw [if_pos hd, Yb, if_pos (by omega), hd, show n + 1 - 1 = n by omega, hc, hcc _ r7]
  · rw [if_neg hd, bitN_code hX2 n (by omega : p - 1 < 22)]
    obtain ⟨g1, g2, g3⟩ := prev_facts p hp' hd
    unfold Yb
    rw [g2, g3]
    by_cases hn : distOf p ≤ n + 1
    · rw [if_pos hn, if_pos (by omega), hX _ _ (by omega), show n + 1 - distOf p = n - (distOf p - 1) by omega]
    · rw [if_neg hn, if_neg (by omega)]

/-! ### Enumerating the admissible columns -/

/-- The bits of `c` below `n` are 1 where `rq` has a bit 1 and 0 where `bd` has a bit 1. -/
def okP (rq bd n c : ℕ) : Prop := ∀ i < n, (bitN rq i = 1 → bitN c i = 1) ∧ (bitN bd i = 1 → bitN c i = 0)

instance (rq bd n c : ℕ) : Decidable (okP rq bd n c) := by
  unfold okP
  infer_instance

theorem bitN_zero (x : ℕ) : bitN x 0 = x % 2 := by
  unfold bitN
  rw [pow_zero, Nat.div_one]

theorem bitN_succ (x i : ℕ) : bitN x (i + 1) = bitN (x / 2) i := by
  unfold bitN
  rw [pow_succ', ← Nat.div_div_eq_div_mul]

theorem bitN_bit0 (c b : ℕ) (hb : b < 2) : bitN (2 * c + b) 0 = b := by
  rw [bitN_zero]
  omega

theorem bitN_bitS (c b i : ℕ) (hb : b < 2) : bitN (2 * c + b) (i + 1) = bitN c i := by
  rw [bitN_succ, show (2 * c + b) / 2 = c by omega]

theorem okP_succ (rq bd n c b : ℕ) (hb : b < 2) :
    okP rq bd (n + 1) (2 * c + b) ↔
      ((rq % 2 = 1 → b = 1) ∧ (bd % 2 = 1 → b = 0)) ∧ okP (rq / 2) (bd / 2) n c := by
  unfold okP
  constructor
  · intro h
    refine ⟨?_, fun i hi => ?_⟩
    · have := h 0 (by omega)
      rw [bitN_bit0 c b hb, bitN_zero rq, bitN_zero bd] at this
      exact this
    · have := h (i + 1) (by omega)
      rw [bitN_succ rq, bitN_succ bd, bitN_bitS c b i hb] at this
      exact this
  · rintro ⟨h0, h⟩ i hi
    cases i with
    | zero =>
      rw [bitN_bit0 c b hb, bitN_zero rq, bitN_zero bd]
      exact h0
    | succ i =>
      rw [bitN_succ rq, bitN_succ bd, bitN_bitS c b i hb]
      exact h i (by omega)

theorem sum_range_double (H : ℕ → ℕ) : ∀ m : ℕ,
    ∑ c ∈ range (2 * m), H c = ∑ c ∈ range m, (H (2 * c) + H (2 * c + 1))
  | 0 => by simp
  | m + 1 => by
    rw [show 2 * (m + 1) = 2 * m + 1 + 1 by ring, Finset.sum_range_succ, Finset.sum_range_succ,
      sum_range_double H m, Finset.sum_range_succ]
    ring

theorem enum_sum (F : ℕ → ℕ) : ∀ n rq bd : ℕ,
    ∑ c ∈ range (2 ^ n), (if okP rq bd n c then F c else 0) = ((enum rq bd n).map F).sum
  | 0, rq, bd => by
    have h : okP rq bd 0 0 := fun i hi => absurd hi (by omega)
    simp [enum, h]
  | n + 1, rq, bd => by
    rw [pow_succ', sum_range_double]
    have e0 : ∀ c, okP rq bd (n + 1) (2 * c) ↔
        ((rq % 2 = 1 → (0 : ℕ) = 1) ∧ (bd % 2 = 1 → (0 : ℕ) = 0)) ∧ okP (rq / 2) (bd / 2) n c :=
      fun c => by simpa using okP_succ rq bd n c 0 (by norm_num)
    have e1 : ∀ c, okP rq bd (n + 1) (2 * c + 1) ↔
        ((rq % 2 = 1 → (1 : ℕ) = 1) ∧ (bd % 2 = 1 → (1 : ℕ) = 0)) ∧ okP (rq / 2) (bd / 2) n c :=
      fun c => okP_succ rq bd n c 1 (by norm_num)
    rw [Finset.sum_add_distrib]
    unfold enum
    rw [List.map_append, List.sum_append]
    congr 1
    · by_cases hr : rq % 2 = 1
      · rw [if_pos hr]
        refine Finset.sum_eq_zero fun c _ => if_neg ?_
        rw [e0]
        intro h
        exact absurd (h.1.1 hr) (by norm_num)
      · rw [if_neg hr, List.map_map,
          show F ∘ (fun c => 2 * c) = (fun c => F (2 * c)) from rfl,
          ← enum_sum (fun c => F (2 * c)) n (rq / 2) (bd / 2)]
        refine Finset.sum_congr rfl fun c _ => ?_
        simp only [e0, hr, false_imp_iff, true_and, imp_true_iff]
    · by_cases hd : bd % 2 = 1
      · rw [if_pos hd]
        refine Finset.sum_eq_zero fun c _ => if_neg ?_
        rw [e1]
        intro h
        exact absurd (h.1.2 hd) (by norm_num)
      · rw [if_neg hd, List.map_map,
          show F ∘ (fun c => 2 * c + 1) = (fun c => F (2 * c + 1)) from rfl,
          ← enum_sum (fun c => F (2 * c + 1)) n (rq / 2) (bd / 2)]
        refine Finset.sum_congr rfl fun c _ => ?_
        simp only [e1, hd, false_imp_iff, true_and, imp_true_iff]

theorem ok_iff (s cc : ℕ) : locb s cc = true ↔ okP (reqv s) (badv s) 7 cc := by
  rw [locb_iff]
  have hr := bitN_enc7 (reqBit s) (reqBit_lt s)
  have hb := bitN_enc7 (fun i => if badB s i = true then 1 else 0)
    (fun i => by split_ifs <;> norm_num)
  unfold okP reqv badv
  constructor
  · rintro ⟨h1, h2⟩ i hi
    rw [hr, hb, if_pos hi, if_pos hi]
    refine ⟨fun h => ?_, fun h => ?_⟩
    · have := h1 i hi
      have := bitN_lt cc i
      omega
    · split_ifs at h with hbad
      · exact h2 i hi hbad
  · intro h
    refine ⟨fun i hi => ?_, fun i hi hbad => ?_⟩
    · have hh := h i hi
      rw [hr, if_pos hi] at hh
      have g1 := reqBit_lt s i
      have g2 := bitN_lt cc i
      by_cases hq : reqBit s i = 1
      · have := hh.1 hq
        omega
      · omega
    · have := (h i hi).2
      rw [hb, if_pos hi, if_pos hbad] at this
      exact this rfl

/-! ### The automaton on arrays -/

/-- The state after `n` columns: the window code if `GoodN` holds, and 4194304 (dead) if not. -/
noncomputable def st (X : ℕ → ℕ → ℕ) (n : ℕ) : ℕ := by
  classical
  exact if GoodN X n then code X n else 4194304

/-- The transition on the column with code `cc`. -/
def tau (s cc : ℕ) : ℕ :=
  if s = 4194304 then 4194304 else if locb s cc = true then tauc s cc else 4194304

theorem st_snoc {X X' : ℕ → ℕ → ℕ} (hX2 : ∀ i j, X i j < 2) (n : ℕ) (c : ℕ → ℕ) (cc : ℕ)
    (hX : ∀ i j, j < n → X' i j = X i j) (hc : ∀ i, X' i n = c i)
    (hcc : ∀ i < 7, bitN cc i = c i) :
    st X' (n + 1) = tau (st X n) cc := by
  classical
  unfold st tau
  by_cases hG : GoodN X n
  · rw [if_pos hG, if_neg (ne_of_lt (code_lt hX2 n))]
    have hL := local_iff hX2 n c (code X n) cc (fun p hp => bitN_code hX2 n hp) hcc
    by_cases hl : LocalN X n c
    · rw [if_pos ((goodN_snoc X X' n c hX hc).mpr ⟨hG, hl⟩), if_pos (hL.mp hl),
        code_snoc hX2 n c cc hX hc hcc]
    · rw [if_neg (fun h => hl ((goodN_snoc X X' n c hX hc).mp h).2),
        if_neg (fun h => hl (hL.mpr h))]
  · rw [if_neg hG, if_neg (fun h => hG ((goodN_snoc X X' n c hX hc).mp h).1), if_pos rfl]

theorem goodN_zero (X : ℕ → ℕ → ℕ) : GoodN X 0 :=
  ⟨fun _ _ _ h => absurd h (by omega), fun _ _ _ h => absurd h (by omega),
    fun _ _ _ _ _ _ _ _ _ h => absurd h (by omega)⟩

theorem st_zero (X : ℕ → ℕ → ℕ) : st X 0 = 0 := by
  classical
  unfold st
  rw [if_pos (goodN_zero X), code_zero]

/-- The array `x` with the column `c` appended. -/
def snocA {m : ℕ} (x : Fin 7 → Fin m → Fin 2) (c : Fin 7 → Fin 2) :
    Fin 7 → Fin (m + 1) → Fin 2 :=
  fun i => Fin.snoc (α := fun _ => Fin 2) (x i) (c i)

/-- The column `c` as a function on ℕ. -/
def cN (c : Fin 7 → Fin 2) (i : ℕ) : ℕ := if h : i < 7 then (c ⟨i, h⟩).val else 0

theorem ext_snoc_lt {m : ℕ} (x : Fin 7 → Fin m → Fin 2) (c : Fin 7 → Fin 2) (i j : ℕ)
    (hj : j < m) : ext (snocA x c) i j = ext x i j := by
  unfold ext snocA
  by_cases hi : i < 7
  · rw [dif_pos ⟨hi, by omega⟩, dif_pos ⟨hi, hj⟩]
    have : (⟨j, by omega⟩ : Fin (m + 1)) = Fin.castSucc ⟨j, hj⟩ := rfl
    rw [this, Fin.snoc_castSucc]
  · rw [dif_neg (fun h => hi h.1), dif_neg (fun h => hi h.1)]

theorem ext_snoc_last {m : ℕ} (x : Fin 7 → Fin m → Fin 2) (c : Fin 7 → Fin 2) (i : ℕ) :
    ext (snocA x c) i m = cN c i := by
  unfold ext snocA cN
  by_cases hi : i < 7
  · rw [dif_pos ⟨hi, by omega⟩, dif_pos hi]
    have : (⟨m, by omega⟩ : Fin (m + 1)) = Fin.last m := rfl
    rw [this, Fin.snoc_last]
  · rw [dif_neg (fun h => hi h.1), dif_neg hi]

theorem bitN_ccode (c : Fin 7 → Fin 2) (i : ℕ) (hi : i < 7) :
    bitN (finFunctionFinEquiv c).val i = cN c i := by
  have h := finFunctionFinEquiv_symm_apply_val (finFunctionFinEquiv c) ⟨i, hi⟩
  rw [Equiv.symm_apply_apply] at h
  unfold bitN cN
  rw [dif_pos hi]
  exact h.symm

/-- Splitting off the last column. -/
def splitE (m : ℕ) :
    (Fin 7 → Fin (m + 1) → Fin 2) ≃ (Fin 7 → Fin m → Fin 2) × (Fin 7 → Fin 2) where
  toFun x' := (fun i => Fin.init (x' i), fun i => x' i (Fin.last m))
  invFun p := snocA p.1 p.2
  left_inv x' := by
    funext i
    exact Fin.snoc_init_self (x' i)
  right_inv p := by
    obtain ⟨x, c⟩ := p
    simp only [snocA, Fin.init_snoc, Fin.snoc_last]

theorem sum_snocA (m : ℕ) (F : (Fin 7 → Fin (m + 1) → Fin 2) → ℕ) :
    ∑ x', F x' = ∑ x : Fin 7 → Fin m → Fin 2, ∑ c : Fin 7 → Fin 2, F (snocA x c) := by
  rw [← Fintype.sum_prod_type' (fun x c => F (snocA x c))]
  exact Fintype.sum_equiv (splitE m) _ _ (fun x' => by
    rw [show snocA ((splitE m) x').1 ((splitE m) x').2 = (splitE m).symm ((splitE m) x') from rfl,
      Equiv.symm_apply_apply])

/-! ### Counting -/

/-- The sum of `g` over the states of all arrays with `m` columns. -/
noncomputable def Ssum (m : ℕ) (g : ℕ → ℕ) : ℕ := ∑ x : Fin 7 → Fin m → Fin 2, g (st (ext x) m)

/-- The transfer operator on functions of the state. -/
def Top (g : ℕ → ℕ) (s : ℕ) : ℕ := ∑ cc ∈ range 128, g (tau s cc)

theorem Ssum_succ (m : ℕ) (g : ℕ → ℕ) : Ssum (m + 1) g = Ssum m (Top g) := by
  unfold Ssum Top
  rw [sum_snocA]
  refine Finset.sum_congr rfl fun x _ => ?_
  have h1 : ∀ c, st (ext (snocA x c)) (m + 1) = tau (st (ext x) m) (finFunctionFinEquiv c).val :=
    fun c => st_snoc (ext_lt x) m (cN c) _ (ext_snoc_lt x c) (ext_snoc_last x c) (bitN_ccode c)
  simp only [h1]
  rw [Fintype.sum_equiv finFunctionFinEquiv _ (fun k : Fin (2 ^ 7) => g (tau (st (ext x) m) k.val))
    (fun _ => rfl), Fin.sum_univ_eq_sum_range (fun k => g (tau (st (ext x) m) k))]
  rfl

theorem Ssum_zero (g : ℕ → ℕ) : Ssum 0 g = g 0 := by
  unfold Ssum
  rw [Fintype.sum_unique, st_zero]

theorem Ssum_iter : ∀ (m : ℕ) (g : ℕ → ℕ), Ssum m g = (Top^[m] g) 0
  | 0, g => Ssum_zero g
  | m + 1, g => by
    rw [Ssum_succ, Ssum_iter m (Top g), Function.iterate_succ_apply]

/-- The indicator of the live states. -/
def live (s : ℕ) : ℕ := if s = 4194304 then 0 else 1

theorem a_eq (m : ℕ) : a m = (Top^[m] live) 0 := by
  classical
  rw [← Ssum_iter]
  unfold a Ssum
  rw [Finset.card_filter]
  refine Finset.sum_congr rfl fun x _ => ?_
  unfold live st
  by_cases h : GoodN (ext x) m
  · rw [if_pos ((good_iff x).mpr h), if_pos h, if_neg (ne_of_lt (code_lt (ext_lt x) m))]
  · rw [if_neg (fun h' => h ((good_iff x).mp h')), if_neg h, if_pos rfl]

/-! ### Kernel checks on the reachable codes -/

/-- The reachable code with index `k`. -/
def Lc (k : ℕ) : ℕ := (LT.getD (k / 64) []).getD (k % 64) 0

/-- The successor indices of the reachable code with index `k`. -/
def SI (k : ℕ) : List ℕ := (SIT.getD (k / 64) []).getD (k % 64) []

theorem chkA0 : ∀ k < 376, succC (Lc k) = (SI k).map Lc := by
  decide +kernel

theorem chkA1 : ∀ k < 752, 376 ≤ k → succC (Lc k) = (SI k).map Lc := by
  decide +kernel

theorem chkA2 : ∀ k < 1128, 752 ≤ k → succC (Lc k) = (SI k).map Lc := by
  decide +kernel

theorem chkA3 : ∀ k < 1504, 1128 ≤ k → succC (Lc k) = (SI k).map Lc := by
  decide +kernel

theorem chkA (k : ℕ) (hk : k < 1504) : succC (Lc k) = (SI k).map Lc := by
  rcases Nat.lt_or_ge k 376 with h0 | h0
  · exact chkA0 k h0
  rcases Nat.lt_or_ge k 752 with h1 | h1
  · exact chkA1 k h1 h0
  rcases Nat.lt_or_ge k 1128 with h2 | h2
  · exact chkA2 k h2 h1
  · exact chkA3 k hk h2

/-- The vector with index `i` of the table, at the code with index `k`. -/
def wv (i k : ℕ) : ℕ := ((WT.getD i []).getD (k / 64) []).getD (k % 64) 0

/-- One transfer step applied to the table vector with index `i`, at the code with index `k`. -/
def MT (i k : ℕ) : ℕ := ((SI k).map (fun k' => wv i k')).sum

theorem chkB0 : ∀ k < 1504, (∀ k' ∈ SI k, k' < 1504) ∧ Lc k < 4194304 ∧ wv 0 k = 1 := by
  decide +kernel

theorem chkB (k : ℕ) (hk : k < 1504) : (∀ k' ∈ SI k, k' < 1504) ∧ Lc k < 4194304 :=
  ⟨(chkB0 k hk).1, (chkB0 k hk).2.1⟩

theorem chkW0 (k : ℕ) (hk : k < 1504) : wv 0 k = 1 := (chkB0 k hk).2.2

theorem chkV0 : ∀ k < 1504, MT 0 k = wv 1 k := by
  decide +kernel

theorem chkV1 : ∀ k < 1504, MT 1 k = wv 2 k := by
  decide +kernel

theorem chkV2 : ∀ k < 1504, MT 2 k = wv 3 k := by
  decide +kernel

theorem chkV3 : ∀ k < 1504, MT 3 k = wv 4 k := by
  decide +kernel

theorem chkV4 : ∀ k < 1504, MT 4 k = wv 5 k := by
  decide +kernel

theorem chkV5 : ∀ k < 1504, MT 5 k = wv 6 k := by
  decide +kernel

theorem chkV (i : ℕ) (hi : i < 6) (k : ℕ) (hk : k < 1504) : MT i k = wv (i + 1) k := by
  interval_cases i
  · exact chkV0 k hk
  · exact chkV1 k hk
  · exact chkV2 k hk
  · exact chkV3 k hk
  · exact chkV4 k hk
  · exact chkV5 k hk

theorem chkK0 : ∀ k < 1504, MT 6 k = wv 6 k + wv 7 k := by
  decide +kernel

theorem chkK1 : ∀ k < 1504, MT 7 k = wv 7 k + wv 8 k := by
  decide +kernel

theorem chkK2 : ∀ k < 1504, MT 8 k = wv 8 k + wv 9 k := by
  decide +kernel

theorem chkK3 : ∀ k < 1504, MT 9 k = wv 9 k + wv 10 k := by
  decide +kernel

theorem chkK4 : ∀ k < 1504, MT 10 k = wv 10 k + wv 11 k := by
  decide +kernel

theorem chkK5 : ∀ k < 1504, MT 11 k = wv 11 k + wv 12 k := by
  decide +kernel

theorem chkK6 : ∀ k < 1504, MT 12 k = wv 12 k + wv 13 k := by
  decide +kernel

theorem chkK7 : ∀ k < 1504, MT 13 k = wv 13 k + wv 14 k := by
  decide +kernel

theorem chkK (j : ℕ) (hj : j < 8) (k : ℕ) (hk : k < 1504) :
    MT (j + 6) k = wv (j + 6) k + wv (j + 7) k := by
  interval_cases j
  · exact chkK0 k hk
  · exact chkK1 k hk
  · exact chkK2 k hk
  · exact chkK3 k hk
  · exact chkK4 k hk
  · exact chkK5 k hk
  · exact chkK6 k hk
  · exact chkK7 k hk

theorem chk_vals : Lc 0 = 0 ∧ wv 0 0 = 1 ∧ wv 1 0 = 128 ∧ wv 2 0 = 987 ∧ wv 3 0 = 2419 ∧
    wv 4 0 = 4160 ∧ wv 5 0 = 6321 ∧ wv 6 0 = 9125 ∧ wv 7 0 = 3731 ∧ wv 8 0 = 1288 ∧
    wv 9 0 = 441 ∧ wv 10 0 = 145 ∧ wv 11 0 = 42 ∧ wv 12 0 = 9 ∧ wv 13 0 = 1 := by
  decide +kernel

theorem Top_eq (g : ℕ → ℕ) (hg : g 4194304 = 0) (s : ℕ) (hs : s ≠ 4194304) :
    Top g s = ((succC s).map g).sum := by
  have h1 : ∀ cc ∈ range (2 ^ 7), g (tau s cc) =
      if okP (reqv s) (badv s) 7 cc then g (tauc s cc) else 0 := by
    intro cc _
    unfold tau
    rw [if_neg hs]
    by_cases h : locb s cc = true
    · rw [if_pos h, if_pos ((ok_iff s cc).mp h)]
    · rw [if_neg h, if_neg (fun h' => h ((ok_iff s cc).mpr h')), hg]
  unfold Top succC
  rw [show (128 : ℕ) = 2 ^ 7 from rfl, Finset.sum_congr rfl h1, enum_sum, List.map_map]
  rfl

/-- The number of continuations of length `m` from each state. -/
def G (m : ℕ) : ℕ → ℕ := Top^[m] live

theorem G_dead : ∀ m, G m 4194304 = 0
  | 0 => rfl
  | m + 1 => by
    unfold G
    rw [Function.iterate_succ_apply']
    unfold Top
    refine Finset.sum_eq_zero fun cc _ => ?_
    unfold tau
    rw [if_pos rfl]
    exact G_dead m

theorem G_step (m k : ℕ) (hk : k < 1504) :
    G (m + 1) (Lc k) = ((SI k).map (fun k' => G m (Lc k'))).sum := by
  have h := Top_eq (G m) (G_dead m) (Lc k) (ne_of_lt (chkB k hk).2)
  rw [chkA k hk, List.map_map] at h
  unfold G at h ⊢
  rw [Function.iterate_succ_apply']
  exact h

theorem G_low : ∀ i ≤ 6, ∀ k < 1504, G i (Lc k) = wv i k
  | 0, _, k, hk => by
    rw [chkW0 k hk]
    show live (Lc k) = 1
    unfold live
    rw [if_neg (ne_of_lt (chkB k hk).2)]
  | i + 1, hi, k, hk => by
    rw [G_step i k hk, ← chkV i (by omega) k hk]
    unfold MT
    congr 1
    apply List.map_congr_left
    intro k' hk'
    exact G_low i (by omega) k' ((chkB k hk).1 k' hk')

theorem list_sum_lin (S : Finset ℕ) (c : ℕ → ℕ) (F : ℕ → ℕ → ℕ) : ∀ l : List ℕ,
    (l.map (fun k' => ∑ j ∈ S, c j * F j k')).sum = ∑ j ∈ S, c j * (l.map (F j)).sum
  | [] => by simp
  | a :: l => by
    simp only [List.map_cons, List.sum_cons, list_sum_lin S c F l, mul_add, Finset.sum_add_distrib]

theorem G_high : ∀ m, ∀ k < 1504, G (m + 6) (Lc k) = ∑ j ∈ range 8, m.choose j * wv (j + 6) k
  | 0, k, hk => by
    show G 6 (Lc k) = _
    rw [G_low 6 le_rfl k hk]
    simp [Finset.sum_range_succ]
  | m + 1, k, hk => by
    rw [show m + 1 + 6 = (m + 6) + 1 by omega, G_step (m + 6) k hk]
    rw [List.map_congr_left (fun k' hk' => G_high m k' ((chkB k hk).1 k' hk')),
      list_sum_lin]
    have e : ∀ j ∈ range 8, m.choose j * ((SI k).map (fun k' => wv (j + 6) k')).sum =
        m.choose j * (wv (j + 6) k + wv (j + 7) k) := by
      intro j hj
      rw [← chkK j (Finset.mem_range.mp hj) k hk]
      rfl
    rw [Finset.sum_congr rfl e]
    have h14 : wv 14 k = 0 := by
      unfold wv
      rfl
    have p1 : (m + 1).choose 1 = m.choose 0 + m.choose 1 := Nat.choose_succ_succ m 0
    have p2 : (m + 1).choose 2 = m.choose 1 + m.choose 2 := Nat.choose_succ_succ m 1
    have p3 : (m + 1).choose 3 = m.choose 2 + m.choose 3 := Nat.choose_succ_succ m 2
    have p4 : (m + 1).choose 4 = m.choose 3 + m.choose 4 := Nat.choose_succ_succ m 3
    have p5 : (m + 1).choose 5 = m.choose 4 + m.choose 5 := Nat.choose_succ_succ m 4
    have p6 : (m + 1).choose 6 = m.choose 5 + m.choose 6 := Nat.choose_succ_succ m 5
    have p7 : (m + 1).choose 7 = m.choose 6 + m.choose 7 := Nat.choose_succ_succ m 6
    simp only [Finset.sum_range_succ, Finset.sum_range_zero, p1, p2, p3, p4, p5, p6, p7,
      Nat.choose_zero_right, h14]
    ring

theorem a_G (m : ℕ) : a m = G m (Lc 0) := by
  rw [a_eq, chk_vals.1]
  rfl

theorem a_low : a 1 = 128 ∧ a 2 = 987 ∧ a 3 = 2419 ∧ a 4 = 4160 ∧ a 5 = 6321 := by
  obtain ⟨_, _, v1, v2, v3, v4, v5, _⟩ := chk_vals
  have h : ∀ i ≤ 6, a i = wv i 0 := fun i hi => by
    rw [a_G]
    exact G_low i hi 0 (by norm_num)
  exact ⟨by rw [h 1 (by norm_num), v1], by rw [h 2 (by norm_num), v2],
    by rw [h 3 (by norm_num), v3], by rw [h 4 (by norm_num), v4], by rw [h 5 (by norm_num), v5]⟩

theorem a_high (m : ℕ) : a (m + 6) = 9125 + 3731 * m + 1288 * m.choose 2 + 441 * m.choose 3 +
    145 * m.choose 4 + 42 * m.choose 5 + 9 * m.choose 6 + m.choose 7 := by
  obtain ⟨_, _, _, _, _, _, _, k0, k1, k2, k3, k4, k5, k6, k7⟩ := chk_vals
  rw [a_G, G_high m 0 (by norm_num)]
  simp only [Finset.sum_range_succ, Finset.sum_range_zero, Nat.choose_zero_right,
    Nat.choose_one_right, Nat.reduceAdd, k0, k1, k2, k3, k4, k5, k6, k7]
  ring

/-! ### The closed form, the recurrence and the generating function -/

theorem choose2 (m : ℕ) : (m.choose 2 : ℚ) = m * (m - 1) / 2 := by
  induction m with
  | zero => simp
  | succ m ih =>
    rw [Nat.choose_succ_succ', Nat.cast_add, ih, Nat.choose_one_right]
    push_cast
    ring

theorem choose3 (m : ℕ) : (m.choose 3 : ℚ) = m * (m - 1) * (m - 2) / 6 := by
  induction m with
  | zero => simp
  | succ m ih =>
    rw [Nat.choose_succ_succ', Nat.cast_add, ih, choose2]
    push_cast
    ring

theorem choose4 (m : ℕ) : (m.choose 4 : ℚ) = m * (m - 1) * (m - 2) * (m - 3) / 24 := by
  induction m with
  | zero => simp
  | succ m ih =>
    rw [Nat.choose_succ_succ', Nat.cast_add, ih, choose3]
    push_cast
    ring

theorem choose5 (m : ℕ) :
    (m.choose 5 : ℚ) = m * (m - 1) * (m - 2) * (m - 3) * (m - 4) / 120 := by
  induction m with
  | zero => simp
  | succ m ih =>
    rw [Nat.choose_succ_succ', Nat.cast_add, ih, choose4]
    push_cast
    ring

theorem choose6 (m : ℕ) :
    (m.choose 6 : ℚ) = m * (m - 1) * (m - 2) * (m - 3) * (m - 4) * (m - 5) / 720 := by
  induction m with
  | zero => simp
  | succ m ih =>
    rw [Nat.choose_succ_succ', Nat.cast_add, ih, choose5]
    push_cast
    ring

theorem choose7 (m : ℕ) : (m.choose 7 : ℚ) =
    m * (m - 1) * (m - 2) * (m - 3) * (m - 4) * (m - 5) * (m - 6) / 5040 := by
  induction m with
  | zero => simp
  | succ m ih =>
    rw [Nat.choose_succ_succ', Nat.cast_add, ih, choose6]
    push_cast
    ring

/-- The empirical closed form, for every `n > 5`. -/
theorem closedQ (n : ℕ) (hn : 5 < n) : (a n : ℚ) =
    1 / 5040 * n ^ 7 + 17 / 360 * n ^ 5 + 13 / 24 * n ^ 4 + 5767 / 720 * n ^ 3 +
      1919 / 24 * n ^ 2 + 37901 / 70 * n + 143 := by
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 6 := ⟨n - 6, by omega⟩
  rw [a_high]
  push_cast
  rw [choose2, choose3, choose4, choose5, choose6, choose7]
  ring

theorem recurrence (n : ℕ) (hn : 13 < n) :
    (a n : ℤ) = 8 * a (n - 1) - 28 * a (n - 2) + 56 * a (n - 3) - 70 * a (n - 4) +
      56 * a (n - 5) - 28 * a (n - 6) + 8 * a (n - 7) - a (n - 8) := by
  have h : ((a n : ℤ) : ℚ) = ((8 * a (n - 1) - 28 * a (n - 2) + 56 * a (n - 3) -
      70 * a (n - 4) + 56 * a (n - 5) - 28 * a (n - 6) + 8 * a (n - 7) - a (n - 8) : ℤ) : ℚ) := by
    push_cast
    rw [closedQ n (by omega), closedQ (n - 1) (by omega), closedQ (n - 2) (by omega),
      closedQ (n - 3) (by omega), closedQ (n - 4) (by omega), closedQ (n - 5) (by omega),
      closedQ (n - 6) (by omega), closedQ (n - 7) (by omega), closedQ (n - 8) (by omega)]
    push_cast [show 1 ≤ n by omega, show 2 ≤ n by omega, show 3 ≤ n by omega,
      show 4 ≤ n by omega, show 5 ≤ n by omega, show 6 ≤ n by omega, show 7 ≤ n by omega,
      show 8 ≤ n by omega]
    ring
  exact_mod_cast h

set_option maxRecDepth 20000 in
open PowerSeries in
theorem gen_fun :
    PowerSeries.mk (fun n => if n = 0 then (0 : ℚ) else (a n : ℚ)) * (1 - X) ^ 8 =
      X * (128 - 37 * X - 1893 * X ^ 2 + 5276 * X ^ 3 - 5539 * X ^ 4 + 1495 * X ^ 5 +
        1526 * X ^ 6 - 1101 * X ^ 7 + 65 * X ^ 8 + 155 * X ^ 9 - 160 * X ^ 10 +
        117 * X ^ 11 - 31 * X ^ 12) := by
  set F : ℕ → ℚ := fun n => if n = 0 then (0 : ℚ) else (a n : ℚ) with hF
  have key : PowerSeries.mk F * (1 - X) ^ 8 =
      C 1 * (PowerSeries.mk F * X ^ 0) - C 8 * (PowerSeries.mk F * X ^ 1) +
        C 28 * (PowerSeries.mk F * X ^ 2) - C 56 * (PowerSeries.mk F * X ^ 3) +
        C 70 * (PowerSeries.mk F * X ^ 4) - C 56 * (PowerSeries.mk F * X ^ 5) +
