import FormalConjectures.Wikipedia.Transcendental
import Mathlib

-- Reduction Transcendental.exp_mul_pi_transcendental.R1: `e * π` is transcendental
-- Credit: @MBimrose
-- Each H becomes its own step once this file is accepted. Proving all of them closes the problem.

/-!
# `e · π` is transcendental, from Schanuel's conjecture for `n = 2`

Schanuel's conjecture: if `z₁, …, zₙ` are complex numbers linearly independent over `ℚ`, then
`ℚ(z₁, …, zₙ, exp z₁, …, exp zₙ)` has transcendence degree at least `n` over `ℚ`.

* `H1`: Schanuel for `n = 2`, in the catalogue's wording. This is the deep open input.
* `H2`: the transcendence-degree bound used to turn an algebraic value into a small field: a field
  generated by a set `S`, all of whose elements are algebraic over the field generated by `m`
  elements of `S`, has transcendence degree at most `m`.

The argument (Schanuel ⟹ `e` and `π` are algebraically independent ⟹ `e · π` is transcendental):

1. Apply `H1` to `(1, π i)`: the field is `ℚ(1, π i, e, exp (π i)) = ℚ(π i, e)`, and `1, π i` are
   `ℚ`-linearly independent because `π i` is not real. So its transcendence degree is at least `2`.
2. If instead `e · π = a` were algebraic over `ℚ`, then `π = a / e`, so `π` lies in the algebraic
   extension `ℚ(e, a)` of `ℚ(e)`; then every generator `1`, `π i`, `e`, `-1` of that field is
   algebraic over `ℚ(e)` alone, and `H2` bounds the transcendence degree by `1` — a contradiction.

No transcendence or irrationality result about `e` or `π` is used: only Schanuel and field theory.
-/

namespace OMA.R_Transcendental_exp_mul_pi_transcendental_R1

open IntermediateField

/-- Schanuel's conjecture for `n = 2`. -/
def H1 : Prop :=
  ∀ z : Fin 2 → ℂ, LinearIndependent ℚ z →
    ((2 : ℕ) : Cardinal) ≤
      Algebra.trdeg ℚ (adjoin ℚ (Set.range z ∪ Set.range (Complex.exp ∘ z)))

/-- A field generated by a set `S`, all of whose elements are algebraic over the field generated
by `m` elements of `S`, has transcendence degree at most `m`. -/
def H2 : Prop :=
  ∀ (S : Set ℂ) (m : ℕ) (t : Fin m → ℂ), Set.range t ⊆ S →
    (∀ s ∈ S, IsAlgebraic (adjoin ℚ (Set.range t)) s) →
      Algebra.trdeg ℚ (adjoin ℚ S) ≤ (m : Cardinal)

/-- An element of an intermediate field is algebraic over it. -/
lemma alg_mem (F : IntermediateField ℚ ℂ) {x : ℂ} (hx : x ∈ F) : IsAlgebraic F x :=
  isAlgebraic_algebraMap (⟨x, hx⟩ : F)

/-- `I` is algebraic over every intermediate field. -/
lemma alg_I (F : IntermediateField ℚ ℂ) : IsAlgebraic F Complex.I := by
  refine IsAlgebraic.of_pow (n := 2) (by norm_num) ?_
  rw [Complex.I_sq]
  exact alg_mem F (neg_mem (one_mem F))

lemma exp_one_eq : Complex.exp 1 = ((Real.exp 1 : ℝ) : ℂ) := by
  rw [Complex.ofReal_exp]
  simp

/-- Algebraicity of `x : ℝ` over `ℚ` and of its image in `ℂ` agree. -/
lemma isAlgebraic_ofReal_iff (x : ℝ) : IsAlgebraic ℚ ((x : ℂ)) ↔ IsAlgebraic ℚ x :=
  isAlgebraic_algebraMap_iff Complex.ofReal_injective

/-- Real and imaginary parts of `x + y i = 0`. -/
lemma re_im_of (x y : ℝ) (h : (x : ℂ) + (y : ℂ) * Complex.I = 0) : x = 0 ∧ y = 0 := by
  have h' := Complex.ext_iff.mp h
  simpa using h'

/-- `1` and `π i` are linearly independent over `ℚ`. -/
lemma lin2 : LinearIndependent ℚ ![(1 : ℂ), ((Real.pi : ℝ) : ℂ) * Complex.I] := by
  rw [Fintype.linearIndependent_iff]
  intro g hg
  have hg' : g 0 • (1 : ℂ) + g 1 • (((Real.pi : ℝ) : ℂ) * Complex.I) = 0 := by
    rw [Fin.sum_univ_two] at hg
    exact hg
  have key : (((g 0 : ℝ) : ℝ) : ℂ) + (((g 1 : ℝ) * Real.pi : ℝ) : ℂ) * Complex.I = 0 := by
    rw [← hg']
    simp only [Rat.smul_def]
    push_cast
    ring
  obtain ⟨hx, hy⟩ := re_im_of _ _ key
  have h1 : g 1 = 0 := by
    rcases mul_eq_zero.mp hy with h | h
    · exact_mod_cast h
    · exact absurd h Real.pi_ne_zero
  have h0 : g 0 = 0 := by exact_mod_cast hx
  intro i
  fin_cases i
  · exact h0
  · exact h1

theorem main : H1 → H2 → type_of% @Transcendental.exp_mul_pi_transcendental := by
  intro h1 h2 hG
  -- `e * π` algebraic in `ℝ` transfers to `ℂ`
  have hGc : IsAlgebraic ℚ (((Real.exp 1 * Real.pi : ℝ)) : ℂ) :=
    (isAlgebraic_ofReal_iff _).mpr hG
  -- Schanuel for `n = 2` on the pair `(1, π i)`
  have lower := h1 ![(1 : ℂ), ((Real.pi : ℝ) : ℂ) * Complex.I] lin2
  -- the field generated by `e` alone
  have he_mem : ((Real.exp 1 : ℝ) : ℂ) ∈ adjoin ℚ (Set.range ![((Real.exp 1 : ℝ) : ℂ)]) :=
    subset_adjoin ℚ _ ⟨0, rfl⟩
  have hae : IsAlgebraic (adjoin ℚ (Set.range ![((Real.exp 1 : ℝ) : ℂ)]))
      (((Real.exp 1 * Real.pi : ℝ)) : ℂ) :=
    IsAlgebraic.tower_top (L := adjoin ℚ (Set.range ![((Real.exp 1 : ℝ) : ℂ)])) hGc
  -- `π = (e * π) / e`
  have hpi : ((Real.pi : ℝ) : ℂ) = (((Real.exp 1 * Real.pi : ℝ)) : ℂ) *
      (((Real.exp 1 : ℝ) : ℂ))⁻¹ := by
    have hne : ((Real.exp 1 : ℝ) : ℂ) ≠ 0 := by
      rw [Ne, ← Complex.ofReal_zero, Complex.ofReal_inj]
      exact (Real.exp_pos 1).ne'
    push_cast
    field_simp
  have hπi : IsAlgebraic (adjoin ℚ (Set.range ![((Real.exp 1 : ℝ) : ℂ)]))
      (((Real.pi : ℝ) : ℂ) * Complex.I) := by
    rw [hpi]
    exact (hae.mul (alg_mem _ (inv_mem he_mem))).mul (alg_I _)
  -- every generator is algebraic over `ℚ(e)`, so the transcendence degree is at most `1`
  have upper := h2 (Set.range ![(1 : ℂ), ((Real.pi : ℝ) : ℂ) * Complex.I] ∪
      Set.range (Complex.exp ∘ ![(1 : ℂ), ((Real.pi : ℝ) : ℂ) * Complex.I]))
    (1 : ℕ) ![((Real.exp 1 : ℝ) : ℂ)]
    (by
      rintro _ ⟨i, rfl⟩
      fin_cases i
      exact Or.inr ⟨0, exp_one_eq⟩)
    (by
      rintro s (⟨i, rfl⟩ | ⟨i, rfl⟩)
      · fin_cases i
        · exact alg_mem _ (one_mem _)
        · exact hπi
      · fin_cases i
        · show IsAlgebraic _ (Complex.exp 1)
          rw [exp_one_eq]
          exact alg_mem _ he_mem
        · show IsAlgebraic _ (Complex.exp (((Real.pi : ℝ) : ℂ) * Complex.I))
          rw [Complex.exp_pi_mul_I]
          exact alg_mem _ (neg_mem (one_mem _)))
  have h21 : (2 : ℕ) ≤ 1 := by exact_mod_cast lower.trans upper
  omega

end OMA.R_Transcendental_exp_mul_pi_transcendental_R1
