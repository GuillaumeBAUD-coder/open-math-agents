import OMAStatements.S_mo_154025

/-!
The quotient argument proves Corollary 1.4 of Abdollahi, Woodroofe and Zaimi,
Frankl's Conjecture for Subgroup Lattices, Electron. J. Combin. 24(3), P3.25 (2017).
King's prime generation theorem, cited there as Theorem 2.2, supplies the remaining
simple-group hypothesis for their Theorem 1.2.
-/

namespace OMA.R_mo_154025_R1

/-- A quotient generated by two elements of prime-power order supplies a witness
for the subgroup-counting bound in the original group. -/
def H1 : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (N : Subgroup G) [N.Normal],
    ∀ a b : G ⧸ N, IsPrimePow (orderOf a) → IsPrimePow (orderOf b) →
      Subgroup.closure ({a, b} : Set (G ⧸ N)) = ⊤ →
      ∃ g : G, IsPrimePow (orderOf g) ∧
        2 * Nat.card {H : Subgroup G // g ∈ H} ≤ Nat.card (Subgroup G)

/-- Nonabelian finite simple groups admit two generators of prime-power order. -/
def H2 : Prop :=
  ∀ (S : Type) [Group S] [Finite S] [IsSimpleGroup S],
    ¬ IsMulCommutative S →
    ∃ a b : S, IsPrimePow (orderOf a) ∧ IsPrimePow (orderOf b) ∧
      Subgroup.closure ({a, b} : Set S) = ⊤

lemma primePowerOrder_not_one {Q : Type} [Group Q] {a : Q} (ha : IsPrimePow (orderOf a)) : a ≠ 1 := by
  intro h
  subst a
  obtain ⟨p, k, hp, hk, he⟩ := (isPrimePow_nat_iff _).mp ha
  rw [orderOf_one] at he
  exact (Nat.one_lt_pow hk.ne' hp.one_lt).ne' he

/-- Taking the prime-power part of the order of a lift preserves the cyclic
subgroup generated by its image. A further power recovers the original image. -/
private lemma lift_primePower {G Q : Type} [Group G] [Finite G] [Group Q]
    (q : G →* Q) (hq : Function.Surjective q) {a : Q} (ha : IsPrimePow (orderOf a)) :
    ∃ g : G, IsPrimePow (orderOf g) ∧ q g = a := by
  obtain ⟨x, hx⟩ := hq a
  obtain ⟨p, k, hp, _, hpa⟩ := (isPrimePow_nat_iff _).mp ha
  let r := ordCompl[p] (orderOf x)
  have hx0 : orderOf x ≠ 0 := (orderOf_pos x).ne'
  have hcop : r.Coprime (orderOf a) := by
    rw [← hpa]
    exact (Nat.coprime_ordCompl hp hx0).symm.pow_right _
  obtain ⟨m, hm⟩ := exists_pow_eq_self_of_coprime hcop
  let g := (x ^ r) ^ m
  have hg : q g = a := by simpa only [g, map_pow, hx] using hm
  have hxorder : orderOf (x ^ r) = p ^ (orderOf x).factorization p :=
    orderOf_pow_orderOf_div hx0 (Nat.ordProj_dvd _ _)
  have hdiv : orderOf g ∣ p ^ (orderOf x).factorization p :=
    hxorder ▸ orderOf_pow_dvd (x := x ^ r) m
  obtain ⟨e, _, he⟩ := (Nat.dvd_prime_pow hp).mp hdiv
  have he0 : e ≠ 0 := by
    intro he0
    have hg1 : g = 1 := orderOf_eq_one_iff.mp (by simpa [he0] using he)
    exact primePowerOrder_not_one ha (by rw [← hg, hg1, map_one])
  exact ⟨g, (isPrimePow_nat_iff _).mpr ⟨p, e, hp, Nat.pos_of_ne_zero he0, he.symm⟩, hg⟩

/-- Intersecting with the kernel injects the subgroups containing both
generators into those containing neither. -/
private lemma half_of_generating_mod {G : Type} [Group G] [Finite G]
    (N : Subgroup G) [N.Normal] {g h : G} (hgN : g ∉ N) (hhN : h ∉ N)
    (hjoin : Subgroup.closure ({g, h} : Set G) ⊔ N = ⊤) :
    2 * Nat.card {H : Subgroup G // g ∈ H} ≤ Nat.card (Subgroup G) ∨
      2 * Nat.card {H : Subgroup G // h ∈ H} ≤ Nat.card (Subgroup G) := by
  classical
  let K := Subgroup.closure ({g, h} : Set G)
  have reconstruct (H : Subgroup G) (hgH : g ∈ H) (hhH : h ∈ H) : K ⊔ (H ⊓ N) = H := by
    have hK : K ≤ H := by
      dsimp [K]
      rw [Subgroup.closure_le]
      intro x hx
      rcases Set.mem_insert_iff.mp hx with rfl | hx
      · exact hgH
      · rw [Set.mem_singleton_iff.mp hx]
        exact hhH
    apply le_antisymm (sup_le hK inf_le_left)
    intro x hx
    have hx' : x ∈ K ⊔ N := by rw [hjoin]; exact Subgroup.mem_top x
    obtain ⟨k, hk, n, hn, rfl⟩ := Subgroup.mem_sup_of_normal_right.mp hx'
    have hnH : n ∈ H := by simpa using H.mul_mem (H.inv_mem (hK hk)) hx
    exact Subgroup.mul_mem_sup hk (show n ∈ H ⊓ N from ⟨hnH, hn⟩)
  let _ : Fintype (Subgroup G) := Fintype.ofFinite _
  let A := Finset.univ.filter (fun H : Subgroup G => g ∈ H)
  let B := Finset.univ.filter (fun H : Subgroup G => h ∈ H)
  have hmem (H : Subgroup G) : H ∈ A ∩ B ↔ g ∈ H ∧ h ∈ H := by simp [A, B]
  have hle : (A ∩ B).card ≤ ((A ∪ B)ᶜ).card := by
    apply Finset.card_le_card_of_injOn (fun H : Subgroup G => H ⊓ N)
    · intro H _
      simp [A, B, hgN, hhN]
    · intro H hH J hJ he
      obtain ⟨hHg, hHh⟩ := (hmem H).mp hH
      obtain ⟨hJg, hJh⟩ := (hmem J).mp hJ
      change H ⊓ N = J ⊓ N at he
      rw [← reconstruct H hHg hHh, ← reconstruct J hJg hJh, he]
  have hunion := Finset.card_union_add_card_inter A B
  have hcompl := Finset.card_add_card_compl (A ∪ B)
  have card_mem (x : G) : Nat.card {H : Subgroup G // x ∈ H} =
      (Finset.univ.filter (fun H : Subgroup G => x ∈ H)).card := by
    let _ : Fintype {H : Subgroup G // x ∈ H} := Fintype.ofFinite _
    rw [Nat.card_eq_fintype_card, Fintype.card_subtype]
  rw [card_mem g, card_mem h, Nat.card_eq_fintype_card]
  change 2 * A.card ≤ Fintype.card (Subgroup G) ∨ 2 * B.card ≤ Fintype.card (Subgroup G)
  omega

theorem quotient_generated : H1 := by
  intro G _ _ N _ a b ha hb hab
  let q := QuotientGroup.mk' N
  have hq : Function.Surjective q := QuotientGroup.mk'_surjective N
  obtain ⟨g, hg, hga⟩ := lift_primePower q hq ha
  obtain ⟨h, hh, hhb⟩ := lift_primePower q hq hb
  have hgN : g ∉ N := by
    intro hgN
    apply primePowerOrder_not_one ha
    rw [← hga]
    exact (QuotientGroup.eq_one_iff g).mpr hgN
  have hhN : h ∉ N := by
    intro hhN
    apply primePowerOrder_not_one hb
    rw [← hhb]
    exact (QuotientGroup.eq_one_iff h).mpr hhN
  let K := Subgroup.closure ({g, h} : Set G)
  have hmap : K.map q = ⊤ := by
    rw [MonoidHom.map_closure, Set.image_insert_eq, Set.image_singleton, hga, hhb, hab]
  have hjoin : K ⊔ N = ⊤ := by
    have he := congrArg (Subgroup.comap q) hmap
    rw [Subgroup.comap_map_eq, Subgroup.comap_top] at he
    simpa only [q, QuotientGroup.ker_mk'] using he
  exact (half_of_generating_mod N hgN hhN hjoin).elim
    (fun hle => ⟨g, hg, hle⟩) (fun hle => ⟨h, hh, hle⟩)


/-- A maximal proper normal subgroup has a nontrivial simple quotient. -/
private lemma simple_quotient_of_maximal {G : Type} [Group G] {N : Subgroup G} [N.Normal]
    (hN : Maximal (fun M : Subgroup G => M.Normal ∧ M ≠ ⊤) N) : IsSimpleGroup (G ⧸ N) := by
  have : Nontrivial (G ⧸ N) := QuotientGroup.nontrivial_iff.mpr hN.1.2
  refine ⟨?_⟩
  intro S hS
  by_cases htop : S = ⊤
  · exact Or.inr htop
  left
  let q := QuotientGroup.mk' N
  have hq : Function.Surjective q := QuotientGroup.mk'_surjective N
  have hle : N ≤ S.comap q := by
    simpa only [q, QuotientGroup.ker_mk'] using S.ker_le_comap q
  have hproper : S.comap q ≠ ⊤ := fun he =>
    htop (Subgroup.comap_injective hq (he.trans (Subgroup.comap_top q).symm))
  have hge : S.comap q ≤ N := hN.2 ⟨hS.comap q, hproper⟩ hle
  apply Subgroup.comap_injective hq
  change S.comap q = q.ker
  simpa only [q, QuotientGroup.ker_mk'] using le_antisymm hge hle

private lemma generators_comm_simple (S : Type) [Group S] [Finite S] [IsSimpleGroup S]
    (hcomm : IsMulCommutative S) :
    ∃ a b : S, IsPrimePow (orderOf a) ∧ IsPrimePow (orderOf b) ∧
      Subgroup.closure ({a, b} : Set S) = ⊤ := by
  let _ : CommGroup S := { ‹Group S› with mul_comm := mul_comm' }
  have hp : (Nat.card S).Prime := CommGroup.is_simple_iff_prime_card.mp ‹IsSimpleGroup S›
  have : Fact ((Nat.card S).Prime) := ⟨hp⟩
  obtain ⟨a, ha⟩ := exists_prime_orderOf_dvd_card' (Nat.card S) (G := S) (dvd_refl _)
  have hap : IsPrimePow (orderOf a) := (isPrimePow_nat_iff _).mpr
    ⟨Nat.card S, 1, hp, Nat.one_pos, by simpa only [pow_one] using ha.symm⟩
  refine ⟨a, a, hap, hap, ?_⟩
  let K := Subgroup.closure ({a, a} : Set S)
  have hKa : a ∈ K := Subgroup.subset_closure (Set.mem_insert _ _)
  rcases (inferInstance : K.Normal).eq_bot_or_eq_top with h | h
  · rw [h, Subgroup.mem_bot] at hKa
    exact (primePowerOrder_not_one hap hKa).elim
  · exact h

theorem main : H1 → H2 → type_of% @OMA.S_mo_154025.main := by
  intro lifted generated G _ _ hG
  classical
  let candidates : Set (Subgroup G) := {N | N.Normal ∧ N ≠ ⊤}
  have hbot : (⊥ : Subgroup G) ∈ candidates := ⟨inferInstance, bot_ne_top⟩
  obtain ⟨N, hN⟩ := candidates.toFinite.exists_maximal ⟨⊥, hbot⟩
  have : N.Normal := hN.1.1
  have : IsSimpleGroup (G ⧸ N) := simple_quotient_of_maximal hN
  have generators : ∃ a b : G ⧸ N, IsPrimePow (orderOf a) ∧ IsPrimePow (orderOf b) ∧
      Subgroup.closure ({a, b} : Set (G ⧸ N)) = ⊤ := by
    by_cases hcomm : IsMulCommutative (G ⧸ N)
    · exact generators_comm_simple _ hcomm
    · exact generated _ hcomm
  obtain ⟨a, b, ha, hb, hab⟩ := generators
  obtain ⟨g, hg, hhalf⟩ := lifted G N a b ha hb hab
  obtain ⟨p, k, hp, hk, he⟩ := (isPrimePow_nat_iff _).mp hg
  exact ⟨g, ⟨p, k, hp, hk, he.symm⟩, hhalf⟩

/-- Nonabelian simple-group generation suffices for the conjecture. -/
theorem of_simple_generation : H2 → type_of% @OMA.S_mo_154025.main :=
  main quotient_generated

/-- The bound holds for every finite group with a proper commutator subgroup. -/
theorem nonperfect_case (G : Type) [Group G] [Finite G] (hproper : commutator G ≠ ⊤) :
    ∃ g : G, IsPrimePow (orderOf g) ∧
      2 * Nat.card {H : Subgroup G // g ∈ H} ≤ Nat.card (Subgroup G) := by
  classical
  let candidates : Set (Subgroup G) := {N | N.Normal ∧ N ≠ ⊤}
  have hc : commutator G ∈ candidates := ⟨inferInstance, hproper⟩
  obtain ⟨N, hle, hN⟩ := candidates.toFinite.exists_le_maximal hc
  have : N.Normal := hN.1.1
  have : IsSimpleGroup (G ⧸ N) := simple_quotient_of_maximal hN
  have hcomm : IsMulCommutative (G ⧸ N) :=
    Subgroup.Normal.quotient_commutative_iff_commutator_le.mpr hle
  obtain ⟨a, b, ha, hb, hab⟩ := generators_comm_simple (G ⧸ N) hcomm
  exact quotient_generated G N a b ha hb hab

end OMA.R_mo_154025_R1
