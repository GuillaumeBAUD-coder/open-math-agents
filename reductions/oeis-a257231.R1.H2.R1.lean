import OMAReductions.R_oeis_a257231_R1

/-! A pronic center is k(k+1), between k² and (k+1)². The finite prime-waypoint argument extends @physbuzz, PR #7357. -/

/-! Prime gaps in the interval between two successive squares. -/

namespace A257Gap

open OMA.S_oeis_a257231 OMA.R_oeis_a257231_R1

theorem inside_gap_iff {k p q : ℕ} (lo : k^2 ≤ p) (pq : p < q) (hi : q ≤ (k+1)^2) :
    (q-p)^2 < q ↔ q-p ≤ k := by
  constructor
  · intro h
    by_contra! bad
    have bound := Nat.pow_le_pow_left (show k+1 ≤ q-p by omega) 2
    omega
  · intro h
    exact (Nat.pow_le_pow_left h 2).trans_lt (lo.trans_lt pq)

theorem midpoint_failure {k p : ℕ} (hp : p.Prime) (lo : k^2 ≤ p) (hi : nextPrime p ≤ (k+1)^2)
    (bad : ¬(nextPrime p-p)^2 < nextPrime p) :
    let m := k*(k+1)
    p < m ∧ m < nextPrime p ∧
      p = Nat.findGreatest Nat.Prime m ∧ nextPrime p = nextPrime m ∧
      0 < m-p ∧ 0 < nextPrime p-m ∧
      (m-p)+(nextPrime p-m) = nextPrime p-p ∧ k+1 ≤ (m-p)+(nextPrime p-m) := by
  dsimp only
  obtain ⟨pq,hq⟩ := prime_spec p
  have large : k < nextPrime p-p := by
    by_contra! h
    exact bad ((inside_gap_iff lo pq hi).mpr h)
  have upper_strict : nextPrime p < (k+1)^2 :=
    lt_of_le_of_ne hi (fun e => Nat.Prime.not_prime_pow (by decide : 2 ≤ 2) (e ▸ hq))
  have e₁ : k*(k+1) = k^2+k := by ring
  have e₂ : (k+1)^2 = k*(k+1)+k+1 := by ring
  have left : p < k*(k+1) := by omega
  have right : k*(k+1) < nextPrime p := by omega
  have prev_le : Nat.findGreatest Nat.Prime (k*(k+1)) ≤ k*(k+1) := Nat.findGreatest_le _
  have prev_ge := Nat.le_findGreatest left.le hp
  have prev_prime := Nat.findGreatest_spec left.le hp
  have prev : p = Nat.findGreatest Nat.Prime (k*(k+1)) := by
    apply le_antisymm prev_ge
    by_contra! x
    have := prime_min p _ prev_prime x
    omega
  have next : nextPrime p = nextPrime (k*(k+1)) :=
    le_antisymm (prime_min p _ (prime_spec _).2 (left.trans (prime_spec _).1))
      (prime_min _ _ hq right)
  exact ⟨left,right,prev,next,by omega,by omega,by omega,by omega⟩

theorem endpoint_clearance {k p : ℕ} (hk : 2 ≤ k) (hp : p.Prime) (lo : k^2 ≤ p)
    (hi : nextPrime p ≤ (k+1)^2) (bad : ¬(nextPrime p-p)^2 < nextPrime p) :
    let m := k*(k+1)
    3 ≤ m-p ∧ 3 ≤ nextPrime p-m ∧ Odd (m-p) ∧ Odd (nextPrime p-m) ∧
      ¬(m-1).Prime ∧ ¬(m+1).Prime := by
  dsimp only
  obtain ⟨left,right,_,_,_,_,dist,large⟩ := midpoint_failure hp lo hi bad
  obtain ⟨pq,hq⟩ := prime_spec p
  have plo : k^2 < p := lt_of_le_of_ne lo (fun e => Nat.Prime.not_prime_pow (by decide : 2 ≤ 2) (e.symm ▸ hp))
  have qhi : nextPrime p < (k+1)^2 := lt_of_le_of_ne hi (fun e => Nat.Prime.not_prime_pow (by decide : 2 ≤ 2) (e ▸ hq))
  have e₁ : k*(k+1) = k^2+k := by ring
  have e₂ : (k+1)^2 = k*(k+2)+1 := by ring
  have e₃ : k*(k+2) = k*(k+1)+k := by ring
  have nq : nextPrime p ≠ k*(k+2) := fun e => Nat.not_prime_mul (by omega) (by omega) (e ▸ hq)
  have four : 4 ≤ k^2 := Nat.pow_le_pow_left hk 2
  obtain ⟨z,he⟩ := Nat.two_dvd_mul_add_one k
  obtain ⟨a,ha⟩ := hp.odd_of_ne_two (by omega)
  obtain ⟨b,hb⟩ := hq.odd_of_ne_two (by omega)
  have lodd : Odd (k*(k+1)-p) := ⟨z-a-1,by omega⟩
  have rodd : Odd (nextPrime p-k*(k+1)) := ⟨b-z,by omega⟩
  have lb : 3 ≤ k*(k+1)-p := by omega
  have rb : 3 ≤ nextPrime p-k*(k+1) := by omega
  refine ⟨lb,rb,lodd,rodd,?_,?_⟩
  · intro h
    have bound := prime_min p _ h (by omega)
    omega
  · intro h
    have bound := prime_min p _ h (by omega)
    omega

theorem midpoint_bad {k p : ℕ} (hk : 2 ≤ k) (hp : p.Prime) (lo : k^2 ≤ p)
    (hi : nextPrime p ≤ (k+1)^2) (bad : ¬(nextPrime p-p)^2 < nextPrime p) :
    let c := k*(k+1)
    p < c ∧ c < nextPrime p ∧ p = Nat.findGreatest Nat.Prime c ∧
      nextPrime p = nextPrime c ∧ ¬(c-1).Prime ∧ ¬(c+1).Prime := by
  obtain ⟨left,right,prev,next,_,_,_,_⟩ := midpoint_failure hp lo hi bad
  obtain ⟨_,_,_,_,below,above⟩ := endpoint_clearance hk hp lo hi bad
  exact ⟨left,right,prev,next,below,above⟩

end A257Gap

namespace A257Gap
open OMA.S_oeis_a257231 OMA.R_oeis_a257231_R1

/-- It suffices to check strict records against a nondecreasing bound. -/
theorem bound_of_records (eligible : ℕ → Prop) (width bound : ℕ → ℕ)
    (mono : Monotone bound)
    (records : ∀ n, eligible n → (∀ j < n, eligible j → width j < width n) →
      width n ≤ bound n) :
    ∀ n, eligible n → width n ≤ bound n := by
  intro n
  induction n using Nat.strong_induction_on with
  | h n prev =>
    intro en
    by_cases record : ∀ j < n, eligible j → width j < width n
    · exact records n en record
    · push Not at record
      obtain ⟨j,hj,ej,le⟩ := record
      exact (le.trans (prev j hj ej)).trans (mono hj.le)

/-- Two primes bracketing a center bound the gap between its nearest primes. -/
theorem width_of_bracket {c u v k : ℕ} (hu : u.Prime) (hv : v.Prime)
    (le : u ≤ c) (lt : c < v) (span : v-u ≤ k) :
    nextPrime c - Nat.findGreatest Nat.Prime c ≤ k := by
  have left : u ≤ Nat.findGreatest Nat.Prime c := Nat.le_findGreatest le hu
  have right := prime_min c v hv lt
  omega

end A257Gap

/-! Proper prime powers occupy at most one position per odd exponent in an
open interval between consecutive squares. -/

namespace A257Gap
open Finset

theorem no_square_in_band {k a : ℕ} (lo : k^2 < a^2) (hi : a^2 < (k+1)^2) : False := by
  by_cases h : a ≤ k
  · exact lo.not_ge (Nat.pow_le_pow_left h 2)
  · exact hi.not_ge (Nat.pow_le_pow_left (show k+1 ≤ a by omega) 2)

/-- No two distinct powers of the same exponent at least two can be in the band. -/
theorem power_unique_in_band {k a b m : ℕ} (hm : 2 ≤ m)
    (ha : k^2 < a^m ∧ a^m < (k+1)^2) (hb : k^2 < b^m ∧ b^m < (k+1)^2) : a = b := by
  have sep {u v : ℕ} (lt : u < v) (lo : k^2 < u^m) (hi : v^m < (k+1)^2) : False := by
    obtain ⟨t, rfl⟩ : ∃ t, m = t+2 := ⟨m-2,by omega⟩
    rw [pow_add] at lo hi
    have uz : 0 < u^t := by by_contra! h; simp [Nat.eq_zero_of_le_zero h] at lo
    have mul := Nat.mul_le_mul_right (u^2) (Nat.le_mul_self (u^t))
    have big : k < u^t*u := by
      by_contra! small
      have sq := Nat.pow_le_pow_left small 2
      nlinarith
    have grow := Nat.mul_le_mul (Nat.pow_le_pow_left lt.le t)
      (Nat.pow_le_pow_left (show u+1 ≤ v by omega) 2)
    nlinarith
  rcases lt_trichotomy a b with h|h|h
  · exact (sep h ha.1 hb.2).elim
  · exact h
  · exact (sep h hb.1 ha.2).elim

/-- The number of available exponent labels is the number of odd integers
from 3 to the binary logarithm of the last integer in the square band. -/
theorem proper_prime_power_count {k : ℕ} (s : Finset ℕ)
    (band : ∀ x ∈ s, k^2 < x ∧ x < (k+1)^2) :
    (s.filter (fun x => IsPrimePow x ∧ ¬x.Prime)).card ≤ (Nat.log 2 ((k+1)^2-1)-1)/2 := by
  classical
  let U := (k+1)^2-1
  let B := Nat.log 2 U
  let S := s.filter (fun x => IsPrimePow x ∧ ¬x.Prime)
  have rep (x : S) : ∃ m, m ≤ B ∧ m ≥ 3 ∧ m % 2 = 1 ∧ ∃ a : ℕ, x.val = a^m := by
    obtain ⟨xs,hp,hn⟩ := mem_filter.mp x.property
    obtain ⟨m,hmax,hpos,a,_,eq,ap⟩ := (isPrimePow_nat_iff_bounded_log x.val).mp hp
    obtain ⟨lo,hi⟩ := band x.val xs
    have ne : m ≠ 1 := by
      rintro rfl
      exact hn (by simpa [eq] using ap)
    have odd : m % 2 = 1 := by
      by_contra! h
      have even : m=m/2*2 := by omega
      have square : x.val = (a^(m/2))^2 := by rw [← pow_mul,← even,← eq]
      exact no_square_in_band (square ▸ lo) (square ▸ hi)
    have hU : x.val ≤ U := by dsimp [U]; omega
    exact ⟨m,hmax.trans (Nat.log_mono_right hU),by omega,odd,a,eq⟩
  choose e bound low odd witness using rep
  let f (x : S) : Fin ((B-1)/2) := ⟨e x/2-1,by
    have := bound x
    have := low x
    have := odd x
    omega⟩
  have inj : Function.Injective f := by
    intro x y h
    have same := congrArg Fin.val h
    change e x / 2 - 1 = e y / 2 - 1 at same
    have eq : e x = e y := by
      have := low x
      have := low y
      have := odd x
      have := odd y
      omega
    obtain ⟨a,ha⟩ := witness x
    obtain ⟨b,hb⟩ := witness y
    rw [← eq] at hb
    have bx := band x.val (mem_filter.mp x.property).1
    have by' := band y.val (mem_filter.mp y.property).1
    rw [ha] at bx
    rw [hb] at by'
    have eqb := power_unique_in_band (le_trans (by decide : 2 ≤ 3) (low x)) bx by'
    exact Subtype.ext (ha.trans ((congrArg (· ^ e x) eqb).trans hb.symm))
  simpa only [Fintype.card_coe,Fintype.card_fin] using Fintype.card_le_of_injective f inj

theorem prime_of_many_prime_powers {k : ℕ} (s : Finset ℕ)
    (band : ∀ x ∈ s, k^2 < x ∧ x < (k+1)^2)
    (many : (Nat.log 2 ((k+1)^2-1)-1)/2 < (s.filter IsPrimePow).card) :
    ∃ p ∈ s, Nat.Prime p := by
  by_contra! none
  have eq : s.filter IsPrimePow = s.filter (fun x => IsPrimePow x ∧ ¬ x.Prime) := by
    ext x
    simp only [mem_filter]
    exact ⟨fun h => ⟨h.1,h.2,none x h.1⟩,fun h => ⟨h.1,h.2.1⟩⟩
  rw [eq] at many
  exact many.not_ge (proper_prime_power_count s band)

end A257Gap

/-! Finite prime-gap certificates extending the verified initial interval of @physbuzz.
Each block uses a fixed stride and stores one byte for the amount subtracted from that stride.
The kernel checks that the resulting waypoints are prime and that each squared gap is below its lower endpoint. -/

namespace A257Gap
open OMA.S_oeis_a257231 OMA.R_oeis_a257231_R1

lemma prime_from_sieve (v b : ℕ) (small : v < (b+1)^2) (big : 2 ≤ v)
    (cop : v.Coprime (Nat.factorial b)) : v.Prime := by
  have cut := (Nat.coprime_factorial_iff (show v ≠ 1 by omega)).mp cop
  refine Nat.prime_def_le_sqrt.mpr ⟨big,?_⟩
  intro t ht hs dv
  have bound : v.sqrt < b+1 := Nat.sqrt_lt.mpr (by simpa only [pow_two] using small)
  have le := Nat.minFac_le_of_dvd ht dv
  omega

lemma sparse_interval (a n b : ℕ) (ps : List ℕ)
    (hc : (a::ps).IsChain (fun u v => ((v-u)^2 < u ∧ 2 ≤ v ∧ v < (b+1)^2) ∧ v.Coprime (Nat.factorial b)))
    (lo : a ≤ n) (hi : n < (a::ps).getLastD 0) : (nextPrime n-n)^2 < nextPrime n := by
  induction ps generalizing a with
  | nil => simp at hi; omega
  | cons z zs ih =>
    obtain ⟨⟨⟨gap,big,small⟩,cop⟩,rest⟩ := List.isChain_cons_cons.mp hc
    by_cases h : n<z
    · have bound := prime_min n z (prime_from_sieve z b small big cop) h
      have le : nextPrime n-n ≤ z-a := by omega
      exact ((Nat.pow_le_pow_left le 2).trans_lt gap).trans_le (lo.trans (prime_spec n).1.le)
    · exact ih z rest (by omega) (by simpa using hi)

