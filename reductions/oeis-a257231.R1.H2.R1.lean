              · have hi := split
                exact part_122 n lo hi
              · have lo : 3950202209 ≤ n := Nat.le_of_not_gt split
                exact part_123 n lo hi

end A257Gap

namespace OMA.R_oeis_a257231_R1_H2_R1
open OMA.S_oeis_a257231 OMA.R_oeis_a257231_R1

/-- Finite record-gap table, starting at the end of the verified waypoint cover.
The bound 1550 is the published maximum gap below 2^64. -/
def H1 : Prop :=
  ∀ p : ℕ, 4000028147 ≤ p → p < 2^64 → p.Prime →
    (∀ r < p, 4000028147 ≤ r → r.Prime → nextPrime r-r < nextPrime p-p) →
    nextPrime p-p ≤ 1550

/-- At a record midpoint gap, give any two bracketing primes at distance at most k.
The midpoint candidates exclude the cases settled by an adjacent prime. -/
def H2 : Prop :=
  let c (k : ℕ) := k*(k+1)
  let a (k : ℕ) := Nat.findGreatest Nat.Prime (c k)
  let b (k : ℕ) := nextPrime (c k)
  let candidate (k : ℕ) := 2^32 ≤ k ∧ k^2 ≤ a k ∧ b k ≤ (k+1)^2 ∧
    ¬(c k-1).Prime ∧ ¬(c k+1).Prime
  ∀ k, candidate k → (∀ j < k, candidate j → b j-a j < b k-a k) →
    ∃ u v : ℕ, u.Prime ∧ v.Prime ∧ u ≤ c k ∧ c k < v ∧ v-u ≤ k

/-- A prime-power count on each side can replace explicit prime witnesses in H2.
Each finite set lies inside the square band and the two sets together span at most k. -/
theorem H2_of_prime_power_windows
    (windows :
      let c (k : ℕ) := k*(k+1)
      let a (k : ℕ) := Nat.findGreatest Nat.Prime (c k)
      let b (k : ℕ) := nextPrime (c k)
      let candidate (k : ℕ) := 2^32 ≤ k ∧ k^2 ≤ a k ∧ b k ≤ (k+1)^2 ∧
        ¬(c k-1).Prime ∧ ¬(c k+1).Prime
      ∀ k, candidate k → (∀ j < k, candidate j → b j-a j < b k-a k) →
        ∃ L R : Finset ℕ,
          (∀ x ∈ L, k^2 < x ∧ x ≤ c k) ∧ (∀ y ∈ R, c k < y ∧ y < (k+1)^2) ∧
          (∀ x ∈ L, ∀ y ∈ R, y-x ≤ k) ∧
          (Nat.log 2 ((k+1)^2-1)-1)/2 < (L.filter IsPrimePow).card ∧
          (Nat.log 2 ((k+1)^2-1)-1)/2 < (R.filter IsPrimePow).card) : H2 := by
  intro k eligible record
  obtain ⟨L,R,left,right,span,manyL,manyR⟩ := windows k eligible record
  have hc : k*(k+1) < (k+1)^2 := by nlinarith
  have hc' : k^2 ≤ k*(k+1) := by nlinarith
  obtain ⟨u,hu,primeU⟩ := A257Gap.prime_of_many_prime_powers L
    (fun x hx => ⟨(left x hx).1,lt_of_le_of_lt (left x hx).2 hc⟩) manyL
  obtain ⟨v,hv,primeV⟩ := A257Gap.prime_of_many_prime_powers R
    (fun y hy => ⟨lt_of_le_of_lt hc' (right y hy).1,(right y hy).2⟩) manyR
  exact ⟨u,v,primeU,primeV,(left u hu).2,(right v hv).1,span u hu v hv⟩

theorem main : H1 → H2 → OMA.R_oeis_a257231_R1.H2 := by
  intro finiteRecords centerRecords k p start hp lo hi
  by_cases small : p < 4000028147
  · exact A257Gap.finite_part p start small
  by_cases intermediate : p < 2^64
  · let eligible (n : ℕ) := 4000028147 ≤ n ∧ n < 2^64 ∧ n.Prime
    let gap (n : ℕ) := nextPrime n - n
    have records (n : ℕ) (h : eligible n)
        (record : ∀ j < n, eligible j → gap j < gap n) : gap n ≤ 1550 :=
      finiteRecords n h.1 h.2.1 h.2.2 (fun j hj hmin hprime =>
        record j hj ⟨hmin,hj.trans h.2.1,hprime⟩)
    have cap := A257Gap.bound_of_records eligible gap (fun _ => 1550)
      (fun _ _ _ => le_rfl) records p ⟨by omega,intermediate,hp⟩
    have pow := Nat.pow_le_pow_left cap 2
    change (nextPrime p-p)^2 ≤ 1550^2 at pow
    have pq := (prime_spec p).1
    omega
  let c (j : ℕ) := j*(j+1)
  let a (j : ℕ) := Nat.findGreatest Nat.Prime (c j)
  let b (j : ℕ) := nextPrime (c j)
  let candidate (j : ℕ) := 2^32 ≤ j ∧ j^2 ≤ a j ∧ b j ≤ (j+1)^2 ∧
    ¬(c j-1).Prime ∧ ¬(c j+1).Prime
  let span (j : ℕ) := b j-a j
  have records (j : ℕ) (hj : candidate j)
      (rec : ∀ n < j, candidate n → span n < span j) : span j ≤ j := by
    obtain ⟨u,v,hu,hv,left,right,d⟩ := centerRecords j hj rec
    exact A257Gap.width_of_bracket hu hv left right d
  have pq := (prime_spec p).1
  have hk : 2^32 ≤ k := by
    by_contra! h
    have hsq := Nat.pow_le_pow_left (show k+1 ≤ 2^32 by omega) 2
    norm_num at hsq intermediate
    omega
  by_contra bad
  obtain ⟨_,_,prev,nxt,minus,plus⟩ :=
    A257Gap.midpoint_bad (by omega : 2 ≤ k) hp lo hi bad
  have hprev : p = a k := prev
  have hnxt : nextPrime p = b k := nxt
  have eligible : candidate k :=
    ⟨hk,hprev ▸ lo,hnxt ▸ hi,minus,plus⟩
  have hgap := A257Gap.bound_of_records candidate span id monotone_id records k eligible
  apply bad
  apply (A257Gap.inside_gap_iff lo pq hi).mpr
  change span k ≤ k at hgap
  simpa only [span,←hprev,←hnxt] using hgap

end OMA.R_oeis_a257231_R1_H2_R1
