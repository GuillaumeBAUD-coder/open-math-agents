import OMAReductions.R_Erdos1160_erdos_1160_variants_sum_R2
import Mathlib.GroupTheory.Index
import Mathlib.Data.Nat.Log
import Mathlib.Data.Set.Card

-- Reduction Erdos1160.erdos_1160.variants.sum.R2.H3.R1 of step Erdos1160.erdos_1160.variants.sum.R2.H3
-- Credit: @gertjanvdgoot

/-!
Split the groups of order 2^(m-2) by d, where 2^d is the index of the subgroup F generated by
the squares (G/F is elementary abelian of rank d).

* H1 (large rank, 5(m-2) ≤ 6d): elementary. The pc-presentation count through F bounds these
  classes by 2^(C(k+1,3) - C(d+1,3)) ≤ 2^((91/1296) k^3) ≈ 2^(0.0702 k^3), k = m-2, and the factor
  2^(2m+1) is quadratically smaller than the gap to Higman's g(2^m) ≥ 2^(0.0741 m^3 - O(m^2)).
* H2 (smaller rank, 6d < 5(m-2)): the bulk; needs the growth from 2^(m-2) to 2^m, i.e. the sharp
  two-group enumeration (Li and Qiao, arXiv:2610.14509).

main: g(2^(m-2)) is at most the sum of the two counts.
-/

open Filter CategoryTheory Erdos1160

namespace OMA.R_Erdos1160_erdos_1160_variants_sum_R2_H3_R1

/-- Classes of order 2^(m-2) with a large square-subgroup index, weighted by 2^(2m+1). -/
def H1 : Prop := ∀ᶠ m : ℕ in atTop,
  2^(2*m+1) * (Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) '' {G : FiniteGrp.{0} |
    Nat.card G = 2^(m-2) ∧
    5*(m-2) ≤ 6*Nat.log 2 (Subgroup.closure (Set.range (fun x : G => x*x))).index}).ncard ≤ g (2^m)

/-- The same for the classes of order 2^(m-2) with a smaller square-subgroup index. -/
def H2 : Prop := ∀ᶠ m : ℕ in atTop,
  2^(2*m+1) * (Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) '' {G : FiniteGrp.{0} |
    Nat.card G = 2^(m-2) ∧
    ¬ 5*(m-2) ≤ 6*Nat.log 2 (Subgroup.closure (Set.range (fun x : G => x*x))).index}).ncard ≤ g (2^m)

/-- The classes of order n split along any property of the representative. -/
theorem split_le (n : ℕ) (P : FiniteGrp.{0} → Prop) :
    g n ≤ (Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) ''
        {G : FiniteGrp.{0} | Nat.card G = n ∧ P G}).ncard +
      (Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) ''
        {G : FiniteGrp.{0} | Nat.card G = n ∧ ¬ P G}).ncard := by
  unfold g
  have h : {G : FiniteGrp.{0} | Nat.card G = n} =
      {G : FiniteGrp.{0} | Nat.card G = n ∧ P G} ∪ {G : FiniteGrp.{0} | Nat.card G = n ∧ ¬ P G} := by
    ext G
    simp only [Set.mem_setOf_eq, Set.mem_union]
    tauto
  rw [h, Set.image_union]
  exact Set.ncard_union_le _ _

theorem main : H1 → H2 → OMA.R_Erdos1160_erdos_1160_variants_sum_R2.H3 := by
  intro large small
  filter_upwards [large, small] with m hl hs
  have hsplit := split_le (2^(m-2))
    (fun G => 5*(m-2) ≤ 6*Nat.log 2 (Subgroup.closure (Set.range (fun x : G => x*x))).index)
  set a := (Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) '' {G : FiniteGrp.{0} |
    Nat.card G = 2^(m-2) ∧
    5*(m-2) ≤ 6*Nat.log 2 (Subgroup.closure (Set.range (fun x : G => x*x))).index}).ncard
  set b := (Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) '' {G : FiniteGrp.{0} |
    Nat.card G = 2^(m-2) ∧
    ¬ 5*(m-2) ≤ 6*Nat.log 2 (Subgroup.closure (Set.range (fun x : G => x*x))).index}).ncard
  have h2 : 2^(2*m+1) = 2 * 2^(2*m) := by rw [pow_succ]; ring
  rw [h2] at hl hs
  calc 2 ^ (2 * m) * g (2 ^ (m - 2)) ≤ 2 ^ (2 * m) * (a + b) := Nat.mul_le_mul_left _ hsplit
    _ = 2 ^ (2 * m) * a + 2 ^ (2 * m) * b := by ring
    _ ≤ g (2 ^ m) := by nlinarith

end OMA.R_Erdos1160_erdos_1160_variants_sum_R2_H3_R1
