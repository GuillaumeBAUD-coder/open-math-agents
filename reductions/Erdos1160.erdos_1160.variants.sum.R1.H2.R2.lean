import OMAReductions.R_Erdos1160_erdos_1160_variants_sum_R1
import Mathlib.GroupTheory.Index
import Mathlib.Data.Nat.Log
import Mathlib.Data.Set.Card

-- Reduction Erdos1160.erdos_1160.variants.sum.R1.H2.R2 of step Erdos1160.erdos_1160.variants.sum.R1.H2
-- Credit: @gertjanvdgoot

/-!
Split the groups of order 2^m by d, where 2^d is the index of the subgroup F generated by the
squares (so G/F is elementary abelian of rank d).

* H1 (large rank, 5m ≤ 6d): elementary. Running the pc-presentation count with the series through
  F, all power and commutator codes vanish in the first d coordinates, so these classes number at
  most 2^(C(m+1,3) - C(d+1,3)) ≤ 2^((m^3 - d^3)/6) ≤ 2^((91/1296) m^3) ≈ 2^(0.0702 m^3), while
  Higman gives g(2^(m+1)) ≥ 2^(0.0741 m^3 - O(m^2)).
* H2 (smaller rank, 6d < 5m): contains the bulk of the groups (Higman's family has d ≈ 2m/3); the
  bound is the growth of g(2^m), i.e. the sharp two-group enumeration (Li and Qiao,
  arXiv:2610.14509).

main: g(2^m) is at most the sum of the two counts.
-/

open Filter CategoryTheory Erdos1160

namespace OMA.R_Erdos1160_erdos_1160_variants_sum_R1_H2_R2

/-- Classes of order 2^m whose square subgroup has index at least 2^(5m/6), times six, are
fewer than the groups of order 2^(m+1). -/
def H1 : Prop := ∀ᶠ m : ℕ in atTop,
  6 * (Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) '' {G : FiniteGrp.{0} | Nat.card G = 2^m ∧
    5*m ≤ 6*Nat.log 2 (Subgroup.closure (Set.range (fun x : G => x*x))).index}).ncard < g (2^(m+1))

/-- The same for the classes whose square subgroup has index below 2^(5m/6). -/
def H2 : Prop := ∀ᶠ m : ℕ in atTop,
  6 * (Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) '' {G : FiniteGrp.{0} | Nat.card G = 2^m ∧
    ¬ 5*m ≤ 6*Nat.log 2 (Subgroup.closure (Set.range (fun x : G => x*x))).index}).ncard < g (2^(m+1))

/-- The classes of order n split along any property of the representative. -/
theorem split_le (n : ℕ) (P : FiniteGrp.{0} → Prop) :
    g n ≤ (Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) ''
        {G : FiniteGrp.{0} | Nat.card G = n ∧ P G}).ncard +
      (Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) ''
        {G : FiniteGrp.{0} | Nat.card G = n ∧ ¬ P G}).ncard := by
  unfold g
  have h : {G : FiniteGrp.{0} | Nat.card G = n} =
      {G : FiniteGrp.{0} | Nat.card G = n ∧ P G} ∪ {G : FiniteGrp.{0} | Nat.card G = n ∧ ¬ P G} := by
    ext G
    simp only [Set.mem_setOf_eq, Set.mem_union]
    tauto
  rw [h, Set.image_union]
  exact Set.ncard_union_le _ _

theorem main : H1 → H2 → OMA.R_Erdos1160_erdos_1160_variants_sum_R1.H2 := by
  intro large small
  filter_upwards [large, small] with m hl hs
  have := split_le (2^m)
    (fun G => 5*m ≤ 6*Nat.log 2 (Subgroup.closure (Set.range (fun x : G => x*x))).index)
  omega

end OMA.R_Erdos1160_erdos_1160_variants_sum_R1_H2_R2
