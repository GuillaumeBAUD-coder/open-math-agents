import FormalConjectures.GreensOpenProblems.«14»

/-! Finite search on red positions meeting every twelve-term progression.
The four coordinate masks and their safety proof are adapted from the
merged Green14.W_3_11.R1.H1 and H3 proofs. -/

namespace OMA.Window131

private def NoTriple (R : Nat → Prop) :=
  ∀ a d, 0 < d → R a → R (a+d) → R (a+2*d) → False

private lemma distinct_terms {R : Nat → Prop} (hn : NoTriple R) {u v w : Nat}
    (hu : R u) (hv : R v) (hw : R w) (he : u+w=2*v) (hne : u ≠ w) : False := by
  rcases lt_or_gt_of_ne hne with h | h
  · exact hn u (v-u) (by omega) hu (by simpa only [show u+(v-u)=v by omega] using hv)
      (by simpa only [show u+2*(v-u)=w by omega] using hw)
  · exact hn w (v-w) (by omega) hw (by simpa only [show w+(v-w)=v by omega] using hv)
      (by simpa only [show w+2*(v-w)=u by omega] using hu)

-- Four views of the chosen red positions give every forbidden third point
-- by shifts. The last two views compress even and odd positions separately.
private structure Marks where
  rev : Nat
  dbl : Nat
  ev : Nat
  od : Nat
  red : Nat
  deriving DecidableEq

private def mark (q : Nat) : Marks :=
  ⟨1 <<< (130-q), 1 <<< (2*q),
    if q%2=0 then 1 <<< (q/2) else 0,
    if q%2=1 then 1 <<< (q/2) else 0, 1 <<< q⟩

private def join (s t : Marks) : Marks :=
  ⟨s.rev ||| t.rev, s.dbl ||| t.dbl, s.ev ||| t.ev, s.od ||| t.od, s.red ||| t.red⟩

private def forbidden (s : Marks) (p : Nat) : Nat :=
  ((s.rev <<< (2*p)) >>> 130) ||| (s.dbl >>> p) |||
    ((if p%2=0 then s.ev else s.od) <<< ((p+1)/2))

private def Good (R : Nat → Prop) (s : Marks) :=
  ∀ p t, R p → R t → t ≠ p → (forbidden s p).testBit t = false

private lemma mark_good {R : Nat → Prop} (hn : NoTriple R)
    {q : Nat} (hq : R q) (hq' : q ≤ 130) : Good R (mark q) := by
  intro p t hp ht hne
  have h₁ : t+q ≠ 2*p := fun he =>
    distinct_terms hn ht hp hq he (by rintro rfl; omega)
  have h₂ : t+p ≠ 2*q := fun he => distinct_terms hn ht hq hp he hne
  have h₃ : p+q ≠ 2*t := fun he =>
    distinct_terms hn hp ht hq he (by rintro rfl; omega)
  have single (x i : Nat) : (1 <<< x : Nat).testBit i = decide (x=i) := by
    rw [Nat.shiftLeft_eq, one_mul, Nat.testBit_two_pow]
  unfold forbidden mark
  split_ifs <;> simp only [Nat.testBit_or, Nat.testBit_shiftRight, single,
    Nat.testBit_shiftLeft, Nat.zero_testBit, Bool.or_eq_false_iff,
    Bool.and_eq_false_imp, decide_eq_true_eq, decide_eq_false_iff_not]
  all_goals (repeat' apply And.intro) <;> intros <;> first | trivial | omega

private lemma join_good {R : Nat → Prop} {s u : Marks} (hs : Good R s) (hu : Good R u) :
    Good R (join s u) := by
  intro p t hp ht hn
  have h₁ := hs p t hp ht hn
  have h₂ := hu p t hp ht hn
  unfold forbidden at *
  unfold join
  split_ifs at * <;> simp_all [Nat.testBit_or, Nat.testBit_shiftRight, Nat.testBit_shiftLeft]

private def addRed (s : Marks) (a p : Nat) : Marks × Nat :=
  let bad := forbidden s p
  (join s (mark p), (a ^^^ (a &&& bad)) ||| (1 <<< p))

private def Bad (hit : (Nat → Prop) → Prop) (seed : Marks × Nat) :=
  ∀ R : Nat → Prop, (∀ x, R x → x ≤ 130) → NoTriple R → hit R →
    Good R seed.1 → (∀ x, R x → seed.2.testBit x = true) → False

private lemma add_safe {R : Nat → Prop} {s : Marks} {a p : Nat} (hs : Good R s)
    (ha : ∀ x, R x → a.testBit x = true) (hp : R p) :
    ∀ x, R x → (addRed s a p).2.testBit x = true := by
  intro x hx
  by_cases he : x = p
  · simp [addRed, he, Nat.shiftLeft_eq]
  · simp [addRed, Nat.testBit_xor, ha x hx, hs p x hp hx he]

private def bases : Array Nat := #[0x1, 0xfff, 0x555555, 0x249249249, 0x111111111111, 0x84210842108421, 0x41041041041041041, 0x20408102040810204081, 0x10101010101010101010101, 0x8040201008040201008040201, 0x4010040100401004010040100401, 0x2004008010020040080100200400801]

private def pattern (d a : Nat) : Nat :=
  if 0 < d ∧ a+11*d < 131 then bases[d]! <<< a else bases[1]!

private def Hits (R : Nat → Prop) := ∀ d a, ∃ t, (pattern d a).testBit t = true ∧ R t

-- The bits of h count nonempty windows, and the bits of m indicate
-- windows with two available points or with a red point already marked.
private def chooseStart (red allow d : Nat) : Nat :=
  let valid := (1 <<< (131-11*d))-1
  let h2 := allow ||| (allow >>> d)
  let h4 := h2 ||| (h2 >>> (2*d))
  let h8 := h4 ||| (h4 >>> (4*d))
  let h12 := h8 ||| (h4 >>> (8*d))
  let noHit := valid ^^^ (valid &&& h12)
  if noHit ≠ 0 then noHit.log2 else
    let m2 := red ||| (red >>> d) ||| (allow &&& (allow >>> d))
    let m4 := m2 ||| (m2 >>> (2*d)) ||| (h2 &&& (h2 >>> (2*d)))
    let m8 := m4 ||| (m4 >>> (4*d)) ||| (h4 &&& (h4 >>> (4*d)))
    let m12 := m8 ||| (m4 >>> (8*d)) ||| (h8 &&& (h4 >>> (8*d)))
    (valid ^^^ (valid &&& m12)).log2

private def gate (leaves : Array {s // Bad Hits s}) (k : Nat) (s : Marks × Nat) : Bool :=
  match leaves[k]? with
  | some leaf => leaf.val == s
  | none => false

private lemma gate_sound (leaves : Array {s // Bad Hits s}) (k : Nat) (s : Marks × Nat)
    (h : gate leaves k s = true) : Bad Hits s := by
  unfold gate at h
  split at h
  · rename_i leaf he
    exact (beq_iff_eq.mp h) ▸ leaf.property
  · contradiction

private def word (tape : Array Nat) (i : Nat) := ((tape[i/512]! >>> (i%512)) % 512)

private def walk (leaves : Array {s // Bad Hits s}) (tape : Array Nat) :
    Nat → Nat → Marks × Nat → Nat
  | 0, _, _ => 0
  | gas+1, i, s =>
    let w := word tape i
    let tag := w%16
    if tag < 11 then
      let d := tag+1
      let rest := pattern d (chooseStart s.1.red s.2 d) &&& s.2
      if rest = 0 then i+4 else
        let p := rest.log2
        if rest = (1 <<< p) then walk leaves tape gas (i+4) (addRed s.1 s.2 p) else 0
    else
      let p := (tag-11)*32+w/16
      if p < 135 then
        let next := walk leaves tape gas (i+9) (addRed s.1 s.2 p)
        if next = 0 then 0 else
          walk leaves tape gas next (s.1, s.2 ^^^ (s.2 &&& (1 <<< p)))
      else if gate leaves (p-135) s then i+9 else 0

private lemma walk_sound {tape : Array Nat} (leaves : Array {s // Bad Hits s})
    (g i : Nat) (s : Marks × Nat) (hw : walk leaves tape g i s ≠ 0) : Bad Hits s := by
  induction g generalizing i s with
  | zero => simp [walk] at hw
  | succ g ih =>
    intro R bound hn hit hs ha
    simp only [walk] at hw
    split at hw
    · let d := (word tape i)%16+1
      let a := chooseStart s.1.red s.2 d
      obtain ⟨t,hbit,ht⟩ := hit d a
      have hrest : (pattern d a &&& s.2).testBit t = true := by simp [hbit,ha t ht]
      split at hw
      · rename_i hzero
        change pattern d a &&& s.2 = 0 at hzero
        simp [hzero] at hrest
      · split at hw
        · rename_i hpow
          change pattern d a &&& s.2 = 1 <<< (pattern d a &&& s.2).log2 at hpow
          rw [hpow, Nat.shiftLeft_eq, one_mul, Nat.testBit_two_pow] at hrest
          have hp := (of_decide_eq_true hrest) ▸ ht
          exact ih _ _ hw R bound hn hit (join_good hs (mark_good hn hp (bound _ hp))) (add_safe hs ha hp)
        · contradiction
    · split at hw
      · split at hw
        · contradiction
        · rename_i hleft
          let p := ((word tape i)%16-11)*32+word tape i/16
          by_cases hp : R p
          · exact ih _ _ hleft R bound hn hit (join_good hs (mark_good hn hp (bound _ hp))) (add_safe hs ha hp)
          · apply ih _ _ hw R bound hn hit hs
            intro t ht
            have ne : p ≠ t := fun e => hp (e ▸ ht)
            change (s.2 ^^^ (s.2 &&& (1 <<< p))).testBit t = true
            simp [Nat.testBit_xor, ha t ht, Nat.shiftLeft_eq, ne]
      · split at hw
        · exact gate_sound leaves _ s (by assumption) R bound hn hit hs ha
        · contradiction

private lemma certify {s : Marks × Nat} (tape : Array Nat) (leaves : Array {s // Bad Hits s})
    (h : walk leaves tape 145 0 s ≠ 0) : Bad Hits s := walk_sound leaves 145 0 s h

