private lemma of_not_false {b : Bool} (h : b = false → False) : b = true := by
  cases b <;> simp_all

private def Mono (r : ℕ → Bool) : Prop :=
  ∃ (b : Bool) (a d : ℕ), 0 < d ∧ a + (if b then 11 else 2)*d < 135 ∧
    ∀ t ≤ (if b then 11 else 2), r (a+t*d) = b

private def Red (r : ℕ → Bool) (o x : ℕ) := x < 131 ∧ r (o+x) = false

private lemma triple_free {r : ℕ → Bool} {o : ℕ} (ho : o ≤ 4)
    (hn : ¬ Mono r) : NoTriple (Red r o) := by
  intro a d hd h₀ h₁ h₂
  apply hn
  refine ⟨false,o+a,d,hd,by change o+a+2*d < 135; have := h₂.1; omega,?_⟩
  intro t ht
  change t ≤ 2 at ht
  rcases (show t=0 ∨ t=1 ∨ t=2 by omega) with e|e|e
  · simpa [e] using h₀.2
  · simpa [e, Nat.add_assoc] using h₁.2
  · simpa [e, Nat.add_assoc] using h₂.2

private lemma base_bit : ∀ d : Fin 12, 0 < d.val → ∀ t : Fin 12,
    bases[d.val]!.testBit (t.val*d.val) = true := by decide +kernel

private lemma hit_at {r : ℕ → Bool} {o a d : ℕ} (ho : o ≤ 4) (hn : ¬ Mono r)
    (hd : 0 < d) (hb : a+11*d < 131) :
    ∃ t, (bases[d]! <<< a).testBit t = true ∧ Red r o t := by
  by_contra! bad
  apply hn
  refine ⟨true,o+a,d,hd,by change o+a+11*d < 135; omega,?_⟩
  intro t ht
  change t ≤ 11 at ht
  have hmul := Nat.mul_le_mul_right d ht
  have hm : (bases[d]! <<< a).testBit (a+t*d) = true := by
    simpa [Nat.testBit_shiftLeft, Nat.le_add_right] using base_bit ⟨d,by omega⟩ hd ⟨t,by omega⟩
  apply of_not_false
  intro hf
  exact bad _ hm ⟨by omega,by simpa [Nat.add_assoc] using hf⟩

private lemma hit_all {r : ℕ → Bool} {o : ℕ} (ho : o ≤ 4) (hn : ¬ Mono r) : Hits (Red r o) := by
  intro d a
  unfold pattern
  split
  · rename_i h
    exact hit_at ho hn h.1 h.2
  · simpa using hit_at (a:=0) (d:=1) ho hn (by decide) (by decide)

private lemma gap {r : ℕ → Bool} {o : ℕ} (ho : o ≤ 4)
    (hr : r (o+61) = false) (h₂ : r (o+62) = true)
    (h₃ : r (o+63) = true) (h₄ : r (o+64) = true) : Mono r := by
  by_contra hn
  refine n201 (Red r o) (fun x hx => by have := hx.1; omega)
    (triple_free ho hn) (hit_all ho hn) ?_ ?_
  · change Good (Red r o) (mark 61)
    exact mark_good (triple_free ho hn) ⟨by decide,hr⟩ (by decide)
  · intro x hx
    have b : ∀ i : Fin 131, i.val ≠ 62 → i.val ≠ 63 → i.val ≠ 64 →
        (0x7fffffffffffffffe3fffffffffffffff : ℕ).testBit i.val = true := by decide +kernel
    exact b ⟨x,hx.1⟩ (by rintro rfl; simp [hx.2] at h₂)
      (by rintro rfl; simp [hx.2] at h₃) (by rintro rfl; simp [hx.2] at h₄)

private lemma leftBand {r : ℕ → Bool} (hn : ¬ Mono r)
    (h66 : r 66 = true) (h67 : r 67 = true) (h68 : r 68 = true) :
    ∀ x, 61 ≤ x → x ≤ 68 → r x = true := by
  have h65 : r 65 = true := of_not_false fun hf => hn (gap (o:=4) (by decide) hf h66 h67 h68)
  have h64 : r 64 = true := of_not_false fun hf => hn (gap (o:=3) (by decide) hf h65 h66 h67)
  have h63 : r 63 = true := of_not_false fun hf => hn (gap (o:=2) (by decide) hf h64 h65 h66)
  have h62 : r 62 = true := of_not_false fun hf => hn (gap (o:=1) (by decide) hf h63 h64 h65)
  have h61 : r 61 = true := of_not_false fun hf => hn (gap (o:=0) (by decide) hf h62 h63 h64)
  intro x hx hy
  interval_cases x <;> assumption

private theorem mirror_ap (r : ℕ → Bool)
    (h : ∃ (b : Bool) (a d : ℕ), 0 < d ∧ a + (if b then 11 else 2) * d < 135 ∧
      ∀ t ≤ (if b then 11 else 2), (fun i => r (134 - i)) (a + t * d) = b) :
    ∃ (b : Bool) (a d : ℕ), 0 < d ∧ a + (if b then 11 else 2) * d < 135 ∧
      ∀ t ≤ (if b then 11 else 2), r (a + t * d) = b := by
  obtain ⟨b, a, d, hd, he, hm⟩ := h
  generalize hL : (if b then 11 else 2) = L at he hm
  refine ⟨b, 134 - (a + L*d), d, hd, ?_, ?_⟩
  · rw [hL]; omega
  · rw [hL]
    intro t ht
    have hh := hm (L - t) (by omega)
    have hmul := Nat.mul_le_mul_right d ht
    simp only at hh
    rw [Nat.sub_mul] at hh
    simpa only [show 134 - (a + (L*d - t*d)) = 134 - (a + L*d) + t*d by omega] using hh


theorem center {r : ℕ → Bool} (h66 : r 66 = true) (h67 : r 67 = true)
    (h68 : r 68 = true) : ∃ (b : Bool) (a d : ℕ), 0 < d ∧
    a+(if b then 11 else 2)*d < 135 ∧ ∀ t ≤ (if b then 11 else 2), r (a+t*d) = b := by
  change Mono r
  by_contra hn
  have hl := leftBand hn h66 h67 h68
  have hr := leftBand (r:=fun i => r (134-i)) (fun hm => hn (mirror_ap r hm)) h68 h67 h66
  apply hn
  refine ⟨true,61,1,by decide,by decide,?_⟩
  intro t ht
  change t ≤ 11 at ht
  by_cases h : 61+t ≤ 68
  · simpa using hl (61+t) (by omega) h
  · simpa [show 134-(134-(61+t))=61+t by omega] using hr (134-(61+t)) (by omega) (by omega)

end OMA.Window131

/- The following interval lemmas, the lower coloring, and the reflection
argument come from Green14.W_3_12.R1 by @iskan-ai. That reduction credits
@Halldon and Dominic Dabish for the interval and lower-bound arguments. -/

open Set Green14
open scoped Classical

namespace OMA.R_Green14_W_3_12_R2

def H1 : Prop :=
  ∀ r : ℕ → Bool, (r 66 = false ∧ r 68 = true) →
    ∃ (b : Bool) (a d : ℕ), 0 < d ∧ a + (if b then 11 else 2) * d < 135 ∧
      ∀ t ≤ (if b then 11 else 2), r (a + t * d) = b

def H2 : Prop :=
  ∀ r : ℕ → Bool, ((r 66 = false ∧ r 68 = false) ∨ (r 66 = true ∧ r 68 = true ∧ r 67 = false)) →
    ∃ (b : Bool) (a d : ℕ), 0 < d ∧ a + (if b then 11 else 2) * d < 135 ∧
      ∀ t ≤ (if b then 11 else 2), r (a + t * d) = b

theorem mixedMonoAPGuaranteeSet_upward (k r : ℕ) {M N : ℕ} (hMN : M ≤ N)
    (hM : M ∈ mixedMonoAPGuaranteeSet k r) :
    N ∈ mixedMonoAPGuaranteeSet k r := by
  intro coloring
  let emb : Icc 1 M ↪ Icc 1 N :=
    ⟨fun x ↦ ⟨x, x.2.1, x.2.2.trans hMN⟩, by
      intro x y h
      apply Subtype.ext
      exact congrArg (fun z : Icc 1 N ↦ (z : Nat)) h⟩
  let restricted : Icc 1 M → Fin 2 := fun x ↦ coloring (emb x)
  rcases hM restricted with hzero | hone
  · left
    rcases hzero with ⟨s, hsAP, hsColor⟩
    let t : Finset (Icc 1 N) := s.map emb
    have hsets : ({(x : Nat) | x ∈ t} : Set Nat) = {(x : Nat) | x ∈ s} := by
      ext z
      constructor
      · rintro ⟨x,hx,rfl⟩
        obtain ⟨y,hy,rfl⟩ := Finset.mem_map.mp hx
        exact ⟨y,hy,rfl⟩
      · rintro ⟨y,hy,rfl⟩
        exact ⟨emb y,Finset.mem_map.mpr ⟨y,hy,rfl⟩,rfl⟩
    refine ⟨t, ?_, ?_⟩
    · rw [hsets]
      exact hsAP
    · intro x hx
      rcases Finset.mem_map.mp hx with ⟨y, hy, rfl⟩
      simpa [restricted] using hsColor y hy
  · right
    rcases hone with ⟨s, hsAP, hsColor⟩
    let t : Finset (Icc 1 N) := s.map emb
    have hsets : ({(x : Nat) | x ∈ t} : Set Nat) = {(x : Nat) | x ∈ s} := by
      ext z
      constructor
      · rintro ⟨x,hx,rfl⟩
        obtain ⟨y,hy,rfl⟩ := Finset.mem_map.mp hx
        exact ⟨y,hy,rfl⟩
      · rintro ⟨y,hy,rfl⟩
        exact ⟨emb y,Finset.mem_map.mpr ⟨y,hy,rfl⟩,rfl⟩
    refine ⟨t, ?_, ?_⟩
    · rw [hsets]
      exact hsAP
    · intro x hx
      rcases Finset.mem_map.mp hx with ⟨y, hy, rfl⟩
      simpa [restricted] using hsColor y hy

/-- One bad coloring of `{1, ..., N}` proves the numerical lower bound
`W(k,r) ≥ N+1`. -/
private theorem W_ge_succ_of_not_mem (k r N : ℕ)
    (hne : (mixedMonoAPGuaranteeSet k r).Nonempty) (hbad : N ∉ mixedMonoAPGuaranteeSet k r) :
    N + 1 ≤ W k r := by
  rw [W]
  apply le_csInf hne
  intro b hb
  by_contra hle
  have hbN : b ≤ N := Nat.lt_succ_iff.mp (Nat.lt_of_not_ge hle)
  exact hbad (mixedMonoAPGuaranteeSet_upward k r hbN hb)

private lemma progression_at {N k a d : Nat} (hd : 0 < d)
    (c : Icc 1 N → Fin 2) (color : Fin 2)
    (bound : ∀ i : Fin k, a+i.val*d < N)
    (mono : ∀ (i : Fin k) (hi : a+i.val*d < N), c ⟨a+i.val*d+1, by constructor <;> omega⟩ = color) :
    ∃ s : Finset (Icc 1 N), ({(z : Nat) | z ∈ s}).IsAPOfLength k ∧
      ∀ z ∈ s, c z = color := by
  classical
  let value (i : Fin k) := a + i.val*d + 1
  have inj : Function.Injective value := by
    intro i j h
    apply Fin.ext
    exact Nat.eq_of_mul_eq_mul_right hd (by simpa [value] using h)
  let point : Fin k ↪ Icc 1 N := ⟨fun i => ⟨value i, by
    have := bound i
    dsimp [value]
    constructor <;> omega⟩, fun i j h => inj (congrArg Subtype.val h)⟩
  let s := Finset.univ.map point
  have eqs : ({(z : Nat) | z ∈ s} : Set Nat) = range value := by
    ext z
    constructor
    · rintro ⟨y,hy,rfl⟩
      obtain ⟨i,_,rfl⟩ := Finset.mem_map.mp hy
      exact ⟨i,rfl⟩
    · rintro ⟨i,rfl⟩
      exact ⟨point i,Finset.mem_map.mpr ⟨i,Finset.mem_univ _,rfl⟩,rfl⟩
  refine ⟨s, ?_, ?_⟩
  · rw [eqs]
    refine ⟨a+1,d,?_,?_⟩
    · rw [ENat.card_coe_set_eq, ← Set.image_univ, inj.encard_image]
      simp
    · ext z
      constructor
      · rintro ⟨i,rfl⟩
        exact ⟨i.val,by exact_mod_cast i.isLt,by simp [value]; omega⟩
      · rintro ⟨i,hi,rfl⟩
        exact ⟨⟨i,by exact_mod_cast hi⟩,by simp [value]; omega⟩
  · intro z hz
    obtain ⟨i,_,rfl⟩ := Finset.mem_map.mp hz
    exact mono i (bound i)


private lemma extract_progression {N k : ℕ} (hk : 2 ≤ k) (q : ℕ → Fin 2) (col : Fin 2)
    (h : ∃ s : Finset (Icc 1 N), ({(x : ℕ) | x ∈ s}).IsAPOfLength k ∧
      ∀ x ∈ s, q (x.val-1) = col) :
    ∃ a d : Fin N, 0 < d.val ∧ a.val + (k-1)*d.val < N ∧
      ∀ i : Fin k, q (a.val + i.val*d.val) = col := by
  obtain ⟨s,⟨a,d,hcard,hset⟩,hc⟩ := h
  have term (i : ℕ) (hi : i < k) :
      ∃ x ∈ s, (x : ℕ) = a + i*d := by
    change a + i*d ∈ ({(x : ℕ) | x ∈ s} : Set ℕ)
    rw [hset]
    exact ⟨i, by exact_mod_cast hi, by simp⟩
  obtain ⟨x₀, -, hx₀⟩ := term 0 (by omega)
  simp only [Nat.zero_mul, Nat.add_zero] at hx₀
  obtain ⟨x₁, -, hx₁⟩ := term (k-1) (by omega)
  have ha : 1 ≤ a := hx₀ ▸ x₀.property.1
  have hb : a + (k-1)*d ≤ N := hx₁ ▸ x₁.property.2
  have hpos : 0 < d := by
    by_contra! hz
    have hd : d = 0 := by omega
    have heq : ({(x : ℕ) | x ∈ s} : Set ℕ) = {a} := by
      rw [hset]
      ext z
      simp only [hd, nsmul_zero, add_zero, Set.mem_ofPred_eq, Set.mem_singleton_iff]
      constructor
      · rintro ⟨i,hi,rfl⟩
        rfl
      · rintro rfl
        exact ⟨0, by exact_mod_cast (show 0 < k by omega), rfl⟩
    have hone : (k : ℕ∞) = 1 := by rw [← hcard, heq]; simp
    have : k = 1 := by exact_mod_cast hone
    omega
  have hd' : d ≤ (k-1)*d := by
    simpa using Nat.mul_le_mul_right d (show 1 ≤ k-1 by omega)
  refine ⟨⟨a-1,by omega⟩,⟨d,by omega⟩,hpos,by change a-1+(k-1)*d < N; omega,?_⟩
  intro i
  obtain ⟨x,hx,hval⟩ := term i.val i.isLt
  have he := hc x hx
  change q (a - 1 + i.val*d) = col
  convert he using 2 <;> omega

