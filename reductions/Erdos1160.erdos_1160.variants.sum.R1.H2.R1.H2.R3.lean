import OMAReductions.R_Erdos1160_erdos_1160_variants_sum_R1_H2_R1
import Mathlib.GroupTheory.Index
import Mathlib.Data.Nat.Log
import Mathlib.Data.Set.Card

-- Reduction Erdos1160.erdos_1160.variants.sum.R1.H2.R1.H2.R3 of step Erdos1160.erdos_1160.variants.sum.R1.H2.R1.H2
-- Credit: @gertjanvdgoot

/-!
Split the groups of order 2^m by d, where 2^d is the index of the subgroup F generated by the
squares (G/F is elementary abelian of rank d).

* H1 (large rank, 5m ≤ 6d): elementary. The pc-presentation count with the series through F
  bounds these classes by (m+1) * 2^((91/1296) m^3), so 27 * log2 (2 * count) is about
  1.896 m^3 + O(log m), far below 2 m^3 - 9 m^2.
* H2 (smaller rank, 6d < 5m): the bulk of the groups; this is the sharp upper bound
  log2 g(2^m) ≤ (2/27) m^3 - (1/3) m^2 restricted to these classes (Li and Qiao,
  arXiv:2610.14509, give (2/27) m^3 - (4/9) m^2 + O(m)).

main: g(2^m) is at most the sum of the two counts, hence at most twice the larger one.
-/

open Filter CategoryTheory Erdos1160

namespace OMA.R_Erdos1160_erdos_1160_variants_sum_R1_H2_R1_H2_R3

/-- Twice the classes of order 2^m with a large square-subgroup index satisfy the cubic bound. -/
def H1 : Prop := ∀ᶠ m : ℕ in atTop,
  (2 * (Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) '' {G : FiniteGrp.{0} | Nat.card G = 2^m ∧
    5*m ≤ 6*Nat.log 2 (Subgroup.closure (Set.range (fun x : G => x*x))).index}).ncard)^27 *
    2^(9*m^2) ≤ 2^(2*m^3)

/-- The same for the classes of order 2^m with a smaller square-subgroup index. -/
def H2 : Prop := ∀ᶠ m : ℕ in atTop,
  (2 * (Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) '' {G : FiniteGrp.{0} | Nat.card G = 2^m ∧
    ¬ 5*m ≤ 6*Nat.log 2 (Subgroup.closure (Set.range (fun x : G => x*x))).index}).ncard)^27 *
    2^(9*m^2) ≤ 2^(2*m^3)

/-- The classes of order n split along any property of the representative. -/
theorem split_le (n : ℕ) (P : FiniteGrp.{0} → Prop) :
    g n ≤ (Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) ''
        {G : FiniteGrp.{0} | Nat.card G = n ∧ P G}).ncard +
      (Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) ''
        {G : FiniteGrp.{0} | Nat.card G = n ∧ ¬ P G}).ncard := by
  unfold g
  have h : {G : FiniteGrp.{0} | Nat.card G = n} =
      {G : FiniteGrp.{0} | Nat.card G = n ∧ P G} ∪ {G : FiniteGrp.{0} | Nat.card G = n ∧ ¬ P G} := by
    ext G
    simp only [Set.mem_setOf_eq, Set.mem_union]
    tauto
  rw [h, Set.image_union]
  exact Set.ncard_union_le _ _

theorem main : H1 → H2 → OMA.R_Erdos1160_erdos_1160_variants_sum_R1_H2_R1.H2 := by
  intro large small
  filter_upwards [large, small] with m hl hs
  have hsplit := split_le (2^m)
    (fun G => 5*m ≤ 6*Nat.log 2 (Subgroup.closure (Set.range (fun x : G => x*x))).index)
  set a := (Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) '' {G : FiniteGrp.{0} | Nat.card G = 2^m ∧
    5*m ≤ 6*Nat.log 2 (Subgroup.closure (Set.range (fun x : G => x*x))).index}).ncard
  set b := (Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) '' {G : FiniteGrp.{0} | Nat.card G = 2^m ∧
    ¬ 5*m ≤ 6*Nat.log 2 (Subgroup.closure (Set.range (fun x : G => x*x))).index}).ncard
  rcases le_total a b with hab | hab
  · calc g (2 ^ m) ^ 27 * 2 ^ (9 * m ^ 2) ≤ (2 * b) ^ 27 * 2 ^ (9 * m ^ 2) :=
          Nat.mul_le_mul_right _ (Nat.pow_le_pow_left (by omega) 27)
      _ ≤ 2 ^ (2 * m ^ 3) := hs
  · calc g (2 ^ m) ^ 27 * 2 ^ (9 * m ^ 2) ≤ (2 * a) ^ 27 * 2 ^ (9 * m ^ 2) :=
          Nat.mul_le_mul_right _ (Nat.pow_le_pow_left (by omega) 27)
      _ ≤ 2 ^ (2 * m ^ 3) := hl

end OMA.R_Erdos1160_erdos_1160_variants_sum_R1_H2_R1_H2_R3
