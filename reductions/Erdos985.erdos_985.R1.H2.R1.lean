private theorem power_class {a b p r : ℕ} (hp : p.Prime) (hl : p < 10^8) (hr : r.Prime)
    (ha : 0 < a) (hb : 2 ≤ b) (hodd : r%2 = 1) (he : p = 2^a*r^b+1) :
    ∃ q : ℕ, q.Prime ∧ q < p ∧ orderOf (q : ZMod p) = p-1 := by
  let pm (q n e : ℕ) := (Nat.rec (motive := fun _ => ℕ → ℕ) (fun t => q^t % n)
      (fun _ prev t => (prev (t/4)^4 * q^(t%4)) % n) 13 e)
  let test (n s d : ℕ) : Bool :=
    (1 < d && d < s && s%d == 0) || (1 < d && d < n && n%d == 0) ||
    (d < n && decide d.Prime && pm d n ((n-1)/2) != 1 && pm d n ((n-1)/s) != 1)
  have sound (d : ℕ) (h : test p r d = true) :
      ∃ q : ℕ, q.Prime ∧ q < p ∧ orderOf (q : ZMod p) = p-1 := by
    simp only [test, Bool.or_eq_true, Bool.and_eq_true, decide_eq_true_eq,
      bne_iff_ne, beq_iff_eq] at h
    rcases h with ((⟨⟨hd, hlt⟩, hz⟩ | ⟨⟨hd,hlt⟩,hz⟩) | ⟨⟨⟨hlt, hq⟩, h2⟩, ho⟩)
    · exact (Nat.prime_def_lt'.mp hr |>.2 d hd hlt (Nat.dvd_of_mod_eq_zero hz)).elim
    · exact (Nat.prime_def_lt'.mp hp |>.2 d hd hlt (Nat.dvd_of_mod_eq_zero hz)).elim
    · exact small_witness hp hr hq hlt (show p-1 = 2^a*r^b by omega)
        (by simpa only [pm, power_eval] using h2) (by simpa only [pm, power_eval] using ho)
  have hr3 : 3 ≤ r := by have := hr.two_le; omega
  have hm : 2^a*3^b+1 ≤ p := by rw [he]; gcongr
  have ha' : a < 27 := by
    by_contra! h
    have h1 : 2^27 ≤ 2^a := Nat.pow_le_pow_right (by decide) h
    have h3 : 0 < 3^b := by positivity
    norm_num at h1 hl
    nlinarith
  have hb' : b < 17 := by
    by_contra! h
    have h1 : 3^17 ≤ 3^b := Nat.pow_le_pow_right (by decide) h
    have h2 : 0 < 2^a := by positivity
    norm_num at h1 hl
    nlinarith
  -- Each row contains the exponents, the count of candidate odd bases and
