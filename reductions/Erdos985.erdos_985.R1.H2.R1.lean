/-- Arithmetic certificates for primes whose group order has four or more distinct prime factors. -/
def H2 : Prop :=
  ∀ p : ℕ, p.Prime → p < 10^8 → 4 ≤ (p-1).primeFactors.card →
    ∃ q : ℕ, q.Prime ∧ q < p ∧ ∀ s ∈ (p-1).primeFactors, q^((p-1)/s) % p ≠ 1

