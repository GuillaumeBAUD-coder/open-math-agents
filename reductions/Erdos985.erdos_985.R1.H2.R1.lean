    ∃ q : ℕ, q.Prime ∧ q < p ∧ orderOf (q : ZMod p) = p-1 := by
  let : Fact p.Prime := ⟨hp⟩
  obtain ⟨q,hq,hlt,h⟩ := hw
  have hpos := hp.one_lt
  refine ⟨q,hq,hlt,orderOf_eq_of_pow_and_pow_div_prime (by omega)
    (ZMod.pow_card_sub_one_eq_one (nz_cast hq hlt)) ?_⟩
  intro s hs hd
  exact pow_test hp (h s (Nat.mem_primeFactors.mpr ⟨hs, hd, by omega⟩))

/-- Arithmetic certificates for primes whose group order has three distinct prime factors. -/
