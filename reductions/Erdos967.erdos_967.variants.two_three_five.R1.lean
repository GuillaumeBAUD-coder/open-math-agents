import FormalConjectures.ErdosProblems.«967»

-- Reduction Erdos967.erdos_967.variants.two_three_five.R1 of the Erdős–Ingham question for {2, 3, 5}
-- Credit: @LordMike
-- Each H becomes its own step once this file is accepted. Proving all of them closes the problem.

/-!
# `1 + 2^(-1-it) + 3^(-1-it) + 5^(-1-it) ≠ 0` from Schanuel's conjecture for `n = 6`

This is an UPWARD reduction: `H1` is a case of Schanuel's conjecture (the catalogue problem
`Schanuel.schanuel_conjecture`), which is far stronger than the target.

* `H1`: Schanuel's conjecture for `n = 6`, in the catalogue's wording (open, deep).
* `H2`: `log 2, log 3, log 5` are linearly independent over `ℚ` (elementary: unique
  factorisation).

Proof. For `t = 0` the sum is positive. Let `t ≠ 0` and put `u = 2^(-it)`, `v = 3^(-it)`,
`w = 5^(-it)`, so the sum is `1 + u/2 + v/3 + w/5`. Assume it vanishes. As `u, v, w` have modulus
one, conjugation gives `1 + 1/(2u) + 1/(3v) + 1/(5w) = 0` as well. Eliminating `w` gives
`150 (2u + 1) v² + (450 u² + 1189 u + 450) v + (150 u² + 300 u) = 0`, with `2u + 1 ≠ 0`, so `v`
and then `w` are algebraic over `ℚ(u)`.

By `H2` and `t ≠ 0` the six numbers `log 2, log 3, log 5, -it log 2, -it log 3, -it log 5` are
linearly independent over `ℚ`, and their exponentials are `2, 3, 5, u, v, w`. All twelve numbers
are algebraic over `ℚ(log 2, log 3, log 5, -it log 2, u)`, so the field they generate has
transcendence degree at most `5`, against `H1`.

The same argument, with `k` primes and `2k` numbers, would treat any finite set (the catalogue
row `Erdos967.erdos_967.variants.finite`) once the two equations are shown to be independent.
The lemma `trdeg_adjoin_le` is taken from our reduction `Irrational.irrational_pi_to_e.R1`.
-/

namespace OMA.R_Erdos967_erdos_967_variants_two_three_five_R1

open IntermediateField

/-- Schanuel's conjecture for `n = 6`. -/
def H1 : Prop :=
  ∀ z : Fin 6 → ℂ, LinearIndependent ℚ z →
    ((6 : ℕ) : Cardinal) ≤
      Algebra.trdeg ℚ (adjoin ℚ (Set.range z ∪ Set.range (Complex.exp ∘ z)))

/-- `log 2, log 3, log 5` are linearly independent over `ℚ`. -/
def H2 : Prop :=
  LinearIndependent ℚ ![Real.log 2, Real.log 3, Real.log 5]

/-- A field generated by a set `S`, all of whose elements are algebraic over the field generated
by `m` of them, has transcendence degree at most `m`. -/
lemma trdeg_adjoin_le {S : Set ℂ} {m : ℕ} (t : Fin m → ℂ) (hTS : Set.range t ⊆ S)
    (halg : ∀ s ∈ S, IsAlgebraic (adjoin ℚ (Set.range t)) s) :
    Algebra.trdeg ℚ (adjoin ℚ S) ≤ (m : Cardinal) := by
  open IntermediateField.algebraAdjoinAdjoin in
  have h1 : Algebra.trdeg ℚ (Algebra.adjoin ℚ (Set.range t)) ≤ (m : Cardinal) := by
    have hB : Algebra.adjoin ℚ (Set.range t) = (MvPolynomial.aeval t).range :=
      Algebra.adjoin_range_eq_range_aeval ℚ t
    let f : MvPolynomial (Fin m) ℚ →ₐ[ℚ] Algebra.adjoin ℚ (Set.range t) :=
      (MvPolynomial.aeval t).codRestrict _ (fun p => by rw [hB]; exact ⟨p, rfl⟩)
    have hf : Function.Surjective f := by
      rintro ⟨b, hb⟩
      rw [hB] at hb
      obtain ⟨p, hp⟩ := hb
      exact ⟨p, Subtype.ext hp⟩
    have := trdeg_le_of_surjective f hf
    rw [MvPolynomial.trdeg_of_isDomain] at this
    simpa using this
  have hBK : Algebra.adjoin ℚ (Set.range t) ≤ (adjoin ℚ S).toSubalgebra :=
    Algebra.adjoin_le (fun x hx => subset_adjoin ℚ S (hTS hx))
  let _ : Algebra (Algebra.adjoin ℚ (Set.range t)) (adjoin ℚ S) :=
    (Subalgebra.inclusion hBK).toAlgebra
  have : IsScalarTower ℚ (Algebra.adjoin ℚ (Set.range t)) (adjoin ℚ S) :=
    Subalgebra.inclusion.isScalarTower_left hBK _
  have : FaithfulSMul (Algebra.adjoin ℚ (Set.range t)) (adjoin ℚ S) :=
    Subalgebra.inclusion.faithfulSMul hBK
  have hle : adjoin ℚ S ≤ (algebraicClosure (adjoin ℚ (Set.range t)) ℂ).restrictScalars ℚ := by
    rw [adjoin_le_iff]
    intro s hs
    exact mem_algebraicClosure_iff.mpr (halg s hs)
  have : Algebra.IsAlgebraic (Algebra.adjoin ℚ (Set.range t)) (adjoin ℚ S) := by
    refine ⟨fun x => ?_⟩
    have hx : IsAlgebraic (adjoin ℚ (Set.range t)) (x : ℂ) :=
      mem_algebraicClosure_iff.mp (hle x.2)
    have hx' : IsAlgebraic (Algebra.adjoin ℚ (Set.range t)) (x : ℂ) :=
      (IsFractionRing.isAlgebraic_iff (Algebra.adjoin ℚ (Set.range t))
        (adjoin ℚ (Set.range t)) ℂ).mpr hx
    let g : (adjoin ℚ S) →ₐ[Algebra.adjoin ℚ (Set.range t)] ℂ :=
      { (adjoin ℚ S).val.toRingHom with commutes' := fun _ => rfl }
    exact (isAlgebraic_algHom_iff g Subtype.val_injective).mp hx'
  have h2 := trdeg_add_eq ℚ (Algebra.adjoin ℚ (Set.range t)) (A := adjoin ℚ S)
  rw [trdeg_eq_zero (R := Algebra.adjoin ℚ (Set.range t)) (A := adjoin ℚ S), add_zero] at h2
  rw [← h2]
  exact h1

/-- An element of an intermediate field is algebraic over it. -/
lemma alg_mem (F : IntermediateField ℚ ℂ) {x : ℂ} (hx : x ∈ F) : IsAlgebraic F x :=
  isAlgebraic_algebraMap (⟨x, hx⟩ : F)

/-- Algebraicity of every generator of the Schanuel field, checked coordinate by coordinate. -/
lemma alg_union {n : ℕ} (F : IntermediateField ℚ ℂ) (z : Fin n → ℂ)
    (h1 : ∀ i, IsAlgebraic F (z i)) (h2 : ∀ i, IsAlgebraic F (Complex.exp (z i))) :
    ∀ s ∈ Set.range z ∪ Set.range (Complex.exp ∘ z), IsAlgebraic F s := by
  rintro s (⟨i, rfl⟩ | ⟨i, rfl⟩)
  · exact h1 i
  · exact h2 i

/-- Real and imaginary parts of `x + y i = 0`. -/
lemma re_im_of (x y : ℝ) (h : (x : ℂ) + (y : ℂ) * Complex.I = 0) : x = 0 ∧ y = 0 := by
  have h' := Complex.ext_iff.mp h
  simpa using h'

/-- A root of a quadratic with coefficients in `F` and nonzero leading coefficient is algebraic
over `F`. -/
lemma alg_quadratic (F : IntermediateField ℚ ℂ) {a b c x : ℂ} (ha : a ∈ F) (hb : b ∈ F)
    (hc : c ∈ F) (ha0 : a ≠ 0) (h : a * x ^ 2 + b * x + c = 0) : IsAlgebraic F x := by
  refine ⟨Polynomial.C (⟨a, ha⟩ : F) * Polynomial.X ^ 2 + Polynomial.C (⟨b, hb⟩ : F) * Polynomial.X
    + Polynomial.C (⟨c, hc⟩ : F), ?_, ?_⟩
  · intro h0
    have h2 := congrArg (fun p => Polynomial.coeff p 2) h0
    simp only [Polynomial.coeff_add, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow,
      Polynomial.coeff_X, Polynomial.coeff_C, Polynomial.coeff_zero] at h2
    norm_num at h2
    exact ha0 (congrArg Subtype.val h2)
  · simp only [map_add, map_mul, map_pow, Polynomial.aeval_C, Polynomial.aeval_X]
    exact h

/-- The summand as an exponential. -/
lemma summand_eq (t : ℝ) (n : ℕ) (hn : 0 < n) :
    Erdos967.summand t n =
      Complex.exp (-(t * Complex.I) * ((Real.log n : ℝ) : ℂ)) / (n : ℂ) := by
  have hn0 : (n : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr hn.ne'
  have hlog : Complex.log (n : ℂ) = ((Real.log n : ℝ) : ℂ) := by
    rw [Complex.ofReal_log (Nat.cast_nonneg n)]
    simp
  have hexp : Complex.exp ((Real.log n : ℝ) : ℂ) = (n : ℂ) := by
    rw [← Complex.ofReal_exp, Real.exp_log (by exact_mod_cast hn)]
    simp
  unfold Erdos967.summand
  rw [Complex.cpow_def_of_ne_zero hn0, hlog, mul_add, mul_one, Complex.exp_add, hexp,
    show -(t * Complex.I) * ((Real.log n : ℝ) : ℂ) = -(((Real.log n : ℝ) : ℂ) * (t * Complex.I)) by
      ring, Complex.exp_neg]
  field_simp

/-- The numbers `p^(-it)` have modulus one: the conjugate is the inverse. -/
lemma conj_exp (t L : ℝ) :
    (starRingEnd ℂ) (Complex.exp (-(t * Complex.I) * (L : ℂ))) =
      (Complex.exp (-(t * Complex.I) * (L : ℂ)))⁻¹ := by
  rw [← Complex.exp_conj, ← Complex.exp_neg]
  congr 1
  simp

/-- Elimination of `w` from the equation and its conjugate. -/
lemma quad_rel {u v w : ℂ} (hu : u ≠ 0) (hv : v ≠ 0) (hw : w ≠ 0)
    (h : 1 + u / 2 + v / 3 + w / 5 = 0) (h' : 1 + u⁻¹ / 2 + v⁻¹ / 3 + w⁻¹ / 5 = 0) :
    (150 * (2 * u + 1)) * v ^ 2 + (450 * u ^ 2 + 1189 * u + 450) * v
      + (150 * u ^ 2 + 300 * u) = 0 := by
  have h'' : u * v * w + v * w / 2 + u * w / 3 + u * v / 5 = 0 := by
    have : u * v * w + v * w / 2 + u * w / 3 + u * v / 5
        = u * v * w * (1 + u⁻¹ / 2 + v⁻¹ / 3 + w⁻¹ / 5) := by
      field_simp
    rw [this, h', mul_zero]
  linear_combination (-180 : ℂ) * h'' + 900 * (u * v + v / 2 + u / 3) * h

lemma lin6 (t : ℝ) (ht : t ≠ 0) (h2 : H2) :
    LinearIndependent ℚ
      ![((Real.log 2 : ℝ) : ℂ), ((Real.log 3 : ℝ) : ℂ), ((Real.log 5 : ℝ) : ℂ),
        -(t * Complex.I) * ((Real.log 2 : ℝ) : ℂ), -(t * Complex.I) * ((Real.log 3 : ℝ) : ℂ),
        -(t * Complex.I) * ((Real.log 5 : ℝ) : ℂ)] := by
  have key3 : ∀ a b c : ℚ, (a : ℝ) * Real.log 2 + b * Real.log 3 + c * Real.log 5 = 0 →
      a = 0 ∧ b = 0 ∧ c = 0 := by
    intro a b c habc
    have := Fintype.linearIndependent_iff.mp h2 ![a, b, c] (by
      rw [Fin.sum_univ_three]
      simp only [Rat.smul_def, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
        Matrix.head_cons, Matrix.tail_cons]
      exact habc)
    exact ⟨this 0, this 1, this 2⟩
  rw [Fintype.linearIndependent_iff]
  intro g hg
  have hg' : g 0 • ((Real.log 2 : ℝ) : ℂ) + g 1 • ((Real.log 3 : ℝ) : ℂ)
      + g 2 • ((Real.log 5 : ℝ) : ℂ)
      + g 3 • (-(t * Complex.I) * ((Real.log 2 : ℝ) : ℂ))
      + g 4 • (-(t * Complex.I) * ((Real.log 3 : ℝ) : ℂ))
      + g 5 • (-(t * Complex.I) * ((Real.log 5 : ℝ) : ℂ)) = 0 := by
    rw [Fin.sum_univ_six] at hg
    exact hg
  have key : ((((g 0 : ℝ) * Real.log 2 + g 1 * Real.log 3 + g 2 * Real.log 5 : ℝ)) : ℂ) +
      (((-t * ((g 3 : ℝ) * Real.log 2 + g 4 * Real.log 3 + g 5 * Real.log 5) : ℝ)) : ℂ)
        * Complex.I = 0 := by
    rw [← hg']
    simp only [Rat.smul_def]
    push_cast
    ring
  obtain ⟨hx, hy⟩ := re_im_of _ _ key
  have hy' : (g 3 : ℝ) * Real.log 2 + g 4 * Real.log 3 + g 5 * Real.log 5 = 0 := by
    rcases mul_eq_zero.mp hy with h | h
    · exact absurd (neg_eq_zero.mp h) ht
    · exact h
  obtain ⟨h0, h1, h2'⟩ := key3 _ _ _ hx
  obtain ⟨h3, h4, h5⟩ := key3 _ _ _ hy'
  intro i
  fin_cases i
  · exact h0
  · exact h1
  · exact h2'
  · exact h3
  · exact h4
  · exact h5

lemma exp_log_nat (n : ℕ) (hn : 0 < n) : Complex.exp ((Real.log n : ℝ) : ℂ) = (n : ℂ) := by
  rw [← Complex.ofReal_exp, Real.exp_log (by exact_mod_cast hn)]
  simp

/-- The upper bound: if the sum vanishes, the Schanuel field has transcendence degree at most 5. -/
lemma upper (t : ℝ)
    (h : 1 + Complex.exp (-(t * Complex.I) * ((Real.log 2 : ℝ) : ℂ)) / 2
      + Complex.exp (-(t * Complex.I) * ((Real.log 3 : ℝ) : ℂ)) / 3
      + Complex.exp (-(t * Complex.I) * ((Real.log 5 : ℝ) : ℂ)) / 5 = 0) :
    Algebra.trdeg ℚ (adjoin ℚ
      (Set.range ![((Real.log 2 : ℝ) : ℂ), ((Real.log 3 : ℝ) : ℂ), ((Real.log 5 : ℝ) : ℂ),
        -(t * Complex.I) * ((Real.log 2 : ℝ) : ℂ), -(t * Complex.I) * ((Real.log 3 : ℝ) : ℂ),
        -(t * Complex.I) * ((Real.log 5 : ℝ) : ℂ)] ∪
      Set.range (Complex.exp ∘ ![((Real.log 2 : ℝ) : ℂ), ((Real.log 3 : ℝ) : ℂ),
        ((Real.log 5 : ℝ) : ℂ),
        -(t * Complex.I) * ((Real.log 2 : ℝ) : ℂ), -(t * Complex.I) * ((Real.log 3 : ℝ) : ℂ),
        -(t * Complex.I) * ((Real.log 5 : ℝ) : ℂ)]))) ≤ ((5 : ℕ) : Cardinal) := by
  set L2 : ℂ := ((Real.log 2 : ℝ) : ℂ) with hL2
  set L3 : ℂ := ((Real.log 3 : ℝ) : ℂ) with hL3
  set L5 : ℂ := ((Real.log 5 : ℝ) : ℂ) with hL5
  set u : ℂ := Complex.exp (-(t * Complex.I) * L2) with hu
  set v : ℂ := Complex.exp (-(t * Complex.I) * L3) with hv
  set w : ℂ := Complex.exp (-(t * Complex.I) * L5) with hw
  have hL2ne : L2 ≠ 0 := by
    rw [hL2]
    exact_mod_cast (Real.log_pos (by norm_num : (1 : ℝ) < 2)).ne'
  have hu0 : u ≠ 0 := Complex.exp_ne_zero _
  have hv0 : v ≠ 0 := Complex.exp_ne_zero _
  have hw0 : w ≠ 0 := Complex.exp_ne_zero _
  have cu : (starRingEnd ℂ) u = u⁻¹ := conj_exp t _
  have cv : (starRingEnd ℂ) v = v⁻¹ := conj_exp t _
  have cw : (starRingEnd ℂ) w = w⁻¹ := conj_exp t _
  have h' : 1 + u⁻¹ / 2 + v⁻¹ / 3 + w⁻¹ / 5 = 0 := by
    have := congrArg (starRingEnd ℂ) h
    simpa [cu, cv, cw, Complex.conj_ofNat] using this
  have hquad := quad_rel hu0 hv0 hw0 h h'
  have ha0 : 150 * (2 * u + 1) ≠ 0 := by
    intro h0
    have hu2 : u = -1 / 2 := by linear_combination h0 / 300
    rw [hu2] at cu
    have : (starRingEnd ℂ) (-1 / 2 : ℂ) = -1 / 2 := by
      simp [Complex.conj_ofNat]
    rw [this] at cu
    norm_num at cu
  set B : Fin 5 → ℂ := ![L2, L3, L5, -(t * Complex.I) * L2, u] with hB
  have m0 : L2 ∈ adjoin ℚ (Set.range B) := subset_adjoin ℚ _ ⟨0, rfl⟩
  have m1 : L3 ∈ adjoin ℚ (Set.range B) := subset_adjoin ℚ _ ⟨1, rfl⟩
  have m2 : L5 ∈ adjoin ℚ (Set.range B) := subset_adjoin ℚ _ ⟨2, rfl⟩
  have m3 : -(t * Complex.I) * L2 ∈ adjoin ℚ (Set.range B) := subset_adjoin ℚ _ ⟨3, rfl⟩
  have m4 : u ∈ adjoin ℚ (Set.range B) := subset_adjoin ℚ _ ⟨4, rfl⟩
  have m5 : -(t * Complex.I) * L3 ∈ adjoin ℚ (Set.range B) := by
    have : -(t * Complex.I) * L3 = -(t * Complex.I) * L2 * L3 / L2 := by
      field_simp
    rw [this]
    exact div_mem (mul_mem m3 m1) m0
  have m6 : -(t * Complex.I) * L5 ∈ adjoin ℚ (Set.range B) := by
    have : -(t * Complex.I) * L5 = -(t * Complex.I) * L2 * L5 / L2 := by
      field_simp
    rw [this]
    exact div_mem (mul_mem m3 m2) m0
  have nat_mem : ∀ k : ℕ, (k : ℂ) ∈ adjoin ℚ (Set.range B) := fun k => IntermediateField.natCast_mem _ k
  have av : IsAlgebraic (adjoin ℚ (Set.range B)) v := by
    refine alg_quadratic _ (a := 150 * (2 * u + 1)) (b := 450 * u ^ 2 + 1189 * u + 450)
      (c := 150 * u ^ 2 + 300 * u) ?_ ?_ ?_ ha0 hquad
    · exact mul_mem (nat_mem 150) (add_mem (mul_mem (nat_mem 2) m4) (one_mem _))
    · exact add_mem (add_mem (mul_mem (nat_mem 450) (pow_mem m4 2)) (mul_mem (nat_mem 1189) m4))
        (nat_mem 450)
    · exact add_mem (mul_mem (nat_mem 150) (pow_mem m4 2)) (mul_mem (nat_mem 300) m4)
  have aw : IsAlgebraic (adjoin ℚ (Set.range B)) w := by
    have hweq : w = -5 + (-5 / 2) * u + (-5 / 3) * v := by linear_combination 5 * h
    rw [hweq]
    have c1 : IsAlgebraic (adjoin ℚ (Set.range B)) (-5 + (-5 / 2) * u : ℂ) :=
      alg_mem _ (add_mem (neg_mem (nat_mem 5))
        (mul_mem (div_mem (neg_mem (nat_mem 5)) (nat_mem 2)) m4))
    have c2 : IsAlgebraic (adjoin ℚ (Set.range B)) (-5 / 3 : ℂ) :=
      alg_mem _ (div_mem (neg_mem (nat_mem 5)) (nat_mem 3))
    exact c1.add (c2.mul av)
  refine trdeg_adjoin_le B ?_ (alg_union _ _ ?_ ?_)
  · rintro _ ⟨i, rfl⟩
    fin_cases i
    · exact Or.inl ⟨0, rfl⟩
    · exact Or.inl ⟨1, rfl⟩
    · exact Or.inl ⟨2, rfl⟩
    · exact Or.inl ⟨3, rfl⟩
    · exact Or.inr ⟨3, rfl⟩
  · intro i
    fin_cases i
    · exact alg_mem _ m0
    · exact alg_mem _ m1
    · exact alg_mem _ m2
    · exact alg_mem _ m3
    · exact alg_mem _ m5
    · exact alg_mem _ m6
  · intro i
    fin_cases i
    · show IsAlgebraic _ (Complex.exp L2)
      have := exp_log_nat 2 (by norm_num)
      simp only [Nat.cast_ofNat] at this
      rw [hL2, this]
      exact alg_mem _ (nat_mem 2)
    · show IsAlgebraic _ (Complex.exp L3)
      have := exp_log_nat 3 (by norm_num)
      simp only [Nat.cast_ofNat] at this
      rw [hL3, this]
      exact alg_mem _ (nat_mem 3)
    · show IsAlgebraic _ (Complex.exp L5)
      have := exp_log_nat 5 (by norm_num)
      simp only [Nat.cast_ofNat] at this
      rw [hL5, this]
      exact alg_mem _ (nat_mem 5)
    · exact alg_mem _ m4
    · exact av
    · exact aw

theorem main : H1 → H2 → type_of% @Erdos967.erdos_967.variants.two_three_five := by
  intro h1 h2 t hsum
  have e : 1 + Complex.exp (-(t * Complex.I) * ((Real.log 2 : ℝ) : ℂ)) / 2
      + Complex.exp (-(t * Complex.I) * ((Real.log 3 : ℝ) : ℂ)) / 3
      + Complex.exp (-(t * Complex.I) * ((Real.log 5 : ℝ) : ℂ)) / 5 = 0 := by
    rw [Finset.sum_insert (by decide), Finset.sum_insert (by decide), Finset.sum_singleton,
      summand_eq t 2 (by norm_num), summand_eq t 3 (by norm_num),
      summand_eq t 5 (by norm_num)] at hsum
    simp only [Nat.cast_ofNat] at hsum
    linear_combination hsum
  by_cases ht : t = 0
  · subst ht
    norm_num at e
  · have lower := h1 _ (lin6 t ht h2)
    have h65 : (6 : ℕ) ≤ 5 := by exact_mod_cast lower.trans (upper t e)
    omega

end OMA.R_Erdos967_erdos_967_variants_two_three_five_R1
