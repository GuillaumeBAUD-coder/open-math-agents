/-!
# `e ^ e` is transcendental, from Schanuel's conjecture for `n = 2`

Schanuel's conjecture: if `z₁, …, zₙ` are complex numbers linearly independent over `ℚ`, then
`ℚ(z₁, …, zₙ, exp z₁, …, exp zₙ)` has transcendence degree at least `n` over `ℚ`. This file uses the
case `n = 2` for **real** `z`: the standard conjecture is stated for complex tuples, and the real
case is the special case of it with `Im zᵢ = 0`, which is all that is used below.

* `H1` (Schanuel for `n = 2`, real tuples, the deep open input): for real `z₁, z₂` linearly
  independent over `ℚ` the field `ℚ(z₁, z₂, exp z₁, exp z₂)` has transcendence degree at least `2`.
* `H2` (Euler 1737, classical and elementary): `e = exp 1` is irrational — equivalently `1` and `e`
  are linearly independent over `ℚ`, which is the side condition of `H1` for `(z₁, z₂) = (1, e)`.

`main`: apply `H1` to `(1, e)`. Its field is `ℚ(1, e, e, e ^ e) = ℚ(e, e ^ e)`. If `e ^ e` were
algebraic over `ℚ` then every generator of that field (`1`, `e`, `e ^ e`) would be algebraic over
`ℚ(e)`, so the field would be generated by the single element `e` and would have transcendence
degree at most `1` (`trdeg_adjoin_le` below), contradicting `2 ≤ trdeg` from `H1`.
No transcendence result about `e` itself is used: `trdeg ℚ(e) ≤ 1` holds for any single generator.
-/

namespace OMA.R_Transcendental_exp_exp_transcendental_R1

open IntermediateField

/-- Schanuel's conjecture for real tuples with `n = 2`: if `z₁, z₂ : ℝ` are linearly independent
over `ℚ`, then `ℚ(z₁, z₂, exp z₁, exp z₂)` has transcendence degree at least `2` over `ℚ`. -/
def H1 : Prop :=
  ∀ z : Fin 2 → ℝ, LinearIndependent ℚ z →
    ((2 : ℕ) : Cardinal) ≤
      Algebra.trdeg ℚ (adjoin ℚ (Set.range z ∪ Set.range (Real.exp ∘ z)))

/-- Euler (1737): `e = exp 1` is irrational. -/
def H2 : Prop := Irrational (Real.exp 1)

/-- A field generated by a set `S`, all of whose elements are algebraic over the field generated
by `m` of them, has transcendence degree at most `m`. -/
lemma trdeg_adjoin_le {S : Set ℝ} {m : ℕ} (t : Fin m → ℝ) (hTS : Set.range t ⊆ S)
    (halg : ∀ s ∈ S, IsAlgebraic (adjoin ℚ (Set.range t)) s) :
    Algebra.trdeg ℚ (adjoin ℚ S) ≤ (m : Cardinal) := by
  open IntermediateField.algebraAdjoinAdjoin in
  -- step 1: the polynomial ring surjects onto the subalgebra generated by `t`
  have h1 : Algebra.trdeg ℚ (Algebra.adjoin ℚ (Set.range t)) ≤ (m : Cardinal) := by
    have hB : Algebra.adjoin ℚ (Set.range t) = (MvPolynomial.aeval t).range :=
      Algebra.adjoin_range_eq_range_aeval ℚ t
    let f : MvPolynomial (Fin m) ℚ →ₐ[ℚ] Algebra.adjoin ℚ (Set.range t) :=
      (MvPolynomial.aeval t).codRestrict _ (fun p => by rw [hB]; exact ⟨p, rfl⟩)
    have hf : Function.Surjective f := by
      rintro ⟨b, hb⟩
      rw [hB] at hb
      obtain ⟨p, hp⟩ := hb
      exact ⟨p, Subtype.ext hp⟩
    have := trdeg_le_of_surjective f hf
    rw [MvPolynomial.trdeg_of_isDomain] at this
    simpa using this
  -- step 2: `adjoin ℚ S` is an algebraic extension of that subalgebra
  have hBK : Algebra.adjoin ℚ (Set.range t) ≤ (adjoin ℚ S).toSubalgebra :=
    Algebra.adjoin_le (fun x hx => subset_adjoin ℚ S (hTS hx))
  let _ : Algebra (Algebra.adjoin ℚ (Set.range t)) (adjoin ℚ S) :=
    (Subalgebra.inclusion hBK).toAlgebra
  have : IsScalarTower ℚ (Algebra.adjoin ℚ (Set.range t)) (adjoin ℚ S) :=
    Subalgebra.inclusion.isScalarTower_left hBK _
  have : FaithfulSMul (Algebra.adjoin ℚ (Set.range t)) (adjoin ℚ S) :=
    Subalgebra.inclusion.faithfulSMul hBK
  have hle : adjoin ℚ S ≤ (algebraicClosure (adjoin ℚ (Set.range t)) ℝ).restrictScalars ℚ := by
    rw [adjoin_le_iff]
    intro s hs
    exact mem_algebraicClosure_iff.mpr (halg s hs)
  have : Algebra.IsAlgebraic (Algebra.adjoin ℚ (Set.range t)) (adjoin ℚ S) := by
    refine ⟨fun x => ?_⟩
    have hx : IsAlgebraic (adjoin ℚ (Set.range t)) (x : ℝ) :=
      mem_algebraicClosure_iff.mp (hle x.2)
    have hx' : IsAlgebraic (Algebra.adjoin ℚ (Set.range t)) (x : ℝ) :=
      (IsFractionRing.isAlgebraic_iff (Algebra.adjoin ℚ (Set.range t))
        (adjoin ℚ (Set.range t)) ℝ).mpr hx
    let g : (adjoin ℚ S) →ₐ[Algebra.adjoin ℚ (Set.range t)] ℝ :=
      { (adjoin ℚ S).val.toRingHom with commutes' := fun _ => rfl }
    exact (isAlgebraic_algHom_iff g Subtype.val_injective).mp hx'
  have h2 := trdeg_add_eq ℚ (Algebra.adjoin ℚ (Set.range t)) (A := adjoin ℚ S)
  rw [trdeg_eq_zero (R := Algebra.adjoin ℚ (Set.range t)) (A := adjoin ℚ S), add_zero] at h2
  rw [← h2]
  exact h1

/-- An element of an intermediate field is algebraic over it. -/
lemma alg_mem (F : IntermediateField ℚ ℝ) {x : ℝ} (hx : x ∈ F) : IsAlgebraic F x :=
  isAlgebraic_algebraMap (⟨x, hx⟩ : F)

/-- Euler's irrationality of `e = exp 1` says that `1` and `e` are linearly independent over `ℚ`. -/
lemma lin_two (h : Irrational (Real.exp 1)) :
    LinearIndependent ℚ ![(1 : ℝ), Real.exp 1] := by
  rw [Fintype.linearIndependent_iff]
  intro g hg
  have hg' : g 0 • (1 : ℝ) + g 1 • Real.exp 1 = 0 := by
    rw [Fin.sum_univ_two] at hg
    exact hg
  have key : (g 0 : ℝ) + (g 1 : ℝ) * Real.exp 1 = 0 := by
    simpa only [Rat.smul_def, Rat.cast_one, mul_one] using hg'
  have h1 : g 1 = 0 := by
    by_contra hne
    have hneR : (g 1 : ℝ) ≠ 0 := by exact_mod_cast hne
    apply h
    refine ⟨-g 0 / g 1, ?_⟩
    push_cast
    field_simp
    linarith
  have h0 : g 0 = 0 := by
    have h0R : (g 0 : ℝ) = 0 := by
      rw [h1] at key
      simpa using key
    exact_mod_cast h0R
  intro i
  fin_cases i
  · exact h0
  · exact h1

theorem main : H1 → H2 → type_of% @Transcendental.exp_exp_transcendental := by
  intro h1 h2 hT
  -- Schanuel for the pair `(1, e)`: its field is `ℚ(1, e)` together with `exp 1 = e` and
  -- `exp e = e ^ e`, i.e. `ℚ(e, e ^ e)`.
  have hlin : LinearIndependent ℚ ![(1 : ℝ), Real.exp 1] := lin_two h2
  have lower := h1 ![(1 : ℝ), Real.exp 1] hlin
  -- If `e ^ e` is algebraic then that field is generated by `e` alone.
  have hbridge :
      IsAlgebraic (adjoin ℚ (Set.range (fun _ : Fin 1 => Real.exp 1)))
        (Real.exp (Real.exp 1)) :=
    IsAlgebraic.tower_top (K := ℚ) (L := adjoin ℚ (Set.range (fun _ : Fin 1 => Real.exp 1)))
      (A := ℝ) hT
  have upper :
      Algebra.trdeg ℚ (adjoin ℚ (Set.range ![(1 : ℝ), Real.exp 1] ∪
        Set.range (Real.exp ∘ ![(1 : ℝ), Real.exp 1]))) ≤ ((1 : ℕ) : Cardinal) :=
    trdeg_adjoin_le (S := Set.range ![(1 : ℝ), Real.exp 1] ∪
        Set.range (Real.exp ∘ ![(1 : ℝ), Real.exp 1]))
      (fun _ : Fin 1 => Real.exp 1)
      (by
        rintro _ ⟨i, rfl⟩
        exact Or.inl ⟨1, rfl⟩)
      (by
        rintro s (⟨i, rfl⟩ | ⟨i, rfl⟩)
        · fin_cases i
          · exact alg_mem _ (one_mem _)
          · exact alg_mem _ (subset_adjoin ℚ _ ⟨0, rfl⟩)
        · fin_cases i
          · exact alg_mem _ (subset_adjoin ℚ _ ⟨0, rfl⟩)
          · exact hbridge)
  have h21 : (2 : ℕ) ≤ 1 := by exact_mod_cast lower.trans upper
  omega

end OMA.R_Transcendental_exp_exp_transcendental_R1
