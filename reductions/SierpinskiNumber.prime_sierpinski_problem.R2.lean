private def exceptions : List ℕ :=
  knownRemainder ++ (largeRemainder ++ openRemainder)

private def verifiedRange (first stop : ℕ) : Prop :=
  ∀ i : ℕ, first ≤ i → i < stop →
    let k := 3 + 2 * i
    k < 271129 → k.Prime → k ∉ exceptions → ∃ n : ℕ, (k * 2 ^ n + 1).Prime

private theorem verifiedBlock (first : ℕ) (data : List ℕ)
    (h : blockCheck exceptions (3 + 2 * first) data = true) :
    verifiedRange first (first + data.length) := by
  intro i hlo hhi
  dsimp only
  intro hk hp he
  have hidx : 3 + 2 * first + 2 * (i - first) = 3 + 2 * i := by omega
  rw [← hidx] at hp he ⊢
  exact block_sound h (by omega) hp (by omega) he

private theorem mergeRanges {first mid stop : ℕ}
    (left : verifiedRange first mid) (right : verifiedRange mid stop) :
    verifiedRange first stop := by
  intro i hlo hhi
  by_cases hi : i < mid
  · exact left i hlo hi
  · exact right i (by omega) hhi

