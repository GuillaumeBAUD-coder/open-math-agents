import FormalConjectures.Wikipedia.SierpinskiNumber
import Mathlib.FieldTheory.Finite.Basic

/-! Kernel-checked prime witnesses for the prime Sierpiński problem. -/

-- Credit: @MrSeizy. The exception-table strategy follows @Genbox and @tatashbar.

namespace OMA.R_SierpinskiNumber_prime_sierpinski_problem_R2

-- Compute a^e modulo N using at most t binary digits of the exponent.
private def modPow : ℕ → ℕ → ℕ → ℕ → ℕ
  | 0, N, _, _ => 1 % N
  | t + 1, N, a, e =>
    if e = 0 then 1 % N
    else
      let b := modPow t N a (e / 2)
      (b * b * (if e % 2 = 0 then 1 else a)) % N

private theorem modPow_eq (t N a e : ℕ) (he : e < 2 ^ t) :
    modPow t N a e = a ^ e % N := by
  induction t generalizing e with
  | zero =>
    have : e = 0 := by simpa using he
    simp [modPow, this]
  | succ t ih =>
    rw [pow_succ] at he
    rw [modPow]
    split_ifs with hz heven
    · simp [hz]
    · dsimp only
      rw [ih (e / 2) (by omega), mul_one, ← Nat.mul_mod, ← pow_add]
      congr 2
      omega
    · dsimp only
      rw [ih (e / 2) (by omega)]
      let b := a ^ (e / 2)
      change (b % N * (b % N) * a) % N = a ^ e % N
      rw [← Nat.mod_mul_mod (b % N * (b % N)) a N, ← Nat.mul_mod,
        Nat.mod_mul_mod (b * b) a N]
      change (a ^ (e / 2) * a ^ (e / 2) * a) % N = a ^ e % N
      rw [← pow_add, ← pow_succ]
      congr 2
      omega

private def squareMod (N : ℕ) : ℕ → ℕ → ℕ
  | 0, a => a % N
  | m + 1, a =>
    let b := squareMod N m a
    (b * b) % N

private theorem squareMod_eq (N m a : ℕ) :
    squareMod N m a = a ^ (2 ^ m) % N := by
  induction m with
  | zero => simp [squareMod]
  | succ m ih => rw [squareMod, ih, ← Nat.mul_mod, ← pow_add, pow_succ, Nat.mul_two]

private def accepts (k m a : ℕ) : Bool :=
  let P := 2 ^ (m + 1)
  let N := k * P + 1
  squareMod N m (modPow 19 N a k) == k * P &&
    (k < P || Nat.gcd (squareMod N (m + 1) a + k * P) N == 1)

-- The first branch uses the order-of-an-element proof of Proth's criterion by @philipsaint.
-- The second uses the prime factor k of N - 1 when it supplies the larger bound.
private theorem accepts_sound {k m a : ℕ} (hk : k.Prime) (hk19 : k < 2 ^ 19)
    (h : accepts k m a = true) : (k * 2 ^ (m + 1) + 1).Prime := by
  let P := 2 ^ (m + 1)
  let N := k * P + 1
  let r := a ^ P % N
  have hP : P = 2 ^ m * 2 := pow_succ _ _
  have hPpos : 0 < P := by positivity
  have hNpos : 0 < N := by exact Nat.succ_pos _
  have hN1 : N ≠ 1 := by
    have := Nat.mul_pos hk.pos hPpos
    change k * P + 1 ≠ 1
    omega
  change (squareMod N m (modPow 19 N a k) == k * P &&
    (decide (k < P) || Nat.gcd (squareMod N (m + 1) a + k * P) N == 1)) = true at h
  rw [Bool.and_eq_true, Bool.or_eq_true, beq_iff_eq, decide_eq_true_eq,
    beq_iff_eq, modPow_eq _ _ _ _ hk19, squareMod_eq, squareMod_eq,
    ← Nat.pow_mod, ← pow_mul] at h
  change N.Prime
  by_contra hn
  let q := N.minFac
  have hq : q.Prime := Nat.minFac_prime hN1
  have hd : q ∣ N := Nat.minFac_dvd N
  have hsq : q ^ 2 ≤ N := Nat.minFac_sq_le_self hNpos hn
  have : Fact q.Prime := ⟨hq⟩
  have hN0 : (N : ZMod q) = 0 := (ZMod.natCast_eq_zero_iff N q).mpr hd
  have hkp : (↑(k * P) : ZMod q) = -1 := by
    apply eq_neg_of_add_eq_zero_left
    change (↑(k * P + 1) : ZMod q) = 0 at hN0
    simpa only [Nat.cast_add, Nat.cast_one] using hN0
  have cast_mod (x : ℕ) : (↑(x % N) : ZMod q) = x := by
    have he := congrArg (fun n : ℕ => (n : ZMod q)) (Nat.mod_add_div x N)
    simpa only [Nat.cast_add, Nat.cast_mul, hN0, zero_mul, add_zero] using he
  let b : ZMod q := a
  have hb : (b ^ k) ^ (2 ^ m) = -1 := by
    rw [← pow_mul]
    change ((a : ZMod q) ^ (k * 2 ^ m)) = -1
    rw [← Nat.cast_pow, ← cast_mod, h.1, hkp]
  have hq2 : q ≠ 2 := by
    intro he
    rw [he] at hd
    obtain ⟨c, hc⟩ := hd
    change k * P + 1 = 2 * c at hc
    rw [hP, ← mul_assoc] at hc
    omega
  have hneg : (-1 : ZMod q) ≠ 1 := by
    intro hh
    have h2 : ((2 : ℕ) : ZMod q) = 0 := by
      push_cast
      linear_combination (-1 : ZMod q) * hh
    rw [ZMod.natCast_eq_zero_iff] at h2
    exact hq2 ((Nat.prime_dvd_prime_iff_eq hq Nat.prime_two).mp h2)
  have hfull : (b ^ k) ^ P = 1 := by
    rw [hP, pow_mul, hb]
    norm_num
  have hb0 : b ≠ 0 := by
    intro he
    rw [he, zero_pow hk.ne_zero, zero_pow hPpos.ne'] at hfull
    exact zero_ne_one hfull
  have hlarge (x : ℕ) (hx : x ∣ q - 1) (hbound : k * P ≤ x ^ 2) : False := by
    have hq1 : 0 < q - 1 := by have := hq.two_le; omega
    have hle := Nat.le_of_dvd hq1 hx
    have hsq' : (x + 1) ^ 2 ≤ q ^ 2 := Nat.pow_le_pow_left (by omega) 2
    change q ^ 2 ≤ k * P + 1 at hsq
    have hxpos : 0 < x := Nat.pos_of_dvd_of_pos hx hq1
    clear h
    nlinarith
  by_cases hProth : k < P
  · have hord : orderOf (b ^ k) = P := by
      change orderOf (b ^ k) = 2 ^ (m + 1)
      exact orderOf_eq_prime_pow (by rwa [hb]) hfull
    exact hlarge P (hord ▸ ZMod.orderOf_dvd_card_sub_one (pow_ne_zero _ hb0)) (by nlinarith)
  · have hPock := h.2.resolve_left hProth
    have hpow : (b ^ P) ^ k = 1 := by
      rwa [← pow_mul, mul_comm, pow_mul]
    have hne : b ^ P ≠ 1 := by
      intro he
      have hz : (↑(r + k * P) : ZMod q) = 0 := by
        rw [Nat.cast_add, hkp, show (r : ZMod q) = b ^ P by
          change (↑(a ^ P % N) : ZMod q) = (a : ZMod q) ^ P
          rw [cast_mod, Nat.cast_pow], he, add_neg_cancel]
      have hh := (ZMod.natCast_eq_zero_iff _ _).mp hz
      have : q ∣ Nat.gcd (r + k * P) N := Nat.dvd_gcd hh hd
      change Nat.gcd (r + k * P) N = 1 at hPock
      rw [hPock] at this
      exact hq.ne_one (Nat.dvd_one.mp this)
    have hord : orderOf (b ^ P) = k := by
      rcases (Nat.dvd_prime hk).mp (orderOf_dvd_of_pow_eq_one hpow) with h1 | hk
      · exact (hne (orderOf_eq_one_iff.mp h1)).elim
      · exact hk
    exact hlarge k (hord ▸ ZMod.orderOf_dvd_card_sub_one (pow_ne_zero _ hb0)) (by nlinarith)


-- The k-th row either marks an exception (0), supplies a proper divisor (1 through 1023),
-- or encodes the exponent n and base a as 1024 + 256 * (n - 1) + a.
-- In each block the rows are in order of increasing odd coefficient.
private def rowCheck (exceptions : List ℕ) (k code : ℕ) : Bool :=
  if code = 0 then exceptions.contains k
  else if code < 1024 then decide (1 < code ∧ code < k ∧ code ∣ k)
  else accepts k ((code - 1024) / 256) (code % 256)

private theorem row_sound {exceptions : List ℕ} {k code : ℕ}
    (h : rowCheck exceptions k code = true) (hp : k.Prime) (hsize : k < 2 ^ 19)
    (hnot : k ∉ exceptions) : ∃ n : ℕ, (k * 2 ^ n + 1).Prime := by
  unfold rowCheck at h
  split_ifs at h with hz hsmall
  · exact (hnot (List.contains_iff_mem.mp h)).elim
  · obtain ⟨h1, h2, hd⟩ := of_decide_eq_true h
    rcases hp.eq_one_or_self_of_dvd code hd with he | he <;> omega
  · exact ⟨(code - 1024) / 256 + 1, accepts_sound hp hsize h⟩

private def blockCheck (exceptions : List ℕ) (k : ℕ) : List ℕ → Bool
  | [] => true
  | code :: rest => rowCheck exceptions k code && blockCheck exceptions (k + 2) rest

private theorem block_sound {exceptions : List ℕ} {k i : ℕ} {data : List ℕ}
    (h : blockCheck exceptions k data = true) (hi : i < data.length)
    (hp : (k + 2 * i).Prime) (hsize : k + 2 * i < 2 ^ 19)
    (hnot : k + 2 * i ∉ exceptions) : ∃ n : ℕ, ((k + 2 * i) * 2 ^ n + 1).Prime := by
  induction data generalizing k i with
  | nil => simp at hi
  | cons code rest ih =>
    rw [blockCheck, Bool.and_eq_true] at h
    cases i with
    | zero =>
      simp only [Nat.mul_zero, Nat.add_zero] at hp hsize hnot ⊢
      exact row_sound h.1 hp hsize hnot
    | succ i =>
      rw [show k + 2 * (i + 1) = k + 2 + 2 * i by omega] at hp hsize hnot ⊢
      exact ih h.2 (by simpa using hi) hp hsize hnot

