/-- Two coefficients with reported prime witnesses at exponents 9162167 and 19375200. -/
def H2 : Prop :=
  ∀ k ∈ ([90527, 168451] : List ℕ), ∃ n : ℕ, (k * 2 ^ n + 1).Prime

/-- Coefficients whose sequences have no known prime witness. -/
def H3 : Prop :=
  ∀ k ∈ ([22699, 67607, 79309, 79817, 152267, 156511, 222113, 225931, 237019] : List ℕ), ∃ n : ℕ, (k * 2 ^ n + 1).Prime

theorem main : H1 → H2 → H3 → type_of% @SierpinskiNumber.prime_sierpinski_problem := by
  intro h1 h2 h3
  refine ⟨⟨covered, by norm_num⟩, ?_⟩
  rintro k ⟨hs, hp⟩
  by_contra! hlt
  have hw : ∃ n : ℕ, (k * 2 ^ n + 1).Prime := by
    by_cases he : k ∈ exceptions
    · simp only [exceptions, List.mem_append] at he
      rcases he with h | h | h
      · exact h1 k h
      · exact h2 k h
      · exact h3 k h
    · exact knownWitness hlt hp hs.1 he
  obtain ⟨n, hn⟩ := hw
  exact (hs.2 n).2 hn

end OMA.R_SierpinskiNumber_prime_sierpinski_problem_R2
