# Headers for files served from the static assets, without the Worker (cloudflare.config.ts, runWorkerFirst).
# vinext writes the first rule itself only when this file does not exist: keep it here.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Files of public/ keep their names across deploys. Cached a day (icons a week), then reused while the browser checks
# for a new version in the background, instead of a round trip on every page view. A replaced logo shows at once
# under a new file name.
/logo-mark.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/sponsor-logos/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/favicon.ico
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/icon-*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/apple-touch-icon*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/og.jpg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
